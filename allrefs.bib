@article{Ingersoll1982a,
	annote = {10.1144/GSL.SP.1982.010.01.31},
	author = {Ingersoll, Raymond V.},
	date = {1982/01/01},
	date-added = {2016-03-29 21:50:39 +0000},
	date-modified = {2016-03-29 21:50:39 +0000},
	journal = {Geological Society, London, Special Publications},
	journal1 = {Geological Society, London, Special Publications},
	month = {01},
	number = {1},
	pages = {459--467},
	title = {Initiation and evolution of the Great Valley forearc basin of northern and central California, U.S.A.},
	ty = {JOUR},
	url = {http://sp.lyellcollection.org/content/10/1/459.abstract N2 - The late Mesozoic Great Valley forearc basin of northern and central California evolved from a residual forearc basin formed on top of young oceanic crust to a composite forearc basin resting on both oceanic and continental crust. Depositional environments preserved in outcrop along the west side of the Sacramento Valley evolved from deep oceanic floor and slope in the Late Jurassic to basin plain in the Early Cretaceous to submarine fan complexes in the Late Cretaceous to slope and shelf in the Palaeogene. The forearc basin widened and enlarged, and was supplied with voluminous sediment primarily derived from the coeval magmatic arc to the east. However, significant quantities of ophiolitic detritus (chert, and sedimentary, mafic volcanic and mafic metavolcanic lithic fragments) occur in the lower Great Valley strata, thus indicating erosion of ‘tectonic highlands’ formed during arc-arc collision immediately preceeding initiation of the late Mesozoic subduction regime.The Great Valley forearc owes its geometry and history to the peculiarities of subduction initiation and to the shapes of the continental margin and magmatic arcs extant before initiation of the Great Valley subduction phase. The residual forearc developed on oceanic crust that had formed previously by spreading behind an east-facing intraoceanic arc. After this east-facing arc collided with the west-facing continental-margin arc, a new trench formed west of the suture belt. The shape of the new continental margin was irregular, so that a wide residual forearc basin formed in the Great Valley area, whereas no residual forearc basin formed to the north (Klamath area) or possibly, to the south (southern California borderland area that has been dislocated by Neogene strike-slip motions). The northern coastal promontory (Klamath area) provided much of the ophiolitic detritus within the lower part of the Great Valley strata. Sediment derived from the Klamaths was transported southward directly into the forearc basin, as well as westwards and then southwards into the trench west of the forearc basin. The Great Valley forearc basin is preserved and displayed so well today due to its mode of initiation (residual forearc formed in a previously backarc area) and its mode of termination (northward migration of a triple junction that converted a convergent margin into a transform margin).},
	volume = {10},
	year = {1982},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://sp.lyellcollection.org/content/10/1/459.abstract%20N2%20-%20The%20late%20Mesozoic%20Great%20Valley%20forearc%20basin%20of%20northern%20and%20central%20California%20evolved%20from%20a%20residual%20forearc%20basin%20formed%20on%20top%20of%20young%20oceanic%20crust%20to%20a%20composite%20forearc%20basin%20resting%20on%20both%20oceanic%20and%20continental%20crust.%20Depositional%20environments%20preserved%20in%20outcrop%20along%20the%20west%20side%20of%20the%20Sacramento%20Valley%20evolved%20from%20deep%20oceanic%20floor%20and%20slope%20in%20the%20Late%20Jurassic%20to%20basin%20plain%20in%20the%20Early%20Cretaceous%20to%20submarine%20fan%20complexes%20in%20the%20Late%20Cretaceous%20to%20slope%20and%20shelf%20in%20the%20Palaeogene.%20The%20forearc%20basin%20widened%20and%20enlarged,%20and%20was%20supplied%20with%20voluminous%20sediment%20primarily%20derived%20from%20the%20coeval%20magmatic%20arc%20to%20the%20east.%20However,%20significant%20quantities%20of%20ophiolitic%20detritus%20(chert,%20and%20sedimentary,%20mafic%20volcanic%20and%20mafic%20metavolcanic%20lithic%20fragments)%20occur%20in%20the%20lower%20Great%20Valley%20strata,%20thus%20indicating%20erosion%20of%20%E2%80%98tectonic%20highlands%E2%80%99%20formed%20during%20arc-arc%20collision%20immediately%20preceeding%20initiation%20of%20the%20late%20Mesozoic%20subduction%20regime.The%20Great%20Valley%20forearc%20owes%20its%20geometry%20and%20history%20to%20the%20peculiarities%20of%20subduction%20initiation%20and%20to%20the%20shapes%20of%20the%20continental%20margin%20and%20magmatic%20arcs%20extant%20before%20initiation%20of%20the%20Great%20Valley%20subduction%20phase.%20The%20residual%20forearc%20developed%20on%20oceanic%20crust%20that%20had%20formed%20previously%20by%20spreading%20behind%20an%20east-facing%20intraoceanic%20arc.%20After%20this%20east-facing%20arc%20collided%20with%20the%20west-facing%20continental-margin%20arc,%20a%20new%20trench%20formed%20west%20of%20the%20suture%20belt.%20The%20shape%20of%20the%20new%20continental%20margin%20was%20irregular,%20so%20that%20a%20wide%20residual%20forearc%20basin%20formed%20in%20the%20Great%20Valley%20area,%20whereas%20no%20residual%20forearc%20basin%20formed%20to%20the%20north%20(Klamath%20area)%20or%20possibly,%20to%20the%20south%20(southern%20California%20borderland%20area%20that%20has%20been%20dislocated%20by%20Neogene%20strike-slip%20motions).%20The%20northern%20coastal%20promontory%20(Klamath%20area)%20provided%20much%20of%20the%20ophiolitic%20detritus%20within%20the%20lower%20part%20of%20the%20Great%20Valley%20strata.%20Sediment%20derived%20from%20the%20Klamaths%20was%20transported%20southward%20directly%20into%20the%20forearc%20basin,%20as%20well%20as%20westwards%20and%20then%20southwards%20into%20the%20trench%20west%20of%20the%20forearc%20basin.%20The%20Great%20Valley%20forearc%20basin%20is%20preserved%20and%20displayed%20so%20well%20today%20due%20to%20its%20mode%20of%20initiation%20(residual%20forearc%20formed%20in%20a%20previously%20backarc%20area)%20and%20its%20mode%20of%20termination%20(northward%20migration%20of%20a%20triple%20junction%20that%20converted%20a%20convergent%20margin%20into%20a%20transform%20margin).}}

@article{HAGGART1984a,
	annote = {10.1130/0016-7606(1984)95<618:LCSSOT>2.0.CO;2},
	author = {HAGGART, JAMES W. and WARD, PETER D.},
	date = {1984/05/01},
	date-added = {2016-03-29 21:39:16 +0000},
	date-modified = {2016-03-29 21:39:16 +0000},
	journal = {Geological Society of America Bulletin},
	journal1 = {Geological Society of America Bulletin},
	month = {05},
	number = {5},
	pages = {618--627},
	title = {Late Cretaceous (Santonian-Campanian) stratigraphy of the northern Sacramento Valley, California},
	ty = {JOUR},
	url = {http://gsabulletin.gsapubs.org/content/95/5/618.abstract N2 - The Upper Cretaceous (Coniacian–lower Campanian) Chico Formation of the northeastern Sacramento Valley, California, includes three newly defined members at the type locality: (1) cobble conglomerate of the basal Ponderosa Way Member, (2) coarse-grained conglomeratic sandstone of the overlying Musty Buck Member, and (3) fine-grained silty sandstone of the uppermost Ten Mile Member. Other outcrops of the Chico Formation exhibit the same three members plus an additional unit, the Kingsley Cave Member, composed of mudstone. The Chico Formation resulted from a transgression onto the Sierra Nevada basement in the Late Cretaceous. The Kingsley Cave Member was deposited locally in quiet-water conditions below wave base in an intrashelf basin and may represent a marine connection with regions farther northeast.Macrofossils allow correlation of the Chico Formation with marine deposits of the Great Valley sequence exposed along the western Sacramento Valley. Strata of the Guinda and Forbes Formations represent submarine fan-channel to outer-fan deposits of a shallowing Late Cretaceous fore-arc basin. The Santonian Guinda Formation, a massive sand unit deposited in fan-channel to distal-fan turbidite environments, is correlative with the Musty Buck and Kingsley Cave Members of the Chico Formation. The Dobbins Shale Member of the Forbes Formation, a widespread mudstone unit of hemipelagic outer-fan to basin-plain deposits, is correlative with the Kingsley Cave Member of the Chico Formation and reflects a Santonian transgressive event in the northern fore-arc basin. Mudstones and turbidites of the middle of the Forbes Formation are equivalent to the shallow-marine strata of the Ten Mile Member of the Chico Formation. Correlatives of younger Forbes Formation strata have not been positively identified from the Chico Creek region but may be represented by unfossiliferous, cross-bedded, coarse-grained sandstones found above sections of the Chico Formation.},
	volume = {95},
	year = {1984},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://gsabulletin.gsapubs.org/content/95/5/618.abstract%20N2%20-%20The%20Upper%20Cretaceous%20(Coniacian%E2%80%93lower%20Campanian)%20Chico%20Formation%20of%20the%20northeastern%20Sacramento%20Valley,%20California,%20includes%20three%20newly%20defined%20members%20at%20the%20type%20locality:%20(1)%20cobble%20conglomerate%20of%20the%20basal%20Ponderosa%20Way%20Member,%20(2)%20coarse-grained%20conglomeratic%20sandstone%20of%20the%20overlying%20Musty%20Buck%20Member,%20and%20(3)%20fine-grained%20silty%20sandstone%20of%20the%20uppermost%20Ten%20Mile%20Member.%20Other%20outcrops%20of%20the%20Chico%20Formation%20exhibit%20the%20same%20three%20members%20plus%20an%20additional%20unit,%20the%20Kingsley%20Cave%20Member,%20composed%20of%20mudstone.%20The%20Chico%20Formation%20resulted%20from%20a%20transgression%20onto%20the%20Sierra%20Nevada%20basement%20in%20the%20Late%20Cretaceous.%20The%20Kingsley%20Cave%20Member%20was%20deposited%20locally%20in%20quiet-water%20conditions%20below%20wave%20base%20in%20an%20intrashelf%20basin%20and%20may%20represent%20a%20marine%20connection%20with%20regions%20farther%20northeast.Macrofossils%20allow%20correlation%20of%20the%20Chico%20Formation%20with%20marine%20deposits%20of%20the%20Great%20Valley%20sequence%20exposed%20along%20the%20western%20Sacramento%20Valley.%20Strata%20of%20the%20Guinda%20and%20Forbes%20Formations%20represent%20submarine%20fan-channel%20to%20outer-fan%20deposits%20of%20a%20shallowing%20Late%20Cretaceous%20fore-arc%20basin.%20The%20Santonian%20Guinda%20Formation,%20a%20massive%20sand%20unit%20deposited%20in%20fan-channel%20to%20distal-fan%20turbidite%20environments,%20is%20correlative%20with%20the%20Musty%20Buck%20and%20Kingsley%20Cave%20Members%20of%20the%20Chico%20Formation.%20The%20Dobbins%20Shale%20Member%20of%20the%20Forbes%20Formation,%20a%20widespread%20mudstone%20unit%20of%20hemipelagic%20outer-fan%20to%20basin-plain%20deposits,%20is%20correlative%20with%20the%20Kingsley%20Cave%20Member%20of%20the%20Chico%20Formation%20and%20reflects%20a%20Santonian%20transgressive%20event%20in%20the%20northern%20fore-arc%20basin.%20Mudstones%20and%20turbidites%20of%20the%20middle%20of%20the%20Forbes%20Formation%20are%20equivalent%20to%20the%20shallow-marine%20strata%20of%20the%20Ten%20Mile%20Member%20of%20the%20Chico%20Formation.%20Correlatives%20of%20younger%20Forbes%20Formation%20strata%20have%20not%20been%20positively%20identified%20from%20the%20Chico%20Creek%20region%20but%20may%20be%20represented%20by%20unfossiliferous,%20cross-bedded,%20coarse-grained%20sandstones%20found%20above%20sections%20of%20the%20Chico%20Formation.}}

@article{DICKINSON1972a,
	annote = {10.1130/0016-7606(1972)83{$[$}3007:PIAPIT{$]$}2.0.CO;2},
	author = {DICKINSON, WILLIAM R and RICH, ERNEST I},
	date = {1972/10/01},
	date-added = {2016-03-29 21:35:41 +0000},
	date-modified = {2016-03-29 21:35:41 +0000},
	journal = {Geological Society of America Bulletin},
	journal1 = {Geological Society of America Bulletin},
	month = {10},
	number = {10},
	pages = {3007--3024},
	title = {Petrologic Intervals and Petrofacies in the Great Valley Sequence, Sacramento Valley, California},
	ty = {JOUR},
	url = {http://gsabulletin.gsapubs.org/content/83/10/3007.abstract N2 - The Great Valley Sequence of Upper Jurassic to Upper Cretaceous strata is composed of clastic detritus eroded from the Sierran-Klamath belt, which was the site of a late Mesozoic magmatic arc. The sequence accumulated mainly as a prismatic wedge of turbidites in an asymmetric trough within the arc-trench gap. Stratigraphic variations in detrital sandstone mineralogy define five petrologic intervals, or nearly synchronous petrofacies, useful for regional correlation. By contrast, local lithofacies are markedly lenticular. The clastic debris in the sequence was derived mainly from volcanic and plutonic rocks in varying proportions. The parameters used to define the petrofacies include: (a) content of quartzose grains (Q), feldspar grains (F), and unstable lithic fragments (L) expressed as volumetric percentages of the Q-F-L population; (b) ratios of plagioclase to total feldspar (P/F) and volcanic rock fragments to total unstable lithic fragments (V/L), and (c) content of mica (M) expressed as volumetric percentage of framework sand grains. The most distinctive characteristics of the petrofacies recognized, and their approximate time-stratigraphic spans, are as follows: (1) Stony Creek (Tithonian-Neocomian): quartz-poor and feldspatholithic sandstones with high P/F, high V/L, low M; (2) Lodoga (Aptian-Albian): quartz-rich sandstones with high P/F; (3) Boxer (Cenomanian): two distinct variants with moderate P/F, one quartz-rich and the other quartz-poor and feldspatholithic; (4) Cortina (Turonian-Coniacian): two similar variants with moderate P/F, one with Q-F-L proportions nearly equal and the other quartz-poor and feld-spatholithic; (5) Rumsey (Santonian-Campanian): quartz-rich lithofeldspathic with low P/F and high M. The nature of the petrofacies and their age can be related to the petrology and timing of dated intrusive episodes with inferred volcanic accompaniments in the Sierra Nevada. The Stony Creek petrofacies contains mainly volcanic debris erupted during the Yosemite magmatic epoch, and the overlying Lodoga petrofacies contains mainly plutonic debris emplaced during the same epoch, but only exposed to erosion by subsequent dissection. The Boxer and Cortina petrofacies contain mixed and intercalated volcanic and plutonic debris derived mainly from rocks erupted or emplaced during the Huntington Lake magmatic epoch. The slight differences between the Boxer and Cortina petrofacies may indicate that plutonic contributions were partly from older rocks for the Boxer, but volcanic contributions were essentially the same for both. The Rumsey facies contains mainly plutonic debris, with subordinate volcanic debris, derived from igneous rocks of the Cathedral Range magmatic epoch. Except locally or slightly, petrofacies boundaries do not transgress time-stratigraphic boundaries in the region. A close linkage among major magmatic, tectonic, and depositional events in arc-trench systems is implied.},
	volume = {83},
	year = {1972},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://gsabulletin.gsapubs.org/content/83/10/3007.abstract%20N2%20-%20The%20Great%20Valley%20Sequence%20of%20Upper%20Jurassic%20to%20Upper%20Cretaceous%20strata%20is%20composed%20of%20clastic%20detritus%20eroded%20from%20the%20Sierran-Klamath%20belt,%20which%20was%20the%20site%20of%20a%20late%20Mesozoic%20magmatic%20arc.%20The%20sequence%20accumulated%20mainly%20as%20a%20prismatic%20wedge%20of%20turbidites%20in%20an%20asymmetric%20trough%20within%20the%20arc-trench%20gap.%20Stratigraphic%20variations%20in%20detrital%20sandstone%20mineralogy%20define%20five%20petrologic%20intervals,%20or%20nearly%20synchronous%20petrofacies,%20useful%20for%20regional%20correlation.%20By%20contrast,%20local%20lithofacies%20are%20markedly%20lenticular.%20The%20clastic%20debris%20in%20the%20sequence%20was%20derived%20mainly%20from%20volcanic%20and%20plutonic%20rocks%20in%20varying%20proportions.%20The%20parameters%20used%20to%20define%20the%20petrofacies%20include:%20(a)%20content%20of%20quartzose%20grains%20(Q),%20feldspar%20grains%20(F),%20and%20unstable%20lithic%20fragments%20(L)%20expressed%20as%20volumetric%20percentages%20of%20the%20Q-F-L%20population;%20(b)%20ratios%20of%20plagioclase%20to%20total%20feldspar%20(P/F)%20and%20volcanic%20rock%20fragments%20to%20total%20unstable%20lithic%20fragments%20(V/L),%20and%20(c)%20content%20of%20mica%20(M)%20expressed%20as%20volumetric%20percentage%20of%20framework%20sand%20grains.%20The%20most%20distinctive%20characteristics%20of%20the%20petrofacies%20recognized,%20and%20their%20approximate%20time-stratigraphic%20spans,%20are%20as%20follows:%20(1)%20Stony%20Creek%20(Tithonian-Neocomian):%20quartz-poor%20and%20feldspatholithic%20sandstones%20with%20high%20P/F,%20high%20V/L,%20low%20M;%20(2)%20Lodoga%20(Aptian-Albian):%20quartz-rich%20sandstones%20with%20high%20P/F;%20(3)%20Boxer%20(Cenomanian):%20two%20distinct%20variants%20with%20moderate%20P/F,%20one%20quartz-rich%20and%20the%20other%20quartz-poor%20and%20feldspatholithic;%20(4)%20Cortina%20(Turonian-Coniacian):%20two%20similar%20variants%20with%20moderate%20P/F,%20one%20with%20Q-F-L%20proportions%20nearly%20equal%20and%20the%20other%20quartz-poor%20and%20feld-spatholithic;%20(5)%20Rumsey%20(Santonian-Campanian):%20quartz-rich%20lithofeldspathic%20with%20low%20P/F%20and%20high%20M.%20The%20nature%20of%20the%20petrofacies%20and%20their%20age%20can%20be%20related%20to%20the%20petrology%20and%20timing%20of%20dated%20intrusive%20episodes%20with%20inferred%20volcanic%20accompaniments%20in%20the%20Sierra%20Nevada.%20The%20Stony%20Creek%20petrofacies%20contains%20mainly%20volcanic%20debris%20erupted%20during%20the%20Yosemite%20magmatic%20epoch,%20and%20the%20overlying%20Lodoga%20petrofacies%20contains%20mainly%20plutonic%20debris%20emplaced%20during%20the%20same%20epoch,%20but%20only%20exposed%20to%20erosion%20by%20subsequent%20dissection.%20The%20Boxer%20and%20Cortina%20petrofacies%20contain%20mixed%20and%20intercalated%20volcanic%20and%20plutonic%20debris%20derived%20mainly%20from%20rocks%20erupted%20or%20emplaced%20during%20the%20Huntington%20Lake%20magmatic%20epoch.%20The%20slight%20differences%20between%20the%20Boxer%20and%20Cortina%20petrofacies%20may%20indicate%20that%20plutonic%20contributions%20were%20partly%20from%20older%20rocks%20for%20the%20Boxer,%20but%20volcanic%20contributions%20were%20essentially%20the%20same%20for%20both.%20The%20Rumsey%20facies%20contains%20mainly%20plutonic%20debris,%20with%20subordinate%20volcanic%20debris,%20derived%20from%20igneous%20rocks%20of%20the%20Cathedral%20Range%20magmatic%20epoch.%20Except%20locally%20or%20slightly,%20petrofacies%20boundaries%20do%20not%20transgress%20time-stratigraphic%20boundaries%20in%20the%20region.%20A%20close%20linkage%20among%20major%20magmatic,%20tectonic,%20and%20depositional%20events%20in%20arc-trench%20systems%20is%20implied.}}

