@article{DeCelles2007a,
	annote = {10.1130/B26074.1},
	author = {DeCelles, P. G. and Kapp, P. and Ding, L. and Gehrels, G. E.},
	date = {May/June, 2007},
	date-added = {2012-10-12 23:43:17 +0000},
	date-modified = {2012-10-29 20:46:17 +0000},
	journal = {Geological Society of America Bulletin},
	journal1 = {Geological Society of America Bulletin},
	number = {5-6},
	pages = {654--680},
	title = {Late Cretaceous to middle Tertiary basin evolution in the central Tibetan Plateau: Changing environments in response to tectonic partitioning, aridification, and regional elevation gain},
	ty = {JOUR},
	volume = {119},
	year = {2007},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://gsabulletin.gsapubs.org/content/119/5-6/654.abstract%20N2%20-%20Located%20in%20the%20Bangong%20suture%20zone%20between%20the%20Lhasa%20and%20Qiangtang%20terranes%20of%20central%20Tibet,%20the%20Nima%20basin%20records%20Cretaceous%E2%80%93late%20Miocene%20sediment%20accumulation%20during%20a%20period%20of%20drastically%20changing%20paleogeography%20and%20paleoelevation.%20The%20Bangong%20suture%20zone%20originally%20formed%20during%20Late%20Jurassic%E2%80%93Early%20Cretaceous%20time%20as%20the%20Lhasa%20terrane%20collided%20with%20the%20Qiang-tang%20terrane.%20During%20Early%20to%20middle%20Cretaceous%20time,%20the%20region%20lay%20at%20northern%20near-equatorial%20paleolatitudes,%20near%20sea%20level.%20By%20Aptian%20time%20the%20Nima%20basin%20was%20above%20sea%20level%20and%20was%20strongly%20influenced%20by%20nearby%20volcanic%20activity%20and%20crustal%20shortening%20in%20the%20reactivated%20Bangong%20suture%20zone.%20In%20the%20southern%20Nima%20basin,%20an%20%E2%88%BC50%20m.y.%20(Late%20Cretaceous%E2%80%93Eocene)%20depositional%20hiatus%20correlates%20with%20major%20crustal%20shortening%20and%20ensuing%20voluminous%20ignimbrite%20eruptions%20in%20the%20Lhasa%20terrane.%20In%20the%20northern%20Nima%20basin,%20deposition%20continued%20during%20latest%20Cretaceous%20time,%20recording%20arid%20paleoclimate%20in%20evaporitic%20lacustrine%20and%20eolian%20dunefield%20deposits.%20By%20Oligocene%20time%20the%20Nima%20basin%20comprised%20two%20independent%20depocenters%20that%20accumulated%20coarse-grained%20alluvial,%20fluvial,%20lacustrine%20(evaporitic),%20and%20fan-delta%20deposits%20in%20close%20association%20with%20reactivated%20thrusts%20in%20the%20Bangong%20suture%20zone.Carbon%20and%20oxygen%20isotope%20data%20from%20Oligocene%20paleosol%20carbonate,%20reported%20elsewhere,%20indicate%20that%20regional%20paleoelevation%20during%20the%20late%20Oligocene%20was%20%3E4.6%20km,%20as%20it%20is%20today.%20Overall,%20the%20depositional%20record%20of%20the%20Nima%20basin,%20combined%20with%20ongoing%20structural%20and%20geochronologic%20studies,%20demonstrates%20that%20the%20Bangong%20suture%20zone%20was%20reactivated%20during%20middle%20Cretaceous%20and%20middle%20Tertiary%20time,%20that%20the%20intervening%20%E2%88%BC50%20m.y.%20interval%20was%20a%20time%20of%20regional%20upper%20crustal%20shortening%20in%20the%20Lhasa%20terrane%20followed%20by%20regional%20ignimbrite%20eruptions,%20and%20that%20arid%20paleoclimate%20and%20high%20paleoelevation%20were%20established%20by%20the%20Late%20Cretaceous%20and%20late%20Oligocene,%20respectively.Within%20the%20context%20of%20other%20data%20sets%20from%20the%20Lhasa%20terrane,%20the%20record%20of%20deposition%20in%20the%20Nima%20basin%20is%20consistent%20with%20low-angle%20subduction%20of%20Neotethyan%20oceanic%20lithosphere%20and%20reactivation%20of%20the%20Bangong%20suture%20zone%20during%20the%20Early%20Cretaceous,%20followed%20by%20shortening%20within%20the%20Gangdese%20retroarc%20and%20northern%20Lhasa%20terrane%20thrust%20belts%20during%20the%20Late%20Cretaceous,%20lithospheric%20delamination-dripping%20and%20regional%20magmatic%20flare-up%20during%20latest%20Cretaceous%20through%20early%20Tertiary%20time,%20and%20underthrusting%20of%20Indian%20lower%20crust%20and%20lithosphere%20as%20far%20north%20as%20the%20Bangong%20suture%20zone%20during%20late%20Oligocene%20time.}}

@article{Zhu2011b,
