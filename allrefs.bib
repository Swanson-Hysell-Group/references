	doi = {10.1093/gji/ggv451},
	journal = {Geophysical Journal International},
	month = {01},
	number = {1},
	pages = {274--291},
	title = {Principal component analysis of palaeomagnetic directions: converting a {Maximum Angular Deviation (MAD)} into an α95 angle},
	volume = {204},
	year = {2016},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://gji.oxfordjournals.org/content/204/1/274.abstract%20N2%20-%20Directions%20recovered%20from%20palaeomagnetic%20samples%20are%20usually%20archived%20with%20some%20quantitative%20information%20about%20their%20precision,%20most%20often%20in%20the%20form%20of%20a%20so-called%20%CE%B195%20angle.%20Such%20angles%20are%20classically%20co-estimated%20with%20the%20recovered%20palaeomagnetic%20direction%20from%20a%20collection%20of%20samples%20providing%20individual%20estimates%20of%20this%20direction.%20In%20some%20instances,%20however,%20palaeomagnetic%20directions%20have%20to%20be%20inferred%20from%20a%20single%20sample%20in%20which%20case%20no%20%CE%B195%20angle%20can%20be%20recovered%20in%20this%20way.%20Fortunately,%20the%20progressive%20demagnetization%20techniques%20and%20principal%20component%20analysis%20universally%20used%20to%20recover%20directional%20information%20from%20single%20samples%20provide%20alternative%20measures%20of%20the%20error%20affecting%20the%20recovered%20direction,%20known%20as%20Maximum%20Angular%20Deviation%20(MAD)%20angles.%20These%20have%20so%20far%20only%20been%20considered%20as%20rough%20quality%20indicators.%20Here,%20however,%20we%20show%20that%20directions%20recovered%20in%20this%20way%20can%20be%20assumed%20to%20satisfy%20a%20Fisher%20distribution,%20and%20that%20the%20corresponding%20MAD%20angles%20can%20be%20rescaled%20into%20%CE%B195%20estimates%20by%20multiplying%20it%20by%20an%20appropriate%20factor,%20which%20only%20depends%20on%20the%20number%20of%20demagnetization%20steps%20used%20in%20the%20principal%20component%20analysis%20and%20on%20whether%20one%20relies%20on%20a%20standard%20or%20a%20so-called%20%E2%80%98anchored%E2%80%99%20principal%20component%20analysis.%20These%20coefficients%20have%20been%20tabulated%20and%20practical%20recommendations%20for%20taking%20advantage%20of%20them%20outlined%20in%20the%20final%20section%20of%20the%20text.%20They%20provide%20simple%20means%20for%20users%20to%20produce%20much%20needed%20error%20bars%20on%20declination%20and%20inclination%20time%20series%20recovered%20from%20sedimentary%20long%20sequences.}}

