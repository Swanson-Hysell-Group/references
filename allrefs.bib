@article{Tangborn2015a,
	author = {Tangborn, Andrew and Kuang, Weijia},
	date = {2015/01/01},
	date-added = {2015-04-15 00:09:49 +0000},
	date-modified = {2015-04-15 00:09:49 +0000},
	journal = {Geophysical Journal International},
	m3 = {10.1093/gji/ggu409},
	month = {01},
	number = {1},
	pages = {664--675},
	title = {Geodynamo model and error parameter estimation using geomagnetic data assimilation},
	ty = {JOUR},
	url = {http://gji.oxfordjournals.org/content/200/1/664.abstract N2 - We have developed a new geomagnetic data assimilation approach which uses the minimum variance’ estimate for the analysis state, and which models both the forecast (or model output) and observation errors using an empirical approach and parameter tuning. This system is used in a series of assimilation experiments using Gauss coefficients (hereafter referred to as observational data) from the GUFM1 and CM4 field models for the years 1590–1990. We show that this assimilation system could be used to improve our knowledge of model parameters, model errors and the dynamical consistency of observation errors, by comparing forecasts of the magnetic field with the observations every 20 yr. Statistics of differences between observation and forecast (O − F) are used to determine how forecast accuracy depends on the Rayleigh number, forecast error correlation length scale and an observation error scale factor. Experiments have been carried out which demonstrate that a Rayleigh number of 30 times the critical Rayleigh number produces better geomagnetic forecasts than lower values, with an Ekman number of E = 1.25 × 10−6, which produces a modified magnetic Reynolds number within the parameter domain with an ‘Earth like’ geodynamo. The optimal forecast error correlation length scale is found to be around 90 per cent of the thickness of the outer core, indicating a significant bias in the forecasts. Geomagnetic forecasts are also found to be highly sensitive to estimates of modelled observation errors: Errors that are too small do not lead to the gradual reduction in forecast error with time that is generally expected in a data assimilation system while observation errors that are too large lead to model divergence. Finally, we show that assimilation of L ≤ 3 (or large scale) gauss coefficients can help to improve forecasts of the L > 5 (smaller scale) coefficients, and that these improvements are the result of corrections to the velocity field in the geodynamo model.},
	volume = {200},
	year = {2015},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://gji.oxfordjournals.org/content/200/1/664.abstract%20N2%20-%20We%20have%20developed%20a%20new%20geomagnetic%20data%20assimilation%20approach%20which%20uses%20the%20minimum%20variance%E2%80%99%20estimate%20for%20the%20analysis%20state,%20and%20which%20models%20both%20the%20forecast%20(or%20model%20output)%20and%20observation%20errors%20using%20an%20empirical%20approach%20and%20parameter%20tuning.%20This%20system%20is%20used%20in%20a%20series%20of%20assimilation%20experiments%20using%20Gauss%20coefficients%20(hereafter%20referred%20to%20as%20observational%20data)%20from%20the%20GUFM1%20and%20CM4%20field%20models%20for%20the%20years%201590%E2%80%931990.%20We%20show%20that%20this%20assimilation%20system%20could%20be%20used%20to%20improve%20our%20knowledge%20of%20model%20parameters,%20model%20errors%20and%20the%20dynamical%20consistency%20of%20observation%20errors,%20by%20comparing%20forecasts%20of%20the%20magnetic%20field%20with%20the%20observations%20every%2020%20yr.%20Statistics%20of%20differences%20between%20observation%20and%20forecast%20(O%20%E2%88%92%20F)%20are%20used%20to%20determine%20how%20forecast%20accuracy%20depends%20on%20the%20Rayleigh%20number,%20forecast%20error%20correlation%20length%20scale%20and%20an%20observation%20error%20scale%20factor.%20Experiments%20have%20been%20carried%20out%20which%20demonstrate%20that%20a%20Rayleigh%20number%20of%2030%20times%20the%20critical%20Rayleigh%20number%20produces%20better%20geomagnetic%20forecasts%20than%20lower%20values,%20with%20an%20Ekman%20number%20of%20E%20=%201.25%20%C3%97%2010%E2%88%926,%20which%20produces%20a%20modified%20magnetic%20Reynolds%20number%20within%20the%20parameter%20domain%20with%20an%20%E2%80%98Earth%20like%E2%80%99%20geodynamo.%20The%20optimal%20forecast%20error%20correlation%20length%20scale%20is%20found%20to%20be%20around%2090%20per%20cent%20of%20the%20thickness%20of%20the%20outer%20core,%20indicating%20a%20significant%20bias%20in%20the%20forecasts.%20Geomagnetic%20forecasts%20are%20also%20found%20to%20be%20highly%20sensitive%20to%20estimates%20of%20modelled%20observation%20errors:%20Errors%20that%20are%20too%20small%20do%20not%20lead%20to%20the%20gradual%20reduction%20in%20forecast%20error%20with%20time%20that%20is%20generally%20expected%20in%20a%20data%20assimilation%20system%20while%20observation%20errors%20that%20are%20too%20large%20lead%20to%20model%20divergence.%20Finally,%20we%20show%20that%20assimilation%20of%20L%20%E2%89%A4%203%20(or%20large%20scale)%20gauss%20coefficients%20can%20help%20to%20improve%20forecasts%20of%20the%20L%20%3E%205%20(smaller%20scale)%20coefficients,%20and%20that%20these%20improvements%20are%20the%20result%20of%20corrections%20to%20the%20velocity%20field%20in%20the%20geodynamo%20model.}}

