@article{Mattei2014a,
	annote = {10.1130/G35467.1},
	author = {Mattei, Massimo and Muttoni, Giovanni and Cifelli, Francesca},
	date = {2014/06/01},
	date-added = {2015-05-21 23:49:19 +0000},
	date-modified = {2015-05-27 05:33:32 +0000},
	doi = {10.1130/G35467.1},
	journal = {Geology},
	journal1 = {Geology},
	month = {06},
	number = {6},
	pages = {555--558},
	title = {{A record of the Jurassic massive plate shift from the Garedu Formation of central Iran}},
	ty = {JOUR},
	volume = {42},
	year = {2014},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://geology.gsapubs.org/content/42/6/555.abstract%20N2%20-%20Modern%20generations%20of%20apparent%20polar%20wander%20paths%20(APWPs)%20show%20the%20occurrence%20in%20North%20American%20and%20African%20coordinates%20of%20a%20major%20and%20rapid%20shift%20in%20pole%20position%20(plate%20shift)%20during%20the%20Middle%20to%20Late%20Jurassic%20(175%E2%80%93145%20Ma)%20that%20alternative%20curves%20from%20the%20literature%20tend%20to%20underestimate.%20This%20Jurassic%20massive%20polar%20shift%20(JMPS),%20of%20vast%20and%20as-yet%20unexplored%20paleogeographic%20implications,%20is%20also%20predicted%20for%20Eurasia%20from%20the%20North%20Atlantic%20plate%20circuit,%20but%20Jurassic%20data%20from%20this%20continent%20are%20scanty%20and%20problematic.%20Here%20we%20present%20paleomagnetic%20data%20from%20the%20Kimmeridgian%E2%80%93Tithonian%20(upper%20Jurassic)%20Garedu%20Formation%20of%20Iran,%20which%20was%20part%20of%20Eurasia%20since%20the%20Triassic.%20Paleomagnetic%20component%20directions%20of%20primary%20(pre-folding)%20age%20indicate%20a%20paleolatitude%20of%20deposition%20that%20is%20in%20excellent%20agreement%20with%20the%20latitude%20drop%20predicted%20for%20Iran%20from%20APWPs%20incorporating%20the%20JMPS.%20Moreover,%20we%20show%20that%20paleolatitudes%20calculated%20from%20these%20APWPs,%20used%20in%20conjunction%20with%20simple%20zonal%20climate%20belts,%20better%20explain%20the%20overall%20stratigraphic%20evolution%20of%20Iran%20during%20the%20Mesozoic.%20As%20Iran%20drifted%20from%20the%20tropical%20arid%20belt%20to%20the%20mid-latitude%20humid%20belt%20in%20the%20Late%20Triassic,%20carbonate%20platform%20productivity%20stopped%20while%20widespread%20coal-bearing%20sedimentation%20started,%20whereas%20as%20Iran%20returned%20to%20arid%20tropical%20latitudes%20during%20the%20JMPS,%20carbonate%20platform%20productivity%20and%20evaporitic%20sedimentation%20resumed.%20These%20results%20illustrate%20(1)%20the%20potent,%20but%20often%20neglected,%20control%20that%20plate%20motion%20(continental%20drift%20and/or%20true%20polar%20wander)%20across%20zonal%20climate%20belts%20exerts%20on%20the%20genesis%20of%20sedimentary%20facies;%20and%20(2)%20the%20importance%20of%20precisely%20controlled%20paleogeographic%20reconstructions%20for%20tectonic%20interpretations,%20especially%20during%20times%20of%20fast%20plate%20motion%20like%20the%20Jurassic.%20As%20a%20suggestion%20for%20future%20research,%20we%20predict%20that%20the%20adoption%20of%20Eurasian%20reference%20paleopoles%20incorporating%20the%20JMPS%20may%20lead%20to%20a%20reconciliation%20(or%20reinterpretation)%20of%20existing%20geologic%20and%20paleomagnetic%20data%20regarding%20the%20deformation%20history%20of%20central%20Asia.}}

