	bdsk-url-1 = {http://www.pnas.org/content/108/14/5542.abstract%20N2%20-%20The%20cycles%20of%20carbon%20and%20oxygen%20at%20the%20Earth%20surface%20are%20intimately%20linked,%20where%20the%20burial%20of%20organic%20carbon%20into%20sediments%20represents%20a%20source%20of%20oxygen%20to%20the%20surface%20environment.%20This%20coupling%20is%20typically%20quantified%20through%20the%20isotope%20records%20of%20organic%20and%20inorganic%20carbon.%20Yet,%20the%20late%20Neoproterozoic%20Eon,%20the%20time%20when%20animals%20first%20evolved,%20experienced%20wild%20isotope%20fluctuations%20which%20do%20not%20conform%20to%20our%20normal%20understanding%20of%20the%20carbon%20cycle%20and%20carbon-oxygen%20coupling.%20We%20interpret%20these%20fluctuations%20with%20a%20new%20carbon%20cycle%20model%20and%20demonstrate%20that%20all%20of%20the%20main%20features%20of%20the%20carbonate%20and%20organic%20carbon%20isotope%20record%20can%20be%20explained%20by%20the%20release%20of%20methane%20hydrates%20from%20an%20anoxic%20dissolved%20organic%20carbon-rich%20ocean%20into%20an%20atmosphere%20containing%20oxygen%20levels%20considerably%20less%20than%20today.}}

@article{Dalziel2010a,
