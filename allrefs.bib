@article{Cao2013a,
	author = {Cao, Xiaobin and Bao, Huiming},
	date = {2013/07/29},
	date-added = {2014-03-11 02:04:43 +0000},
	date-modified = {2014-03-11 02:04:43 +0000},
	journal = {Proceedings of the National Academy of Sciences},
	m3 = {10.1073/pnas.1302972110},
	month = {07},
	title = {Dynamic model constraints on oxygen-17 depletion in atmospheric O2 after a snowball Earth},
	ty = {JOUR},
	url = {http://www.pnas.org/content/early/2013/07/24/1302972110.abstract N2 - A large perturbation in atmospheric CO2 and O2 or bioproductivity will result in a drastic pulse of 17O change in atmospheric O2, as seen in the Marinoan Oxygen-17 Depletion (MOSD) event in the immediate aftermath of a global deglaciation 635 Mya. The exact nature of the perturbation, however, is debated. Here we constructed a coupled, four-box, and quick-response biosphere–atmosphere model to examine both the steady state and dynamics of the MOSD event. Our model shows that the ultra-high CO2 concentrations proposed by the “snowball’ Earth hypothesis produce a typical MOSD duration of less than 106 y and a magnitude of 17O depletion reaching approximately −35‰. Both numbers are in remarkable agreement with geological constraints from South China and Svalbard. Moderate CO2 and low O2 concentration (e.g., 3,200 parts per million by volume and 0.01 bar, respectively) could produce distinct sulfate 17O depletion only if postglacial marine bioproductivity was impossibly low. Our dynamic model also suggests that a snowball in which the ocean is isolated from the atmosphere by a continuous ice cover may be distinguished from one in which cracks in the ice permit ocean–atmosphere exchange only if partial pressure of atmospheric O2 is larger than 0.02 bar during the snowball period and records of weathering-derived sulfate are available for the very first few tens of thousands of years after the onset of the meltdown. In any case, a snowball Earth is a precondition for the observed MOSD event.},
	year = {2013},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://www.pnas.org/content/early/2013/07/24/1302972110.abstract%20N2%20-%20A%20large%20perturbation%20in%20atmospheric%20CO2%20and%20O2%20or%20bioproductivity%20will%20result%20in%20a%20drastic%20pulse%20of%2017O%20change%20in%20atmospheric%20O2,%20as%20seen%20in%20the%20Marinoan%20Oxygen-17%20Depletion%20(MOSD)%20event%20in%20the%20immediate%20aftermath%20of%20a%20global%20deglaciation%20635%20Mya.%20The%20exact%20nature%20of%20the%20perturbation,%20however,%20is%20debated.%20Here%20we%20constructed%20a%20coupled,%20four-box,%20and%20quick-response%20biosphere%E2%80%93atmosphere%20model%20to%20examine%20both%20the%20steady%20state%20and%20dynamics%20of%20the%20MOSD%20event.%20Our%20model%20shows%20that%20the%20ultra-high%20CO2%20concentrations%20proposed%20by%20the%20%E2%80%9Csnowball%E2%80%99%20Earth%20hypothesis%20produce%20a%20typical%20MOSD%20duration%20of%20less%20than%20106%20y%20and%20a%20magnitude%20of%2017O%20depletion%20reaching%20approximately%20%E2%88%9235%E2%80%B0.%20Both%20numbers%20are%20in%20remarkable%20agreement%20with%20geological%20constraints%20from%20South%20China%20and%20Svalbard.%20Moderate%20CO2%20and%20low%20O2%20concentration%20(e.g.,%203,200%20parts%20per%20million%20by%20volume%20and%200.01%20bar,%20respectively)%20could%20produce%20distinct%20sulfate%2017O%20depletion%20only%20if%20postglacial%20marine%20bioproductivity%20was%20impossibly%20low.%20Our%20dynamic%20model%20also%20suggests%20that%20a%20snowball%20in%20which%20the%20ocean%20is%20isolated%20from%20the%20atmosphere%20by%20a%20continuous%20ice%20cover%20may%20be%20distinguished%20from%20one%20in%20which%20cracks%20in%20the%20ice%20permit%20ocean%E2%80%93atmosphere%20exchange%20only%20if%20partial%20pressure%20of%20atmospheric%20O2%20is%20larger%20than%200.02%20bar%20during%20the%20snowball%20period%20and%20records%20of%20weathering-derived%20sulfate%20are%20available%20for%20the%20very%20first%20few%20tens%20of%20thousands%20of%20years%20after%20the%20onset%20of%20the%20meltdown.%20In%20any%20case,%20a%20snowball%20Earth%20is%20a%20precondition%20for%20the%20observed%20MOSD%20event.}}

