@article{Halverson2011b,
	annote = {10.1144/M36.4},
	author = {Halverson, Galen P. and Shields-Zhou, Graham},
	date = {2011/01/01},
	date-added = {2012-02-28 21:46:27 +0000},
	date-modified = {2012-10-29 20:46:18 +0000},
	journal = {Geological Society, London, Memoirs},
	journal1 = {Geological Society, London, Memoirs},
	month = {01},
	number = {1},
	pages = {51--66},
	title = {Chapter 4 Chemostratigraphy and the Neoproterozoic glaciations},
	ty = {JOUR},
	volume = {36},
	year = {2011},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://mem.lyellcollection.org/content/36/1/51.abstract%20N2%20-%20Although%20the%20pre-glacial%20Proterozoic%20isotopic%20record%20is%20poorly%20constrained,%20it%20is%20apparent%20that%20the%20chemical%20and%20isotopic%20composition%20of%20the%20oceans%20began%20to%20change%20during%20the%20early%20to%20mid-Neoproterozoic%20and%20experienced%20considerable%20fluctuations%20alongside%20climatic%20instability%20during%20much%20of%20the%20subsequent%20Cryogenian%20and%20Ediacaran%20periods.%20The%20earliest%20known%20large%20negative%20%CE%B413C%20excursion%20appears%20to%20post-date%20811%20Ma%20and%20fluctuations%20became%20progressively%20more%20extreme,%20culminating%20in%20the%20late-Ediacaran%20%E2%80%98Shuram%E2%80%93Wonoka%E2%80%99%20anomaly.%20The%20negative%20excursions%20are%20commonly%20associated%20with%20pre-glacial%20and%20post-glacial%20times,%20while%20extremely%20high%20%CE%B413C%20values%20are%20characteristic%20of%20strata%20between%20glaciations.%20The%20precise%20causal%20mechanism%20for%20these%20excursions%20is%20subject%20to%20debate.%20Seawater%2087Sr/86Sr%20rose%20during%20the%20Neoproterozoic,%20with%20abrupt%20increases%20following%20deglaciation%20consistent%20with%20enhanced%20weathering%20rates.%20Reported%20marine%20sulphate%20and%20pyrite%20%CE%B434S%20data%20exhibit%20marked%20variation%20through%20this%20interval,%20although%20the%20changes%20are%20not%20always%20consistent%20within%20or%20between%20sedimentary%20successions%20of%20equivalent%20age.%20Iron-speciation%20studies%20indicate%20that%20much%20of%20this%20variation%20was%20caused%20by%20fluctuating%20and%20low%20sulphate%20concentrations%20in%20seawater,%20which%20at%20times%20led%20to%20the%20build-up%20of%20ferruginous%20conditions%20in%20the%20ocean.%20The%20application%20of%20chemostratigraphy%20to%20understanding%20and%20correlating%20the%20Neoproterozoic%20glaciations%20evokes%20considerable%20controversy,%20and%20many%20questions%20persist%20regarding%20the%20reliability%20and%20calibration%20of%20the%20%CE%B413C,%2087Sr/86Sr%20and%20%CE%B434S%20record.%20Nevertheless,%20the%20individual%20glaciations%20appear%20to%20be%20characterized%20by%20distinct%20combined%20chemostratigraphic%20signatures,%20in%20large%20part%20due%20to%20the%20generally%20increasing%20strontium%20isotope%20composition%20of%20seawater%20through%20the%20Neoproterozoic%20Era.}}

@article{Hill2011a,
	annote = {10.1144/M36.67},
	author = {Hill, Andrew C. and Haines, Peter W. and Grey, Kathleen},
	date = {2011/01/01},
	date-added = {2012-02-28 21:43:36 +0000},
	date-modified = {2012-10-29 20:46:18 +0000},
	journal = {Geological Society, London, Memoirs},
	journal1 = {Geological Society, London, Memoirs},
	month = {01},
	number = {1},
	pages = {677--691},
	title = {Chapter 67 Neoproterozoic glacial deposits of central Australia},
	ty = {JOUR},
	volume = {36},
	year = {2011},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://mem.lyellcollection.org/content/36/1/677.abstract%20N2%20-%20There%20are%20two%20distinct%20stratigraphic%20levels%20of%20Neoproterozoic%20glacigenic%20deposits%20in%20central%20Australia,%20both%20Cryogenian%20in%20age,%20spread%20over%20an%20area%20greater%20than%202.5%C3%97106%20km2.%20They%20were%20deposited%20in%20a%20once%20continuous%20intracratonic%20sag%20basin%20and%20are%20now%20preserved%20in%20four%20major%20structural%20basins:%20the%20Officer,%20Amadeus,%20Ngalia%20and%20Georgina%20Basins.%20In%20all%20four%20basins%20there%20are%20units%20that%20correlate%20with%20the%20(older)%20Sturt%20Tillite%20and%20equivalent%20glacial%20deposits%20in%20the%20Adelaide%20Rift%20Complex%20%E2%80%93%20the%20Sturt%20glaciation%20(Preiss%20et%20al.%202011)%20%E2%80%93%20and%20with%20the%20(younger)%20Elatina%20Formation%20(Fm.)%20and%20equivalents%20%E2%80%93%20the%20Elatina%20glaciation%20(Williams%20et%20al.%202008,%202011).%20The%20clearest%20evidence%20for%20glacial%20activity%20is%20the%20occurrence%20of%20diamictites%20that%20contain%20clasts%20of%20lithologically%20diverse%20origin%20which%20are%20often%20striated,%20faceted%20and%20polished,%20and%20the%20occurrence%20of%20dropstones.%20Most%20glacial%20deposits%20were%20deposited%20in%20shallow%20marine%20to%20fluvio-lacustrine%20palaeoenvironments.%20In%20all%20basins,%20the%20Elatina%20glacial%20deposits%20are%20overlain%20(at%20least%20locally)%20by%20dolostone%20units%20that%20mark%20the%20onset%20of%20post-glacial%20transgression%20and%20contain%20unique%20sedimentary%20and%20geochemical%20features.%20The%20cap%20dolomite%20units%20are%20distinct%20from%20dolomite%20beds%20within%20glaciogenic%20sediments,%20and%20those%20that%20occur%20near%20the%20top%20of%20Sturt%20glacial%20units%20in%20the%20Amadeus%20(Areyonga%20Fm.)%20and%20eastern%20Officer%20Basins%20(Chambers%20Bluff%20Tillite).None%20of%20the%20central%20Australian%20glacial%20units%20have%20direct%20geochronological%20constraints.%20There%20are,%20however,%20radiometric%20dates%20for%20a%20Sturt%20glacial%20unit%20in%20the%20Adelaide%20Rift%20Complex%20(Wilyerpa%20Fm.)%20and%20post-glacial%20shales%20in%20the%20Amadeus%20Basin%20(Aralka%20Fm.),%20Stuart%20Shelf%20(Tapley%20Hill%20Fm.)%20and%20Adelaide%20Rift%20Complex%20(Tapley%20Hill%20Fm.)%20that%20indicate%20a%20c.%20660%20Ma%20age%20for%20the%20Sturt%20glaciation%20in%20Australia%20(Kendall%20et%20al.%202006,%202007;%20Fanning%20&%20Link%202008).%20The%20age%20of%20the%20Elatina%20glaciation%20in%20Australia%20is%20constrained%20only%20by%20the%20age%20of%20the%20Sturt%20glaciation%20and%20the%20presence%20of%20the%20Ediacara%20fauna%20in%20overlying%20strata%20of%20all%20the%20basins%20except%20the%20Ngalia%20Basin.%20Consequently,%20correlations%20have%20been%20mainly%20established%20by%20means%20of%20lithostratigraphy,%20chemostratigraphy,%20palynology,%20and%20to%20a%20lesser%20extent,%20stromatolite%20biostratigraphy,%20mainly%20on%20the%20successions%20above%20and%20below%20the%20glacial%20units.%20Results%20from%20each%20of%20the%20above%20techniques%20show%20a%20remarkable%20consistency,%20and%20indicate%20that%20the%20two%20major%20Cryogenian%20glacial%20episodes%20are%20of%20similar%20age%20across%20Australia.}}

@article{Hoffman2011b,
	annote = {10.1144/M36.5},
	author = {Hoffman, Paul F. and Macdonald, Francis A. and Halverson, Galen P.},
	date = {2011/01/01},
	date-added = {2012-02-28 21:41:28 +0000},
	date-modified = {2012-10-29 20:46:18 +0000},
	journal = {Geological Society, London, Memoirs},
	journal1 = {Geological Society, London, Memoirs},
	month = {01},
	number = {1},
	pages = {67--80},
	title = {Chapter 5 Chemical sediments associated with Neoproterozoic glaciation: iron formation, cap carbonate, barite and phosphorite},
	ty = {JOUR},
	volume = {36},
	year = {2011},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://mem.lyellcollection.org/content/36/1/67.abstract%20N2%20-%20Orthochemical%20sediments%20associated%20with%20Neoproterozoic%20glaciation%20have%20prominence%20beyond%20their%20volumetric%20proportions%20because%20of%20the%20insights%20they%20provide%20on%20the%20nature%20of%20glaciation%20and%20the%20records%20they%20hold%20of%20the%20environment%20in%20which%20they%20were%20precipitated.%20Synglacial%20Fe%20formations%20are%20mineralogically%20simple%20(haematite%20jaspilite),%20and%20their%20trace%20element%20spectra%20resemble%20modern%20seawater,%20with%20a%20weaker%20hydrothermal%20signature%20than%20Archaean%E2%80%93Palaeoproterozoic%20Fe%20formations.%20Lithofacies%20associations%20implicate%20subglacial%20meltwater%20plumes%20as%20the%20agents%20of%20Fe(II)%20oxidation,%20and%20temporal%20oscillations%20in%20the%20plume%20flux%20as%20the%20cause%20of%20alternating%20Fe-%20and%20Mn-oxide%20deposits.%20Most%20if%20not%20all%20Neoproterozoic%20examples%20belong%20to%20the%20older%20Cryogenian%20(Sturtian)%20glaciation.%20Older%20and%20younger%20Cryogenian%20(Marinoan)%20cap%20carbonates%20are%20distinct.%20Only%20the%20younger%20have%20well-developed%20transgressive%20cap%20dolostones,%20which%20were%20laid%20down%20during%20the%20rise%20in%20global%20mean%20sea%20level%20resulting%20from%20ice-sheet%20meltdown.%20Marinoan%20cap%20dolostones%20have%20a%20suite%20of%20unusual%20sedimentary%20structures,%20indicating%20abnormal%20palaeoenvironmental%20conditions%20during%20their%20deposition.%20Assuming%20the%20meltdown%20of%20ice-sheets%20was%20rapid,%20cap%20dolostones%20were%20deposited%20from%20surface%20waters%20dominated%20by%20buoyant%20glacial%20meltwater,%20within%20and%20beneath%20which%20microbial%20activity%20probably%20catalysed%20dolomite%20nucleation.%20Former%20aragonite%20seafloor%20cement%20(crystal%20fans)%20found%20in%20deeper%20water%20limestone%20above%20Marinoan%20cap%20dolostones%20indicates%20carbonate%20oversaturation%20at%20depth,%20implying%20extreme%20concentrations%20of%20dissolved%20inorganic%20carbon.%20Barite%20is%20associated%20with%20a%20number%20of%20Marinoan%20cap%20dolostones,%20either%20as%20digitate%20seafloor%20cement%20associated%20with%20Fe-dolomite%20at%20the%20top%20of%20the%20cap%20dolostone,%20or%20as%20early%20diagenetic%20void-filling%20cement%20associated%20with%20tepee%20or%20tepee-like%20breccias.%20Seafloor%20barite%20marks%20a%20redoxcline%20in%20the%20water%20column%20across%20which%20euxinic%20Ba-rich%20waters%20upwelled,%20causing%20simultaneous%20barite%20titration%20and%20Fe(III)%20reduction.%20Phosphatic%20stromatolites,%20shrub-like%20structures%20and%20coated%20grains%20are%20associated%20with%20a%20glacioisostatically%20induced%20exposure%20surface%20on%20a%20cap%20dolostone%20in%20the%20NE%20of%20the%20West%20African%20craton,%20but%20this%20appears%20to%20be%20a%20singular%20occurrence%20of%20phosphorite%20formed%20during%20a%20Neoproterozoic%20deglaciation.}}

@article{Matsuyama2010b,
	abstract = {We use a revised partitioning of the planet figure into equilibrium and nonequilibrium contributions that takes into account the presence of an elastic lithosphere to study the Martian gravity field and shape. The equilibrium contribution is associated with the present rotational figure, and the nonequilibrium contribution is dominated by Tharsis and a remnant rotational figure supported by the elastic lithosphere that traces the paleopole location prior to the formation of Tharsis. We calculate the probability density functions for Tharsis' size and location, the paleopole location, and the global average thickness of the elastic lithosphere at the time Tharsis was emplaced. Given the observed degree-3 spherical harmonic gravity coefficients, the expected Tharsis center location is 258.6 $\pm$4.2∞E, 9.8 $\pm$0.9∞N, where the uncertainties represent the 90{\%} confidence interval. Given this Tharsis center location and the observed degree-2 spherical harmonic gravity coefficients, the expected paleopole location prior to the emplacement of Tharsis is 259.5 $\pm$49.5∞E, 71.1\&{\#}8722;14.4+17.5∞N, and the expected elastic lithospheric thickness at the time of loading is 58\&{\#}8722;32+34 km. Our estimated paleopole colatitude implies 18.9\&{\#}8722;17.5+14.4∞of true polar wander (TPW) driven by the emplacement of Tharsis, in disagreement with previous studies that invoke large TPW. The remnant rotational figure is visible in both the nonequilibrium degree-2 geoid (areoid) without Tharsis and the nonequilibrium degree-2 topography without Tharsis. The remnant rotational figure is also visible in the total nonequilibrium geoid without Tharsis, but it is not visible in the total nonequilibrium topography without Tharsis due to the strong signal of the north-south dichotomy. Shorter wavelength geological features become significantly more visible in the geoid with the removal of the long wavelength contributions of the equilibrium rotational figure, Tharsis, and the remnant rotational figure. Removal of the equilibrium rotational figure and Tharsis from the topography reveals a better defined north-south dichotomy boundary.},
	author = {Matsuyama, I. and Manga, M.},
	date = {2010/12/31},
	date-added = {2012-02-28 21:15:23 +0000},
	date-modified = {2012-10-29 20:46:18 +0000},
	isbn = {0148-0227},
	journal = {J. Geophys. Res.},
	keywords = {Mars; geoid; topography; rotational dynamics; remnant rotation; true polar wander; 6225 Planetary Sciences: Solar System Objects: Mars; 5417 Planetary Sciences: Solid Surface Planets: Gravitational fields; 5450 Planetary Sciences: Solid Surface Planets: Orbital and rotational dynamics; 5430 Planetary Sciences: Solid Surface Planets: Interiors; 5455 Planetary Sciences: Solid Surface Planets: Origin and evolution},
	month = {12},
	number = {E12},
	publisher = {AGU},
	sp = {E12020},
	title = {Mars without the equilibrium rotational figure, Tharsis, and the remnant rotational figure},
	ty = {JOUR},
	volume = {115},
	year = {2010},
	bdsk-file-1 = {},
