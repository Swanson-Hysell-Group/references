@article{Luczaj1998a,
	annote = {10.1130/0091-7613(1998)026<0295:ASEIAF>2.3.CO;2},
	author = {Luczaj, John},
	date-added = {2012-11-20 16:21:09 +0000},
	date-modified = {2012-11-20 16:21:09 +0000},
	journal = {Geology},
	journal1 = {Geology},
	number = {4},
	pages = {295--298},
	title = {Argument supporting explosive igneous activity for the origin of ``cryptoexplosion''structures in the midcontinent, United States},
	ty = {JOUR},
	url = {http://geology.gsapubs.org/content/26/4/295.abstract N2 - There has been a long-lived controversy over the origin of a well-defined linear set of eight cryptoexplosion structures in the southern midcontinent, United States. The linearity suggests that these structures must be related to either (1) impact of a string of bolides derived from breakup of a large parent bolide, or (2) volatile-rich, explosive ultramafic magmatism associated with structural weaknesses in the crust. That these structures are of various ages, are at or near intersections of major regional tectonic features, and have closely associated ultramafic magmatism, rules out the impact-string hypothesis. The only remaining hypothesis is that these cryptoexplosion structures were produced by explosive ultramafic volcanic activity. An important corollary to this hypothesis is that some shock-metamorphic features, including shatter cones and shocked quartz, can be produced by explosive ultramafic igneous activity.},
	volume = {26},
	year = {April, 1998},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://geology.gsapubs.org/content/26/4/295.abstract%20N2%20-%20There%20has%20been%20a%20long-lived%20controversy%20over%20the%20origin%20of%20a%20well-defined%20linear%20set%20of%20eight%20cryptoexplosion%20structures%20in%20the%20southern%20midcontinent,%20United%20States.%20The%20linearity%20suggests%20that%20these%20structures%20must%20be%20related%20to%20either%20(1)%20impact%20of%20a%20string%20of%20bolides%20derived%20from%20breakup%20of%20a%20large%20parent%20bolide,%20or%20(2)%20volatile-rich,%20explosive%20ultramafic%20magmatism%20associated%20with%20structural%20weaknesses%20in%20the%20crust.%20That%20these%20structures%20are%20of%20various%20ages,%20are%20at%20or%20near%20intersections%20of%20major%20regional%20tectonic%20features,%20and%20have%20closely%20associated%20ultramafic%20magmatism,%20rules%20out%20the%20impact-string%20hypothesis.%20The%20only%20remaining%20hypothesis%20is%20that%20these%20cryptoexplosion%20structures%20were%20produced%20by%20explosive%20ultramafic%20volcanic%20activity.%20An%20important%20corollary%20to%20this%20hypothesis%20is%20that%20some%20shock-metamorphic%20features,%20including%20shatter%20cones%20and%20shocked%20quartz,%20can%20be%20produced%20by%20explosive%20ultramafic%20igneous%20activity.}}

