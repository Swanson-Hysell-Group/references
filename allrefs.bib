	year = {2011},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://gsabulletin.gsapubs.org/content/early/2011/08/19/B30433.1.abstract%20N2%20-%20The%20Triassic%20successions%20of%20the%20Colorado%20Plateau%20preserve%20an%20important%20record%20of%20vertebrate%20evolution%20and%20climate%20change,%20but%20correlations%20to%20a%20global%20Triassic%20framework%20are%20hampered%20by%20a%20lack%20of%20geochronological%20control.%20Tuffaceous%20sandstones%20and%20siltstones%20were%20collected%20from%20the%20Upper%20Triassic%20Chinle%20Formation%20exposed%20in%20the%20Petrified%20Forest%20National%20Park,%20Arizona,%20USA,%20within%20a%20refined%20stratigraphic%20context%20of%2031%20detailed%20measured%20sections.%20U-Pb%20analyses%20by%20the%20isotope%20dilution%E2%80%93thermal%20ionization%20mass%20spectrometry%20(ID-TIMS)%20method%20constrain%20maximum%20depositional%20ages%20for%20nine%20tuffaceous%20beds%20and%20provide%20new%20insights%20into%20the%20depositional%20history%20of%20the%20Chinle%20fluvial%20system.%20The%20base%20of%20the%20Blue%20Mesa%20Member%20of%20the%20Chinle%20Formation%20is%20placed%20at%20ca.%20225%20Ma,%20and%20the%20top%20of%20the%20Petrified%20Forest%20Member%20is%20placed%20at%20208%20Ma%20or%20younger,%20bracketing%20an%20%E2%88%BC280-m-thick%20section%20that%20spans%20nearly%20the%20entire%20Norian%20Stage%20of%20the%20Late%20Triassic.%20Estimated%20sediment%20accumulation%20rates%20throughout%20the%20section%20reflect%20extensive%20hiatuses%20and/or%20sediment%20removal%20by%20channel%20erosion.%20The%20new%20geochronology%20for%20the%20Chinle%20Formation%20underscores%20the%20potential%20pitfalls%20of%20correlation%20of%20fluvial%20units%20based%20solely%20on%20lithostratigraphic%20criteria.%20A%20mid-Norian%20age%20(ca.%20219%E2%80%93213%20Ma)%20for%20the%20distinctive%20Sonsela%20conglomeratic%20sandstone%20bed%20constrains%20the%20Adamanian-Revueltian%20land%20vertebrate%20faunachron%20boundary.%20Our%20new%20data%20permit%20a%20significant%20time%20overlap%20between%20the%20lower%20Chinle%20sequence%20and%20the%20dinosauromorph-rich%20Ischigualasto%20Formation%20of%20northwestern%20Argentina.%20Near-contemporaneity%20of%20the%20trans-American%20deposits%20and%20their%20faunal%20similarities%20imply%20that%20early%20dinosaur%20evolution%20occurred%20rapidly%20across%20the%20Americas.}}

@article{Page1950a,
	author = {Page, Benjamin Markham},
	date = {1950/03/01},
	date-added = {2016-08-15 17:57:01 +0000},
	date-modified = {2022-06-19 10:20:01 -0700},
	journal = {Economic Geology},
	m3 = {10.2113/gsecongeo.45.2.142},
	month = {03},
	n2 = {The Broadway Tunnel is a pair of highway tunnels side by side, near Oakland, California. The geological conditions were not accurately determined prior to the driving of the tunnels, yet the contract was arranged on a firm unit-price basis. Construction was handicapped by unequal pressures exerted on the tunnels, general instability of a large portion of the rock, local running ground, irregular distribution of rock units, and plastic dikes. Two cave-ins occurred, expensive methods of construction had to be adopted, and a large financial loss resulted. Litigation inevitably followed.The formations penetrated by the tunnels include Miocene sandstone, shaly sandstone, and shale; the Claremont formation (Miocene chert and shale); and the Orinda formation (Pliocene mudstone, sandstone, and conglomerate). Some of these rocks are cut by many brittle sandstone dikes and by plastic, hydrothermally altered diabase dikes.The southwest portal of the Broadway Tunnel is in a terrain of unsystematic structure, but the greater part of the tunnel is in an overturned limb of a syncline, where dips are moderately uniform (about 60 degrees ). Many faults of very small displacement cut the Miocene formations, and indefinite fracture zones locally add to the instability of the rock mass.},
	number = {2},
	pages = {142--166},
	title = {{Geology of the Broadway Tunnel, Berkeley Hills, California}},
	ty = {JOUR},
	volume = {45},
	year = {1950},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://econgeol.geoscienceworld.org/content/45/2/142.abstract}}

@article{ASRAT2004a,
	annote = {10.1093/petrology/egh009},
	author = {ASRAT, A. and BARBEY, P. and LUDDEN, J. N. and REISBERG, L. and GLEIZES, G. and AYALEW, D.},
	date = {2004/06/01},
	date-added = {2016-08-12 22:32:44 +0000},
	date-modified = {2016-08-12 22:32:44 +0000},
	journal = {Journal of Petrology},
	journal1 = {Journal of Petrology},
	month = {06},
	number = {6},
	pages = {1147--1179},
	title = {Petrology and Isotope Geochemistry of the Pan-African Negash Pluton, Northern Ethiopia: Mafic--Felsic Magma Interactions During the Construction of Shallow-level Calc-alkaline Plutons},
	ty = {JOUR},
	url = {http://petrology.oxfordjournals.org/content/45/6/1147.abstract N2 - The Negash pluton consists of monzogranites, granodiorites, hybrid quartz monzodiorites, quartz monzodiorites and pyroxene monzodiorites, emplaced at 608 ± 7 Ma (zircon U–Pb) in low-grade volcaniclastic sediments. Field relationships between mafic and felsic rocks result from mingling and hybridization at the lower interface of a mafic sheet injected into partially crystallized, phenocryst-laden, granodiorite magma (back-veining), and hybridization during simultaneous ascent of mafic and felsic magmas in the feeder zone located to the NW of the pluton. The rock suite displays low 87Sr/86Sr(608) (0·70260–0·70350) and positive εNd(608) values (+3·9 to +5·9), along with fractionated rare earth element patterns [(La/Yb)N = 9·9–17·7], enrichment in large ion lithophile elements (Ba, U, K, Pb and Sr) and depletion in Nb and Th compared with the primitive mantle. Monzogranites, granodiorites and hybrid quartz monzodiorites define a calc-alkaline differentiation trend, whereas the quartz monzodiorites have higher Fe/Mg ratios. The pyroxene monzodiorites show anomalously high Ti/Zr, Ti/Y and Ti/V ratios, suggesting that they are cumulates. Chemical modelling suggests that pyroxene and quartz monzodiorites could derive from a common gabbrodioritic parent by fractional crystallization. Structural and chemical data suggest that (1) the pluton results from the assembly of several, low-viscosity, melt-rich batches (sheeting/dyking), differentiated in intermediate chambers prior to their emplacement; (2) in situ differentiation is limited to the coarse-grained pyroxene monzodiorites; (3) mafic–felsic magma interactions at the emplacement level were essentially limited to mingling.},
	volume = {45},
	year = {2004},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://petrology.oxfordjournals.org/content/45/6/1147.abstract%20N2%20-%20The%20Negash%20pluton%20consists%20of%20monzogranites,%20granodiorites,%20hybrid%20quartz%20monzodiorites,%20quartz%20monzodiorites%20and%20pyroxene%20monzodiorites,%20emplaced%20at%20608%20%C2%B1%207%20Ma%20(zircon%20U%E2%80%93Pb)%20in%20low-grade%20volcaniclastic%20sediments.%20Field%20relationships%20between%20mafic%20and%20felsic%20rocks%20result%20from%20mingling%20and%20hybridization%20at%20the%20lower%20interface%20of%20a%20mafic%20sheet%20injected%20into%20partially%20crystallized,%20phenocryst-laden,%20granodiorite%20magma%20(back-veining),%20and%20hybridization%20during%20simultaneous%20ascent%20of%20mafic%20and%20felsic%20magmas%20in%20the%20feeder%20zone%20located%20to%20the%20NW%20of%20the%20pluton.%20The%20rock%20suite%20displays%20low%2087Sr/86Sr(608)%20(0%C2%B770260%E2%80%930%C2%B770350)%20and%20positive%20%CE%B5Nd(608)%20values%20(+3%C2%B79%20to%20+5%C2%B79),%20along%20with%20fractionated%20rare%20earth%20element%20patterns%20%5B(La/Yb)N%20=%209%C2%B79%E2%80%9317%C2%B77%5D,%20enrichment%20in%20large%20ion%20lithophile%20elements%20(Ba,%20U,%20K,%20Pb%20and%20Sr)%20and%20depletion%20in%20Nb%20and%20Th%20compared%20with%20the%20primitive%20mantle.%20Monzogranites,%20granodiorites%20and%20hybrid%20quartz%20monzodiorites%20define%20a%20calc-alkaline%20differentiation%20trend,%20whereas%20the%20quartz%20monzodiorites%20have%20higher%20Fe/Mg%20ratios.%20The%20pyroxene%20monzodiorites%20show%20anomalously%20high%20Ti/Zr,%20Ti/Y%20and%20Ti/V%20ratios,%20suggesting%20that%20they%20are%20cumulates.%20Chemical%20modelling%20suggests%20that%20pyroxene%20and%20quartz%20monzodiorites%20could%20derive%20from%20a%20common%20gabbrodioritic%20parent%20by%20fractional%20crystallization.%20Structural%20and%20chemical%20data%20suggest%20that%20(1)%20the%20pluton%20results%20from%20the%20assembly%20of%20several,%20low-viscosity,%20melt-rich%20batches%20(sheeting/dyking),%20differentiated%20in%20intermediate%20chambers%20prior%20to%20their%20emplacement;%20(2)%20in%20situ%20differentiation%20is%20limited%20to%20the%20coarse-grained%20pyroxene%20monzodiorites;%20(3)%20mafic%E2%80%93felsic%20magma%20interactions%20at%20the%20emplacement%20level%20were%20essentially%20limited%20to%20mingling.}}

