	journal1 = {Geological Society of America Bulletin},
	month = {03},
	number = {3-4},
	pages = {681--702},
	title = {Dating of volcanism and sedimentation in the Skelton Group, Transantarctic Mountains: Implications for the Rodinia-Gondwana transition in southern Victoria Land, Antarctica},
	ty = {JOUR},
	volume = {123},
	year = {2011},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://gsabulletin.gsapubs.org/content/123/3-4/681.abstract%20N2%20-%20The%20Ross%20orogen%20in%20southern%20Victoria%20Land,%20Antarctica,%20is%20composed%20of%20Skelton%20Group%20metasedimentary%20rocks%20and%20varied%20plutons%20of%20the%20Granite%20Harbor%20intrusives.%20In%20the%20Baronick%20Glacier%20area,%20metasediments%20are%20dominated%20by%20thick%20sequences%20of%20coarse%20conglomerate,%20interbedded%20with%20pisolitic%20limestones.%20Clasts%20within%20metaconglomerates%20are%20predominantly%20volcanic,%20ranging%20in%20composition%20from%20basanite%20to%20rhyolite.%20Baronick%20basaltic%20clast%20compositions%20are%20mildly%20alkalic%20and%20ocean-island%20basalt%E2%80%93like,%20compatible%20with%20eruption%20in%20a%20continental-margin%20rift%20environment.%20Sr-Nd%20isotope%20ratios%20suggest%20rhyolites%20and%20quartz-trachytes%20were%20produced%20by%20assimilation%20and%20fractional%20crystallization%20mechanisms.%20Two%20rhyolites%20yielded%20U-Pb%20zircon%20ages%20determined%20by%20laser%20ablation%E2%80%93inductively%20coupled%20plasma%E2%80%93mass%20spectrometry%20(LA-ICP-MS)%20of%20650.1%20%C2%B1%204.0%20Ma%20and%20648.5%20%C2%B1%203.2%20Ma%20(both%202%CF%83).Studies%20of%20southern%20Victoria%20Land%20Skelton%20Group%20metasediments%20indicate%20that,%20although%20dominated%20by%20Grenville-aged%20detrital%20zircons,%20they%20contain%20an%20important%20component%20dated%20between%20630%20and%20680%20Ma,%20overlapping%20the%20age%20of%20volcanism%20in%20both%20the%20Baronick%20Glacier%20and%20central%20Transantarctic%20Mountain%20areas.%20The%20distribution%20of%20650%20Ma,%20rift-related%20volcanism%20in%20the%20southern%20Victoria%20Land%20segment%20of%20the%20Ross%20orogen,%20and%20the%20absence%20of%20significant%20older,%20but%20post-Grenville,%20extension-related%20zircon%20populations,%20is%20interpreted%20to%20reflect%20initiation%20of%20Rodinia%20fragmentation%20on%20the%20Antarctic%20margin%20at%20this%20time.%20It%20is%20proposed%20that%20rifting%20along%20the%20paleo-Pacific%20margin%20was%20diachronous,%20with%20the%20Antarctic%20segment%20of%20the%20rift%20opening%20substantially%20earlier%20than%20in%20Australia.%20Based%20on%20the%20dates%20of%20subduction-related%20calc-alkaline%20plutons%20formed%20during%20the%20Ross%20and%20Delamerian%20orogenies,%20the%20paleo%E2%80%93Pacific%20Ocean%20in%20Antarctica%20may%20also%20have%20closed%20earlier%20than%20in%20Australia,%20effectively%20defining%20the%20time%20of%20Gondwana%20assembly.}}

@article{Wingate2003a,
