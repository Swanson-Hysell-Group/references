@article{Smoot2014a,
	annote = {10.1130/B30875.1},
	author = {Smoot, Joseph P. and Southworth, Scott},
	date = {2014/01/01},
	date-added = {2014-01-07 21:29:51 +0000},
	date-modified = {2014-01-07 21:29:51 +0000},
	journal = {Geological Society of America Bulletin},
	journal1 = {Geological Society of America Bulletin},
	month = {01},
	number = {1-2},
	pages = {201--218},
	title = {Volcanic rift margin model for the rift-to-drift setting of the late Neoproterozoic-early Cambrian eastern margin of Laurentia: Chilhowee Group of the Appalachian Blue Ridge},
	ty = {JOUR},
	url = {http://gsabulletin.gsapubs.org/content/126/1-2/201.abstract N2 - New data support a model of a volcanic rifted margin for eastern Laurentia and the breakup of the supercontinent Rodinia. Upper Neoproterozoic–lower Cambrian rocks of the Chilhowee Group in the Blue Ridge Province of eastern North America are subdivided into two facies assemblages separated by an unconformity. Historically, the rocks have been correlated as a tripartite division: 1) basal sandstone and conglomerate (Cochran, Unicoi, and Weverton Formations), 2) middle siltstone and shale (Nichols Shale, Hampton Shale, and the Hampton and Harpers Formations), and 3) an upper sandstone and shale (Nebo Quartzite, Murray Shale, Hesse Quartzite, and Helenmode, Erwin, and Antietam Formations). Sedimentary analyses show that boundaries of the newly defined facies assemblages transect the named stratigraphic units. Assemblage A consists of fluvial-lacustrine deposits with interbedded subaerial basalt flows overlain by marine deposits. Fluvial strata formed in anastomosing braided-river channels and are interbedded with mudstones deposited in shallow lacustrine plains. Overlying shallow marine deposits consist of upward-coarsening successions capped by over-thickened sandstones. Shale-rich turbidite deposits characterized by subdued bioturbation and common slump features occur at the top. Assemblage B consists of sandstone and shale deposited on a stable shelf. These upward-coarsening parasequences are stacked to form transgressive-regressive system tracts reflecting long-term sea-level fluctuations.A working hypothesis is that these rocks are comparable to those present in seismic reflection profiles and drill cores of the volcanic rift margins of the Atlantic and Indian Oceans. Assemblage A deposits formed during rapid subsidence associated with the formation of seaward-dipping reflectors. Flood basalts within fluvial sandstones are the landward facies of more voluminous basalt flows in the opening basin. Overlying marine deposits of Assemblage A were coeval with basaltic volcanism and deeper-water deposits to the east. Assemblage B unconformably overlies Assemblage A rocks and laps onto much older continental rocks. It was deposited on the craton into the late Cambrian. Much of the lateral lithologic variability and differences in character and thickness of the Chilhowee Group is attributed to the depositional setting that was influenced by the underlying rift architecture. It was further complicated by juxtaposition of rocks telescoped along numerous Paleozoic thrust faults. This model predicts that coeval rocks in outboard thrust sheets are finer-grained, mafic volcanic-rich marine sequences (Assemblage A), overlain by shelf-margin and basin deposits that lack volcanic rocks (Assemblage B). This model provides more refined sedimentary criteria for examination of other volcanic rift margins.},
	volume = {126},
	year = {2014},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://gsabulletin.gsapubs.org/content/126/1-2/201.abstract%20N2%20-%20New%20data%20support%20a%20model%20of%20a%20volcanic%20rifted%20margin%20for%20eastern%20Laurentia%20and%20the%20breakup%20of%20the%20supercontinent%20Rodinia.%20Upper%20Neoproterozoic%E2%80%93lower%20Cambrian%20rocks%20of%20the%20Chilhowee%20Group%20in%20the%20Blue%20Ridge%20Province%20of%20eastern%20North%20America%20are%20subdivided%20into%20two%20facies%20assemblages%20separated%20by%20an%20unconformity.%20Historically,%20the%20rocks%20have%20been%20correlated%20as%20a%20tripartite%20division:%201)%20basal%20sandstone%20and%20conglomerate%20(Cochran,%20Unicoi,%20and%20Weverton%20Formations),%202)%20middle%20siltstone%20and%20shale%20(Nichols%20Shale,%20Hampton%20Shale,%20and%20the%20Hampton%20and%20Harpers%20Formations),%20and%203)%20an%20upper%20sandstone%20and%20shale%20(Nebo%20Quartzite,%20Murray%20Shale,%20Hesse%20Quartzite,%20and%20Helenmode,%20Erwin,%20and%20Antietam%20Formations).%20Sedimentary%20analyses%20show%20that%20boundaries%20of%20the%20newly%20defined%20facies%20assemblages%20transect%20the%20named%20stratigraphic%20units.%20Assemblage%20A%20consists%20of%20fluvial-lacustrine%20deposits%20with%20interbedded%20subaerial%20basalt%20flows%20overlain%20by%20marine%20deposits.%20Fluvial%20strata%20formed%20in%20anastomosing%20braided-river%20channels%20and%20are%20interbedded%20with%20mudstones%20deposited%20in%20shallow%20lacustrine%20plains.%20Overlying%20shallow%20marine%20deposits%20consist%20of%20upward-coarsening%20successions%20capped%20by%20over-thickened%20sandstones.%20Shale-rich%20turbidite%20deposits%20characterized%20by%20subdued%20bioturbation%20and%20common%20slump%20features%20occur%20at%20the%20top.%20Assemblage%20B%20consists%20of%20sandstone%20and%20shale%20deposited%20on%20a%20stable%20shelf.%20These%20upward-coarsening%20parasequences%20are%20stacked%20to%20form%20transgressive-regressive%20system%20tracts%20reflecting%20long-term%20sea-level%20fluctuations.A%20working%20hypothesis%20is%20that%20these%20rocks%20are%20comparable%20to%20those%20present%20in%20seismic%20reflection%20profiles%20and%20drill%20cores%20of%20the%20volcanic%20rift%20margins%20of%20the%20Atlantic%20and%20Indian%20Oceans.%20Assemblage%20A%20deposits%20formed%20during%20rapid%20subsidence%20associated%20with%20the%20formation%20of%20seaward-dipping%20reflectors.%20Flood%20basalts%20within%20fluvial%20sandstones%20are%20the%20landward%20facies%20of%20more%20voluminous%20basalt%20flows%20in%20the%20opening%20basin.%20Overlying%20marine%20deposits%20of%20Assemblage%20A%20were%20coeval%20with%20basaltic%20volcanism%20and%20deeper-water%20deposits%20to%20the%20east.%20Assemblage%20B%20unconformably%20overlies%20Assemblage%20A%20rocks%20and%20laps%20onto%20much%20older%20continental%20rocks.%20It%20was%20deposited%20on%20the%20craton%20into%20the%20late%20Cambrian.%20Much%20of%20the%20lateral%20lithologic%20variability%20and%20differences%20in%20character%20and%20thickness%20of%20the%20Chilhowee%20Group%20is%20attributed%20to%20the%20depositional%20setting%20that%20was%20influenced%20by%20the%20underlying%20rift%20architecture.%20It%20was%20further%20complicated%20by%20juxtaposition%20of%20rocks%20telescoped%20along%20numerous%20Paleozoic%20thrust%20faults.%20This%20model%20predicts%20that%20coeval%20rocks%20in%20outboard%20thrust%20sheets%20are%20finer-grained,%20mafic%20volcanic-rich%20marine%20sequences%20(Assemblage%20A),%20overlain%20by%20shelf-margin%20and%20basin%20deposits%20that%20lack%20volcanic%20rocks%20(Assemblage%20B).%20This%20model%20provides%20more%20refined%20sedimentary%20criteria%20for%20examination%20of%20other%20volcanic%20rift%20margins.}}

