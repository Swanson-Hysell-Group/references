@article{Barbeau2005b,
	annote = {10.1130/B25496.1},
	author = {Barbeau, David L. and Ducea, Mihai N. and Gehrels, George E. and Kidder, Steven and Wetmore, Paul H. and Saleeby, Jason B.},
	date = {2005/03/01},
	date-added = {2017-02-11 01:34:50 +0000},
	date-modified = {2022-05-28 18:05:06 -0700},
	journal = {Geological Society of America Bulletin},
	journal1 = {Geological Society of America Bulletin},
	month = {03},
	number = {3-4},
	pages = {466--481},
	title = {U-Pb detrital-zircon geochronology of northern Salinian basement and cover rocks},
	ty = {JOUR},
	url = {https://doi.org/10.1130/B25496.1},
	volume = {117},
	year = {2005},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://gsabulletin.gsapubs.org/content/117/3-4/466.abstract%20N2%20-%20Salinia%20is%20an%20out-of-place%20granitic%20ter-rane%20in%20central%20coastal%20California%20whose%20debated%20origin%20is%20critical%20to%20understanding%20the%20tectonic%20history%20of%20southwestern%20North%20America.%20Salinian%20metasedimentary%20and%20sedimentary%20rocks%20that%20respectively%20host%20and%20cover%20its%20predominant%20arc%20rocks%20should%20contribute%20important%20data%20about%20its%20origin%20and%20kinematic%20history,%20but%20pervasive%20intrusion,%20high-grade%20metamorphism%20and%20Cenozoic%20erosion%20of%20the%20Salinian%20block%20have%20inhibited%20their%20widespread%20characterization%20and%20correlation.%20To%20further%20address%20these%20problems,%20we%20report%20605%20U-Pb%20detrital-zircon%20geo-chronologic%20ages%20collected%20by%20laser-ablation%20multi-collector%20inductively%20coupled%20plasma%20mass%20spectrometry%20(LA-MC-ICP-MS)%20from%20seven%20Salinian%20metasedimentary%20framework%20(Sur%20Series)%20and%20sedimentary%20cover%20samples.%20Samples%20collected%20from%20the%20Sur%20Series%20contain%20Late%20Archean%20(2.5%E2%80%932.9%20Ga),%20late%20Paleo-proterozoic%20(1.6%E2%80%931.9%20Ga),%20Mesoproterozoic%20(0.9%E2%80%931.5%20Ga),%20Neoproterozoic%20(0.65%E2%80%930.8%20Ga),%20Paleozoic%20(250%E2%80%93450%20Ma),%20and%20possibly%20Mesozoic%20U-Pb%20detritalzircon%20ages.%20Samples%20collected%20from%20Upper%20Cretaceous%20cover%20units%20have%20various%20age-peak%20distributions,%20which%20collectively%20include%20late%20Paleoproterozoic%20(1.6%E2%80%931.8%20Ga),%20early%20Mesoproterozoic%20(1.35%E2%80%931.55%20Ga),%20Permo-Triassic%20(220%E2%80%93290%20Ma),%20and%20Jurassic-Cretaceous%20(80%E2%80%93190%20Ma)%20peaks.%20From%20these%20data,%20several%20interpretations%20are%20made.%20(1)%20Maximum%20depositional%20ages%20of%20the%20Sur%20Series%20and%20cover%20intervals%20are%20280%E2%80%93360%20Ma%20and%2078%E2%80%9390%20Ma,%20respectively.%20(2)%20The%20presence%20of%20Late%20Archean,%20early%20Paleoproterozoic,%20and%20Neoproterozoic%20zircons%20in%20Salinian%20metasedimentary%20rocks%20suggest%20that%20uplift%20and%20erosion%20of%20adjacent%20basins%20recycled%20sediment%20onto%20Salinia.%20(3)%20The%20abundant%20pre-Mesoproterozoic%20detritalzircon%20ages%20in%20Sur%20Series%20and%20cover%20units%20preclude%20the%20possibility%20that%20Salinia%20originated%20in%20southern%20Mexico,%20as%20has%20been%20previously%20suggested.%20(4)%20Five%20of%20six%20key%20detritalzircon%20age%20peaks%20identified%20in%20Salinian%20basement%20and%20cover%20units%20are%20nowhere%20more%20closely%20arranged%20than%20in%20the%20Mojave%20Desert%E2%80%93Peninsular%20Ranges%20region%20of%20Baja%20and%20southern%20Alta%20California.%20(5)%20Paleozoic%20and%20early%20Mesozoic%20detrital%20zircons%20in%20Sur%20Series%20and%20cover%20units%20match%20the%20ages%20of%20several%20plutonic%20events%20that%20occurred%20along%20the%20western%20margin%20of%20North%20America%E2%80%94however,%20Permian%20ages%20favor%20a%20Mojave%20Desert%20origin%20over%20other%20candidates.%20Collectively,%20these%20and%20other%20data%20suggest%20that%20Salinia%20resided%20in%20the%20Mojave%20Desert%E2%80%93Peninsular%20Ranges%20region%20from%20the%20late%20Paleozoic%20until%20the%20Late%20Cretaceous,%20after%20which%20it%20was%20rapidly%20exhumed,%20deposited%20upon,%20and%20then%20translated%20outboard%20and%20northward%20to%20its%20current%20position.}}

