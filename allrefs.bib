	isbn = {0031-9201},
	journal = {Physics of the Earth and Planetary Interiors},
	month = {8},
	number = {1--2},
	pages = {83--99},
	title = {Mineralogical change and self-reversed magnetizations in pyrrhotite resulting from partial oxidation; geophysical implications},
	ty = {JOUR},
	url = {http://www.sciencedirect.com/science/article/pii/0031920194900094},
