	title = {{Two-phase Neogene extension in the northwestern Basin and Range recorded in a single thermochronology sample}},
	ty = {JOUR},
	volume = {36},
	year = {2008},
	bdsk-url-1 = {http://geology.gsapubs.org/content/36/8/631.abstract%20N2%20-%20We%20use%20a%20combination%20of%20apatite%204He/3He,%20(U-Th)/He,%20and%20fission-track%20thermochronology%20to%20date%20slip%20on%20the%20Surprise%20Valley%20fault%20in%20northeastern%20California%20by%20analyzing%20a%20single%20sample%20from%20the%20Warner%20Range%20in%20the%20footwall%20of%20the%20fault.%20This%20sample,%20a%20granitic%20clast%20from%20a%20conglomerate,%20yielded%20a%20fission-track%20age%20of%2011.6%20%C2%B1%202.8%20Ma%20and%20a%20(U-Th)/He%20age%20of%203.02%20%C2%B1%200.52%20Ma.%20Geologic%20relationships%20indicate%20that%20this%20sample%20was%20buried%20to%20a%20depth%20of%20~3.3%20km%20prior%20to%20exhumation%20during%20slip%20on%20the%20Surprise%20Valley%20fault.%20Fission-track%20age%20and%20length%20data%20indicate%20that%20the%20sample%20was%20fully%20reset%20(%3E120%20%C2%B0C)%20prior%20to%20exhumation,%20which%20began%20sometime%20after%2014%20Ma.%20A%20single%20aliquot%20of%20nine%20apatite%20grains%20was%20step-heated%20for%204He/3He%20analysis;%20modeling%20of%20the%20resulting%204He%20distribution%20indicates%20that%20cooling%20from%20%3E80%20%C2%B0C%20to%20~20%20%C2%B0C%20occurred%20between%203%20and%201%20Ma.%20Interconsistent%20time-temperature%20(t-T)%20solutions%20to%20the%20combined%204He/3He,%20(U-Th)/He,%20and%20fission-track%20data%20require%20two%20distinct%20periods%20of%20cooling,%20consistent%20with%20non-continuous%20slip%20on%20the%20Surprise%20Valley%20fault.%20Early%20cooling%20and%20fault%20slip%20took%20place%20between%2014%20and%208%20Ma,%20followed%20by%20more%20recent%20fault%20slip%20ca.%203%20Ma.%20This%20timing%20is%20consistent%20with%20both%20local%20geologic%20relationships%20and%20with%20the%20regional%20timing%20of%20faulting%20along%20the%20western%20margin%20of%20the%20Basin%20and%20Range%20Province.%20These%20data%20demonstrate%20the%20resolving%20power%20of%20combined%20fission-track,%20(U-Th)/He,%20and%204He/3He%20thermochronometric%20data%20to%20extract%20low-temperature%20t-T%20information%20from%20a%20single%20sample%20close%20to%20Earth's%20surface.}}

