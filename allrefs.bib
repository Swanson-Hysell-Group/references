	bdsk-url-1 = {http://geology.gsapubs.org/content/28/7/619.abstract%20N2%20-%20The%20Chuar%20Group%20(%E2%88%BC1600%20m%20thick)%20preserves%20a%20record%20of%20extensional%20tectonism,%20ocean-chemistry%20fluctuations,%20and%20biological%20diversification%20during%20the%20late%20Neoproterozoic%20Era.%20An%20ash%20layer%20from%20the%20top%20of%20the%20section%20has%20a%20U-Pb%20zircon%20age%20of%20742%20%C2%B1%206%20Ma.%20The%20Chuar%20Group%20was%20deposited%20at%20low%20latitudes%20during%20extension%20on%20the%20north-trending%20Butte%20fault%20system%20and%20is%20inferred%20to%20record%20rifting%20during%20the%20breakup%20of%20Rodinia.%20Shallow-marine%20deposition%20is%20documented%20by%20tide-%20and%20wave-generated%20sedimentary%20structures,%20facies%20associations,%20and%20fossils.%20C%20isotopes%20in%20organic%20carbon%20show%20large%20stratigraphic%20variations,%20apparently%20recording%20incipient%20stages%20of%20the%20marked%20C%20isotopic%20fluctuations%20that%20characterize%20later%20Neoproterozoic%20time.%20Upper%20Chuar%20rocks%20preserve%20a%20rich%20biota%20that%20includes%20not%20only%20cyanobacteria%20and%20algae,%20but%20also%20heterotrophic%20protists%20that%20document%20increased%20food%20web%20complexity%20in%20Neoproterozoic%20ecosystems.%20The%20Chuar%20Group%20thus%20provides%20a%20well-dated,%20high-resolution%20record%20of%20early%20events%20in%20the%20sequence%20of%20linked%20tectonic,%20biogeochemical,%20environmental,%20and%20biological%20changes%20that%20collectively%20ushered%20in%20the%20Phanerozoic%20Eon.}}

@article{Carporzen2011a,
	annote = {10.1073/pnas.1017165108},
