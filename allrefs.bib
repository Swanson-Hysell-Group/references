@article{Begg2009a,
	annote = {10.1130/GES00179.1},
	author = {Begg, G. C. and Griffin, W. L. and Natapov, L. M. and O'Reilly, Suzanne Y. and Grand, S. P. and O'Neill, C. J. and Hronsky, J. M. A. and Djomani, Y. Poudjom and Swain, C. J. and Deen, T. and Bowden, P.},
	date = {2009/02/01},
	date-added = {2013-05-16 20:58:30 +0000},
	date-modified = {2013-05-16 20:58:30 +0000},
	journal = {Geosphere},
	journal1 = {Geosphere},
	month = {02},
	number = {1},
	pages = {23--50},
	title = {The lithospheric architecture of Africa: Seismic tomography, mantle petrology, and tectonic evolution},
	ty = {JOUR},
	url = {http://geosphere.gsapubs.org/content/5/1/23.abstract N2 - We present a new analysis of the lithospheric architecture of Africa, and its evolution from ca. 3.6 Ga to the present. Upper-lithosphere domains, generated or reworked in different time periods, have been delineated by integrating regional tectonics and geochronology with geophysical data (magnetic, gravity, and seismic). The origins and evolution of lower-lithosphere domains are interpreted from a high-resolution global shear-wave tomographic model, using thermal/compositional modeling and xenolith/xenocryst data from volcanic rocks. These data are integrated to map the distribution of ancient highly depleted subcontinental lithospheric mantle (SCLM), zones of younger or strongly modified SCLM and zones of active mantle upwelling, and to relate these to the evolution of the upper lithosphere domains.The lithospheric architecture of Africa consists of several Archean cratons and smaller cratonic fragments, stitched together and flanked by younger fold belts; the continental assembly as we see it has only existed since lower Paleozoic time. The larger cratons are underlain by geochemically depleted, rigid, and mechanically robust SCLM; these cratonic roots have steep sides, extending in some cases to ≥300-km depth. Beneath smaller cratons (e.g., Kaapvaal) extensive refertilization has reduced the lateral and vertical extent of strongly depleted SCLM. Some cratonic roots extend ≥300 km into the Atlantic Ocean, suggesting that the upper lithosphere may detach during continental breakup, leaving fragments of SCLM scattered in the ocean basin.The cratonic margins, and some intracratonic domain boundaries, have played a major role in the tectonics of Africa. They have repeatedly focused ascending magmas, leading to refertilization and weakening of the SCLM. These boundaries have localized successive cycles of extension, rifting, and renewed accretion; the ongoing development of the East Africa Rift and its branches is only the latest stage in this process. The less depleted SCLM that underlies some accretionary belts may have been generated in Archean time, and repeatedly refertilized by the passage of magmas during younger tectonic events. Our analysis indicates that originally Archean SCLM is far more extensive beneath Africa than previously recognized, and implies that post-Archean SCLM rarely survives the collision/accretion process. Where continental crust and SCLM have remained connected, there is a strong linkage between the tectonic evolution of the crust and the composition and modification of its underlying SCLM.},
	volume = {5},
	year = {2009},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://geosphere.gsapubs.org/content/5/1/23.abstract%20N2%20-%20We%20present%20a%20new%20analysis%20of%20the%20lithospheric%20architecture%20of%20Africa,%20and%20its%20evolution%20from%20ca.%203.6%20Ga%20to%20the%20present.%20Upper-lithosphere%20domains,%20generated%20or%20reworked%20in%20different%20time%20periods,%20have%20been%20delineated%20by%20integrating%20regional%20tectonics%20and%20geochronology%20with%20geophysical%20data%20(magnetic,%20gravity,%20and%20seismic).%20The%20origins%20and%20evolution%20of%20lower-lithosphere%20domains%20are%20interpreted%20from%20a%20high-resolution%20global%20shear-wave%20tomographic%20model,%20using%20thermal/compositional%20modeling%20and%20xenolith/xenocryst%20data%20from%20volcanic%20rocks.%20These%20data%20are%20integrated%20to%20map%20the%20distribution%20of%20ancient%20highly%20depleted%20subcontinental%20lithospheric%20mantle%20(SCLM),%20zones%20of%20younger%20or%20strongly%20modified%20SCLM%20and%20zones%20of%20active%20mantle%20upwelling,%20and%20to%20relate%20these%20to%20the%20evolution%20of%20the%20upper%20lithosphere%20domains.The%20lithospheric%20architecture%20of%20Africa%20consists%20of%20several%20Archean%20cratons%20and%20smaller%20cratonic%20fragments,%20stitched%20together%20and%20flanked%20by%20younger%20fold%20belts;%20the%20continental%20assembly%20as%20we%20see%20it%20has%20only%20existed%20since%20lower%20Paleozoic%20time.%20The%20larger%20cratons%20are%20underlain%20by%20geochemically%20depleted,%20rigid,%20and%20mechanically%20robust%20SCLM;%20these%20cratonic%20roots%20have%20steep%20sides,%20extending%20in%20some%20cases%20to%20%E2%89%A5300-km%20depth.%20Beneath%20smaller%20cratons%20(e.g.,%20Kaapvaal)%20extensive%20refertilization%20has%20reduced%20the%20lateral%20and%20vertical%20extent%20of%20strongly%20depleted%20SCLM.%20Some%20cratonic%20roots%20extend%20%E2%89%A5300%20km%20into%20the%20Atlantic%20Ocean,%20suggesting%20that%20the%20upper%20lithosphere%20may%20detach%20during%20continental%20breakup,%20leaving%20fragments%20of%20SCLM%20scattered%20in%20the%20ocean%20basin.The%20cratonic%20margins,%20and%20some%20intracratonic%20domain%20boundaries,%20have%20played%20a%20major%20role%20in%20the%20tectonics%20of%20Africa.%20They%20have%20repeatedly%20focused%20ascending%20magmas,%20leading%20to%20refertilization%20and%20weakening%20of%20the%20SCLM.%20These%20boundaries%20have%20localized%20successive%20cycles%20of%20extension,%20rifting,%20and%20renewed%20accretion;%20the%20ongoing%20development%20of%20the%20East%20Africa%20Rift%20and%20its%20branches%20is%20only%20the%20latest%20stage%20in%20this%20process.%20The%20less%20depleted%20SCLM%20that%20underlies%20some%20accretionary%20belts%20may%20have%20been%20generated%20in%20Archean%20time,%20and%20repeatedly%20refertilized%20by%20the%20passage%20of%20magmas%20during%20younger%20tectonic%20events.%20Our%20analysis%20indicates%20that%20originally%20Archean%20SCLM%20is%20far%20more%20extensive%20beneath%20Africa%20than%20previously%20recognized,%20and%20implies%20that%20post-Archean%20SCLM%20rarely%20survives%20the%20collision/accretion%20process.%20Where%20continental%20crust%20and%20SCLM%20have%20remained%20connected,%20there%20is%20a%20strong%20linkage%20between%20the%20tectonic%20evolution%20of%20the%20crust%20and%20the%20composition%20and%20modification%20of%20its%20underlying%20SCLM.}}

