	title = {Trace fossils and substrates of the terminal Proterozoic--Cambrian transition: Implications for the record of early bilaterians and sediment mixing},
	ty = {JOUR},
	volume = {99},
	year = {2002},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://www.pnas.org/content/99/20/12572.abstract%20N2%20-%20The%20trace%20fossil%20record%20is%20important%20in%20determining%20the%20timing%20of%20the%20appearance%20of%20bilaterian%20animals.%20A%20conservative%20estimate%20puts%20this%20time%20at%20%E2%89%88555%20million%20years%20ago.%20The%20preservational%20potential%20of%20traces%20made%20close%20to%20the%20sediment%E2%80%93water%20interface%20is%20crucial%20to%20detecting%20early%20benthic%20activity.%20Our%20studies%20on%20earliest%20Cambrian%20sediments%20suggest%20that%20shallow%20tiers%20were%20preserved%20to%20a%20greater%20extent%20than%20typical%20for%20most%20of%20the%20Phanerozoic,%20which%20can%20be%20attributed%20both%20directly%20and%20indirectly%20to%20the%20low%20levels%20of%20sediment%20mixing.%20The%20low%20levels%20of%20sediment%20mixing%20meant%20that%20thin%20event%20beds%20were%20preserved.%20The%20shallow%20depth%20of%20sediment%20mixing%20also%20meant%20that%20muddy%20sediments%20were%20firm%20close%20to%20the%20sediment%E2%80%93water%20interface,%20increasing%20the%20likelihood%20of%20recording%20shallow-tier%20trace%20fossils%20in%20muddy%20sediments.%20Overall,%20trace%20fossils%20can%20provide%20a%20sound%20record%20of%20the%20onset%20of%20bilaterian%20benthic%20activity.}}

