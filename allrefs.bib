@article{Mullins1989a,
	annote = {10.1130/0091-7613(1989)017<0622:EAIONY>2.3.CO;2},
	author = {Mullins, Henry T. and Hinchey, Edward J.},
	date-added = {2017-02-24 03:37:40 +0000},
	date-modified = {2017-02-24 03:37:40 +0000},
	journal = {Geology},
	journal1 = {Geology},
	number = {7},
	pages = {622--625},
	title = {Erosion and infill of New York Finger Lakes: Implications for Laurentide ice sheet deglaciation},
	ty = {JOUR},
	url = {http://geology.gsapubs.org/content/17/7/622.abstract N2 - A comprehensive seismic reflection profile investigation of the New York Finger Lakes has revealed the extent of bedrock erosion and nature of sediment fill beneath the lakes.Bedrock deepens to the south, where gorgelike profiles have been eroded to as much as 304 m below sea level and infilled with up to 275 m of late Quaternary age (< 14 ka) sediment. We propose a working hypothesis that invokes ice streaming and pressurized subglacial meltwater and sediment to account for regional geomorphology. This working hypothesis is consistent with recent concepts of the collapse of continental ice sheets via ice streaming and the marine isotopic record for a meltwater spike at 13-14 ka. The Finger Lakes may provide a critical testing ground for deglaciation models of the southern Laurentide ice sheet because they contain a thick, well-preserved, and now seismically defined record of the deglaciation process.},
	volume = {17},
	year = {July, 1989},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://geology.gsapubs.org/content/17/7/622.abstract%20N2%20-%20A%20comprehensive%20seismic%20reflection%20profile%20investigation%20of%20the%20New%20York%20Finger%20Lakes%20has%20revealed%20the%20extent%20of%20bedrock%20erosion%20and%20nature%20of%20sediment%20fill%20beneath%20the%20lakes.Bedrock%20deepens%20to%20the%20south,%20where%20gorgelike%20profiles%20have%20been%20eroded%20to%20as%20much%20as%20304%20m%20below%20sea%20level%20and%20infilled%20with%20up%20to%20275%20m%20of%20late%20Quaternary%20age%20(%3C%2014%20ka)%20sediment.%20We%20propose%20a%20working%20hypothesis%20that%20invokes%20ice%20streaming%20and%20pressurized%20subglacial%20meltwater%20and%20sediment%20to%20account%20for%20regional%20geomorphology.%20This%20working%20hypothesis%20is%20consistent%20with%20recent%20concepts%20of%20the%20collapse%20of%20continental%20ice%20sheets%20via%20ice%20streaming%20and%20the%20marine%20isotopic%20record%20for%20a%20meltwater%20spike%20at%2013-14%20ka.%20The%20Finger%20Lakes%20may%20provide%20a%20critical%20testing%20ground%20for%20deglaciation%20models%20of%20the%20southern%20Laurentide%20ice%20sheet%20because%20they%20contain%20a%20thick,%20well-preserved,%20and%20now%20seismically%20defined%20record%20of%20the%20deglaciation%20process.}}

