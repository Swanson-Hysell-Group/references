	title = {Mid-Miocene rhyolite volcanism in northeastern Nevada: The Jarbidge Rhyolite and its relationship to the Cenozoic evolution of the northern Great Basin (USA)},
	ty = {JOUR},
	url = {http://gsabulletin.gsapubs.org/content/126/7-8/1047.abstract N2 - We present new physical, geochemical, geochronologic, and oxygen isotope constraints on the mid-Miocene Jarbidge Rhyolite in northeastern Nevada (USA), providing new constraints on the tectonomagmatic evolution of the Cenozoic northern Great Basin. Widespread extension due to rapid collapse of the Nevadaplano began at ca. 17–16 Ma across the northern Great Basin. Coeval with this event was compositionally bimodal basalt-rhyolite volcanism that is often attributed to the inception of the Yellowstone hotspot. The most widespread mid-Miocene volcanic units in northeastern Nevada are lavas and domes of the Jarbidge Rhyolite. The thickest and most areally extensive exposures of these lavas include, and are found just west of, the Jarbidge Mountains, Nevada. This study focuses on Jarbidge Rhyolite directly south of the central Snake River Plain, adjacent to the thickest exposures in the vicinity of Jarbidge, Nevada. Textures on a range of scales indicate that the Jarbidge Rhyolite consists primarily of phenocryst-rich lavas. Laser 40Ar/39Ar ages for sanidine are consistent with effusive eruption of metaluminous to slightly peraluminous ferroan calc-alkalic rhyolite from 16.1 to 15.0 Ma; prior K-Ar ages suggest that some activity occurred over a slightly longer duration. Major and trace element data, coupled with new stable and prior radiogenic isotope measurements, suggest that Jarbidge Rhyolite magmas formed primarily via melting of quartzofeldspathic crust. The Jarbidge Rhyolite lavas are geochemically dissimilar from younger Snake River Plain rhyolites (e.g., lower MgO, lower Nb, higher Rb/Nb) and are more similar to coeval rhyolites erupted to the west on or adjacent to the Oregon Plateau. The distribution of the Jarbidge Rhyolite lavas in northeastern Nevada reflects an intimate association with temporally and spatially coincident extension rather than the Yellowstone hotspot.},
	volume = {126},
	year = {2014},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://gsabulletin.gsapubs.org/content/126/7-8/1047.abstract%20N2%20-%20We%20present%20new%20physical,%20geochemical,%20geochronologic,%20and%20oxygen%20isotope%20constraints%20on%20the%20mid-Miocene%20Jarbidge%20Rhyolite%20in%20northeastern%20Nevada%20(USA),%20providing%20new%20constraints%20on%20the%20tectonomagmatic%20evolution%20of%20the%20Cenozoic%20northern%20Great%20Basin.%20Widespread%20extension%20due%20to%20rapid%20collapse%20of%20the%20Nevadaplano%20began%20at%20ca.%2017%E2%80%9316%20Ma%20across%20the%20northern%20Great%20Basin.%20Coeval%20with%20this%20event%20was%20compositionally%20bimodal%20basalt-rhyolite%20volcanism%20that%20is%20often%20attributed%20to%20the%20inception%20of%20the%20Yellowstone%20hotspot.%20The%20most%20widespread%20mid-Miocene%20volcanic%20units%20in%20northeastern%20Nevada%20are%20lavas%20and%20domes%20of%20the%20Jarbidge%20Rhyolite.%20The%20thickest%20and%20most%20areally%20extensive%20exposures%20of%20these%20lavas%20include,%20and%20are%20found%20just%20west%20of,%20the%20Jarbidge%20Mountains,%20Nevada.%20This%20study%20focuses%20on%20Jarbidge%20Rhyolite%20directly%20south%20of%20the%20central%20Snake%20River%20Plain,%20adjacent%20to%20the%20thickest%20exposures%20in%20the%20vicinity%20of%20Jarbidge,%20Nevada.%20Textures%20on%20a%20range%20of%20scales%20indicate%20that%20the%20Jarbidge%20Rhyolite%20consists%20primarily%20of%20phenocryst-rich%20lavas.%20Laser%2040Ar/39Ar%20ages%20for%20sanidine%20are%20consistent%20with%20effusive%20eruption%20of%20metaluminous%20to%20slightly%20peraluminous%20ferroan%20calc-alkalic%20rhyolite%20from%2016.1%20to%2015.0%20Ma;%20prior%20K-Ar%20ages%20suggest%20that%20some%20activity%20occurred%20over%20a%20slightly%20longer%20duration.%20Major%20and%20trace%20element%20data,%20coupled%20with%20new%20stable%20and%20prior%20radiogenic%20isotope%20measurements,%20suggest%20that%20Jarbidge%20Rhyolite%20magmas%20formed%20primarily%20via%20melting%20of%20quartzofeldspathic%20crust.%20The%20Jarbidge%20Rhyolite%20lavas%20are%20geochemically%20dissimilar%20from%20younger%20Snake%20River%20Plain%20rhyolites%20(e.g.,%20lower%20MgO,%20lower%20Nb,%20higher%20Rb/Nb)%20and%20are%20more%20similar%20to%20coeval%20rhyolites%20erupted%20to%20the%20west%20on%20or%20adjacent%20to%20the%20Oregon%20Plateau.%20The%20distribution%20of%20the%20Jarbidge%20Rhyolite%20lavas%20in%20northeastern%20Nevada%20reflects%20an%20intimate%20association%20with%20temporally%20and%20spatially%20coincident%20extension%20rather%20than%20the%20Yellowstone%20hotspot.}}

@article{Stolper2014a,
	author = {Stolper, D. A. and Lawson, M. and Davis, C. L. and Ferreira, A. A. and Neto, E. V. Santos and Ellis, G. S. and Lewan, M. D. and Martini, A. M. and Tang, Y. and Schoell, M. and Sessions, A. L. and Eiler, J. M.},
	date = {2014/06/27},
	date-added = {2014-06-27 17:48:42 +0000},
	date-modified = {2014-06-27 17:48:42 +0000},
	journal = {Science},
	m3 = {10.1126/science.1254509},
	month = {06},
	number = {6191},
	pages = {1500--1503},
	title = {Formation temperatures of thermogenic and biogenic methane},
	ty = {JOUR},
	url = {http://www.sciencemag.org/content/344/6191/1500.abstract N2 - Methane is an important greenhouse gas and energy resource generated dominantly by methanogens at low temperatures and through the breakdown of organic molecules at high temperatures. However, methane-formation temperatures in nature are often poorly constrained. We measured formation temperatures of thermogenic and biogenic methane using a “clumped isotope” technique. Thermogenic gases yield formation temperatures between 157° and 221°C, within the nominal gas window, and biogenic gases yield formation temperatures consistent with their comparatively lower-temperature formational environments (<50°C). In systems where gases have migrated and other proxies for gas-generation temperature yield ambiguous results, methane clumped-isotope temperatures distinguish among and allow for independent tests of possible gas-formation models.},
	volume = {344},
	year = {2014},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://www.sciencemag.org/content/344/6191/1500.abstract%20N2%20-%20Methane%20is%20an%20important%20greenhouse%20gas%20and%20energy%20resource%20generated%20dominantly%20by%20methanogens%20at%20low%20temperatures%20and%20through%20the%20breakdown%20of%20organic%20molecules%20at%20high%20temperatures.%20However,%20methane-formation%20temperatures%20in%20nature%20are%20often%20poorly%20constrained.%20We%20measured%20formation%20temperatures%20of%20thermogenic%20and%20biogenic%20methane%20using%20a%20%E2%80%9Cclumped%20isotope%E2%80%9D%20technique.%20Thermogenic%20gases%20yield%20formation%20temperatures%20between%20157%C2%B0%20and%20221%C2%B0C,%20within%20the%20nominal%20gas%20window,%20and%20biogenic%20gases%20yield%20formation%20temperatures%20consistent%20with%20their%20comparatively%20lower-temperature%20formational%20environments%20(%3C50%C2%B0C).%20In%20systems%20where%20gases%20have%20migrated%20and%20other%20proxies%20for%20gas-generation%20temperature%20yield%20ambiguous%20results,%20methane%20clumped-isotope%20temperatures%20distinguish%20among%20and%20allow%20for%20independent%20tests%20of%20possible%20gas-formation%20models.}}

@article{Stanton1970a,
	annote = {Invertebrate macrofossils from the Pliocene and Pleistocene Etchegoin, San Joaquin, and Tulare Formations exposed in the Kettleman Hills were studied to compare the techniques and results of faunal and geochemical analysis in the determination of paleoenvironments. The fossils in these strata are abundant and chemically well preserved; genera suitable for geochemical study are widely distributed. The faunal lists of Woodring, Stewart, \& Richards (1940) were used in addition to new collections. Faunal analysis indicates a marine climate similar to that of the northern part of the modern Californian Province (Valentine, 1966), i.e., just south of Point Concepcion, California, with an average mean winter surface temperature of about 13$\,^{\circ}$C. Temperatures based on strontium concentration in the outer layer of Mytilus specimens ranged from 11.5 to 17.8, with a mean of 14$\,^{\circ}$C. Neither analysis indicates any significant climatic trends or fluctuations during deposition of the strata studied. Agreement between the faunal and geochemical paleotemperature analysis is good. Analyses of paleosalinity by faunal and oxygen isotopic methods give results which also agree closely. Salinity during deposition of the Etchegoin and San Joaquin Formations generally ranged from normal marine to brackish; it was predominantly fresh during deposition of the Tulare Formation. Lateral variations in salinity and restriction of water circulation are interpreted from comparison of the composition and diversity of fossil assemblages with those of the modern biofacies of San Francisco Bay which have been determined by cluster analysis.},
	author = {Stanton, Robert J. , Jr. and Dodd, J. Robert},
	cr = {Copyright \copyright 1970 SEPM Society for Sedimentary Geology},
	date = {1970/11/01},
	date-added = {2014-06-24 21:59:30 +0000},
	date-modified = {2014-06-24 21:59:30 +0000},
	doi = {10.2307/1302614},
	isbn = {00223360},
	journal = {Journal of Paleontology},
	m1 = {ArticleType: research-article / Full publication date: Nov., 1970 / Copyright {\copyright}1970 SEPM Society for Sedimentary Geology},
	month = {11},
	number = {6},
	pages = {1092--1121},
	publisher = {SEPM Society for Sedimentary Geology},
	title = {Paleoecologic Techniques: Comparison of Faunal and Geochemical Analyses of Pliocene Paleoenvironments, Kettleman Hills, California},
	ty = {JOUR},
	url = {http://www.jstor.org/stable/1302614},
	volume = {44},
	year = {1970},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://www.jstor.org/stable/1302614},
	bdsk-url-2 = {http://dx.doi.org/10.2307/1302614}}

@article{DODD1975a,
	annote = {10.1130/0016-7606(1975)86<51:PWAPBK>2.0.CO;2},
	author = {DODD, J. ROBERT and STANTON, ROBERT J.},
	date-added = {2014-06-24 21:58:12 +0000},
	date-modified = {2014-06-24 21:58:12 +0000},
	journal = {Geological Society of America Bulletin},
	journal1 = {Geological Society of America Bulletin},
	number = {1},
	pages = {51--64},
	title = {Paleosalinities within a Pliocene Bay, Kettleman Hills, California: A Study of the Resolving Power of Isotopic and Faunal Techniques},
	ty = {JOUR},
	url = {http://gsabulletin.gsapubs.org/content/86/1/51.abstract N2 - Pliocene sediments of the Kettleman Hills, California, were deposited in a marine embayment that occupied part of the San Joaquin Valley. Faunal and sedimentologic data from the upper Pliocene Pecten zone indicate a decreasing salinity trend south and southwestward across the Kettleman Hills. In general, the least diverse faunas and coarsest sediment are in the west-central part of the area, near an apparent small delta and are relatively distant from the entrance of the embayment. Salinity and substrate are probably the main factors controlling the composition of the eight fossil communities recognized by Q-mode cluster analysis. Oxygen and carbon isotopic age determinations were made on specimens of Pecten, Aequipecten, Ostrea, and the fresh-water clam, Anodonta, in order to determine paleosalinities. Assuming that Anodonta grew in water that was representative of the fresh water that flowed into the embayment, that the shells with the heaviest isotopic composition grew in normal marine water, and that the temperature was constant throughout the area at that time, the salinity at which the shells grew can be calculated from their oxygen isotopic composition. The salinities calculated by this procedure range from normal marine (35 ‰) in the north and east parts of the Kettleman Hills to brackish (about 10 to 15 ‰) in the west-central part. These results are in good agreement with those suggested by faunal composition and diversity. A similar but more limited study of the stratigraphically higher upper Mya zone indicates that the salinity during this time was reduced but did not vary in a systematic pattern as during Pecten zone time. Comparison of fossil and modern communities provides the means for detailed paleoenvironmental reconstruction by establishing analogous modern settings. Environmental interpretation, based on isotopic analysis, is similar to interpretations based on faunal analyses but, in addition, provides more quantitative estimates of the paleotemperature and salinity.},
	volume = {86},
	year = {January, 1975},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://gsabulletin.gsapubs.org/content/86/1/51.abstract%20N2%20-%20Pliocene%20sediments%20of%20the%20Kettleman%20Hills,%20California,%20were%20deposited%20in%20a%20marine%20embayment%20that%20occupied%20part%20of%20the%20San%20Joaquin%20Valley.%20Faunal%20and%20sedimentologic%20data%20from%20the%20upper%20Pliocene%20Pecten%20zone%20indicate%20a%20decreasing%20salinity%20trend%20south%20and%20southwestward%20across%20the%20Kettleman%20Hills.%20In%20general,%20the%20least%20diverse%20faunas%20and%20coarsest%20sediment%20are%20in%20the%20west-central%20part%20of%20the%20area,%20near%20an%20apparent%20small%20delta%20and%20are%20relatively%20distant%20from%20the%20entrance%20of%20the%20embayment.%20Salinity%20and%20substrate%20are%20probably%20the%20main%20factors%20controlling%20the%20composition%20of%20the%20eight%20fossil%20communities%20recognized%20by%20Q-mode%20cluster%20analysis.%20Oxygen%20and%20carbon%20isotopic%20age%20determinations%20were%20made%20on%20specimens%20of%20Pecten,%20Aequipecten,%20Ostrea,%20and%20the%20fresh-water%20clam,%20Anodonta,%20in%20order%20to%20determine%20paleosalinities.%20Assuming%20that%20Anodonta%20grew%20in%20water%20that%20was%20representative%20of%20the%20fresh%20water%20that%20flowed%20into%20the%20embayment,%20that%20the%20shells%20with%20the%20heaviest%20isotopic%20composition%20grew%20in%20normal%20marine%20water,%20and%20that%20the%20temperature%20was%20constant%20throughout%20the%20area%20at%20that%20time,%20the%20salinity%20at%20which%20the%20shells%20grew%20can%20be%20calculated%20from%20their%20oxygen%20isotopic%20composition.%20The%20salinities%20calculated%20by%20this%20procedure%20range%20from%20normal%20marine%20(35%20%E2%80%B0)%20in%20the%20north%20and%20east%20parts%20of%20the%20Kettleman%20Hills%20to%20brackish%20(about%2010%20to%2015%20%E2%80%B0)%20in%20the%20west-central%20part.%20These%20results%20are%20in%20good%20agreement%20with%20those%20suggested%20by%20faunal%20composition%20and%20diversity.%20A%20similar%20but%20more%20limited%20study%20of%20the%20stratigraphically%20higher%20upper%20Mya%20zone%20indicates%20that%20the%20salinity%20during%20this%20time%20was%20reduced%20but%20did%20not%20vary%20in%20a%20systematic%20pattern%20as%20during%20Pecten%20zone%20time.%20Comparison%20of%20fossil%20and%20modern%20communities%20provides%20the%20means%20for%20detailed%20paleoenvironmental%20reconstruction%20by%20establishing%20analogous%20modern%20settings.%20Environmental%20interpretation,%20based%20on%20isotopic%20analysis,%20is%20similar%20to%20interpretations%20based%20on%20faunal%20analyses%20but,%20in%20addition,%20provides%20more%20quantitative%20estimates%20of%20the%20paleotemperature%20and%20salinity.}}

