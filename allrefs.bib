	journal = {J. Geophys. Res.},
	keywords = {oceanic basalt; titanomaghemite; self-reversal of remanent magnetization; 1540 Geomagnetism and Paleomagnetism: Rock and mineral magnetism; 1519 Geomagnetism and Paleomagnetism: Magnetic mineralogy and petrology; 1533 Geomagnetism and Paleomagnetism: Remagnetization; 1517 Geomagnetism and Paleomagnetism: Magnetic anomalies: modeling and interpretation},
	month = {11},
