	m3 = {Article},
	month = {10},
	publisher = {Nature Publishing Group, a division of Macmillan Publishers Limited. All Rights Reserved.},
	title = {Rapid regional perturbations to the recent global geomagnetic decay revealed by a new Hawaiian record},
	ty = {JOUR},
	url = {http://dx.doi.org/10.1038/ncomms3727},
	volume = {4},
	year = {2013},
