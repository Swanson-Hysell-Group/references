@article{Mills2014b,
	annote = {10.1073/pnas.1321679111},
	author = {Mills, Benjamin and Lenton, Timothy M. and Watson, Andrew J.},
	date = {2014/06/24},
	date-added = {2016-01-29 01:27:22 +0000},
	date-modified = {2016-01-29 01:27:22 +0000},
	journal = {Proceedings of the National Academy of Sciences},
	journal1 = {Proceedings of the National Academy of Sciences},
	month = {06},
	number = {25},
	pages = {9073--9078},
	title = {Proterozoic oxygen rise linked to shifting balance between seafloor and terrestrial weathering},
	ty = {JOUR},
	url = {http://www.pnas.org/content/111/25/9073.abstract N2 - A shift toward higher atmospheric oxygen concentration during the late Proterozoic has been inferred from multiple indirect proxies and is seen by many as a prerequisite for the emergence of complex animal life. However, the mechanisms controlling the level of oxygen throughout the Proterozoic and its eventual rise remain uncertain. Here we use a simple biogeochemical model to show that the balance between long-term carbon removal fluxes via terrestrial silicate weathering and ocean crust alteration plays a key role in determining atmospheric oxygen concentration. This balance may be shifted by changes in terrestrial weatherability or in the generation rate of oceanic crust. As a result, the terrestrial chemical weathering flux may be permanently altered—contrasting with the conventional view that the global silicate weathering flux must adjust to equal the volcanic CO2 degassing flux. Changes in chemical weathering flux in turn alter the long-term supply of phosphorus to the ocean, and therefore the flux of organic carbon burial, which is the long-term source of atmospheric oxygen. Hence we propose that increasing solar luminosity and a decrease in seafloor spreading rate over 1,500–500 Ma drove a gradual shift from seafloor weathering to terrestrial weathering, and a corresponding steady rise in atmospheric oxygen. Furthermore, increased terrestrial weatherability during the late Neoproterozoic may explain low temperature, increases in ocean phosphate, ocean sulfate, and atmospheric oxygen concentration at this time.},
	volume = {111},
	year = {2014},
	bdsk-url-1 = {http://www.pnas.org/content/111/25/9073.abstract%20N2%20-%20A%20shift%20toward%20higher%20atmospheric%20oxygen%20concentration%20during%20the%20late%20Proterozoic%20has%20been%20inferred%20from%20multiple%20indirect%20proxies%20and%20is%20seen%20by%20many%20as%20a%20prerequisite%20for%20the%20emergence%20of%20complex%20animal%20life.%20However,%20the%20mechanisms%20controlling%20the%20level%20of%20oxygen%20throughout%20the%20Proterozoic%20and%20its%20eventual%20rise%20remain%20uncertain.%20Here%20we%20use%20a%20simple%20biogeochemical%20model%20to%20show%20that%20the%20balance%20between%20long-term%20carbon%20removal%20fluxes%20via%20terrestrial%20silicate%20weathering%20and%20ocean%20crust%20alteration%20plays%20a%20key%20role%20in%20determining%20atmospheric%20oxygen%20concentration.%20This%20balance%20may%20be%20shifted%20by%20changes%20in%20terrestrial%20weatherability%20or%20in%20the%20generation%20rate%20of%20oceanic%20crust.%20As%20a%20result,%20the%20terrestrial%20chemical%20weathering%20flux%20may%20be%20permanently%20altered%E2%80%94contrasting%20with%20the%20conventional%20view%20that%20the%20global%20silicate%20weathering%20flux%20must%20adjust%20to%20equal%20the%20volcanic%20CO2%20degassing%20flux.%20Changes%20in%20chemical%20weathering%20flux%20in%20turn%20alter%20the%20long-term%20supply%20of%20phosphorus%20to%20the%20ocean,%20and%20therefore%20the%20flux%20of%20organic%20carbon%20burial,%20which%20is%20the%20long-term%20source%20of%20atmospheric%20oxygen.%20Hence%20we%20propose%20that%20increasing%20solar%20luminosity%20and%20a%20decrease%20in%20seafloor%20spreading%20rate%20over%201,500%E2%80%93500%20Ma%20drove%20a%20gradual%20shift%20from%20seafloor%20weathering%20to%20terrestrial%20weathering,%20and%20a%20corresponding%20steady%20rise%20in%20atmospheric%20oxygen.%20Furthermore,%20increased%20terrestrial%20weatherability%20during%20the%20late%20Neoproterozoic%20may%20explain%20low%20temperature,%20increases%20in%20ocean%20phosphate,%20ocean%20sulfate,%20and%20atmospheric%20oxygen%20concentration%20at%20this%20time.}}

