@article{Dinares-Turell1999a,
	annote = {10.1144/GSL.SP.1999.151.01.07},
	author = {Dinar{\`e}s-Turell, J. and Dekkers, M. J.},
	date = {1999/01/01},
	date-added = {2011-03-13 13:22:15 -0400},
	date-modified = {2011-04-18 10:34:30 -0400},
	journal = {Geological Society, London, Special Publications},
	journal1 = {Geological Society, London, Special Publications},
	month = {01},
	number = {1},
	pages = {53--69},
	title = {Diagenesis and remanence acquisition in the {Lower Pliocene Trubi marls at Punta di Maiata (southern Sicily)}: palaeomagnetic and rock magnetic observations},
	ty = {JOUR},
	volume = {151},
	year = {1999},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://sp.lyellcollection.org/content/151/1/53.abstract%20N2%20-%20Three%20new%20profiles%20(LCM,%20PMD%20and%20CMD)%20through%20the%20lower%20Cochiti%20polarity%20zone%20allow%20comparison%20of%20the%20effects%20of%20weathering%20and%20diagenesis%20on%20the%20magnetic%20properties%20of%20the%20Lower%20Pliocene%20Trubi%20marls.%20These%20marls%20have%20been%20well%20dated,%20by%20means%20of%20astronomical%20calibration,%20and%20are%20of%20particular%20interest%20in%20terms%20of%20polarity%20zonation%20and%20regional%20tectonics.%20The%20freshest%20exposures%20(LCM%20profile)%20carry%20a%20remanence%20associated%20with%20pyrrhotite,%20which%20is%20particularly%20enhanced%20in%20some%20grey%20layers.%20This%20is%20the%20first%20time%20that%20pyrrhotite%20has%20been%20documented%20as%20the%20main%20remanence%20carrier%20in%20these%20marls.%20Previously,%20single-domain%20(SD)%20magnetite%20was%20recognized%20as%20the%20fundamental%20ferromagnetic%20phase.%20The%20mean%20characteristic%20remanent%20magnetization%20(ChRM)%20direction%20from%20the%20LCM%20record%20does%20not%20show%20the%20expected%2030%E2%80%9335%C2%B0%20clockwise%20rotation%20found%20in%20other%20studies,%20nor%20does%20it%20record%20the%20normal%20Cochiti%20interval%20(i.e.%20the%20sampled%20interval%20is%20entirely%20reverse%20polarity),%20suggesting%20a%20relatively%20late%20origin%20for%20the%20natural%20remanent%20magnetization%20(NRM).%20Standard%20rock%20magnetic%20techniques%20are%20used%20to%20investigate%20the%20nature%20of%20the%20magnetization%20in%20the%20three%20laterally%20equivalent%20profiles%20at%20Punta%20di%20Maiata.%20The%20entire%20dataset%20seems%20to%20be%20better%20explained%20by%20a%20complex%20diagenetic%20history%20involving%20a%20multistage%20redox%20history%20that%20invokes%20a%20%E2%80%98late%E2%80%99%20anoxia%20event.%20The%20previously%20postulated%20iron%20migration%20model%20was%20put%20forward%20for%20the%20%E2%80%98suboxic%20situation%E2%80%99%20and%20does%20not%20take%20into%20account%20the%20presence%20of%20magnetic%20sulphides,%20which%20are%20clearly%20demonstrated%20in%20the%20zone%20under%20study.%20The%20%E2%80%98extended%20diagenetic%20model%E2%80%99%20inferred%20here%20proposes%20a%20pathway%20that%20accounts%20for%20most%20of%20the%20new%20observations.%20The%20salient%20feature%20is%20the%20postulated%20existence%20of%20a%20diagenetic%20phase%20that%20has%20altered%20the%20original%20NRM%20in%20some%20areas%20(dissolution%20of%20magnetite)%20resulting%20in%20a%20later-stage%20acquisition%20of%20chemical%20remanence%20that%20does%20not%20date%20to%20the%20timing%20of%20deposition%20of%20the%20sediments.%20The%20extension%20and%20the%20detailed%20mechanisms%20by%20which%20such%20a%20process%20has%20taken%20place%20deserve%20further%20research.%20None%20the%20less,%20the%20present%20investigation%20accounts%20for%20previously%20unrecognized%20features%20in%20the%20Trubi%20marls%20from%20Sicily%20and%20outlines%20how%20intricate%20the%20nature%20of%20the%20mechanisms%20contributing%20to%20the%20blocking%20of%20remanence%20in%20sediments%20can%20be.}}

