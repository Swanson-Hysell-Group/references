@article{Vail1985a,
	author = {Vail, John R.},
	date = {1985/12/01},
	date-added = {2016-08-11 18:35:36 +0000},
	date-modified = {2016-08-11 18:35:36 +0000},
	journal = {Geology},
	m3 = {10.1130/0091-7613(1985)13<839:PLPTTA>2.0.CO;2},
	month = {12},
	number = {12},
	pages = {839--842},
	title = {Pan-African (late Precambrian) tectonic terrains and the reconstruction of the Arabian-Nubian Shield},
	ty = {JOUR},
	url = {http://geology.gsapubs.org/content/13/12/839.abstract N2 - The recognition of Precambrian ophiolite suites and their dismembered remnants in association with intraoceanic island-arc volcanic and plutonic terrains across much of the Arabian-Nubian Shield of eastern Egypt, Sudan, Ethiopia, Yemen, western Saudi Arabia, and Sinai has been used by many authors to support the hypothesis of crustal accretion during late Proterozoic time (∼950−550 Ma). Reassembly of the various fragments provides a mosaic of Proterozoic microplates in a regular pattern in which at least five oceanic terrains, bounded by the remains of ophiolite belts, lie between remobilized continental plates to east and west.},
	volume = {13},
	year = {1985},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://geology.gsapubs.org/content/13/12/839.abstract%20N2%20-%20The%20recognition%20of%20Precambrian%20ophiolite%20suites%20and%20their%20dismembered%20remnants%20in%20association%20with%20intraoceanic%20island-arc%20volcanic%20and%20plutonic%20terrains%20across%20much%20of%20the%20Arabian-Nubian%20Shield%20of%20eastern%20Egypt,%20Sudan,%20Ethiopia,%20Yemen,%20western%20Saudi%20Arabia,%20and%20Sinai%20has%20been%20used%20by%20many%20authors%20to%20support%20the%20hypothesis%20of%20crustal%20accretion%20during%20late%20Proterozoic%20time%20(%E2%88%BC950%E2%88%92550%20Ma).%20Reassembly%20of%20the%20various%20fragments%20provides%20a%20mosaic%20of%20Proterozoic%20microplates%20in%20a%20regular%20pattern%20in%20which%20at%20least%20five%20oceanic%20terrains,%20bounded%20by%20the%20remains%20of%20ophiolite%20belts,%20lie%20between%20remobilized%20continental%20plates%20to%20east%20and%20west.}}

@article{STOESER1985a,
	annote = {10.1130/0016-7606(1985)96<817:PMAOTA>2.0.CO;2},
	author = {STOESER, DOUGLAS B. and CAMP, VICTOR E.},
	date-added = {2016-08-11 18:31:19 +0000},
	date-modified = {2016-08-11 18:31:19 +0000},
	journal = {Geological Society of America Bulletin},
	journal1 = {Geological Society of America Bulletin},
	number = {7},
	pages = {817--826},
	title = {Pan-African microplate accretion of the Arabian Shield},
	ty = {JOUR},
	url = {http://gsabulletin.gsapubs.org/content/96/7/817.abstract N2 - The late Proterozoic Arabian Shield is composed of at least five geologically distinct terranes (microplates) separated by four ophiolite-bearing suture zones. Three ensimatic island-arc terranes occur in the western shield, whereas the two terranes in the eastern shield have continental affinities. The western two sutures are island-arc-island-arc joins, whereas the eastern two sutures collectively form a major coilisional orogenic belt. Accretion of the five terranes to form an Arabian neocraton occurred from 715 to 630 Ma. After accretion, intracratonic deformation and magmatism related to collision continued and resulted in the formation of molasse, intermediate to silicic volcanic rocks, peralka-line to peraluminous granites (640-570 Ma), and a major left-lateral wrench fault system (∼630-550 Ma) which displaced the northern part of the Arabian neocraton ∼250 km to the northwest. These tectonic events represent the accretion of the Arabian portion of Gondwanaland during the Pan-African event.},
	volume = {96},
	year = {July, 1985},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://gsabulletin.gsapubs.org/content/96/7/817.abstract%20N2%20-%20The%20late%20Proterozoic%20Arabian%20Shield%20is%20composed%20of%20at%20least%20five%20geologically%20distinct%20terranes%20(microplates)%20separated%20by%20four%20ophiolite-bearing%20suture%20zones.%20Three%20ensimatic%20island-arc%20terranes%20occur%20in%20the%20western%20shield,%20whereas%20the%20two%20terranes%20in%20the%20eastern%20shield%20have%20continental%20affinities.%20The%20western%20two%20sutures%20are%20island-arc-island-arc%20joins,%20whereas%20the%20eastern%20two%20sutures%20collectively%20form%20a%20major%20coilisional%20orogenic%20belt.%20Accretion%20of%20the%20five%20terranes%20to%20form%20an%20Arabian%20neocraton%20occurred%20from%20715%20to%20630%20Ma.%20After%20accretion,%20intracratonic%20deformation%20and%20magmatism%20related%20to%20collision%20continued%20and%20resulted%20in%20the%20formation%20of%20molasse,%20intermediate%20to%20silicic%20volcanic%20rocks,%20peralka-line%20to%20peraluminous%20granites%20(640-570%20Ma),%20and%20a%20major%20left-lateral%20wrench%20fault%20system%20(%E2%88%BC630-550%20Ma)%20which%20displaced%20the%20northern%20part%20of%20the%20Arabian%20neocraton%20%E2%88%BC250%20km%20to%20the%20northwest.%20These%20tectonic%20events%20represent%20the%20accretion%20of%20the%20Arabian%20portion%20of%20Gondwanaland%20during%20the%20Pan-African%20event.}}

