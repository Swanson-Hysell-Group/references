@article{Wiberg1994a,
	abstract = {The wavelength, height, and steepness of ripples formed under oscillatory flows in flume and field studies are reexamined to construct a simple and accurate method of predicting these ripple properties. Ripples with wavelengths proportional to near-bed wave orbital diameter (orbital ripples), predominant in laboratory experiments, are found to have heights in excess of the thickness of the wave boundary layer. Ripples with wavelengths that are roughly proportional to grain size and nearly independent of orbital diameter (anorbital ripples), which predominate in the field, have heights at least several times smaller than wave boundary layer thickness. Relating wave boundary layer height to the generally more easily estimated wave orbital diameter, a set of expressions are developed for predicting ripple type and geometry based on mean grain size, wave orbital diameter, and estimated anorbital ripple height. This method provides a good characterization of ripple wavelength and steepness for a large set of combined field and flume data.},
	author = {Wiberg, Patricia L. and Harris, Courtney K.},
	date-added = {2011-09-20 14:52:39 +0000},
	date-modified = {2012-10-29 20:46:19 +0000},
	isbn = {0148-0227},
	journal = {J. Geophys. Res.},
	number = {C1},
	pages = {775--789},
	publisher = {AGU},
	title = {Ripple geometry in wave-dominated environments},
	ty = {JOUR},
	volume = {99},
	year = {1994},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://dx.doi.org/10.1029/93JC02726}}

@article{Abbot2011a,
	abstract = {Geological and geochemical evidence can be interpreted as indicating strong hysteresis in global climate during the Neoproterozoic glacial events (\&{\#}8764;630 Ma and \&{\#}8764;715 Ma). Standard climate theory only allows such strong hysteresis if global climate enters a fully-glaciated \&{\#}8220;Snowball\&{\#}8221; state. However, the survival of photosynthetic, eukaryotic, marine species through these glaciations may indicate that there were large areas of open ocean. A previously-proposed \&{\#}8220;Slushball\&{\#}8221; model for Neoproterozoic glaciations could easily explain the survival of these organisms because it has open ocean throughout the tropics, but there is only a small amount of hysteresis associated with the Slushball state. In this paper a new state of global climate, the \&{\#}8220;Jormungand\&{\#}8221; state, is proposed. In this state the ocean is very nearly globally ice-covered, but a very small strip of the tropical ocean remains ice-free. The low ice latitude of the Jormungand state is a consequence of the low albedo of snow-free (bare) sea ice. If the ice latitude propagates into the subtropical desert zone, it can stabilize without collapsing to the equator because subtropical ice-covered regions have a relatively low top-of-atmosphere albedo as a result of the exposure of bare sea ice and relatively lower cloud cover. Moreover, there is strong hysteresis associated with the Jormungand state as greenhouse gas levels are varied because of the high albedo contrast between regions of bare and snow covered sea ice. The Jormungand state is illustrated here in two different atmospheric global climate models and in the Budyko-Sellers model. By offering a scenario that could explain both strong hysteresis in global climate and the survival of life, the Jormungand state represents a potential model for Neoproterozoic glaciations, although further study of this issue is needed.},
	author = {Abbot, Dorian S. and Voigt, Aiko and Koll, Daniel},
	date = {2011/09/17},
	date-added = {2011-09-19 20:47:39 +0000},
	date-modified = {2012-10-29 20:46:19 +0000},
	isbn = {0148-0227},
	journal = {J. Geophys. Res.},
	keywords = {Neoproterozoic glaciation; Snowball Earth; sea ice; 0750 Cryosphere: Sea ice (4540); 1620 Global Change: Climate dynamics (0429, 3309); 1626 Global Change: Global climate models (3337, 4928); 4908 Paleoceanography: Albedo; 9622 Information Related to Geologic Time: Proterozoic},
	month = {09},
	number = {D18},
	publisher = {AGU},
	sp = {D18103},
	title = {The Jormungand global climate state and implications for Neoproterozoic glaciations},
	ty = {JOUR},
	volume = {116},
	year = {2011},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://dx.doi.org/10.1029/2011JD015927}}

@article{Elrick2011a,
	annote = {10.1130/G32109.1},
	author = {Elrick, Maya and Rieboldt, Sarah and Saltzman, Matt and McKay, Robert M.},
	date = {2011/10/01},
	date-added = {2011-09-19 20:34:54 +0000},
	date-modified = {2012-10-29 20:46:19 +0000},
	journal = {Geology},
	journal1 = {Geology},
	month = {10},
	number = {10},
	pages = {987--990},
	title = {Oxygen-isotope trends and seawater temperature changes across the Late Cambrian Steptoean positive carbon-isotope excursion (SPICE event)},
	ty = {JOUR},
	volume = {39},
	year = {2011},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://geology.gsapubs.org/content/39/10/987.abstract%20N2%20-%20The%20globally%20recognized%20Late%20Cambrian%20Steptoean%20positive%20C-isotope%20excursion%20(SPICE)%20is%20characterized%20by%20a%203%E2%80%B0%E2%80%935%E2%80%B0%20positive%20%CE%B413C%20shift%20spanning%20%3C4%20m.y.%20Existing%20hypotheses%20suggest%20that%20the%20SPICE%20represents%20a%20widespread%20ocean%20anoxic%20event%20leading%20to%20enhanced%20burial/preservation%20of%20organic%20matter%20(Corg)%20and%20pyrite.%20We%20analyzed%20%CE%B418O%20values%20of%20apatitic%20inarticulate%20brachiopods%20from%20three%20Upper%20Cambrian%20successions%20across%20Laurentia%20to%20evaluate%20paleotemperatures%20during%20the%20SPICE.%20%CE%B418O%20values%20range%20from%20%E2%88%BC12.5%E2%80%B0%20to%2016.5%E2%80%B0.%20Estimated%20seawater%20temperatures%20associated%20with%20the%20SPICE%20are%20unreasonably%20warm,%20suggesting%20that%20the%20brachiopod%20%CE%B418O%20values%20were%20altered%20during%20early%20diagenesis.%20Despite%20this,%20all%20three%20localities%20show%20similar%20trends%20with%20respect%20to%20the%20SPICE%20%CE%B413C%20curve,%20suggesting%20that%20the%20brachiopod%20apatite%20preserves%20a%20record%20of%20relative%20%CE%B418O%20and%20temperature%20changes.%20The%20trends%20include%20relatively%20high%20%CE%B418O%20values%20at%20the%20onset%20of%20the%20SPICE,%20decreasing%20and%20lowest%20values%20during%20the%20main%20event,%20and%20an%20increase%20in%20values%20at%20the%20end%20of%20the%20event.%20The%20higher%20%CE%B418O%20values%20during%20the%20global%20extinction%20at%20the%20onset%20of%20the%20SPICE%20suggests%20seawater%20cooling%20and%20supports%20earlier%20hypotheses%20of%20upwelling%20of%20cool%20waters%20onto%20the%20shallow%20shelf.%20Decreasing%20and%20low%20%CE%B418O%20values%20coincident%20with%20the%20rising%20limb%20of%20the%20SPICE%20support%20the%20hypothesis%20that%20seawater%20warming%20and%20associated%20reduced%20thermohaline%20circulation%20rates%20contributed%20to%20decreased%20dissolved%20O2%20concentrations,%20which%20enhanced%20the%20preservation/burial%20of%20Corg%20causing%20the%20positive%20%CE%B413C%20shift.}}

@article{Yu2011a,
	abstract = {The practical effect of cooling rate on the magnitude of thermal remanent magnetization (TRM) is experimentally tested, using both natural and synthetic magnetites. For synthetic and natural single-domain (SD) magnetites, TRM intensity increases as the cooling rate decreases because a longer exposure time for slower cooling offers more chances to achieve an equilibrium magnetization. Multidomain (MD) magnetites have the opposite response: TRM decreases as the cooling rate increases because slower cooling allows more time to achieve lower magnetization because of self-demagnetization. For pseudo-single-domain (PSD) magnetite, the effect of cooling rate on the remanence intensity appears to be insignificant, intermediate in behavior between SD and MD. For a SD, TRM differences are restricted to lower temperatures but diminish near the Curie point, strongly indicating a serious problem in a conventional treatment of cooling rate correction. On the practical side, merely applying TRM differences as a correction can overcorrect the true paleointensity. Another important significance of the present study is that a cooling rate difference alone can cause a slight nonlinearity in an Arai plot for a SD.},
	author = {Yu, Yongjae},
	date = {2011/09/09},
	date-added = {2011-09-19 20:30:07 +0000},
	date-modified = {2012-10-29 20:46:19 +0000},
	isbn = {0148-0227},
	journal = {J. Geophys. Res.},
	keywords = {Thellier analysis; cooling rate; geomagnetic field intensity determination; magnetite; thermoremanent magnetization (TRM); 1503 Geomagnetism and Paleomagnetism: Archeomagnetism; 1519 Geomagnetism and Paleomagnetism: Magnetic mineralogy and petrology; 1521 Geomagnetism and Paleomagnetism: Paleointensity; 1540 Geomagnetism and Paleomagnetism: Rock and mineral magnetism},
	month = {09},
	number = {B9},
	publisher = {AGU},
	sp = {B09101},
	title = {Importance of cooling rate dependence of thermoremanence in paleointensity determination},
	ty = {JOUR},
	volume = {116},
	year = {2011},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://dx.doi.org/10.1029/2011JB008388}}

@article{Brownlee2011a,
	abstract = {Paleomagnetic studies of the 91 Ma Ecstall pluton and other Cretaceous plutons of British Columbia imply large northward tectonic movements ({$>$}2000 km) may have occurred during the tectonic evolution of western North America. However, more recent studies have shown that the eastern edge of the Ecstall pluton experienced considerable mineralogical changes as younger Eocene plutons, such as the \&{\#}8764;58 Ma Quottoon Pluton, were emplaced along its margins. We investigated changes in the rock magnetic properties associated with this reheating event by examining isolated grains of intergrown ilmenite and hematite, the primary paleomagnetic recorder in the Ecstall pluton. Measurements of hysteresis properties, low-temperature remanence, and room temperature isothermal remanent magnetization acquisition and observations from magnetic force microscopy and off-axis electron holography indicate that samples fall into three groups. The groups are defined by the presence of mineral microstructures that are related to distance from the Quotoon plutonic complex. The two groups closest to the Quottoon Pluton contain magnetite within hematite and ilmenite lamellae. Reheating of the Ecstall pluton led to an increase in coercivity and magnetization, as well as to development of mixed phase hysteresis. These results indicate that shallow paleomagnetic directions from the western Ecstall pluton are not affected by reheating and are therefore likely to record original field conditions at the time of pluton emplacement. In the absence of structural deformation, these shallow inclinations are consistent with large-scale northward translation suggested by the Baja\&{\#}8211;British Columbia hypothesis.},
	author = {Brownlee, Sarah J. and Feinberg, Joshua M. and Kasama, Takeshi and Harrison, Richard J. and Scott, Gary R. and Renne, Paul R.},
	date = {2011/09/10},
	date-added = {2011-09-19 20:26:42 +0000},
	date-modified = {2012-10-29 20:46:19 +0000},
	isbn = {1525-2027},
	journal = {Geochem. Geophys. Geosyst.},
	keywords = {Baja-BC; IRM acquisition; hysteresis; low-temperature remanence; magnetic force microscopy; off-axis electron holography; 1519 Geomagnetism and Paleomagnetism: Magnetic mineralogy and petrology; 1533 Geomagnetism and Paleomagnetism: Remagnetization; 1540 Geomagnetism and Paleomagnetism: Rock and mineral magnetism},
	month = {09},
	number = {9},
	publisher = {AGU},
	sp = {Q07Z29},
	title = {Magnetic properties of ilmenite-hematite single crystals from the Ecstall pluton near Prince Rupert, British Columbia},
	ty = {JOUR},
	volume = {12},
	year = {2011},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://dx.doi.org/10.1029/2011GC003622}}

@article{Tziperman2011a,
	annote = {10.1073/pnas.1016361108},
	author = {Tziperman, Eli and Halevy, Itay and Johnston, David T. and Knoll, Andrew H. and Schrag, Daniel P.},
