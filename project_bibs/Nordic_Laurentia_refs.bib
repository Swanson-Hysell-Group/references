	eprint = {http://gji.oxfordjournals.org/content/37/1/51.full.pdf+html},
	journal = {Geophysical Journal International},
	number = {1},
	pages = {51-72},
	title = {Palaeomagnetism of Precambrian Sedimentary Rocks from NW Scotland and the Apparent Polar Wandering Path of Laurentia},
	volume = {37},
	year = {1974},
	bdsk-url-1 = {http://gji.oxfordjournals.org/content/37/1/51.abstract},
	bdsk-url-2 = {http://dx.doi.org/10.1111/j.1365-246X.1974.tb02443.x}}

