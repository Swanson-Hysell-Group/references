@article{Hodych1998a,
	annote = {10.1046/j.1365-246X.1998.00263.x},
	author = {Hodych, Joseph P. and Buchan, Kenneth L.},
	date = {1998/10/01},
	date-added = {2017-01-05 21:36:11 +0000},
	date-modified = {2017-01-06 18:04:45 +0000},
	journal = {Geophysical Journal International},
	journal1 = {Geophysical Journal International},
	month = {10},
	number = {1},
	pages = {155--164},
	title = {{Palaeomagnetism of the ca. 440 Ma Cape St Mary's sills of the Avalon Peninsula of Newfoundland: implications for Iapetus Ocean closure}},
	ty = {JOUR},
	url = {http://gji.oxfordjournals.org/content/135/1/155.abstract N2 - We report on the palaeomagnetism of the gabbroic Cape St Mary's sills of the Avalon Peninsula of Newfoundland, which have previously yielded a 441±2 Ma U-Pb baddeleyite age (latest Ordovician or earliest Silurian). At 12 of 19 sites, stepwise alternating-field or thermal demagnetization isolated a stable characteristic remanence carried by magnetite. This remanence is shown to pre-date Early Devonian folding of the sills. Although a baked-contact test was inconclusive, the positive fold test and the low grade of metamorphism of the sills (prehnite-pumpellyite facies) make it likely that the characteristic remanence is primary. The tilt-corrected site-mean characteristic remanence has a declination of 343° and an inclination of −51° (k=25, α95=9°), yielding a ∼440 Ma palaeopole at 10°N, 140°E (dm=12°, dp=8°) for West (North American) Avalonia. The corresponding ∼440 Ma palaeolatitude for the Avalon Peninsula is 32°S±8°. The only other West Avalonian palaeolatitude determination from rocks that could be of similar age is from the Dunn Point volcanics of Nova Scotia; their more southerly palaeolatitude of 41°S±5° suggests that they are significantly older than 440 Ma, a possibility that we recommend testing with U-Pb dating. Although no ∼440 Ma palaeolatitude determinations are available for East Avalonia (parts of southern Britain and Ireland), interpolating between mid-Ordovician and mid-Silurian determinations gives an estimate of ∼25°S. This is consistent with our Cape St Mary's result and, if the Iapetus Ocean closed orthogonally, with a narrow (∼1000 km) Iapetus Ocean of approximately east-west orientation between Avalonia and Laurentia by 440 Ma.},
	volume = {135},
	year = {1998},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://gji.oxfordjournals.org/content/135/1/155.abstract%20N2%20-%20We%20report%20on%20the%20palaeomagnetism%20of%20the%20gabbroic%20Cape%20St%20Mary's%20sills%20of%20the%20Avalon%20Peninsula%20of%20Newfoundland,%20which%20have%20previously%20yielded%20a%20441%C2%B12%20Ma%20U-Pb%20baddeleyite%20age%20(latest%20Ordovician%20or%20earliest%20Silurian).%20At%2012%20of%2019%20sites,%20stepwise%20alternating-field%20or%20thermal%20demagnetization%20isolated%20a%20stable%20characteristic%20remanence%20carried%20by%20magnetite.%20This%20remanence%20is%20shown%20to%20pre-date%20Early%20Devonian%20folding%20of%20the%20sills.%20Although%20a%20baked-contact%20test%20was%20inconclusive,%20the%20positive%20fold%20test%20and%20the%20low%20grade%20of%20metamorphism%20of%20the%20sills%20(prehnite-pumpellyite%20facies)%20make%20it%20likely%20that%20the%20characteristic%20remanence%20is%20primary.%20The%20tilt-corrected%20site-mean%20characteristic%20remanence%20has%20a%20declination%20of%20343%C2%B0%20and%20an%20inclination%20of%20%E2%88%9251%C2%B0%20(k=25,%20%CE%B195=9%C2%B0),%20yielding%20a%20%E2%88%BC440%20Ma%20palaeopole%20at%2010%C2%B0N,%20140%C2%B0E%20(dm=12%C2%B0,%20dp=8%C2%B0)%20for%20West%20(North%20American)%20Avalonia.%20The%20corresponding%20%E2%88%BC440%20Ma%20palaeolatitude%20for%20the%20Avalon%20Peninsula%20is%2032%C2%B0S%C2%B18%C2%B0.%20The%20only%20other%20West%20Avalonian%20palaeolatitude%20determination%20from%20rocks%20that%20could%20be%20of%20similar%20age%20is%20from%20the%20Dunn%20Point%20volcanics%20of%20Nova%20Scotia;%20their%20more%20southerly%20palaeolatitude%20of%2041%C2%B0S%C2%B15%C2%B0%20suggests%20that%20they%20are%20significantly%20older%20than%20440%20Ma,%20a%20possibility%20that%20we%20recommend%20testing%20with%20U-Pb%20dating.%20Although%20no%20%E2%88%BC440%20Ma%20palaeolatitude%20determinations%20are%20available%20for%20East%20Avalonia%20(parts%20of%20southern%20Britain%20and%20Ireland),%20interpolating%20between%20mid-Ordovician%20and%20mid-Silurian%20determinations%20gives%20an%20estimate%20of%20%E2%88%BC25%C2%B0S.%20This%20is%20consistent%20with%20our%20Cape%20St%20Mary's%20result%20and,%20if%20the%20Iapetus%20Ocean%20closed%20orthogonally,%20with%20a%20narrow%20(%E2%88%BC1000%20km)%20Iapetus%20Ocean%20of%20approximately%20east-west%20orientation%20between%20Avalonia%20and%20Laurentia%20by%20440%20Ma.}}

@article{Van-Avendonk2017a,
	abstract = {Earth/'s mantle has cooled by 6-11{$[$}thinsp{$]$}{$[$}deg{$]$}C every 100 million years since the Archaean, 2.5 billion years ago. In more recent times, the surface heat loss that led to this temperature drop may have been enhanced by plate-tectonic processes, such as continental breakup, the continuous creation of oceanic lithosphere at mid-ocean ridges and subduction at deep-sea trenches. Here we use a compilation of marine seismic refraction data from ocean basins globally to analyse changes in the thickness of oceanic crust over time. We find that oceanic crust formed in the mid-Jurassic, about 170 million years ago, is 1.7{$[$}thinsp{$]$}km thicker on average than crust produced along the present-day mid-ocean ridge system. If a higher mantle temperature is the cause of thicker Jurassic ocean crust, the upper mantle may have cooled by 15-20{$[$}thinsp{$]$}{$[$}deg{$]$}C per 100 million years over this time period. The difference between this and the long-term mantle cooling rate indeed suggests that modern plate tectonics coincide with greater mantle heat loss. We also find that the increase of ocean crustal thickness with plate age is stronger in the Indian and Atlantic oceans compared with the Pacific Ocean. This observation supports the idea that upper mantle temperature in the Jurassic was higher in the wake of the fragmented supercontinent Pangaea due to the effect of continental insulation.},
	author = {Van Avendonk, Harm J. A. and Davis, Joshua K. and Harding, Jennifer L. and Lawver, Lawrence A.},
	date = {2017/01//print},
	date-added = {2017-01-04 19:31:15 +0000},
	date-modified = {2017-01-04 19:31:15 +0000},
	isbn = {1752-0894},
	journal = {Nature Geosci},
	l3 = {10.1038/ngeo2849; http://www.nature.com/ngeo/journal/v10/n1/abs/ngeo2849.html#supplementary-information},
	m3 = {Article},
	month = {01},
	number = {1},
	pages = {58--61},
	publisher = {Nature Publishing Group},
	title = {Decrease in oceanic crustal thickness since the breakup of Pangaea},
	ty = {JOUR},
	url = {http://dx.doi.org/10.1038/ngeo2849},
	volume = {10},
	year = {2017},
	bdsk-file-1 = {},
	bdsk-file-2 = {},
	bdsk-url-1 = {http://dx.doi.org/10.1038/ngeo2849}}

