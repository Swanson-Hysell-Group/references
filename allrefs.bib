@article{Lhuillier2011a,
	abstract = {The knowledge of the spatial power spectra of the main geomagnetic field and of its secular variation makes it possible to define typical timescales \&{\#}964;n for each spherical harmonic degree n. Investigating both observations and numerical dynamos, we show that a one-parameter law of the form \&{\#}964;n = \&{\#}964;SV/n is satisfied for the non-dipole field, given the statistical way the observed \&{\#}964;n are expected to fluctuate. Consequently, we determine the corresponding secular-variation timescale \&{\#}964;SV from either instantaneous or time-averaged spectra, leading to a value of 415 $\pm$4555 yr for recent satellite field models. In the broader context of geomagnetic data assimilation, \&{\#}964;SV could provide a sensible and convenient means to rescale the time axis of dynamo simulations.},
	author = {Lhuillier, Florian and Fournier, Alexandre and Hulot, Gauthier and Aubert, Julien},
	date = {2011/05/05},
