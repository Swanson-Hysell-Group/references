@article{Conder2003a,
	annote = {10.1130/G19893.1},
	author = {Conder, Jan and Butler, Robert F. and DeCelles, Peter G. and Constenius, Kurt},
	date-added = {2012-12-10 22:21:17 +0000},
	date-modified = {2012-12-10 22:21:17 +0000},
	journal = {Geology},
	journal1 = {Geology},
	number = {12},
	pages = {1113--1116},
	title = {Paleomagnetic determination of vertical-axis rotations within the Charleston-Nebo salient, Utah},
	ty = {JOUR},
	url = {http://geology.gsapubs.org/content/31/12/1113.abstract N2 - The Charleston-Nebo salient is highly convex toward the foreland of the Sevier fold-thrust belt in Utah. To determine the importance of vertical-axis rotations to the kinematic history of the salient, paleomagnetic samples were collected from red Triassic strata of the Woodside Shale and Ankareh Formation from 68 sites distributed around the curvature of the salient. The paleomagnetic data indicate counterclockwise rotation of 33.3° ± 4.8° in the northern part of the salient and clockwise rotation of 66.7° ± 5.1° in the southern part of the salient. These data support divergent-flow models for thrust-salient development, augmented by relatively minor contributions from original basin geometry and local strike-slip along salient margins.},
	volume = {31},
	year = {December, 2003},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://geology.gsapubs.org/content/31/12/1113.abstract%20N2%20-%20The%20Charleston-Nebo%20salient%20is%20highly%20convex%20toward%20the%20foreland%20of%20the%20Sevier%20fold-thrust%20belt%20in%20Utah.%20To%20determine%20the%20importance%20of%20vertical-axis%20rotations%20to%20the%20kinematic%20history%20of%20the%20salient,%20paleomagnetic%20samples%20were%20collected%20from%20red%20Triassic%20strata%20of%20the%20Woodside%20Shale%20and%20Ankareh%20Formation%20from%2068%20sites%20distributed%20around%20the%20curvature%20of%20the%20salient.%20The%20paleomagnetic%20data%20indicate%20counterclockwise%20rotation%20of%2033.3%C2%B0%20%C2%B1%204.8%C2%B0%20in%20the%20northern%20part%20of%20the%20salient%20and%20clockwise%20rotation%20of%2066.7%C2%B0%20%C2%B1%205.1%C2%B0%20in%20the%20southern%20part%20of%20the%20salient.%20These%20data%20support%20divergent-flow%20models%20for%20thrust-salient%20development,%20augmented%20by%20relatively%20minor%20contributions%20from%20original%20basin%20geometry%20and%20local%20strike-slip%20along%20salient%20margins.}}

@article{Cocks2002a,
	annote = {10.1144/0016-764901-118},
	author = {Cocks, L. R. M. and Torsvik, T. H.},
	date = {2002/12/01},
	date-added = {2012-12-10 22:15:19 +0000},
	date-modified = {2012-12-10 22:15:19 +0000},
	journal = {Journal of the Geological Society},
	journal1 = {Journal of the Geological Society},
	month = {12},
	number = {6},
	pages = {631--644},
	title = {Earth geography from 500 to 400 million years ago: a faunal and palaeomagnetic review},
	ty = {JOUR},
	url = {http://jgs.lyellcollection.org/content/159/6/631.abstract N2 - Very different palaeogeographical reconstructions have been produced by a combination of palaeomagnetic and faunal data, which are re-evaluated on a global basis for the period from 500 to 400 Ma, and are presented with appropriate confidence (or lack of it) on six maps at 20 Ma intervals. The palaeomagnetic results are the most reliable for establishing the changing palaeolatitudes of Baltica, Laurentia and Siberia. However, global palaeomagnetic reliability dwindles over the 100 Ma, and more evidence for relative continental positioning can be gleaned from study of the distribution of the faunas in the later parts of the interval. The new maps were generated initially from palaeomagnetic data when available, but sometimes modified, and terranes were positioned in longitude to take account of key faunal data derived from the occurrences of selected trilobites, brachiopods and fish. Kinematic continuity over the long period is maintained. The many terranes without reliable palaeomagnetic data are placed according to the affinities of their contained fauna. The changing positions of the vast palaeocontinent of Gondwana (which has hitherto been poorly constrained) as it drifted over the South Pole during the interval have been revised and are now more confidently shown following analysis of both faunal and palaeomagnetic data in combination, as well as by the glacial and periglacial sediments in the latest Ordovician. In contrast, the peri-Gondwanan and other terranes of the Middle and Far East, Central Asia and Central America are poorly constrained.},
	volume = {159},
	year = {2002},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://jgs.lyellcollection.org/content/159/6/631.abstract%20N2%20-%20Very%20different%20palaeogeographical%20reconstructions%20have%20been%20produced%20by%20a%20combination%20of%20palaeomagnetic%20and%20faunal%20data,%20which%20are%20re-evaluated%20on%20a%20global%20basis%20for%20the%20period%20from%20500%20to%20400%20Ma,%20and%20are%20presented%20with%20appropriate%20confidence%20(or%20lack%20of%20it)%20on%20six%20maps%20at%2020%20Ma%20intervals.%20The%20palaeomagnetic%20results%20are%20the%20most%20reliable%20for%20establishing%20the%20changing%20palaeolatitudes%20of%20Baltica,%20Laurentia%20and%20Siberia.%20However,%20global%20palaeomagnetic%20reliability%20dwindles%20over%20the%20100%20Ma,%20and%20more%20evidence%20for%20relative%20continental%20positioning%20can%20be%20gleaned%20from%20study%20of%20the%20distribution%20of%20the%20faunas%20in%20the%20later%20parts%20of%20the%20interval.%20The%20new%20maps%20were%20generated%20initially%20from%20palaeomagnetic%20data%20when%20available,%20but%20sometimes%20modified,%20and%20terranes%20were%20positioned%20in%20longitude%20to%20take%20account%20of%20key%20faunal%20data%20derived%20from%20the%20occurrences%20of%20selected%20trilobites,%20brachiopods%20and%20fish.%20Kinematic%20continuity%20over%20the%20long%20period%20is%20maintained.%20The%20many%20terranes%20without%20reliable%20palaeomagnetic%20data%20are%20placed%20according%20to%20the%20affinities%20of%20their%20contained%20fauna.%20The%20changing%20positions%20of%20the%20vast%20palaeocontinent%20of%20Gondwana%20(which%20has%20hitherto%20been%20poorly%20constrained)%20as%20it%20drifted%20over%20the%20South%20Pole%20during%20the%20interval%20have%20been%20revised%20and%20are%20now%20more%20confidently%20shown%20following%20analysis%20of%20both%20faunal%20and%20palaeomagnetic%20data%20in%20combination,%20as%20well%20as%20by%20the%20glacial%20and%20periglacial%20sediments%20in%20the%20latest%20Ordovician.%20In%20contrast,%20the%20peri-Gondwanan%20and%20other%20terranes%20of%20the%20Middle%20and%20Far%20East,%20Central%20Asia%20and%20Central%20America%20are%20poorly%20constrained.}}

