	title = {Neogene block rotation in central Iran: Evidence from paleomagnetic data},
	ty = {JOUR},
	volume = {124},
	year = {2012},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://gsabulletin.gsapubs.org/content/124/5-6/943.abstract%20N2%20-%20Paleomagnetic%20results%20from%20Oligocene%E2%80%93Miocene%20sedimentary%20units%20in%20central%20Iran%20are%20used%20to%20reconstruct%20the%20history%20of%20Neogene%20tectonic%20deformation%20of%20this%20region.%20Paleomagnetic%20data%20show%20that%20in%20central%20Iran,%20crustal%20blocks%20bounded%20by%20sets%20of%20strike-slip%20faults%20are%20rotated%20to%20accommodate%20NNE-SSW%20shortening%20related%20to%20Arabia-Eurasia%20convergence.%20Counterclockwise%20rotations%20of%2020%C2%B0%E2%80%9335%C2%B0%20have%20been%20measured%20in%20the%20Tabas%20and%20Anarak%20areas,%20south%20of%20the%20Great%20Kavir%20fault,%20characterized%20by%20the%20presence%20of%20N-S%20to%20NNW-SSE%20right-lateral%20strike-slip%20faults.%20Conversely,%20in%20the%20Great%20Kavir%20and%20Torud%20areas,%20where%20ENE-WSW%20left-lateral%20strike-slip%20faults%20have%20been%20recognized,%20paleomagnetic%20results%20are%20less%20conclusive%20because%20the%20small%20amount%20of%20measured%20clockwise%20rotation%20shows%20a%20statistical%20uncertainty,%20which%20also%20includes%20the%20possibility%20of%20no%20rotation.%20Some%20of%20these%20faults%20have%20been%20active%20during%20the%20Quaternary%20up%20to%20present%20day,%20suggesting%20the%20possibility%20that%20block%20rotation%20is%20still%20occurring%20in%20central%20Iran.}}

@article{Tsukui2012a,
	annote = {10.1130/B30545.1},
