	bdsk-file-1 = {},
	bdsk-file-2 = {},
	bdsk-url-1 = {http://geology.gsapubs.org/content/39/12/1123.abstract%20N2%20-%20Major%20lineages%20of%20modern%20eukaryotes,%20represented%20primarily%20by%20microscopic%20taxa,%20are%20thought%20to%20have%20originated%20during%20the%20Neoproterozoic,%20but%20microfossils%20older%20than%20635%20Ma%20rarely%20have%20unambiguous%20relationships%20to%20modern%20microscopic%20eukaryotes.%20Here%20we%20report%20exceptionally%20preserved%20715%E2%80%93635%20m.y.%20old%20eukaryotic%20tests%20in%20limestone%20strata%20of%20Mongolia.%20The%20%E2%88%BC100-%CE%BCm-long%20organic-rich%20three-dimensional%20tests%20have%20flask-like%20shapes,%20constricted%20necks,%20distinct%20and%20often%20thickened%20collars,%20and%20flexible%20walls%20composed%20of%20densely%20packed%20alveolar%20structures.%20The%20combined%20morphological%20and%20ultrastructural%20characters%20of%20these%20Cryogenian%20tests%20are%20remarkably%20similar%20to%20the%20tests%20of%20tintinnids,%20modern%20planktonic%20ciliates.%20Eukaryotes%20forming%20recalcitrant%20organic%20or%20mineral-rich%20tests%20before%20635%20Ma%20may%20have%20increased%20export%20and%20burial%20fraction%20of%20organic%20carbon,%20driving%20an%20increase%20in%20atmospheric%20oxygen%20and%20the%20subsequent%20radiation%20of%20metazoans.}}

@article{Gomez2005a,
	annote = {10.1130/B25456.1},
	author = {G{\'o}mez, El{\'\i}as and Jordan, Teresa E. and Allmendinger, Richard W. and Cardozo, Nestor},
	date = {2005},
	date-added = {2011-11-15 06:16:35 +0000},
	date-modified = {2012-10-29 20:46:19 +0000},
	journal = {Geological Society of America Bulletin},
	journal1 = {Geological Society of America Bulletin},
	number = {9-10},
	pages = {1272--1292},
	title = {Development of the Colombian foreland-basin system as a consequence of diachronous exhumation of the northern Andes},
	ty = {JOUR},
	volume = {117},
	year = {2005},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://gsabulletin.gsapubs.org/content/117/9-10/1272.abstract%20N2%20-%20This%20study%20addresses%20multiple%20controls%20on%20foreland-basin%20accommodation%20and%20contributes%20to%20enhanced%20understanding%20of%20the%20evolution%20of%20the%20northern%20Andes.%20The%20Middle%20Magdalena%20Valley%20Basin%20(MMVB),%20Eastern%20Cordillera,%20and%20Llanos%20Basin%20are%20part%20of%20a%20Late%20Cretaceous%E2%80%93Cenozoic%20foreland-basin%20system,%20east%20of%20the%20Colombian%20Central%20Cordillera.%20Mechanical%20modeling%20indicates%20that%20the%20primary%20control%20on%20complex%20distributions%20of%20sedimentary%20thicknesses,%20facies,%20and%20unconformities%20was%20lithospheric%20flexure%20in%20response%20to%20crustal%20loads%20from%20the%20Central%20and%20Eastern%20Cordilleras.%20Shorter-wavelength%20folding%20and%20paleoaltitude%20determined%20the%20local%20character%20of%20strata.%20Our%20mechanical%20modeling%20consists%20of%20the%20application%20of%20orogenic%20and%20sedimentary%20loads%20extracted%20from%20geologic%20data%20on%20a%20continuous%20elastic%20lithosphere.%20The%20results%20validate%20two%20major%20basin%20configurations.%20The%20first%20configuration%20was%20a%20Maastrichtian%E2%80%93early%20Eocene%20foreland%20basin%20coupled%20with%20Central%20Cordillera%20uplift.%20Growth%20strata%20record%20continuous%20sedimentation%20in%20the%20Eastern%20Cordillera,%20whereas%20regional%20unconformities%20in%20the%20Llanos%20Basin%20(distal%20foreland%20basin)%20reflect%20isostatic%20adjustments%20of%20the%20basin's%20amplitude%20and%20wavelength%20to%20Central%20Cordillera%20episodic%20uplift%20and%20tectonic%20quiescence.%20The%20second%20major%20basin%20configuration%20was%20characterized%20by%20Central%20Cordillera%20erosion%20since%20middle%20Eocene%20times%20recorded%20by%20a%20regional%20pediment%20surface.%20In%20the%20absence%20of%20Central%20Cordillera%20effective%20loading,%20loads%20from%20onlapping%20sediments%20and%20Eastern%20Cordillera%20piggyback%20sub-basins%20provoked%20post%E2%80%93middle%20Eocene%20accommodation%20in%20the%20MMVB%20and%20Llanos%20Basin.%20Intensified%20Eastern%20Cordillera%20uplift%20during%20the%20Neogene%20produced%20basinal%20tilting%20recorded%20by%20unconformities%20in%20the%20MMVB.%20This%20study%20highlights%20the%20importance%20of%20assessing%20the%20causes%20of%20tectonic%20accommodation%20as%20a%20foundation%20for%20interpretation%20of%20the%20evolution%20of%20large%20foreland%20and%20intermontane%20basins.}}

