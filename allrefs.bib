	title = {The North-West Highlands memoir: a century-old legacy for understanding Earth before Pangaea},
	ty = {JOUR},
	volume = {335},
	year = {2010},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://sp.lyellcollection.org/content/335/1/189.abstract%20N2%20-%20Benjamin%20Peach,%20John%20Horne%20and%20their%20co-workers%20recognized%20a%20century%20ago%20that%20the%20identical%20fauna%20and%20lithofacies%20of%20the%20lower%20Palaeozoic%20strata%20in%20the%20NW%20Highlands%20of%20Scotland%20and%20the%20North%20American%20craton%20could%20only%20be%20explained%20if%20they%20were:%20%E2%80%98part%20of%20one%20and%20the%20same%20geological%20and%20zoological%20province%E2%80%99.%20In%20this%20sense%20their%20work%20provided%20critical%20geological%20underpinning%20for%20the%20subsequent%20understanding%20of%20Mesozoic%E2%80%93Cenozoic%20seafloor%20spreading%20and%20continental%20drift.%20%E2%80%98Tectonic%20tracers%E2%80%99%20such%20as%20the%20fragment%20of%20Laurentian%20craton%20in%20the%20NW%20Highlands%20of%20Scotland,%20provide%20the%20strongest%20evidence%20available%20for%20deciphering%20pre-Pangaea%20palaeogeography.%20The%20Laurentian%20craton%20appears%20to%20have%20left%20several%20such%20tectonic%20%E2%80%98calling%20cards%E2%80%99%20in%20today's%20southern%20continents.%20Intriguingly,%20it%20is%20the%20presence%20in%20the%20Andean%20Precordillera%20of%20northwestern%20Argentina%20of%20an%20early%20Palaeozoic%20fauna%20identical%20to%20that%20of%20the%20NW%20Highlands%20that%20provides%20perhaps%20the%20most%20unequivocal%20geological%20clue%20to%20pre-Pangaea%20palaeogeography.%20Recent%20work%20in%20East%20Antarctic%20and%20Laurentian%20cratons%20has%20provided%20a%20positive%20test%20of%20the%20hypothesis%20that%20they%20were%20once%20juxtaposed%20prior%20to%20the%20Neoproterozoic%20opening%20of%20the%20Pacific%20Ocean%20basin.%20Geochronology%20and%20isotope%20geochemistry,%20supported%20by%20palaeomagnetic%20studies%20indicate%20that%20the%20Coats%20Land%20crustal%20block%20of%20East%20Antarctica%20at%20the%20head%20of%20the%20Weddell%20Sea%20is%20also%20a%20fragment%20of%20the%20Laurentian%20craton.%20These%20three%20%E2%80%98tectonic%20tracers%E2%80%99%20permit%20tracking%20of%20the%20Laurentian%20craton%20in%20relation%20to%20the%20present%20southern%20continents%20from%20the%20Neoproterozoic%20break-up%20of%20the%20Rodinian%20supercontinent%20to%20the%20late%20Palaeozoic%20assembly%20of%20Pangaea.}}

