@article{Halls2014a,
	abstract = {Abstract In the last 130 million years, perhaps as much as 2000 km of intra-continental shortening has taken place within Asia during 10,000 km of convergence between Siberia and India (with ∼8000 km being accommodated by oceanic subduction). Given that Earth was hotter during the Paleoproterozoic, crustal shortening at this time may have been equally, if not more, significant compared to today, warranting a search of the paleomagnetic data base for any supporting evidence. Paleomagnetic data from units on either side of the Paleoproterozoic Trans Hudson orogen in Canada have been chosen because this orogen bears close similarity both in size and history to the India-Siberia one. The data do not prove, but can accommodate, continental crustal shortening between the Archean Slave and Superior Provinces of about 3000 $\pm$ 1000 km. The results allow crustal shortening to have been a significant component of continental collision in the Paleoproterozoic, an important issue in any re-assembly of Precambrian continents. If true, the present dimensions of Precambrian shields, may be significantly different compared to those existing in earlier times. },
	author = {Henry Halls},
	date-added = {2017-03-11 20:23:37 +0000},
	date-modified = {2017-03-11 20:23:41 +0000},
	doi = {http://dx.doi.org/10.1016/j.precamres.2013.09.005},
	issn = {0301-9268},
	journal = {Precambrian Research},
	keywords = {Crustal shortening},
	note = {Precambrian SupercontinentsPrecambrian Supercontinents},
	pages = {42 - 52},
	title = {Crustal shortening during the Paleoproterozoic: Can it be accommodated by paleomagnetic data?},
	url = {http://www.sciencedirect.com/science/article/pii/S0301926813002611},
	volume = {244},
	year = {2014},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://www.sciencedirect.com/science/article/pii/S0301926813002611},
	bdsk-url-2 = {http://dx.doi.org/10.1016/j.precamres.2013.09.005}}

