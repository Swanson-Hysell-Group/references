	pages = {3736--3741},
	title = {Leaks in the pipeline: separating demographic inertia from ongoing gender differences in academia},
	ty = {JOUR},
	volume = {279},
	year = {2012},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://rspb.royalsocietypublishing.org/content/279/1743/3736.abstract%20N2%20-%20Identification%20of%20the%20causes%20underlying%20the%20under-representation%20of%20women%20and%20minorities%20in%20academia%20is%20a%20source%20of%20ongoing%20concern%20and%20controversy.%20This%20is%20a%20critical%20issue%20in%20ensuring%20the%20openness%20and%20diversity%20of%20academia;%20yet%20differences%20in%20personal%20experiences%20and%20interpretations%20have%20mired%20it%20in%20controversy.%20We%20construct%20a%20simple%20model%20of%20the%20academic%20career%20that%20can%20be%20used%20to%20identify%20general%20trends,%20and%20separate%20the%20demographic%20effects%20of%20historical%20differences%20from%20ongoing%20biological%20or%20cultural%20gender%20differences.%20We%20apply%20the%20model%20to%20data%20on%20academics%20collected%20by%20the%20National%20Science%20Foundation%20(USA)%20over%20the%20past%20three%20decades,%20across%20all%20of%20science%20and%20engineering,%20and%20within%20six%20disciplines%20(agricultural%20and%20biological%20sciences,%20engineering,%20mathematics%20and%20computer%20sciences,%20physical%20sciences,%20psychology,%20and%20social%20sciences).%20We%20show%20that%20the%20hiring%20and%20retention%20of%20women%20in%20academia%20have%20been%20affected%20by%20both%20demographic%20inertia%20and%20gender%20differences,%20but%20that%20the%20relative%20influence%20of%20gender%20differences%20appears%20to%20be%20dwindling%20for%20most%20disciplines%20and%20career%20transitions.%20Our%20model%20enables%20us%20to%20identify%20the%20two%20key%20non-structural%20bottlenecks%20restricting%20female%20participation%20in%20academia:%20choice%20of%20undergraduate%20major%20and%20application%20to%20faculty%20positions.%20These%20transitions%20are%20those%20in%20greatest%20need%20of%20detailed%20study%20and%20policy%20development.}}

@article{Tarduno2012b,
	annote = {10.1126/science.1223932},
	author = {Tarduno, John A. and Cottrell, Rory D. and Nimmo, Francis and Hopkins, Julianna and Voronov, Julia and Erickson, Austen and Blackman, Eric and Scott, Edward R. D. and McKinley, Robert},
	date = {2012/11/16},
	date-added = {2012-11-23 23:29:42 +0000},
	date-modified = {2012-11-23 23:29:42 +0000},
	journal = {Science},
	journal1 = {Science},
	month = {11},
	number = {6109},
	pages = {939--942},
	title = {Evidence for a Dynamo in the Main Group Pallasite Parent Body},
	ty = {JOUR},
	url = {http://www.sciencemag.org/content/338/6109/939.abstract N2 - Understanding the origin of pallasites, stony-iron meteorites made mainly of olivine crystals and FeNi metal, has been a vexing problem since their discovery. Here, we show that pallasite olivines host minute magnetic inclusions that have favorable magnetic recording properties. Our paleointensity measurements indicate strong paleomagnetic fields, suggesting dynamo action in the pallasite parent body. We use these data and thermal modeling to suggest that some pallasites formed when liquid FeNi from the core of an impactor was injected as dikes into the shallow mantle of a ~200-kilometer-radius protoplanet. The protoplanet remained intact for at least several tens of millions of years after the olivine-metal mixing event.},
	volume = {338},
	year = {2012},
