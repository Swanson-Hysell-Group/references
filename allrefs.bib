	ty = {JOUR},
	volume = {109},
	year = {2012},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://www.pnas.org/content/109/3/728.abstract%20N2%20-%20An%20asteroid%20impact%20at%20the%20end%20of%20the%20Cretaceous%20caused%20mass%20extinction,%20but%20extinction%20mechanisms%20are%20not%20well-understood.%20The%20collapse%20of%20sea%20surface%20to%20sea%20floor%20carbon%20isotope%20gradients%20has%20been%20interpreted%20as%20reflecting%20a%20global%20collapse%20of%20primary%20productivity%20(Strangelove%20Ocean)%20or%20export%20productivity%20(Living%20Ocean),%20which%20caused%20mass%20extinction%20higher%20in%20the%20marine%20food%20chain.%20Phytoplankton-dependent%20benthic%20foraminifera%20on%20the%20deep-sea%20floor,%20however,%20did%20not%20suffer%20significant%20extinction,%20suggesting%20that%20export%20productivity%20persisted%20at%20a%20level%20sufficient%20to%20support%20their%20populations.%20We%20compare%20benthic%20foraminiferal%20records%20with%20benthic%20and%20bulk%20stable%20carbon%20isotope%20records%20from%20the%20Pacific,%20Southeast%20Atlantic,%20and%20Southern%20Oceans.%20We%20conclude%20that%20end-Cretaceous%20decrease%20in%20export%20productivity%20was%20moderate,%20regional,%20and%20insufficient%20to%20explain%20marine%20mass%20extinction.%20A%20transient%20episode%20of%20surface%20ocean%20acidification%20may%20have%20been%20the%20main%20cause%20of%20extinction%20of%20calcifying%20plankton%20and%20ammonites,%20and%20recovery%20of%20productivity%20may%20have%20been%20as%20fast%20in%20the%20oceans%20as%20on%20land.}}

