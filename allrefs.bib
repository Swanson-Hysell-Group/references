@article{Rudolph2015a,
	author = {Rudolph, Maxwell L. and Leki{\'c}, Vedran and Lithgow-Bertelloni, Carolina},
	date = {2015/12/10},
	date-added = {2016-03-15 19:55:55 +0000},
	date-modified = {2016-03-15 19:55:55 +0000},
	journal = {Science},
	m3 = {10.1126/science.aad1929},
	month = {12},
	n2 = {The viscosity of Earth's deep interior plays a key role in mediating plate tectonics. Rudolph et al. combined several geophysical data sets to model the viscosity of the mantle. Mantle viscosity abruptly increases below 1000 km. The increase could explain the stalling of subducting slabs and the deflections of hot upwelling plumes around this depth. Although the viscosity increase explains some recent unexpected observations, the origin of the jump itself remains a mystery.Science, this issue p. 1349The viscosity structure of Earth's deep mantle affects the thermal evolution of Earth, the ascent of mantle plumes, settling of subducted oceanic lithosphere, and the mixing of compositional heterogeneities in the mantle. Based on a reanalysis of the long-wavelength nonhydrostatic geoid, we infer viscous layering of the mantle using a method that allows us to avoid a priori assumptions about its variation with depth. We detect an increase in viscosity at 800- to 1200-kilometers depth, far greater than the depth of the mineral phase transformations that define the mantle transition zone. The viscosity increase is coincident in depth with regions where seismic tomography has imaged slab stagnation, plume deflection, and changes in large-scale structure and offers a simple explanation of these phenomena.},
	number = {6266},
	pages = {1349--1352},
	title = {Viscosity jump in Earth's mid-mantle},
	ty = {JOUR},
	url = {http://science.sciencemag.org/content/350/6266/1349.abstract},
	volume = {350},
	year = {2015},
	bdsk-url-1 = {http://science.sciencemag.org/content/350/6266/1349.abstract}}

@article{LARSON1985a,
	annote = {10.1130/0016-7606(1985)96<1364:PPASEO>2.0.CO;2},
	author = {LARSON, E. E. and PATTERSON, P. E. and CURTIS, G. and DRAKE, K. and MUTSCHLER, F. E.},
	date = {1985/11/01},
	date-added = {2016-03-14 22:51:08 +0000},
	date-modified = {2016-03-14 22:51:08 +0000},
	journal = {Geological Society of America Bulletin},
	journal1 = {Geological Society of America Bulletin},
	month = {11},
	number = {11},
	pages = {1364--1372},
	title = {Petrologic, paleomagnetic, and structural evidence of a Paleozoic rift system in Oklahoma, New Mexico, Colorado, and Utah},
	ty = {JOUR},
	url = {http://gsabulletin.gsapubs.org/content/96/11/1364.abstract N2 - A west-northwest–trending dike swarm consisting of at least 50 mafic dikes cuts Precambrian basement rocks in the area in and south of the Black Canyon of the Gunnison, Colorado, and in Unaweap Canyon near the Colorado-Utah border. The dikes have been studied petrographically, petrochemically, and paleomagnetically, and they have been radiometrically dated. Lithologically, the dike rocks are very similar, consisting of tholeiitic diabase composed primarily of labradorite, augite, and granophyric intergrowths of quartz and alkali feldspar. A Rb-Sr isochron based on mineral separates from one dike yields an age of 495 ±15 m.y. which is statistically identical with a previously reported Rb-Sr date. Pooling the age data for these two dikes gives an age of 497 ± 16 m.y. Whole-rock K-Ar dates on four of the dikes are scattered around the Rb-Sr date and indicate that the dikes have been relatively unaffected by reheating or hydrothermal activity since emplacement.Paleomagnetic directional data from nine of the dikes are well grouped and consistent after both alternating-field (AF) and thermal demagnetization. Several lines of evidence indicate that the remanence reflects the dipolar geomagnetic field direction at the time the dikes were emplaced. Paleopoles corresponding to the mean directions are located at 37.0°N, 101.0°E, δp = 8.6°, δm = 16.4° (AF demagnetization) and 37.0°N, 102.3°E, δp = 4.9°, δm = 9.4° (thermal demagnetization). The consistency of the paleomagnetic data corroborates the idea that the dike swarm is the result of one short pulse of mantle-derived magmatic activity.The dike swarm and other Cambro-Ordovician igneous rocks in Colorado (Powderhorn alkalic complex, Wet Mountains alkalic complexes and dikes) are aligned along a linear west-northwest trend. Cambrian diabase dikes in northeastern New Mexico and a bimodal suite (basalt–gabbro-rhyolite–granite) in southern Oklahoma (Wichita and Arbuckle Mountains, Anadarko Basin) are on line with this trend. Petrologically, all of these Cambrian and Cambro-Ordovician igneous rocks represent types that are typically associated with extensional tectonic regimes. From these data and consideration of documented Paleozoic tectonic activity along the trend of the plutons, it is concluded that throughout the Paleozoic, a west-northwest–trending tectonic zone extended from southeastern Oklahoma, through northeastern New Mexico and Colorado, and into southeastern Utah. Bimodal (basalt-rhyolite) and alkalic igneous activity was restricted to the Cambrian and Cambro-Ordovician, but tectonic activity occurred intermittently along the zone throughout the Paleozoic.},
	volume = {96},
	year = {1985},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://gsabulletin.gsapubs.org/content/96/11/1364.abstract%20N2%20-%20A%20west-northwest%E2%80%93trending%20dike%20swarm%20consisting%20of%20at%20least%2050%20mafic%20dikes%20cuts%20Precambrian%20basement%20rocks%20in%20the%20area%20in%20and%20south%20of%20the%20Black%20Canyon%20of%20the%20Gunnison,%20Colorado,%20and%20in%20Unaweap%20Canyon%20near%20the%20Colorado-Utah%20border.%20The%20dikes%20have%20been%20studied%20petrographically,%20petrochemically,%20and%20paleomagnetically,%20and%20they%20have%20been%20radiometrically%20dated.%20Lithologically,%20the%20dike%20rocks%20are%20very%20similar,%20consisting%20of%20tholeiitic%20diabase%20composed%20primarily%20of%20labradorite,%20augite,%20and%20granophyric%20intergrowths%20of%20quartz%20and%20alkali%20feldspar.%20A%20Rb-Sr%20isochron%20based%20on%20mineral%20separates%20from%20one%20dike%20yields%20an%20age%20of%20495%20%C2%B115%20m.y.%20which%20is%20statistically%20identical%20with%20a%20previously%20reported%20Rb-Sr%20date.%20Pooling%20the%20age%20data%20for%20these%20two%20dikes%20gives%20an%20age%20of%20497%20%C2%B1%2016%20m.y.%20Whole-rock%20K-Ar%20dates%20on%20four%20of%20the%20dikes%20are%20scattered%20around%20the%20Rb-Sr%20date%20and%20indicate%20that%20the%20dikes%20have%20been%20relatively%20unaffected%20by%20reheating%20or%20hydrothermal%20activity%20since%20emplacement.Paleomagnetic%20directional%20data%20from%20nine%20of%20the%20dikes%20are%20well%20grouped%20and%20consistent%20after%20both%20alternating-field%20(AF)%20and%20thermal%20demagnetization.%20Several%20lines%20of%20evidence%20indicate%20that%20the%20remanence%20reflects%20the%20dipolar%20geomagnetic%20field%20direction%20at%20the%20time%20the%20dikes%20were%20emplaced.%20Paleopoles%20corresponding%20to%20the%20mean%20directions%20are%20located%20at%2037.0%C2%B0N,%20101.0%C2%B0E,%20%CE%B4p%20=%208.6%C2%B0,%20%CE%B4m%20=%2016.4%C2%B0%20(AF%20demagnetization)%20and%2037.0%C2%B0N,%20102.3%C2%B0E,%20%CE%B4p%20=%204.9%C2%B0,%20%CE%B4m%20=%209.4%C2%B0%20(thermal%20demagnetization).%20The%20consistency%20of%20the%20paleomagnetic%20data%20corroborates%20the%20idea%20that%20the%20dike%20swarm%20is%20the%20result%20of%20one%20short%20pulse%20of%20mantle-derived%20magmatic%20activity.The%20dike%20swarm%20and%20other%20Cambro-Ordovician%20igneous%20rocks%20in%20Colorado%20(Powderhorn%20alkalic%20complex,%20Wet%20Mountains%20alkalic%20complexes%20and%20dikes)%20are%20aligned%20along%20a%20linear%20west-northwest%20trend.%20Cambrian%20diabase%20dikes%20in%20northeastern%20New%20Mexico%20and%20a%20bimodal%20suite%20(basalt%E2%80%93gabbro-rhyolite%E2%80%93granite)%20in%20southern%20Oklahoma%20(Wichita%20and%20Arbuckle%20Mountains,%20Anadarko%20Basin)%20are%20on%20line%20with%20this%20trend.%20Petrologically,%20all%20of%20these%20Cambrian%20and%20Cambro-Ordovician%20igneous%20rocks%20represent%20types%20that%20are%20typically%20associated%20with%20extensional%20tectonic%20regimes.%20From%20these%20data%20and%20consideration%20of%20documented%20Paleozoic%20tectonic%20activity%20along%20the%20trend%20of%20the%20plutons,%20it%20is%20concluded%20that%20throughout%20the%20Paleozoic,%20a%20west-northwest%E2%80%93trending%20tectonic%20zone%20extended%20from%20southeastern%20Oklahoma,%20through%20northeastern%20New%20Mexico%20and%20Colorado,%20and%20into%20southeastern%20Utah.%20Bimodal%20(basalt-rhyolite)%20and%20alkalic%20igneous%20activity%20was%20restricted%20to%20the%20Cambrian%20and%20Cambro-Ordovician,%20but%20tectonic%20activity%20occurred%20intermittently%20along%20the%20zone%20throughout%20the%20Paleozoic.}}

