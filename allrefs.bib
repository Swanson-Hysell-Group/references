	author = {Ramezani, Jahandar and Hoke, Gregory D. and Fastovsky, David E. and Bowring, Samuel A. and Therrien, Fran{\c c}ois and Dworkin, Steven I. and Atchley, Stacy C. and Nordt, Lee C.},
