	bdsk-url-1 = {http://www.sciencemag.org/content/336/6080/459.abstract%20N2%20-%20Cyanobacteria%20have%20affected%20major%20geochemical%20cycles%20(carbon,%20nitrogen,%20and%20oxygen)%20on%20Earth%20for%20billions%20of%20years.%20In%20particular,%20they%20have%20played%20a%20major%20role%20in%20the%20formation%20of%20calcium%20carbonates%20(i.e.,%20calcification),%20which%20has%20been%20considered%20to%20be%20an%20extracellular%20process.%20We%20identified%20a%20cyanobacterium%20in%20modern%20microbialites%20in%20Lake%20Alchichica%20(Mexico)%20that%20forms%20intracellular%20amorphous%20calcium-magnesium-strontium-barium%20carbonate%20inclusions%20about%20270%20nanometers%20in%20average%20diameter,%20revealing%20an%20unexplored%20pathway%20for%20calcification.%20Phylogenetic%20analyses%20place%20this%20cyanobacterium%20within%20the%20deeply%20divergent%20order%20Gloeobacterales.%20The%20chemical%20composition%20and%20structure%20of%20the%20intracellular%20precipitates%20suggest%20some%20level%20of%20cellular%20control%20on%20the%20biomineralization%20process.%20This%20discovery%20expands%20the%20diversity%20of%20organisms%20capable%20of%20forming%20amorphous%20calcium%20carbonates.}}

@article{Finnegan2012a,
	annote = {10.1073/pnas.1117039109},
	author = {Finnegan, Seth and Heim, Noel A. and Peters, Shanan E. and Fischer, Woodward W.},
	date = {2012/05/01},
	date-added = {2012-05-02 15:02:27 +0000},
	date-modified = {2012-10-29 20:46:18 +0000},
	journal = {Proceedings of the National Academy of Sciences},
	journal1 = {Proceedings of the National Academy of Sciences},
	month = {05},
	number = {18},
	pages = {6829--6834},
	title = {Climate change and the selective signature of the Late Ordovician mass extinction},
	ty = {JOUR},
	volume = {109},
	year = {2012},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://www.pnas.org/content/109/18/6829.abstract%20N2%20-%20Selectivity%20patterns%20provide%20insights%20into%20the%20causes%20of%20ancient%20extinction%20events.%20The%20Late%20Ordovician%20mass%20extinction%20was%20related%20to%20Gondwanan%20glaciation;%20however,%20it%20is%20still%20unclear%20whether%20elevated%20extinction%20rates%20were%20attributable%20to%20record%20failure,%20habitat%20loss,%20or%20climatic%20cooling.%20We%20examined%20Middle%20Ordovician-Early%20Silurian%20North%20American%20fossil%20occurrences%20within%20a%20spatiotemporally%20explicit%20stratigraphic%20framework%20that%20allowed%20us%20to%20quantify%20rock%20record%20effects%20on%20a%20per-taxon%20basis%20and%20assay%20the%20interplay%20of%20macrostratigraphic%20and%20macroecological%20variables%20in%20determining%20extinction%20risk.%20Genera%20that%20had%20large%20proportions%20of%20their%20observed%20geographic%20ranges%20affected%20by%20stratigraphic%20truncation%20or%20environmental%20shifts%20at%20the%20end%20of%20the%20Katian%20stage%20were%20particularly%20hard%20hit.%20The%20duration%20of%20the%20subsequent%20sampling%20gaps%20had%20little%20effect%20on%20extinction%20risk,%20suggesting%20that%20this%20extinction%20pulse%20cannot%20be%20entirely%20attributed%20to%20rock%20record%20failure;%20rather,%20it%20was%20caused,%20in%20part,%20by%20habitat%20loss.%20Extinction%20risk%20at%20this%20time%20was%20also%20strongly%20influenced%20by%20the%20maximum%20paleolatitude%20at%20which%20a%20genus%20had%20previously%20been%20sampled,%20a%20macroecological%20trait%20linked%20to%20thermal%20tolerance.%20A%20model%20trained%20on%20the%20relationship%20between%2016%20explanatory%20variables%20and%20extinction%20patterns%20during%20the%20early%20Katian%20interval%20substantially%20underestimates%20the%20extinction%20of%20exclusively%20tropical%20taxa%20during%20the%20late%20Katian%20interval.%20These%20results%20indicate%20that%20glacioeustatic%20sea-level%20fall%20and%20tropical%20ocean%20cooling%20played%20important%20roles%20in%20the%20first%20pulse%20of%20the%20Late%20Ordovician%20mass%20extinction%20in%20Laurentia.}}

@article{Stamatakos1998a,
	annote = {10.1130/0016-7606(1998)110<1530:PCOTTE>2.3.CO;2},
	author = {Stamatakos, John A. and Ferrill, David A. and Spivey, Kathy H.},
	date-added = {2012-05-02 14:58:17 +0000},
	date-modified = {2012-10-29 20:46:18 +0000},
	journal = {Geological Society of America Bulletin},
	journal1 = {Geological Society of America Bulletin},
	number = {12},
	pages = {1530--1546},
	title = {Paleomagnetic constraints on the tectonic evolution of Bare Mountain, Nevada},
	ty = {JOUR},
	volume = {110},
	year = {December, 1998},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://gsabulletin.gsapubs.org/content/110/12/1530.abstract%20N2%20-%20Paleomagnetic%20investigations%20of%20Tertiary%20dikes%20and%20Ordovician%20carbonate%20rocks%20at%20Bare%20Mountain%20and%20in%20the%20surrounding%20region%20of%20southwestern%20Nevada%20were%20conducted%20to%20further%20constrain%20possible%20rotations%20related%20to%20Walker%20Lane%20dextral%20shear%20and%20Basin%20and%20Range%20detachment%20faulting.%20Demagnetization%20experiments%20revealed%20two%20distinct%20remanence%20components%20in%20the%20Ordovician%20carbonate%20rocks:%20(1)%20a%20dual%20polarity%20Permian-Triassic%20magnetization%20carried%20by%20magnetite%20that%20was%20acquired%20after%20Paleozoic%20or%20Mesozoic%20folding%20but%20prior%20to%20Tertiary%20tilting;%20and%20(2)%20a%20dual%20polarity%20Miocene%20magnetization%20carried%20by%20hematite%20that%20was%20acquired%20after%20folding%20and%20tilting.%20The%20Tertiary%20dikes%20also%20contain%20a%20dual%20polarity%20magnetization%20carried%20by%20magnetite%20that%20can%20be%20interpreted%20either%20as%20a%20primary%20thermoremanent%20magnetization%20or%20a%20secondary%20chemical%20remanent%20magnetization%20acquired%20shortly%20after%20dike%20intrusion.%20Overall,%20mean%20directions%20for%20all%20three%20magnetizations%20roughly%20coincide%20with%20corresponding%20reference%20directions%20for%20Nevada.%20The%20largest%20declination%20discordance%20of%2016%C2%B0%20%C2%B1%207%C2%B0%20(clockwise)%20comes%20from%20comparison%20of%20the%20Permian-Triassic%20magnetite%20magnetization%20to%20the%20Late%20Permian%20reference%20direction%20for%20Nevada.%20Thus,%20although%20structural%20and%20geothermal%20data,%20including%20zircon%20fission-track%20ages,%20indicate%20that%20northern%20Bare%20Mountain%20was%20tilted%2020%C2%B0%E2%80%9340%C2%B0%20northeastward%20about%20a%20horizontal%20axis%20during%20early%20Tertiary%20time,%20we%20find%20no%20evidence%20for%20large-scale%20(i.e.,%20%3E30%C2%B0)%20vertical-axis%20rotation.%20On%20the%20basis%20of%20these%20results,%20we%20suggest%20that%20Bare%20Mountain%20forms%20an%20autochthonous%20or%20parautochthonous%20footwall%20within%20the%20Basin%20and%20Range%20and%20Walker%20Lane,%20in%20a%20region%20where%20many%20of%20the%20surrounding%20upper%20crustal%20rocks%20are%20detached%20and%20significantly%20rotated%20about%20vertical%20and%20steeply%20inclined%20axes.%20In%20addition,%20the%20nature%20and%20timing%20of%20footwall%20uplift%20indicated%20by%20our%20paleomagnetic%20results%20do%20not%20support%20tectonic%20models%20that%20reconstruct%20Bare%20Mountain%20and%20the%20Striped%20Hills%20as%20adjacent%20segments%20of%20a%20continuous%20fold%20and%20thrust%20belt%20system.%20Finally,%20we%20suggest%20that%20the%20postfolding%20Permian%E2%80%93Triassic%20magnetization%20at%20Bare%20Mountain%20coupled%20with%20Paleozoic%20zircon%20fission-track%20ages%20indicate%20that%20the%20Meiklejohn%20Peak%20thrust%20predates%20Jurassic-Cretaceous%20(Sevier)%20deformation%20and%20may%20have%20instead%20resulted%20from%20a%20Permian%20or%20earlier%20contractional%20event.}}

