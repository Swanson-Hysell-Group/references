@article{Huang2013a,
	abstract = {It has been debated whether there was southward movement of the South China Block (SCB) during the Cretaceous. In this study, a paleomagnetic investigation was carried out on the Late Cretaceous volcanic rocks (∼88 Ma) of the Shimaoshan Group in Yongtai County, Fujian Province. Rock magnetic experiments showed that magnetite in pseudo-single-domain and multi-domain grain and hematite were predominant magnetic phases. Stepwise thermal demagnetization successfully isolated characteristic directional components at high-temperature interval (> 500{\textdegree}C) from 383 specimens in 19 sites, which yielded a paleomagnetic pole for the studied section at 83.1{\textdegree}N, 152.6{\textdegree}E (N = 19, A                95 = 3.9{\textdegree}), and the scatter S                                  B                 = 9.0. The Fisher distribution of virtual geomagnetic poles (VGPs) and the consistence of S                                  B                 with the expected value at the 95{\%} confidence level indicate that the yielded paleomagnetic pole is free of paleomagnetic secular variation influence. The new pole, which is well consistent with that from the Eurasian apparent polar wander path (APWP) curve, suggests no obvious southward movement of the sampling site during the Cretaceous.},
	author = {Huang, Sheng and Pan, YongXin and Zhu, RiXiang},
	date-added = {2017-07-13 20:21:16 +0000},
	date-modified = {2017-07-13 20:21:21 +0000},
	day = {01},
	doi = {10.1007/s11430-012-4519-8},
	issn = {1869-1897},
	journal = {Science China Earth Sciences},
	month = {Jan},
	number = {1},
	pages = {22--30},
	title = {Paleomagnetism of the Late Cretaceous volcanic rocks of the Shimaoshan Group in Yongtai County, Fujian Province},
	url = {http://dx.doi.org/10.1007/s11430-012-4519-8},
	volume = {56},
	year = {2013},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://dx.doi.org/10.1007/s11430-012-4519-8}}

@article{Hillhouse2011a,
	abstract = {We report remanent magnetization measurements from 13 sites in Cretaceous plutonic rocks in the northern Sierra Nevada (38{\textdegree}N{\textendash}39.5{\textdegree}N). By increasing the number of available paleomagnetic sites, the new data tighten constraints on the displacement history of the Sierra Nevada block and its pre-extensional position relative to interior North America. We collected samples in freshly exposed outcrops along four highway transects. The rocks include diorite, granodiorite, and tonalite with potassium-argon ages (hornblende) ranging from 100 Ma to 83 Ma. By combining our results with previous paleomagnetic determinations from the central and southern Sierra Nevada (excluding sites from the rotated southern tip east of the White Wolf{\textendash}Kern Canyon fault system), we find a mean paleomagnetic pole of 70.5{\textdegree}N, 188.2{\textdegree}E, A95 = 2.6{\textdegree} (N = 26, Fisher concentration parameter, K = 118). Thermal demagnetization indicates that the characteristic remanence is generally unblocked in a narrow range within 35 {\textdegree}C of the Curie temperature of pure magnetite. Small apparent polar wander during the Cretaceous normal-polarity superchron, plus prolonged acquisition of remanence at the site level, may account for the low dispersion of virtual geomagnetic poles and relatively large K value. Tilt estimates based on overlapping sediments, stream gradients, and thermochronology of the Sierra Nevada plutons vary from 0{\textdegree} to 3{\textdegree} down to the southwest. Without tilt correction, the mean paleomagnetic pole for the Sierra Nevada is essentially coincident with the North American reference pole during the Cretaceous stillstand (125 Ma to 80 Ma). At 95\% confidence, the apparent latitude shift is 1.1{\textdegree} {\textpm} 3.0{\textdegree} (positive northward), and the apparent rotation is negligible, 0.0{\textdegree} {\textpm} 4.7{\textdegree}. Correcting for each degree of tilt, which is limited to 3{\textdegree} on geologic evidence, increases the rotation anomaly 2.2{\textdegree} counterclockwise, while the apparent latitude shift remains unchanged.},
	author = {Hillhouse, John W. and Gromm{\'e}, Sherman},
	date-added = {2017-07-13 20:14:40 +0000},
	date-modified = {2017-07-13 20:15:28 +0000},
	doi = {10.1130/L142.1},
	eprint = {http://lithosphere.geoscienceworld.org/content/3/4/275.full.pdf},
	issn = {1941-8264},
	journal = {Lithosphere},
	number = {4},
	pages = {275--288},
	publisher = {Geological Society of America},
	title = {Updated paleomagnetic pole from {C}retaceous plutonic rocks of the {S}ierra {N}evada, {C}alifornia: {T}ectonic displacement of the {S}ierra {N}evada block},
	url = {http://lithosphere.geoscienceworld.org/content/3/4/275},
	volume = {3},
	year = {2011},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://lithosphere.geoscienceworld.org/content/3/4/275},
	bdsk-url-2 = {http://dx.doi.org/10.1130/L142.1}}

