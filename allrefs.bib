@article{Kroner2010a,
	annote = {10.2475/07.2010.01},
	author = {Kr{\"o}ner, Alfred and Lehmann, J{\'e}r{\'e}mie and Schulmann, Karel and Demoux, Antoine and Lexa, Ondrej and Tomurhuu, Dondov and {\v S}t{\'\i}psk{\'a}, Pavla and Liu, Dunyi and Wingate, Michael T. D.},
	date-added = {2013-11-07 17:39:45 +0000},
	date-modified = {2013-11-07 17:39:45 +0000},
	journal = {American Journal of Science},
	journal1 = {American Journal of Science},
	number = {7},
	pages = {523--574},
	title = {Lithostratigraphic and geochronological constraints on the evolution of the Central Asian Orogenic Belt in SW Mongolia: Early Paleozoic rifting followed by late Paleozoic accretion},
	ty = {JOUR},
	url = {http://www.ajsonline.org/content/310/7/523.abstract N2 - New SHRIMP U-Pb and evaporation Pb-Pb zircon ages, together with a revision of the lithostratigraphy of “suspect” terranes in SW Mongolia, suggest that the collage of continental and oceanic units in this region resulted from recurrent magmatic reworking and deformation of Silurian–early Devonian proximal and distal passive margin sequences of the Paleo-Asian Ocean. The zircon ages from early Ordovician volcaniclastic rocks and syntectonic felsic dikes reveal an heterogeneous stretching of the Precambrian Dzabkhan microcontinent (Lake Zone basement) during the Ordovician, followed by the development of a carbonate platform on a proximal margin (Gobi-Altai Zone), serpentinite breccias and Silurian chert sequences on a distal margin and possibly also the formation of oceanic crust. The assumed early Neoproterozoic South Gobi continental zone may either represent an allochthonous block detached from Dzabkhan or, less likely, the conjugate margin of a Paleo-Asian continental rift. Early Devonian volcanism subsequently affected both types of margins with back-arc spreading centers and arcs located in the core of the future Trans-Altai Zone. During the late Devonian to early Carboniferous a Japan-type magmatic arc developed on the previously stretched continental crust of the Gobi-Altai Zone. This event was associated with shortening of the entire domain, exhumation of the deep arc core and formation of intramontane basins with Devonian and Carboniferous detrital zircons of the adjacent Lake Zone continent. Clastic, flysch-type sedimentation occurred on the former distal margin and in oceanic areas. During this early Carboniferous contraction event the continental and oceanic units were imbricated and accreted to the continent in the north. Subsequently, late Carboniferous volcanic arc sequences and a Japan-type magmatic arc developed on the Trans-Altai oceanic crust and the southern South Gobi Zone, respectively. Finally, a Permian thermal event was localized in the Gobi-Altai–Lake Zone contact domain and was responsible for formation of Permian grabens, bimodal volcanism and substantial melting of the accreted crust.},
	volume = {310},
	year = {September 2010},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://www.ajsonline.org/content/310/7/523.abstract%20N2%20-%20New%20SHRIMP%20U-Pb%20and%20evaporation%20Pb-Pb%20zircon%20ages,%20together%20with%20a%20revision%20of%20the%20lithostratigraphy%20of%20%E2%80%9Csuspect%E2%80%9D%20terranes%20in%20SW%20Mongolia,%20suggest%20that%20the%20collage%20of%20continental%20and%20oceanic%20units%20in%20this%20region%20resulted%20from%20recurrent%20magmatic%20reworking%20and%20deformation%20of%20Silurian%E2%80%93early%20Devonian%20proximal%20and%20distal%20passive%20margin%20sequences%20of%20the%20Paleo-Asian%20Ocean.%20The%20zircon%20ages%20from%20early%20Ordovician%20volcaniclastic%20rocks%20and%20syntectonic%20felsic%20dikes%20reveal%20an%20heterogeneous%20stretching%20of%20the%20Precambrian%20Dzabkhan%20microcontinent%20(Lake%20Zone%20basement)%20during%20the%20Ordovician,%20followed%20by%20the%20development%20of%20a%20carbonate%20platform%20on%20a%20proximal%20margin%20(Gobi-Altai%20Zone),%20serpentinite%20breccias%20and%20Silurian%20chert%20sequences%20on%20a%20distal%20margin%20and%20possibly%20also%20the%20formation%20of%20oceanic%20crust.%20The%20assumed%20early%20Neoproterozoic%20South%20Gobi%20continental%20zone%20may%20either%20represent%20an%20allochthonous%20block%20detached%20from%20Dzabkhan%20or,%20less%20likely,%20the%20conjugate%20margin%20of%20a%20Paleo-Asian%20continental%20rift.%20Early%20Devonian%20volcanism%20subsequently%20affected%20both%20types%20of%20margins%20with%20back-arc%20spreading%20centers%20and%20arcs%20located%20in%20the%20core%20of%20the%20future%20Trans-Altai%20Zone.%20During%20the%20late%20Devonian%20to%20early%20Carboniferous%20a%20Japan-type%20magmatic%20arc%20developed%20on%20the%20previously%20stretched%20continental%20crust%20of%20the%20Gobi-Altai%20Zone.%20This%20event%20was%20associated%20with%20shortening%20of%20the%20entire%20domain,%20exhumation%20of%20the%20deep%20arc%20core%20and%20formation%20of%20intramontane%20basins%20with%20Devonian%20and%20Carboniferous%20detrital%20zircons%20of%20the%20adjacent%20Lake%20Zone%20continent.%20Clastic,%20flysch-type%20sedimentation%20occurred%20on%20the%20former%20distal%20margin%20and%20in%20oceanic%20areas.%20During%20this%20early%20Carboniferous%20contraction%20event%20the%20continental%20and%20oceanic%20units%20were%20imbricated%20and%20accreted%20to%20the%20continent%20in%20the%20north.%20Subsequently,%20late%20Carboniferous%20volcanic%20arc%20sequences%20and%20a%20Japan-type%20magmatic%20arc%20developed%20on%20the%20Trans-Altai%20oceanic%20crust%20and%20the%20southern%20South%20Gobi%20Zone,%20respectively.%20Finally,%20a%20Permian%20thermal%20event%20was%20localized%20in%20the%20Gobi-Altai%E2%80%93Lake%20Zone%20contact%20domain%20and%20was%20responsible%20for%20formation%20of%20Permian%20grabens,%20bimodal%20volcanism%20and%20substantial%20melting%20of%20the%20accreted%20crust.}}

