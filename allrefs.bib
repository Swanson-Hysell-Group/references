	pages = {233-247},
	publisher = {Royal Society of Edinburgh Scotland Foundation},
	title = {{The Bail Hill Volcanic Group: alkaline within-plate volcanism during Ordovician sedimentation in the Southern Uplands, Scotland}},
	ty = {JOUR},
	url = {https://www.cambridge.org/core/article/bail-hill-volcanic-group-alkaline-withinplate-volcanism-during-ordovician-sedimentation-in-the-southern-uplands-scotland/5E6B0F5BFA1EC6B9D5543EF9A3FF9B83},
