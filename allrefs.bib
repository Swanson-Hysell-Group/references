	journal1 = {Proceedings of the National Academy of Sciences},
	month = {10},
	number = {42},
	pages = {16065--16070},
	title = {Equatorial convergence of India and early Cenozoic climate trends},
	ty = {JOUR},
	volume = {105},
	year = {2008},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://www.pnas.org/content/105/42/16065.abstract%20N2%20-%20India's%20northward%20flight%20and%20collision%20with%20Asia%20was%20a%20major%20driver%20of%20global%20tectonics%20in%20the%20Cenozoic%20and,%20we%20argue,%20of%20atmospheric%20CO2%20concentration%20(pCO2)%20and%20thus%20global%20climate.%20Subduction%20of%20Tethyan%20oceanic%20crust%20with%20a%20carpet%20of%20carbonate-rich%20pelagic%20sediments%20deposited%20during%20transit%20beneath%20the%20high-productivity%20equatorial%20belt%20resulted%20in%20a%20component%20flux%20of%20CO2%20delivery%20to%20the%20atmosphere%20capable%20to%20maintain%20high%20pCO2%20levels%20and%20warm%20climate%20conditions%20until%20the%20decarbonation%20factory%20shut%20down%20with%20the%20collision%20of%20Greater%20India%20with%20Asia%20at%20the%20Early%20Eocene%20climatic%20optimum%20at%20%E2%89%8850%20Ma.%20At%20about%20this%20time,%20the%20India%20continent%20and%20the%20highly%20weatherable%20Deccan%20Traps%20drifted%20into%20the%20equatorial%20humid%20belt%20where%20uptake%20of%20CO2%20by%20efficient%20silicate%20weathering%20further%20perturbed%20the%20delicate%20equilibrium%20between%20CO2%20input%20to%20and%20removal%20from%20the%20atmosphere%20toward%20progressively%20lower%20pCO2%20levels,%20thus%20marking%20the%20onset%20of%20a%20cooling%20trend%20over%20the%20Middle%20and%20Late%20Eocene%20that%20some%20suggest%20triggered%20the%20rapid%20expansion%20of%20Antarctic%20ice%20sheets%20at%20around%20the%20Eocene-Oligocene%20boundary.}}

@article{Bergstrom2010c,
	annote = {10.1130/2010.2466(04)},
	author = {Bergstr{\"o}m, Stig M. and Schmitz, Birger and Saltzman, Matthew R. and Huff, Warren D.},
	date = {2010/04/01},
	date-added = {2011-11-06 20:53:49 +0000},
	date-modified = {2012-10-29 20:46:19 +0000},
	journal = {Geological Society of America Special Papers},
	journal1 = {Geological Society of America Special Papers},
	month = {04},
	pages = {37--67},
	title = {The Upper Ordovician Guttenberg δ13C excursion (GICE) in North America and Baltoscandia: Occurrence, chronostratigraphic significance, and paleoenvironmental relationships},
	ty = {JOUR},
	volume = {466},
	year = {2010},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://specialpapers.gsapubs.org/content/466/37.abstract%20N2%20-%20Two%20prominent,%20and%20apparently%20globally%20distributed,%20%CE%B413C%20excursions%20have%20been%20documented%20from%20the%20Upper%20Ordovician,%20namely%20the%20early%20Katian%20Guttenberg%20isotope%20carbon%20excursion%20(GICE)%20and%20the%20latest%20Ordovician%20Hirnantian%20isotope%20carbon%20excursion%20(HICE).%20The%20former%20excursion,%20which%20has%20lower%20%CE%B413C%20values%20than%20the%20HICE,%20is%20now%20recorded%20from%20dozens%20of%20localities%20in%20North%20America%20and%20Baltoscandia,%20and%20it%20appears%20to%20be%20present%20also%20in%20China.%20In%20North%20America%20the%20GICE%20ranges%20from%20the%20uppermost%20Phragmodus%20undatus%20Midcontinent%20Conodont%20Zone%20to%20near%20the%20top%20of%20the%20Plectodina%20tenuis%20Midcontinent%20Conodont%20Zone,%20an%20interval%20corresponding%20to%20the%20lower%20part%20of%20the%20Diplacanthograptus%20caudatus%20Global%20Graptolite%20Zone.%20The%20base%20of%20the%20GICE%20lies%20somewhat%20above%20the%20Millbrig%20K-bentonite.%20In%20Baltoscandia%20the%20GICE%20occurs%20in%20the%20upper%20Diplograptus%20foliaceus%20through%20the%20lower%20Dicranograptus%20clingani%20Graptolite%20Zones,%20and%20in%20the%20upper%20Amorphognathus%20tvaerensis%20Conodont%20Zone.%20Its%20base%20is%20a%20few%20meters%20above%20the%20widespread%20Kinnekulle%20K-bentonite.%20In%20Baltoscandia%20and%20in%20Oklahoma%20the%20GICE%20ranges%20through%20a%20part%20of%20the%20Spinachitina%20cervicornis%20Chitinozoan%20Zone.%20In%20North%20America%20the%20GICE%20is%20regionally%20in%20a%20transgressive-regressive%20succession.%20The%20bathymetric%20conditions%20in%20the%20GICE%20interval%20in%20Baltoscandia%20were%20somewhat%20complex%20and%20have%20been%20the%20subject%20of%20different%20interpretations,%20but%20there%20is%20no%20obvious%20correlation%20between%20the%20GICE%20and%20apparent%20sea%20level%20changes.%20A%20review%20of%20the%20relations%20between%20the%20GICE%20and%20potential%20climatic%20and%20water%20temperature%20indicators,%20such%20as%20lithofacies,%20faunas,%20and%2018O%20geochemistry,%20does%20not%20suggest%20a%20close%20correlation%20to%20specific%20environmental%20conditions.%20The%20cause%20of%20formation%20of%20the%20GICE%20is%20enigmatic,%20but%20there%20is%20no%20direct%20evidence%20that%20it%20was%20coeval%20with%20a%20period%20of%20extensive%20glaciation%20in%20the%20Gondwana.%20The%20GICE%20is%20a%20powerful%20chemostratigraphic%20tool%20that%20is%20useful%20for%20detailed%20local%20and%20even%20transatlantic%20correlations.}}

@article{BERGSTROM2009a,
	abstract = {The only published {\{}delta{\}}13C data from the Ordovician of China are from the Lower and Upper Ordovician, and only the latter records include a significant excursion, namely the Hirnantian excursion (HICE). Our recent chemostratigraphic work on the Upper Ordovician (Sandbian-Katian) Pagoda and Yanwashan formations at several localities on the Yangtze Platform and Chiangnan (Jiangnan) slope belt has resulted in the recognition of a positive {\{}delta{\}}13C excursion that has values of \~{} +1.5 {\{}per thousand{\}} above baseline values. This excursion starts a few metres above a stratigraphic interval with B. alobatus Subzone conodonts as well as graptolites of the N. gracilis Zone. The distinctive conodonts Amorphognathus aff. Am. ventilatus and Hamarodus europaeus first occur at, or very near, the excursion interval. Because these conodonts appear in the stratigraphic interval of the Guttenberg {\{}delta{\}}13C excursion (GICE) in Estonia, we identify the Chinese excursion as the GICE. This is the first record of the GICE in the entire Asian continent. It confirms that GICE is a global excursion and provides an illustration of how {\{}delta{\}}13C chemostratigraphy, combined with new biostratigraphic data, solves the problem of the previously controversial age of the Pagoda Formation and how this classical stratigraphic unit correlates with the Baltoscandian and North American successions. },
	annote = {10.1017/S0016756808005748},
	author = {BERGSTROM, STIG M. and XU, CHEN and SCHMITZ, BIRGER and YOUNG, SETH and JIA-YU, RONG and SALTZMAN, MATTHEW R.},
	date = {2009/1/1},
	date-added = {2011-11-06 20:50:10 +0000},
	date-modified = {2012-10-29 20:46:19 +0000},
	journal = {Geological Magazine},
	journal1 = {Geological Magazine},
	month = {1},
	number = {1},
	pages = {1--11},
	title = {First documentation of the Ordovician Guttenberg {\{}delta{\}}13C excursion (GICE) in Asia: chemostratigraphy of the Pagoda and Yanwashan formations in southeastern China},
	ty = {JOUR},
	volume = {146},
	year = {2009},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://geolmag.geoscienceworld.org/cgi/content/abstract/146/1/1}}

@article{Sagnotti2011a,
	abstract = {A high-resolution paleomagnetic and rock magnetic study has been carried out on sediment cores collected in glaciomarine silty-clay sequences from the continental shelf and slope of the southern Storfjorden trough-mouth fan, on the northwestern Barents Sea continental margin. The Storfjorden sedimentary system was investigated during the SVAIS and EGLACOM cruises, when 10 gravity cores, with a variable length from 1.03 m to 6.41 m, were retrieved. Accelerator mass spectrometry (AMS) 14C analyses on 24 samples indicate that the cores span a time interval that includes the Holocene, the last deglaciation phase and in some cores the last glacial maximum. The sediments carry a well-defined characteristic remanent magnetization and have a valuable potential to reconstruct the paleosecular variation (PSV) of the geomagnetic field, including relative paleointensity (RPI) variations. The paleomagnetic data allow reconstruction of past dynamics and amplitude of the geomagnetic field variations at high northern latitudes (75∞\&{\#}8211;76∞N). At the same time, the rock magnetic and paleomagnetic data allow a high-resolution correlation of the sedimentary sequences and a refinement of their preliminary age models. The Holocene PSV and RPI records appear particularly sound, since they are consistent between cores and they can be correlated to the closest regional stacking curves (UK PSV, FENNOSTACK and FENNORPIS) and global geomagnetic model for the last 7 ka (CALS7k.2). The computed amplitude of secular variation is lower than that outlined by some geomagnetic field models, suggesting that it has been almost independent from latitude during the Holocene.},
	author = {Sagnotti, Leonardo and Macr{\"I}, Patrizia and Lucchi, Renata and Rebesco, Michele and Camerlenghi, Angelo},
	date = {2011/11/01},
	date-added = {2011-11-02 16:42:35 +0000},
	date-modified = {2012-10-29 20:46:19 +0000},
	isbn = {1525-2027},
	journal = {Geochem. Geophys. Geosyst.},
	keywords = {Barents Sea; Holocene; Storfjorden; geomagnetic paleosecular variation; relative paleointensity; 1521 Geomagnetism and Paleomagnetism: Paleointensity; 1522 Geomagnetism and Paleomagnetism: Paleomagnetic secular variation; 1560 Geomagnetism and Paleomagnetism: Time variations: secular and longer},
	month = {11},
	number = {11},
	publisher = {AGU},
	sp = {Q11Z33},
	title = {A Holocene paleosecular variation record from the northwestern Barents Sea continental margin},
	ty = {JOUR},
	volume = {12},
	year = {2011},
	bdsk-url-1 = {http://dx.doi.org/10.1029/2011GC003810}}

@article{Manthilake2011a,
	annote = {10.1073/pnas.1110594108},
	author = {Manthilake, Geeth M. and de Koker, Nico and Frost, Dan J. and McCammon, Catherine A.},
	date = {2011/11/01},
	date-added = {2011-11-02 14:40:36 +0000},
	date-modified = {2011-11-02 14:40:36 +0000},
	journal = {Proceedings of the National Academy of Sciences},
	journal1 = {Proceedings of the National Academy of Sciences},
	month = {11},
	number = {44},
	pages = {17901--17904},
	title = {Lattice thermal conductivity of lower mantle minerals and heat flux from Earth's core},
	ty = {JOUR},
	url = {http://www.pnas.org/content/108/44/17901.abstract N2 - The amount of heat flowing from Earth’s core critically determines the thermo-chemical evolution of both the core and the lower mantle. Consisting primarily of a polycrystalline aggregate of silicate perovskite and ferropericlase, the thermal boundary layer at the very base of Earth’s lower mantle regulates the heat flow from the core, so that the thermal conductivity (k) of these mineral phases controls the amount of heat entering the lowermost mantle. Here we report measurements of the lattice thermal conductivity of pure, Al-, and Fe-bearing MgSiO3 perovskite at 26 GPa up to 1,073 K, and of ferropericlase containing 0, 5, and 20% Fe, at 8 and 14 GPa up to 1,273 K. We find the incorporation of these elements in silicate perovskite and ferropericlase to result in a ∼50% decrease of lattice thermal conductivity relative to the end member compositions. A model of thermal conductivity constrained from our results indicates that a peridotitic mantle would have k = 9.1 ± 1.2 W/m K at the top of the thermal boundary layer and k = 8.4 ± 1.2 W/m K at its base. These values translate into a heat flux of 11.0 ± 1.4 terawatts (TW) from Earth’s core, a range of values consistent with a variety of geophysical estimates.},
	volume = {108},
	year = {2011},
	bdsk-file-1 = {}}

