@article{Wang2013a,
	annote = {10.1073/pnas.1205308110},
	author = {Wang, Huapei and Kent, Dennis V. and Jackson, Michael J.},
	date = {2013/01/08},
	date-added = {2013-02-11 14:33:11 +0000},
