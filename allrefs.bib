	year = {2011},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://www.ajsonline.org/content/311/8/651.abstract%20N2%20-%20Hotspot%20tracks%20represent%20plate%20motions%20relative%20to%20mantle%20sources,%20and%20paleomagnetic%20data%20from%20magmatic%20units%20along%20those%20tracks%20can%20quantify%20motions%20of%20those%20mantle%20anomalies%20relative%20to%20the%20Earth's%20magnetic%20field%20and%20rotational%20axis.%20The%20Ediacaran%20Period%20is%20notable%20for%20rapid%20and%20large%20paleomagnetic%20apparent%20polar%20wander%20(APW)%20for%20many%20continents.%20Whereas%20magmatic%20units%20attributed%20to%20the%20%E2%80%9CSutton%E2%80%9D%20mantle%20plume%20suggest%20a%20practically%20stationary%20hotspot%20track,%20paleolatitudes%20of%20Laurentia%20for%20that%20interval%20vary%20dramatically;%20geologic%20and%20paleomagnetic%20data%20are%20at%20odds%20unless%20true%20polar%20wander%20(TPW)%20is%20invoked%20to%20explain%20a%20majority%20of%20APW.%20Here%20we%20test%20the%20plume-TPW%20hypothesis%20by%20generating%20the%20predicted%20Sutton%20hotspot%20track%20for%20a%20stationary%20plume%20under%20a%20moving%20plate%20along%20the%20Laurentian%20margin%20during%20the%20interval%20from%20615%20to%20530%20Ma.%20Our%20model%20is%20the%20first%20to%20provide%20a%20kinematic%20framework%20for%20the%20extensive%20large%20igneous%20province%20associated%20with%20opening%20the%20Iapetus%20Ocean.}}

@article{Woodcock2004a,
	annote = {10.1130/G20598.1},
