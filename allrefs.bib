	volume = {424},
	year = {2016},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://sp.lyellcollection.org/content/early/2016/02/26/SP424.12.abstract%20N2%20-%20The%20supercontinent-cycle%20hypothesis%20attributes%20planetary-scale%20episodic%20tectonic%20events%20to%20an%20intrinsic%20self-organizing%20mode%20of%20mantle%20convection,%20governed%20by%20the%20buoyancy%20of%20continental%20lithosphere%20that%20resists%20subduction%20during%20closure%20of%20old%20ocean%20basins,%20and%20consequent%20reorganization%20of%20mantle%20convection%20cells%20leading%20to%20opening%20of%20new%20ocean%20basins.%20Characteristic%20timescales%20of%20the%20cycle%20are%20typically%20500%E2%80%93700%20myr.%20Proposed%20spatial%20patterns%20of%20cyclicity%20range%20from%20hemispheric%20(introversion)%20to%20antipodal%20(extroversion),%20to%20precisely%20between%20those%20end-members%20(orthoversion).%20Advances%20in%20our%20understanding%20can%20arise%20from%20theoretical%20or%20numerical%20modelling,%20primary%20data%20acquisition%20relevant%20to%20continental%20reconstructions,%20and%20spatiotemporal%20correlations%20between%20plate%20kinematics,%20geodynamic%20events%20and%20palaeoenvironmental%20history.%20The%20palaeogeographic%20record%20of%20supercontinental%20tectonics%20on%20Earth%20is%20still%20under%20development.%20The%20contributions%20in%20this%20special%20publication%20provide%20snap-shots%20in%20time%20of%20these%20investigations%20and%20indicate%20that%20Earth's%20palaeogeographic%20record%20incorporates%20elements%20of%20all%20three%20endmember%20spatial%20patterns.}}

