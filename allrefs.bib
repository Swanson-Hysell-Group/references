@article{Green1982a,
	annote = {10.1130/MEM156-p47},
	author = {Green, John C.},
	date = {1982/01/01},
	date-added = {2014-04-07 05:29:29 +0000},
	date-modified = {2020-06-22 11:30:07 -0700},
	journal = {Geological Society of America Memoirs},
	journal1 = {Geological Society of America Memoirs},
	pages = {47--56},
	title = {{5: Geology of Keweenawan extrusive rocks}},
	ty = {JOUR},
	volume = {156},
	year = {1982},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://memoirs.gsapubs.org/content/156/47.abstract%20N2%20-%20The%20volcanic%20rocks%20associated%20with%20the%20Midcontinent%20Rift%20System%20accumulated%20in%20at%20least%20eight%20basins%20in%20the%20Lake%20Superior%20area%20as%20the%20intensity%20and%20character%20of%20rifting%20changed%20in%20time%20and%20place.%20Each%20basin%20sank%20centrally,%20and%20the%20edges%20of%20some%20were%20eroded%20prior%20to%20the%20effusion%20of%20overlapping%20plateaus.%20Dike%20sets%20aligned%20parallel%20to%20the%20rift%20axis,%20the%20wide%20extent%20of%20many%20flows,%20and%20physical%20features%20indicating%20low%20viscosity%20show%20the%20volcanism%20to%20be%20dominated%20by%20fissure-fed%20flood%20eruptions,%20though%20a%20few%20central%20volcanoes%20were%20present.%20Al-rich%20olivine%20tholeiite%20is%20the%20dominant%20rock%20type,%20followed%20by%20transitional%20to%20weakly%20alkaline%20olivine%20basalt%20and%20a%20large%20proportion%20of%20high%20Fe%20tholeiite%20that%20grades%20into%20tholeiitic%20(basaltic)%20andesite.%20A%20few%20icelandites%20and%20more%20rhyolites%20are%20also%20present.%20The%20high%20A1%20olivine%20tholeiites%20include%20rather%20primitive%20members%20that%20could%20have%20been%20derived%20with%20only%20slight%20loss%20of%20olivine%20from%20partial%20melts%20of%20mantle%20lherzolite%20that%20had%20not%20previously%20been%20depleted%20in%20incompatible%20elements.%20Some%20rhyolites%20show%20Sr%20isotopic%20evidence%20of%20crustal%20contamination,%20but%20others%20do%20not.%20Specific%20fractional%20crystallization%20models%20involving%20major%20and%20trace%20elements%20have%20been%20unsuccessful,%20and%20the%20petrogenetic%20relations%20between%20the%20flows%20and%20the%20associated%20and%20underlying%20Duluth%20Complex%20remain%20obscure.}}

@article{Morey1982a,
	annote = {10.1130/MEM156-p15},
	author = {Morey, G. B. and Green, John C.},
	date = {1982/01/01},
	date-added = {2014-04-07 05:26:57 +0000},
	date-modified = {2014-04-07 05:26:57 +0000},
	journal = {Geological Society of America Memoirs},
	journal1 = {Geological Society of America Memoirs},
	month = {01},
	pages = {15--26},
	title = {3: Status of the Keweenawan as a stratigraphic unit in the Lake Superior region},
	ty = {JOUR},
	url = {http://memoirs.gsapubs.org/content/156/15.abstract N2 - The term “Keweenawan” has been used for over 100 years to designate a suite of dominantly mafic igneous and derivative sedimentary rocks that crop out around the shores of Lake Superior. Although the rocks have been extensively studied and described, there is no generally accepted stratigraphic definition of the term in the geologic literature. It has been used both as a lithostratigraphic and as a chronostratigraphic unit.This dual usage has resulted in confusion and consequent recommendations from time to time that the term be abandoned completely, but there is a growing consensus that the term “Keweenawan” best describes a lithostratigraphic package having supergroup status. As a chronostratigraphic term, however, no “Keweenawan Series” that accords with accepted stratigraphic procedures can be defined, because the rocks themselves are bounded by non-isochronous surfaces.Since 1911, the Keweenawan has been subdivided into the lower, middle and upper Keweenawan. These subdivisions, as first proposed by Van Hise and Leith (1911), are not chronostrati-graphic units, but rather are rock units with either time-transgressive boundaries or boundaries that cannot be traced for any appreciable distance. Recent suggested revisions in these lithostratigraphic boundaries, intended to make the boundaries more useful and more nearly isochronous, have had wide acceptance in the United States.The Keweenawan also has been subdivided into three paleomagnetic polarization sequences. Although several of the sequence boundaries coincide with unconformities representing hiatuses of unknown duration, the sequences have considerable value in intraregional correlations of rock units around Lake Superior. Furthermore, paleomagnetic pole positions associated with the polarization sequences should be recognizable worldwide and therefore should make excellent reference points for long-distance correlation. However, existing nomenclatural schemes using names such as lower Keweenawan and middle Keweenawan to designate paleomagnetic polarization sequences should be abandoned. These names can be confused with traditional lithostratigraphic terminology and should therefore be replaced by names that accord with accepted magnetostratigraphic procedures.},
	volume = {156},
	year = {1982},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://memoirs.gsapubs.org/content/156/15.abstract%20N2%20-%20The%20term%20%E2%80%9CKeweenawan%E2%80%9D%20has%20been%20used%20for%20over%20100%20years%20to%20designate%20a%20suite%20of%20dominantly%20mafic%20igneous%20and%20derivative%20sedimentary%20rocks%20that%20crop%20out%20around%20the%20shores%20of%20Lake%20Superior.%20Although%20the%20rocks%20have%20been%20extensively%20studied%20and%20described,%20there%20is%20no%20generally%20accepted%20stratigraphic%20definition%20of%20the%20term%20in%20the%20geologic%20literature.%20It%20has%20been%20used%20both%20as%20a%20lithostratigraphic%20and%20as%20a%20chronostratigraphic%20unit.This%20dual%20usage%20has%20resulted%20in%20confusion%20and%20consequent%20recommendations%20from%20time%20to%20time%20that%20the%20term%20be%20abandoned%20completely,%20but%20there%20is%20a%20growing%20consensus%20that%20the%20term%20%E2%80%9CKeweenawan%E2%80%9D%20best%20describes%20a%20lithostratigraphic%20package%20having%20supergroup%20status.%20As%20a%20chronostratigraphic%20term,%20however,%20no%20%E2%80%9CKeweenawan%20Series%E2%80%9D%20that%20accords%20with%20accepted%20stratigraphic%20procedures%20can%20be%20defined,%20because%20the%20rocks%20themselves%20are%20bounded%20by%20non-isochronous%20surfaces.Since%201911,%20the%20Keweenawan%20has%20been%20subdivided%20into%20the%20lower,%20middle%20and%20upper%20Keweenawan.%20These%20subdivisions,%20as%20first%20proposed%20by%20Van%20Hise%20and%20Leith%20(1911),%20are%20not%20chronostrati-graphic%20units,%20but%20rather%20are%20rock%20units%20with%20either%20time-transgressive%20boundaries%20or%20boundaries%20that%20cannot%20be%20traced%20for%20any%20appreciable%20distance.%20Recent%20suggested%20revisions%20in%20these%20lithostratigraphic%20boundaries,%20intended%20to%20make%20the%20boundaries%20more%20useful%20and%20more%20nearly%20isochronous,%20have%20had%20wide%20acceptance%20in%20the%20United%20States.The%20Keweenawan%20also%20has%20been%20subdivided%20into%20three%20paleomagnetic%20polarization%20sequences.%20Although%20several%20of%20the%20sequence%20boundaries%20coincide%20with%20unconformities%20representing%20hiatuses%20of%20unknown%20duration,%20the%20sequences%20have%20considerable%20value%20in%20intraregional%20correlations%20of%20rock%20units%20around%20Lake%20Superior.%20Furthermore,%20paleomagnetic%20pole%20positions%20associated%20with%20the%20polarization%20sequences%20should%20be%20recognizable%20worldwide%20and%20therefore%20should%20make%20excellent%20reference%20points%20for%20long-distance%20correlation.%20However,%20existing%20nomenclatural%20schemes%20using%20names%20such%20as%20lower%20Keweenawan%20and%20middle%20Keweenawan%20to%20designate%20paleomagnetic%20polarization%20sequences%20should%20be%20abandoned.%20These%20names%20can%20be%20confused%20with%20traditional%20lithostratigraphic%20terminology%20and%20should%20therefore%20be%20replaced%20by%20names%20that%20accord%20with%20accepted%20magnetostratigraphic%20procedures.}}

