@article{Spencer2013a,
	annote = {10.1130/G34520.1},
	author = {Spencer, Christopher J. and Hawkesworth, Chris and Cawood, Peter A. and Dhuime, Bruno},
	date = {2013/07/01},
	date-added = {2013-08-13 20:02:05 +0000},
	date-modified = {2013-08-13 20:02:05 +0000},
	journal = {Geology},
	journal1 = {Geology},
	month = {07},
	number = {7},
	pages = {795--798},
	title = {Not all supercontinents are created equal: Gondwana-Rodinia case study},
	ty = {JOUR},
	url = {http://geology.gsapubs.org/content/41/7/795.abstract N2 - The geologic records associated with the formation of the supercontinents Rodinia and Gondwana have markedly different seawater Sr and zircon Hf isotopic signatures. Rodinia-related (Grenville-Sveconorwegian-Sunsas) orogens display significantly less enriched crustal signatures than Gondwana-related (Pan-African) orogens. Seawater Sr isotope ratios also exhibit a more pronounced crustal signal during the span of the Gondwana supercontinent than at the time of Rodinia. Such isotopic differences are attributed to the age and nature of the continental margins involved in the collisional assembly, and specifically to the depleted mantle model ages, and hence the isotope ratios of the material weathered into the oceans. In our preferred model the isotopic signatures of Rodinia-suturing orogens reflect the closure of ocean basins with dual subduction zones verging in opposite directions, analogous to the modern Pacific basin. This would have resulted in the juxtaposition of juvenile continental and island arc terrains on both margins of the colliding plates, thus further reworking juvenile crust. Conversely, the assembly of Gondwana was accomplished primarily via a number of single-sided subduction zones that involved greater reworking of ancient cratonic lithologies within the collisional sutures. The proposed geodynamic models of the assembly of Rodinia and Gondwana provide a connection between the geodynamic configuration of supercontinent assembly and its resulting isotopic signature.},
	volume = {41},
	year = {2013},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://geology.gsapubs.org/content/41/7/795.abstract%20N2%20-%20The%20geologic%20records%20associated%20with%20the%20formation%20of%20the%20supercontinents%20Rodinia%20and%20Gondwana%20have%20markedly%20different%20seawater%20Sr%20and%20zircon%20Hf%20isotopic%20signatures.%20Rodinia-related%20(Grenville-Sveconorwegian-Sunsas)%20orogens%20display%20significantly%20less%20enriched%20crustal%20signatures%20than%20Gondwana-related%20(Pan-African)%20orogens.%20Seawater%20Sr%20isotope%20ratios%20also%20exhibit%20a%20more%20pronounced%20crustal%20signal%20during%20the%20span%20of%20the%20Gondwana%20supercontinent%20than%20at%20the%20time%20of%20Rodinia.%20Such%20isotopic%20differences%20are%20attributed%20to%20the%20age%20and%20nature%20of%20the%20continental%20margins%20involved%20in%20the%20collisional%20assembly,%20and%20specifically%20to%20the%20depleted%20mantle%20model%20ages,%20and%20hence%20the%20isotope%20ratios%20of%20the%20material%20weathered%20into%20the%20oceans.%20In%20our%20preferred%20model%20the%20isotopic%20signatures%20of%20Rodinia-suturing%20orogens%20reflect%20the%20closure%20of%20ocean%20basins%20with%20dual%20subduction%20zones%20verging%20in%20opposite%20directions,%20analogous%20to%20the%20modern%20Pacific%20basin.%20This%20would%20have%20resulted%20in%20the%20juxtaposition%20of%20juvenile%20continental%20and%20island%20arc%20terrains%20on%20both%20margins%20of%20the%20colliding%20plates,%20thus%20further%20reworking%20juvenile%20crust.%20Conversely,%20the%20assembly%20of%20Gondwana%20was%20accomplished%20primarily%20via%20a%20number%20of%20single-sided%20subduction%20zones%20that%20involved%20greater%20reworking%20of%20ancient%20cratonic%20lithologies%20within%20the%20collisional%20sutures.%20The%20proposed%20geodynamic%20models%20of%20the%20assembly%20of%20Rodinia%20and%20Gondwana%20provide%20a%20connection%20between%20the%20geodynamic%20configuration%20of%20supercontinent%20assembly%20and%20its%20resulting%20isotopic%20signature.}}

