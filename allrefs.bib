@article{Milne2002a,
	abstract = {We predict sea-level change since the Last Glacial Maximum (LGM) at four far-field sites (Barbados, Bonaparte Gulf, Huon Peninsula and Tahiti) using a revised theoretical formalism. This formalism includes a time-varying shoreline geometry, an accurate treatment of sea-level variations near regions of ice retreat and the influence of glacial cycle perturbations in Earth rotation. We elucidate the physics of far-field sea-level change by de-constructing the predicted signal into spatially uniform versus spatially varying components, as well as isolating contributions due to the ice load, the ocean load and the rotational potential. We demonstrate that the sum of these three contributions plus the spatially uniform sea-level fall associated the with retreat of grounded marine ice sheets can produce a significant difference between predictions of sea-level change at far-field sites and the eustatic (or meltwater) curve associated with the adopted ice model. This difference is site and time dependent. For example, the total sea-level rise since the LGM predicted using our ice-earth model can be either smaller (e.g., Barbados) or larger (e.g., Tahiti) than the eustatic sea-level change. Finally, we review procedures that have been applied to estimate continental ice volume from far-field sea-level observations and apply these procedures to data from Barbados and Bonaparte Gulf. Applying an ice-earth model that is tuned to fit the Barbados data, we estimate a change in grounded ice volume from the LGM to the present of 43.5-51x106 km3 based on Barbados data and an LGM ice volume estimate of 51x106 km3 based on Bonaparte Gulf data. Our results for the Bonaparte Gulf data are consistent with the recent study by Yokoyama et al. (Nature 406 (2000) 713). These LGM ice volume estimates map into a eustatic (or meltwater) sea-level rise of 115-135 m. Taking into account plausible variations in the adopted radial earth model introduces uncertainties in the range of +/-1.5x106 km3 for ice volume estimates based on the Barbados data.},
	author = {Milne, Glenn A. and Mitrovica, Jerry X. and Schrag, Daniel P.},
	date-added = {2008-02-21 11:48:14 -0500},
	date-modified = {2011-02-02 09:42:54 -0500},
	journal = {Quaternary Science Reviews},
	keywords = {sea-level, ice-sheets},
	local-url = {Papers/Milne2002a Estimating past continental ice volume.pdf},
	number = {1-3},
	pages = {361--376},
	title = {Estimating past continental ice volume from sea-level data},
	ty = {JOUR},
	volume = {21},
	year = {2002},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://www.sciencedirect.com/science/article/B6VBC-44B29S8-B/2/233ea1b87ab82ad361d0f4c8e9b39d7e}}

@article{Milne2005a,
	abstract = {Holocene data from the Caribbean and the Atlantic coast of South America have been critically assessed and a subset of the best quality data are presented. These data cover a large north-south geographic extent and display a distinct spatial variation. We make the first comparisons of this data set to predictions based on a realistic model of glaciation-induced sea-level change with the main aims of understanding the cause of the observed spatial trend and estimating a eustatic signal for the Holocene. The spatial variation is dominated by the influence of the ice and ocean mass redistribution on sea-level change, with the ice-induced effect dominating the observed north-south trend. A best-fitting model is applied to estimate a Holocene eustatic signal from the observations. We find that the model-corrected data are consistent with a relatively rapid rise of 7-8 mm/yr in the early Holocene with a marked reduction in this rate around 7 cal. kyr BP. From this time until present, the model-corrected data suggest that the volume of mass transfer between ice sheets and oceans was no more than (eustatic sea-level equivalent).},
	author = {Milne, Glenn A. and Long, Antony J. and Bassett, Sophie E.},
	date-added = {2008-02-21 11:48:14 -0500},
	date-modified = {2011-02-02 09:42:54 -0500},
	journal = {Quaternary Science Reviews},
	keywords = {sea-level, Holocene},
	local-url = {Papers/Milne2005a Modelling Holocene relative sea-level.pdf},
	number = {10-11},
	pages = {1183--1202},
	title = {Modelling Holocene relative sea-level observations from the Caribbean and South America},
	ty = {JOUR},
	volume = {24},
	year = {2005},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://www.sciencedirect.com/science/article/B6VBC-4FCRFCM-1/2/0809ddbb44c486d29752ee107e6a237a}}

