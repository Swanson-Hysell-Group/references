	pages = {95--104},
	title = {Macrostratigraphy and macroevolution in marine environments: testing the common-cause hypothesis},
	ty = {JOUR},
	volume = {358},
	year = {2011},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://sp.lyellcollection.org/content/358/1/95.abstract%20N2%20-%20Quantitative%20patterns%20in%20the%20sedimentary%20rock%20record%20predict%20many%20different%20macroevolutionary%20patterns%20in%20the%20fossil%20record,%20but%20the%20reasons%20for%20this%20predictability%20remain%20uncertain.%20There%20are%20two%20competing,%20but%20non-mutually%20exclusive,%20hypotheses:%20(1)%20similarities%20reflect%20a%20sampling%20bias%20imposed%20by%20variable%20and%20incomplete%20sampling%20of%20fossils,%20and%20(2)%20similarities%20reflect%20environmental%20perturbations%20that%20influence%20both%20the%20patterns%20of%20sedimentation%20and%20macroevolution%20(i.e.,%20common-cause).%20Macrostratigraphy,%20which%20is%20based%20on%20the%20quantitative%20analysis%20of%20hiatus-bound%20rock%20packages,%20permits%20variation%20in%20the%20rock%20record%20to%20be%20expressed%20in%20terms%20of%20rock%20quantity%20and,%20more%20importantly,%20spatiotemporal%20continuity.%20In%20combination%20with%20spatially-explicit%20fossil%20occurrence%20data%20in%20the%20Paleobiology%20Database,%20it%20is%20now%20possible%20to%20more%20rigorously%20test%20alternative%20hypotheses%20for%20similarities%20in%20the%20rock%20and%20fossil%20records%20and%20to%20start%20distinguishing%20between%20geologically-controlled%20sampling%20bias%20and%20the%20common-cause%20hypothesis.%20Here%20we%20summarize%20results%20from%20measuring%20the%20intersection%20of%20Macrostrat%20and%20the%20Paleobiology%20Database.%20Our%20results%20suggest%20that%20patterns%20in%20the%20fossil%20record%20are%20not%20dominated%20by%20large-scale%20stratigraphic%20biases.%20Instead,%20they%20suggest%20that%20linkages%20between%20multiple%20Earth%20systems%20are%20driving%20both%20spatiotemporal%20patterns%20of%20sedimentation%20and%20macroevolution.}}

@article{Summeren2012a,
	abstract = {Earth's subducting plates move 3\&{\#}8211;4 times faster than its overriding plates, but it remains unclear whether these contrasting plate speeds are caused by additional pull from subducting slabs or by increased viscous drag on the lithosphere-asthenosphere boundary beneath deeply-protruding continental roots. To investigate the relative importance of plausible controls, we predicted global patterns of plate motions using numerical models that incorporate the influence of subducting slabs, convective mantle flow, and continental roots. From the mantle convection models, we computed a set of dynamically consistent plate velocities by balancing forces that drive and resist the motion of each plate. When deep continental roots anchor to the sub-asthenospheric upper mantle, the calculated patterns of plate motions are close to the observations if only \&{\#}8764;20{\%} of (excess) upper mantle slab weight contributes to the slab pull force. However, this small contribution causes plates to move too slowly on average unless mantle viscosity is a factor of \&{\#}8764;2 lower than expected from post-glacial rebound. In contrast, we show that predicted and observed plate motions are more easily reconciled if even the deepest continental roots are underlain by a low-viscosity layer and at least half of (excess) upper mantle slab weight contributes to the slab pull force. This preferred scenario agrees with recent seismological evidence for a global asthenosphere and previously proposed mechanisms for partial decoupling of slabs from surface plates.},
	author = {van Summeren, Joost and Conrad, Clinton P. and Lithgow-Bertelloni, Carolina},
	date = {2012/02/01},
	date-added = {2012-01-31 22:59:45 +0000},
	date-modified = {2012-10-29 20:46:18 +0000},
	isbn = {1525-2027},
	journal = {Geochem. Geophys. Geosyst.},
	keywords = {asthenosphere; continental roots; lithosphere; mantle convection; plate motions; plate-slab coupling; 8103 Tectonophysics: Continental cratons; 8155 Tectonophysics: Plate motions: general (3040); 8159 Tectonophysics: Rheology: crust and lithosphere (8031)},
	month = {02},
	publisher = {AGU},
	sp = {Q0AK03},
	title = {The importance of slab pull and a global asthenosphere to plate motions},
	ty = {JOUR},
	volume = {13},
	year = {2012},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://dx.doi.org/10.1029/2011GC003873}}

