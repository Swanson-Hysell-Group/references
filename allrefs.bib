@article{Agarwal2015a,
	author = {Agarwal, Amar and Kontny, Agnes and Srivastava, Deepak C. and Greiling, Reinhard O.},
	date = {2015/06/10},
	date-added = {2015-08-11 16:19:27 +0000},
	date-modified = {2015-08-11 16:19:27 +0000},
	journal = {Geological Society of America Bulletin},
	m3 = {10.1130/B31172.1},
	month = {06},
	title = {Shock pressure estimates in target basalts of a pristine crater: A case study in the Lonar crater, India},
	ty = {JOUR},
	url = {http://gsabulletin.gsapubs.org/content/early/2015/06/10/B31172.1.abstract N2 - The study of shock pressure indicators can provide important clues for understanding the cratering process, though the estimation of shock pressures in weakly shocked rocks is commonly difficult. In this study, we selected a very young and well-preserved impact structure, the Lonar crater in India. The crater, devoid of any tectonic overprint, can be assumed as pristine. We used a combination of rock magnetic and microfracture studies to estimate shock pressure in the crater rim. On the basis of present results, the magnetic fabrics are interpreted to be of magmatic origin related to the Deccan basalt emplacement. The high-coercivity component of the natural remnant magnetization in the crater rim basalt is similar to that in the unshocked basalt. The lack of any shock-related magnetic overprint on the crater rim basalt is, therefore, evident in the Lonar crater.In contrast, radial and concentric microfractures observed in basalts at the crater rim and farther away show symmetric distribution with respect to the crater. The concentric microfractures consistently overprint the radial microfractures. We infer that the radial and concentric microfractures were developed during propagation of the early compressional and the late decompressional shock wave components, respectively. The results of our rock magnetic and microfracture studies, when interpreted in light of published experimental and numerical simulation studies on the Lonar basalt, reveal that the shock pressure in the Lonar crater rim was less than 0.5 GPa but greater than 0.2 GPa. This shock pressure was high enough to produce fractures but too low to affect the magnetic fabrics. These results give new information on the relationship between shock pressure and resulting microfractures.},
	year = {2015},
	bdsk-url-1 = {http://gsabulletin.gsapubs.org/content/early/2015/06/10/B31172.1.abstract%20N2%20-%20The%20study%20of%20shock%20pressure%20indicators%20can%20provide%20important%20clues%20for%20understanding%20the%20cratering%20process,%20though%20the%20estimation%20of%20shock%20pressures%20in%20weakly%20shocked%20rocks%20is%20commonly%20difficult.%20In%20this%20study,%20we%20selected%20a%20very%20young%20and%20well-preserved%20impact%20structure,%20the%20Lonar%20crater%20in%20India.%20The%20crater,%20devoid%20of%20any%20tectonic%20overprint,%20can%20be%20assumed%20as%20pristine.%20We%20used%20a%20combination%20of%20rock%20magnetic%20and%20microfracture%20studies%20to%20estimate%20shock%20pressure%20in%20the%20crater%20rim.%20On%20the%20basis%20of%20present%20results,%20the%20magnetic%20fabrics%20are%20interpreted%20to%20be%20of%20magmatic%20origin%20related%20to%20the%20Deccan%20basalt%20emplacement.%20The%20high-coercivity%20component%20of%20the%20natural%20remnant%20magnetization%20in%20the%20crater%20rim%20basalt%20is%20similar%20to%20that%20in%20the%20unshocked%20basalt.%20The%20lack%20of%20any%20shock-related%20magnetic%20overprint%20on%20the%20crater%20rim%20basalt%20is,%20therefore,%20evident%20in%20the%20Lonar%20crater.In%20contrast,%20radial%20and%20concentric%20microfractures%20observed%20in%20basalts%20at%20the%20crater%20rim%20and%20farther%20away%20show%20symmetric%20distribution%20with%20respect%20to%20the%20crater.%20The%20concentric%20microfractures%20consistently%20overprint%20the%20radial%20microfractures.%20We%20infer%20that%20the%20radial%20and%20concentric%20microfractures%20were%20developed%20during%20propagation%20of%20the%20early%20compressional%20and%20the%20late%20decompressional%20shock%20wave%20components,%20respectively.%20The%20results%20of%20our%20rock%20magnetic%20and%20microfracture%20studies,%20when%20interpreted%20in%20light%20of%20published%20experimental%20and%20numerical%20simulation%20studies%20on%20the%20Lonar%20basalt,%20reveal%20that%20the%20shock%20pressure%20in%20the%20Lonar%20crater%20rim%20was%20less%20than%200.5%20GPa%20but%20greater%20than%200.2%20GPa.%20This%20shock%20pressure%20was%20high%20enough%20to%20produce%20fractures%20but%20too%20low%20to%20affect%20the%20magnetic%20fabrics.%20These%20results%20give%20new%20information%20on%20the%20relationship%20between%20shock%20pressure%20and%20resulting%20microfractures.%20},
	bdsk-url-2 = {Provider:%20John%20Wiley%20&%20Sons,%20Ltd%0AContent:text/plain;%20charset=%22UTF-8%22%0A%0ATY%20%20-%20JOUR%0AAU%20%20-%20Tikoo,%20Sonia%20M.%0AAU%20%20-%20Gattacceca,%20J%C3%A9r%C3%B4me%0AAU%20%20-%20Swanson-Hysell,%20Nicholas%20L.%0AAU%20%20-%20Weiss,%20Benjamin%20P.%0AAU%20%20-%20Suavet,%20Cl%C3%A9ment%0AAU%20%20-%20Courn%C3%A8de,%20C%C3%A9cile%0AC8%20%20-%202015JE004840%0ATI%20%20-%20Preservation%20and%20detectability%20of%20shock-induced%20magnetization%0AJO%20%20-%20Journal%20of%20Geophysical%20Research:%20Planets%0AJA%20%20-%20J.%20Geophys.%20Res.%20Planets%0ASN%20%20-%202169-9100%0AUR%20%20-%20http://dx.doi.org/10.1002/2015JE004840%0ADO%20%20-%2010.1002/2015JE004840%0ASP%20%20-%20n/a%0AEP%20%20-%20n/a%0AKW%20%20-%20shock%20remanent%20magnetization%0AKW%20%20-%20shock%0AKW%20%20-%20impact%20cratering%0AKW%20%20-%20extraterrestrial%20magnetism%0AKW%20%20-%205440%20Magnetic%20fields%20and%20magnetism%0AKW%20%20-%205420%20Impact%20phenomena,%20cratering%0AKW%20%20-%206030%20Magnetic%20fields%20and%20magnetism%0AKW%20%20-%206240%20Meteorites%20and%20tektites%0APY%20%20-%202015%0AER%20%20-%20}}

