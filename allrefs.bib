	keywords = {3344 Meteorology and Atmospheric Dynamics: Paleoclimatology; 4267 Oceanography: General: Paleoceanography; 4255 Oceanography: General: Numerical modeling; 9619 Information Related to Geologic Time: Precambrian},
	number = {8},
	publisher = {AGU},
	sp = {L08201},
	title = {Global glaciation in the {N}eoproterozoic: Reconciling previous modelling results},
	ty = {JOUR},
