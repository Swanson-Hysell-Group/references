@article{Tarduno1995b,
	abstract = {Superparamagnetic grains, ultra\&{\#}8208;fine (d {$<$} 0.05µm) particles unable to retain a remanence at room temperature, have come under increased scrutiny as indicators of the diagenetic and authigenic history of sedimentary rocks. In marine sediments, fine\&{\#}8208;grained magnetite with large surface area to volume is thought to be preferentially removed during magnetic mineral reduction. On the basis of new magnetic hysteresis, low\&{\#}8208;temperature, and geochemical studies of pelagic sediments from the western equatorial Pacific Ocean, it is proposed that reduction processes increase rather than deplete the ultra\&{\#}8208;fine magnetic grain population. At the modern Fe\&{\#}8208;redox boundary enhanced superparamagnetism coincides with a coarsening of remanence\&{\#}8208;carrying grains. Superparamagnetism also tracks proposed temporal changes in magnetite reduction caused by climatically\&{\#}8208;driven fluctuations in organic carbon (C               org            ) supply. Together with hysteresis characteristics, changes in superparamagnetism may help the identification of paleointensity artifacts resulting from non steady\&{\#}8208;state magnetic mineral reduction.},
	author = {Tarduno, John A.},
	date-added = {2011-05-31 13:42:18 -0400},
