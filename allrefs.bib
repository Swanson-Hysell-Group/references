@article{PEtrElis2011a,
	abstract = {The discovery of the reversals of Earth's magnetic field and the description of plate tectonics are two of the main breakthroughs in geophysics in the 20th century. We claim that these two phenomena are correlated and that plate tectonics controls long-term changes in geomagnetic reversal frequency. More precisely, geological intervals characterized by an asymmetrical distribution of the continents with respect to the equator are followed by intervals of high reversal frequency. We speculate that the distribution and symmetry of mantle structures driving continental motions at the surface influence the equatorial symmetry of the flow within the core and thus change the coupling between the dipolar and quadrupolar modes which controls the occurrence of reversals.},
	author = {P{\`E}tr{\`E}lis, F. and Besse, J. and Valet, J. -P.},
	date = {2011/10/11},
	date-added = {2011-10-12 17:38:05 +0000},
	date-modified = {2012-10-29 20:46:19 +0000},
	isbn = {0094-8276},
	journal = {Geophys. Res. Lett.},
	keywords = {dynamo; geomagnetism; plate tectonics; reversals; 1507 Geomagnetism and Paleomagnetism: Core processes (1213, 8115); 1510 Geomagnetism and Paleomagnetism: Dynamo: theories and simulations; 1535 Geomagnetism and Paleomagnetism: Reversals: process, timescale, magnetostratigraphy; 8115 Tectonophysics: Core processes (1213, 1507); 8155 Tectonophysics: Plate motions: general (3040)},
	month = {10},
	number = {19},
	publisher = {AGU},
	sp = {L19303},
	title = {Plate tectonics may control geomagnetic reversal frequency},
	ty = {JOUR},
	volume = {38},
	year = {2011},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://dx.doi.org/10.1029/2011GL048784}}

@article{Beck1969a,
	abstract = {The Beaver Bay complex is a series of intrusions of gabbroic rocks related to the Middle Keweenawan Duluth gabbro complex. The Beaver Bay ferrogabbro, one of three units into which the complex has been divided, is an iron-rich gabbro with a very prominent igneous lamination. Magnetic anisotropy caused by preferential alignment of inequant magnetite grains within the lamination appears to have deflected the direction of remanent magnetization of the ferrogabbro by about 8.5∞. When samples from the ferrogabbro are eliminated, the resulting paleomagnetic pole for the Beaver Bay complex falls at 27.5∞N, 170.5∞W, where it forms part of a distinct cluster of paleomagnetic poles for Keweenawan igneous rock units of negative (normal) polarity. Positively magnetized Keweenawan igneous rocks, which appear to be older than the negatively magnetized units, give paleomagnetic pole positions that are scattered over a considerable area to the northeast of the cluster of negative poles. Magnetic intensities vary markedly throughout the complex, probably in response to the ordinary processes of magmatic differentiation.},
	author = {Beck, Myrl E. , Jr. and Lindsley, Nancy C.},
	date-added = {2011-10-09 20:26:52 +0000},
	date-modified = {2020-06-22 11:27:21 -0700},
	isbn = {0148-0227},
	journal = {J. Geophys. Res.},
	number = {8},
	pages = {2002--2013},
	publisher = {AGU},
	title = {{Paleomagnetism of the Beaver Bay Complex, Minnesota}},
	ty = {JOUR},
	volume = {74},
	year = {1969},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://dx.doi.org/10.1029/JB074i008p02002}}

