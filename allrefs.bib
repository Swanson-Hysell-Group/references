@article{Mahon2014a,
	annote = {10.1130/B30956.1},
	author = {Mahon, Robert C. and Dehler, Carol M. and Link, Paul K. and Karlstrom, Karl E. and Gehrels, George E.},
	date = {2014/05/01},
	date-added = {2014-05-02 23:32:37 +0000},
	date-modified = {2014-05-02 23:32:37 +0000},
	journal = {Geological Society of America Bulletin},
	journal1 = {Geological Society of America Bulletin},
	month = {05},
	number = {5-6},
	pages = {652--664},
	title = {Geochronologic and stratigraphic constraints on the Mesoproterozoic and Neoproterozoic Pahrump Group, Death Valley, California: A record of the assembly, stability, and breakup of Rodinia},
	ty = {JOUR},
	url = {http://gsabulletin.gsapubs.org/content/126/5-6/652.abstract N2 - The Pahrump Group in the Death Valley region of eastern California records a rich history of Mesoproterozoic to Neoproterozoic tectonic, climatic, and biotic events. These include the formation, stability, and onset of rifting of the Rodinia supercontinent, two potentially low-latitude glaciations correlative with global “snowball Earth” glacial intervals, and the onset of complex microbiota (e.g., testate amoebae). Poor direct age control, however, has significantly hindered the progress of understanding of these important stratigraphic units. New LA-ICPMS (laser ablation–inductively coupled plasma mass spectrometry) detrital zircon data from clastic units directly overlying a major unconformity within the Mesoproterozoic Crystal Spring Formation provide a maximum depositional age of 787 ± 11 Ma for the upper member of the Crystal Spring Formation. This unconformity, representing a duration of ≥300 Ma, is now recognized in sedimentary successions across southwestern Laurentia. These new age data, in addition to the distinct stratigraphic style above and below the unconformity, result in the proposed formal stratigraphic revision to elevate the upper member of the Crystal Spring Formation to the Neoproterozoic Horse Thief Springs Formation and separate it from the remainder of the underlying Mesoproterozoic Crystal Spring Formation (ca. 1100 Ma). New age relations and revised stratigraphic nomenclature significantly clarify stratigraphic and tectonic correlations and imply ca. 1250–1070 Ma assembly, 1070–780 Ma stability, and 780–600 Ma breakup of the supercontinent Rodinia along the southwestern Laurentian margin.},
	volume = {126},
	year = {2014},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://gsabulletin.gsapubs.org/content/126/5-6/652.abstract%20N2%20-%20The%20Pahrump%20Group%20in%20the%20Death%20Valley%20region%20of%20eastern%20California%20records%20a%20rich%20history%20of%20Mesoproterozoic%20to%20Neoproterozoic%20tectonic,%20climatic,%20and%20biotic%20events.%20These%20include%20the%20formation,%20stability,%20and%20onset%20of%20rifting%20of%20the%20Rodinia%20supercontinent,%20two%20potentially%20low-latitude%20glaciations%20correlative%20with%20global%20%E2%80%9Csnowball%20Earth%E2%80%9D%20glacial%20intervals,%20and%20the%20onset%20of%20complex%20microbiota%20(e.g.,%20testate%20amoebae).%20Poor%20direct%20age%20control,%20however,%20has%20significantly%20hindered%20the%20progress%20of%20understanding%20of%20these%20important%20stratigraphic%20units.%20New%20LA-ICPMS%20(laser%20ablation%E2%80%93inductively%20coupled%20plasma%20mass%20spectrometry)%20detrital%20zircon%20data%20from%20clastic%20units%20directly%20overlying%20a%20major%20unconformity%20within%20the%20Mesoproterozoic%20Crystal%20Spring%20Formation%20provide%20a%20maximum%20depositional%20age%20of%20787%20%C2%B1%2011%20Ma%20for%20the%20upper%20member%20of%20the%20Crystal%20Spring%20Formation.%20This%20unconformity,%20representing%20a%20duration%20of%20%E2%89%A5300%20Ma,%20is%20now%20recognized%20in%20sedimentary%20successions%20across%20southwestern%20Laurentia.%20These%20new%20age%20data,%20in%20addition%20to%20the%20distinct%20stratigraphic%20style%20above%20and%20below%20the%20unconformity,%20result%20in%20the%20proposed%20formal%20stratigraphic%20revision%20to%20elevate%20the%20upper%20member%20of%20the%20Crystal%20Spring%20Formation%20to%20the%20Neoproterozoic%20Horse%20Thief%20Springs%20Formation%20and%20separate%20it%20from%20the%20remainder%20of%20the%20underlying%20Mesoproterozoic%20Crystal%20Spring%20Formation%20(ca.%201100%20Ma).%20New%20age%20relations%20and%20revised%20stratigraphic%20nomenclature%20significantly%20clarify%20stratigraphic%20and%20tectonic%20correlations%20and%20imply%20ca.%201250%E2%80%931070%20Ma%20assembly,%201070%E2%80%93780%20Ma%20stability,%20and%20780%E2%80%93600%20Ma%20breakup%20of%20the%20supercontinent%20Rodinia%20along%20the%20southwestern%20Laurentian%20margin.}}

@article{Parnell2005a,
	annote = {10.1130/G21204.1},
	author = {Parnell, John and Osinski, Gordon R. and Lee, Pascal and Green, Paul F. and Baron, Martin J.},
	date-added = {2014-04-25 15:42:16 +0000},
	date-modified = {2014-04-25 15:42:16 +0000},
	journal = {Geology},
	journal1 = {Geology},
	number = {5},
	pages = {373--376},
	title = {Thermal alteration of organic matter in an impact crater and the duration of postimpact heating},
	ty = {JOUR},
	url = {http://geology.gsapubs.org/content/33/5/373.abstract N2 - The 24-km-diameter Tertiary Haughton impact structure formed in rocks that contained preexisting liquid hydrocarbons. Biomarker ratios in the hydrocarbons show a consistent pattern of variation in degree of heating across the structure. The heating reached a maximum at the crater center and is attributed to hydrothermal activity following impact. Kinetic modeling suggests a time scale of ∼5 k.y. for the heating, at a maximum temperature of 210 °C. The short time scale suggests that in moderate-sized craters, which are abundant on Mars, heating is not so extensive that fossil or extant organic matter would be obliterated.},
	volume = {33},
	year = {May, 2005},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://geology.gsapubs.org/content/33/5/373.abstract%20N2%20-%20The%2024-km-diameter%20Tertiary%20Haughton%20impact%20structure%20formed%20in%20rocks%20that%20contained%20preexisting%20liquid%20hydrocarbons.%20Biomarker%20ratios%20in%20the%20hydrocarbons%20show%20a%20consistent%20pattern%20of%20variation%20in%20degree%20of%20heating%20across%20the%20structure.%20The%20heating%20reached%20a%20maximum%20at%20the%20crater%20center%20and%20is%20attributed%20to%20hydrothermal%20activity%20following%20impact.%20Kinetic%20modeling%20suggests%20a%20time%20scale%20of%20%E2%88%BC5%20k.y.%20for%20the%20heating,%20at%20a%20maximum%20temperature%20of%20210%20%C2%B0C.%20The%20short%20time%20scale%20suggests%20that%20in%20moderate-sized%20craters,%20which%20are%20abundant%20on%20Mars,%20heating%20is%20not%20so%20extensive%20that%20fossil%20or%20extant%20organic%20matter%20would%20be%20obliterated.}}

@article{Muller2013a,
	annote = {10.1130/G34405.1},
	author = {M{\"u}ller, R. D. and Dutkiewicz, A. and Seton, M. and Gaina, C.},
	date = {2013/06/20},
	date-added = {2014-04-23 16:23:27 +0000},
	date-modified = {2014-04-23 16:23:27 +0000},
	journal = {Geology},
	journal1 = {Geology},
	month = {06},
	title = {Seawater chemistry driven by supercontinent assembly, breakup, and dispersal},
	ty = {JOUR},
	url = {http://geology.gsapubs.org/content/early/2013/06/20/G34405.1.abstract N2 - Global oceans are known to have alternated between aragonite and calcite seas. These oscillations reflect changes in the Mg/Ca ratios of seawater that control biomineralization and the composition of marine carbonates, and are thought to be caused mainly by the time dependence of crustal accretion at mid-ocean ridge crests and the associated high-temperature mid-ocean ridge fluid flux. Here we use global ocean basin reconstructions to demonstrate that the fluctuations in hydrothermal ocean inputs are instead caused by the gradual growth and destruction of mid-ocean ridges and their relatively cool flanks during long-term tectonic cycles, thus linking ocean chemistry to off-ridge low-temperature hydrothermal exchange. Early Jurassic aragonite seas were a consequence of supercontinent stability and a minimum in mid-ocean ridge length and global basalt alteration. The breakup of Pangea resulted in a gradual doubling in ridge length and a 50% increase in the ridge flank area, leading to an enhanced volume of basalt to be altered. The associated increase in the total global hydrothermal fluid flux by as much as 65%, peaking at 120 Ma, led to lowered seawater Mg/Ca ratios and marine hypercalcification from 140 to 35 Ma. A return to aragonite seas with preferential aragonite and high-Mg calcite precipitation was driven by pronounced continental dispersal, leading to progressive subduction of ridges and their flanks along the Pacific rim.},
	year = {2013},
	bdsk-file-1 = {},
	bdsk-file-2 = {},
	bdsk-file-3 = {}}

@article{Kidane2013a,
	annote = {10.1093/gji/ggt336},
	author = {Kidane, Tesfaye and Bachtadse, Valerian and Alene, Mulugeta and Kirscher, Uwe},
	date-added = {2014-04-16 19:57:18 +0000},
	date-modified = {2014-04-16 19:57:18 +0000},
	journal = {Geophysical Journal International},
	journal1 = {Geophysical Journal International},
	number = {3},
	pages = {1551--1565},
	title = {Palaeomagnetism of Palaeozoic glacial sediments of Northern Ethiopia: a contribution towards African Permian palaeogeography},
	ty = {JOUR},
	url = {http://gji.oxfordjournals.org/content/195/3/1551.abstract N2 - One hundred fourteen oriented palaeomagnetic core samples were collected from 13 palaeomagnetic sites on subhorizontal to tilted glacial sediments at five localities of Northern Ethiopia. Combined alternating field (AF) and stepwise thermal demagnetization techniques were successfully applied to resolve the complete directional spectrum. A viscous remagnetization (VRM) and one stable component of magnetization were identified in most of the specimens. The VRM is removed between a temperature range of 120–350 °C and AF of up to 30 mT. Further heating until ∼650 °C results in smooth decay of the natural remanent magnetization (NRM) intensity to about 50 per cent and the rest of the NRM is efficiently removed by heating to 690 °C, while only 30–50 per cent of NRM is removed by the maximum AF available suggesting haematite as remanence carrier. Results of the magnetization decay curve plots and rock magnetic analyses using the variable field translation balance indicated the presence of magnetite with minor goethite, pyrrhotite as well. The high stability component defining a straightline segment, starting 350 °C and/or 30 mT is mostly directed towards the origin and interpreted as the characteristic remanent magnetizations (ChRMs). The direction of magnetization is determined both by best-fitting line using the least-square technique of Kirschvink and remagnetization circles of Halls for few unresolved overlapping components. The site mean directions of the sediments from two sites are normal polarity and are close to present-day field directions at the sample site. The site mean directions from 11 sites, on the other hand, are reversed in polarity with better grouping in the tilt-corrected coordinate and pass the McFadden fold test. This overall site mean direction is Dec = 143.4º, Inc = 58.8º (N = 11, α95 = 9.7º) with a corresponding mean pole position of Lat = 26.0º, Lon = 249.5º (N = 11, A95 = 13.1º). This geomagnetic pole position is later rotated into West Africa coordinates to allow for extensional rifting in the Benue Trough about an Euler pole position, at 19.2ºN, 352.6ºE through an angle −6.3º (clockwise). The resulting pole position is located at ϕs = 246.6ºE, λs = 31.8ºS (N = 11, A95 = 13.1º), this pole with its 95 per cent confidence circle intersects the 270–310 Ma, segment of the APW path for West Africa consistent with ages of between late Carboniferous and early Permian. The result also implies that the Late Carboniferous Dwyka land ice sheet had probably extended more than 1000 km further north to Ethiopia than previously known.},
	volume = {195},
	year = {December, 2013},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://gji.oxfordjournals.org/content/195/3/1551.abstract%20N2%20-%20One%20hundred%20fourteen%20oriented%20palaeomagnetic%20core%20samples%20were%20collected%20from%2013%20palaeomagnetic%20sites%20on%20subhorizontal%20to%20tilted%20glacial%20sediments%20at%20five%20localities%20of%20Northern%20Ethiopia.%20Combined%20alternating%20field%20(AF)%20and%20stepwise%20thermal%20demagnetization%20techniques%20were%20successfully%20applied%20to%20resolve%20the%20complete%20directional%20spectrum.%20A%20viscous%20remagnetization%20(VRM)%20and%20one%20stable%20component%20of%20magnetization%20were%20identified%20in%20most%20of%20the%20specimens.%20The%20VRM%20is%20removed%20between%20a%20temperature%20range%20of%20120%E2%80%93350%20%C2%B0C%20and%20AF%20of%20up%20to%2030%20mT.%20Further%20heating%20until%20%E2%88%BC650%20%C2%B0C%20results%20in%20smooth%20decay%20of%20the%20natural%20remanent%20magnetization%20(NRM)%20intensity%20to%20about%2050%20per%20cent%20and%20the%20rest%20of%20the%20NRM%20is%20efficiently%20removed%20by%20heating%20to%20690%20%C2%B0C,%20while%20only%2030%E2%80%9350%20per%20cent%20of%20NRM%20is%20removed%20by%20the%20maximum%20AF%20available%20suggesting%20haematite%20as%20remanence%20carrier.%20Results%20of%20the%20magnetization%20decay%20curve%20plots%20and%20rock%20magnetic%20analyses%20using%20the%20variable%20field%20translation%20balance%20indicated%20the%20presence%20of%20magnetite%20with%20minor%20goethite,%20pyrrhotite%20as%20well.%20The%20high%20stability%20component%20defining%20a%20straightline%20segment,%20starting%20350%20%C2%B0C%20and/or%2030%20mT%20is%20mostly%20directed%20towards%20the%20origin%20and%20interpreted%20as%20the%20characteristic%20remanent%20magnetizations%20(ChRMs).%20The%20direction%20of%20magnetization%20is%20determined%20both%20by%20best-fitting%20line%20using%20the%20least-square%20technique%20of%20Kirschvink%20and%20remagnetization%20circles%20of%20Halls%20for%20few%20unresolved%20overlapping%20components.%20The%20site%20mean%20directions%20of%20the%20sediments%20from%20two%20sites%20are%20normal%20polarity%20and%20are%20close%20to%20present-day%20field%20directions%20at%20the%20sample%20site.%20The%20site%20mean%20directions%20from%2011%20sites,%20on%20the%20other%20hand,%20are%20reversed%20in%20polarity%20with%20better%20grouping%20in%20the%20tilt-corrected%20coordinate%20and%20pass%20the%20McFadden%20fold%20test.%20This%20overall%20site%20mean%20direction%20is%20Dec%20=%20143.4%C2%BA,%20Inc%20=%2058.8%C2%BA%20(N%20=%2011,%20%CE%B195%20=%209.7%C2%BA)%20with%20a%20corresponding%20mean%20pole%20position%20of%20Lat%20=%2026.0%C2%BA,%20Lon%20=%20249.5%C2%BA%20(N%20=%2011,%20A95%20=%2013.1%C2%BA).%20This%20geomagnetic%20pole%20position%20is%20later%20rotated%20into%20West%20Africa%20coordinates%20to%20allow%20for%20extensional%20rifting%20in%20the%20Benue%20Trough%20about%20an%20Euler%20pole%20position,%20at%2019.2%C2%BAN,%20352.6%C2%BAE%20through%20an%20angle%20%E2%88%926.3%C2%BA%20(clockwise).%20The%20resulting%20pole%20position%20is%20located%20at%20%CF%95s%20=%20246.6%C2%BAE,%20%CE%BBs%20=%2031.8%C2%BAS%20(N%20=%2011,%20A95%20=%2013.1%C2%BA),%20this%20pole%20with%20its%2095%20per%20cent%20confidence%20circle%20intersects%20the%20270%E2%80%93310%20Ma,%20segment%20of%20the%20APW%20path%20for%20West%20Africa%20consistent%20with%20ages%20of%20between%20late%20Carboniferous%20and%20early%20Permian.%20The%20result%20also%20implies%20that%20the%20Late%20Carboniferous%20Dwyka%20land%20ice%20sheet%20had%20probably%20extended%20more%20than%201000%20km%20further%20north%20to%20Ethiopia%20than%20previously%20known.}}

@article{Austermann2014a,
	author = {Austermann, Jacqueline and Kaye, Bryan T. and Mitrovica, Jerry X. and Huybers, Peter},
	date = {2014/04/01},
	date-added = {2014-04-16 19:53:24 +0000},
	date-modified = {2014-04-16 19:53:24 +0000},
	journal = {Geophysical Journal International},
	m3 = {10.1093/gji/ggt500},
	month = {04},
	number = {1},
	pages = {1--9},
	title = {A statistical analysis of the correlation between large igneous provinces and lower mantle seismic structure},
	ty = {JOUR},
	url = {http://gji.oxfordjournals.org/content/197/1/1.abstract N2 - Large igneous provinces (LIPs) lie approximately above the margins of the African and Pacific large low shear velocity provinces (LLSVPs) in the deep mantle. This spatial correlation has been used to argue that plumes are preferentially generated at the margins of LLSVPs. We perform a series of Monte Carlo–based statistical tests to assess the uniqueness of this conclusion. These tests indicate that (1) the reconstructed locations of LIPs are significantly correlated with both slower-than-average shear wave velocity regions, which contain LLSVPs, and the margins of these structures; and (2) these correlations cannot be statistically distinguished. That is, given current constraints, if plumes were generated randomly throughout regions of slower-than-average shear wave velocity in the deep mantle, then statistical tests are expected to show a significant correlation between the locations of LIPs and the margins of LLSVPs. We therefore conclude that it is premature to argue that the margins of LLSVPs represent preferred zones of plume generation. This conclusion is reinforced in our analysis by a demonstration that the expected mean distance of a set of points randomly placed in slower-than-average shear wave velocity regions is consistent with the observed mean distance between LIPs and the margins of LLSVPs. Finally, we also test the correlation between the reconstructed locations of LIPs and the horizontal gradient in deep mantle shear velocity perturbations. We find, given the uncertainty implied by different tomography models, that there is no statistically significant correlation and that being in a slow region (i.e. in the region of LLSVPs) is a stronger geographic requirement for plume generation than being at a specific (high) gradient.},
	volume = {197},
	year = {2014},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://gji.oxfordjournals.org/content/197/1/1.abstract%20N2%20-%20Large%20igneous%20provinces%20(LIPs)%20lie%20approximately%20above%20the%20margins%20of%20the%20African%20and%20Pacific%20large%20low%20shear%20velocity%20provinces%20(LLSVPs)%20in%20the%20deep%20mantle.%20This%20spatial%20correlation%20has%20been%20used%20to%20argue%20that%20plumes%20are%20preferentially%20generated%20at%20the%20margins%20of%20LLSVPs.%20We%20perform%20a%20series%20of%20Monte%20Carlo%E2%80%93based%20statistical%20tests%20to%20assess%20the%20uniqueness%20of%20this%20conclusion.%20These%20tests%20indicate%20that%20(1)%20the%20reconstructed%20locations%20of%20LIPs%20are%20significantly%20correlated%20with%20both%20slower-than-average%20shear%20wave%20velocity%20regions,%20which%20contain%20LLSVPs,%20and%20the%20margins%20of%20these%20structures;%20and%20(2)%20these%20correlations%20cannot%20be%20statistically%20distinguished.%20That%20is,%20given%20current%20constraints,%20if%20plumes%20were%20generated%20randomly%20throughout%20regions%20of%20slower-than-average%20shear%20wave%20velocity%20in%20the%20deep%20mantle,%20then%20statistical%20tests%20are%20expected%20to%20show%20a%20significant%20correlation%20between%20the%20locations%20of%20LIPs%20and%20the%20margins%20of%20LLSVPs.%20We%20therefore%20conclude%20that%20it%20is%20premature%20to%20argue%20that%20the%20margins%20of%20LLSVPs%20represent%20preferred%20zones%20of%20plume%20generation.%20This%20conclusion%20is%20reinforced%20in%20our%20analysis%20by%20a%20demonstration%20that%20the%20expected%20mean%20distance%20of%20a%20set%20of%20points%20randomly%20placed%20in%20slower-than-average%20shear%20wave%20velocity%20regions%20is%20consistent%20with%20the%20observed%20mean%20distance%20between%20LIPs%20and%20the%20margins%20of%20LLSVPs.%20Finally,%20we%20also%20test%20the%20correlation%20between%20the%20reconstructed%20locations%20of%20LIPs%20and%20the%20horizontal%20gradient%20in%20deep%20mantle%20shear%20velocity%20perturbations.%20We%20find,%20given%20the%20uncertainty%20implied%20by%20different%20tomography%20models,%20that%20there%20is%20no%20statistically%20significant%20correlation%20and%20that%20being%20in%20a%20slow%20region%20(i.e.%20in%20the%20region%20of%20LLSVPs)%20is%20a%20stronger%20geographic%20requirement%20for%20plume%20generation%20than%20being%20at%20a%20specific%20(high)%20gradient.}}

@article{Cawood2014a,
	annote = {10.1130/G35402.1},
	author = {Cawood, Peter A. and Hawkesworth, Chris J.},
	date = {2014/04/10},
	date-added = {2014-04-11 02:15:23 +0000},
	date-modified = {2014-04-11 02:15:23 +0000},
	journal = {Geology},
	journal1 = {Geology},
	month = {04},
	title = {Earth's middle age},
	ty = {JOUR},
	url = {http://geology.gsapubs.org/content/early/2014/04/08/G35402.1.abstract N2 - Earth's middle age, extending from 1.7 to 0.75 Ga, was characterized by environmental, evolutionary, and lithospheric stability that contrasts with the dramatic changes in preceding and succeeding eras. The period is marked by a paucity of preserved passive margins, an absence of a significant Sr anomaly in the paleoseawater record and in the εHf(t) in detrital zircon, a lack of orogenic gold and volcanic-hosted massive sulfide deposits, and an absence of glacial deposits and iron formations. In contrast, anorthosites and kindred bodies are well developed and major pulses of Mo and Cu mineralization, including the world's largest examples of these deposits, are features of this period. These trends are attributed to a relatively stable continental assemblage that was initiated during assembly of the Nuna supercontinent by ca. 1.7 Ga and continued until breakup of its closely related successor, Rodinia, ca. 0.75 Ga. The overall low abundance of passive margins is consistent with a stable continental configuration, which also provided a framework for environmental and evolutionary stability. A series of convergent margin accretionary orogens developed along the edge of the supercontinent. Abundant anorthosites and related rocks developed inboard of the plate margin. Their temporal distribution appears to link with the secular cooling of the mantle, at which time the overlying continental lithosphere was strong enough to be thickened and to support the emplacement of large plutons into the crust, yet the underlying mantle was still warm enough to result in widespread melting of the lower thickened crust.},
	year = {2014},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://geology.gsapubs.org/content/early/2014/04/08/G35402.1.abstract%20N2%20-%20Earth's%20middle%20age,%20extending%20from%201.7%20to%200.75%20Ga,%20was%20characterized%20by%20environmental,%20evolutionary,%20and%20lithospheric%20stability%20that%20contrasts%20with%20the%20dramatic%20changes%20in%20preceding%20and%20succeeding%20eras.%20The%20period%20is%20marked%20by%20a%20paucity%20of%20preserved%20passive%20margins,%20an%20absence%20of%20a%20significant%20Sr%20anomaly%20in%20the%20paleoseawater%20record%20and%20in%20the%20%CE%B5Hf(t)%20in%20detrital%20zircon,%20a%20lack%20of%20orogenic%20gold%20and%20volcanic-hosted%20massive%20sulfide%20deposits,%20and%20an%20absence%20of%20glacial%20deposits%20and%20iron%20formations.%20In%20contrast,%20anorthosites%20and%20kindred%20bodies%20are%20well%20developed%20and%20major%20pulses%20of%20Mo%20and%20Cu%20mineralization,%20including%20the%20world's%20largest%20examples%20of%20these%20deposits,%20are%20features%20of%20this%20period.%20These%20trends%20are%20attributed%20to%20a%20relatively%20stable%20continental%20assemblage%20that%20was%20initiated%20during%20assembly%20of%20the%20Nuna%20supercontinent%20by%20ca.%201.7%20Ga%20and%20continued%20until%20breakup%20of%20its%20closely%20related%20successor,%20Rodinia,%20ca.%200.75%20Ga.%20The%20overall%20low%20abundance%20of%20passive%20margins%20is%20consistent%20with%20a%20stable%20continental%20configuration,%20which%20also%20provided%20a%20framework%20for%20environmental%20and%20evolutionary%20stability.%20A%20series%20of%20convergent%20margin%20accretionary%20orogens%20developed%20along%20the%20edge%20of%20the%20supercontinent.%20Abundant%20anorthosites%20and%20related%20rocks%20developed%20inboard%20of%20the%20plate%20margin.%20Their%20temporal%20distribution%20appears%20to%20link%20with%20the%20secular%20cooling%20of%20the%20mantle,%20at%20which%20time%20the%20overlying%20continental%20lithosphere%20was%20strong%20enough%20to%20be%20thickened%20and%20to%20support%20the%20emplacement%20of%20large%20plutons%20into%20the%20crust,%20yet%20the%20underlying%20mantle%20was%20still%20warm%20enough%20to%20result%20in%20widespread%20melting%20of%20the%20lower%20thickened%20crust.}}

@article{Swanson-Hysell2014a,
	annote = {10.1130/G35271.1},
	author = {Swanson-Hysell, Nicholas L. and Burgess, Seth D. and Maloof, Adam C. and Bowring, Samuel A.},
	date-added = {2014-04-10 22:55:01 +0000},
	date-modified = {2015-04-06 03:41:07 +0000},
	doi = {10.1130/G35271.1},
	journal = {Geology},
	journal1 = {Geology},
	pages = {475-478},
	title = {Magmatic activity and plate motion during the latent stage of {M}idcontinent {R}ift development},
	ty = {JOUR},
	volume = {42},
	year = {2014},
	bdsk-file-1 = {},
	bdsk-file-2 = {},
	bdsk-url-1 = {http://geology.gsapubs.org/content/early/2014/04/08/G35271.1.abstract%20N2%20-%20%20The%20Keweenawan%20Midcontinent%20Rift%20of%20North%20America%20records%20significant%20continental%20rifting%20between%20ca.%201110%20and%201085%20Ma,%20and%20preserves%20the%20most%20detailed%20paleomagnetic%20record%20of%20plate%20motion%20of%20any%20continent%20in%20Precambrian%20time.%20U/Pb%20dates%20from%20extrusive%20and%20intrusive%20rocks%20of%20the%20western%20Lake%20Superior%20Basin%20suggest%20a%20latent%20stage%20of%20reduced%20magmatic%20activity%20from%20ca.%201106%20to%201100%20Ma%20that%20places%20constraints%20on%20the%20dynamics%20of%20rift%20development%20and%20the%20record%20of%20plate%20motion.%20However,%20it%20has%20remained%20unclear%20whether%20this%20stage%20is%20a%20feature%20of%20the%20entire%20%3E2500-km-long%20rift.%20The%20succession%20of%20picritic%20and%20basaltic%20lava%20flows%20at%20Mamainse%20Point%20in%20the%20eastern%20Lake%20Superior%20Basin%20may%20be%20the%20most%20continuous%20and%20best%20exposed%20record%20of%20rift-related%20volcanism%20and%20magnetic%20reversals,%20but%20its%20age%20and%20duration%20relative%20to%20the%20latent%20stage%20has%20been%20uncertain%20due%20to%20a%20lack%20of%20radioisotopic%20dates.%20We%20present%20a%20weighted%20mean%20206Pb/238U%20date%20of%201100.36%20%C2%B1%200.25%20Ma%20on%20zircon%20crystals%20isolated%20from%20a%20newly%20discovered%20tuff%20within%20the%20upper%20reversed%20polarity%20portion%20of%20the%20stratigraphy%20below%20the%20Great%20Conglomerate.%20This%20date%20indicates%20that%20eruptive%20activity%20at%20Mamainse%20Point%20continued%20during%20the%20interval%20of%20diminished%20magmatic%20activity%20in%20the%20western%20Lake%20Superior%20Basin.%20This%20result%20strengthens%20the%20chronostratigraphic%20framework%20of%20rift%20development%20while%20explaining%20the%20preservation%20of%20additional%20geomagnetic%20reversals%20at%20Mamainse%20Point%20and%20the%20record%20of%20progressively%20decreasing%20paleomagnetic%20inclination%20that%20is%20indicative%20of%20rapid%20paleogeographic%20change.}}

