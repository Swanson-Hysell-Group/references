@article{McKenzie2014a,
	author = {McKenzie, N. Ryan and Hughes, Nigel C. and Gill, Benjamin C. and Myrow, Paul M.},
	date = {2014/02/01},
	date-added = {2014-01-28 01:41:20 +0000},
	date-modified = {2014-01-28 01:41:20 +0000},
	journal = {Geology},
	m3 = {10.1130/G34962.1},
	month = {02},
	number = {2},
	pages = {127--130},
	title = {Plate tectonic influences on Neoproterozoic--early Paleozoic climate and animal evolution},
	ty = {JOUR},
	url = {http://geology.gsapubs.org/content/42/2/127.abstract N2 - The initial diversification of animals paralleled some of the most dramatic episodes of climate and environmental change in Earth history. We compiled global Neoproterozoic–early Paleozoic detrital zircon age data to track spatiotemporal variations in continental arc systems to explore the influence of tectonic outgassing of CO2 on these climatic shifts. These data indicate that global continental arc systems were spatially reduced at the onset of the Cryogenian glacial interval, widespread during the Cambrian greenhouse, and reduced during Ordovician cooling. The Cambrian greenhouse was coincident with ecologically stressed conditions, whereas Ordovician global cooling was accompanied by a major biodiversification event. Thus, variation in the continental arc CO2 flux likely played a critical role in major climatic fluctuations, which profoundly influenced early animal evolution.},
	volume = {42},
	year = {2014},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://geology.gsapubs.org/content/42/2/127.abstract%20N2%20-%20The%20initial%20diversification%20of%20animals%20paralleled%20some%20of%20the%20most%20dramatic%20episodes%20of%20climate%20and%20environmental%20change%20in%20Earth%20history.%20We%20compiled%20global%20Neoproterozoic%E2%80%93early%20Paleozoic%20detrital%20zircon%20age%20data%20to%20track%20spatiotemporal%20variations%20in%20continental%20arc%20systems%20to%20explore%20the%20influence%20of%20tectonic%20outgassing%20of%20CO2%20on%20these%20climatic%20shifts.%20These%20data%20indicate%20that%20global%20continental%20arc%20systems%20were%20spatially%20reduced%20at%20the%20onset%20of%20the%20Cryogenian%20glacial%20interval,%20widespread%20during%20the%20Cambrian%20greenhouse,%20and%20reduced%20during%20Ordovician%20cooling.%20The%20Cambrian%20greenhouse%20was%20coincident%20with%20ecologically%20stressed%20conditions,%20whereas%20Ordovician%20global%20cooling%20was%20accompanied%20by%20a%20major%20biodiversification%20event.%20Thus,%20variation%20in%20the%20continental%20arc%20CO2%20flux%20likely%20played%20a%20critical%20role%20in%20major%20climatic%20fluctuations,%20which%20profoundly%20influenced%20early%20animal%20evolution.}}

