@article{Valla2012a,
	abstract = {The late Neogene\&{\#}8211;Quaternary exhumation history of the European Alps is the subject of controversial findings and interpretations, with several thermochronological studies arguing for long-term steady state exhumation rates, while others have pointed to late Miocene\&{\#}8211;Pliocene exhumation pulses associated with tectonic and/or climatic changes. Here, we perform inverse thermal-kinematic modeling on dense thermochronological data sets combining apatite fission track (AFT) data from the literature and recently published apatite (U-Th-Sm)/He (AHe) data along the upper Rh{\`U}ne valley (Aar and Aiguilles Rouges massifs, Swiss Alps) in order to derive precise estimates on the denudation and relief history of this region. We then apply forward numerical modeling to interpret cooling paths quantified from apatite 4He/3He thermochronometry, in terms of denudation and relief-development scenarios. Our modeling results highlight the respective benefits of using AFT/AHe thermochronology data and 4He/3He thermochronometry for extracting quantitative denudation and relief information. Modeling results suggest a late Miocene exhumation pulse lasting until \&{\#}8764;8\&{\#}8211;10†Ma, consistent with recently proposed exhumation histories for other parts of the European Alps, followed by moderate (\&{\#}8764;0.3\&{\#}8211;0.5†km Myr\&{\#}8722;1) denudation rates during the late Miocene/Pliocene. Both inverse modeling and 4He/3He data reveal that the late stage exhumation of the studied massifs can be explained by a significant increase (\&{\#}8764;85\&{\#}8211;100{\%}) in local topographic relief through efficient glacial valley carving. Modeling results quantitatively constrain Rh{\`U}ne valley carving to 1\&{\#}8211;1.5†km since \&{\#}8764;1†Ma. We postulate that recent relief development within this part of the Swiss Alps is climatically driven by the onset of major Alpine glaciations at the mid-Pleistocene climate transition.},
	author = {Valla, Pierre G. and van der Beek, Peter A. and Shuster, David L. and Braun, Jean and Herman, Fr{\`E}d{\`E}ric and Tassan-Got, Laurent and Gautheron, C{\`E}cile},
	date = {2012/01/12},
	date-added = {2012-11-29 15:49:33 +0000},
	date-modified = {2012-11-29 15:50:03 +0000},
	doi = {10.1029/2011JF002043},
	isbn = {0148-0227},
	journal = {J. Geophys. Res.},
	keywords = {European Alps; inverse modeling; landscape evolution; thermochronology; 1140 Geochronology: Thermochronology; 4255 Oceanography: General: Numerical modeling (0545, 0560, 1952); 8175 Tectonophysics: Tectonics and landscape evolution; 8177 Tectonophysics: Tectonics and climatic interactions},
	month = {01},
	number = {F1},
	pages = {F01004},
	publisher = {AGU},
	title = {{Late Neogene exhumation and relief development of the Aar and Aiguilles Rouges massifs (Swiss Alps) from low-temperature thermochronology modeling and $^4$He/$^3$He thermochronometry}},
