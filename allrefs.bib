	bdsk-file-1 = {},
	bdsk-url-1 = {https://www.cambridge.org/core/article/evidence-for-metamorphic-remagnetisation-of-upper-precambrian-tillite-in-the-dalradian-supergroup-of-scotland/5B434BEE693F1B23FE1E39065007671E},
