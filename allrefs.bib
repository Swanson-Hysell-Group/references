@article{Reinhard2013a,
	author = {Reinhard, Christopher T. and Planavsky, Noah J. and Robbins, Leslie J. and Partin, Camille A. and Gill, Benjamin C. and Lalonde, Stefan V. and Bekker, Andrey and Konhauser, Kurt O. and Lyons, Timothy W.},
	date = {2013/04/02},
	date-added = {2013-04-02 18:57:30 +0000},
	date-modified = {2013-04-02 18:57:30 +0000},
	journal = {Proceedings of the National Academy of Sciences},
	m3 = {10.1073/pnas.1208622110},
	month = {04},
	number = {14},
	pages = {5357--5362},
	title = {Proterozoic ocean redox and biogeochemical stasis},
	ty = {JOUR},
	url = {http://www.pnas.org/content/110/14/5357.abstract N2 - The partial pressure of oxygen in Earth’s atmosphere has increased dramatically through time, and this increase is thought to have occurred in two rapid steps at both ends of the Proterozoic Eon (∼2.5–0.543 Ga). However, the trajectory and mechanisms of Earth’s oxygenation are still poorly constrained, and little is known regarding attendant changes in ocean ventilation and seafloor redox. We have a particularly poor understanding of ocean chemistry during the mid-Proterozoic (∼1.8–0.8 Ga). Given the coupling between redox-sensitive trace element cycles and planktonic productivity, various models for mid-Proterozoic ocean chemistry imply different effects on the biogeochemical cycling of major and trace nutrients, with potential ecological constraints on emerging eukaryotic life. Here, we exploit the differing redox behavior of molybdenum and chromium to provide constraints on seafloor redox evolution by coupling a large database of sedimentary metal enrichments to a mass balance model that includes spatially variant metal burial rates. We find that the metal enrichment record implies a Proterozoic deep ocean characterized by pervasive anoxia relative to the Phanerozoic (at least ∼30–40% of modern seafloor area) but a relatively small extent of euxinic (anoxic and sulfidic) seafloor (less than ∼1–10% of modern seafloor area). Our model suggests that the oceanic Mo reservoir is extremely sensitive to perturbations in the extent of sulfidic seafloor and that the record of Mo and chromium enrichments through time is consistent with the possibility of a Mo–N colimited marine biosphere during many periods of Earth’s history.},
	volume = {110},
	year = {2013},
	bdsk-file-1 = {}}

@article{Whalen2000a,
	author = {Whalen, Michael T. and Eberli, Gregor P. and Van Buchem, Frans S. P. and Mountjoy, Eric W. and Homewood, Peter W.},
	date = {2000/07/01},
	date-added = {2013-04-01 17:47:24 +0000},
	date-modified = {2013-04-01 17:47:24 +0000},
	journal = {Journal of Sedimentary Research},
	m3 = {10.1306/2DC40941-0E47-11D7-8643000102C1865D},
	month = {07},
	number = {4},
	pages = {913--936},
	title = {Bypass Margins, Basin-Restricted Wedges, and Platform-to-Basin Correlation, Upper Devonian, Canadian Rocky Mountains: Implications for Sequence Stratigraphy of Carbonate Platform Systems},
	ty = {JOUR},
	url = {http://jsedres.sepmonline.org/content/70/4/913.abstract N2 - Carbonate platforms can commonly keep up with relative sea-level rise because of high rates of sediment accumulation and platform aggradation. Surrounding basinal environments are commonly starved but can receive variable extrabasinal siliciclastic input and episodically deposited carbonate sediment. If accumulation rates in basinal settings lag behind those of the platform, a bypass or erosional margin can develop. Under these circumstances platform and basin depositional sequences become physically detached and direct correlation of basinal and platform sequences is hindered.We report here the results of high-resolution stratigraphic analyses of two Upper Devonian isolated carbonate platforms in western Alberta that provide insight into the sequence stratigraphy of bypass margins and criteria for accurate correlation of platform and basinal sequences. The slope and basin sequences surrounding the Miette and Ancient Wall platforms consist of basin-restricted, onlapping wedges of fine-grained background sediment deposited dominantly from suspension and coarse-grained platform-derived sediment redeposited by a variety of gravity-flow mechanisms. Sequence boundaries are identified within the redeposited carbonate intervals. Identification of sequence boundaries and differentiation of highstand and lowstand slope and basinal facies was based on the geometry, mineralogy, and clast content of redeposited carbonate units. Highstand carbonates contain sheet-like debris flows and turbidites with abundant slope-derived clasts and background facies with high total carbonate content. Lowstand carbonates contain sheet-like and channelized debris flows and turbidites with abundant platform-derived clasts and background facies with low carbonate content and locally high amounts of organic carbon. Transgressive facies are dominated by initially carbonate-poor and organic-rich background sediments that display a progressive increase in carbonate content and decrease in organic carbon content. These patterns are interpreted to record abundant background carbonate sedimentation during late transgression and highstand when the carbonate factory was robust. Highstand redeposited carbonates record slope erosion due to oversteepening and slope readjustment processes. Lowstand redeposited carbonates indicate platform and platform-margin erosion and low background carbonate sedimentation when the platform was either exposed or under very shallow peritidal conditions. High siliciclastic and organic contents during lowstand and early transgression may partly be the result of reciprocal sedimentation but alternatively may represent continuous siliciclastic supply during times with little dilution by fine-grained carbonate sediment.Successive stages of platform development at Miette and Ancient Wall were controlled by accommodation changes driven by relative sea-level fluctuations. Backstripping analyses of strata from both platforms confirm that significant differential subsidence was a major control on variations in platform thickness and patterns of slope development. Greater subsidence at Ancient Wall fostered the development of a steeper bypass margin and different slope evolution compared to Miette. Slope oversteepening also initiated a process of slope readjustment that eventually reduced the platform-to-basin gradient and facilitated regressive platform progradation.In conventional siliciclastic sequence stratigraphy, basin-restricted wedges are interpreted as lowstand deposits on the basis of their geometry and position relative to an updip margin. Wedge-shaped basinal units along the Miette and Ancient Wall bypass margins contain both highstand and lowstand facies that straddle sequence boundaries. The results of this study provide objective criteria for differentiating systems tracts in carbonate slope and basin environments through mineralogic and compositional analyses providing more accurate correlation of detached platform and basin sequences. Interpretation of carbonate basin-restricted wedges as purely highstand or lowstand deposits may lead to erroneous conclusions regarding sequence stratigraphy, platform-to-basin correlation, and the volumetric partitioning of sediments deposited in different systems tracts.},
	volume = {70},
	year = {2000},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://jsedres.sepmonline.org/content/70/4/913.abstract%20N2%20-%20Carbonate%20platforms%20can%20commonly%20keep%20up%20with%20relative%20sea-level%20rise%20because%20of%20high%20rates%20of%20sediment%20accumulation%20and%20platform%20aggradation.%20Surrounding%20basinal%20environments%20are%20commonly%20starved%20but%20can%20receive%20variable%20extrabasinal%20siliciclastic%20input%20and%20episodically%20deposited%20carbonate%20sediment.%20If%20accumulation%20rates%20in%20basinal%20settings%20lag%20behind%20those%20of%20the%20platform,%20a%20bypass%20or%20erosional%20margin%20can%20develop.%20Under%20these%20circumstances%20platform%20and%20basin%20depositional%20sequences%20become%20physically%20detached%20and%20direct%20correlation%20of%20basinal%20and%20platform%20sequences%20is%20hindered.We%20report%20here%20the%20results%20of%20high-resolution%20stratigraphic%20analyses%20of%20two%20Upper%20Devonian%20isolated%20carbonate%20platforms%20in%20western%20Alberta%20that%20provide%20insight%20into%20the%20sequence%20stratigraphy%20of%20bypass%20margins%20and%20criteria%20for%20accurate%20correlation%20of%20platform%20and%20basinal%20sequences.%20The%20slope%20and%20basin%20sequences%20surrounding%20the%20Miette%20and%20Ancient%20Wall%20platforms%20consist%20of%20basin-restricted,%20onlapping%20wedges%20of%20fine-grained%20background%20sediment%20deposited%20dominantly%20from%20suspension%20and%20coarse-grained%20platform-derived%20sediment%20redeposited%20by%20a%20variety%20of%20gravity-flow%20mechanisms.%20Sequence%20boundaries%20are%20identified%20within%20the%20redeposited%20carbonate%20intervals.%20Identification%20of%20sequence%20boundaries%20and%20differentiation%20of%20highstand%20and%20lowstand%20slope%20and%20basinal%20facies%20was%20based%20on%20the%20geometry,%20mineralogy,%20and%20clast%20content%20of%20redeposited%20carbonate%20units.%20Highstand%20carbonates%20contain%20sheet-like%20debris%20flows%20and%20turbidites%20with%20abundant%20slope-derived%20clasts%20and%20background%20facies%20with%20high%20total%20carbonate%20content.%20Lowstand%20carbonates%20contain%20sheet-like%20and%20channelized%20debris%20flows%20and%20turbidites%20with%20abundant%20platform-derived%20clasts%20and%20background%20facies%20with%20low%20carbonate%20content%20and%20locally%20high%20amounts%20of%20organic%20carbon.%20Transgressive%20facies%20are%20dominated%20by%20initially%20carbonate-poor%20and%20organic-rich%20background%20sediments%20that%20display%20a%20progressive%20increase%20in%20carbonate%20content%20and%20decrease%20in%20organic%20carbon%20content.%20These%20patterns%20are%20interpreted%20to%20record%20abundant%20background%20carbonate%20sedimentation%20during%20late%20transgression%20and%20highstand%20when%20the%20carbonate%20factory%20was%20robust.%20Highstand%20redeposited%20carbonates%20record%20slope%20erosion%20due%20to%20oversteepening%20and%20slope%20readjustment%20processes.%20Lowstand%20redeposited%20carbonates%20indicate%20platform%20and%20platform-margin%20erosion%20and%20low%20background%20carbonate%20sedimentation%20when%20the%20platform%20was%20either%20exposed%20or%20under%20very%20shallow%20peritidal%20conditions.%20High%20siliciclastic%20and%20organic%20contents%20during%20lowstand%20and%20early%20transgression%20may%20partly%20be%20the%20result%20of%20reciprocal%20sedimentation%20but%20alternatively%20may%20represent%20continuous%20siliciclastic%20supply%20during%20times%20with%20little%20dilution%20by%20fine-grained%20carbonate%20sediment.Successive%20stages%20of%20platform%20development%20at%20Miette%20and%20Ancient%20Wall%20were%20controlled%20by%20accommodation%20changes%20driven%20by%20relative%20sea-level%20fluctuations.%20Backstripping%20analyses%20of%20strata%20from%20both%20platforms%20confirm%20that%20significant%20differential%20subsidence%20was%20a%20major%20control%20on%20variations%20in%20platform%20thickness%20and%20patterns%20of%20slope%20development.%20Greater%20subsidence%20at%20Ancient%20Wall%20fostered%20the%20development%20of%20a%20steeper%20bypass%20margin%20and%20different%20slope%20evolution%20compared%20to%20Miette.%20Slope%20oversteepening%20also%20initiated%20a%20process%20of%20slope%20readjustment%20that%20eventually%20reduced%20the%20platform-to-basin%20gradient%20and%20facilitated%20regressive%20platform%20progradation.In%20conventional%20siliciclastic%20sequence%20stratigraphy,%20basin-restricted%20wedges%20are%20interpreted%20as%20lowstand%20deposits%20on%20the%20basis%20of%20their%20geometry%20and%20position%20relative%20to%20an%20updip%20margin.%20Wedge-shaped%20basinal%20units%20along%20the%20Miette%20and%20Ancient%20Wall%20bypass%20margins%20contain%20both%20highstand%20and%20lowstand%20facies%20that%20straddle%20sequence%20boundaries.%20The%20results%20of%20this%20study%20provide%20objective%20criteria%20for%20differentiating%20systems%20tracts%20in%20carbonate%20slope%20and%20basin%20environments%20through%20mineralogic%20and%20compositional%20analyses%20providing%20more%20accurate%20correlation%20of%20detached%20platform%20and%20basin%20sequences.%20Interpretation%20of%20carbonate%20basin-restricted%20wedges%20as%20purely%20highstand%20or%20lowstand%20deposits%20may%20lead%20to%20erroneous%20conclusions%20regarding%20sequence%20stratigraphy,%20platform-to-basin%20correlation,%20and%20the%20volumetric%20partitioning%20of%20sediments%20deposited%20in%20different%20systems%20tracts.}}

