	volume = {314},
	year = {2014},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://www.ajsonline.org/content/314/4/878.abstract%20N2%20-%20Laurentia,%20the%20core%20of%20Paleo-%20to%20Mesoproterozoic%20supercontinent%20Nuna,%20has%20remained%20largely%20intact%20since%20assembly%202.0%20to%201.8%20billion%20years%20ago%20%5BGa%5D.%20For%20earlier%20times,%20previous%20paleomagnetic%20data%20on%20poorly%20dated%20Paleoproterozoic%20mafic%20intrusions%20yielded%20ambiguous%20estimates%20of%20the%20amount%20of%20separation%20between%20key%20cratons%20within%20Nuna%20such%20as%20the%20Slave%20and%20Superior.%20Recent%20developments%20in%20paleomagnetism%20and%20U-Pb%20baddeleyite%20geochronology,%20including%20new%20results%20reported%20herein,%20yield%20sufficiently%20precise%20data%20to%20generate%20partial%20apparent%20polar%20wander%20paths%20for%20both%20the%20Slave%20and%20Superior%20craton%20from%202.2%20to%202.0%20Ga.%20Our%20new%20apparent%20polar%20wander%20comparison%20confirms%20earlier%20speculations%20that%20processes%20similar%20to%20plate%20tectonics,%20with%20relative%20motion%20between%20the%20Slave%20and%20Superior%20cratons,%20were%20operative%20leading%20up%20to%20the%20final%20assembly%20of%20supercontinent%20Nuna.}}

