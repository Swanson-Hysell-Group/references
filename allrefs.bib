@article{Aleinikoff2013a,
	author = {Aleinikoff, John N. and Southworth, Scott and Merschat, Arthur J.},
	date = {2013/10/01},
	date-added = {2013-09-26 18:13:55 +0000},
	date-modified = {2021-11-04 23:01:16 -0700},
	journal = {Geology},
	m3 = {10.1130/G34779.1},
	month = {10},
	number = {10},
	pages = {1087--1090},
	title = {{Implications for late Grenvillian (Rigolet phase) construction of Rodinia using new U-Pb data from the Mars Hill terrane, Tennessee and North Carolina, United States}},
	ty = {JOUR},
	url = {http://geology.gsapubs.org/content/41/10/1087.abstract N2 - New data for zircon (external morphology, cathodoluminescence zoning, and sensitive high resolution ion microprobe [SHRIMP] U-Pb ages) from the Carvers Gap granulite gneiss of the Mars Hill terrane (Tennessee and North Carolina, United States) require reevaluation of interpretations of the age and origin of this rock. The new results indicate that the zircon is detrital and that the sedimentary protolith of this gneiss (and related Cloudland gneiss) was deposited no earlier than ca. 1.02 Ga and was metamorphosed at ca. 0.98 Ga. Tectonic models that included the gneiss as a piece of 1.8 Ga Amazonian crust (perhaps as part of the hypothetical Columbia supercontinent) are now untenable. The remarkably fast cycle of exhumation, erosion, deposition, and deep burial also is characteristic of other late Grenvillian (post-Ottawan) Mesoproterozoic paragneisses that occur throughout the Appalachians. These rocks provide new evidence for the duration of the formation of the Rodinia supercontinent lasting until at least 0.98 Ma.},
	volume = {41},
	year = {2013},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://geology.gsapubs.org/content/41/10/1087.abstract%20N2%20-%20New%20data%20for%20zircon%20(external%20morphology,%20cathodoluminescence%20zoning,%20and%20sensitive%20high%20resolution%20ion%20microprobe%20%5BSHRIMP%5D%20U-Pb%20ages)%20from%20the%20Carvers%20Gap%20granulite%20gneiss%20of%20the%20Mars%20Hill%20terrane%20(Tennessee%20and%20North%20Carolina,%20United%20States)%20require%20reevaluation%20of%20interpretations%20of%20the%20age%20and%20origin%20of%20this%20rock.%20The%20new%20results%20indicate%20that%20the%20zircon%20is%20detrital%20and%20that%20the%20sedimentary%20protolith%20of%20this%20gneiss%20(and%20related%20Cloudland%20gneiss)%20was%20deposited%20no%20earlier%20than%20ca.%201.02%20Ga%20and%20was%20metamorphosed%20at%20ca.%200.98%20Ga.%20Tectonic%20models%20that%20included%20the%20gneiss%20as%20a%20piece%20of%201.8%20Ga%20Amazonian%20crust%20(perhaps%20as%20part%20of%20the%20hypothetical%20Columbia%20supercontinent)%20are%20now%20untenable.%20The%20remarkably%20fast%20cycle%20of%20exhumation,%20erosion,%20deposition,%20and%20deep%20burial%20also%20is%20characteristic%20of%20other%20late%20Grenvillian%20(post-Ottawan)%20Mesoproterozoic%20paragneisses%20that%20occur%20throughout%20the%20Appalachians.%20These%20rocks%20provide%20new%20evidence%20for%20the%20duration%20of%20the%20formation%20of%20the%20Rodinia%20supercontinent%20lasting%20until%20at%20least%200.98%20Ma.}}

