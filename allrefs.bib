@article{Knott2008a,
	annote = {10.1130/2008.2439(01)},
	author = {Knott, Jeffrey R. and Machette, Michael N. and Klinger, Ralph E. and Sarna-Wojcicki, Andrei M. and Liddicoat, Joseph C. and Tinsley, John C. and David, Brian T. and Ebbs, Veva M.},
	date = {2008/01/01},
	date-added = {2015-03-23 06:41:09 +0000},
	date-modified = {2018-03-20 20:18:58 +0000},
	journal = {Geological Society of America Special Papers},
	journal1 = {Geological Society of America Special Papers},
	month = {01},
	pages = {1--26},
	title = {{Reconstructing late Pliocene to middle Pleistocene Death Valley lakes and river systems as a test of pupfish (Cyprinodontidae) dispersal hypotheses}},
	ty = {JOUR},
	volume = {439},
	year = {2008},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://specialpapers.gsapubs.org/content/439/1.abstract%20N2%20-%20During%20glacial%20(pluvial)%20climatic%20periods,%20Death%20Valley%20is%20hypothesized%20to%20have%20episodically%20been%20the%20terminus%20for%20the%20Amargosa,%20Owens,%20and%20Mojave%20Rivers.%20Geological%20and%20biological%20studies%20have%20tended%20to%20support%20this%20hypothesis%20and%20a%20hydrological%20link%20that%20included%20the%20Colorado%20River,%20allowing%20dispersal%20of%20pupfish%20throughout%20southeastern%20California%20and%20western%20Nevada.%20Recent%20mitochondrial%20deoxyribonucleic%20acid%20(mtDNA)%20studies%20show%20a%20common%20pupfish%20(Cyprinodontidae)%20ancestry%20in%20this%20region%20with%20divergence%20beginning%203%E2%80%932%20Ma.%20We%20present%20tephrochronologic%20and%20paleomagnetic%20data%20in%20the%20context%20of%20testing%20the%20paleohydrologic%20connections%20with%20respect%20to%20the%20common%20collection%20point%20of%20the%20Amargosa,%20Owens,%20and%20Mojave%20Rivers%20in%20Death%20Valley%20during%20successive%20time%20periods:%20(1)%20the%20late%20Pliocene%20to%20early%20Pleistocene%20(3%E2%80%932%20Ma),%20(2)%20early%20to%20middle%20Pleistocene%20(1.2%E2%80%930.5%20Ma),%20and%20(3)%20middle%20to%20late%20Pleistocene%20(%3C0.7%E2%80%930.03%20Ma;%20paleolakes%20Manly%20and%20Mojave).%20Using%20the%203.35%20Ma%20Zabriskie%20Wash%20tuff%20and%203.28%20Ma%20Nomlaki%20Tuff%20Member%20of%20the%20Tuscan%20and%20Tehama%20Formations,%20which%20are%20prominent%20marker%20beds%20in%20the%20region,%20we%20conclude%20that%20at%203%E2%80%932%20Ma,%20a%20narrow%20lake%20occupied%20the%20ancient%20Furnace%20Creek%20Basin%20and%20that%20Death%20Valley%20was%20not%20hydrologically%20connected%20with%20the%20Amargosa%20or%20Mojave%20Rivers.%20A%20paucity%20of%20data%20for%20Panamint%20Valley%20does%20not%20allow%20us%20to%20evaluate%20an%20Owens%20River%20connection%20to%20Death%20Valley%20ca.%203%E2%80%932%20Ma.%20Studies%20by%20others%20have%20shown%20that%20Death%20Valley%20was%20not%20hydrologically%20linked%20to%20the%20Amargosa,%20Owens,%20or%20Mojave%20Rivers%20from%201.2%20to%200.5%20Ma.%20We%20found%20no%20evidence%20that%20Lake%20Manly%20flooded%20back%20up%20the%20Mojave%20River%20to%20pluvial%20Lake%20Mojave%20between%200.18%20and%200.12%20Ma,%20although%20surface%20water%20flowed%20from%20the%20Amargosa%20and%20Owens%20Rivers%20to%20Death%20Valley%20at%20this%20time.%20There%20is%20also%20no%20evidence%20for%20a%20connection%20of%20the%20Owens,%20Amargosa,%20or%20Mojave%20Rivers%20to%20the%20Colorado%20River%20in%20the%20last%203%E2%80%932%20m.y.%20Therefore,%20the%20hypothesis%20that%20pupfish%20dispersed%20or%20were%20isolated%20in%20basins%20throughout%20southeastern%20California%20and%20western%20Nevada%20by%20such%20a%20connection%20is%20not%20supported.%20Beyond%20the%20biologically%20predicted%20time%20frame,%20however,%20sparse%20and%20disputed%20data%20suggest%20that%20a%20fluvial%20system%20connected%20Panamint%20(Owens%20River),%20Death,%20and%20Amargosa%20Valleys,%20which%20could%20account%20for%20the%20dispersal%20and%20isolation%20before%203%20Ma.}}

