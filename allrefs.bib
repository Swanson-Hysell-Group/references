	isbn = {0301-9268},
	journal = {Precambrian Research},
	month = {11},
	number = {1--2},
	pages = {43--57},
	title = {{Palaeomagnetism of the Koras group, Northern Cape province, South Africa}},
	ty = {JOUR},
