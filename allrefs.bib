	title = {{Relations between Monterey Formation deposition and middle Miocene global cooling: Naples Beach section, California}},
	volume = {21},
	year = {1993},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://geology.gsapubs.org/content/21/10/877.abstract%20N2%20-%20An%20oxygen%20and%20carbon%20isotopic%20stratigraphy%20has%20been%20established%20for%20the%20Miocene%20Monterey%20Formation%20(%E2%88%BC18%20to%208%20Ma)%20at%20Naples%20Beach,%20Santa%20Barbara%20County,%20California.%20Correlation%20to%20the%20deep-sea%20climatic%20record%20provides%20a%20test%20of%20the%20Monterey%20hypothesis,%20which%20suggests%20that%20organic-carbon-rich%20deposition%20in%20the%20Monterey%20Formation%20fostered%20middle%20Miocene%20global%20cooling%20through%20drawdown%20of%20atmospheric%20partial%20CO2.%20Oxygen%20isotopic%20correlation%20of%20the%20Naples%20Beach%20section%20to%20the%20deep-sea%20record%20suggests%20that%20increased%20organic-carbon-rich%20deposition%20coincided%20closely%20with%20deep-water%20cooling%20and%20major%20East%20Antarctic%20ice-sheet%20growth%20from%2014.5%20to%2014.1%20Ma%20and%20with%20a%20%CE%B413C%20maximum%20in%20deep-sea%20records.%20These%20results%20support%20a%20corollary%20of%20the%20Monterey%20hypothesis,%20that%20episodic%20organic-carbon-rich%20deposition%20within%20the%20Monterey%20Formation%20contributed%20to%20deep-sea%20%CE%B413C%20maxima%20and%20to%20synchronous%20global%20cooling.}}

