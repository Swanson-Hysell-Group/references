@article{Mankinen1982a,
	annote = {10.1130/0091-7613(1982)10<82:PSOSCA>2.0.CO;2},
	author = {Mankinen, Edward A. and Irwin, William P.},
	date = {1982/02/01},
	date-added = {2016-02-02 20:40:20 +0000},
	date-modified = {2016-02-02 20:40:20 +0000},
	journal = {Geology},
	journal1 = {Geology},
	month = {02},
	number = {2},
	pages = {82--87},
	title = {Paleomagnetic study of some Cretaceous and Tertiary sedimentary rocks of the Klamath Mountains province, California},
	ty = {JOUR},
	url = {http://geology.gsapubs.org/content/10/2/82.abstract N2 - Paleomagnetic investigation of Cretaceous outliers and Tertiary sedimentary strata of the Klamath Mountains province, and of onlapping Cretaceous strata, has shown the rocks to be largely remagnetized. Samples studied are from the Upper Jurassic to Upper Cretaceous Great Valley sequence, Upper Cretaceous Hornbrook Formation, Eocene Montgomery Creek Formation, and Oligocene(?) Weaverville Formation. Cretaceous samples that survived the remagnetization have a mean remanence direction that is very close to the expected direction of the Cretaceous magnetic field at the locality of the Klamath Mountains. Data from both primary and remagnetized samples suggest the possibility of 11.5° ± 15.8° of post-Cretaceous clockwise rotation of the Klamath Mountains province. None of the data from either the primary or remagnetized samples shows evidence of the large amounts (∼ 70°) of clockwise rotation that other workers have measured for the lower Tertiary of the Oregon Coast Range. Our data indicate that the Oregon Coast Range and Klamath Mountains province did not behave as a single rigid block during the early Tertiary. They also suggest that any post-Oligocene rotation of the Klamath Mountains province is less than the approximately 30° post-Oligocene rotation recently proposed for a combined Oregon Coast Range–Klamath Mountains–Cascade Range block.},
	volume = {10},
	year = {1982},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://geology.gsapubs.org/content/10/2/82.abstract%20N2%20-%20Paleomagnetic%20investigation%20of%20Cretaceous%20outliers%20and%20Tertiary%20sedimentary%20strata%20of%20the%20Klamath%20Mountains%20province,%20and%20of%20onlapping%20Cretaceous%20strata,%20has%20shown%20the%20rocks%20to%20be%20largely%20remagnetized.%20Samples%20studied%20are%20from%20the%20Upper%20Jurassic%20to%20Upper%20Cretaceous%20Great%20Valley%20sequence,%20Upper%20Cretaceous%20Hornbrook%20Formation,%20Eocene%20Montgomery%20Creek%20Formation,%20and%20Oligocene(?)%20Weaverville%20Formation.%20Cretaceous%20samples%20that%20survived%20the%20remagnetization%20have%20a%20mean%20remanence%20direction%20that%20is%20very%20close%20to%20the%20expected%20direction%20of%20the%20Cretaceous%20magnetic%20field%20at%20the%20locality%20of%20the%20Klamath%20Mountains.%20Data%20from%20both%20primary%20and%20remagnetized%20samples%20suggest%20the%20possibility%20of%2011.5%C2%B0%20%C2%B1%2015.8%C2%B0%20of%20post-Cretaceous%20clockwise%20rotation%20of%20the%20Klamath%20Mountains%20province.%20None%20of%20the%20data%20from%20either%20the%20primary%20or%20remagnetized%20samples%20shows%20evidence%20of%20the%20large%20amounts%20(%E2%88%BC%2070%C2%B0)%20of%20clockwise%20rotation%20that%20other%20workers%20have%20measured%20for%20the%20lower%20Tertiary%20of%20the%20Oregon%20Coast%20Range.%20Our%20data%20indicate%20that%20the%20Oregon%20Coast%20Range%20and%20Klamath%20Mountains%20province%20did%20not%20behave%20as%20a%20single%20rigid%20block%20during%20the%20early%20Tertiary.%20They%20also%20suggest%20that%20any%20post-Oligocene%20rotation%20of%20the%20Klamath%20Mountains%20province%20is%20less%20than%20the%20approximately%2030%C2%B0%20post-Oligocene%20rotation%20recently%20proposed%20for%20a%20combined%20Oregon%20Coast%20Range%E2%80%93Klamath%20Mountains%E2%80%93Cascade%20Range%20block.}}

