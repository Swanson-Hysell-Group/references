@article{Larson1982a,
	abstract = {Paleomagnetic studies of Moenkopi samples from several sites on the Colorado Plateau, including a complete 427-m section at Sinbad Valley, western Colorado, reveal the following: (1) the presence of both normal and reversed Triassic components in many of the same samples at many localities, (2) the close correlation of the magnetic polarity and intensity of magnetic remanence with the lithologic characteristics in the Sinbad Valley section, (3) a streaked pattern of the remanence directions in any one member in the Sinbad Valley section similar to that expected from polar wander, (4) a lack of progressive change from the base upward, and (5) the common intermediate remanence directions of weak intensity (suggesting the presence of two or more nearly balanced anti-parallel components) throughout the formation. The results of our investigation, combined with previously reported petrographic and paleomagnetic studies of the Moenkopi Formation, have led us to conclude that the principal remanence carried by the formation is chemical remanent magnetism (CRM) acquired diagenetically over a geologically long time interval. From the available data we have formulated the following model to explain how the CRM was acquired through natural processes acting intermittently at geologically reasonable rates. When initially deposited, the Moenkopi sediments consisted primarily of first-cycle detritus containing a few percent of iron-bearing accessory minerals such as biotite, hornblende, magnetite, and ilmenite. At some time after deposition, under favorable subsurface conditions, intrastratal alteration began, involving breakdown of iron-bearing silicate and oxide minerals, partial replacement of some iron-rich silicate grains by hematite, martitization of magnetite, growth of hematite pods and blebs in ilmenite and biotite, and precipitation of crystalline hematite in both primary and secondary voids. The authigenesis spanned at least two polarity events and probably continued over several tens of millions of years. Stratigraphic units with grossly similar lithologies underwent similar diagenetic alterations at rates and to extents that were different from other stratigraphic units having different lithologies. Because of variations in the rate and duration of alteration and variations in the length of normal versus reversed polarity events, any given lithologic unit tended to be dominated by one polarity. The model given above seems to be capable of explaining not only those magnetic and petrographic features found in the Moenkopi Formation but also those of most other red beds.},
	author = {Larson, E. E. and Walker, T. R. and Patterson, P. E. and Hoblitt, R. P. and Rosenbaum, J. G.},
	date-added = {2011-02-09 10:00:18 -0500},
	date-modified = {2011-03-14 20:51:35 -0400},
	do = {10.1029/JB087iB02p01081},
	isbn = {0148-0227},
	journal = {J. Geophys. Res.},
	number = {B2},
	pages = {1081--1106},
	publisher = {AGU},
	title = {PALEOMAGNETISM OF THE MOENKOPI FORMATION, COLORADO PLATEAU: BASIS FOR LONG-TERM MODEL OF ACQUISITION OF CHEMICAL REMANENT MAGNETISM IN RED BEDS},
	ty = {JOUR},
	volume = {87},
	year = {1982},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://dx.doi.org/10.1029/JB087iB02p01081}}

@article{Sheldon2003a,
	annote = {10.1130/B25223.1},
	author = {Sheldon, Nathan D.},
	date-added = {2011-02-09 08:57:25 -0500},
	date-modified = {2011-03-14 20:51:35 -0400},
	journal = {Geological Society of America Bulletin},
	journal1 = {Geological Society of America Bulletin},
	number = {11},
	pages = {1377--1387},
	title = {Pedogenesis and geochemical alteration of the Picture Gorge subgroup, Columbia River basalt, Oregon},
	ty = {JOUR},
	volume = {115},
	year = {November, 2003},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://gsabulletin.gsapubs.org/content/115/11/1377.abstract%20N2%20-%20%20Reddened,%20clay-rich%20horizons%20between%20basalt%20flows%20have%20historically%20been%20identified%20as%20%E2%80%9Cbaked%20zones%E2%80%9D%20or%20as%20zones%20of%20lateral%20groundwater%20movement.%20The%20reddening%20has%20been%20attributed%20to%20thermal%20or%20chemical%20alteration%20of%20the%20permeable%20portion%20of%20the%20basalt%20flow.%20Many%20of%20these%20red%20horizons%20are%20instead%20paleosols%20that%20record%20significant%20hiatuses%20in%20basalt%20flow%20emplacement.%20Paleosols%20were%20identified%20in%20the%20field%20on%20the%20basis%20of%20features%20such%20as%20horizonation,%20ped%20morphology,%20and%20root%20traces.%20Terrestrial%20gastropods,%20fossil%20plants,%20and%20peats%20also%20occur%20locally.Plots%20of%20weathering%20indices,%20such%20as%20base%20loss,%20are%20consistent%20with%20a%20pedogenic%20origin%20for%20these%20horizons.%20Ca,%20Na,%20Mg,%20Fe2+,%20and%20P%20have%20been%20extensively%20lost%20from%20the%20A%20and%20Bt%20horizons%20of%20the%20paleosols,%20consistent%20with%20modern%20weathering%20patterns.%20K%20and%20Rb%20have%20been%20added%20to%20the%20upper%20portions%20of%20the%20profiles%20and%20lost%20in%20the%20lower%20portions%20of%20the%20profiles%20relative%20to%20the%20parent%20material,%20with%20Rb%20added%20disproportionately.%20Historically,%20this%20pattern%20of%20enrichment%20has%20been%20cited%20as%20evidence%20of%20K%20metasomatism.%20The%20apparent%20metasomatism%20can%20be%20explained%20using%20a%20new%20model%20in%20which%20there%20was%20extensive%20felsic%20volcanism%20contemporaneous%20with%20pedogenesis,%20and%20K%20and%20Rb%20were%20likely%20added%20by%20windborne%20ash.%20The%20apparent%20discordance%20between%20K%20and%20Rb%20contents%20of%20the%20paleosols%20can%20be%20explained%20by%20the%20presence%20of%20land%20plants%20because%20K%20is%20an%20important%20electrolyte%20and%20Rb%20does%20not%20serve%20any%20major%20biological%20role.%20This%20model%20could%20account%20for%20apparent%20K%20metasomatism%20in%20other%20paleosols%20following%20the%20advent%20of%20land%20plants%20and%20may%20be%20applicable%20to%20older%20paleosols%20as%20well.},
	bdsk-url-2 = {http://gsabulletin.gsapubs.org/content/115/11/1377.abstract%20N2%20-%20Reddened,%20clay-rich%20horizons%20between%20basalt%20flows%20have%20historically%20been%20identified%20as%20%E2%80%9Cbaked%20zones%E2%80%9D%20or%20as%20zones%20of%20lateral%20groundwater%20movement.%20The%20reddening%20has%20been%20attributed%20to%20thermal%20or%20chemical%20alteration%20of%20the%20permeable%20portion%20of%20the%20basalt%20flow.%20Many%20of%20these%20red%20horizons%20are%20instead%20paleosols%20that%20record%20significant%20hiatuses%20in%20basalt%20flow%20emplacement.%20Paleosols%20were%20identified%20in%20the%20field%20on%20the%20basis%20of%20features%20such%20as%20horizonation,%20ped%20morphology,%20and%20root%20traces.%20Terrestrial%20gastropods,%20fossil%20plants,%20and%20peats%20also%20occur%20locally.Plots%20of%20weathering%20indices,%20such%20as%20base%20loss,%20are%20consistent%20with%20a%20pedogenic%20origin%20for%20these%20horizons.%20Ca,%20Na,%20Mg,%20Fe2+,%20and%20P%20have%20been%20extensively%20lost%20from%20the%20A%20and%20Bt%20horizons%20of%20the%20paleosols,%20consistent%20with%20modern%20weathering%20patterns.%20K%20and%20Rb%20have%20been%20added%20to%20the%20upper%20portions%20of%20the%20profiles%20and%20lost%20in%20the%20lower%20portions%20of%20the%20profiles%20relative%20to%20the%20parent%20material,%20with%20Rb%20added%20disproportionately.%20Historically,%20this%20pattern%20of%20enrichment%20has%20been%20cited%20as%20evidence%20of%20K%20metasomatism.%20The%20apparent%20metasomatism%20can%20be%20explained%20using%20a%20new%20model%20in%20which%20there%20was%20extensive%20felsic%20volcanism%20contemporaneous%20with%20pedogenesis,%20and%20K%20and%20Rb%20were%20likely%20added%20by%20windborne%20ash.%20The%20apparent%20discordance%20between%20K%20and%20Rb%20contents%20of%20the%20paleosols%20can%20be%20explained%20by%20the%20presence%20of%20land%20plants%20because%20K%20is%20an%20important%20electrolyte%20and%20Rb%20does%20not%20serve%20any%20major%20biological%20role.%20This%20model%20could%20account%20for%20apparent%20K%20metasomatism%20in%20other%20paleosols%20following%20the%20advent%20of%20land%20plants%20and%20may%20be%20applicable%20to%20older%20paleosols%20as%20well.}}

