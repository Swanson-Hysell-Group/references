@article{Pancost1999a,
	annote = {10.1130/0091-7613(1999)027<1015:OMSVAT>2.3.CO;2},
	author = {Pancost, Richard D. and Freeman, Katherine H. and Patzkowsky, Mark E.},
	date-added = {2011-06-02 18:03:34 -0400},
	date-modified = {2012-10-29 20:46:19 +0000},
	journal = {Geology},
	journal1 = {Geology},
	number = {11},
	pages = {1015--1018},
	title = {Organic-matter source variation and the expression of a late Middle Ordovician carbon isotope excursion},
	ty = {JOUR},
	volume = {27},
	year = {November, 1999},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://geology.gsapubs.org/content/27/11/1015.abstract%20N2%20-%20The%20carbon%20isotopic%20composition%20of%20organic%20matter%20is%20a%20powerful%20tool%20in%20the%20study%20of%20organic%20carbon%20burial%20and%20pCO2%20through%20the%20geologic%20record.%20However,%20the%20organic-matter%20source%20can%20affect%20total%20organic%20carbon%20%CE%B413C%20values%20and%20may%20complicate%20interpretation%20of%20environmental%20conditions.%20We%20examined%20the%20influence%20of%20organic-matter%20source%20variations%20on%20a%20late%20Middle%20Ordovician%20positive%20%CE%B413C%20excursion%20in%20strata%20of%20the%20United%20States%20midcontinent.%20In%20a%20core%20from%20Iowa,%20the%20magnitude%20of%20the%20excursion%20recorded%20by%20carbonate%20carbon%20is%20%E2%88%BC2.5%E2%80%B0,%20whereas%20the%20excursion%20recorded%20by%20total%20organic%20carbon%20is%20nearly%208%E2%80%B0.%20Although%20this%20difference%20could%20arise%20from%20a%20profound%20decrease%20in%20surface-water%20CO2%20concentrations,%20association%20of%20the%20organic-walled%20microfossil%20Gloeocapsomorpha%20prisca%20with%2013C-enriched%20total%20organic%20carbon%20(TOC)%20in%20this%20interval%20suggests%20that%20the%20excursion%20could%20also%20record%20a%20shift%20from%20normal-marine%20to%20G.%20prisca%E2%80%93dominated%20organic%20matter.%20Carbon%20isotope%20analyses%20of%20individual%20biomarkers%20indicate%20that%20both%20of%20these%20explanations%20are%20required%20to%20explain%20the%20data.%20Compounds%20inferred%20to%20be%20of%20G.%20prisca%20origin%20are%20enriched%20in%2013C%20by%207%E2%80%B0%20relative%20to%20compounds%20derived%20from%20other%20algal%20sources.%20Furthermore,%20compounds%20exclusively%20from%20either%20G.%20prisca%20or%20other%20sources%20exhibit%20a%20positive%20shift%20of%20only%203.5%E2%80%B0.%20Thus,%20the%20large%20excursion%20recorded%20by%20TOC%20reflects,%20in%20part,%20a%20change%20in%20the%20proportional%20contribution%20of%20G.%20prisca%20to%20TOC.%20That%20all%20compounds%20exhibit%20a%20positive%20carbon%20isotopic%20shift%20indicates%20that,%20independent%20of%20contributions%20from%20G.%20prisca,%20a%20positive%20organic%20%CE%B413C%20excursion%20occurred%20and%20records%20a%20change%20in%20environmental%20conditions%20such%20as%20CO2(aq)%20concentrations.%20The%203.5%E2%80%B0%20shift%20is%20similar%20in%20magnitude%20to%20that%20observed%20for%20TOC%20in%20correlative%20units%20from%20Pennsylvania,%20suggesting%20that%20this%20event%20has%20broad%20geographic%20significance.%20This%20work%20illustrates%20that%20organic-matter%20source%20variations%20as%20well%20as%20environmental%20conditions%20govern%20the%20TOC%20%CE%B413C%20values%20and%20shows%20how%20compound-specific%20isotope%20analyses%20can%20resolve%20these%20multiple%20controls.}}

