	doi = {10.1360/03wd0112},
	issn = {1861-9541},
	journal = {Chinese Science Bulletin},
	number = {16},
	pages = {1657--1662},
	title = {Lower boundary age of the Nanhua System and the Gucheng glacial stage: Evidence from SHRIMP II dating},
	url = {http://dx.doi.org/10.1360/03wd0112},
	volume = {48},
	year = {2003},
