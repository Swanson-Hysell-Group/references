	title = {Biologically induced initiation of {N}eoproterozoic snowball-Earth events},
	ty = {JOUR},
	volume = {108},
	year = {2011},
	bdsk-file-1 = {},
	bdsk-file-2 = {},
	bdsk-url-1 = {http://www.pnas.org/content/108/37/15091.abstract%20N2%20-%20The%20glaciations%20of%20the%20Neoproterozoic%20Era%20(1,000%20to%20542%20MyBP)%20were%20preceded%20by%20dramatically%20light%20C%20isotopic%20excursions%20preserved%20in%20preglacial%20deposits.%20Standard%20explanations%20of%20these%20excursions%20involve%20remineralization%20of%20isotopically%20light%20organic%20matter%20and%20imply%20strong%20enhancement%20of%20atmospheric%20CO2%20greenhouse%20gas%20concentration,%20apparently%20inconsistent%20with%20the%20glaciations%20that%20followed.%20We%20examine%20a%20scenario%20in%20which%20the%20isotopic%20signal,%20as%20well%20as%20the%20global%20glaciation,%20result%20from%20enhanced%20export%20of%20organic%20matter%20from%20the%20upper%20ocean%20into%20anoxic%20subsurface%20waters%20and%20sediments.%20The%20organic%20matter%20undergoes%20anoxic%20remineralization%20at%20depth%20via%20either%20sulfate-%20or%20iron-reducing%20bacteria.%20In%20both%20cases,%20this%20can%20lead%20to%20changes%20in%20carbonate%20alkalinity%20and%20dissolved%20inorganic%20pool%20that%20efficiently%20lower%20the%20atmospheric%20CO2%20concentration,%20possibly%20plunging%20Earth%20into%20an%20ice%20age.%20This%20scenario%20predicts%20enhanced%20deposition%20of%20calcium%20carbonate,%20the%20formation%20of%20siderite,%20and%20an%20increase%20in%20ocean%20pH,%20all%20of%20which%20are%20consistent%20with%20recent%20observations.%20Late%20Neoproterozoic%20diversification%20of%20marine%20eukaryotes%20may%20have%20facilitated%20the%20episodic%20enhancement%20of%20export%20of%20organic%20matter%20from%20the%20upper%20ocean,%20by%20causing%20a%20greater%20proportion%20of%20organic%20matter%20to%20be%20partitioned%20as%20particulate%20aggregates%20that%20can%20sink%20more%20efficiently,%20via%20increased%20cell%20size,%20biomineralization%20or%20increased%20C%E2%88%B6N%20of%20eukaryotic%20phytoplankton.%20The%20scenario%20explains%20isotopic%20excursions%20that%20are%20correlated%20or%20uncorrelated%20with%20snowball%20initiation,%20and%20suggests%20that%20increasing%20atmospheric%20oxygen%20concentrations%20and%20a%20progressive%20oxygenation%20of%20the%20subsurface%20ocean%20helped%20to%20prevent%20snowball%20glaciation%20on%20the%20Phanerozoic%20Earth.}}

