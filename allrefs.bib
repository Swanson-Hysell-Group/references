	journal = {Geology},
	journal1 = {Geology},
	month = {2},
	number = {2},
	pages = {120--123},
	title = {Episodic accumulation and the origin of formation boundaries in the Helderberg Group of New York State},
	ty = {JOUR},
	volume = {12},
	year = {1984},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://geology.gsapubs.org/cgi/content/abstract/12/2/120}}

@article{Straeten2004a,
	annote = {10.1130/B25244.1},
	author = {Straeten, Charles A. Ver},
	date = {March/April, 2004},
	date-added = {2011-04-08 18:46:43 -0400},
	date-modified = {2012-10-29 20:46:19 +0000},
	journal = {Geological Society of America Bulletin},
	journal1 = {Geological Society of America Bulletin},
	number = {3-4},
	pages = {474--489},
	title = {K-bentonites, volcanic ash preservation, and implications for Early to Middle Devonian volcanism in the Acadian orogen, eastern North America},
	ty = {JOUR},
	volume = {116},
	year = {2004},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://gsabulletin.gsapubs.org/content/116/3-4/474.abstract%20N2%20-%20%20Lower%20to%20Middle%20Devonian%20marine%20strata%20in%20the%20Appalachian%20foreland%20basin%20feature%20up%20to%2080%20or%20more%20thin%20K-bentonites%20that%20represent%20ancient%20volcanic%20ashes.%20The%20time%20vs.%20space%20distribution%20of%20K-bentonites%20through%20the%20Lochkovian%20to%20Eifelian%20Stages%20(representing%20%E2%88%BC30%20m.y.)%20shows%20a%20distinct%20pattern%20of%20clustered%20multiple%20beds,%20several%20scattered%20beds,%20and%20thick%20intervals%20with%20no%20K-bentonites.%20Four%20clusters%20of%207%20to%2015%20individual,%20closely%20spaced%20layers%20occur%20in%20the%20middle%20Lochkovian%20(Bald%20Hill%20K-bentonites,%20Kalkberg%E2%80%93New%20Scotland%20Formations),%20late%20Pragian%20or%20early%20Emsian%20(Sprout%20Brook%20K-bentonites,%20Esopus%20Formation)%20and%20early%20Eifelian%20(two%20clusters,%20the%20Tioga%20middle%20coarse%20zone%20and%20Tioga%20A%E2%80%93G%20K-bentonites,%20Onondaga%20Formation).Detailed%20examination%20of%20these%20Devonian%20K-bentonites%20shows%20that%20in%20many%20cases%20they%20do%20not%20represent%20a%20single%20eruption.%20Multilayered%20beds,%20fossil%20layers%20within%20beds,%20authigenic%20minerals%20(e.g.,%20glauconite%20and%20phosphate%20nodules),%20subjacent%20hardgrounds,%20and%20an%20irregular%20distribution%20of%20beds%20through%20space%20and%20time%20raise%20questions%20about%20the%20depositional%20history%20and%20preservation%20potential%20of%20volcanic%20ash%20in%20marine%20environments%20and%20the%20degree%20to%20which%20the%20beds%20represent%20a%20primary%20record%20of%20volcanism.%20These%20and%20other%20lines%20of%20evidence%20indicate%20that%20postdepositional%20physical,%20biological,%20and%20geochemical%20processes%20(e.g.,%20sedimentation%20rate,%20event,%20and%20background%20physical%20processes,%20burrowing)%20have%20modified%20the%20primary%20record%20of%20these%20water-laid%20ash-fall%20events.%20These%20factors%20may%20lead%20to%20preservation%20of%20primary%20ash%20deposits%20or%20to%20their%20resedimentation%20and/or%20partial%20to%20complete%20mixing%20with%20background%20sediments.The%20preservation%20potential,%20and%20resulting%20distribution,%20of%20the%20Devonian%20K-bentonites%20can%20be%20analyzed%20across%20a%20spectrum%20of%20preservational%20magnafacies.%20In%20this%20paper%20I%20present%20a%20model%20of%20ash%20preservation;%20the%20model%20incorporates%20environmentally%20related%20physical,%20biological,%20and%20chemical%20processes%20active%20in%20epicontinental%20seas%20and%20marine%20foreland%20basins.%20Conclusions%20based%20on%20the%20model%20indicate%20that%20the%20middle%20Lochkovian,%20early%20Emsian,%20and%20early%20Eifelian%20were%20times%20of%20peak%20volcanic%20activity%20in%20eastern%20North%20America,%20related%20to%20times%20of%20increased%20tectonism%20in%20the%20Acadian%20orogen.},
	bdsk-url-2 = {http://gsabulletin.gsapubs.org/content/116/3-4/474.abstract%20N2%20-%20Lower%20to%20Middle%20Devonian%20marine%20strata%20in%20the%20Appalachian%20foreland%20basin%20feature%20up%20to%2080%20or%20more%20thin%20K-bentonites%20that%20represent%20ancient%20volcanic%20ashes.%20The%20time%20vs.%20space%20distribution%20of%20K-bentonites%20through%20the%20Lochkovian%20to%20Eifelian%20Stages%20(representing%20%E2%88%BC30%20m.y.)%20shows%20a%20distinct%20pattern%20of%20clustered%20multiple%20beds,%20several%20scattered%20beds,%20and%20thick%20intervals%20with%20no%20K-bentonites.%20Four%20clusters%20of%207%20to%2015%20individual,%20closely%20spaced%20layers%20occur%20in%20the%20middle%20Lochkovian%20(Bald%20Hill%20K-bentonites,%20Kalkberg%E2%80%93New%20Scotland%20Formations),%20late%20Pragian%20or%20early%20Emsian%20(Sprout%20Brook%20K-bentonites,%20Esopus%20Formation)%20and%20early%20Eifelian%20(two%20clusters,%20the%20Tioga%20middle%20coarse%20zone%20and%20Tioga%20A%E2%80%93G%20K-bentonites,%20Onondaga%20Formation).Detailed%20examination%20of%20these%20Devonian%20K-bentonites%20shows%20that%20in%20many%20cases%20they%20do%20not%20represent%20a%20single%20eruption.%20Multilayered%20beds,%20fossil%20layers%20within%20beds,%20authigenic%20minerals%20(e.g.,%20glauconite%20and%20phosphate%20nodules),%20subjacent%20hardgrounds,%20and%20an%20irregular%20distribution%20of%20beds%20through%20space%20and%20time%20raise%20questions%20about%20the%20depositional%20history%20and%20preservation%20potential%20of%20volcanic%20ash%20in%20marine%20environments%20and%20the%20degree%20to%20which%20the%20beds%20represent%20a%20primary%20record%20of%20volcanism.%20These%20and%20other%20lines%20of%20evidence%20indicate%20that%20postdepositional%20physical,%20biological,%20and%20geochemical%20processes%20(e.g.,%20sedimentation%20rate,%20event,%20and%20background%20physical%20processes,%20burrowing)%20have%20modified%20the%20primary%20record%20of%20these%20water-laid%20ash-fall%20events.%20These%20factors%20may%20lead%20to%20preservation%20of%20primary%20ash%20deposits%20or%20to%20their%20resedimentation%20and/or%20partial%20to%20complete%20mixing%20with%20background%20sediments.The%20preservation%20potential,%20and%20resulting%20distribution,%20of%20the%20Devonian%20K-bentonites%20can%20be%20analyzed%20across%20a%20spectrum%20of%20preservational%20magnafacies.%20In%20this%20paper%20I%20present%20a%20model%20of%20ash%20preservation;%20the%20model%20incorporates%20environmentally%20related%20physical,%20biological,%20and%20chemical%20processes%20active%20in%20epicontinental%20seas%20and%20marine%20foreland%20basins.%20Conclusions%20based%20on%20the%20model%20indicate%20that%20the%20middle%20Lochkovian,%20early%20Emsian,%20and%20early%20Eifelian%20were%20times%20of%20peak%20volcanic%20activity%20in%20eastern%20North%20America,%20related%20to%20times%20of%20increased%20tectonism%20in%20the%20Acadian%20orogen.}}

