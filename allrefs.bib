@article{Davydov2010a,
	abstract = {High-precision ID-TIMS U-Pb zircon ages for 12 interstratified tuffs and tonsteins are used to radiometrically calibrate the detailed lithostratigraphic, cyclostratigraphic, and biostratigraphic framework of the Carboniferous Donets Basin of eastern Europe. Chemical abrasion of zircons, use of the internationally calibrated EARTHTIME mixed U-Pb isotope dilution tracer, and improved mass spectrometry guided by detailed error analysis have resulted in an age resolution of {$<$}0.05{\%}, or \&{\#}8764;100 ka, for these Carboniferous volcanics. This precision allows the resolution of time in the Milankovitch band and confirms the long-standing hypothesis that individual high-frequency Pennsylvanian cyclothems and bundles of cyclothems into fourth-order sequences are the eustatic response to orbital eccentricity (\&{\#}8764;100 and 400 ka) forcing. Tuning of the fourth-order sequences in the Donets Basin to the long-period eccentricity cycle results in a continuous age model for the Middle to Late Pennsylvanian (Moscovian-Kasimovian-Ghzelian) strata of the basin and their record of biological and climatic changes through the latter portion of the late Paleozoic Ice Age. Detailed fusulinid and conodont zonations allow the export of this age model to sections throughout Euramerica. Additional ages for Mississippian strata provide among the first robust radiometric calibration points within this subperiod and result in variable lowering of the base ages of its constituent stages compared to recent global time scale compilations.},
	author = {Davydov, Vladimir I. and Crowley, James L. and Schmitz, Mark D. and Poletaev, Vladislav I.},
	date = {2010/02/02},
	date-added = {2011-03-22 10:19:33 -0400},
	date-modified = {2020-02-04 17:10:50 -0800},
	doi = {10.1029/2009GC002736},
	isbn = {1525-2027},
	journal = {Geochem. Geophys. Geosyst.},
	keywords = {U-Pb geochronology; zircon; Carboniferous; time scale; cyclostratigraphy; biostratigraphy; 1115 Geochronology: Radioisotope geochronology; 1135 Geochronology: Correlative geochronology; 4946 Paleoceanography: Milankovitch theory},
	month = {02},
	number = {2},
	publisher = {AGU},
	sp = {Q0AA04},
	title = {{High-precision U-Pb zircon age calibration of the global Carboniferous time scale and Milankovitch band cyclicity in the Donets Basin, eastern Ukraine}},
	ty = {JOUR},
	volume = {11},
	year = {2010},
	bdsk-file-1 = {},
	bdsk-file-2 = {},
	bdsk-url-1 = {http://dx.doi.org/10.1029/2009GC002736}}

@article{Dunlop1977a,
	abstract = {Viscous remanent magnetization (VRM) generated during the Brunhes epoch is a major source of paleomagnetic noise. VRM is usually \&{\#}8216;soft\&{\#}8217; or easily erased by alternating field (af) demagnetization, but we find that in a few hour's exposure to a weak field, hematite grains 0.1\&{\#}8722;5 µm in size acquire significant VRM, about 10{\%} of which survives af demagnetization to 400 Oe. The finer the grains and the longer the exposure time, the more intense and resistant to demagnetization VRM. Calculations using the N{\`E}el {$[$}1949{$]$} single\&{\#}8208;domain theory of VRM indicate that \&{\#}8216;hard\&{\#}8217; VRM is not confined to hematite. It is a property of fine grains of any highly coercive magnetic mineral, e.g., elongated single\&{\#}8208;domain grains of iron in lunar rocks. In terrestrial hematite\&{\#}8208;bearing rocks, e.g., red beds, VRM acquired over the Brunhes epoch is probably largely unaffected by routine af demagnetization. However, these rocks can be successfully cleaned by heating because \&{\#}8216;hard\&{\#}8217; VRM is \&{\#}8216;soft\&{\#}8217; to thermal demagnetization.},
	author = {Dunlop, David J. and Stirling, J. Mark},
	date-added = {2011-03-20 18:46:18 -0400},
	date-modified = {2012-10-29 20:46:20 +0000},
	do = {10.1029/GL004i004p00163},
	isbn = {0094-8276},
	journal = {Geophys. Res. Lett.},
	keywords = {1502 Geomagnetism and Paleomagnetism: Time variations, paleomagnetism; 1594 Geomagnetism and Paleomagnetism: Instruments and techniques; 5109 Physical Properties of Rocks: Magnetic and electrical properties},
	number = {4},
	pages = {163--166},
	publisher = {AGU},
	title = {``Hard'' viscous remanent magnetization (VRM) in fine-grained hematite},
	ty = {JOUR},
	volume = {4},
	year = {1977},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://dx.doi.org/10.1029/GL004i004p00163}}

