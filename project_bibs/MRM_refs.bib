@article{Guenthner2013a,
	annote = {10.2475/03.2013.01},
	author = {Guenthner, William R. and Reiners, Peter W. and Ketcham, Richard A. and Nasdala, Lutz and Giester, Gerald},
	cited-by = {MRM},
	date-added = {2017-04-05 19:05:42 +0000},
	date-modified = {2024-03-07 15:26:20 -0800},
	journal = {American Journal of Science},
	journal1 = {American Journal of Science},
	number = {3},
	pages = {145--198},
	title = {{Helium diffusion in natural zircon: Radiation damage, anisotropy, and the interpretation of zircon (U-Th)/He thermochronology}},
	volume = {313},
	year = {2013},
	bdsk-url-1 = {http://www.ajsonline.org/content/313/3/145.abstract%20N2%20-%20Accurate%20thermochronologic%20interpretation%20of%20zircon%20(U-Th)/He%20dates%20requires%20a%20realistic%20and%20practically%20useful%20understanding%20of%20He%20diffusion%20kinetics%20in%20natural%20zircon,%20ideally%20across%20the%20range%20of%20variation%20that%20characterize%20typically%20dated%20specimens.%20Here%20we%20present%20a%20series%20of%20date%20and%20diffusion%20measurements%20that%20document%20the%20importance%20of%20alpha%20dose,%20which%20we%20interpret%20to%20be%20correlated%20with%20accumulated%20radiation%20damage,%20on%20He%20diffusivity.%20This%20effect%20is%20manifest%20in%20both%20date-effective%20uranium%20(eU)%20correlations%20among%20zircon%20grains%20from%20single%20hand%20samples%20and%20in%20diffusion%20experiments%20on%20pairs%20of%20crystallographically%20oriented%20slabs%20of%20zircon%20with%20alpha%20doses%20ranging%20from%20%E2%88%BC1016%20to%201019%20%CE%B1/g.%20We%20interpret%20these%20results%20as%20due%20to%20two%20contrasting%20effects%20of%20radiation%20damage%20in%20zircon,%20both%20of%20which%20have%20much%20larger%20effects%20on%20He%20diffusivity%20and%20thermal%20sensitivity%20of%20the%20zircon%20(U-Th)/He%20system%20than%20crystallographic%20anisotropy.%20Between%201.2%20%C3%97%201016%20%CE%B1/g%20and%201.4%20%C3%97%201018%20%CE%B1/g,%20the%20frequency%20factor,%20D0,%20measured%20in%20the%20c-axis%20parallel%20direction%20decreases%20by%20roughly%20four%20orders%20of%20magnitude,%20causing%20He%20diffusivity%20to%20decrease%20dramatically%20(for%20example%20by%20three%20orders%20of%20magnitude%20at%20temperatures%20between%20140%20and%20220%20%C2%B0C).%20Above%20%E2%88%BC2%20%C3%97%201018%20%CE%B1/g,%20however,%20activation%20energy%20decreases%20by%20a%20factor%20of%20roughly%20two,%20and%20diffusivity%20increases%20by%20about%20nine%20orders%20of%20magnitude%20by%208.2%20%C3%97%201018%20%CE%B1/g.%20We%20interpret%20these%20two%20trends%20with%20a%20model%20that%20describes%20the%20increasing%20tortuosity%20of%20diffusion%20pathways%20with%20progressive%20damage%20accumulation,%20which%20in%20turn%20causes%20decreases%20in%20He%20diffusivity%20at%20low%20damage.%20At%20high%20damage,%20increasing%20diffusivity%20results%20from%20damage%20zone%20interconnection%20and%20consequential%20shrinking%20of%20the%20effective%20diffusion%20domain%20size.%20Our%20model%20predicts%20that%20the%20bulk%20zircon%20(U-Th)/He%20closure%20temperature%20(Tc)%20increases%20from%20about%20140%20to%20220%20%C2%B0C%20between%20alpha%20doses%20of%201016%20to%201018%20%CE%B1/g,%20followed%20by%20a%20dramatic%20decrease%20in%20Tc%20above%20this%20dose.%20Linking%20this%20parameterization%20to%20one%20describing%20damage%20annealing%20as%20a%20function%20of%20time%20and%20temperature,%20we%20can%20model%20the%20coevolution%20of%20damage,%20He%20diffusivity,%20and%20(U-Th)/He%20date%20of%20zircon.%20This%20model%20generates%20positive%20or%20negative%20date-eU%20correlations%20depending%20on%20the%20extent%20of%20damage%20in%20each%20grain%20and%20the%20date-eU%20sample's%20time-temperature%20history.}}

