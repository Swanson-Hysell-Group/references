@article{Moles2014a,
	annote = {10.1144/SP393.7},
	author = {Moles, Norman R. and Boyce, Adrian J. and Fallick, Anthony E.},
	date = {2014/01/03},
	date-added = {2014-01-09 21:01:02 +0000},
	date-modified = {2014-01-09 21:01:02 +0000},
	journal = {Geological Society, London, Special Publications},
	journal1 = {Geological Society, London, Special Publications},
	month = {01},
	title = {Abundant sulphate in the Neoproterozoic ocean: implications of constant δ34S of barite in the Aberfeldy SEDEX deposits, Scottish Dalradian},
	ty = {JOUR},
	url = {http://sp.lyellcollection.org/content/early/2014/01/02/SP393.7.abstract N2 - The timing and extent of ocean oxygenation is controversial. Proterozoic sulphur isotope datasets often show marked fluctuations over small stratigraphic intervals, suggesting that oceanic sulphate concentrations were much lower than modern values. A large accumulation of Neoproterozoic sulphate (>8 million tonnes preserved), as stratiform barite rock, is located in the Grampian Highlands near Aberfeldy. Diagenetic/metamorphic alteration has caused pronounced δ34S variations near bed margins. This aside, barite throughout the deposits shows a narrow range in δ34S, mean 36 ± 1.5‰. We infer that this is representative of contemporaneous seawater sulphate, and that δ34Sseawater was constant during deposition of a stratigraphical thickness >250 m of mostly fine-grained clastic sediments. Uniformity of δ34Sseawater during barite precipitation, even in thick (>10 m) beds and with the co-occurrence of abundant sulphides incorporating bacteriogenically reduced sulphur, implies no limit to availability of seawater sulphate during hydrothermal exhalative events. Our data, combined with previous δ34S research on Dalradian metasediments, suggest a stability, abundance and constancy of ocean sulphate in the Neoproterozoic. This contrasts with isotopic data using trace sulphate in limestones. It appears that, around the time of the Marinoan glaciation (c. 635 Ma), the ocean, although stratified at least locally, comprised a substantial reservoir of sulphate-bearing oxygenated seawater.},
	volume = {393},
	year = {2014},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://sp.lyellcollection.org/content/early/2014/01/02/SP393.7.abstract%20N2%20-%20The%20timing%20and%20extent%20of%20ocean%20oxygenation%20is%20controversial.%20Proterozoic%20sulphur%20isotope%20datasets%20often%20show%20marked%20fluctuations%20over%20small%20stratigraphic%20intervals,%20suggesting%20that%20oceanic%20sulphate%20concentrations%20were%20much%20lower%20than%20modern%20values.%20A%20large%20accumulation%20of%20Neoproterozoic%20sulphate%20(%3E8%20million%20tonnes%20preserved),%20as%20stratiform%20barite%20rock,%20is%20located%20in%20the%20Grampian%20Highlands%20near%20Aberfeldy.%20Diagenetic/metamorphic%20alteration%20has%20caused%20pronounced%20%CE%B434S%20variations%20near%20bed%20margins.%20This%20aside,%20barite%20throughout%20the%20deposits%20shows%20a%20narrow%20range%20in%20%CE%B434S,%20mean%2036%20%C2%B1%201.5%E2%80%B0.%20We%20infer%20that%20this%20is%20representative%20of%20contemporaneous%20seawater%20sulphate,%20and%20that%20%CE%B434Sseawater%20was%20constant%20during%20deposition%20of%20a%20stratigraphical%20thickness%20%3E250%20m%20of%20mostly%20fine-grained%20clastic%20sediments.%20Uniformity%20of%20%CE%B434Sseawater%20during%20barite%20precipitation,%20even%20in%20thick%20(%3E10%20m)%20beds%20and%20with%20the%20co-occurrence%20of%20abundant%20sulphides%20incorporating%20bacteriogenically%20reduced%20sulphur,%20implies%20no%20limit%20to%20availability%20of%20seawater%20sulphate%20during%20hydrothermal%20exhalative%20events.%20Our%20data,%20combined%20with%20previous%20%CE%B434S%20research%20on%20Dalradian%20metasediments,%20suggest%20a%20stability,%20abundance%20and%20constancy%20of%20ocean%20sulphate%20in%20the%20Neoproterozoic.%20This%20contrasts%20with%20isotopic%20data%20using%20trace%20sulphate%20in%20limestones.%20It%20appears%20that,%20around%20the%20time%20of%20the%20Marinoan%20glaciation%20(c.%20635%20Ma),%20the%20ocean,%20although%20stratified%20at%20least%20locally,%20comprised%20a%20substantial%20reservoir%20of%20sulphate-bearing%20oxygenated%20seawater.}}

