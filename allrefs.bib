	journal = {Geology},
	journal1 = {Geology},
	month = {02},
	number = {2},
	pages = {90--93},
	title = {Marine magnetic anomaly 33--34 identified in the Upper Cretaceous of the Great Valley Sequence of California},
	ty = {JOUR},
	url = {http://geology.gsapubs.org/content/11/2/90.abstract N2 - An interval of reversed magnetic polarity has been located in Upper Cretaceous rocks of the Great Valley Sequence of California. The interval has been found at four sites, two on each side of the Sacramento Valley. In each case, the reversed interval is associated with the same ammonite local range zone. Firm biostratigraphic correlation and the structure of the magnetic polarity time scale allow us to determine that the reversed interval corresponds to marine magnetic anomaly 33–34 and represents the lower part of the Campanian Stage. The reversed interval serves as a marker horizon linking the different faunal assemblages and sedimentary facies of the Great Valley Sequence. It also provides the first direct correlation of provincial biostratigraphic zones of the North Pacific province with the Cretaceous stages in Europe.},
	volume = {11},
	year = {1983},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://geology.gsapubs.org/content/11/2/90.abstract%20N2%20-%20An%20interval%20of%20reversed%20magnetic%20polarity%20has%20been%20located%20in%20Upper%20Cretaceous%20rocks%20of%20the%20Great%20Valley%20Sequence%20of%20California.%20The%20interval%20has%20been%20found%20at%20four%20sites,%20two%20on%20each%20side%20of%20the%20Sacramento%20Valley.%20In%20each%20case,%20the%20reversed%20interval%20is%20associated%20with%20the%20same%20ammonite%20local%20range%20zone.%20Firm%20biostratigraphic%20correlation%20and%20the%20structure%20of%20the%20magnetic%20polarity%20time%20scale%20allow%20us%20to%20determine%20that%20the%20reversed%20interval%20corresponds%20to%20marine%20magnetic%20anomaly%2033%E2%80%9334%20and%20represents%20the%20lower%20part%20of%20the%20Campanian%20Stage.%20The%20reversed%20interval%20serves%20as%20a%20marker%20horizon%20linking%20the%20different%20faunal%20assemblages%20and%20sedimentary%20facies%20of%20the%20Great%20Valley%20Sequence.%20It%20also%20provides%20the%20first%20direct%20correlation%20of%20provincial%20biostratigraphic%20zones%20of%20the%20North%20Pacific%20province%20with%20the%20Cretaceous%20stages%20in%20Europe.}}

