	keywords = {geomagnetism; geomagnetic secular variation; correlation times; main geomagnetic field models; dynamos: theories and simulations; statistical behavior; 1560 Geomagnetism and Paleomagnetism: Time variations: secular and longer; 1510 Geomagnetism and Paleomagnetism: Dynamo: theories and simulations; 1507 Geomagnetism and Paleomagnetism: Core processes; 3270 Mathematical Geophysics: Time series analysis; 3260 Mathematical Geophysics: Inverse theory},
