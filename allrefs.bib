@article{Dickinson2002a,
	annote = {10.1306/082701720288},
	author = {Dickinson, Julie A. and Wallace, Malcolm W. and Holdgate, Guy R. and Gallagher, Stephen J. and Thomas, Lindsay},
	date-added = {2017-04-25 23:35:54 +0000},
	date-modified = {2022-09-14 21:09:17 -0700},
	doi = {10.1306/082701720288},
	journal = {Journal of Sedimentary Research},
	month = {03},
	number = {2},
	pages = {288--303},
	title = {Origin and Timing of the {Miocene-Pliocene Unconformity in southeast Australia}},
	volume = {72},
	year = {2002},
	bdsk-file-1 = {},
	bdsk-file-2 = {},
	bdsk-url-1 = {http://jsedres.sepmonline.org/content/72/2/288.abstract%20N2%20-%20An%20unconformity%20is%20present%20close%20to%20the%20Miocene-Pliocene%20boundary%20in%20the%20onshore%20and%20nearshore%20portions%20of%20the%20Otway,%20Port%20Phillip-Torquay,%20and%20Gippsland%20basins%20of%20southeast%20Australia.%20The%20unconformity%20is%20angular%20(generally%20%3C%201-5%C2%B0%20angularity),%20with%20the%20underlying%20Miocene%20units%20having%20been%20deformed%20(gentle%20folding%20and%20reverse%20faulting)%20and%20eroded%20prior%20to%20deposition%20of%20the%20Pliocene%20succession.%20The%20unconformity%20also%20marks%20a%20change%20from%20Oligocene-Miocene%20deposition%20of%20cool-water%20carbonate%20sediments%20and%20brown%20coal-bearing%20successions%20to%20the%20accumulation%20of%20more%20siliciclastic-rich%20sediments%20in%20Pliocene%20time.%20The%20Miocene-Pliocene%20boundary%20therefore%20represents%20an%20interval%20of%20significant%20regional%20uplift%20in%20the%20southeast%20Australian%20basins.%20The%20amount%20of%20section%20removed%20is%20greatest%20around%20the%20Otway%20and%20Strzelecki%20ranges%20in%20Victoria,%20where%20up%20to%20a%20kilometer%20of%20section%20may%20have%20been%20removed.%20In%20most%20onshore%20sections%20of%20the%20Victorian%20basins%20hundreds%20of%20meters%20of%20section%20have%20been%20eroded.%20In%20distal%20offshore%20locations%20the%20boundary%20becomes%20conformable.%20The%20timing%20of%20uplift%20and%20erosion%20is%20best%20constrained%20in%20the%20Otway%20and%20Port%20Phillip%20basins,%20where%20late%20Miocene%20(N16%20%E2%88%BC%2010%20Ma)%20sediments%20underlie%20the%20unconformity%20and%20earliest%20Pliocene%20(%E2%88%BC%205%20Ma)%20sediments%20overlie%20it.%20This%20timing%20coincides%20with%20a%20change%20in%20the%20dynamics%20of%20the%20Australian%20plate,%20beginning%20at%20around%2012%20Ma.%20Southeast%20Australia%20is%20currently%20under%20a%20NW-SE%20compressional%20regime,%20and%20this%20has%20probably%20persisted%20since%20the%20late%20Miocene.%20In%20the%20basins%20(as%20opposed%20to%20the%20basement-dominated%20highland%20areas),%20the%20late%20Miocene%20uplift%20event%20is%20more%20significant%20than%20later%20Pliocene-Recent%20uplift.}}

