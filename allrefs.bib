@article{ALVAREZ1980a,
	annote = {10.1130/0016-7606(1980)91<476:FCLDAS>2.0.CO;2},
	author = {ALVAREZ, WALTER and KENT, DENNIS V. and PREMOLI SILVA, ISABELLA and SCHWEICKERT, RICHARD A. and LARSON, ROGER A.},
	date-added = {2014-01-20 23:45:16 +0000},
	date-modified = {2014-01-20 23:45:16 +0000},
	journal = {Geological Society of America Bulletin},
	journal1 = {Geological Society of America Bulletin},
	number = {8},
	pages = {476--484},
	title = {Franciscan Complex limestone deposited at 17$\,^{\circ}$South paleolatitude},
	ty = {JOUR},
	url = {http://gsabulletin.gsapubs.org/content/91/8/476.abstract N2 - At Laytonville, California, about 230 km north-northwest of San Francisco, three blocks of pelagic limestone, each a few tens of metres long, are incorporated in the Franciscan melange. Bedding is well defined, but top indicators are lacking. Paleomagnetic study of two of the blocks (16 samples, 52 specimens) yielded directions of D: 183.9°, I: −22.6°, α95: 21.6° (block 1), and D: 229.5°, I: −31.8°, α95: 10.7° (block 2) relative to the present orientation of bedding. Inclinations were not significantly different, but the difference in declinations shows that magnetization preceded emplacement of the blocks in the melange. Study of foraminifera showed that the blocks are of Albian and Cenomanian age and were deposited during the Cretaceous Long Normal Polarity Interval. Details of the foraminiferal zonation show that both blocks are right side up. The observed inclinations imply deposition on the Farallon plate at 17° ± 7° South paleolatitude at about 96 m.y. B.P. (block 2; block 1 data agree but are less definitive). Consideration of reasonable paleolongitudes and possible times of incorporation of the blocks in the melange indicates a Farallon–North America convergence rate significantly higher than any observed today. The most commonly accepted emplacement time (latest Cretaceous) indicates convergence at about 38 cm/yr (range: 24 to 60 cm/yr). An alternate interpretation, that emplacement occurred at 30 ± 15 m.y. B.P., would indicate convergence at about 15 cm/yr (range: 9 to 24 cm/yr). The convergence rates obtained in the first case are astonishingly high, and they suggest that perhaps current ideas on the Franciscan should be re-evaluated, with consideration given to the possibility that tectonic mixing continued until the middle or late Tertiary. Even so, the Farallon–North American convergence rate was apparently higher than any convergence rate observed today. This rapid convergence coincides with the Cretaceous rapid spreading pulse, and it may be responsible for such features as the large volumes of Late Cretaceous batholiths and subduction complexes in western North America.},
	volume = {91},
	year = {August, 1980},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://gsabulletin.gsapubs.org/content/91/8/476.abstract%20N2%20-%20At%20Laytonville,%20California,%20about%20230%20km%20north-northwest%20of%20San%20Francisco,%20three%20blocks%20of%20pelagic%20limestone,%20each%20a%20few%20tens%20of%20metres%20long,%20are%20incorporated%20in%20the%20Franciscan%20melange.%20Bedding%20is%20well%20defined,%20but%20top%20indicators%20are%20lacking.%20Paleomagnetic%20study%20of%20two%20of%20the%20blocks%20(16%20samples,%2052%20specimens)%20yielded%20directions%20of%20D:%20183.9%C2%B0,%20I:%20%E2%88%9222.6%C2%B0,%20%CE%B195:%2021.6%C2%B0%20(block%201),%20and%20D:%20229.5%C2%B0,%20I:%20%E2%88%9231.8%C2%B0,%20%CE%B195:%2010.7%C2%B0%20(block%202)%20relative%20to%20the%20present%20orientation%20of%20bedding.%20Inclinations%20were%20not%20significantly%20different,%20but%20the%20difference%20in%20declinations%20shows%20that%20magnetization%20preceded%20emplacement%20of%20the%20blocks%20in%20the%20melange.%20Study%20of%20foraminifera%20showed%20that%20the%20blocks%20are%20of%20Albian%20and%20Cenomanian%20age%20and%20were%20deposited%20during%20the%20Cretaceous%20Long%20Normal%20Polarity%20Interval.%20Details%20of%20the%20foraminiferal%20zonation%20show%20that%20both%20blocks%20are%20right%20side%20up.%20The%20observed%20inclinations%20imply%20deposition%20on%20the%20Farallon%20plate%20at%2017%C2%B0%20%C2%B1%207%C2%B0%20South%20paleolatitude%20at%20about%2096%20m.y.%20B.P.%20(block%202;%20block%201%20data%20agree%20but%20are%20less%20definitive).%20Consideration%20of%20reasonable%20paleolongitudes%20and%20possible%20times%20of%20incorporation%20of%20the%20blocks%20in%20the%20melange%20indicates%20a%20Farallon%E2%80%93North%20America%20convergence%20rate%20significantly%20higher%20than%20any%20observed%20today.%20The%20most%20commonly%20accepted%20emplacement%20time%20(latest%20Cretaceous)%20indicates%20convergence%20at%20about%2038%20cm/yr%20(range:%2024%20to%2060%20cm/yr).%20An%20alternate%20interpretation,%20that%20emplacement%20occurred%20at%2030%20%C2%B1%2015%20m.y.%20B.P.,%20would%20indicate%20convergence%20at%20about%2015%20cm/yr%20(range:%209%20to%2024%20cm/yr).%20The%20convergence%20rates%20obtained%20in%20the%20first%20case%20are%20astonishingly%20high,%20and%20they%20suggest%20that%20perhaps%20current%20ideas%20on%20the%20Franciscan%20should%20be%20re-evaluated,%20with%20consideration%20given%20to%20the%20possibility%20that%20tectonic%20mixing%20continued%20until%20the%20middle%20or%20late%20Tertiary.%20Even%20so,%20the%20Farallon%E2%80%93North%20American%20convergence%20rate%20was%20apparently%20higher%20than%20any%20convergence%20rate%20observed%20today.%20This%20rapid%20convergence%20coincides%20with%20the%20Cretaceous%20rapid%20spreading%20pulse,%20and%20it%20may%20be%20responsible%20for%20such%20features%20as%20the%20large%20volumes%20of%20Late%20Cretaceous%20batholiths%20and%20subduction%20complexes%20in%20western%20North%20America.}}

