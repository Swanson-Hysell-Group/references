	ty = {JOUR},
	volume = {20},
	year = {July, 1992},
	bdsk-url-1 = {http://geology.gsapubs.org/content/20/7/637.abstract%20N2%20-%20U-Pb%20baddeleyite%20ages%20of%201087%20%C2%B13%20and%201069%20%C2%B13%20Ma%20for%20twodiabase%20sills%20that%20intrude%20the%20Crystal%20Spring%20Formation%20of%20the%20Pahrump%20Group,%20southeastern%20California,%20provide%20a%20minimum%20estimate%20for%20the%20depositional%20age%20of%20the%20Crystal%20Spring%20Formation.%20The%20new%20ages%20high-light%20the%20potential%20range%20in%20deposition%20ages%20for%20the%20Pahrump%20Group,%20from%20%E2%89%A51087%20Ma%20to%20possibly%20as%20young%20as%20600%20Ma%20for%20Kingston%20Peak%20glaciogenic%20sediments.%20Consequently,%20there%20probably%20are%20significant%20disconformities%20within%20the%20Pahrump%20Group%20that%20separate%20unrelated,%20tectonically%20distinct%20episodes%20of%20basin%20subsidence.%20The%20Crystal%20Spring%20and%20Beck%20Spring%20Formations%20are%20considered%20to%20be%20platform-cover%20rocks%20preserved%20as%20a%20result%20of%20block%20faulting%20during%20deposition%20of%20the%20upper%20Kingston%20Peak%20Formation.%20The%20age%20of%20the%20Pahrump%20sills%20is%20in%20excellent%20agreement%20with%20the%20age%20of%20sills%20that%20intrude%20the%20Apache%20Group%20(central%20Arizona)%20and%20the%20Unkar%20Group%20(Grand%20Canyon)%20and%20supports%20earlier%20correlations%20of%20those%20units.}}

@article{Pearce1988a,
	annote = {10.1098/rsta.1988.0125},
	author = {Pearce, Julian A. and Houjun, Mei},
	date = {1988/12/12},
	date-added = {2012-10-12 19:31:43 +0000},
	date-modified = {2012-10-29 20:46:17 +0000},
	journal = {Philosophical Transactions of the Royal Society of London. Series A, Mathematical and Physical Sciences},
	journal1 = {Philosophical Transactions of the Royal Society of London. Series A, Mathematical and Physical Sciences},
	month = {12},
	number = {1594},
	pages = {169--201},
	title = {Volcanic Rocks of the 1985 Tibet Geotraverse: Lhasa to Golmud},
	ty = {JOUR},
	volume = {327},
	year = {1988},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://rsta.royalsocietypublishing.org/content/327/1594/169.abstract%20N2%20-%20Volcanic%20rocks%20encountered%20during%20the%20Tibet%20Geotraverse%20have%20been%20studied%20in%20the%20field,%20in%20thin%20section%20and%20by%20major%20and%20trace%20element%20geochemistry%20in%20order%20to%20determine%20their%20most%20probable%20original%20eruptive%20environment.%20Rocks%20from%20a%20total%20of%20eleven%20distinct%20volcanic%20provinces%20were%20studied%20in%20this%20way.%20They%20provide%20evidence%20for:%20an%20active%20continental%20margin%20or%20post-collision%20province%20of%20probable%20Devonian/early%20Carboniferous%20age%20in%20the%20northern%20Kunlun%20mountains;%20an%20active%20continental%20margin%20of%20late%20Carboniferous%20age%20in%20the%20southern%20Lhasa%20Terrane;%20Permian%20continental%20rifts%20in%20the%20central%20Qiangtang%20and%20central%20Kunlun%20Terranes;%20Triassic%20volcanic%20arcs%20in%20the%20southern%20Lhasa%20and%20northern%20Qiangtang%20Terranes;%20a%20Triassic%20active%20continental%20margin%20dyke%20swarm%20in%20the%20northern%20Kunlun%20mountains;%20a%20Jurassic%20post-collision%20or%20back-arc%20rifting%20province%20in%20the%20southern%20Qiangtang%20Terrane;%20a%20Jurassic%20island%20arc%20in%20the%20northern%20Lhasa%20Terrane;%20a%20Cretaceous%20post-collision%20province%20in%20the%20northern%20Lhasa%20Terrane%20possibly%20extending%20into%20the%20southern%20Qiangtang%20Terrane;%20and%20a%20Palaeogene%20active%20continental%20margin%20in%20the%20southern%20Lhasa%20Terrane.%20An%20Oligocene%20trachyte%20plug%20in%20the%20northern%20Qiangtang%20Terrane%20was%20the%20only%20evidence%20encountered%20during%20the%20Geotraverse%20of%20volcanism%20post-dating%20the%20Palaeogene%20India--Eurasia%20collision.%20However,%20the%20composition%20of%20this%20plug,%20coupled%20with%20new%20and%20published%20analyses%20from%20Miocene%20volcanics%20in%20the%20southern%20Lhasa%20terrane%20and%20from%20the%20Pliocene-Recent%20volcanic%20province%20of%20northwest%20Tibet,%20places%20important%20constraints%20on%20models%20for%20post-collision%20underplating%20of%20Tibet%20by%20continental%20lithosphere:%20any%20underplating%20is%20likely%20to%20have%20been%20(a)%20much%20later%20than%20the%20start%20of%20collision,%20(b)%20directed%20beneath%20Tibet%20from%20the%20north%20as%20well%20as%20the%20south,%20and%20(c)%20limited%20in%20extent.}}

@article{Leeder1988a,
	annote = {10.1098/rsta.1988.0123},
	author = {Leeder, M. R. and Smith, A. B. and Jixiang, Yin},
	date = {1988/12/12},
	date-added = {2012-10-12 19:21:28 +0000},
	date-modified = {2012-10-29 20:46:17 +0000},
	journal = {Philosophical Transactions of the Royal Society of London. Series A, Mathematical and Physical Sciences},
	journal1 = {Philosophical Transactions of the Royal Society of London. Series A, Mathematical and Physical Sciences},
	month = {12},
	number = {1594},
	pages = {107--143},
	title = {Sedimentology, Palaeoecology and Palaeoenvironmental Evolution of the 1985 Lhasa to Golmud Geotraverse},
	ty = {JOUR},
	volume = {327},
	year = {1988},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://rsta.royalsocietypublishing.org/content/327/1594/107.abstract%20N2%20-%20Vertical%20and%20horizontal%20measurements%20of%20almost%2030%20km%20of%20sections%20were%20made%20along%20the%20Geotraverse%20route%20at%20113%20localities%20ranging%20in%20age%20from%20Ordovician%20to%20Tertiary.%20Over%20280%20palaeocurrent%20measurements%20were%20taken%20and%20200%20thin%20sections%20were%20studied.%20Ordovician%20strata%20occur%20only%20in%20the%20Kunlun%20Terrane,%20where%20thick%20metamorphosed%20sequences%20of%20clastics%20and%20carbonates%20occur.%20These%20are%20tentatively%20interpreted%20as%20platform%20margin%20and%20slope%20deposits.%20During%20Carboniferous%20times%20in%20the%20Kunlun%20Terrane%20transgressive%20late-Dinantian%20marine%20limestones%20with%20tropical%20to%20subtropical%20Eurasian%20reefoidal%20faunas%20overlie%20fluviatile%20redbeds%20derived%20from%20an%20unroofed%20orogenic%20belt.%20The%20Lhasa%20Terrane%20contains%20shelf%20basin%20clastics%20with%20low-diversity%20faunas%20succeeded%20by%20thick%20late%20Carboniferous/early%20Permian%20glacio-marine%20mixtites%20deposited%20by%20iceberg%20meltout.%20Permian%20carbonate%20ramp%20and%20shelf%20facies%20with%20reefoidal%20developments%20occur%20over%20both%20the%20Lhasa%20and%20Qiangtang%20Terranes,%20with%20coal-bearing%20clastics%20and%20fluviatile%20redbeds%20also%20occurring%20in%20the%20latter.%20Permian%20sequences%20in%20the%20Kunlun%20Terrane%20comprise%20resedimented%20tuffaceous%20shelf%20basin%20clastics%20overlain%20by%20shelf%20carbonates.%20Triassic%20rocks%20are%20widely%20distributed.%20Those%20of%20the%20Lhasa%20Terrane%20are%20predominantly%20carbonate%20ramp%20and%20platform%20margin/slope%20facies%20showing%20evidence%20for%20shelf%20breakup%20due%20to%20extensional%20tectonics.%20Qiangtang%20sequences%20occur%20below%20and%20above%20a%20thick%20andesite%20lava%20development.%20Those%20below%20are%20mature%20fluviatile%20gravels%20derived%20from%20the%20north.%20The%20strata%20above%20the%20arc-related%20volcanics%20are%20typical%20shoaling-upwards%20carbonate%20ramp%20facies.%20Thick%20sequences%20in%20the%20southern%20Kunlun%20Terrane%20are%20tentatively%20ascribed%20to%20passive%20continental%20rise%20deposits%20of%20countourite%20drift%20aspects.%20Those%20in%20the%20northern%20areas%20are%20highly%20immature%20coarse%20clastics%20derived%20as%20alluvial%20fans%20from%20an%20Anisian--Carnian%20granitoid%20intrusive%20belt%20to%20the%20north.%20Jurassic%20sequences%20are%20unknown%20in%20the%20Kunlun%20Terrane.%20In%20the%20Qiangtang%20Terrane%20very%20thick%20(c.%205%20km)%20sequences%20of%20clastic%20redbeds%20are%20interpreted%20as%20fluviatile%20and%20coastal%20plain%20molasse%20derived%20from%20the%20newly%20formed%20Kunlun%20orogen%20to%20the%20north.%20These%20intertongue%20southwards%20with%20marine%20shelf%20carbonates%20and%20clastics.%20The%20northern%20Lhasa%20Terrane%20contains%20thick%20clastic%20mudrocks%20and%20turbiditic%20sandstones%20of%20shelf%20basin%20aspects.%20Pelagic%20cherts%20and%20clastics%20overly%20oceanic%20pillow%20lavas,%20with%20ophiolitic%20ultrabasics%20capped%20by%20ferrosiallitic%20duricrusts%20and%20overlain%20by%20late%20Jurassic%20marine%20limestones.%20Cretaceous%20rocks%20are%20only%20known%20in%20the%20Lhasa%20Terrane.%20North%20of%20Lhasa%20they%20comprise%20northerly-derived%20fluviatile%20redbeds%20of%20molassic%20aspects%20which%20record%20the%20formation%20and%20uplift%20of%20the%20Jinsha/Banggong%20orogen.%20300%20km%20NW%20of%20Lhasa%20probable%20Neocomian%20fluviatile%20clastics%20are%20overlain%20by%20Lower%20Cretaceous%20marine%20carbonate%20buildup%20and%20lagoonal%20facies.%20Tertiary%20successions%20are%20almost%20entirely%20continental%20and%20record%20fluvio-lacustrine%20deposition%20in%20a%20number%20of%20basins%20which%20are%20thought%20to%20have%20originated%20as%20thrust-related%20features%20during%20major%20crustal%20shortening%20of%20the%20Tibetan%20Plateau%20in%20the%20Palaeogene%20and%20Neogene.}}

