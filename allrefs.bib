@article{Cannon1994a,
	abstract = {N2 - The Midcontinent rift formed in the Laurentian supercontinent between 1109 and 1094 Ma. Soon after rifting, stresses changed from extensional to compressional, and the central graben of the rift was partly inverted by thrusting on original extensional faults. Thrusting culminated at about 1060 Ma but may have begun as early as 1080 Ma. On the southwest-trending arm of the rift, the crust was shortened about 30 km; on the southeast-trending arm, strike-slip motion was dominant. The rift developed adjacent to the tectonically active Grenville province, and its rapid evolution from an extensional to a compressional feature at ca. 1080 Ma was coincident with renewal of northwest-directed thrusting in the Grenvllle, probably caused by continent-continent collision. A zone of weak lithosphere created by rifting became the locus for deformation within the otherwise strong continental lithosphere. Stresses transmitted from the Grenville province utilized this weak zone to close and invert the rift.},
	author = {Cannon, William F.},
	date = {1994/02/01},
	date-added = {2014-11-24 18:28:55 +0000},
	date-modified = {2021-06-09 13:13:35 -0500},
	doi = {10.1130/0091-7613(1994)022$<$0155:COTMRA$>$2.3.CO;2},
	journal = {Geology},
	month = {02},
	number = {2},
	pages = {155--158},
	title = {Closing of the {M}idcontinent rift - {A} far-field effect of {G}renvillian compression},
	ty = {JOUR},
	volume = {22},
	year = {1994},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://geology.gsapubs.org/content/22/2/155.abstract%20N2%20-%20The%20Midcontinent%20rift%20formed%20in%20the%20Laurentian%20supercontinent%20between%201109%20and%201094%20Ma.%20Soon%20after%20rifting,%20stresses%20changed%20from%20extensional%20to%20compressional,%20and%20the%20central%20graben%20of%20the%20rift%20was%20partly%20inverted%20by%20thrusting%20on%20original%20extensional%20faults.%20Thrusting%20culminated%20at%20about%201060%20Ma%20but%20may%20have%20begun%20as%20early%20as%201080%20Ma.%20On%20the%20southwest-trending%20arm%20of%20the%20rift,%20the%20crust%20was%20shortened%20about%2030%20km;%20on%20the%20southeast-trending%20arm,%20strike-slip%20motion%20was%20dominant.%20The%20rift%20developed%20adjacent%20to%20the%20tectonically%20active%20Grenville%20province,%20and%20its%20rapid%20evolution%20from%20an%20extensional%20to%20a%20compressional%20feature%20at%20ca.%201080%20Ma%20was%20coincident%20with%20renewal%20of%20northwest-directed%20thrusting%20in%20the%20Grenvllle,%20probably%20caused%20by%20continent-continent%20collision.%20A%20zone%20of%20weak%20lithosphere%20created%20by%20rifting%20became%20the%20locus%20for%20deformation%20within%20the%20otherwise%20strong%20continental%20lithosphere.%20Stresses%20transmitted%20from%20the%20Grenville%20province%20utilized%20this%20weak%20zone%20to%20close%20and%20invert%20the%20rift.}}

