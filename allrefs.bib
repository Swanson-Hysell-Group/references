	date = {2008/06/01},
	date-added = {2010-11-15 21:18:46 -0500},
	date-modified = {2011-02-02 09:42:43 -0500},
	journal = {Geology},
	journal1 = {Geology},
	month = {06},
	number = {6},
	pages = {487--490},
	title = {Modern iron isotope perspective on the benthic iron shuttle and the redox evolution of ancient oceans},
	ty = {JOUR},
	volume = {36},
	year = {2008},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://geology.gsapubs.org/content/36/6/487.abstract%20N2%20-%20The%20increase%20in%20atmospheric%20oxygen%20ca.%202.4%20Ga%20had%20a%20significant%20impact%20on%20the%20geochemical%20cycling%20of%20Fe.%20The%20history%20of%20environmental%20oxygenation%20may%20be%20recorded%20in%20the%20Fe%20isotope%20composition%20of%20Archean%20and%20Proterozoic%20sediments,%20but%20this%20record%20cannot%20be%20interpreted%20accurately%20until%20we%20understand%20the%20mechanisms%20causing%20isotope%20variations.%20Here%20we%20present%20Fe%20isotope%20data%20and%20iron/aluminum%20ratios%20from%20the%20Black%20Sea%20oxic%20shelf%20and%20euxinic%20basin.%20The%20isotope%20data%20demonstrate%20that%20shelf%20Fe%20is%20depleted%20in%20the%20lighter%20isotope%20compared%20to%20both%20the%20detrital%20weathering%20input%20and%20the%20sediments%20of%20the%20euxinic%20basin.%20We%20propose%20that%20there%20is%20net%20transport%20of%20isotopically%20light%20Fe%20from%20sediments%20of%20the%20shelf%20to%20those%20of%20the%20distal,%20anoxic%20basin,%20consistent%20with%20enrichments%20in%20reactive%20Fe%20seen%20in%20the%20deep%20basin.%20The%20low%20%CE%B456Fe%20benthic%20Fe%20flux%20is%20generated%20during%20the%20coupling%20of%20microbial%20Fe(III)%20reduction%20or%20sulfidization%20with%20Fe2+aq%20oxidation.%20Low%20%CE%B456Fe%20values%20reported%20previously%20from%20Late%20Archean%20sedimentary%20pyrites%20may%20be%20an%20isotopic%20fingerprint%20of%20analogous%20Fe%20redox%20cycling%20in%20the%20Late%20Archean%20oceans.%20This%20interpretation%20implies%20shallow-water%20Fe%20redox%20recycling%20in%20the%20Late%20Archean.%20We%20predict%20that%20the%20light%20isotopic%20compositions%20of%20the%20Late%20Archean%20will%20prove%20to%20be%20distinct%20from%20those%20of%20the%20Early%20Archean,%20before%20Fe%20redox%20cycling%20became%20an%20important%20process,%20and%20we%20infer%20that%20this%20difference%20may%20be%20related%20to%20the%20presence%20of%20oxygen%20in%20the%20surface%20ocean.}}

