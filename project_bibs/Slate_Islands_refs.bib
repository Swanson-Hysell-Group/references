	ty = {JOUR},
	year = {2015},
	bdsk-url-1 = {http://geology.gsapubs.org/content/early/2015/11/05/G37190.1.abstract%20N2%20-%20Newly%20developed%20techniques%20were%20used%20to%20characterize%20the%20age,%20origin,%20and%20temperature%20history%20of%20coarse%20hematite%20contained%20in%20high-grade%20iron%20ore.%20Three%20botryoidal%20specimens%20from%20two%20different%20mines%20in%20the%20Gogebic%20iron%20range%20near%20Ironwood,%20Michigan%20(USA),%20yielded%20(U-Th)/21Ne%20ages%20concordant%20with%20plateau%204He/3He%20ages.%20These%20data%20reveal%20that%20while%20two%20of%20the%20specimens%20grew%20at%20ca.%20772%20%C2%B1%2041%20Ma,%20the%20third%20formed%20300%20m.y.%20later%20(453%20%C2%B1%2014%20Ma).%204He/3He%20polydomain%20thermochronometry%20indicates%20hematite%20formation%20at%20%3E80%20%C2%B0C%20for%20the%20older%20specimens%20and%20%E2%88%BC60%20%C2%B0C%20for%20the%20younger.%20Fe%20mobilization%20and%20recrystallization%20in%20open%20cavities%20at%203%E2%80%935%20km%20subsurface%20has%20occurred%20episodically%20or%20possibly%20continuously%20over%20hundreds%20of%20millions%20of%20years%20despite%20a%20quiescent%20tectonic%20setting%20throughout%20this%20interval.%20While%20the%20analyzed%20specimens%20are%20distinct%20from%20typical%20Fe%20ore,%20their%20ages%20along%20with%20structural%20relationships%20constrain%20the%20onset%20of%20iron%20enrichment%20to%20between%201060%20and%20770%20Ma.%20Cooling%20of%20%E2%88%BC0.5%20%C2%B0C/m.y.%20ensued%20between%20ca.%20800%20and%20ca.%20550%20Ma,%20declining%20to%20%E2%88%BC0.1%20%C2%B0C/m.y.%20for%20the%20last%20550%20m.y.%20These%20data%20suggest%20an%20erosion%20rate%20of%20%E2%88%BC6%20m/m.y.%20and%20%E2%88%BC5%20km%20of%20total%20erosion%20of%20the%20Superior%20Upland%20province%20through%20the%20Phanerozoic,%20and%20limit%20unroofing%20associated%20with%20Pleistocene%20glaciation%20to%20%3C1%20km.}}

