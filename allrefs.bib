@article{Black2014a,
	abstract = {Abstract The Siberian Traps flood basalts transferred a large mass of volatiles from the Earth's mantle and crust to the atmosphere. The eruption of the large igneous province temporally overlapped with the end-Permian mass extinction. Constraints on the sources of Siberian Traps volatiles are critical for determining the overall volatile budget, the role of crustal assimilation, the genesis of Noril'sk ore deposits, and the environmental effects of magmatism. We measure sulfur isotopic ratios ranging from − 10.8 ‰ to + 25.3 ‰ Vienna Ca{\~n}on Diablo Troilite (V-CDT) in melt inclusions from Siberian Traps basaltic rocks. Our measurements, which offer a snapshot of sulfur cycling far from mid-ocean ridge and arc settings, suggest the δ34S of the Siberian Traps mantle melt source was close to that of mid-ocean ridge basalts. In conjunction with previously published whole rock measurements from Noril'sk, our sulfur isotopic data indicate that crustal contamination was widespread and heterogeneous---though not universal---during the emplacement of the Siberian Traps. Incorporation of crustal materials likely increased the total volatile budget of the large igneous province, thereby contributing to Permian--Triassic environmental deterioration.},
	author = {Black, Benjamin A. and Hauri, Erik H. and Elkins-Tanton, Linda T. and Brown, Stephanie M.},
	date = {2014/5/15/},
	date-added = {2014-10-23 19:18:40 +0000},
	date-modified = {2014-10-23 19:18:40 +0000},
	day = {15},
	doi = {http://dx.doi.org/10.1016/j.epsl.2014.02.057},
	isbn = {0012-821X},
	journal = {Earth and Planetary Science Letters},
	keywords = {Siberian Traps; sulfur; crustal contamination; end-Permian mass extinction; volatile release},
	month = {5},
	number = {0},
	pages = {58--69},
	title = {Sulfur isotopic evidence for sources of volatiles in Siberian Traps magmas},
	ty = {JOUR},
	url = {http://www.sciencedirect.com/science/article/pii/S0012821X14001484},
	volume = {394},
	year = {2014},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://www.sciencedirect.com/science/article/pii/S0012821X14001484},
	bdsk-url-2 = {http://dx.doi.org/10.1016/j.epsl.2014.02.057}}

@article{Wei2014a,
	abstract = {Abstract The evolution of life is affected by variations of atmospheric oxygen level and geomagnetic field intensity. Oxygen can escape into interplanetary space as ions after gaining momentum from solar wind, but Earth's strong dipole field reduces the momentum transfer efficiency and the ion outflow rate, except for the time of geomagnetic polarity reversals when the field is significantly weakened in strength and becomes Mars-like in morphology. The newest databases available for the Phanerozoic era illustrate that the reversal rate increased and the atmospheric oxygen level decreased when the marine diversity showed a gradual pattern of mass extinctions lasting millions of years. We propose that accumulated oxygen escape during an interval of increased reversal rate could have led to the catastrophic drop of oxygen level, which is known to be a cause of mass extinction. We simulated the oxygen ion escape rate for the Triassic--Jurassic event, using a modified Martian ion escape model with an input of quiet solar wind inferred from Sun-like stars. The results show that geomagnetic reversal could enhance the oxygen escape rate by 3--4 orders only if the magnetic field was extremely weak, even without consideration of space weather effects. This suggests that our hypothesis could be a possible explanation of a correlation between geomagnetic reversals and mass extinction. Therefore, if this causal relation indeed exists, it should be a ``many-to-one'' scenario rather the previously considered ``one-to-one'', and planetary magnetic field should be much more important than previously thought for planetary habitability.},
	author = {Wei, Yong and Pu, Zuyin and Zong, Qiugang and Wan, Weixing and Ren, Zhipeng and Fraenz, Markus and Dubinin, Eduard and Tian, Feng and Shi, Quanqi and Fu, Suiyan and Hong, Minghua},
	date = {2014/5/15/},
	date-added = {2014-10-23 19:15:43 +0000},
	date-modified = {2014-10-23 19:15:43 +0000},
	day = {15},
	doi = {http://dx.doi.org/10.1016/j.epsl.2014.03.018},
	isbn = {0012-821X},
	journal = {Earth and Planetary Science Letters},
	keywords = {atmospheric ion escape; geomagnetic reversal; mass extinction},
	month = {5},
	number = {0},
	pages = {94--98},
	title = {Oxygen escape from the Earth during geomagnetic reversals: Implications to mass extinction},
	ty = {JOUR},
	url = {http://www.sciencedirect.com/science/article/pii/S0012821X14001629},
	volume = {394},
	year = {2014},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://www.sciencedirect.com/science/article/pii/S0012821X14001629},
	bdsk-url-2 = {http://dx.doi.org/10.1016/j.epsl.2014.03.018}}

@article{Black2013a,
	annote = {10.1130/G34875.1},
	author = {Black, Benjamin A. and Lamarque, Jean-Fran{\c c}ois and Shields, Christine A. and Elkins-Tanton, Linda T. and Kiehl, Jeffrey T.},
	date = {2013/11/22},
	date-added = {2014-10-23 19:11:34 +0000},
	date-modified = {2014-10-23 19:11:34 +0000},
	journal = {Geology},
	journal1 = {Geology},
	month = {11},
	title = {Acid rain and ozone depletion from pulsed Siberian Traps magmatism},
	ty = {JOUR},
	url = {http://geology.gsapubs.org/content/early/2013/11/21/G34875.1.abstract N2 - The Siberian Traps flood basalts have been invoked as a trigger for the catastrophic end-Permian mass extinction. Widespread aberrant plant remains across the Permian-Triassic boundary provide evidence that atmospheric stress contributed to the collapse in terrestrial diversity. We used detailed estimates of magmatic degassing from the Siberian Traps to complete the first three-dimensional global climate modeling of atmospheric chemistry during eruption of a large igneous province. Our results show that both strongly acidic rain and global ozone collapse are possible transient consequences of episodic pyroclastic volcanism and heating of volatile-rich Siberian country rocks. We suggest that in conjunction with abrupt warming from greenhouse gas emissions, these repeated, rapidly applied atmospheric stresses directly linked Siberian magmatism to end-Permian ecological failure on land. Our comprehensive modeling supplies the first picture of the global distribution and severity of acid rain and ozone depletion, providing testable predictions for the geography of end-Permian environmental proxies.},
	year = {2013},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://geology.gsapubs.org/content/early/2013/11/21/G34875.1.abstract%20N2%20-%20The%20Siberian%20Traps%20flood%20basalts%20have%20been%20invoked%20as%20a%20trigger%20for%20the%20catastrophic%20end-Permian%20mass%20extinction.%20Widespread%20aberrant%20plant%20remains%20across%20the%20Permian-Triassic%20boundary%20provide%20evidence%20that%20atmospheric%20stress%20contributed%20to%20the%20collapse%20in%20terrestrial%20diversity.%20We%20used%20detailed%20estimates%20of%20magmatic%20degassing%20from%20the%20Siberian%20Traps%20to%20complete%20the%20first%20three-dimensional%20global%20climate%20modeling%20of%20atmospheric%20chemistry%20during%20eruption%20of%20a%20large%20igneous%20province.%20Our%20results%20show%20that%20both%20strongly%20acidic%20rain%20and%20global%20ozone%20collapse%20are%20possible%20transient%20consequences%20of%20episodic%20pyroclastic%20volcanism%20and%20heating%20of%20volatile-rich%20Siberian%20country%20rocks.%20We%20suggest%20that%20in%20conjunction%20with%20abrupt%20warming%20from%20greenhouse%20gas%20emissions,%20these%20repeated,%20rapidly%20applied%20atmospheric%20stresses%20directly%20linked%20Siberian%20magmatism%20to%20end-Permian%20ecological%20failure%20on%20land.%20Our%20comprehensive%20modeling%20supplies%20the%20first%20picture%20of%20the%20global%20distribution%20and%20severity%20of%20acid%20rain%20and%20ozone%20depletion,%20providing%20testable%20predictions%20for%20the%20geography%20of%20end-Permian%20environmental%20proxies.}}

