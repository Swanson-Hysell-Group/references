	journal = {Geological Society of America Bulletin},
	journal1 = {Geological Society of America Bulletin},
	month = {4},
	number = {4},
	pages = {492--506},
	title = {Deposition of the uppermost Cambrian (Croixan) Jordan Sandstone, and the nature of the Cambrian-Ordovician boundary in the Upper Mississippi Valley},
	ty = {JOUR},
	volume = {106},
	year = {1994},
	bdsk-file-1 = {},
