	pages = {525--538},
	title = {{Neoproterozoic ice sheets and olistoliths: multiple glacial cycles in the Kingston Peak Formation, California}},
	ty = {JOUR},
	volume = {171},
	year = {2014},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://jgs.lyellcollection.org/content/171/4/525.abstract%20N2%20-%20The%20Kingston%20Peak%20Formation%20is%20a%20diamictite-bearing%20succession%20that%20crops%20out%20in%20the%20Death%20Valley%20region,%20California,%20USA.%20An%20exceptionally%20thick%20(%3E1.5%20km)%20outcrop%20belt%20in%20its%20type%20area%20(the%20Kingston%20Range)%20provides%20clear%20insights%20into%20the%20dynamics%20of%20mid-Cryogenian%20(%E2%80%98Sturtian%E2%80%99)%20ice%20sheets%20in%20Laurentia.%20Seven%20detailed%20logs%20allow%20the%20lateral%20and%20vertical%20distribution%20of%20facies%20associations%20to%20be%20assessed.%20We%20recognize%20(1)%20diamictite%20facies%20association%20(ice-proximal%20glacigenic%20debris%20flows),%20(2)%20lonestone-bearing%20facies%20association%20(ice-marginal%20hemipelagic%20deposits%20and%20low-density%20gravity%20flows%20with%20iceberg%20rafting),%20(3)%20pebble%20to%20boulder%20conglomerate%20facies%20association%20(ice-proximal%20cogenetic%20glacigenic%20debris%20flows%20and%20high-density%20turbidites),%20(4)%20megaclast%20facies%20association%20(olistostrome%20and%20hemipelagic%20sediments%20subject%20to%20ice-rafting),%20and%20(5)%20interbedded%20heterolithics%20facies%20association%20(low-density%20turbidites%20and%20hemipelagic%20deposits).%20The%20stratigraphic%20motif%20allows%20three%20glacial%20cycles%20to%20be%20inferred%20across%20the%20range.%20Ice-minimum%20conditions%20interrupting%20the%20Kingston%20Peak%20succession%20are%20associated%20with%20the%20development%20of%20an%20olistostrome%20complex,%20succeeded%20by%20a%20thick%20accumulation%20of%20boulder%20conglomerates%20deposited%20during%20ice%20readvance.%20The%20data%20testify%20to%20a%20strong%20glacial%20influence%20on%20sedimentation%20within%20this%20ancient%20subaqueous%20succession,%20and%20to%20highly%20dynamic%20ice%20sheet%20behaviour%20with%20clear%20glacial%20cycles%20during%20the%20Sturtian%20glaciation.}}

@article{Bryson2014a,
	abstract = {Abstract Nanoscale intergrowths unique to the cloudy zones (CZs) of meteoritic metal display novel magnetic behaviour with the potential to reveal new insight into the early development of magnetic fields on protoplanetary bodies. The nanomagnetic state of the CZ within the Tazewell IIICD iron meteorite has been imaged using off-axis electron holography. The CZ is revealed to be a natural nanocomposite of magnetically hard islands of tetrataenite (ordered FeNi) embedded in a magnetically soft matrix of ordered Fe3Ni. In the remanent state, each tetrataenite island acts as a uniaxial single domain particle with its [001] magnetic easy axis oriented along one of three 〈100〉 crystallographic directions of the parent taenite phase. Micromagnetic simulations demonstrate that switching occurs via the nucleation and propagation of domain walls through individual tetrataenite particles. The switching field (Hs) varies with the length scale of the matrix phase (Lm), with Hs &gt; 1 T for Lm ∼10 nm (approaching the intrinsic switching field for isolated single domain tetrataenite) and 0.2 &lt; H s &lt; 0.6 T for Lm ∼30 nm. The reduction in Hs with increasing Lc is caused by exchange coupling between the hard tetrataenite islands and the soft magnetic matrix, which lowers the critical field for domain wall nucleation, providing an explanation for previously observed coercivity variations throughout the CZ. Non-random distributions of the tetrataenite easy axes are observed locally throughout the CZ, suggesting a magnetic field could have been present during nanostructure formation. This observation demonstrates the potential for stable chemical transformation remanent magnetisation to be encoded by the nanostructure, with variations in the proportions of the six possible magnetisation states reflecting the intensity and relative direction of the magnetic fields present during cooling. According to recent cooling models, the cooling rate of meteoritic metal originating near the surface of differentiated planetesimals was such that the magnetic signal across the CZ could potentially record dynamo field intensity and direction variations over time (10--100 Ma), which would enable events such as magnetic reversals and the decay of an asteroid dynamo to be observed.},
	author = {Bryson, James F. J. and Church, Nathan S. and Kasama, Takeshi and Harrison, Richard J.},
	date = {2014/2/15/},
	date-added = {2015-03-11 20:47:47 +0000},
	date-modified = {2015-03-11 20:47:47 +0000},
	day = {15},
	doi = {http://dx.doi.org/10.1016/j.epsl.2013.12.004},
	isbn = {0012-821X},
	journal = {Earth and Planetary Science Letters},
	keywords = {extraterrestrial magnetism; tetrataenite; cloudy zone; high-resolution magnetic microscopy; off-axis electron holography},
	month = {2},
	number = {0},
	pages = {237--248},
	title = {Nanomagnetic intergrowths in Fe--Ni meteoritic metal: The potential for time-resolved records of planetesimal dynamo fields},
	ty = {JOUR},
	url = {http://www.sciencedirect.com/science/article/pii/S0012821X13007012},
	volume = {388},
	year = {2014},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://www.sciencedirect.com/science/article/pii/S0012821X13007012},
	bdsk-url-2 = {http://dx.doi.org/10.1016/j.epsl.2013.12.004}}

