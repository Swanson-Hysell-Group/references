	bdsk-file-1 = {},
	bdsk-url-1 = {http://sp.lyellcollection.org/content/396/1/265.abstract%20N2%20-%20The%20determination%20of%20the%20past%20ancient%20magnetic%20field%20intensity%20is%20typically%20very%20difficult%20and%20error%20prone.%20Fresh%20volcanic%20glass%20has%20been%20suggested%20to%20be%20an%20ideal%20material%20for%20obtaining%20direction%20and%20strength%20of%20the%20magnetic%20field.%20Domain%20state%20bias%20is%20generally%20absent,%20thermal%20alteration%20is%20normally%20negligible%20and,%20as%20demonstrated%20in%20this%20study,%20cooling-rate%20differences%20can%20be%20corrected%20for.%20Major%20issues%20remaining%20include%20alteration%20and%20the%20origin%20of%20the%20remanence:%20that%20is,%20whether%20it%20is%20a%20true%20thermo-,%20a%20thermochemical%20or,%20for%20altered%20samples,%20a%20chemical%20remanence.%20Hydration,%20devitrification%20and%20perlitization%20lead%20to%20incorrect%20estimates%20of%20the%20palaeointensity,%20which%20are%20very%20difficult%20to%20recognize%20as%20the%20palaeointensity%20analysis%20does%20not%20easily%20expose%20these%20biasing%20effects%20and%20points%20towards%20%E2%80%98reliable%E2%80%99%20results.%20Particular%20care%20on%20sampling%20and/or%20volatile%20measurements%20are%20necessary%20to%20overcome%20these%20drawbacks.},
