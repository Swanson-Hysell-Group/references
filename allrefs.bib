@article{Bassett2007a,
	annote = {10.2110/palo.2005.p05-089r},
	author = {Bassett, DAMON and Macleod, KENNETH G. and Miller, JAMES F. and Ethington, RAYMOND L.},
	date-added = {2017-01-06 17:36:29 +0000},
	date-modified = {2017-01-06 17:37:21 +0000},
	doi = {10.2110/palo.2005.p05-089r},
	journal = {PALAIOS},
	journal1 = {PALAIOS},
	month = {01},
	number = {1},
	pages = {98--103},
	title = {OXYGEN ISOTOPIC COMPOSITION OF BIOGENIC PHOSPHATE AND THE TEMPERATURE OF {E}ARLY {O}RDOVICIAN SEAWATER},
	ty = {JOUR},
	url = {http://palaios.sepmonline.org/content/22/1/98.abstract N2 - Stable isotopic values were measured on micrite, sparry calcite, dolomite, inarticulated brachiopods, and conodonts from the Lange Ranch section (central Texas) of the Lower Ordovician Tanyard Formation. The section spans the upper Cordylodus angulatus Zone through the lower Rossodus manitouensis Zone. An ∼2‰ negative δ13C shift from >0‰ to <−1.5‰VPDB through the section suggests the lower third of the Rossodus manitouensis Zone was sampled. Consistent with previous studies, the δ18O values of carbonates are low, ranging from −3.3‰ to −8.1‰VPDB. Phosphate δ18O values range from 15.4‰ to 17.1‰VSMOW. Paleotemperature estimates calculated from micrite δ18O values assuming an ice-free seawater δ18O value of −1‰VSMOW indicate Early Ordovician tropical seawater temperatures averaged 42°C, whereas δ18O values of co-occurring biogenic phosphate assuming the same seawater value yield paleotemperature estimates averaging 37°C. The phosphate values are interpreted as less affected by diagenesis than carbonate values and suggest Early Ordovician tropical paleotemperatures were not more than 10°C warmer or the oxygen isotopic composition of Early Ordovician hydrosphere was not more than 2‰ lower than present.},
	volume = {22},
	year = {2007},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://palaios.sepmonline.org/content/22/1/98.abstract%20N2%20-%20Stable%20isotopic%20values%20were%20measured%20on%20micrite,%20sparry%20calcite,%20dolomite,%20inarticulated%20brachiopods,%20and%20conodonts%20from%20the%20Lange%20Ranch%20section%20(central%20Texas)%20of%20the%20Lower%20Ordovician%20Tanyard%20Formation.%20The%20section%20spans%20the%20upper%20Cordylodus%20angulatus%20Zone%20through%20the%20lower%20Rossodus%20manitouensis%20Zone.%20An%20%E2%88%BC2%E2%80%B0%20negative%20%CE%B413C%20shift%20from%20%3E0%E2%80%B0%20to%20%3C%E2%88%921.5%E2%80%B0VPDB%20through%20the%20section%20suggests%20the%20lower%20third%20of%20the%20Rossodus%20manitouensis%20Zone%20was%20sampled.%20Consistent%20with%20previous%20studies,%20the%20%CE%B418O%20values%20of%20carbonates%20are%20low,%20ranging%20from%20%E2%88%923.3%E2%80%B0%20to%20%E2%88%928.1%E2%80%B0VPDB.%20Phosphate%20%CE%B418O%20values%20range%20from%2015.4%E2%80%B0%20to%2017.1%E2%80%B0VSMOW.%20Paleotemperature%20estimates%20calculated%20from%20micrite%20%CE%B418O%20values%20assuming%20an%20ice-free%20seawater%20%CE%B418O%20value%20of%20%E2%88%921%E2%80%B0VSMOW%20indicate%20Early%20Ordovician%20tropical%20seawater%20temperatures%20averaged%2042%C2%B0C,%20whereas%20%CE%B418O%20values%20of%20co-occurring%20biogenic%20phosphate%20assuming%20the%20same%20seawater%20value%20yield%20paleotemperature%20estimates%20averaging%2037%C2%B0C.%20The%20phosphate%20values%20are%20interpreted%20as%20less%20affected%20by%20diagenesis%20than%20carbonate%20values%20and%20suggest%20Early%20Ordovician%20tropical%20paleotemperatures%20were%20not%20more%20than%2010%C2%B0C%20warmer%20or%20the%20oxygen%20isotopic%20composition%20of%20Early%20Ordovician%20hydrosphere%20was%20not%20more%20than%202%E2%80%B0%20lower%20than%20present.}}

