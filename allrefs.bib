@article{Calver2013a,
	author = {Calver, C. R. and Crowley, J. L. and Wingate, M. T. D. and Evans, D. A. D. and Raub, T. D. and Schmitz, M. D.},
	date-added = {2013-09-18 15:40:15 +0000},
	date-modified = {2014-01-08 05:01:11 +0000},
	doi = {10.1130/G34568.1},
	journal = {Geology},
	month = {07},
	title = {{Globally synchronous Marinoan deglaciation indicated by U-Pb geochronology of the Cottons Breccia, Tasmania, Australia}},
	year = {2013},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://geology.gsapubs.org/content/early/2013/07/30/G34568.1.abstract%20N2%20-%20U-Pb%20zircon%20data%20from%20the%20uppermost%20Cottons%20Breccia,%20representing%20the%20Marinoan%20glacial-postglacial%20transition%20on%20King%20Island,%20Tasmania,%20provide%20the%20first%20direct%20age%20constraint%20on%20the%20Cryogenian-Ediacaran%20boundary%20in%20Australia.%20Zircons%20in%20four%20samples%20from%20the%20topmost%20meter%20of%20the%20Cottons%20Breccia,%20dated%20by%20sensitive%20high-resolution%20ion%20microprobe,%20exhibit%20two%20modes%20ca.%20660%20Ma%20and%20ca.%20635%20Ma.%20The%20younger%20component%20predominates%20in%20the%20uppermost%20sample,%20a%20possibly%20volcanolithic%20dolomitic%20sandstone,%20apparently%20lacking%20glacially%20transported%20debris,%20in%20the%20transition%20to%20cap%20carbonate.%20Chemical%20abrasion%E2%80%93thermal%20ionization%20mass%20spectrometry%20(CA-TIMS)%20U-Pb%20dating%20of%20euhedral%20zircons%20from%20that%20sample%20yields%20a%20weighted-mean%20age%20of%20636.41%20%C2%B1%200.45%20Ma.%20Equivalence%20to%20published%20TIMS%20ash%20bed%20dates%20from%20Cryogenian-Ediacaran%20transitional%20strata%20in%20Namibia%20(635.51%20%C2%B1%200.82%20Ma,%20within%20glacial%20deposit)%20and%20China%20(635.23%20%C2%B1%200.84%20Ma,%202%20m%20above%20glacial%20deposit)%20supports%20correlation%20of%20those%20strata%20to%20the%20Australian%20type%20sections%20and%20globally%20synchronous%20deglaciation%20at%20the%20end%20of%20the%20Cryogenian%20Period.}}

@article{Yamazaki2013a,
	author = {Yamazaki, Toshitsugu and Shimono, Takaya},
	date = {2013/09/06},
	date-added = {2013-09-18 15:34:07 +0000},
	date-modified = {2013-09-18 15:34:07 +0000},
	journal = {Geology},
	m3 = {10.1130/G34782.1},
	month = {09},
	title = {Abundant bacterial magnetite occurrence in oxic red clay},
	ty = {JOUR},
	url = {http://geology.gsapubs.org/content/early/2013/09/06/G34782.1.abstract N2 - Magnetotactic bacteria (MTB) produce chains of intracellular magnetite and/or greigite crystals and respond to an ambient magnetic field. MTB are considered to be microaerophilic to anaerobic organisms that live at and below the oxic-anoxic transition zone of aquatic environments. On the basis of rock magnetic analyses, including first-order reversal curve diagrams and isothermal remanent magnetization component analyses, along with transmission electron microscopy, we demonstrate that bacterial magnetites (magnetofossils) dominate magnetic mineral assemblages throughout a 76 m thickness of red clay at Integrated Ocean Drilling Program Site U1365 in the South Pacific Gyre, as well as in subsurface red clay of the North Pacific Gyre, where the sediment column contains abundant dissolved oxygen and no oxic-anoxic transition zone exists. This implies that MTB inhabit red clay; this conflicts with widespread interpretations of MTB ecology, namely that they are microaerophilic, requiring low levels of oxygen to grow and produce magnetite, and that magnetotaxis is used to help them find optimal positions in a strong vertical chemical gradient. Most magnetofossils in the red clay have cubo-octahedral morphology. This supports the notion that magnetofossil morphology can be a paleoenvironmental indicator; the proportion of elongated magnetofossils increases in less oxic environments. Our results also have implications for red-clay paleomagnetism in that magnetofossils may cause much-delayed remanence acquisition if MTB can live at decimeter depths within red clay.},
	year = {2013},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://geology.gsapubs.org/content/early/2013/09/06/G34782.1.abstract%20N2%20-%20Magnetotactic%20bacteria%20(MTB)%20produce%20chains%20of%20intracellular%20magnetite%20and/or%20greigite%20crystals%20and%20respond%20to%20an%20ambient%20magnetic%20field.%20MTB%20are%20considered%20to%20be%20microaerophilic%20to%20anaerobic%20organisms%20that%20live%20at%20and%20below%20the%20oxic-anoxic%20transition%20zone%20of%20aquatic%20environments.%20On%20the%20basis%20of%20rock%20magnetic%20analyses,%20including%20first-order%20reversal%20curve%20diagrams%20and%20isothermal%20remanent%20magnetization%20component%20analyses,%20along%20with%20transmission%20electron%20microscopy,%20we%20demonstrate%20that%20bacterial%20magnetites%20(magnetofossils)%20dominate%20magnetic%20mineral%20assemblages%20throughout%20a%2076%20m%20thickness%20of%20red%20clay%20at%20Integrated%20Ocean%20Drilling%20Program%20Site%20U1365%20in%20the%20South%20Pacific%20Gyre,%20as%20well%20as%20in%20subsurface%20red%20clay%20of%20the%20North%20Pacific%20Gyre,%20where%20the%20sediment%20column%20contains%20abundant%20dissolved%20oxygen%20and%20no%20oxic-anoxic%20transition%20zone%20exists.%20This%20implies%20that%20MTB%20inhabit%20red%20clay;%20this%20conflicts%20with%20widespread%20interpretations%20of%20MTB%20ecology,%20namely%20that%20they%20are%20microaerophilic,%20requiring%20low%20levels%20of%20oxygen%20to%20grow%20and%20produce%20magnetite,%20and%20that%20magnetotaxis%20is%20used%20to%20help%20them%20find%20optimal%20positions%20in%20a%20strong%20vertical%20chemical%20gradient.%20Most%20magnetofossils%20in%20the%20red%20clay%20have%20cubo-octahedral%20morphology.%20This%20supports%20the%20notion%20that%20magnetofossil%20morphology%20can%20be%20a%20paleoenvironmental%20indicator;%20the%20proportion%20of%20elongated%20magnetofossils%20increases%20in%20less%20oxic%20environments.%20Our%20results%20also%20have%20implications%20for%20red-clay%20paleomagnetism%20in%20that%20magnetofossils%20may%20cause%20much-delayed%20remanence%20acquisition%20if%20MTB%20can%20live%20at%20decimeter%20depths%20within%20red%20clay.}}

@article{Riller2010a,
	author = {Riller, Ulrich and Lieger, Daniel and Gibson, Roger L. and Grieve, Richard A. F. and St{\"o}ffler, Dieter},
	date = {2010/07/01},
	date-added = {2013-08-16 22:04:05 +0000},
	date-modified = {2013-08-16 22:04:05 +0000},
	journal = {Geology},
	m3 = {10.1130/G30806.1},
	month = {07},
	number = {7},
	pages = {619--622},
	title = {Origin of large-volume pseudotachylite in terrestrial impact structures},
	ty = {JOUR},
	url = {http://geology.gsapubs.org/content/38/7/619.abstract N2 - Large-volume pseudotachylite bodies in impact structures are dike like and consist of angular and rounded wall-rock fragments enveloped by a microcrystalline and sporadically glassy matrix that crystallized from a melt. Knowledge of the formation of pseudotachylite bodies is important for understanding mechanics of complex crater formation. Most current hypotheses of pseudotachylite formation inherently assume that fragmentation and melt generation occur during a single process. Based on the structure of pseudotachylite bodies at Sudbury (Canada) and Vredefort (South Africa), we show that these processes differ in time and space. We demonstrate that the centimeter- to kilometer-scale bodies are effectively fragment- and melt-filled tension fractures that formed by differential rotation of target rock during cratering. Highly variable pseudotachylite characteristics can be accounted for by a single process, i.e., drainage of initially superheated impact melt into tension fractures of the crater floor.},
	volume = {38},
	year = {2010},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://geology.gsapubs.org/content/38/7/619.abstract%20N2%20-%20Large-volume%20pseudotachylite%20bodies%20in%20impact%20structures%20are%20dike%20like%20and%20consist%20of%20angular%20and%20rounded%20wall-rock%20fragments%20enveloped%20by%20a%20microcrystalline%20and%20sporadically%20glassy%20matrix%20that%20crystallized%20from%20a%20melt.%20Knowledge%20of%20the%20formation%20of%20pseudotachylite%20bodies%20is%20important%20for%20understanding%20mechanics%20of%20complex%20crater%20formation.%20Most%20current%20hypotheses%20of%20pseudotachylite%20formation%20inherently%20assume%20that%20fragmentation%20and%20melt%20generation%20occur%20during%20a%20single%20process.%20Based%20on%20the%20structure%20of%20pseudotachylite%20bodies%20at%20Sudbury%20(Canada)%20and%20Vredefort%20(South%20Africa),%20we%20show%20that%20these%20processes%20differ%20in%20time%20and%20space.%20We%20demonstrate%20that%20the%20centimeter-%20to%20kilometer-scale%20bodies%20are%20effectively%20fragment-%20and%20melt-filled%20tension%20fractures%20that%20formed%20by%20differential%20rotation%20of%20target%20rock%20during%20cratering.%20Highly%20variable%20pseudotachylite%20characteristics%20can%20be%20accounted%20for%20by%20a%20single%20process,%20i.e.,%20drainage%20of%20initially%20superheated%20impact%20melt%20into%20tension%20fractures%20of%20the%20crater%20floor.}}

