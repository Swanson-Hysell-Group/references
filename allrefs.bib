@article{Lu2010a,
	author = {Lu, Zunli and Jenkyns, Hugh C. and Rickaby, Rosalind E. M.},
	date = {2010/12/01},
	date-added = {2014-02-06 21:33:56 +0000},
	date-modified = {2014-02-06 21:33:56 +0000},
	journal = {Geology},
	m3 = {10.1130/G31145.1},
	month = {12},
	number = {12},
	pages = {1107--1110},
	title = {Iodine to calcium ratios in marine carbonate as a paleo-redox proxy during oceanic anoxic events},
	ty = {JOUR},
	url = {http://geology.gsapubs.org/content/38/12/1107.abstract N2 - Periods of globally distributed extreme oxygen depletion, so-called oceanic anoxic events (OAEs), have been recognized in the Mesozoic geological record and appear to be characteristic of episodes of extreme warmth. Here we explore the application of iodine/calcium ratios (I/Ca) in marine carbonate as a new geochemical proxy to constrain seawater redox change, and provide additional insights into the response of ocean chemistry to ancient climatic warming. Iodine has long been known as a redox-sensitive and biophilic element, mainly present as iodate and iodide in seawater, iodate converting to iodide under anoxic conditions. Laboratory experiments growing calcite crystals from solutions spiked with iodate show that this is the ionic species incorporated into the carbonate structure, likely substituting for the CO32− ion. A fall in the I/Ca ratio measured in carbonates formed in shallow water by marine calcifiers during the early Toarcian and Cenomanian-Turonian OAEs is interpreted both as a response to a decrease in the iodate/iodide ratio in ocean waters and the drawdown of the global iodine inventory under conditions of accelerated organic-matter burial. The results suggest that I/Ca ratios in carbonates may be used to monitor seawater oxidation levels throughout Earth history.},
	volume = {38},
	year = {2010},
	bdsk-file-1 = {},
	bdsk-file-2 = {},
	bdsk-url-1 = {http://geology.gsapubs.org/content/38/12/1107.abstract%20N2%20-%20Periods%20of%20globally%20distributed%20extreme%20oxygen%20depletion,%20so-called%20oceanic%20anoxic%20events%20(OAEs),%20have%20been%20recognized%20in%20the%20Mesozoic%20geological%20record%20and%20appear%20to%20be%20characteristic%20of%20episodes%20of%20extreme%20warmth.%20Here%20we%20explore%20the%20application%20of%20iodine/calcium%20ratios%20(I/Ca)%20in%20marine%20carbonate%20as%20a%20new%20geochemical%20proxy%20to%20constrain%20seawater%20redox%20change,%20and%20provide%20additional%20insights%20into%20the%20response%20of%20ocean%20chemistry%20to%20ancient%20climatic%20warming.%20Iodine%20has%20long%20been%20known%20as%20a%20redox-sensitive%20and%20biophilic%20element,%20mainly%20present%20as%20iodate%20and%20iodide%20in%20seawater,%20iodate%20converting%20to%20iodide%20under%20anoxic%20conditions.%20Laboratory%20experiments%20growing%20calcite%20crystals%20from%20solutions%20spiked%20with%20iodate%20show%20that%20this%20is%20the%20ionic%20species%20incorporated%20into%20the%20carbonate%20structure,%20likely%20substituting%20for%20the%20CO32%E2%88%92%20ion.%20A%20fall%20in%20the%20I/Ca%20ratio%20measured%20in%20carbonates%20formed%20in%20shallow%20water%20by%20marine%20calcifiers%20during%20the%20early%20Toarcian%20and%20Cenomanian-Turonian%20OAEs%20is%20interpreted%20both%20as%20a%20response%20to%20a%20decrease%20in%20the%20iodate/iodide%20ratio%20in%20ocean%20waters%20and%20the%20drawdown%20of%20the%20global%20iodine%20inventory%20under%20conditions%20of%20accelerated%20organic-matter%20burial.%20The%20results%20suggest%20that%20I/Ca%20ratios%20in%20carbonates%20may%20be%20used%20to%20monitor%20seawater%20oxidation%20levels%20throughout%20Earth%20history.}}

