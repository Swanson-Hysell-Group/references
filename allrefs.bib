	keywords = {Supercraton Superia; Penokean orogeny; Laurentia; aeromagnetic data; gravity data; Tectonics},
	pages = {106205},
	title = {Geophysical insights into Paleoproterozoic tectonics along the southern margin of the Superior Province, central Upper Peninsula, Michigan, USA},
