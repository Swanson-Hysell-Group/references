	doi = {10.1029/2006JB004555},
	isbn = {0148-0227},
	journal = {J. Geophys. Res.},
	keywords = {hematite; magnetic memory; defect moment; 1540 Geomagnetism and Paleomagnetism: Rock and mineral magnetism; 1517 Geomagnetism and Paleomagnetism: Magnetic anomalies: modeling and interpretation; 1527 Geomagnetism and Paleomagnetism: Paleomagnetism applied to geologic processes; 5440 Planetary Sciences: Solid Surface Planets: Magnetic fields and magnetism; 6225 Planetary Sciences: Solar System Objects: Mars},
	number = {B12},
	publisher = {AGU},
	sp = {B12S03},
	title = {Magnetic memory and coupling between spin-canted and defect magnetism in hematite},
	ty = {JOUR},
	volume = {111},
	year = {2006},
