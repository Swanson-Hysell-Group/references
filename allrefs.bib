@article{Smirnov2016a,
	author = {Smirnov, Aleksey V. and Tarduno, John A. and Kulakov, Evgeniy V. and McEnroe, Suzanne A. and Bono, Richard K.},
	date = {2016/03/01},
	date-added = {2016-03-17 06:26:25 +0000},
	date-modified = {2016-03-17 06:26:25 +0000},
	journal = {Geophysical Journal International},
	m3 = {10.1093/gji/ggw080},
	month = {03},
	title = {Paleointensity, core thermal conductivity and the unknown age of the inner core},
	ty = {JOUR},
	url = {http://gji.oxfordjournals.org/content/early/2016/02/29/gji.ggw080.abstract N2 - Data on the evolution of Earth's magnetic field intensity are important for understanding the geodynamo and planetary evolution. However, the paleomagnetic record in rocks may be adversely affected by many physical processes, which must be taken into account when analyzing the paleointensity database. This is especially important in the light of an on-going debate regarding core thermal conductivity values, and how these relate to the Precambrian geodynamo. Here, we demonstrate that several datasets in the Precambrian paleointensity database overestimate the true paleofield strength due to the presence of non-ideal carriers of paleointensity signals and/or viscous re-magnetizations. When the paleointensity overestimates are removed, the Precambrian database does not indicate a robust change in geomagnetic field intensity during the Mesoproterozoic. These findings call into question the recent claim that the solid inner core formed in the Mesoproterozoic, hence constraining the thermal conductivity in the core to “moderate” values. Instead, our analyses indicate that the presently available paleointensity data are insufficient in number and quality to constrain the timing of solid inner core formation, or the outstanding problem of core thermal conductivity. Very young or very old inner core ages (and attendant high or low core thermal conductivity values) are consistent with the presently known history of Earth's field strength. More promising available data sets that reflect long-term core structure are geomagnetic reversal rate and field morphology. The latter suggests changes that may reflect differences in Archean to Proterozoic core stratification, whereas the former suggest an interval of geodynamo hyperactivity at ca. 550 Ma.},
	year = {2016},
	bdsk-file-1 = {},
	bdsk-file-2 = {},
	bdsk-url-1 = {http://gji.oxfordjournals.org/content/early/2016/02/29/gji.ggw080.abstract%20N2%20-%20Data%20on%20the%20evolution%20of%20Earth's%20magnetic%20field%20intensity%20are%20important%20for%20understanding%20the%20geodynamo%20and%20planetary%20evolution.%20However,%20the%20paleomagnetic%20record%20in%20rocks%20may%20be%20adversely%20affected%20by%20many%20physical%20processes,%20which%20must%20be%20taken%20into%20account%20when%20analyzing%20the%20paleointensity%20database.%20This%20is%20especially%20important%20in%20the%20light%20of%20an%20on-going%20debate%20regarding%20core%20thermal%20conductivity%20values,%20and%20how%20these%20relate%20to%20the%20Precambrian%20geodynamo.%20Here,%20we%20demonstrate%20that%20several%20datasets%20in%20the%20Precambrian%20paleointensity%20database%20overestimate%20the%20true%20paleofield%20strength%20due%20to%20the%20presence%20of%20non-ideal%20carriers%20of%20paleointensity%20signals%20and/or%20viscous%20re-magnetizations.%20When%20the%20paleointensity%20overestimates%20are%20removed,%20the%20Precambrian%20database%20does%20not%20indicate%20a%20robust%20change%20in%20geomagnetic%20field%20intensity%20during%20the%20Mesoproterozoic.%20These%20findings%20call%20into%20question%20the%20recent%20claim%20that%20the%20solid%20inner%20core%20formed%20in%20the%20Mesoproterozoic,%20hence%20constraining%20the%20thermal%20conductivity%20in%20the%20core%20to%20%E2%80%9Cmoderate%E2%80%9D%20values.%20Instead,%20our%20analyses%20indicate%20that%20the%20presently%20available%20paleointensity%20data%20are%20insufficient%20in%20number%20and%20quality%20to%20constrain%20the%20timing%20of%20solid%20inner%20core%20formation,%20or%20the%20outstanding%20problem%20of%20core%20thermal%20conductivity.%20Very%20young%20or%20very%20old%20inner%20core%20ages%20(and%20attendant%20high%20or%20low%20core%20thermal%20conductivity%20values)%20are%20consistent%20with%20the%20presently%20known%20history%20of%20Earth's%20field%20strength.%20More%20promising%20available%20data%20sets%20that%20reflect%20long-term%20core%20structure%20are%20geomagnetic%20reversal%20rate%20and%20field%20morphology.%20The%20latter%20suggests%20changes%20that%20may%20reflect%20differences%20in%20Archean%20to%20Proterozoic%20core%20stratification,%20whereas%20the%20former%20suggest%20an%20interval%20of%20geodynamo%20hyperactivity%20at%20ca.%20550%20Ma.}}

