@article{Mills2014a,
	author = {Mills, Benjamin and Lenton, Timothy M. and Watson, Andrew J.},
	date = {2014/06/09},
	date-added = {2014-06-22 19:32:34 +0000},
	date-modified = {2014-06-22 19:32:34 +0000},
	journal = {Proceedings of the National Academy of Sciences},
	m3 = {10.1073/pnas.1321679111},
	month = {06},
	title = {Proterozoic oxygen rise linked to shifting balance between seafloor and terrestrial weathering},
	ty = {JOUR},
	url = {http://www.pnas.org/content/early/2014/06/04/1321679111.abstract N2 - A shift toward higher atmospheric oxygen concentration during the late Proterozoic has been inferred from multiple indirect proxies and is seen by many as a prerequisite for the emergence of complex animal life. However, the mechanisms controlling the level of oxygen throughout the Proterozoic and its eventual rise remain uncertain. Here we use a simple biogeochemical model to show that the balance between long-term carbon removal fluxes via terrestrial silicate weathering and ocean crust alteration plays a key role in determining atmospheric oxygen concentration. This balance may be shifted by changes in terrestrial weatherability or in the generation rate of oceanic crust. As a result, the terrestrial chemical weathering flux may be permanently altered—contrasting with the conventional view that the global silicate weathering flux must adjust to equal the volcanic CO2 degassing flux. Changes in chemical weathering flux in turn alter the long-term supply of phosphorus to the ocean, and therefore the flux of organic carbon burial, which is the long-term source of atmospheric oxygen. Hence we propose that increasing solar luminosity and a decrease in seafloor spreading rate over 1,500–500 Ma drove a gradual shift from seafloor weathering to terrestrial weathering, and a corresponding steady rise in atmospheric oxygen. Furthermore, increased terrestrial weatherability during the late Neoproterozoic may explain low temperature, increases in ocean phosphate, ocean sulfate, and atmospheric oxygen concentration at this time.},
	year = {2014},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://www.pnas.org/content/early/2014/06/04/1321679111.abstract%20N2%20-%20A%20shift%20toward%20higher%20atmospheric%20oxygen%20concentration%20during%20the%20late%20Proterozoic%20has%20been%20inferred%20from%20multiple%20indirect%20proxies%20and%20is%20seen%20by%20many%20as%20a%20prerequisite%20for%20the%20emergence%20of%20complex%20animal%20life.%20However,%20the%20mechanisms%20controlling%20the%20level%20of%20oxygen%20throughout%20the%20Proterozoic%20and%20its%20eventual%20rise%20remain%20uncertain.%20Here%20we%20use%20a%20simple%20biogeochemical%20model%20to%20show%20that%20the%20balance%20between%20long-term%20carbon%20removal%20fluxes%20via%20terrestrial%20silicate%20weathering%20and%20ocean%20crust%20alteration%20plays%20a%20key%20role%20in%20determining%20atmospheric%20oxygen%20concentration.%20This%20balance%20may%20be%20shifted%20by%20changes%20in%20terrestrial%20weatherability%20or%20in%20the%20generation%20rate%20of%20oceanic%20crust.%20As%20a%20result,%20the%20terrestrial%20chemical%20weathering%20flux%20may%20be%20permanently%20altered%E2%80%94contrasting%20with%20the%20conventional%20view%20that%20the%20global%20silicate%20weathering%20flux%20must%20adjust%20to%20equal%20the%20volcanic%20CO2%20degassing%20flux.%20Changes%20in%20chemical%20weathering%20flux%20in%20turn%20alter%20the%20long-term%20supply%20of%20phosphorus%20to%20the%20ocean,%20and%20therefore%20the%20flux%20of%20organic%20carbon%20burial,%20which%20is%20the%20long-term%20source%20of%20atmospheric%20oxygen.%20Hence%20we%20propose%20that%20increasing%20solar%20luminosity%20and%20a%20decrease%20in%20seafloor%20spreading%20rate%20over%201,500%E2%80%93500%20Ma%20drove%20a%20gradual%20shift%20from%20seafloor%20weathering%20to%20terrestrial%20weathering,%20and%20a%20corresponding%20steady%20rise%20in%20atmospheric%20oxygen.%20Furthermore,%20increased%20terrestrial%20weatherability%20during%20the%20late%20Neoproterozoic%20may%20explain%20low%20temperature,%20increases%20in%20ocean%20phosphate,%20ocean%20sulfate,%20and%20atmospheric%20oxygen%20concentration%20at%20this%20time.}}

@article{Strauss2014a,
	author = {Strauss, Justin V. and Rooney, Alan D. and Macdonald, Francis A. and Brandon, Alan D. and Knoll, Andrew H.},
	date = {2014/06/09},
	date-added = {2014-06-22 19:29:59 +0000},
	date-modified = {2014-06-22 19:29:59 +0000},
	journal = {Geology},
	m3 = {10.1130/G35736.1},
	month = {06},
	title = {740 Ma vase-shaped microfossils from Yukon, Canada: Implications for Neoproterozoic chronology and biostratigraphy},
	ty = {JOUR},
	url = {http://geology.gsapubs.org/content/early/2014/06/09/G35736.1.abstract N2 - Biostratigraphy underpins the Phanerozoic time scale, but its application to pre-Ediacaran strata has remained limited because Proterozoic taxa commonly have long or unknown stratigraphic ranges, poorly understood taphonomic constraints, and/or inadequate geochronological context. Here we report the discovery of abundant vase-shaped microfossils from the Callison Lake dolostone of the Coal Creek inlier (Yukon, Canada) that highlight the potential for biostratigraphic correlation of Neoproterozoic successions using species-level assemblage zones of limited duration. The fossiliferous horizon, dated here by Re-Os geochronology at 739.9 ± 6.1 Ma, shares multiple species-level taxa with a well-characterized assemblage from the Chuar Group of the Grand Canyon (Arizona, USA), dated by U-Pb on zircon from an interbedded tuff at 742 ± 6 Ma. The overlapping age and species assemblages from these two deposits suggest biostratigraphic utility, at least within Neoproterozoic basins of Laurentia, and perhaps globally. The new Re-Os age also confirms the timing of the Islay δ13Ccarbonate anomaly in northwestern Canada, which predates the onset of the Sturtian glaciation by >15 m.y. Together these data provide global calibration of sedimentary, paleontological, and geochemical records on the eve of profound environmental and evolutionary change.},
	year = {2014},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://geology.gsapubs.org/content/early/2014/06/09/G35736.1.abstract%20N2%20-%20%20Biostratigraphy%20underpins%20the%20Phanerozoic%20time%20scale,%20but%20its%20application%20to%20pre-Ediacaran%20strata%20has%20remained%20limited%20because%20Proterozoic%20taxa%20commonly%20have%20long%20or%20unknown%20stratigraphic%20ranges,%20poorly%20understood%20taphonomic%20constraints,%20and/or%20inadequate%20geochronological%20context.%20Here%20we%20report%20the%20discovery%20of%20abundant%20vase-shaped%20microfossils%20from%20the%20Callison%20Lake%20dolostone%20of%20the%20Coal%20Creek%20inlier%20(Yukon,%20Canada)%20that%20highlight%20the%20potential%20for%20biostratigraphic%20correlation%20of%20Neoproterozoic%20successions%20using%20species-level%20assemblage%20zones%20of%20limited%20duration.%20The%20fossiliferous%20horizon,%20dated%20here%20by%20Re-Os%20geochronology%20at%20739.9%20%C2%B1%206.1%20Ma,%20shares%20multiple%20species-level%20taxa%20with%20a%20well-characterized%20assemblage%20from%20the%20Chuar%20Group%20of%20the%20Grand%20Canyon%20(Arizona,%20USA),%20dated%20by%20U-Pb%20on%20zircon%20from%20an%20interbedded%20tuff%20at%20742%20%C2%B1%206%20Ma.%20The%20overlapping%20age%20and%20species%20assemblages%20from%20these%20two%20deposits%20suggest%20biostratigraphic%20utility,%20at%20least%20within%20Neoproterozoic%20basins%20of%20Laurentia,%20and%20perhaps%20globally.%20The%20new%20Re-Os%20age%20also%20confirms%20the%20timing%20of%20the%20Islay%20%CE%B413Ccarbonate%20anomaly%20in%20northwestern%20Canada,%20which%20predates%20the%20onset%20of%20the%20Sturtian%20glaciation%20by%20%3E15%20m.y.%20Together%20these%20data%20provide%20global%20calibration%20of%20sedimentary,%20paleontological,%20and%20geochemical%20records%20on%20the%20eve%20of%20profound%20environmental%20and%20evolutionary%20change.}}

