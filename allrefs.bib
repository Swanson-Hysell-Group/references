@article{Blattler2012a,
	author = {Bl{\"a}ttler, Clara L. and Henderson, Gideon M. and Jenkyns, Hugh C.},
	date = {2012/07/12},
	date-added = {2013-11-20 00:28:40 +0000},
	date-modified = {2013-11-20 00:28:40 +0000},
	journal = {Geology},
	m3 = {10.1130/G33191.1},
	month = {07},
	title = {Explaining the Phanerozoic Ca isotope history of seawater},
	ty = {JOUR},
	url = {http://geology.gsapubs.org/content/early/2012/06/21/G33191.1.abstract N2 - A new geochemical budget for the modern marine carbonate sink helps to explain the major features of the Phanerozoic Ca isotope record. A large compilation of Ca isotope ratios for modern carbonates, incorporating more than 50 new measurements, represents the quantitatively important components of the system. With this data set, distinct Ca isotope ratios are identified for different types of marine carbonate, the balance of which has changed over time with shifts between calcite and aragonite seas and with the development of pelagic calcification during the Mesozoic. It is suggested that large-scale changes in the Ca isotope ratio of seawater, as exemplified by that in the Carboniferous, were no longer possible after Jurassic time because of the generation of a deep-sea calcite sink expressed by deposition of foraminiferal–coccolith ooze across the world ocean. This work demonstrates the close connection between isotopic cycling, carbonate sedimentation, seawater chemistry, and evolutionary trends.},
	year = {2012},
	bdsk-file-1 = {},
	bdsk-file-2 = {},
	bdsk-url-1 = {http://geology.gsapubs.org/content/early/2012/06/21/G33191.1.abstract%20N2%20-%20A%20new%20geochemical%20budget%20for%20the%20modern%20marine%20carbonate%20sink%20helps%20to%20explain%20the%20major%20features%20of%20the%20Phanerozoic%20Ca%20isotope%20record.%20A%20large%20compilation%20of%20Ca%20isotope%20ratios%20for%20modern%20carbonates,%20incorporating%20more%20than%2050%20new%20measurements,%20represents%20the%20quantitatively%20important%20components%20of%20the%20system.%20With%20this%20data%20set,%20distinct%20Ca%20isotope%20ratios%20are%20identified%20for%20different%20types%20of%20marine%20carbonate,%20the%20balance%20of%20which%20has%20changed%20over%20time%20with%20shifts%20between%20calcite%20and%20aragonite%20seas%20and%20with%20the%20development%20of%20pelagic%20calcification%20during%20the%20Mesozoic.%20It%20is%20suggested%20that%20large-scale%20changes%20in%20the%20Ca%20isotope%20ratio%20of%20seawater,%20as%20exemplified%20by%20that%20in%20the%20Carboniferous,%20were%20no%20longer%20possible%20after%20Jurassic%20time%20because%20of%20the%20generation%20of%20a%20deep-sea%20calcite%20sink%20expressed%20by%20deposition%20of%20foraminiferal%E2%80%93coccolith%20ooze%20across%20the%20world%20ocean.%20This%20work%20demonstrates%20the%20close%20connection%20between%20isotopic%20cycling,%20carbonate%20sedimentation,%20seawater%20chemistry,%20and%20evolutionary%20trends.}}

