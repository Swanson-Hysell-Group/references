@article{Ugalde2005a,
	annote = {10.1130/0-8137-2384-1.25},
	author = {Ugalde, H. A. and Artemieva, N. and Milkereit, B.},
	date = {2005/01/01},
	date-added = {2012-11-19 15:21:57 +0000},
	date-modified = {2012-11-19 15:21:57 +0000},
	journal = {Geological Society of America Special Papers},
	journal1 = {Geological Society of America Special Papers},
	month = {01},
	pages = {25--42},
	title = {Magnetization on impact structures---Constraints from numerical modeling and petrophysics},
	ty = {JOUR},
	url = {http://specialpapers.gsapubs.org/content/384/25.abstract N2 - Prominent magnetic anomalies over large impact craters are attributed to remanent magnetization as thermal effects induce extremely high Koenigsberger values (remanent to induced magnetization ratio, Q). Magnetization of impact melt rocks, breccias, and the rocks underneath the crater floor is related to the thermal evolution of large impact craters, from a single heat pulse to long-lived hydrothermal processes and associated alteration and mineral deposits. The magnetic signature observed on large impact structures can be primarily the aggregate of three effects: (1) composition and properties of target rocks, (2) modification of magnetic carriers due to high pressure-temperature (P-T) conditions, and (3) natural remanent magnetization (NRM). Numerical modeling is used to predict the pressure and temperature distribution for varying size craters ranging from a 1.5-km-diameter simple crater to a 90-km-diameter complex crater. We first compare the results of two hydrocodes: the Simplified Arbitrary Lagrangian Eulerian code, version B (SALEB), to produce the final crater shape after a vertical impact; and the Solid, Vapor, Air (SOVA) code to model the initial stage of an oblique impact and to evaluate differences in the volumes of highly shocked materials within the crater created by a vertical impact versus an oblique one. After defining the accuracy of the numerical modeling and reliability of the resulting P-T conditions predicted, numerical modeling is applied for 1–90 km diameter impact structures. The P-T distributions of the target material at its final position obtained with the SALEB code are used for geophysical predictions. The calculated maximum P-T values and their initial and final spatial distributions can be linked with geological and physical and/or chemical processes that lead to different geophysical signatures. For a 5 km diameter crater, brecciation (P > 1 GPa) affects all material in a 2.5 km hemisphere. Brecciation and fluid circulation trigger a hydrothermal system, which introduces chemical remanent magnetization (CRM) and modify magnetic carriers due to alteration. Pressures larger than 30 GPa induce a secondary component of remanent magnetization (shock remanent magnetization, SRM). These P-T conditions are generally restricted to a radius of <0.5 km and depth <0.8 km. Therefore, SRM and melting are confined to small regions, occasionally not even discernible by a regional airborne magnetic survey, and easily removed by erosive processes.},
	volume = {384},
	year = {2005},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://specialpapers.gsapubs.org/content/384/25.abstract%20N2%20-%20Prominent%20magnetic%20anomalies%20over%20large%20impact%20craters%20are%20attributed%20to%20remanent%20magnetization%20as%20thermal%20effects%20induce%20extremely%20high%20Koenigsberger%20values%20(remanent%20to%20induced%20magnetization%20ratio,%20Q).%20Magnetization%20of%20impact%20melt%20rocks,%20breccias,%20and%20the%20rocks%20underneath%20the%20crater%20floor%20is%20related%20to%20the%20thermal%20evolution%20of%20large%20impact%20craters,%20from%20a%20single%20heat%20pulse%20to%20long-lived%20hydrothermal%20processes%20and%20associated%20alteration%20and%20mineral%20deposits.%20The%20magnetic%20signature%20observed%20on%20large%20impact%20structures%20can%20be%20primarily%20the%20aggregate%20of%20three%20effects:%20(1)%20composition%20and%20properties%20of%20target%20rocks,%20(2)%20modification%20of%20magnetic%20carriers%20due%20to%20high%20pressure-temperature%20(P-T)%20conditions,%20and%20(3)%20natural%20remanent%20magnetization%20(NRM).%20Numerical%20modeling%20is%20used%20to%20predict%20the%20pressure%20and%20temperature%20distribution%20for%20varying%20size%20craters%20ranging%20from%20a%201.5-km-diameter%20simple%20crater%20to%20a%2090-km-diameter%20complex%20crater.%20We%20first%20compare%20the%20results%20of%20two%20hydrocodes:%20the%20Simplified%20Arbitrary%20Lagrangian%20Eulerian%20code,%20version%20B%20(SALEB),%20to%20produce%20the%20final%20crater%20shape%20after%20a%20vertical%20impact;%20and%20the%20Solid,%20Vapor,%20Air%20(SOVA)%20code%20to%20model%20the%20initial%20stage%20of%20an%20oblique%20impact%20and%20to%20evaluate%20differences%20in%20the%20volumes%20of%20highly%20shocked%20materials%20within%20the%20crater%20created%20by%20a%20vertical%20impact%20versus%20an%20oblique%20one.%20After%20defining%20the%20accuracy%20of%20the%20numerical%20modeling%20and%20reliability%20of%20the%20resulting%20P-T%20conditions%20predicted,%20numerical%20modeling%20is%20applied%20for%201%E2%80%9390%20km%20diameter%20impact%20structures.%20The%20P-T%20distributions%20of%20the%20target%20material%20at%20its%20final%20position%20obtained%20with%20the%20SALEB%20code%20are%20used%20for%20geophysical%20predictions.%20The%20calculated%20maximum%20P-T%20values%20and%20their%20initial%20and%20final%20spatial%20distributions%20can%20be%20linked%20with%20geological%20and%20physical%20and/or%20chemical%20processes%20that%20lead%20to%20different%20geophysical%20signatures.%20For%20a%205%20km%20diameter%20crater,%20brecciation%20(P%20%3E%201%20GPa)%20affects%20all%20material%20in%20a%202.5%20km%20hemisphere.%20Brecciation%20and%20fluid%20circulation%20trigger%20a%20hydrothermal%20system,%20which%20introduces%20chemical%20remanent%20magnetization%20(CRM)%20and%20modify%20magnetic%20carriers%20due%20to%20alteration.%20Pressures%20larger%20than%2030%20GPa%20induce%20a%20secondary%20component%20of%20remanent%20magnetization%20(shock%20remanent%20magnetization,%20SRM).%20These%20P-T%20conditions%20are%20generally%20restricted%20to%20a%20radius%20of%20%3C0.5%20km%20and%20depth%20%3C0.8%20km.%20Therefore,%20SRM%20and%20melting%20are%20confined%20to%20small%20regions,%20occasionally%20not%20even%20discernible%20by%20a%20regional%20airborne%20magnetic%20survey,%20and%20easily%20removed%20by%20erosive%20processes.}}

@article{Milkereit2010a,
	annote = {10.1130/2010.2465(08)},
	author = {Milkereit, B. and Artemieva, N. and Ugalde, H.},
	date = {2010/09/01},
	date-added = {2012-11-19 15:15:34 +0000},
	date-modified = {2012-11-19 15:15:34 +0000},
	journal = {Geological Society of America Special Papers},
	journal1 = {Geological Society of America Special Papers},
	month = {09},
	pages = {115--131},
	title = {Fracturing, thermal evolution and geophysical signature of the crater floor of a large impact structure: The case of the Sudbury Structure, Canada},
	ty = {JOUR},
	url = {http://specialpapers.gsapubs.org/content/465/115.abstract N2 - Impact modeling and post-impact cooling studies predict a unique fracture and post-impact temperature distribution within the crater floor of large meteorite impact structures. The integration of numerical modeling results and their application to the observed geophysical and current topographic data provides new insights into the early evolution of the deeply eroded Sudbury Structure. The modeling shows a maximum depth of melting of 30–40 km (depending on impact angle and impact velocity). However, melt from upper target layers (< 10 km) is mainly ejected during the excavation stage of crater formation, and the remaining melt is strongly biased to melt derived from lower crustal material. Two-dimensional thermal evolution modeling with various granophyre/norite thickness ratios shows that irrespective of the granophyre/norite thickness ratio, the hottest part of the Sudbury Igneous Complex (SIC) was near the crater center at the melt-pool bottom and within the crater floor, which supports precipitation of sulfides toward the crater floor. The 2D cooling models give compelling evidence for longevity of melt at the bottom of the SIC and partial remelting of the crater floor. The numerical model results are compared with observed topographic, seismic and magnetic data and provide important constraints on their interpretation. A unique slow cooling history is manifested in the broad magnetic signature of the SIC and the adjacent crater floor, and its pronounced remanent magnetization. The vast damage zone and the complex fracture pattern predicted for the crater floor is well preserved in the new high-resolution topographic data for the Sudbury Structure. These regional topographic data allow the distinction between inside-basin fabric (radial topographic lineaments) and crater-floor topographic fabric (radial and contact parallel lineaments), which corroborates the numerical modeling results of radial and concentric faults propagating up to tens of kilometers from the crater center.},
	volume = {465},
	year = {2010},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://specialpapers.gsapubs.org/content/465/115.abstract%20N2%20-%20Impact%20modeling%20and%20post-impact%20cooling%20studies%20predict%20a%20unique%20fracture%20and%20post-impact%20temperature%20distribution%20within%20the%20crater%20floor%20of%20large%20meteorite%20impact%20structures.%20The%20integration%20of%20numerical%20modeling%20results%20and%20their%20application%20to%20the%20observed%20geophysical%20and%20current%20topographic%20data%20provides%20new%20insights%20into%20the%20early%20evolution%20of%20the%20deeply%20eroded%20Sudbury%20Structure.%20The%20modeling%20shows%20a%20maximum%20depth%20of%20melting%20of%2030%E2%80%9340%20km%20(depending%20on%20impact%20angle%20and%20impact%20velocity).%20However,%20melt%20from%20upper%20target%20layers%20(%3C%2010%20km)%20is%20mainly%20ejected%20during%20the%20excavation%20stage%20of%20crater%20formation,%20and%20the%20remaining%20melt%20is%20strongly%20biased%20to%20melt%20derived%20from%20lower%20crustal%20material.%20Two-dimensional%20thermal%20evolution%20modeling%20with%20various%20granophyre/norite%20thickness%20ratios%20shows%20that%20irrespective%20of%20the%20granophyre/norite%20thickness%20ratio,%20the%20hottest%20part%20of%20the%20Sudbury%20Igneous%20Complex%20(SIC)%20was%20near%20the%20crater%20center%20at%20the%20melt-pool%20bottom%20and%20within%20the%20crater%20floor,%20which%20supports%20precipitation%20of%20sulfides%20toward%20the%20crater%20floor.%20The%202D%20cooling%20models%20give%20compelling%20evidence%20for%20longevity%20of%20melt%20at%20the%20bottom%20of%20the%20SIC%20and%20partial%20remelting%20of%20the%20crater%20floor.%20The%20numerical%20model%20results%20are%20compared%20with%20observed%20topographic,%20seismic%20and%20magnetic%20data%20and%20provide%20important%20constraints%20on%20their%20interpretation.%20A%20unique%20slow%20cooling%20history%20is%20manifested%20in%20the%20broad%20magnetic%20signature%20of%20the%20SIC%20and%20the%20adjacent%20crater%20floor,%20and%20its%20pronounced%20remanent%20magnetization.%20The%20vast%20damage%20zone%20and%20the%20complex%20fracture%20pattern%20predicted%20for%20the%20crater%20floor%20is%20well%20preserved%20in%20the%20new%20high-resolution%20topographic%20data%20for%20the%20Sudbury%20Structure.%20These%20regional%20topographic%20data%20allow%20the%20distinction%20between%20inside-basin%20fabric%20(radial%20topographic%20lineaments)%20and%20crater-floor%20topographic%20fabric%20(radial%20and%20contact%20parallel%20lineaments),%20which%20corroborates%20the%20numerical%20modeling%20results%20of%20radial%20and%20concentric%20faults%20propagating%20up%20to%20tens%20of%20kilometers%20from%20the%20crater%20center.}}

