@article{Mac-Niocaill1994a,
	annote = {10.1111/j.1365-246X.1994.tb03292.x},
	author = {Mac Niocaill, Conall and Smethurst, Mark A.},
	date = {1994/03/01},
	date-added = {2017-01-19 17:30:42 +0000},
	date-modified = {2017-01-19 17:30:42 +0000},
	journal = {Geophysical Journal International},
	journal1 = {Geophysical Journal International},
	month = {03},
	number = {3},
	pages = {715--725},
	title = {Palaeozoic palaeogeography of Laurentia and its margins: a reassessment of palaeomagnetic data},
	ty = {JOUR},
	url = {http://gji.oxfordjournals.org/content/116/3/715.abstract N2 - The recognition of wide-spread remagnetization events during the Palaeozoic has greatly added to the problems of reconstructing the Palaeozoic drift history of Laurentia and in recent years increasing emphasis has been placed on evaluating the relative reliability of palaeomagnetic data, in an attempt to overcome some of these difficulties. In the light of these developments a revised apparent polar wander (APW) path has been constructed following a rigorous evaluation of all published Palaeozoic palaeomagnetic data from Laurentia and its Palaeozoic margins (i.e. North America, northern Britain, Northern Ireland and Greenland). The use of data from the Laurentian margins, when corrected for the opening of the North Atlantic, has resulted in a revision of previously published Palaeozoic palaeogeographic reconstructions and these new palaeogeographic reconstructions for Laurentia are in good agreement with faunal and lithological data. A comparison of this new APW path with other APW paths from Avalonia and Baltica reveals a very close agreement between all three paths from mid-Silurian times onwards, indicating that the closure of the Iapetus ocean and the Tornquist sea was essentially complete by this time.Laurentia occupied equatorial latitudes from Cambrian to early Silurian times and its drift history was dominated by anti-clockwise rotation (up to 0.7°Ma−1) and low latitudinal drift rates (up to 3 cm yr−1). Late Silurian and early Devonian times were characterized by increased rates of anti-clockwise rotation (up to 1.3°Ma−1) and southerly directed latitudinal drift (rates up to 13 cm yr−1) of the continent, which place Laurentia in moderate southerly latitudes (30–40°S) by the early Devonian. These palaeolatitudes are comparable with those from Avalonia and Baltica for this time indicating that the amalgamation of Eurmerica had already taken place. By late Devonian time Laurentia had begun to drift north (rates up to 5 cm yr−1) towards equatorial latitudes by mid-Carboniferous time.},
	volume = {116},
	year = {1994},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://gji.oxfordjournals.org/content/116/3/715.abstract%20N2%20-%20The%20recognition%20of%20wide-spread%20remagnetization%20events%20during%20the%20Palaeozoic%20has%20greatly%20added%20to%20the%20problems%20of%20reconstructing%20the%20Palaeozoic%20drift%20history%20of%20Laurentia%20and%20in%20recent%20years%20increasing%20emphasis%20has%20been%20placed%20on%20evaluating%20the%20relative%20reliability%20of%20palaeomagnetic%20data,%20in%20an%20attempt%20to%20overcome%20some%20of%20these%20difficulties.%20In%20the%20light%20of%20these%20developments%20a%20revised%20apparent%20polar%20wander%20(APW)%20path%20has%20been%20constructed%20following%20a%20rigorous%20evaluation%20of%20all%20published%20Palaeozoic%20palaeomagnetic%20data%20from%20Laurentia%20and%20its%20Palaeozoic%20margins%20(i.e.%20North%20America,%20northern%20Britain,%20Northern%20Ireland%20and%20Greenland).%20The%20use%20of%20data%20from%20the%20Laurentian%20margins,%20when%20corrected%20for%20the%20opening%20of%20the%20North%20Atlantic,%20has%20resulted%20in%20a%20revision%20of%20previously%20published%20Palaeozoic%20palaeogeographic%20reconstructions%20and%20these%20new%20palaeogeographic%20reconstructions%20for%20Laurentia%20are%20in%20good%20agreement%20with%20faunal%20and%20lithological%20data.%20A%20comparison%20of%20this%20new%20APW%20path%20with%20other%20APW%20paths%20from%20Avalonia%20and%20Baltica%20reveals%20a%20very%20close%20agreement%20between%20all%20three%20paths%20from%20mid-Silurian%20times%20onwards,%20indicating%20that%20the%20closure%20of%20the%20Iapetus%20ocean%20and%20the%20Tornquist%20sea%20was%20essentially%20complete%20by%20this%20time.Laurentia%20occupied%20equatorial%20latitudes%20from%20Cambrian%20to%20early%20Silurian%20times%20and%20its%20drift%20history%20was%20dominated%20by%20anti-clockwise%20rotation%20(up%20to%200.7%C2%B0Ma%E2%88%921)%20and%20low%20latitudinal%20drift%20rates%20(up%20to%203%20cm%20yr%E2%88%921).%20Late%20Silurian%20and%20early%20Devonian%20times%20were%20characterized%20by%20increased%20rates%20of%20anti-clockwise%20rotation%20(up%20to%201.3%C2%B0Ma%E2%88%921)%20and%20southerly%20directed%20latitudinal%20drift%20(rates%20up%20to%2013%20cm%20yr%E2%88%921)%20of%20the%20continent,%20which%20place%20Laurentia%20in%20moderate%20southerly%20latitudes%20(30%E2%80%9340%C2%B0S)%20by%20the%20early%20Devonian.%20These%20palaeolatitudes%20are%20comparable%20with%20those%20from%20Avalonia%20and%20Baltica%20for%20this%20time%20indicating%20that%20the%20amalgamation%20of%20Eurmerica%20had%20already%20taken%20place.%20By%20late%20Devonian%20time%20Laurentia%20had%20begun%20to%20drift%20north%20(rates%20up%20to%205%20cm%20yr%E2%88%921)%20towards%20equatorial%20latitudes%20by%20mid-Carboniferous%20time.}}

