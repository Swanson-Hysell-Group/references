@article{Jacobs2004a,
	annote = {10.1130/G20516.1},
	author = {Jacobs, Joachim and Thomas, Robert J.},
	date-added = {2015-04-07 01:01:29 +0000},
	date-modified = {2015-04-08 03:45:48 +0000},
	journal = {Geology},
	journal1 = {Geology},
	number = {8},
	pages = {721--724},
	title = {Himalayan-type indenter-escape tectonics model for the southern part of the late {Neoproterozoic--early Paleozoic East African--Antarctic orogen}},
	ty = {JOUR},
	url = {http://geology.gsapubs.org/content/32/8/721.abstract N2 - The East African–Antarctic orogen is one of the largest orogenic belts on the planet. It resulted from the collision of various parts of proto–East and West Gondwana during late Neoproterozoic–early Paleozoic time (between 650 and 500 Ma). We propose that the southern part of this Himalayan-type orogen can be interpreted in terms of a lateral-escape tectonic model. Modern Gondwana reconstructions show that the southern part of the East African– Antarctic orogen can best be reassembled when a number of microplates (the Falkland, Ellsworth-Haag, and Filchner blocks) are positioned between southern Africa and East Antarctica. This microplate assemblage is unusual. The microplates probably represent shear-zone–bounded blocks, produced by tectonic translation during lateral escape, similar to those currently evolving in Southeast Asia. One of the escape-related shear zones is exposed as the 20-km-wide Heimefront transpression zone in western Dronning Maud Land. Coats Land, a crustal block within the orogen, probably represents a block of older crust that was not subjected to tectonometamorphic reworking ca. 500 Ma by lateral tectonic escape. The southern part of the orogen is also typified by very large volumes of late-tectonic A2-type granitoids, intruded ca. 530–490 Ma, probably as a consequence of delamination of the orogenic root and the subsequent influx of hot asthenospheric mantle during tectonic escape. Erosional unroofing of the orogen is documented by the remnants of originally massive areas covered by Cambrian– Ordovician molasse-type sedimentary rocks throughout Africa, Arabia, and Antarctica, testifying to the past extent and size of this largest of orogens.},
	volume = {32},
	year = {2004},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://geology.gsapubs.org/content/32/8/721.abstract%20N2%20-%20The%20East%20African%E2%80%93Antarctic%20orogen%20is%20one%20of%20the%20largest%20orogenic%20belts%20on%20the%20planet.%20It%20resulted%20from%20the%20collision%20of%20various%20parts%20of%20proto%E2%80%93East%20and%20West%20Gondwana%20during%20late%20Neoproterozoic%E2%80%93early%20Paleozoic%20time%20(between%20650%20and%20500%20Ma).%20We%20propose%20that%20the%20southern%20part%20of%20this%20Himalayan-type%20orogen%20can%20be%20interpreted%20in%20terms%20of%20a%20lateral-escape%20tectonic%20model.%20Modern%20Gondwana%20reconstructions%20show%20that%20the%20southern%20part%20of%20the%20East%20African%E2%80%93%20Antarctic%20orogen%20can%20best%20be%20reassembled%20when%20a%20number%20of%20microplates%20(the%20Falkland,%20Ellsworth-Haag,%20and%20Filchner%20blocks)%20are%20positioned%20between%20southern%20Africa%20and%20East%20Antarctica.%20This%20microplate%20assemblage%20is%20unusual.%20The%20microplates%20probably%20represent%20shear-zone%E2%80%93bounded%20blocks,%20produced%20by%20tectonic%20translation%20during%20lateral%20escape,%20similar%20to%20those%20currently%20evolving%20in%20Southeast%20Asia.%20One%20of%20the%20escape-related%20shear%20zones%20is%20exposed%20as%20the%2020-km-wide%20Heimefront%20transpression%20zone%20in%20western%20Dronning%20Maud%20Land.%20Coats%20Land,%20a%20crustal%20block%20within%20the%20orogen,%20probably%20represents%20a%20block%20of%20older%20crust%20that%20was%20not%20subjected%20to%20tectonometamorphic%20reworking%20ca.%20500%20Ma%20by%20lateral%20tectonic%20escape.%20The%20southern%20part%20of%20the%20orogen%20is%20also%20typified%20by%20very%20large%20volumes%20of%20late-tectonic%20A2-type%20granitoids,%20intruded%20ca.%20530%E2%80%93490%20Ma,%20probably%20as%20a%20consequence%20of%20delamination%20of%20the%20orogenic%20root%20and%20the%20subsequent%20influx%20of%20hot%20asthenospheric%20mantle%20during%20tectonic%20escape.%20Erosional%20unroofing%20of%20the%20orogen%20is%20documented%20by%20the%20remnants%20of%20originally%20massive%20areas%20covered%20by%20Cambrian%E2%80%93%20Ordovician%20molasse-type%20sedimentary%20rocks%20throughout%20Africa,%20Arabia,%20and%20Antarctica,%20testifying%20to%20the%20past%20extent%20and%20size%20of%20this%20largest%20of%20orogens.}}

@article{Vandamme1994a,
	abstract = {This study is based on synthetic virtual geomagnetic pole distributions simulated by the sum of a Fisherian distribution characteristic of paleosecular variation (PSV) and a uniform distribution representing transitional data resulting from reversals and excursions of the geomagnetic field. Using such simulations, the optimum cutoff angle to apply to estimate the most precise value of the angular standard deviation (ASD) characteristic of PSV is determined for variable ASD and random data percentage. A relation between this optimum cutoff angle (A) and the expected ASD is deduced: A($\,^{\circ}$) = 1.8ASD($\,^{\circ}$) + 5$\,^{\circ}$. A recursive method for determining the characteristic ASD using this relation is proposed. It is compared with the classical selection method using a constant cutoff angle equal to 40$\,^{\circ}$. The method proposed in the present paper gives much more regular results and especially corrects bias on low and high ASD values obtained with the classical method. The proposed method should be important for PSV modeling because the lowest and highest ASD are the most constraining. The relation cited above could also be used in magnetostratigraphy to limit the domain of transitional geomagnetic poles.},
	author = {Vandamme, D.},
	booktitle = {Special Issue Detailed Records of the Paleomagnetic Field},
	date = {1994/8//},
	date-added = {2015-04-06 17:00:57 +0000},
	date-modified = {2015-04-06 17:00:57 +0000},
	doi = {http://dx.doi.org/10.1016/0031-9201(94)90012-4},
	isbn = {0031-9201},
	journal = {Physics of the Earth and Planetary Interiors},
	month = {8},
	number = {1--2},
	pages = {131--142},
	title = {A new method to determine paleosecular variation},
	ty = {JOUR},
	url = {http://www.sciencedirect.com/science/article/pii/0031920194900124},
	volume = {85},
	year = {1994},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://www.sciencedirect.com/science/article/pii/0031920194900124},
