	bdsk-file-1 = {},
	bdsk-url-1 = {http://mem.lyellcollection.org/content/36/1/331.abstract%20N2%20-%20The%20Tsagaan%20Oloom%20Formation%20(Fm.)%20in%20southwestern%20Mongolia%20contains%20two%20Neoproterozoic%20glacial%20deposits,%20with%20diamictite%20in%20the%20Maikhan%20Ul%20Member%20(Mb.)%20and%20in%20the%20Khongoryn%20Mb.,%20which%20are%20separated%20by%20over%20500%20m%20of%20limestone.%20The%20Maikhan%20Ul%20Mb.%20ranges%20in%20thickness%20between%205%20m%20and%20greater%20than%20300%20m,%20expanding%20in%20deeper-water%20sections%20towards%20the%20SW,%20where%20it%20is%20composed%20of%20two%20massive%20diamictites%20separated%20by%20over%20100%20m%20of%20sandstone,%20siltstone%20and%20shale.%20The%20basal%2010%20m%20of%20the%20overlying%20Tayshir%20Mb.%20of%20the%20Tsagaan%20Oloom%20Fm.%20consists%20of%20a%20fine-laminated,%20dark%20grey%20limestone.%20The%20Khongoryn%20Mb.%20is%20composed%20primarily%20of%20limestone%20clasts%20in%20a%20shale%20matrix,%20and%20is%20between%200%20and%2023%20m%20thick.%20The%20overlying%20Ol%20Mb.%20contains%20sedimentary%20structures%20characteristic%20of%20basal%20Ediacaran%20cap%20carbonates%20including%20micropeloids,%20tubestone%20stromatolites,%20giant%20wave%20ripples%20and%20former%20aragonite%20crystal%20fans.%20U%E2%80%93Pb%20evaporation%20ages%20from%20zircons%20in%20the%20underlying%20Dzabkhan%20Volcanics%20constrain%20the%20Tsagaan%20Oloom%20Fm.%20to%20%3C773%20Ma,%20and%20tuffs%20within%20the%20Maikhan%20Ul%20and%20Tayshir%20members%20testify%20to%20the%20potential%20for%20additional%20geochronology.%20The%20Cryogenian%20organic-rich%20limestone%20of%20the%20Tayshir%20Mb.,%20which%20lies%20between%20the%20two%20glacial%20deposits,%20is%20ideally%20suited%20for%20geochemical%20studies%20and%20has%20been%20the%20subject%20of%20several%20carbon,%20strontium%20and%20rare%20earth%20element%20investigations.%20Limited%20palaeomagnetic%20studies%20suggest%20a%20mid-%20to%20low-latitude%20position%20of%20the%20Dzabkhan%20platform%20during%20deposition%20of%20the%20glaciogenic%20strata,%20and%20additional%20studies%20are%20in%20progress.}}

