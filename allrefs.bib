@article{De-Waele2003a,
	annote = {10.1130/0091-7613(2003)031<0509:UTKKAR>2.0.CO;2},
	author = {De Waele, Bert and Wingate, Michael T. D. and Fitzsimons, Ian C. W. and Mapani, Benjamin S. E.},
	date-added = {2016-04-20 16:40:29 +0000},
	date-modified = {2016-04-20 16:40:29 +0000},
	journal = {Geology},
	journal1 = {Geology},
	number = {6},
	pages = {509--512},
	title = {Untying the Kibaran knot: A reassessment of Mesoproterozoic correlations in southern Africa based on SHRIMP U-Pb data from the Irumide belt},
	ty = {JOUR},
	url = {http://geology.gsapubs.org/content/31/6/509.abstract N2 - The Irumide belt is part of a network of late Mesoproterozoic Kibaran-age orogens in south-central Africa. Sensitive high-resolution ion microprobe (SHRIMP) U-Pb zircon ages for gneisses, migmatites, and granitoids indicate that peak Irumide metamorphism was ca. 1020 Ma and that this was associated with widespread granitic magmatism at 1050–950 Ma. Pre-Irumide protoliths are dominated by 1650–1519 Ma granitic gneisses. These data provide the first robust constraint on the timing of Irumide tectonism and show that previous estimates of ca. 1350 and 1100 Ma are incorrect, thereby negating previously proposed correlations of the Irumide belt with nearby Kibaran-aged tectonism. The correlation between the Irumide belt and Choma-Kalomo block of southern Zambia has had a major influence on models for the tectonic assembly of southern Africa because it required that the intervening Neoproterozoic Zambezi belt was intracratonic and associated with minimal horizontal displacements. Our data indicate that both terranes have distinct histories, consistent with lithologic and metamorphic evidence of Neoproterozoic ocean closure along the Zambezi belt. This implies that the Kalahari and Congo cratons assembled during the Neoproterozoic and not during Kibaran-age tectonism, as previously believed. This new outlook on regional African tectonics supports a configuration of the Rodinia supercontinent that places the Congo craton well away from the Kalahari craton ca. 1000 Ma.},
	volume = {31},
	year = {June, 2003},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://geology.gsapubs.org/content/31/6/509.abstract%20N2%20-%20The%20Irumide%20belt%20is%20part%20of%20a%20network%20of%20late%20Mesoproterozoic%20Kibaran-age%20orogens%20in%20south-central%20Africa.%20Sensitive%20high-resolution%20ion%20microprobe%20(SHRIMP)%20U-Pb%20zircon%20ages%20for%20gneisses,%20migmatites,%20and%20granitoids%20indicate%20that%20peak%20Irumide%20metamorphism%20was%20ca.%201020%20Ma%20and%20that%20this%20was%20associated%20with%20widespread%20granitic%20magmatism%20at%201050%E2%80%93950%20Ma.%20Pre-Irumide%20protoliths%20are%20dominated%20by%201650%E2%80%931519%20Ma%20granitic%20gneisses.%20These%20data%20provide%20the%20first%20robust%20constraint%20on%20the%20timing%20of%20Irumide%20tectonism%20and%20show%20that%20previous%20estimates%20of%20ca.%201350%20and%201100%20Ma%20are%20incorrect,%20thereby%20negating%20previously%20proposed%20correlations%20of%20the%20Irumide%20belt%20with%20nearby%20Kibaran-aged%20tectonism.%20The%20correlation%20between%20the%20Irumide%20belt%20and%20Choma-Kalomo%20block%20of%20southern%20Zambia%20has%20had%20a%20major%20influence%20on%20models%20for%20the%20tectonic%20assembly%20of%20southern%20Africa%20because%20it%20required%20that%20the%20intervening%20Neoproterozoic%20Zambezi%20belt%20was%20intracratonic%20and%20associated%20with%20minimal%20horizontal%20displacements.%20Our%20data%20indicate%20that%20both%20terranes%20have%20distinct%20histories,%20consistent%20with%20lithologic%20and%20metamorphic%20evidence%20of%20Neoproterozoic%20ocean%20closure%20along%20the%20Zambezi%20belt.%20This%20implies%20that%20the%20Kalahari%20and%20Congo%20cratons%20assembled%20during%20the%20Neoproterozoic%20and%20not%20during%20Kibaran-age%20tectonism,%20as%20previously%20believed.%20This%20new%20outlook%20on%20regional%20African%20tectonics%20supports%20a%20configuration%20of%20the%20Rodinia%20supercontinent%20that%20places%20the%20Congo%20craton%20well%20away%20from%20the%20Kalahari%20craton%20ca.%201000%20Ma.}}

@article{Evans2015a,
	abstract = {Moderate to high palaeolatitudes recorded in mafic dykes, exposed along the coast of Bahia, Brazil, are partly responsible for some interpretations that the S{\~a}o Francisco/Congo craton was separate from the low-latitude Rodinia supercontinent at about 1050 Ma. We report new palaeomagnetic data that replicate the previous results. However, we obtain substantially younger U--Pb baddeleyite ages from five dykes previously thought to be 1.02--1.01 Ga according to the 40Ar/39Ar method. Specifically, the so-called `A-normal' remanence direction from Salvador is dated at 924.2$\pm$3.8 Ma, within error of the age for the `C' remanence direction at 921.5$\pm$4.3 Ma. An `A-normal' dyke at Ilh{\'e}us is dated at 926.1$\pm$4.6 Ma, and two `A-normal' dykes at Oliven{\c c}a have indistinguishable ages with best estimate of emplacement at 918.2$\pm$6.7 Ma. We attribute the palaeomagnetic variance of the `A-normal' and `C' directions to lack of averaging of geomagnetic palaeosecular variation in some regions. Our results render previous 40Ar/39Ar ages from the dykes suspect, leaving late Mesoproterozoic palaeolatitudes of the S{\~a}o Francisco/Congo craton unconstrained. The combined `A-normal' palaeomagnetic pole from coastal Bahia places the S{\~a}o Francisco/Congo craton in moderate to high palaeolatitudes at c. 920 Ma, allowing various possible positions of that block within Rodinia.},
	annote = {10.1144/SP424.1},
	author = {Evans, D. A. D. and Trindade, R. I. F. and Catelani, E. L. and D'Agrella-Filho, M. S. and Heaman, L. M. and Oliveira, E. P. and S{\"o}derlund, U. and Ernst, R. E. and Smirnov, A. V. and Salminen, J. M.},
	date = {2015/05/28},
	date-added = {2016-04-20 16:29:04 +0000},
	date-modified = {2016-05-21 02:11:39 +0000},
	doi = {10.1144/SP424.1},
	journal = {Geological Society, London, Special Publications},
	journal1 = {Geological Society, London, Special Publications},
	month = {05},
	title = {{Return to Rodinia? Moderate to high palaeolatitude of the S{\~a}o Francisco/Congo craton at 920 Ma}},
	ty = {JOUR},
	url = {http://sp.lyellcollection.org/content/early/2015/05/28/SP424.1.abstract},
	volume = {424},
	year = {2015},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://sp.lyellcollection.org/content/early/2015/05/28/SP424.1.abstract%20N2%20-%20Moderate%20to%20high%20palaeolatitudes%20recorded%20in%20mafic%20dykes,%20exposed%20along%20the%20coast%20of%20Bahia,%20Brazil,%20are%20partly%20responsible%20for%20some%20interpretations%20that%20the%20S%C3%A3o%20Francisco/Congo%20craton%20was%20separate%20from%20the%20low-latitude%20Rodinia%20supercontinent%20at%20about%201050%20Ma.%20We%20report%20new%20palaeomagnetic%20data%20that%20replicate%20the%20previous%20results.%20However,%20we%20obtain%20substantially%20younger%20U%E2%80%93Pb%20baddeleyite%20ages%20from%20five%20dykes%20previously%20thought%20to%20be%201.02%E2%80%931.01%20Ga%20according%20to%20the%2040Ar/39Ar%20method.%20Specifically,%20the%20so-called%20%E2%80%98A-normal%E2%80%99%20remanence%20direction%20from%20Salvador%20is%20dated%20at%20924.2%C2%B13.8%20Ma,%20within%20error%20of%20the%20age%20for%20the%20%E2%80%98C%E2%80%99%20remanence%20direction%20at%20921.5%C2%B14.3%20Ma.%20An%20%E2%80%98A-normal%E2%80%99%20dyke%20at%20Ilh%C3%A9us%20is%20dated%20at%20926.1%C2%B14.6%20Ma,%20and%20two%20%E2%80%98A-normal%E2%80%99%20dykes%20at%20Oliven%C3%A7a%20have%20indistinguishable%20ages%20with%20best%20estimate%20of%20emplacement%20at%20918.2%C2%B16.7%20Ma.%20We%20attribute%20the%20palaeomagnetic%20variance%20of%20the%20%E2%80%98A-normal%E2%80%99%20and%20%E2%80%98C%E2%80%99%20directions%20to%20lack%20of%20averaging%20of%20geomagnetic%20palaeosecular%20variation%20in%20some%20regions.%20Our%20results%20render%20previous%2040Ar/39Ar%20ages%20from%20the%20dykes%20suspect,%20leaving%20late%20Mesoproterozoic%20palaeolatitudes%20of%20the%20S%C3%A3o%20Francisco/Congo%20craton%20unconstrained.%20The%20combined%20%E2%80%98A-normal%E2%80%99%20palaeomagnetic%20pole%20from%20coastal%20Bahia%20places%20the%20S%C3%A3o%20Francisco/Congo%20craton%20in%20moderate%20to%20high%20palaeolatitudes%20at%20c.%20920%20Ma,%20allowing%20various%20possible%20positions%20of%20that%20block%20within%20Rodinia.}}

