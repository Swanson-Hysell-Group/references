	journal = {Geophys. Res. Lett.},
	keywords = {1525 Geomagnetism and Paleomagnetism: Paleomagnetism applied to tectonics (regional, global); 1527 Geomagnetism and Paleomagnetism: Paleomagnetism applied to geologic processes; 1540 Geomagnetism and Paleomagnetism: Rock and mineral magnetism; 1594 Geomagnetism and Paleomagnetism: Instruments and techniques},
	month = {06},
	number = {11},
