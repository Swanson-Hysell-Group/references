	issn = {0016-7649},
	journal = {Journal of the Geological Society},
	number = {2},
	pages = {133--144},
	publisher = {Geological Society of London},
	title = {{Palaeomagnetic data and radiometric ages from the Cretaceous of West Kalimantan (Borneo), and their significance in interpreting regional structure}},
	url = {http://jgs.lyellcollection.org/content/133/2/133},
	volume = {133},
	year = {1977},
