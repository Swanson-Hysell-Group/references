	keywords = {Delta 13 C; F-F event; atmospheric CO 2 level; south China; 0428 Biogeosciences: Carbon cycling (4806); 0429 Biogeosciences: Climate dynamics (1620); 0473 Biogeosciences: Paleoclimatology and paleoceanography (3344, 4900)},
	month = {03},
	number = {G1},
	pages = {G01032},
	publisher = {AGU},
	title = {Carbon isotopic evidence for the associations of decreasing atmospheric CO2 level with the Frasnian-Famennian mass extinction},
