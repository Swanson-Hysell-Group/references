@article{Hayes2006b,
	abstract = {The fossilized remains of Cretaceous angiosperm leaves are preserved within sandstones and siltstones of the Coniacian Hidden Lake Formation (Gustav Group) and the Santonian-early Campanian Santa Marta Formation (Marambio Group) in the James Ross Basin, Antarctic Peninsula region. The leaves represent the remains of vegetation that grew at approximately 65{\{}degrees{\}}S on an emergent volcanic arc, now represented by the Antarctic Peninsula, and were subsequently transported and buried in marine sediments in the adjacent back-arc basin. Some of the angiosperm leaf morphotypes show similarities to leaves of living families such as Sterculiaceae, Lauraceae, Winteraceae, Cunoniaceae and Myrtaceae. Palaeoclimate analysis based on physiognomic aspects of the leaves, such as leaf-margin analysis, indicates that the mean annual temperatures for the Hidden Lake and Santa Marta formations were 13-21 {\{}degrees{\}}C (mean 17 {\{}degrees{\}}C) and 15-23 {\{}degrees{\}}C (mean 19 {\{}degrees{\}}C), respectively. The fossil plants are indicative of warm climates without extended periods of winter temperatures below freezing and with adequate moisture for growth. This period of Cretaceous warmth in Antarctica corresponds with the Cretaceous thermal maximum, an interval of peak global warmth from the Turonian to the early Campanian. },
	annote = {10.1144/GSL.SP.2006.258.01.04},
	author = {Hayes, Peta A. and Francis, Jane E. and Cantrill, David J. and Crame, J. Alistair},
