	bdsk-url-1 = {http://geology.gsapubs.org/content/26/7/603.abstract%20N2%20-%20Paleomagnetic,%20rock%20magnetic,%20and%20geochemical%20results%20from%20Mesozoic%20carbonates%20in%20the%20Vocontian%20trough%20in%20southeast%20France%20support%20a%20hypothesized%20acquisition%20of%20a%20chemical%20remanent%20magnetization%20(CRM)%20during%20burial%20diagenesis%20of%20smectite%20and%20are%20inconsistent%20with%20an%20orogenic%20fluid%20remagnetization%20mechanism.%20The%20geographic%20and%20vertical%20distribution%20of%20a%20widespread%20CRM,%20which%20resides%20in%20magnetite,%20is%20parallel%20to%20the%20degree%20of%20burial%20diagenesis%20of%20clays.%20The%20CRM%20is%20absent%20only%20where%20there%20is%20no%20evidence%20for%20clay%20diagenesis.%20The%20CRM%20is%20poorly%20developed%20where%20significant%20smectite%20is%20still%20present%20and%20is%20well%20developed%20with%20higher%20natural%20and%20anhysteretic%20remanent%20intensities%20where%20smectite%20has%20completely%20altered%20to%20illite.%20Strontium%20isotope%20results%20do%20not%20support%20alteration%20by%20orogenic-type%20fluids,%20a%20commonly%20invoked%20mechanism%20for%20similar%20CRMs.%20The%20results%20suggest%20that%20the%20burial%20diagenesis%20of%20clays%20is%20a%20viable%20remagnetization%20mechanism%20for%20limestones%20in%20the%20Vocontian%20trough.}}

