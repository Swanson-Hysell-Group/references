	bdsk-file-1 = {},
	bdsk-file-2 = {},
	bdsk-url-1 = {http://www.sciencemag.org/content/339/6119/540.abstract%20N2%20-%20We%20present%20a%20framework%20for%20interpreting%20the%20carbon%20isotopic%20composition%20of%20sedimentary%20rocks,%20which%20in%20turn%20requires%20a%20fundamental%20reinterpretation%20of%20the%20carbon%20cycle%20and%20redox%20budgets%20over%20Earth's%20history.%20We%20propose%20that%20authigenic%20carbonate,%20produced%20in%20sediment%20pore%20fluids%20during%20early%20diagenesis,%20has%20played%20a%20major%20role%20in%20the%20carbon%20cycle%20in%20the%20past.%20This%20sink%20constitutes%20a%20minor%20component%20of%20the%20carbon%20isotope%20mass%20balance%20under%20the%20modern,%20high%20levels%20of%20atmospheric%20oxygen%20but%20was%20much%20larger%20in%20times%20of%20low%20atmospheric%20O2%20or%20widespread%20marine%20anoxia.%20Waxing%20and%20waning%20of%20a%20global%20authigenic%20carbonate%20sink%20helps%20to%20explain%20extreme%20carbon%20isotope%20variations%20in%20the%20Proterozoic,%20Paleozoic,%20and%20Triassic.}}

@article{Jin2013a,
	annote = {10.1130/G33688.1},
	author = {Jin, Jisuo and Harper, David A. T. and Cocks, L. Robin M. and McCausland, Phil J. A. and Rasmussen, Christian M. {\O}. and Sheehan, Peter M.},
	date = {2013/02/01},
	date-added = {2013-02-06 11:16:15 +0000},
	date-modified = {2013-02-06 11:16:15 +0000},
	journal = {Geology},
	journal1 = {Geology},
	month = {02},
	number = {2},
	pages = {107--110},
	title = {Precisely locating the Ordovician equator in Laurentia},
	ty = {JOUR},
	url = {http://geology.gsapubs.org/content/41/2/107.abstract N2 - The Late Ordovician equatorial zone, like the zone today, had few hurricane-grade storms within 10° of the equator, as emphasized by the preservation of massive-bedded Thalassinoides ichnofacies in a trans-Laurentian belt more than 6000 km long, from the southwestern United States to North Greenland. That belt also includes nonamalgamated shell beds dominated by the brachiopod Proconchidium, which would not have been preserved after hurricane-grade storms. The belt lacks such storm-related sedimentary features as rip-up clasts, hummocky cross-stratification, or large channels. In contrast, other contemporaneous Laurentian Thalassinoides facies and shell beds on either side of the belt have been disturbed by severe storms below fair-weather wave base. The position of the biofacies-defined equatorial belt coincides with the Late Ordovician equator deduced from paleomagnetic data from Laurentia, thus providing both a high-precision equatorial location and an independent test of the geocentric axial dipole hypothesis for that time.},
	volume = {41},
	year = {2013},
	bdsk-file-1 = {},
	bdsk-file-2 = {},
	bdsk-url-1 = {http://geology.gsapubs.org/content/41/2/107.abstract%20N2%20-%20The%20Late%20Ordovician%20equatorial%20zone,%20like%20the%20zone%20today,%20had%20few%20hurricane-grade%20storms%20within%2010%C2%B0%20of%20the%20equator,%20as%20emphasized%20by%20the%20preservation%20of%20massive-bedded%20Thalassinoides%20ichnofacies%20in%20a%20trans-Laurentian%20belt%20more%20than%206000%20km%20long,%20from%20the%20southwestern%20United%20States%20to%20North%20Greenland.%20That%20belt%20also%20includes%20nonamalgamated%20shell%20beds%20dominated%20by%20the%20brachiopod%20Proconchidium,%20which%20would%20not%20have%20been%20preserved%20after%20hurricane-grade%20storms.%20The%20belt%20lacks%20such%20storm-related%20sedimentary%20features%20as%20rip-up%20clasts,%20hummocky%20cross-stratification,%20or%20large%20channels.%20In%20contrast,%20other%20contemporaneous%20Laurentian%20Thalassinoides%20facies%20and%20shell%20beds%20on%20either%20side%20of%20the%20belt%20have%20been%20disturbed%20by%20severe%20storms%20below%20fair-weather%20wave%20base.%20The%20position%20of%20the%20biofacies-defined%20equatorial%20belt%20coincides%20with%20the%20Late%20Ordovician%20equator%20deduced%20from%20paleomagnetic%20data%20from%20Laurentia,%20thus%20providing%20both%20a%20high-precision%20equatorial%20location%20and%20an%20independent%20test%20of%20the%20geocentric%20axial%20dipole%20hypothesis%20for%20that%20time.}}

