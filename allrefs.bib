	journal = {Geological Society of America Bulletin},
	journal1 = {Geological Society of America Bulletin},
	month = {02},
	number = {2},
	pages = {159--202},
	title = {DIFFERENTIATION IN LAVAS OF THE {K}EWEENAWAN SERIES AND THE ORIGIN OF THE COPPER DEPOSITS OF {M}ICHIGAN},
	ty = {JOUR},
	volume = {62},
	year = {1951},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://gsabulletin.gsapubs.org/content/62/2/159.abstract%20N2%20-%20Five%20lava%20flows%20in%20the%20Keweenawan%20series%20of%20the%20Michigan%20copper%20district%20have%20been%20studied%20and%20chemical%20analyses%20made,%20with%20special%20attention%20to:%20(1)%20chemical%20and%20mineralogic%20variations%20within%20the%20upper,%20pegmatitic%20portions%20of%20the%20flows;%20(2)%20processes%20of%20differentiation;%20(3)%20comparison%20of%20the%20types%20of%20rocks%20found%20within%20a%20single%20flow%20with%20the%20types%20of%20flows%20that%20make%20up%20the%20lava%20series;%20(4)%20the%20relation%20of%20differentiation%20in%20the%20flows%20to%20the%20origin%20of%20the%20copper%20deposits.The%20primary%20factors%20in%20the%20differentiation%20of%20the%20flows%20were%20probably:%20(1)%20cooling%20at%20a%20moderate%20rate,%20and%20predominantly%20from%20the%20top;%20(2)%20crystal%20sorting%20by%20differential%20settling;%20(3)%20migration%20and%20local%20concentration%20of%20volatiles;%20(4)%20periodic%20convective%20overturn%20of%20the%20magma.%20Convection%20currents%20probably%20were%20not%20active%20in%20the%20thinner%20flows%20and%20may%20not%20have%20been%20in%20the%20thicker.%20Alternate%20hypotheses%20have%20been%20presented,%20one%20assuming%20that%20convective%20overturn%20was%20important,%20the%20other%20that%20it%20was%20not.All%20types%20of%20flows%20in%20the%20series%20can%20be%20approximated%20by%20differentiation%20products%20of%20the%20Greenstone%20flow,%20indicating%20that%20all%20the%20flows%20could%20have%20been%20differentiated%20from%20a%20magma%20similar%20to,%20but%20perhaps%20slightly%20more%20mafic%20than,%20that%20of%20the%20Greenstone%20flow.In%20considering%20the%20origin%20of%20the%20copper%20deposits,%20the%20writer%20has%20briefly%20reviewed%20the%20literature%20and%20presented%20new%20evidence.%20The%20following%20modes%20or%20origin%20of%20the%20deposits%20appear%20still%20open%20to%20consideration:%20(1)%20The%20deposits%20are%20epigenetic,%20and%20formed%20by%20deposition%20from%20hot%20solutions%20ascending%20from%20an%20underlying%20intrusive.%20(2)%20The%20deposits%20are%20the%20result%20of%20a%20combination%20of%20syngenetic%20and%20epigenetic%20processes.%20Primary%20concentrations%20of%20copper%20in%20fumaroles,%20thermal%20springs,%20or%20playa%20lakes%20were%20reworked%20by%20later,%20ascending%20igneous%20emanations.%20(3)%20The%20amygdaloidal%20deposits%20are%20primarily%20syngenetic%20and%20have%20been%20only%20moderately%20modified%20by%20the%20action%20of%20later%20ascending%20solutions.}}

