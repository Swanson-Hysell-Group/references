@article{Chave2015a,
	annote = {10.1093/gji/ggv324},
	author = {Chave, Alan D.},
	date = {2015/11/01},
	date-added = {2015-09-25 19:14:31 +0000},
	date-modified = {2015-09-25 19:14:31 +0000},
	journal = {Geophysical Journal International},
	journal1 = {Geophysical Journal International},
	month = {11},
	number = {2},
	pages = {893--895},
	title = {A note about Gaussian statistics on a sphere},
	ty = {JOUR},
	url = {http://gji.oxfordjournals.org/content/203/2/893.abstract N2 - The statistics of directional data on a sphere can be modelled either using the Fisher distribution that is conditioned on the magnitude being unity, in which case the sample space is confined to the unit sphere, or using the latitude–longitude marginal distribution derived from a trivariate Gaussian model that places no constraint on the magnitude. These two distributions are derived from first principles and compared. The Fisher distribution more closely approximates the uniform distribution on a sphere for a given small value of the concentration parameter, while the latitude–longitude marginal distribution is always slightly larger than the Fisher distribution at small off-axis angles for large values of the concentration parameter. Asymptotic analysis shows that the two distributions only become equivalent in the limit of large concentration parameter and very small off-axis angle.},
	volume = {203},
	year = {2015},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://gji.oxfordjournals.org/content/203/2/893.abstract%20N2%20-%20The%20statistics%20of%20directional%20data%20on%20a%20sphere%20can%20be%20modelled%20either%20using%20the%20Fisher%20distribution%20that%20is%20conditioned%20on%20the%20magnitude%20being%20unity,%20in%20which%20case%20the%20sample%20space%20is%20confined%20to%20the%20unit%20sphere,%20or%20using%20the%20latitude%E2%80%93longitude%20marginal%20distribution%20derived%20from%20a%20trivariate%20Gaussian%20model%20that%20places%20no%20constraint%20on%20the%20magnitude.%20These%20two%20distributions%20are%20derived%20from%20first%20principles%20and%20compared.%20The%20Fisher%20distribution%20more%20closely%20approximates%20the%20uniform%20distribution%20on%20a%20sphere%20for%20a%20given%20small%20value%20of%20the%20concentration%20parameter,%20while%20the%20latitude%E2%80%93longitude%20marginal%20distribution%20is%20always%20slightly%20larger%20than%20the%20Fisher%20distribution%20at%20small%20off-axis%20angles%20for%20large%20values%20of%20the%20concentration%20parameter.%20Asymptotic%20analysis%20shows%20that%20the%20two%20distributions%20only%20become%20equivalent%20in%20the%20limit%20of%20large%20concentration%20parameter%20and%20very%20small%20off-axis%20angle.}}

