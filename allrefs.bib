	author = {Maloof, Adam C. and Porter, Susannah M. and Moore, John L. and Dud{\'a}s, Frank {\"O}. and Bowring, Samuel A. and Higgins, John A. and Fike, David A. and Eddy, Michael P.},
	date = {2010/11/01},
	date-added = {2010-11-08 12:29:35 -0500},
	date-modified = {2011-02-02 09:42:43 -0500},
	journal = {Geological Society of America Bulletin},
	journal1 = {Geological Society of America Bulletin},
	month = {11},
	number = {11-12},
	pages = {1731--1774},
	title = {The earliest {C}ambrian record of animals and ocean geochemical change},
	ty = {JOUR},
	volume = {122},
	year = {2010},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://gsabulletin.gsapubs.org/content/122/11-12/1731.abstract%20N2%20-%20The%20Cambrian%20diversification%20of%20animals%20was%20long%20thought%20to%20have%20begun%20with%20an%20explosive%20phase%20at%20the%20start%20of%20the%20Tommotian%20Age.%20Recent%20stratigraphic%20discoveries,%20however,%20suggest%20that%20many%20taxa%20appeared%20in%20the%20older%20Nemakit-Daldynian%20Age,%20and%20that%20the%20diversification%20was%20more%20gradual.%20We%20map%20lowest%20Cambrian%20(Nemakit-Daldynian%20through%20Tommotian)%20records%20of%20%CE%B413CCaCO3%20variability%20from%20Siberia,%20Mongolia,%20and%20China%20onto%20a%20Moroccan%20U/Pb%E2%80%93%CE%B413CCaCO3%20age%20model%20constrained%20by%20five%20U/Pb%20ages%20from%20interbedded%20volcanic%20ashes.%20The%20%CE%B413CCaCO3%20correlations%20ignore%20fossil%20tie%20points,%20so%20we%20assume%20synchroneity%20in%20%CE%B413C%20trends%20rather%20than%20synchroneity%20in%20first%20appearances%20of%20animal%20taxa.%20We%20present%20new%20%CE%B413Corg,%2087Sr/86Sr,%20uranium,%20and%20vanadium%20data%20from%20the%20same%20carbonate%20samples%20that%20define%20the%20Moroccan%20%CE%B413CCaCO3%20curve.%20The%20result%20is%20a%20new%20absolute%20time%20line%20for%20first%20appearances%20of%20skeletal%20animals%20and%20for%20changes%20in%20the%20carbon,%20strontium,%20and%20redox%20chemistry%20of%20the%20ocean%20during%20the%20Nemakit-Daldynian%20and%20Tommotian%20ages%20at%20the%20beginning%20of%20the%20Cambrian.%20The%20time%20line%20suggests%20that%20the%20diversification%20of%20skeletal%20animals%20began%20early%20in%20the%20Nemakit-Daldynian,%20with%20much%20of%20the%20diversity%20appearing%20by%20the%20middle%20of%20the%20age.%20Fossil%20first%20appearances%20occurred%20in%20three%20pulses,%20with%20a%20small%20pulse%20in%20the%20earliest%20Nemakit-Daldynian%20(ca.%20540%E2%80%93538%20Ma),%20a%20larger%20pulse%20in%20the%20mid-%20to%20late%20Nemakit-Daldynian%20(ca.%20534%E2%80%93530%20Ma),%20and%20a%20moderate%20pulse%20in%20the%20Tommotian%20(ca.%20524%E2%80%93522%20Ma).%20These%20pulses%20are%20associated%20with%20rapid%20reorganizations%20of%20the%20carbon%20cycle,%20and%20are%20superimposed%20on%20long-term%20increases%20in%20sea%20level%20and%20the%20hydrothermal%20flux%20of%20Sr.}}

