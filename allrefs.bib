@article{Taylor2011a,
	annote = {10.1130/B30138.1},
	author = {Taylor, Joshua P. and Fitzgerald, Paul G.},
	date = {2011/03/01},
	date-added = {2011-01-28 13:48:57 -0500},
	date-modified = {2011-02-02 09:42:43 -0500},
	journal = {Geological Society of America Bulletin},
	journal1 = {Geological Society of America Bulletin},
	month = {03},
	number = {3-4},
	pages = {412--426},
	title = {Low-temperature thermal history and landscape development of the eastern Adirondack Mountains, New York: Constraints from apatite fission-track thermochronology and apatite (U-Th)/He dating},
	ty = {JOUR},
	volume = {123},
	year = {2011},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://gsabulletin.gsapubs.org/content/123/3-4/412.abstract%20N2%20-%20The%20Adirondack%20Mountains%20in%20northern%20New%20York%20State%20form%20an%20elongate,%20domal%20exposure%20of%20mainly%20high-grade%20metamorphic%20tectonites%20in%20a%20mountainous%20setting%20with%20topographic%20relief%20of%20%E2%88%BC1%20km.%20The%20origin%20of%20the%20Adirondack%20Mountains%20and%20this%20relief%20has%20long%20been%20enigmatic,%20since%20the%20Adirondacks%20presently%20lie%20within%20an%20intracratonic%20setting,%20inboard%20of%20the%20North%20American%20passive%20margin%20and%20far%20from%20any%20active%20plate%20boundaries.%20Through%20the%20application%20of%20apatite%20fission-track%20(AFT)%20thermochronology%20and%20apatite%20(U-Th)/He%20(AHe)%20dating%20within%20the%20eastern%20Adirondack%20Mountains,%20this%20study%20provides%20constraints%20on%20both%20the%20thermal%20and%20erosional%20effects%20of%20Mesozoic%20passage%20near%20a%20hotspot%20and%20the%20timing%20of%20relief%20development.AFT%20thermochronology%20and%20AHe%20dating%20record%20relatively%20stable%20thermal%20conditions%20within%20the%20eastern%20Adirondacks%20from%20the%20Middle%20Jurassic%20into%20the%20Early%20Cretaceous.%20During%20the%20Early%20Cretaceous%20(ca.%20130%E2%80%93120%20Ma),%20the%20region%20underwent%20heating%20associated%20with%20progressive%20movement%20near%20the%20Great%20Meteor%20hotspot,%20resulting%20in%20the%20temporary%20establishment%20of%20an%20elevated%20geothermal%20gradient.%20Following%20regional%20heating,%20cooling%20rates%20increased%20considerably%20(ca.%20105%E2%80%9395%20Ma),%20likely%20due%20to%20both%20thermal%20doming,%20producing%20an%20increase%20in%20erosion%20rate,%20and%20the%20relaxation%20of%20isotherms%20after%20passage%20near%20the%20hotspot.The%20regional%20distribution%20of%20AFT%20ages%20across%20the%20eastern%20Adirondacks%20reveals%20no%20systematic%20age%20gradient%20from%20core%20to%20periphery,%20which%20would%20be%20expected%20under%20conditions%20of%20persistent%20high%20relief%20during%20the%20decay%20of%20a%20crustal%20root%20over%20many%20tens%20to%20hundreds%20of%20millions%20of%20years.%20Instead,%20thermochronological%20data%20suggest%20that%20the%20present%20relief%20developed%20during%20the%20Late%20Cretaceous%E2%80%93Cenozoic%20through%20plateau%20dissection%20during%20periodic%20base-level%20changes.}}

@article{Cooper2011a,
	annote = {10.1130/B30237.1},
	author = {Cooper, Alan F. and Maas, Roland and Scott, James M. and Barber, Anton J. W.},
	date = {2011/03/01},
	date-added = {2011-01-28 13:47:07 -0500},
	date-modified = {2011-02-02 09:42:43 -0500},
