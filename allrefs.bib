@article{Smith2015a,
	author = {Smith, Emily F. and Macdonald, Francis A. and Petach, Tanya A. and Bold, Uyanga and Schrag, Daniel P.},
	date = {2015/09/02},
	date-added = {2015-11-23 17:15:25 +0000},
	date-modified = {2015-11-23 17:15:25 +0000},
	journal = {Geological Society of America Bulletin},
	m3 = {10.1130/B31248.1},
	month = {09},
	title = {Integrated stratigraphic, geochemical, and paleontological late Ediacaran to early Cambrian records from southwestern Mongolia},
	ty = {JOUR},
	url = {http://gsabulletin.gsapubs.org/content/early/2015/09/02/B31248.1.abstract N2 - The Zavkhan terrane in western Mongolia preserves thick, fossiliferous, carbonate-rich strata that span the Ediacaran-Cambrian transition. Measured stratigraphic sections and geological mapping of these strata, which include the Zuun-Arts, Bayangol, Salaagol, and Khairkhan Formations, reveal large lateral facies changes over short distances that necessitate revisions to previous lithostratigraphic correlations and biostratigraphic range charts. Here, we integrate new geological mapping and measured stratigraphic sections across the Zavkhan terrane with high-resolution carbon isotope (δ13C) chemostratigraphy, sequence stratigraphy, and biostratigraphy. Using these data, we revise correlations within the Zavkhan terrane and place small shelly fossil and ichnofossil horizons in a refined temporal and spatial framework. Finally, we integrate these data from Mongolia with absolute ages and chemostratigraphy from sections in Morocco and Oman. Our revised age model suggests that deposition of the Bayangol Formation and the lower part of the Salaagol Formation was limited to the Nemakit-Daldynian and Tommotian Stages.With the new correlations and age model, we place the small shelly fossil first appearance datum in the basal Bayangol Formation instead of the basal Zuun-Arts Formation, which moves this horizon hundreds of meters higher in the stratigraphy, above the large negative excursion in the Zuun-Arts Formation. The first appearance datum of Treptichnus pedum is ~275 m above the large negative excursion in the Zuun-Arts Formation and ~250 m above the first appearance datum of small shelly fossils, highlighting the rarity and facies dependence of its preservation.We shift the first appearance datums of tommotiids, orthothecimorphs, hyolithelminths, cap-shaped fossils, protoconodonts, and Salanacus to just below the positive peak 3p. This interpretation differs from previous chronostratigraphic placements of first appearance data of genera between positive excursions 1p and 2p. Using this level as the first appearance datum in Mongolia for these genera, we replot global fossil first appearances. With this new compilation, there are still three distinct pulses of fossil first appearances, as was suggested in previous compilations; however, we suggest that this pattern is controlled largely by regional sedimentation and taphonomy rather than the rate of taxonomic origination.},
	year = {2015},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://gsabulletin.gsapubs.org/content/early/2015/09/02/B31248.1.abstract%20N2%20-%20The%20Zavkhan%20terrane%20in%20western%20Mongolia%20preserves%20thick,%20fossiliferous,%20carbonate-rich%20strata%20that%20span%20the%20Ediacaran-Cambrian%20transition.%20Measured%20stratigraphic%20sections%20and%20geological%20mapping%20of%20these%20strata,%20which%20include%20the%20Zuun-Arts,%20Bayangol,%20Salaagol,%20and%20Khairkhan%20Formations,%20reveal%20large%20lateral%20facies%20changes%20over%20short%20distances%20that%20necessitate%20revisions%20to%20previous%20lithostratigraphic%20correlations%20and%20biostratigraphic%20range%20charts.%20Here,%20we%20integrate%20new%20geological%20mapping%20and%20measured%20stratigraphic%20sections%20across%20the%20Zavkhan%20terrane%20with%20high-resolution%20carbon%20isotope%20(%CE%B413C)%20chemostratigraphy,%20sequence%20stratigraphy,%20and%20biostratigraphy.%20Using%20these%20data,%20we%20revise%20correlations%20within%20the%20Zavkhan%20terrane%20and%20place%20small%20shelly%20fossil%20and%20ichnofossil%20horizons%20in%20a%20refined%20temporal%20and%20spatial%20framework.%20Finally,%20we%20integrate%20these%20data%20from%20Mongolia%20with%20absolute%20ages%20and%20chemostratigraphy%20from%20sections%20in%20Morocco%20and%20Oman.%20Our%20revised%20age%20model%20suggests%20that%20deposition%20of%20the%20Bayangol%20Formation%20and%20the%20lower%20part%20of%20the%20Salaagol%20Formation%20was%20limited%20to%20the%20Nemakit-Daldynian%20and%20Tommotian%20Stages.With%20the%20new%20correlations%20and%20age%20model,%20we%20place%20the%20small%20shelly%20fossil%20first%20appearance%20datum%20in%20the%20basal%20Bayangol%20Formation%20instead%20of%20the%20basal%20Zuun-Arts%20Formation,%20which%20moves%20this%20horizon%20hundreds%20of%20meters%20higher%20in%20the%20stratigraphy,%20above%20the%20large%20negative%20excursion%20in%20the%20Zuun-Arts%20Formation.%20The%20first%20appearance%20datum%20of%20Treptichnus%20pedum%20is%20~275%20m%20above%20the%20large%20negative%20excursion%20in%20the%20Zuun-Arts%20Formation%20and%20~250%20m%20above%20the%20first%20appearance%20datum%20of%20small%20shelly%20fossils,%20highlighting%20the%20rarity%20and%20facies%20dependence%20of%20its%20preservation.We%20shift%20the%20first%20appearance%20datums%20of%20tommotiids,%20orthothecimorphs,%20hyolithelminths,%20cap-shaped%20fossils,%20protoconodonts,%20and%20Salanacus%20to%20just%20below%20the%20positive%20peak%203p.%20This%20interpretation%20differs%20from%20previous%20chronostratigraphic%20placements%20of%20first%20appearance%20data%20of%20genera%20between%20positive%20excursions%201p%20and%202p.%20Using%20this%20level%20as%20the%20first%20appearance%20datum%20in%20Mongolia%20for%20these%20genera,%20we%20replot%20global%20fossil%20first%20appearances.%20With%20this%20new%20compilation,%20there%20are%20still%20three%20distinct%20pulses%20of%20fossil%20first%20appearances,%20as%20was%20suggested%20in%20previous%20compilations;%20however,%20we%20suggest%20that%20this%20pattern%20is%20controlled%20largely%20by%20regional%20sedimentation%20and%20taphonomy%20rather%20than%20the%20rate%20of%20taxonomic%20origination.%20}}

