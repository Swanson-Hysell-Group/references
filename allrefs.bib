@article{AGUE1988a,
	author = {AGUE, JAY J. and BRIMHALL, GEORGE H.},
	date = {1988/06/01},
	date-added = {2013-10-23 02:42:59 +0000},
	date-modified = {2013-10-23 02:42:59 +0000},
	journal = {Geological Society of America Bulletin},
	m3 = {10.1130/0016-7606(1988)100<0912:MAAADO>2.3.CO;2},
	month = {06},
	number = {6},
	pages = {912--927},
	title = {Magmatic arc asymmetry and distribution of anomalous plutonic belts in the batholiths of California: Effects of assimilation, crustal thickness, and depth of crystallization},
	ty = {JOUR},
	url = {http://gsabulletin.gsapubs.org/content/100/6/912.abstract N2 - In order to better understand geologic fac-tors controlling pronounced regional variations in whole-rock chemistry, mineralogy, and mineral chemistry in the batholiths of California, we calculate the magmatic intensive variables fHF/fH2O, fHF/fHCl, and fO2.Regional-scale west-to-east increases in F/OH in mafic silicates, corresponding to the systematic I-WC to I-MC and I-SC progression, reflect orders-of-magnitude increase in fHF/fH2O attending pluton crystallization. Low fHF/ fH2Oof formation of western I-WC types is consistent with their derivation from low-fluorine source rocks in subducted oceanic slabs or the upper mantle. In contrast,higher fHF/fH2Oof crystallization of I-MC and I-SC types to the east implies the involvement of (1) progressively greater amounts of continental crustal source material such as biotite-bearing metamorphic rocks, their unweathered sedimentary derivatives retaining F-rich mafic minerals, or their fusion products and/or (2) source materials which become more F-rich toward the continental interior. The regional distribution of I-MC and I-SC types suggests that the Precambrian craton of western North America, or derivative sediments, may extend farther north in California and be morphologically more complex than previously thought. From seemingly out-of- place occurrences of I-WC plutons on the eastern slopes of the Sierra Nevada batholith, we infer the existence of regions where Precambrian basement was thin or absent in Mesozoic time, which prevented extensive cratonal contamination of subducted slab or upper mantle-derived magmas.New methods for estimating T-fO2 relations in the magmas demonstrate that I-SCR granites crystallize at oxygen fugacities as much as five orders of magnitude lower than those of I-WC, I-MC, and I-SC types under conditions at or below the maximum stability limit of graphite in equilibrium with a C-O-H-S gas phase. The local-scale formation of I-SCR granites in plutonic belts within specific wall-rock terranes containing highly reducing sediments or metasediments may occur by contamination of I-types with graphitic pelite or, in some cases, by the direct fusion of this reducing pelitic wall rock. The spatial distribution of I-SCR granite provinces therefore is controlled simply by wall-rock lithology.Amphibole geobarometry demonstrates a general west-to-east decrease in crystallization pressure across the Sierra Nevada batholith. In contrast, the Peninsular Ranges batholith displays a west-to-east crystallization pressure increase. The bulk of the California batholiths crystallized at pressures less than 4-5 kb and depths less than about 15-19 km. In the southern Sierra Nevada batholith, the San Gabriels, and the eastern Peninsular Ranges, however, plutons crystallized at pressures exceeding 6 kb at deep crustal levels (>23 km). Reconstruction of the pre-erosion top of the batholith shows that in an east-west cross section, the central Sierra Nevada batholith was a horizontal tabular body with an aspect ratio of at least five to one.},
	volume = {100},
	year = {1988},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://gsabulletin.gsapubs.org/content/100/6/912.abstract%20N2%20-%20In%20order%20to%20better%20understand%20geologic%20fac-tors%20controlling%20pronounced%20regional%20variations%20in%20whole-rock%20chemistry,%20mineralogy,%20and%20mineral%20chemistry%20in%20the%20batholiths%20of%20California,%20we%20calculate%20the%20magmatic%20intensive%20variables%20fHF/fH2O,%20fHF/fHCl,%20and%20fO2.Regional-scale%20west-to-east%20increases%20in%20F/OH%20in%20mafic%20silicates,%20corresponding%20to%20the%20systematic%20I-WC%20to%20I-MC%20and%20I-SC%20progression,%20reflect%20orders-of-magnitude%20increase%20in%20fHF/fH2O%20attending%20pluton%20crystallization.%20Low%20fHF/%20fH2Oof%20formation%20of%20western%20I-WC%20types%20is%20consistent%20with%20their%20derivation%20from%20low-fluorine%20source%20rocks%20in%20subducted%20oceanic%20slabs%20or%20the%20upper%20mantle.%20In%20contrast,higher%20fHF/fH2Oof%20crystallization%20of%20I-MC%20and%20I-SC%20types%20to%20the%20east%20implies%20the%20involvement%20of%20(1)%20progressively%20greater%20amounts%20of%20continental%20crustal%20source%20material%20such%20as%20biotite-bearing%20metamorphic%20rocks,%20their%20unweathered%20sedimentary%20derivatives%20retaining%20F-rich%20mafic%20minerals,%20or%20their%20fusion%20products%20and/or%20(2)%20source%20materials%20which%20become%20more%20F-rich%20toward%20the%20continental%20interior.%20The%20regional%20distribution%20of%20I-MC%20and%20I-SC%20types%20suggests%20that%20the%20Precambrian%20craton%20of%20western%20North%20America,%20or%20derivative%20sediments,%20may%20extend%20farther%20north%20in%20California%20and%20be%20morphologically%20more%20complex%20than%20previously%20thought.%20From%20seemingly%20out-of-%20place%20occurrences%20of%20I-WC%20plutons%20on%20the%20eastern%20slopes%20of%20the%20Sierra%20Nevada%20batholith,%20we%20infer%20the%20existence%20of%20regions%20where%20Precambrian%20basement%20was%20thin%20or%20absent%20in%20Mesozoic%20time,%20which%20prevented%20extensive%20cratonal%20contamination%20of%20subducted%20slab%20or%20upper%20mantle-derived%20magmas.New%20methods%20for%20estimating%20T-fO2%20relations%20in%20the%20magmas%20demonstrate%20that%20I-SCR%20granites%20crystallize%20at%20oxygen%20fugacities%20as%20much%20as%20five%20orders%20of%20magnitude%20lower%20than%20those%20of%20I-WC,%20I-MC,%20and%20I-SC%20types%20under%20conditions%20at%20or%20below%20the%20maximum%20stability%20limit%20of%20graphite%20in%20equilibrium%20with%20a%20C-O-H-S%20gas%20phase.%20The%20local-scale%20formation%20of%20I-SCR%20granites%20in%20plutonic%20belts%20within%20specific%20wall-rock%20terranes%20containing%20highly%20reducing%20sediments%20or%20metasediments%20may%20occur%20by%20contamination%20of%20I-types%20with%20graphitic%20pelite%20or,%20in%20some%20cases,%20by%20the%20direct%20fusion%20of%20this%20reducing%20pelitic%20wall%20rock.%20The%20spatial%20distribution%20of%20I-SCR%20granite%20provinces%20therefore%20is%20controlled%20simply%20by%20wall-rock%20lithology.Amphibole%20geobarometry%20demonstrates%20a%20general%20west-to-east%20decrease%20in%20crystallization%20pressure%20across%20the%20Sierra%20Nevada%20batholith.%20In%20contrast,%20the%20Peninsular%20Ranges%20batholith%20displays%20a%20west-to-east%20crystallization%20pressure%20increase.%20The%20bulk%20of%20the%20California%20batholiths%20crystallized%20at%20pressures%20less%20than%204-5%20kb%20and%20depths%20less%20than%20about%2015-19%20km.%20In%20the%20southern%20Sierra%20Nevada%20batholith,%20the%20San%20Gabriels,%20and%20the%20eastern%20Peninsular%20Ranges,%20however,%20plutons%20crystallized%20at%20pressures%20exceeding%206%20kb%20at%20deep%20crustal%20levels%20(%3E23%20km).%20Reconstruction%20of%20the%20pre-erosion%20top%20of%20the%20batholith%20shows%20that%20in%20an%20east-west%20cross%20section,%20the%20central%20Sierra%20Nevada%20batholith%20was%20a%20horizontal%20tabular%20body%20with%20an%20aspect%20ratio%20of%20at%20least%20five%20to%20one.}}

