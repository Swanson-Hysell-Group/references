	keywords = {1525 Geomagnetism and Paleomagnetism: Paleomagnetism applied to tectonics; 1540 Geomagnetism and Paleomagnetism: Rock and mineral magnetism; 9614 Information Related to Geologic Time: Paleozoic; 9330 Information Related to Geographic Region: Australia},
	number = {3},
	pages = {351--367},
	publisher = {AGU},
