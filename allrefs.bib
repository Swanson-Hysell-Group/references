@article{Shaar2015a,
	annote = {10.1073/pnas.1507986112},
	author = {Shaar, Ron and Tauxe, Lisa},
	date = {2015/09/08},
	date-added = {2015-09-18 21:32:42 +0000},
	date-modified = {2015-09-18 21:32:42 +0000},
	journal = {Proceedings of the National Academy of Sciences},
	journal1 = {Proceedings of the National Academy of Sciences},
	month = {09},
	number = {36},
	pages = {11187--11192},
	title = {Instability of thermoremanence and the problem of estimating the ancient geomagnetic field strength from non-single-domain recorders},
	ty = {JOUR},
	url = {http://www.pnas.org/content/112/36/11187.abstract N2 - Data on the past intensity of Earth’s magnetic field (paleointensity) are essential for understanding Earth’s deep interior, climatic modeling, and geochronology applications, among other items. Here we demonstrate the possibility that much of available paleointensity data could be biased by instability of thermoremanent magnetization (TRM) associated with non-single-domain (SD) particles. Paleointensity data are derived from experiments in which an ancient TRM, acquired in an unknown field, is replaced by a laboratory-controlled TRM. This procedure is built on the assumption that the process of ancient TRM acquisition is entirely reproducible in the laboratory. Here we show experimental results violating this assumption in a manner not expected from standard theory. We show that the demagnetization−remagnetization relationship of non-SD specimens that were kept in a controlled field for only 2 y show a small but systematic bias relative to sister specimens that were given a fresh TRM. This effect, likely caused by irreversible changes in micromagnetic structures, leads to a bias in paleointensity estimates.},
	volume = {112},
	year = {2015},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://www.pnas.org/content/112/36/11187.abstract%20N2%20-%20Data%20on%20the%20past%20intensity%20of%20Earth%E2%80%99s%20magnetic%20field%20(paleointensity)%20are%20essential%20for%20understanding%20Earth%E2%80%99s%20deep%20interior,%20climatic%20modeling,%20and%20geochronology%20applications,%20among%20other%20items.%20Here%20we%20demonstrate%20the%20possibility%20that%20much%20of%20available%20paleointensity%20data%20could%20be%20biased%20by%20instability%20of%20thermoremanent%20magnetization%20(TRM)%20associated%20with%20non-single-domain%20(SD)%20particles.%20Paleointensity%20data%20are%20derived%20from%20experiments%20in%20which%20an%20ancient%20TRM,%20acquired%20in%20an%20unknown%20field,%20is%20replaced%20by%20a%20laboratory-controlled%20TRM.%20This%20procedure%20is%20built%20on%20the%20assumption%20that%20the%20process%20of%20ancient%20TRM%20acquisition%20is%20entirely%20reproducible%20in%20the%20laboratory.%20Here%20we%20show%20experimental%20results%20violating%20this%20assumption%20in%20a%20manner%20not%20expected%20from%20standard%20theory.%20We%20show%20that%20the%20demagnetization%E2%88%92remagnetization%20relationship%20of%20non-SD%20specimens%20that%20were%20kept%20in%20a%20controlled%20field%20for%20only%202%20y%20show%20a%20small%20but%20systematic%20bias%20relative%20to%20sister%20specimens%20that%20were%20given%20a%20fresh%20TRM.%20This%20effect,%20likely%20caused%20by%20irreversible%20changes%20in%20micromagnetic%20structures,%20leads%20to%20a%20bias%20in%20paleointensity%20estimates.}}

