@article{Ward1983a,
	annote = {10.1130/0091-7613(1983)11<90:MMAIIT>2.0.CO;2},
	author = {Ward, Peter D. and Verosub, Kenneth L. and Haggart, James W.},
	date = {1983/02/01},
