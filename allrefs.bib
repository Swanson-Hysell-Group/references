@article{Bedard2014a,
	annote = {10.1130/G35770.1},
	author = {B{\'e}dard, Jean H. and Harris, Lyal B.},
	date = {2014/11/01},
	date-added = {2015-01-06 17:09:27 +0000},
	date-modified = {2015-01-06 17:09:27 +0000},
	journal = {Geology},
	journal1 = {Geology},
	month = {11},
	number = {11},
	pages = {951--954},
	title = {Neoarchean disaggregation and reassembly of the Superior craton},
	ty = {JOUR},
	url = {http://geology.gsapubs.org/content/42/11/951.abstract N2 - The southern and western Superior craton of Canada (SWSC) is widely considered to be a tectonic collage accreted from north to south by multiple coeval subduction zones. We propose an alternative non–plate tectonic scenario where SWSC continental fragments are not exotic but derived by partial disaggregation of a heterogeneous older (Superior I) craton in response to a mantle overturn event that started at ca. 2780 Ma. During overturn, radial mantle outflow stretched and disaggregated the lithosphere to create the concentric Neoarchean fabric of the Superior craton, the southern part of which (SWSC) broke up into ribbon continents separated by oceanic tracts. Neoarchean calc-alkaline magmas record interaction between plume-related magma and older crust. A change in the mantle flow field at ca. 2720 Ma caused southward drift of the Northern Superior cratonic block as a result of mantle traction on its lithospheric keel, and SWSC terranes accreted to its leading edge.},
	volume = {42},
	year = {2014},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://geology.gsapubs.org/content/42/11/951.abstract%20N2%20-%20The%20southern%20and%20western%20Superior%20craton%20of%20Canada%20(SWSC)%20is%20widely%20considered%20to%20be%20a%20tectonic%20collage%20accreted%20from%20north%20to%20south%20by%20multiple%20coeval%20subduction%20zones.%20We%20propose%20an%20alternative%20non%E2%80%93plate%20tectonic%20scenario%20where%20SWSC%20continental%20fragments%20are%20not%20exotic%20but%20derived%20by%20partial%20disaggregation%20of%20a%20heterogeneous%20older%20(Superior%20I)%20craton%20in%20response%20to%20a%20mantle%20overturn%20event%20that%20started%20at%20ca.%202780%20Ma.%20During%20overturn,%20radial%20mantle%20outflow%20stretched%20and%20disaggregated%20the%20lithosphere%20to%20create%20the%20concentric%20Neoarchean%20fabric%20of%20the%20Superior%20craton,%20the%20southern%20part%20of%20which%20(SWSC)%20broke%20up%20into%20ribbon%20continents%20separated%20by%20oceanic%20tracts.%20Neoarchean%20calc-alkaline%20magmas%20record%20interaction%20between%20plume-related%20magma%20and%20older%20crust.%20A%20change%20in%20the%20mantle%20flow%20field%20at%20ca.%202720%20Ma%20caused%20southward%20drift%20of%20the%20Northern%20Superior%20cratonic%20block%20as%20a%20result%20of%20mantle%20traction%20on%20its%20lithospheric%20keel,%20and%20SWSC%20terranes%20accreted%20to%20its%20leading%20edge.}}

@article{Suttie2015a,
	annote = {10.1093/gji/ggu443},
	author = {Suttie, Neil and Biggin, Andrew and Holme, Richard},
	date-added = {2015-01-05 21:24:03 +0000},
	date-modified = {2015-01-05 21:24:03 +0000},
	journal = {Geophysical Journal International},
	journal1 = {Geophysical Journal International},
	number = {2},
	pages = {1046--1051},
	title = {Robust estimators of palaeosecular variation},
	ty = {JOUR},
	url = {http://gji.oxfordjournals.org/content/200/2/1046.abstract N2 - The Fisher distribution is central to palaeomagnetism but presents several problems when used to characterize geomagnetic field directions as observed in sequences of volcanic rocks. First, it introduces a shallowing effect when used to define the mean of any group of directional unit vectors. This is problematic because it can suggest the presence of persistent non-axial dipole components when none are present. More importantly, it fails to capture the observed ‘long tail’ in distributions of both directions and associated virtual geomagnetic poles in terms of angular distance from a central direction. To achieve a good fit to data, it therefore requires the introduction of a second distribution (and therefore the estimation of additional parameters) or the arbitrary removal of data. Here we present a new distribution to describe palaeomagnetic directions and demonstrate that it overcomes both of these problems, generating robust indicators of both the central direction (or pole position) and the spread of palaeomagnetic data as defined by unit vectors. Starting from the assumption that poles (or directions) have an expected colatitude, rather than a mean location, we derive the spherical exponential distribution. We demonstrate that this new distribution provides a good fit to palaeomagnetic data sets from seven large igneous provinces between 15 and 65 Ma and also those produced by numerical dynamo models. We also use it to derive a new shape parameter which may be used as a diagnostic tool for testing goodness of fit of models to data and use this to argue for a shift in geomagnetic behaviour between 5 and 15 Ma. Furthermore, we point out that this new statistic can be used to determine the most appropriate distribution to be used when constructing confidence limits for poles.},
	volume = {200},
	year = {February, 2015},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://gji.oxfordjournals.org/content/200/2/1046.abstract%20N2%20-%20The%20Fisher%20distribution%20is%20central%20to%20palaeomagnetism%20but%20presents%20several%20problems%20when%20used%20to%20characterize%20geomagnetic%20field%20directions%20as%20observed%20in%20sequences%20of%20volcanic%20rocks.%20First,%20it%20introduces%20a%20shallowing%20effect%20when%20used%20to%20define%20the%20mean%20of%20any%20group%20of%20directional%20unit%20vectors.%20This%20is%20problematic%20because%20it%20can%20suggest%20the%20presence%20of%20persistent%20non-axial%20dipole%20components%20when%20none%20are%20present.%20More%20importantly,%20it%20fails%20to%20capture%20the%20observed%20%E2%80%98long%20tail%E2%80%99%20in%20distributions%20of%20both%20directions%20and%20associated%20virtual%20geomagnetic%20poles%20in%20terms%20of%20angular%20distance%20from%20a%20central%20direction.%20To%20achieve%20a%20good%20fit%20to%20data,%20it%20therefore%20requires%20the%20introduction%20of%20a%20second%20distribution%20(and%20therefore%20the%20estimation%20of%20additional%20parameters)%20or%20the%20arbitrary%20removal%20of%20data.%20Here%20we%20present%20a%20new%20distribution%20to%20describe%20palaeomagnetic%20directions%20and%20demonstrate%20that%20it%20overcomes%20both%20of%20these%20problems,%20generating%20robust%20indicators%20of%20both%20the%20central%20direction%20(or%20pole%20position)%20and%20the%20spread%20of%20palaeomagnetic%20data%20as%20defined%20by%20unit%20vectors.%20Starting%20from%20the%20assumption%20that%20poles%20(or%20directions)%20have%20an%20expected%20colatitude,%20rather%20than%20a%20mean%20location,%20we%20derive%20the%20spherical%20exponential%20distribution.%20We%20demonstrate%20that%20this%20new%20distribution%20provides%20a%20good%20fit%20to%20palaeomagnetic%20data%20sets%20from%20seven%20large%20igneous%20provinces%20between%2015%20and%2065%20Ma%20and%20also%20those%20produced%20by%20numerical%20dynamo%20models.%20We%20also%20use%20it%20to%20derive%20a%20new%20shape%20parameter%20which%20may%20be%20used%20as%20a%20diagnostic%20tool%20for%20testing%20goodness%20of%20fit%20of%20models%20to%20data%20and%20use%20this%20to%20argue%20for%20a%20shift%20in%20geomagnetic%20behaviour%20between%205%20and%2015%20Ma.%20Furthermore,%20we%20point%20out%20that%20this%20new%20statistic%20can%20be%20used%20to%20determine%20the%20most%20appropriate%20distribution%20to%20be%20used%20when%20constructing%20confidence%20limits%20for%20poles.}}

@article{Bazhenov2014b,
	abstract = {Abstract Paleomagnetic studies of thick lava series are one of the most reliable sources of data on the ancient geomagnetic field. However, most of such data are younger than 5 Ma, with much fewer results on the rest of the Cenozoic and the Mesozoic. Two wholesome results are available for the Precambrian but none for the Paleozoic. Late Permian basalts and rhyolites from northeastern Kazakhstan were studied to obtain first estimates of the geomagnetic-field characteristics during that period. We present preliminary results on part of the collection (66 flows (sites)) from a section ~ 1600 m thick. The characteristic component of reversed polarity was isolated by stepwise demagnetization at all the sites with a slight error. This component is of prefolding age and, most likely, primary. No abnormal magnetization direction is observed in the data, and the average directions of the characteristic component at the sites are tightly clustered (D = 243.3$\,^{\circ}$; I = − 57.0$\,^{\circ}$; k = 79.1; α95 = 2.0$\,^{\circ}$; 65 sites). As compared with the published data on Cenozoic and Mesozoic thick lava series, secular variation was much weaker in the Late Permian than in the Mesozoic or Cenozoic, and the geomagnetic field was less disturbed. Secular-variation models based on the Late Cenozoic data show even more dramatic differences.},
	author = {Bazhenov, M. L. and Van der Voo, R. and Meert, J. G. and Levashova, N. M. and Ipat'eva, I. S.},
	date = {2014/1//},
	date-added = {2015-01-05 21:17:08 +0000},
	date-modified = {2015-01-05 21:17:08 +0000},
	doi = {http://dx.doi.org/10.1016/j.rgg.2013.12.009},
	isbn = {1068-7971},
	journal = {Russian Geology and Geophysics},
	keywords = {geomagnetism; paleomagnetism; Paleozoic; thick lava series; geomagnetic-field characteristics},
	month = {1},
	number = {1},
	pages = {108--117},
	title = {Late Paleozoic geomagnetic-field estimates from studies of Permian lavas in northeastern Kazakhstan},
	ty = {JOUR},
	url = {http://www.sciencedirect.com/science/article/pii/S1068797113002459},
	volume = {55},
	year = {2014},
	bdsk-url-1 = {http://www.sciencedirect.com/science/article/pii/S1068797113002459},
	bdsk-url-2 = {http://dx.doi.org/10.1016/j.rgg.2013.12.009}}

@article{Bono2014a,
	annote = {10.1130/G36247.1},
	author = {Bono, Richard K. and Tarduno, John A.},
	date = {2014/12/19},
	date-added = {2015-01-05 20:59:13 +0000},
	date-modified = {2015-01-05 20:59:13 +0000},
	journal = {Geology},
	journal1 = {Geology},
	month = {12},
	title = {A stable Ediacaran Earth recorded by single silicate crystals of the ca. 565 Ma Sept-{\^I}les intrusion},
	ty = {JOUR},
	url = {http://geology.gsapubs.org/content/early/2014/12/19/G36247.1.abstract N2 - The archetypical example of inertial interchange true polar wander (IITPW), the rapid rotation of the entire solid Earth by 90°, is based on two nearly orthogonal directions seen in paleomagnetic studies of the Sept-Îles (ca. 565 Ma) intrusion (Quebec, Canada). This motion has also been proposed as the driving force for the early Cambrian explosion of life. Others have challenged these interpretations, linking the data instead to flips between an axial and equatorial dipole field configuration. We examine this enigma using single silicate crystal paleomagnetic analyses. We conclude that only one of the previously reported magnetic directions is carried by single domain magnetic grains and can be considered primary. Thus, the Ediacaran diversification occurred on a rotationally stable Earth driven by biotic and longer term abiotic forcing. Whether IITPW ever occurred in the past on Earth remains uncertain.},
	year = {2014},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://geology.gsapubs.org/content/early/2014/12/19/G36247.1.abstract%20N2%20-%20The%20archetypical%20example%20of%20inertial%20interchange%20true%20polar%20wander%20(IITPW),%20the%20rapid%20rotation%20of%20the%20entire%20solid%20Earth%20by%2090%C2%B0,%20is%20based%20on%20two%20nearly%20orthogonal%20directions%20seen%20in%20paleomagnetic%20studies%20of%20the%20Sept-%C3%8Eles%20(ca.%20565%20Ma)%20intrusion%20(Quebec,%20Canada).%20This%20motion%20has%20also%20been%20proposed%20as%20the%20driving%20force%20for%20the%20early%20Cambrian%20explosion%20of%20life.%20Others%20have%20challenged%20these%20interpretations,%20linking%20the%20data%20instead%20to%20flips%20between%20an%20axial%20and%20equatorial%20dipole%20field%20configuration.%20We%20examine%20this%20enigma%20using%20single%20silicate%20crystal%20paleomagnetic%20analyses.%20We%20conclude%20that%20only%20one%20of%20the%20previously%20reported%20magnetic%20directions%20is%20carried%20by%20single%20domain%20magnetic%20grains%20and%20can%20be%20considered%20primary.%20Thus,%20the%20Ediacaran%20diversification%20occurred%20on%20a%20rotationally%20stable%20Earth%20driven%20by%20biotic%20and%20longer%20term%20abiotic%20forcing.%20Whether%20IITPW%20ever%20occurred%20in%20the%20past%20on%20Earth%20remains%20uncertain.}}

