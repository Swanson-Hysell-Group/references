	bdsk-url-1 = {http://geology.gsapubs.org/content/39/5/487.abstract%20N2%20-%20Proterozoic%20reconstructions%20of%20the%20Kaapvaal%20and%20Zimbabwe%20cratons%20have%20been%20limited%20by%20the%20scarcity%20of%20precisely%20dated%20paleomagnetic%20poles%20for%20the%20Zimbabwe%20craton.%20We%20present%20new%20U-Pb%20baddeleyite%20and%20apatite%20dates%20from%20two%20diabase%20sheets%20that%20have%20previously%20yielded%20paleomagnetic%20data%20from%20the%20Mashonaland%20igneous%20province%20in%20the%20Zimbabwe%20craton.%20Discordant%20baddeleyite%20analyses%20yield%20upper%20intercept%20dates%20of%201871.9%20%C2%B1%202.2%20and%201882.7%20+1.6/%E2%88%921.5%20Ma.%20Apatite%20data%20from%20the%20same%20samples%20give%20less%20precise%20but%20statistically%20indistinguishable%20dates,%20providing%20direct%20constraints%20on%20the%20post-magmatic%20thermal%20history%20of%20the%20diabases.%20The%20new%20U-Pb%20dates%20and%20other%20recently%20published%20baddeleyite%20dates%20from%20the%20Mashonaland%20province%20are%20coeval%20with%20mafic%20magmatism%20in%20the%20adjacent%20Kaapvaal%20craton%20(1879%E2%80%931872%20Ma),%20but%20paleomagnetic%20poles%20from%20the%20two%20intraplate%20suites%20differ%20by%2039%C2%B0,%20suggesting%20that%20the%20two%20cratons%20underwent%20substantial%20relative%20motion%20after%20ca.%201.88%20Ga.%20Paleomagnetic%20reconstructions%20are%20consistent%20with%20%3E2000%20km%20of%20lateral%20displacement%20being%20accommodated%20in%20the%20Limpopo%20orogenic%20belt%20that%20separates%20the%20two%20cratons.}}

