@article{Vincenz1968b,
	abstract = {Two types of magnetization occur in the Upper Keweenawan rocks. Magnetization has a `normal'direction in the lavas of the Copper Harbor formation where it is associated with minerals of the magnetite-ulv{\"o}spinel series. On the other hand, in the Nonesuch shale and the Freda sandstone, exposed on the Keweenawan peninsula, the magnetization has undergone partial self-reversal, which is associated with preponderance of minerals of the ilmenite-hematite system and exsolution of ilmenite lamellas. The magnetic properties of these sediments are to a certain extent similar to those of the Portage Lake lavas described in the previous paper, but the origin of the self-reversal is not clear. Underground exposures of the Nonesuch shale at White Pine Mine, Ontonagon County, do not show any self-reversal, and they appear to have been partially remagnetized by some secondary thermal process, and direction of maximum susceptibility is in the bedding plane of the sediments. Paleomagnetic computations suggest a close similarity between the lavas and the sediments on the peninsula, but both have significantly different directions of magnetization from directions of magnetization of the Portage Lake lavas. Investigations of two Lower Keweenawan diabase dikes in Baraga County, Michigan, suggest that the magnetization of one of these dikes has been acquired in a reversed field but it contains also an inversely superimposed small self-reversed component. The magnetization of the other dike reveals instabilities suggesting partly super-paramagnetic properties and a field reversal. It is concluded that the partial self-reversal is a very typical phenomenon, which generally cannot be confused with partial remagnetzation in a reversed field.},
	author = {Vincenz, S. A. and Yaskawa, K.},
	date-added = {2009-12-30 17:48:35 -0500},
	date-modified = {2018-05-08 20:01:47 +0000},
	doi = {10.1029/JB073i008p02753},
	journal = {Journal of Geophysical Research},
	publisher = {American Geophysical Union},
	title = {Phenomenon of Partial Self-Reversal in {K}eweenawan Rocks 2. Magnetization of Upper {K}eweenawan Lavas and Sediments and of Lower {K}eweenawan Dikes},
	ty = {JOUR},
	volume = {73},
	year = {1968},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://dx.doi.org/10.1029/JB073i008p02753}}

@article{Vincenz1968a,
	abstract = {Laboratory studies of the Portage Lake lavas of the Precambrian Middle Keweenawan period show that the lavas can be divided into two groups: the northern group in which the natural remanent magnetization consists of a single component directed to the west (D = 291$\,^{\circ}$and I = 36$\,^{\circ}$) and the southern group in which the magnetization consists of two mutually antiparallel components, one (the larger) directed to the west (D = 279$\,^{\circ}$and I = 30$\,^{\circ}$) and the other (the smaller) directed to the east. The stronger component disappears near 580$\,^{\circ}$C or in the interval 650$\,^{\circ}$to 675$\,^{\circ}$C, whereas the weaker component is destroyed by heating to about 250$\,^{\circ}$C and is attributed to partial self-reversal of magnetization. This self-reversal in the southern group of lavas has been modeled in the laboratory and is associated with the presence of certain types of micro-intergrowths in the ilmenite-hematite series. The `normal'magnetization of the northern group of lavas is associated with minerals of the magnetite-ulv{\"o}spinel series. A reversed magnetization in this type of lavas would have to be attributed to geomagnetic field reversals. Paleomagnetic data from thermally cleaned samples are in good agreement with previous paleomagnetic studies of the Portage Lake lavas.},
	author = {Vincenz, S. A.},
