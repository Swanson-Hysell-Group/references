@article{Bartlett2016a,
	abstract = {During the Precambrian era, Earth's decelerating rotation would have passed a 21-hour period that would have been resonant with the semidiurnal atmospheric thermal tide. Near this point, the atmospheric torque would have been maximized, being comparable in magnitude but opposite in direction to the lunar torque, halting Earth's rotational deceleration, maintaining a constant day length, as detailed by Zahnle and Walker {$[$}1987{$]$}. We develop a computational model to determine necessary conditions for formation and breakage of this resonant effect. Our simulations show the resonance to be resilient to atmospheric thermal noise but suggest a sudden atmospheric temperature increase like the deglaciation period following a possible "snowball Earth" near the end of the Precambrian would break this resonance; the Marinoan and Sturtian glaciations seem the most likely candidates for this event. Our model provides a simulated day length over time that resembles existing paleorotational data, though further data is needed to verify this hypothesis.},
	author = {Bartlett, Benjamin C. and Stevenson, David J.},
	date-added = {2016-06-13 18:46:23 +0000},
	date-modified = {2016-06-13 18:46:23 +0000},
	doi = {10.1002/2016GL068912},
	isbn = {1944-8007},
	journal = {Geophysical Research Letters},
	publisher = {Wiley Online Library},
	title = {Analysis of a Precambrian resonance-stabilized day length},
	ty = {JOUR},
	url = {http://dx.doi.org/10.1002/2016GL068912},
	year = {2016},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://dx.doi.org/10.1002/2016GL068912}}

