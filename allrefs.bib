@article{Aubourg2012a,
	annote = {10.1144/SP371.4},
	author = {Aubourg, Charles and Pozzi, Jean-Pierre and Kars, Myriam},
	date = {2012/01/01},
	date-added = {2013-05-10 18:16:22 +0000},
	date-modified = {2013-05-10 18:16:22 +0000},
	journal = {Geological Society, London, Special Publications},
	journal1 = {Geological Society, London, Special Publications},
	month = {01},
	number = {1},
	pages = {181--188},
	title = {Burial, claystones remagnetization and some consequences for magnetostratigraphy},
	ty = {JOUR},
	url = {http://sp.lyellcollection.org/content/371/1/181.abstract N2 - We investigate the broad lines of magnetic mineral formation for non-metamorphic claystones. More particularly, we focus on the formation of magnetite from c. 20 day-experiments aiming to reproduce burial conditions. It is shown that the sole action of temperature from 50 °C to 250 °C leads to the formation of magnetite. The neoformed magnetites carry a chemical remanent magnetization which equates at least the natural remanent magnetization. We propose a schematic of burial with three magnetic windows where a chemical remanent magnetization superimposed the natural remanent magnetization. These are the greigite window (subsurface), the magnetite window (depth > 2 km) and the pyrrhotite window (depth > 6 km). The formation of magnetic minerals has profound consequences for the magnetostratigraphy record. We propose a conceptual model that shows that the continuous production of magnetite during burial may result in magnetozones that have no relation to the age of the sediment.},
	volume = {371},
	year = {2012},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://sp.lyellcollection.org/content/371/1/181.abstract%20N2%20-%20We%20investigate%20the%20broad%20lines%20of%20magnetic%20mineral%20formation%20for%20non-metamorphic%20claystones.%20More%20particularly,%20we%20focus%20on%20the%20formation%20of%20magnetite%20from%20c.%2020%20day-experiments%20aiming%20to%20reproduce%20burial%20conditions.%20It%20is%20shown%20that%20the%20sole%20action%20of%20temperature%20from%2050%20%C2%B0C%20to%20250%20%C2%B0C%20leads%20to%20the%20formation%20of%20magnetite.%20The%20neoformed%20magnetites%20carry%20a%20chemical%20remanent%20magnetization%20which%20equates%20at%20least%20the%20natural%20remanent%20magnetization.%20We%20propose%20a%20schematic%20of%20burial%20with%20three%20magnetic%20windows%20where%20a%20chemical%20remanent%20magnetization%20superimposed%20the%20natural%20remanent%20magnetization.%20These%20are%20the%20greigite%20window%20(subsurface),%20the%20magnetite%20window%20(depth%20%3E%202%20km)%20and%20the%20pyrrhotite%20window%20(depth%20%3E%206%20km).%20The%20formation%20of%20magnetic%20minerals%20has%20profound%20consequences%20for%20the%20magnetostratigraphy%20record.%20We%20propose%20a%20conceptual%20model%20that%20shows%20that%20the%20continuous%20production%20of%20magnetite%20during%20burial%20may%20result%20in%20magnetozones%20that%20have%20no%20relation%20to%20the%20age%20of%20the%20sediment.}}

