@article{Macdonald2014a,
	abstract = {The Taconic and Salinic orogenies in the northern Appalachian Mountains record the closure of the Iapetus Ocean, which separated peri-Laurentian and peri-Gondwanan terranes in the early Paleozoic. The Taconic orogeny in New England is commonly depicted as an Ordovician collision between the peri-Laurentian Shelburne Falls arc and the Laurentian margin, followed by Silurian accretion of peri-Gondwanan terranes during the Salinic orogeny. New U-Pb zircon geochronology demonstrates that the Shelburne Falls arc was instead constructed on a Gondwanan-derived terrane preserved in the Moretown Formation, which we refer to here as the Moretown terrane. Metasedimentary rocks of the Moretown Formation were deposited after 514 Ma and contain abundant ca. 535--650 Ma detrital zircon that suggest a Gondwanan source. The Moretown Formation is bound to the west by the peri-Laurentian Rowe belt, which contains detrital zircon in early Paleozoic metasedimentary rocks that is indistinguishable in age from zircon in Laurentian margin rift-drift successions. These data reveal that the principal Iapetan suture in New England is between the Rowe belt and Moretown terrane, more than 50 km farther west than previously suspected. The Moretown terrane is structurally below and west of volcanic and metasedimentary rocks of the Hawley Formation, which contains Laurentian-derived detrital zircon, providing a link between peri-Laurentian and peri-Gondwanan terranes. The Moretown terrane and Hawley Formation were intruded by 475 Ma plutons during peak activity in the Shelburne Falls arc. We propose that the peri-Laurentian Rowe belt was subducted under the Moretown terrane just prior to 475 Ma, when the trench gap was narrow enough to deliver Laurentian detritus to the Hawley Formation. Interaction between peri-Laurentian and peri-Gondwanan terranes by 475 Ma is 20 m.y. earlier than documented elsewhere and accounts for structural relationships, Early Ordovician metamorphism and deformation, and the subsequent closure of the peri-Laurentian Taconic seaway. In this scenario, a rifted-arc system on the Gondwanan margin resulted in the formation of multiple terranes, including the Moretown, that independently crossed and closed the Iapetus Ocean in piecemeal fashion.},
	author = {Macdonald, F. A. and Ryan-Davis, J. and Coish, R. A. and Crowley, J. L. and Karabinos, P.},
	date = {2014/04/24},
	date-added = {2016-03-13 04:46:02 +0000},
	date-modified = {2016-06-01 03:07:35 +0000},
	doi = {10.1130/G35659.1},
	journal = {Geology},
	month = {04},
	title = {{A newly identified Gondwanan terrane in the northern Appalachian Mountains: Implications for the Taconic orogeny and closure of the Iapetus Ocean}},
	ty = {JOUR},
	url = {http://geology.gsapubs.org/content/early/2014/04/22/G35659.1.abstract},
	year = {2014},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://geology.gsapubs.org/content/early/2014/04/22/G35659.1.abstract%20N2%20-%20%20The%20Taconic%20and%20Salinic%20orogenies%20in%20the%20northern%20Appalachian%20Mountains%20record%20the%20closure%20of%20the%20Iapetus%20Ocean,%20which%20separated%20peri-Laurentian%20and%20peri-Gondwanan%20terranes%20in%20the%20early%20Paleozoic.%20The%20Taconic%20orogeny%20in%20New%20England%20is%20commonly%20depicted%20as%20an%20Ordovician%20collision%20between%20the%20peri-Laurentian%20Shelburne%20Falls%20arc%20and%20the%20Laurentian%20margin,%20followed%20by%20Silurian%20accretion%20of%20peri-Gondwanan%20terranes%20during%20the%20Salinic%20orogeny.%20New%20U-Pb%20zircon%20geochronology%20demonstrates%20that%20the%20Shelburne%20Falls%20arc%20was%20instead%20constructed%20on%20a%20Gondwanan-derived%20terrane%20preserved%20in%20the%20Moretown%20Formation,%20which%20we%20refer%20to%20here%20as%20the%20Moretown%20terrane.%20Metasedimentary%20rocks%20of%20the%20Moretown%20Formation%20were%20deposited%20after%20514%20Ma%20and%20contain%20abundant%20ca.%20535%E2%80%93650%20Ma%20detrital%20zircon%20that%20suggest%20a%20Gondwanan%20source.%20The%20Moretown%20Formation%20is%20bound%20to%20the%20west%20by%20the%20peri-Laurentian%20Rowe%20belt,%20which%20contains%20detrital%20zircon%20in%20early%20Paleozoic%20metasedimentary%20rocks%20that%20is%20indistinguishable%20in%20age%20from%20zircon%20in%20Laurentian%20margin%20rift-drift%20successions.%20These%20data%20reveal%20that%20the%20principal%20Iapetan%20suture%20in%20New%20England%20is%20between%20the%20Rowe%20belt%20and%20Moretown%20terrane,%20more%20than%2050%20km%20farther%20west%20than%20previously%20suspected.%20The%20Moretown%20terrane%20is%20structurally%20below%20and%20west%20of%20volcanic%20and%20metasedimentary%20rocks%20of%20the%20Hawley%20Formation,%20which%20contains%20Laurentian-derived%20detrital%20zircon,%20providing%20a%20link%20between%20peri-Laurentian%20and%20peri-Gondwanan%20terranes.%20The%20Moretown%20terrane%20and%20Hawley%20Formation%20were%20intruded%20by%20475%20Ma%20plutons%20during%20peak%20activity%20in%20the%20Shelburne%20Falls%20arc.%20We%20propose%20that%20the%20peri-Laurentian%20Rowe%20belt%20was%20subducted%20under%20the%20Moretown%20terrane%20just%20prior%20to%20475%20Ma,%20when%20the%20trench%20gap%20was%20narrow%20enough%20to%20deliver%20Laurentian%20detritus%20to%20the%20Hawley%20Formation.%20Interaction%20between%20peri-Laurentian%20and%20peri-Gondwanan%20terranes%20by%20475%20Ma%20is%2020%20m.y.%20earlier%20than%20documented%20elsewhere%20and%20accounts%20for%20structural%20relationships,%20Early%20Ordovician%20metamorphism%20and%20deformation,%20and%20the%20subsequent%20closure%20of%20the%20peri-Laurentian%20Taconic%20seaway.%20In%20this%20scenario,%20a%20rifted-arc%20system%20on%20the%20Gondwanan%20margin%20resulted%20in%20the%20formation%20of%20multiple%20terranes,%20including%20the%20Moretown,%20that%20independently%20crossed%20and%20closed%20the%20Iapetus%20Ocean%20in%20piecemeal%20fashion.}}

@article{Farley2015a,
	author = {Farley, K. A. and McKeon, R.},
	date = {2015/11/06},
	date-added = {2016-03-12 22:49:33 +0000},
	date-modified = {2016-03-12 22:49:33 +0000},
	doi = {10.1130/G37190.1},
	journal = {Geology},
	m3 = {10.1130/G37190.1},
	title = {Radiometric dating and temperature history of banded iron formation--associated hematite, {Gogebic} iron range, {Michigan}, {USA}},
	ty = {JOUR},
	year = {2015},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://geology.gsapubs.org/content/early/2015/11/05/G37190.1.abstract%20N2%20-%20Newly%20developed%20techniques%20were%20used%20to%20characterize%20the%20age,%20origin,%20and%20temperature%20history%20of%20coarse%20hematite%20contained%20in%20high-grade%20iron%20ore.%20Three%20botryoidal%20specimens%20from%20two%20different%20mines%20in%20the%20Gogebic%20iron%20range%20near%20Ironwood,%20Michigan%20(USA),%20yielded%20(U-Th)/21Ne%20ages%20concordant%20with%20plateau%204He/3He%20ages.%20These%20data%20reveal%20that%20while%20two%20of%20the%20specimens%20grew%20at%20ca.%20772%20%C2%B1%2041%20Ma,%20the%20third%20formed%20300%20m.y.%20later%20(453%20%C2%B1%2014%20Ma).%204He/3He%20polydomain%20thermochronometry%20indicates%20hematite%20formation%20at%20%3E80%20%C2%B0C%20for%20the%20older%20specimens%20and%20%E2%88%BC60%20%C2%B0C%20for%20the%20younger.%20Fe%20mobilization%20and%20recrystallization%20in%20open%20cavities%20at%203%E2%80%935%20km%20subsurface%20has%20occurred%20episodically%20or%20possibly%20continuously%20over%20hundreds%20of%20millions%20of%20years%20despite%20a%20quiescent%20tectonic%20setting%20throughout%20this%20interval.%20While%20the%20analyzed%20specimens%20are%20distinct%20from%20typical%20Fe%20ore,%20their%20ages%20along%20with%20structural%20relationships%20constrain%20the%20onset%20of%20iron%20enrichment%20to%20between%201060%20and%20770%20Ma.%20Cooling%20of%20%E2%88%BC0.5%20%C2%B0C/m.y.%20ensued%20between%20ca.%20800%20and%20ca.%20550%20Ma,%20declining%20to%20%E2%88%BC0.1%20%C2%B0C/m.y.%20for%20the%20last%20550%20m.y.%20These%20data%20suggest%20an%20erosion%20rate%20of%20%E2%88%BC6%20m/m.y.%20and%20%E2%88%BC5%20km%20of%20total%20erosion%20of%20the%20Superior%20Upland%20province%20through%20the%20Phanerozoic,%20and%20limit%20unroofing%20associated%20with%20Pleistocene%20glaciation%20to%20%3C1%20km.}}

