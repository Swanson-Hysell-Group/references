@article{COLLINSON1960a,
	annote = {10.1130/0016-7606(1960)71{$[$}915:PWACDE{$]$}2.0.CO;2},
	author = {COLLINSON, D. W and RUNCORN, S. K},
	date = {1960/07/01},
	date-added = {2016-02-06 00:45:02 +0000},
	date-modified = {2016-02-06 00:45:02 +0000},
	journal = {Geological Society of America Bulletin},
	journal1 = {Geological Society of America Bulletin},
	month = {07},
	number = {7},
	pages = {915--958},
	title = {POLAR WANDERING AND CONTINENTAL DRIFT: EVIDENCE FROM PALEOMAGNETIC OBSERVATIONS IN THE UNITED STATES},
	ty = {JOUR},
	url = {http://gsabulletin.gsapubs.org/content/71/7/915.abstract N2 - Further studies of the paleomagnetic directions of red sandstones and siltstones of various geological ages in the United States are described. Usually the directions of magnetization of samples from a formation at one site are grouped symmetrically about a mean direction. From such a mean direction the position of the pole for that geological age can be calculated. There are, however, magnetically unstable formations in which the directions of magnetization are distributed approximately in the plane containing the present dipole field at the site and the original direction of the magnetic field. This planar distribution is the result of a superposition of a secondary magnetization on the original one. The former is thought to be a viscous or chemical magnetization acquired in the last 1,000–1,000,000 years.Pole positions calculated from mean directions at different sites are consistent for the same formation and for different formations of the same geological age.The study confirms the general trend of the polar-wandering curve for North America obtained by Runcorn (1956a), which lies around the northern Pacific Ocean: the pole being in the central tropical Pacific in late Precambrian time, moving across to the tropical western Pacific in the early Paleozoic and to Asia in the late Paleozoic and early Mesozoic. The data also show that the polar-wandering curve for North America is displaced westward relative to that for Europe, as Runcorn (1956b) showed, and provide an estimate for the amount of drift between the two continents since Mesozoic time, which is of the order of 30° in longitude.},
	volume = {71},
	year = {1960},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://gsabulletin.gsapubs.org/content/71/7/915.abstract%20N2%20-%20Further%20studies%20of%20the%20paleomagnetic%20directions%20of%20red%20sandstones%20and%20siltstones%20of%20various%20geological%20ages%20in%20the%20United%20States%20are%20described.%20Usually%20the%20directions%20of%20magnetization%20of%20samples%20from%20a%20formation%20at%20one%20site%20are%20grouped%20symmetrically%20about%20a%20mean%20direction.%20From%20such%20a%20mean%20direction%20the%20position%20of%20the%20pole%20for%20that%20geological%20age%20can%20be%20calculated.%20There%20are,%20however,%20magnetically%20unstable%20formations%20in%20which%20the%20directions%20of%20magnetization%20are%20distributed%20approximately%20in%20the%20plane%20containing%20the%20present%20dipole%20field%20at%20the%20site%20and%20the%20original%20direction%20of%20the%20magnetic%20field.%20This%20planar%20distribution%20is%20the%20result%20of%20a%20superposition%20of%20a%20secondary%20magnetization%20on%20the%20original%20one.%20The%20former%20is%20thought%20to%20be%20a%20viscous%20or%20chemical%20magnetization%20acquired%20in%20the%20last%201,000%E2%80%931,000,000%20years.Pole%20positions%20calculated%20from%20mean%20directions%20at%20different%20sites%20are%20consistent%20for%20the%20same%20formation%20and%20for%20different%20formations%20of%20the%20same%20geological%20age.The%20study%20confirms%20the%20general%20trend%20of%20the%20polar-wandering%20curve%20for%20North%20America%20obtained%20by%20Runcorn%20(1956a),%20which%20lies%20around%20the%20northern%20Pacific%20Ocean:%20the%20pole%20being%20in%20the%20central%20tropical%20Pacific%20in%20late%20Precambrian%20time,%20moving%20across%20to%20the%20tropical%20western%20Pacific%20in%20the%20early%20Paleozoic%20and%20to%20Asia%20in%20the%20late%20Paleozoic%20and%20early%20Mesozoic.%20The%20data%20also%20show%20that%20the%20polar-wandering%20curve%20for%20North%20America%20is%20displaced%20westward%20relative%20to%20that%20for%20Europe,%20as%20Runcorn%20(1956b)%20showed,%20and%20provide%20an%20estimate%20for%20the%20amount%20of%20drift%20between%20the%20two%20continents%20since%20Mesozoic%20time,%20which%20is%20of%20the%20order%20of%2030%C2%B0%20in%20longitude.}}

@article{HAMBLIN1961a,
	annote = {10.1130/0016-7606(1961)72{$[$}1:PEOTLS{$]$}2.0.CO;2},
	author = {HAMBLIN, WILLIAM KENNETH},
	date = {1961/01/01},
	date-added = {2016-02-06 00:43:09 +0000},
	date-modified = {2016-02-06 00:43:09 +0000},
	journal = {Geological Society of America Bulletin},
	journal1 = {Geological Society of America Bulletin},
	month = {01},
	number = {1},
	pages = {1--18},
	title = {Paleogeographic Evolution of the Lake Superior Region from Late Keweenawan to Late Cambrian Time},
	ty = {JOUR},
	url = {http://gsabulletin.gsapubs.org/content/72/1/1.abstract N2 - A combined study of regional stratigraphy, petrology, and paleocurrents was made of the Freda sandstone, Jacobsville sandstone, Bayfield group, Dresbach formation, and Franconia formation. Data pertaining to the location and nature of the source of the sediments were obtained primarily from petrology and directional sedimentary structures. Environmental reconstructions were based on patterns of lithologic variations, kinds of sedimentary structures, and heavy minerals.This information indicates that the Northern Michigan highland extended through northern Wisconsin and northern Michigan and acted as a source of sediment from Late Keweenawan through Dresbachian time. The Freda formation accumulated in the Keweenawan basin, which was north of the Northern Michigan highland approximately in the present site of Lake Superior but extended considerably farther to the southwest. Deposition took place in a flood-plain and lacustrine environment. Prior to the deposition of the Jacobsville-Bayfield sediments, the Keweenawan sequence was deformed and eroded, but the Northern Michigan highland persisted as a positive area, and the shape and extent of the basin remained much the same. A lacustrine environment predominated in the central part of the basin, but much of the Jacobsville sandstone and Bayfield group undoubtedly represents fan deposits which merged northward into sediments of an alluvial plain. During Dresbachian time the Northern Michigan highland remained as a positive area, but shallow seas invaded the Lake Superior region from the northwest and central Wisconsin from the south. Most of the Dresbach sediments accumulated in a beach environment, but in southern Wisconsin an offshore neritic environment predominated. Prior to Franconian time there was a widespread regression of the seas, and most of the region was subjected to subaerial erosion. By Franconian time the Northern Michigan highland was reduced to a surface of low relief, and the seas re-advanced across the entire area from the southwest. An appreciable amount of the Franconia sediments accumulated in an offshore environment.},
	volume = {72},
	year = {1961},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://gsabulletin.gsapubs.org/content/72/1/1.abstract%20N2%20-%20A%20combined%20study%20of%20regional%20stratigraphy,%20petrology,%20and%20paleocurrents%20was%20made%20of%20the%20Freda%20sandstone,%20Jacobsville%20sandstone,%20Bayfield%20group,%20Dresbach%20formation,%20and%20Franconia%20formation.%20Data%20pertaining%20to%20the%20location%20and%20nature%20of%20the%20source%20of%20the%20sediments%20were%20obtained%20primarily%20from%20petrology%20and%20directional%20sedimentary%20structures.%20Environmental%20reconstructions%20were%20based%20on%20patterns%20of%20lithologic%20variations,%20kinds%20of%20sedimentary%20structures,%20and%20heavy%20minerals.This%20information%20indicates%20that%20the%20Northern%20Michigan%20highland%20extended%20through%20northern%20Wisconsin%20and%20northern%20Michigan%20and%20acted%20as%20a%20source%20of%20sediment%20from%20Late%20Keweenawan%20through%20Dresbachian%20time.%20The%20Freda%20formation%20accumulated%20in%20the%20Keweenawan%20basin,%20which%20was%20north%20of%20the%20Northern%20Michigan%20highland%20approximately%20in%20the%20present%20site%20of%20Lake%20Superior%20but%20extended%20considerably%20farther%20to%20the%20southwest.%20Deposition%20took%20place%20in%20a%20flood-plain%20and%20lacustrine%20environment.%20Prior%20to%20the%20deposition%20of%20the%20Jacobsville-Bayfield%20sediments,%20the%20Keweenawan%20sequence%20was%20deformed%20and%20eroded,%20but%20the%20Northern%20Michigan%20highland%20persisted%20as%20a%20positive%20area,%20and%20the%20shape%20and%20extent%20of%20the%20basin%20remained%20much%20the%20same.%20A%20lacustrine%20environment%20predominated%20in%20the%20central%20part%20of%20the%20basin,%20but%20much%20of%20the%20Jacobsville%20sandstone%20and%20Bayfield%20group%20undoubtedly%20represents%20fan%20deposits%20which%20merged%20northward%20into%20sediments%20of%20an%20alluvial%20plain.%20During%20Dresbachian%20time%20the%20Northern%20Michigan%20highland%20remained%20as%20a%20positive%20area,%20but%20shallow%20seas%20invaded%20the%20Lake%20Superior%20region%20from%20the%20northwest%20and%20central%20Wisconsin%20from%20the%20south.%20Most%20of%20the%20Dresbach%20sediments%20accumulated%20in%20a%20beach%20environment,%20but%20in%20southern%20Wisconsin%20an%20offshore%20neritic%20environment%20predominated.%20Prior%20to%20Franconian%20time%20there%20was%20a%20widespread%20regression%20of%20the%20seas,%20and%20most%20of%20the%20region%20was%20subjected%20to%20subaerial%20erosion.%20By%20Franconian%20time%20the%20Northern%20Michigan%20highland%20was%20reduced%20to%20a%20surface%20of%20low%20relief,%20and%20the%20seas%20re-advanced%20across%20the%20entire%20area%20from%20the%20southwest.%20An%20appreciable%20amount%20of%20the%20Franconia%20sediments%20accumulated%20in%20an%20offshore%20environment.}}

@article{Turner2016a,
	annote = {10.1130/B31268.1},
	author = {Turner, E. C. and Bekker, A.},
	date = {2016/01/01},
	date-added = {2016-02-06 00:10:43 +0000},
	date-modified = {2020-09-17 06:30:10 -0700},
	doi = {10.1130/B31268.1},
	journal = {Geological Society of America Bulletin},
	journal1 = {Geological Society of America Bulletin},
	month = {01},
	number = {1-2},
	pages = {203--222},
	title = {{Thick sulfate evaporite accumulations marking a mid-Neoproterozoic oxygenation event (Ten Stone Formation, Northwest Territories, Canada)}},
	ty = {JOUR},
	volume = {128},
	year = {2016},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://gsabulletin.gsapubs.org/content/128/1-2/203.abstract%20N2%20-%20Thick%20sulfate%20evaporite%20accumulations%20are%20absent%20from%20Proterozoic%20strata%20between%20ca.%202000%20and%20ca.%201000%20Ma,%20and%20detailed%20sedimentologic,%20stratigraphic,%20and%20geochemical%20data%20for%20the%20oldest%20Neoproterozoic%20thick%20marine%20sulfate%20evaporite%20successions%20are%20largely%20lacking.%20The%20middle%20Neoproterozoic%20Ten%20Stone%20Formation%20(Little%20Dal%20Group,%20Northwest%20Territories,%20Canada)%20consists%20of%20%E2%88%BC500%20m%20of%20pelagic%20lagoonal%20gypsite%20and%20anhydritite%20(rocks%20consisting%20of%20the%20minerals%20gypsum%20and%20anhydrite)%20deposited%20shortly%20before%20the%20ca.%20811%20Ma%20Bitter%20Springs%20carbon%20isotope%20anomaly%20in%20an%20intracratonic%20basin%20that%20developed%20prior%20to%20breakup%20of%20Rodinia.%20The%20thickness%20of%20regional%20stratigraphic%20subdivisions%20of%20this%20formation,%20defined%20by%20subtle%20silt-%20and%20carbonate-bearing%20intervals,%20indicates%20a%20minor%20terrigenous%20source%20in%20the%20southeast%20and%20a%20silled%20connection%20to%20the%20open%20ocean%20in%20the%20northwest.%20Deposition%20of%20the%20Ten%20Stone%20Formation%20began%20with%20abrupt,%20tectonically%20triggered%20subsidence%20and%20restriction,%20and%20ended%20equally%20abruptly,%20as%20shown%20by%20stratigraphic%20contacts%20across%20which%20lithofacies%20corresponding%20to%20strikingly%20different%20paleoenvironments%20change%20sharply,%20with%20no%20evidence%20for%20hiatus%20or%20erosion.%20Stratigraphic%20cyclicity%20in%20the%20evaporite%20succession%20is%20minimal%20owing%20to%20isolation%20of%20bottom-hugging,%20dense%20lagoonal%20brine%20from%20overlying%20waters.%20Deposition%20of%20the%20Ten%20Stone%20Formation%20in%20a%20basin%20that%20experienced%20intermittent,%20basin-scale%20tectonic%20adjustments,%20as%20recorded%20by%20details%20of%20its%20stratigraphy,%20supports%20the%20interpretation%20that%20the%20Mackenzie%20Mountains%20Supergroup%20accumulated%20in%20an%20extensional,%20tectonically%20active%20intracratonic%20basin%20whose%20structure%20resembled%20a%20lower-plate%20extensional%20system.%20The%20absence%20of%20halite%20from%20the%20Ten%20Stone%20Formation%20contrasts%20with%20its%20abundance%20in%20the%20stratigraphically%20lower,%20gypsum-free%20Dodo%20Creek%20Formation,%20suggesting%20that%20deposition%20of%20the%20lower%20to%20middle%20Little%20Dal%20Group%20spanned%20a%20major%20oxygenation%20event,%20during%20which%20the%20sequence%20of%20evaporite%20mineral%20precipitation%20from%20seawater%20changed%20from%20halite-first%20to%20sulfate-first%20in%20response%20to%20rapid%20accumulation%20of%20atmospheric%20oxygen%20and%20concomitant%20increase%20in%20the%20global%20marine%20sulfate%20reservoir.%20The%20limited%20range%20of%20sulfur%20isotope%20values%20in%20a%20new%20data%20set%20spanning%20hundreds%20of%20meters%20of%20gypsite%20indicates%20a%20strongly%20and%20persistently%20oxidizing%20mid-Neoproterozoic%20atmosphere,%20an%20abundance%20of%20sulfate%20in%20seawater,%20and%20marine%20oxygenation%20extending%20below%20storm%20wave%20base.%20The%20mineralogy,%20sedimentology,%20stratigraphy,%20and%20geochemistry%20of%20the%20Ten%20Stone%20Formation%20are%20virtually%20indistinguishable%20from%20those%20of%20thick,%20Phanerozoic%20%E2%80%9Cdeep-water%E2%80%9D%20(below%20wave-base)%20evaporite%20successions,%20and%20indicate%20that%20the%20tectonic,%20climatic,%20and%20geochemical%20conditions%20required%20for%20deposition%20of%20thick%20successions%20of%20marine%20sulfate%20evaporites%20were%20well%20established%20prior%20to%20ca.%20811%20Ma.%20Thick%20sulfate%20evaporite%20successions%20in%20equivalent%20stratigraphic%20positions%20just%20below%20the%20Bitter%20Springs%20carbon%20isotope%20excursion%20elsewhere%20in%20Laurentia,%20as%20well%20as%20on%20the%20Congo%20craton,%20and%20in%20South%20Australia%20attest%20to%20the%20global%20impact%20of%20the%20rapidly%20increased%20seawater%20sulfate%20reservoir%20prior%20to%20Rodinia%E2%80%99s%20breakup.%20High%20relative%20burial%20rates%20of%20organic%20matter%20prevailed%20before%20the%20breakup%20of%20Rodinia%20and%20led%20to%20oxygenation%20of%20the%20atmosphere-ocean%20system,%20growth%20of%20the%20seawater%20sulfate%20reservoir,%20and,%20in%20association%20with%20a%20warm%20and%20arid%20climate,%20deposition%20for%20the%20first%20time%20in%20Earth%E2%80%99s%20history%20of%20thick%20sulfate%20evaporites%20in%20the%20middle%20Neoproterozoic,%20%E2%88%BC100%20m.y.%20before%20the%20first%20Cryogenian%20glacial%20episode.%20The%20Neoproterozoic%20Oxygenation%20Event%20may%20have%20taken%20place%20in%20several%20steps,%20the%20first%20of%20which%20preceded%20the%20Bitter%20Springs%20anomaly.}}

@article{Pehrsson2015a,
	annote = {10.1144/SP424.5},
	author = {Pehrsson, Sally J. and Eglington, Bruce M. and Evans, David A. D. and Huston, David and Reddy, Steven M.},
	date = {2015/06/04},
	date-added = {2016-02-05 21:45:59 +0000},
	date-modified = {2020-09-14 14:24:22 -0700},
	doi = {10.1144/SP424.5},
	journal = {Geological Society, London, Special Publications},
	journal1 = {Geological Society, London, Special Publications},
	pages = {83-94},
	title = {Metallogeny and its link to orogenic style during the {N}una supercontinent cycle},
	ty = {JOUR},
	volume = {424},
	year = {2015},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://sp.lyellcollection.org/content/early/2015/07/01/SP424.5.abstract%20N2%20-%20The%20link%20between%20observed%20episodicity%20in%20ore%20deposit%20formation%20and%20preservation%20and%20the%20supercontinent%20cycle%20is%20well%20established,%20but%20this%20general%20framework%20has%20not,%20however,%20been%20able%20to%20explain%20a%20lack%20of%20deposits%20associated%20with%20some%20accretionary%20orogens%20during%20specific%20periods%20of%20Earth%20history.%20Here%20we%20show%20that%20there%20are%20intriguing%20correlations%20between%20styles%20of%20orogenesis%20and%20specific%20mineral%20deposit%20types,%20in%20the%20context%20of%20the%20Nuna%20supercontinent%20cycle.%20Using%20animated%20global%20reconstructions%20of%20Nuna's%20assembly%20and%20initial%20breakup,%20and%20integrating%20extensive%20databases%20of%20mineral%20deposits,%20stratigraphy,%20geochronology%20and%20palaeomagnetism%20we%20are%20able%20to%20assess%20spatial%20patterns%20of%20deposit%20formation%20and%20preservation.%20We%20find%20that%20lode%20gold,%20volcanic-hosted-massive-sulphide%20and%20nickel%E2%80%93copper%20deposits%20peak%20during%20closure%20of%20Nuna's%20interior%20ocean%20but%20decline%20during%20subsequent%20peripheral%20orogenesis,%20suggesting%20that%20accretionary%20style%20is%20also%20important.%20Deposits%20such%20as%20intrusion-related%20gold,%20carbonate-hosted%20lead-zinc%20and%20unconformity%20uranium%20deposits%20are%20associated%20with%20the%20post-assembly,%20peripheral%20orogenic%20phase.%20These%20observations%20imply%20that%20the%20use%20of%20plate%20reconstructions%20to%20assess%20orogenic%20style,%20although%20challenging%20for%20the%20Precambrian,%20can%20be%20a%20powerful%20tool%20for%20mineral%20exploration%20targeting.Supplementary%20material:%20Supplementary%20material%20including%20(1)%20tables%20(S1%E2%80%93S3)%20of%20Euler%20poles%20and%20palaeopoles%20used,%20summary%20of%20Nuna%20orogens;%20(2)%20a%20figure%20(S1)%20of%20modelled%20plate%20velocities;%20(3)%20mp4%20files%20(S1%20&%20S2)%20of%20the%20model%20with%20age%20data;%20ore%20deposits%20and%20VGPs;%20and%20(4)%20a%20zip%20file%20(S1)%20of%20the%20Gplates%20model%20is%20available%20at%20http://www.geolsoc.org.uk/SUP18822.}}

