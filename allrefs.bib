	keywords = {carbonate_pmag},
	number = {2},
	pages = {283--298},
	title = {Quantitative controls on location and architecture of carbonate depositional sequences; upper Miocene, Cabo de Gata region, SE Spain},
	ty = {JOUR},
	volume = {68},
