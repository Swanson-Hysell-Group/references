@article{Thomas2014a,
	annote = {10.1130/G36289.1},
	author = {Thomas, Elizabeth K. and Clemens, Steven C. and Prell, Warren L. and Herbert, Timothy D. and Huang, Yongsong and Liu, Zhengyu and Sinninghe Damst{\'e}, Jaap S. and Sun, Youbin and Wen, Xinyu},
	date = {2014/10/17},
	date-added = {2014-11-18 18:28:47 +0000},
	date-modified = {2014-11-18 18:28:47 +0000},
	journal = {Geology},
	journal1 = {Geology},
	month = {10},
	title = {Temperature and leaf wax δ2H records demonstrate seasonal and regional controls on Asian monsoon proxies},
	ty = {JOUR},
	url = {http://geology.gsapubs.org/content/early/2014/10/17/G36289.1.abstract N2 - Orbital-scale precipitation isotope records can elucidate climate forcing mechanisms and provide benchmarks for climate model validation. The ability to differentiate the influence of temperature, seasonality, and vapor transport history on precipitation isotope proxies is critical to both objectives. We present a 300 k.y. leaf wax hydrogen isotope record from the South China Sea with the effects of local condensation temperature removed (δ2Hwax–T). δ2Hwax–T reflects annually integrated precipitation δ2H in the Pearl River catchment of southeast China. Depleted δ2Hwax–T lags minimum precession (Pmin) by 1.0 ± 0.7 k.y., reflecting the influence of maximum summer insolation and minimum winter insolation, with a minor influence of global ice volume, which lags Pmin by 3.3 ± 0.4 k.y. In contrast, annually integrated cave δ18O minima in central China, 1000 km north of our site, lag Pmin by 2.7 ± 0.3 k.y., in phase with ice volume minima. This phase indicates that precipitation δ18O in central China is more strongly influenced by ice volume forcing at the precession band, with a lesser influence of Northern Hemisphere insolation. Our new δ2Hwax–T data demonstrate that precipitation isotopes in Asia have strong regional variability. Interpreting water isotope records within the context of regionally varying temperature, seasonality, and sensitivity to changing glacial boundary conditions is imperative to understanding Asian hydroclimatic change.},
	year = {2014},
	bdsk-url-1 = {http://geology.gsapubs.org/content/early/2014/10/17/G36289.1.abstract%20N2%20-%20%20Orbital-scale%20precipitation%20isotope%20records%20can%20elucidate%20climate%20forcing%20mechanisms%20and%20provide%20benchmarks%20for%20climate%20model%20validation.%20The%20ability%20to%20differentiate%20the%20influence%20of%20temperature,%20seasonality,%20and%20vapor%20transport%20history%20on%20precipitation%20isotope%20proxies%20is%20critical%20to%20both%20objectives.%20We%20present%20a%20300%20k.y.%20leaf%20wax%20hydrogen%20isotope%20record%20from%20the%20South%20China%20Sea%20with%20the%20effects%20of%20local%20condensation%20temperature%20removed%20(%CE%B42Hwax%E2%80%93T).%20%CE%B42Hwax%E2%80%93T%20reflects%20annually%20integrated%20precipitation%20%CE%B42H%20in%20the%20Pearl%20River%20catchment%20of%20southeast%20China.%20Depleted%20%CE%B42Hwax%E2%80%93T%20lags%20minimum%20precession%20(Pmin)%20by%201.0%20%C2%B1%200.7%20k.y.,%20reflecting%20the%20influence%20of%20maximum%20summer%20insolation%20and%20minimum%20winter%20insolation,%20with%20a%20minor%20influence%20of%20global%20ice%20volume,%20which%20lags%20Pmin%20by%203.3%20%C2%B1%200.4%20k.y.%20In%20contrast,%20annually%20integrated%20cave%20%CE%B418O%20minima%20in%20central%20China,%201000%20km%20north%20of%20our%20site,%20lag%20Pmin%20by%202.7%20%C2%B1%200.3%20k.y.,%20in%20phase%20with%20ice%20volume%20minima.%20This%20phase%20indicates%20that%20precipitation%20%CE%B418O%20in%20central%20China%20is%20more%20strongly%20influenced%20by%20ice%20volume%20forcing%20at%20the%20precession%20band,%20with%20a%20lesser%20influence%20of%20Northern%20Hemisphere%20insolation.%20Our%20new%20%CE%B42Hwax%E2%80%93T%20data%20demonstrate%20that%20precipitation%20isotopes%20in%20Asia%20have%20strong%20regional%20variability.%20Interpreting%20water%20isotope%20records%20within%20the%20context%20of%20regionally%20varying%20temperature,%20seasonality,%20and%20sensitivity%20to%20changing%20glacial%20boundary%20conditions%20is%20imperative%20to%20understanding%20Asian%20hydroclimatic%20change.}}

