	title = {Fine-tuning the calibration of the early to middle Eocene geomagnetic polarity time scale: Paleomagnetism of radioisotopically dated tuffs from Laramide foreland basins},
	ty = {JOUR},
	volume = {124},
	year = {2012},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://gsabulletin.gsapubs.org/content/124/5-6/870.abstract%20N2%20-%20Age%20calibration%20of%20the%20early%20to%20middle%20Eocene%20geomagnetic%20polarity%20time%20scale%20remains%20highly%20uncertain%20due%20to%20conflicting%20magnetostratigraphic,%20radioisotopic,%20and%20astrochronologic%20results.%20In%20this%20study,%20new%20paleomagnetic%20polarity%20determinations%20of%2029%20ash-fall%20tuffs%20preserved%20in%20strata%20of%20five%20Laramide%20foreland%20basins%20were%20used%20in%20conjunction%20with%20previously%20published%2040Ar/39Ar%20ages%20from%20the%20same%20tuffs%20to%20evaluate%20eight%20different%20calibration%20models%20for%20the%20early%20to%20middle%20Eocene%20part%20of%20the%20geomagnetic%20polarity%20time%20scale.%20Reliable%20paleomagnetic%20information%20was%20recovered%20from%2023%20tuffs,%20of%20which%2017%20showed%20normal%20polarity%20and%20six%20showed%20reversed%20polarity.%20After%20comparison%20of%20the%20models%20with%20the%20paleomagnetic%20and%20radioisotopic%20data%20from%20the%20tuffs%20and%20an%20array%20of%20independent%20chronostratigraphic%20observations,%20the%20new%20Willwood%20model%20is%20herein%20selected%20as%20the%20best%20alternative%20to%20the%20current%20geomagnetic%20polarity%20time%20scale%20calibration%20for%20the%20early%20to%20middle%20Eocene.%20Three%20important%20implications%20are%20apparent%20in%20our%20proposed%20model.%20First,%20the%20early%20Eocene%20is%20shortened%20by%200.6%20m.y.,%20and%20the%20middle%20Eocene%20is%20lengthened%20by%200.8%20m.y.%20compared%20with%20the%202004%20geomagnetic%20polarity%20time%20scale.%20Also,%20the%20early%20Eocene%20climatic%20optimum%20is%20estimated%20to%20have%20lasted%20from%2052.9%20to%2050.7%20Ma,%20%E2%88%BC1%20m.y.%20longer%20than%20previously%20suggested,%20and%20overlapping%20in%20time%20with%20the%20inferred%20age%20of%20the%20Wasatchian-Bridgerian%20faunal%20transition.%20Our%20new%20model%20agrees%20with%20a%20previous%20astronomical%20model%20when%20it%20is%20tied%20to%20the%20oldest%20proposed%20age%20for%20the%20Paleocene-Eocene%20Thermal%20Maximum%20at%2056.33%20Ma.}}

