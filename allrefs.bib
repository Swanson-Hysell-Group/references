@article{Lee2015a,
	annote = {10.1130/G37236.1},
	author = {Lee, Carina and Love, Gordon D. and Fischer, Woodward W. and Grotzinger, John P. and Halverson, Galen P.},
	date = {2015/11/06},
	date-added = {2015-11-12 18:34:56 +0000},
	date-modified = {2015-11-12 18:34:56 +0000},
	journal = {Geology},
	journal1 = {Geology},
	month = {11},
	title = {Marine organic matter cycling during the Ediacaran Shuram excursion},
	ty = {JOUR},
	url = {http://geology.gsapubs.org/content/early/2015/11/05/G37236.1.abstract N2 - Ediacaran (ca. 635–541 Ma) marine carbonates capture a global δ13C carbon isotope excursion to extremely negative values (~–12‰)—known as the Shuram excursion (SE)—that cannot be explained by conventional mass balance scenarios. Furthermore, the carbon isotopic variation of bulk organic matter (OM) does not mirror that of carbonate through the excursion, suggesting that the OM reflects a mixture of different sources. To evaluate this hypothesis, we investigated thermally immature marine sedimentary rocks that record the SE from the Sultanate of Oman. Compound-specific carbon isotopic analyses of the extractable hydrocarbons reveal low δ13C values of long-chain (>C20) n-alkanes and mid-chain monomethyl alkanes as low as –40‰. Such light signatures are rare in marine rocks of any age and provide evidence that the SE reflects a primary carbon cycle perturbation. The magnitude of the SE recorded in these organic phases is smaller than observed in carbonate and implies that the primary perturbation to dissolved inorganic carbon (DIC) was at least 5‰–7‰, and more likely 7‰–12‰, in magnitude when correcting for end-member source mixing. Due to isotopic differences in stratigraphic patterns of the different organic compounds, we propose that bulk organic carbon (both bitumen and kerogen) reflects source mixing between two distinct pools that previously masked the excursion in bulk δ13Corg measurements. OM sources were derived both from autotrophs fixing 13C-depleted DIC and from a less 13C-depleted heterotrophic microbial biomass feeding on a marine OM pool sustained by petroleum expelled from older sedimentary OM. Expulsion of these sedimentary fluids also helps explain both the duration and magnitude of the SE.},
	year = {2015},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://geology.gsapubs.org/content/early/2015/11/05/G37236.1.abstract%20N2%20-%20Ediacaran%20(ca.%20635%E2%80%93541%20Ma)%20marine%20carbonates%20capture%20a%20global%20%CE%B413C%20carbon%20isotope%20excursion%20to%20extremely%20negative%20values%20(~%E2%80%9312%E2%80%B0)%E2%80%94known%20as%20the%20Shuram%20excursion%20(SE)%E2%80%94that%20cannot%20be%20explained%20by%20conventional%20mass%20balance%20scenarios.%20Furthermore,%20the%20carbon%20isotopic%20variation%20of%20bulk%20organic%20matter%20(OM)%20does%20not%20mirror%20that%20of%20carbonate%20through%20the%20excursion,%20suggesting%20that%20the%20OM%20reflects%20a%20mixture%20of%20different%20sources.%20To%20evaluate%20this%20hypothesis,%20we%20investigated%20thermally%20immature%20marine%20sedimentary%20rocks%20that%20record%20the%20SE%20from%20the%20Sultanate%20of%20Oman.%20Compound-specific%20carbon%20isotopic%20analyses%20of%20the%20extractable%20hydrocarbons%20reveal%20low%20%CE%B413C%20values%20of%20long-chain%20(%3EC20)%20n-alkanes%20and%20mid-chain%20monomethyl%20alkanes%20as%20low%20as%20%E2%80%9340%E2%80%B0.%20Such%20light%20signatures%20are%20rare%20in%20marine%20rocks%20of%20any%20age%20and%20provide%20evidence%20that%20the%20SE%20reflects%20a%20primary%20carbon%20cycle%20perturbation.%20The%20magnitude%20of%20the%20SE%20recorded%20in%20these%20organic%20phases%20is%20smaller%20than%20observed%20in%20carbonate%20and%20implies%20that%20the%20primary%20perturbation%20to%20dissolved%20inorganic%20carbon%20(DIC)%20was%20at%20least%205%E2%80%B0%E2%80%937%E2%80%B0,%20and%20more%20likely%207%E2%80%B0%E2%80%9312%E2%80%B0,%20in%20magnitude%20when%20correcting%20for%20end-member%20source%20mixing.%20Due%20to%20isotopic%20differences%20in%20stratigraphic%20patterns%20of%20the%20different%20organic%20compounds,%20we%20propose%20that%20bulk%20organic%20carbon%20(both%20bitumen%20and%20kerogen)%20reflects%20source%20mixing%20between%20two%20distinct%20pools%20that%20previously%20masked%20the%20excursion%20in%20bulk%20%CE%B413Corg%20measurements.%20OM%20sources%20were%20derived%20both%20from%20autotrophs%20fixing%2013C-depleted%20DIC%20and%20from%20a%20less%2013C-depleted%20heterotrophic%20microbial%20biomass%20feeding%20on%20a%20marine%20OM%20pool%20sustained%20by%20petroleum%20expelled%20from%20older%20sedimentary%20OM.%20Expulsion%20of%20these%20sedimentary%20fluids%20also%20helps%20explain%20both%20the%20duration%20and%20magnitude%20of%20the%20SE.}}

