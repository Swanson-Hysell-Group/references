	abstract = {We examine the general conditions that must be satisfied by the configuration of the continents in order that steady state solutions for Neoproterozoic climate exist that are characterized by heavy continental glaciation but for which a substantial area of open water in the equatorial region persists. Such solutions have previously been termed \&{\#}8220;soft snowball\&{\#}8221; or \&{\#}8220;slush ball\&{\#}8221; to distinguish them from the \&{\#}8220;hard snowball\&{\#}8221; solutions that some have suggested be required to fit the observational constraints. It is found that three conditions are critical in this regard: (1) the continental area in high latitudes should be large enough that a massive ice sheet may develop even when pCO2 is relatively high, an ice sheet complex that is subsequently capable of flowing to lower latitude. (2) The continental fragments in low latitude must be connected (or separated only by continental shelves above which water depths are small) to a significant degree with those at higher latitudes. (3) A relatively simple supercontinental outline favors the formation of the \&{\#}8220;soft snowball\&{\#}8221; state. Although the latter requirement is important, we have nevertheless found that soft snowball solutions are realized for the realistic Sturtian continental configuration of Li et al. (2008) that existed at \&{\#}8764;720 Ma. However, in order for these states to exist, the positions of the individual continental fragments must be slightly adjusted so as to improve their connectivity. These adjustments are consistent with the error bars on the paleomagnetic inferences of paleolatitude and the even less well constrained paleolongitude. We also demonstrate that \&{\#}8220;soft snowball\&{\#}8221; solutions do not exist in models devoid of active continental ice sheets capable of flowing over the landscape. These results for Sturtian conditions extend our previously published results for the Marinoan period during which the supercontinent was centered upon much higher latitudes.},
	author = {Liu, Yonggang and Peltier, W. Richard},
	date = {2010/09/09},
	date-added = {2010-11-06 15:19:50 -0400},
	date-modified = {2011-02-02 09:42:44 -0500},
	do = {10.1029/2009JD013082},
	isbn = {0148-0227},
	journal = {J. Geophys. Res.},
	keywords = {snowball Earth; Neoproterozoic; glaciation; slush ball; Sturtian; Marinoan; 3344 Atmospheric Processes: Paleoclimatology; 0726 Cryosphere: Ice sheets; 0774 Cryosphere: Dynamics; 0798 Cryosphere: Modeling; 5416 Planetary Sciences: Solid Surface Planets: Glaciation},
	month = {09},
	number = {D17},
	publisher = {AGU},
	sp = {D17111},
	title = {A carbon cycle coupled climate model of Neoproterozoic glaciation: Influence of continental configuration on the formation of a \&{\#}8220;soft snowball\&{\#}8221;},
	ty = {JOUR},
	volume = {115},
	year = {2010},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://dx.doi.org/10.1029/2009JD013082}}

