@article{Maliva2005a,
	annote = {10.1130/B25555.1},
	author = {Maliva, Robert G. and Knoll, Andrew H. and Simonson, Bruce M.},
	date = {2005},
	date-added = {2014-05-07 19:02:24 +0000},
	date-modified = {2014-05-07 19:02:34 +0000},
	journal = {Geological Society of America Bulletin},
	journal1 = {Geological Society of America Bulletin},
	number = {7-8},
	pages = {835--845},
	title = {Secular change in the Precambrian silica cycle: Insights from chert petrology},
	ty = {JOUR},
	url = {http://gsabulletin.gsapubs.org/content/117/7-8/835.abstract N2 - Chert deposits preserve a record of secular change in the oceanic silica cycle. The evolutionary radiation of silica-secreting organisms resulted in a transition from abiological silica deposition, characteristic of the Archean and Proterozoic eons, to the predominantly biologically controlled silica deposition of the Phanerozoic. Comparative petrography of Phanerozoic and Precambrian cherts indicates that an earlier change in chert deposition occurred toward the end of the Paleoproterozoic era (ca. 1.8 Ga). In Neoproterozoic and Mesoproterozoic strata, early diagenetic chertification is largely restricted to peritidal environments. These early diagenetic cherts typically occur as nodules or discontinuous beds within carbonate deposits that have similar depositional textures. The cherts formed primarily by carbonate replacement with subsidiary direct silica precipitation. Some of the Paleoproterozoic cherts associated with iron formations, however, are distinctly different from younger cherts and appear to have formed largely by direct silica precipitation at or just below the seabed. These primary cherts lack ghosts or inclusions of carbonate precursors, have fine-scale grain fracturing (possibly from syneresis), exhibit low grain-packing densities, and are not associated with unsilicified carbonate deposits of similar depositional composition. Cherts in some Paleoproterozoic iron formations (e.g., the Gunflint Formation, northwestern Lake Superior region) are composed of silica types similar to those in Phanerozoic sinters (e.g., the Devonian Rhynie and Windyfield cherts, Scotland). Such cherts may provide evidence that basinal, and perhaps global, oceanic silica concentrations were higher during the Paleoproterozoic era than at later times.},
	volume = {117},
	year = {July},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://gsabulletin.gsapubs.org/content/117/7-8/835.abstract%20N2%20-%20Chert%20deposits%20preserve%20a%20record%20of%20secular%20change%20in%20the%20oceanic%20silica%20cycle.%20The%20evolutionary%20radiation%20of%20silica-secreting%20organisms%20resulted%20in%20a%20transition%20from%20abiological%20silica%20deposition,%20characteristic%20of%20the%20Archean%20and%20Proterozoic%20eons,%20to%20the%20predominantly%20biologically%20controlled%20silica%20deposition%20of%20the%20Phanerozoic.%20Comparative%20petrography%20of%20Phanerozoic%20and%20Precambrian%20cherts%20indicates%20that%20an%20earlier%20change%20in%20chert%20deposition%20occurred%20toward%20the%20end%20of%20the%20Paleoproterozoic%20era%20(ca.%201.8%20Ga).%20In%20Neoproterozoic%20and%20Mesoproterozoic%20strata,%20early%20diagenetic%20chertification%20is%20largely%20restricted%20to%20peritidal%20environments.%20These%20early%20diagenetic%20cherts%20typically%20occur%20as%20nodules%20or%20discontinuous%20beds%20within%20carbonate%20deposits%20that%20have%20similar%20depositional%20textures.%20The%20cherts%20formed%20primarily%20by%20carbonate%20replacement%20with%20subsidiary%20direct%20silica%20precipitation.%20Some%20of%20the%20Paleoproterozoic%20cherts%20associated%20with%20iron%20formations,%20however,%20are%20distinctly%20different%20from%20younger%20cherts%20and%20appear%20to%20have%20formed%20largely%20by%20direct%20silica%20precipitation%20at%20or%20just%20below%20the%20seabed.%20These%20primary%20cherts%20lack%20ghosts%20or%20inclusions%20of%20carbonate%20precursors,%20have%20fine-scale%20grain%20fracturing%20(possibly%20from%20syneresis),%20exhibit%20low%20grain-packing%20densities,%20and%20are%20not%20associated%20with%20unsilicified%20carbonate%20deposits%20of%20similar%20depositional%20composition.%20Cherts%20in%20some%20Paleoproterozoic%20iron%20formations%20(e.g.,%20the%20Gunflint%20Formation,%20northwestern%20Lake%20Superior%20region)%20are%20composed%20of%20silica%20types%20similar%20to%20those%20in%20Phanerozoic%20sinters%20(e.g.,%20the%20Devonian%20Rhynie%20and%20Windyfield%20cherts,%20Scotland).%20Such%20cherts%20may%20provide%20evidence%20that%20basinal,%20and%20perhaps%20global,%20oceanic%20silica%20concentrations%20were%20higher%20during%20the%20Paleoproterozoic%20era%20than%20at%20later%20times.}}

@article{Grey2011b,
	abstract = {Cryogenian correlation in Australia is based on an extensive data set from the Centralian Superbasin and Adelaide Rift Complex and integrates biostratigraphy and isotope chemostratigraphy to provide a three-dimensional interpretation based on outcrop and drill holes. Studies are ongoing, but newer data are consistent with the distributions discussed here. From the chemostratigraphic and biostratigraphic viewpoint, the first appearance of the acritarch Cerebrosphaera buickii, coupled with a large negative isotope excursion at c. 800 Ma, supported by the first appearance of the stromatolite Baicalia burra, seems to have potential for boundary placement. It is widely recognized across Australia and seems to have potential globally.},
