@article{KNOLL2013a,
	annote = {10.2110/palo.2013.p13-005r},
	author = {Knoll, ANDREW H. and W{\"o}rndle, SARAH and Kah, LINDA C.},
	date-added = {2014-03-18 20:57:27 +0000},
	date-modified = {2014-03-18 21:16:56 +0000},
	doi = {10.2110/palo.2013.p13-005r},
	journal = {PALAIOS},
	month = {07},
	number = {7},
	pages = {453--470},
	title = {COVARIANCE OF MICROFOSSIL ASSEMBLAGES AND MICROBIALITE TEXTURES ACROSS AN UPPER {M}ESOPROTEROZOIC CARBONATE PLATFORM},
	volume = {28},
	year = {2013},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://palaios.sepmonline.org/content/28/7/453.abstract%20N2%20-%20Early%20diagenetic%20chert%20nodules%20and%20beds%20in%20the%20upper%20Mesoproterozoic%20Angmaat%20(formerly%20Society%20Cliffs)%20Formation,%20Baffin%20and%20Bylot%20islands,%20preserve%20microfossils%20and%20primary%20petrofabrics%20that%20record%20microbial%20mat%20deposition%20and%20lithification%20across%20a%20range%20of%20peritidal%20carbonate%20environments.%20Five%20distinct%20microfossil%20assemblages%20document%20the%20distribution%20of%20mat-building%20and%20mat-dwelling%20populations%20across%20a%20gradient%20from%20restricted,%20frequently%20exposed%20flats%20to%20more%20persistently%20subaqueous%20environments.%20Mats%20built%20primarily%20by%20thin%20filamentous%20or%20coccoidal%20cyanobacteria%20give%20way%20to%20a%20series%20of%20more%20robust%20forms%20that%20show%20increasing%20assemblage%20diversity%20with%20decreasing%20evidence%20of%20subaerial%20exposure.%20Distinct%20fabric%20elements%20are%20associated%20with%20each%20microbial%20assemblage,%20and%20aspects%20of%20these%20petrofabrics%20are%20recognizably%20preserved%20within%20unsilicified%20carbonate%20in%20the%20same%20beds.%20These%20include%20some%20features%20that%20are%20distinctly%20geologic%20in%20nature%20(e.g.,%20seafloor%20cements)%20and%20others%20that%20reflect%20microbial%20growth%20and%20decomposition%20(e.g.,%20tufted%20microbialites).%20A%20particularly%20distinctive,%20micronodular%20fabric%20is%20here%20interpreted%20as%20carbonate%20infilling%20of%20primary%20voids%20within%20microbial%20mat%20structures.%20Such%20structures%20mark%20the%20co-occurrence%20of%20cyanobacterial%20photosynthesis%20that%20produced%20oxygen%20gas,%20filamentous%20mat%20builders%20that%20imparted%20the%20coherence%20necessary%20to%20trap%20gas%20bubbles,%20elevated%20carbonate%20saturation%20required%20to%20preserve%20void%20fabrics%20via%20penecontemporaneous%20cementation,%20and%20a%20relative%20paucity%20of%20detrital%20sediment%20that%20would%20have%20inhibited%20mat%20growth.%20Petrofabrics%20preserved%20in%20Angmaat%20samples%20are%20widespread%20in%20upper%20Paleoproterozoic%20and%20Mesoproterozoic%20carbonate%20successions%20but%20are%20rare%20thereafter,%20perhaps%20recording,%20at%20least%20in%20part,%20the%20declining%20carbonate%20saturation%20state%20of%20seawater.%20Covariation%20of%20microfossil%20assemblages%20with%20petrofabrics%20in%20both%20silicified%20and%20unsilicified%20portions%20of%20carbonate%20beds%20supports%20hypotheses%20that%20link%20stromatolite%20microstructure%20to%20the%20composition%20and%20diversity%20of%20mat%20communities.}}

@article{Lenton2014a,
	annote = {The Neoproterozoic era (about 1,000 to 542 million years ago) was a time of turbulent environmental change. Large fluctuations in the carbon cycle were associated with at least two severe {$[$}mdash{$]$} possible Snowball Earth {$[$}mdash{$]$} glaciations. There were also massive changes in the redox state of the oceans, culminating in the oxygenation of much of the deep oceans. Amid this environmental change, increasingly complex life forms evolved. The traditional view is that a rise in atmospheric oxygen concentrations led to the oxygenation of the ocean, thus triggering the evolution of animals. We argue instead that the evolution of increasingly complex eukaryotes, including the first animals, could have oxygenated the ocean without requiring an increase in atmospheric oxygen. We propose that large eukaryotic particles sank quickly through the water column and reduced the consumption of oxygen in the surface waters. Combined with the advent of benthic filter feeding, this shifted oxygen demand away from the surface to greater depths and into sediments, allowing oxygen to reach deeper waters. The decline in bottom-water anoxia would hinder the release of phosphorus from sediments, potentially triggering a potent positive feedback: phosphorus removal from the ocean reduced global productivity and ocean-wide oxygen demand, resulting in oxygenation of the deep ocean. That, in turn, would have further reinforced eukaryote evolution, phosphorus removal and ocean oxygenation.},
	author = {Lenton, Timothy M. and Boyle, Richard A. and Poulton, Simon W. and Shields-Zhou, Graham A. and Butterfield, Nicholas J.},
	date = {2014/03/09/online},
	date-added = {2014-03-18 20:55:21 +0000},
	date-modified = {2015-03-02 18:31:57 +0000},
	day = {09},
	doi = {10.1038/ngeo2108},
	isbn = {1752-0908},
	journal = {Nature Geoscience},
	month = {03},
	title = {Co-evolution of eukaryotes and ocean oxygenation in the Neoproterozoic era},
	ty = {JOUR},
	year = {2014},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://dx.doi.org/10.1038/ngeo2108}}

