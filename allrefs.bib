	number = {5},
	pages = {473-485},
	read = {Yes},
	title = {Magnetostratigraphy Of Lower Pleistocene Banyoles Palaeolake Carbonate Sediments From Catalonia, Ne Spain - Evidence For Relocation Of The Cobb Mountain Sub-Chron},
	volume = {14},
	year = {1995},
	bdsk-file-1 = {}}

