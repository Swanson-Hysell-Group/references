	isbn = {1464-343X},
	journal = {Journal of African Earth Sciences},
	month = {4},
	number = {3},
	pages = {255--268},
	title = {{Depositional environments of the Meso- to Neoproterozoic Ghanzi-Chobe belt, northwest Botswana}},
	ty = {JOUR},
