@article{Andersen1995a,
	annote = {10.1130/0091-7613(1995)023<0983:TCINIC>2.3.CO;2},
	author = {Andersen, C. B. and Samson, Scott D.},
	date-added = {2017-01-06 17:20:23 +0000},
	date-modified = {2017-01-06 17:21:46 +0000},
	doi = {10.1130/0091-7613(1995)023<0983:TCINIC>2.3.CO;2},
	journal = {Geology},
	journal1 = {Geology},
	number = {11},
	pages = {983--986},
	title = {{Temporal changes in Nd isotopic composition of sedimentary rocks in the Sevier and Taconic foreland basins: Increasing influence of juvenile sources}},
	ty = {JOUR},
	url = {http://geology.gsapubs.org/content/23/11/983.abstract N2 - Initial 143Nd/144Nd ratios of clastic sedimentary rocks in the Ordovician Taconic and Sevier foreland basins increase with decreasing stratigraphic age. This shift in isotopic composition reflects an increased influx of juvenile sediment to both basins. For the Taconic basin, geologic and isotopic data are consistent with the juvenile sediment being derived from uplifted Grenville crust, upthrust as part of the Taconic allochthons, sediment derived from the Bronson Hill arc, or a combination of both. For the Sevier foreland basin, there are few geologic constraints on source regions, but the similar shift in isotopic ratios with time suggests a similar increase in the influence of juvenile sources such as exotic terranes. Sevier basin sedimentary rocks have higher ϵNd values than those within the Taconic basin, thus juvenile source areas were of greater importance to Sevier basin sediments.},
	volume = {23},
	year = {1995},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://geology.gsapubs.org/content/23/11/983.abstract%20N2%20-%20Initial%20143Nd/144Nd%20ratios%20of%20clastic%20sedimentary%20rocks%20in%20the%20Ordovician%20Taconic%20and%20Sevier%20foreland%20basins%20increase%20with%20decreasing%20stratigraphic%20age.%20This%20shift%20in%20isotopic%20composition%20reflects%20an%20increased%20influx%20of%20juvenile%20sediment%20to%20both%20basins.%20For%20the%20Taconic%20basin,%20geologic%20and%20isotopic%20data%20are%20consistent%20with%20the%20juvenile%20sediment%20being%20derived%20from%20uplifted%20Grenville%20crust,%20upthrust%20as%20part%20of%20the%20Taconic%20allochthons,%20sediment%20derived%20from%20the%20Bronson%20Hill%20arc,%20or%20a%20combination%20of%20both.%20For%20the%20Sevier%20foreland%20basin,%20there%20are%20few%20geologic%20constraints%20on%20source%20regions,%20but%20the%20similar%20shift%20in%20isotopic%20ratios%20with%20time%20suggests%20a%20similar%20increase%20in%20the%20influence%20of%20juvenile%20sources%20such%20as%20exotic%20terranes.%20Sevier%20basin%20sedimentary%20rocks%20have%20higher%20%CF%B5Nd%20values%20than%20those%20within%20the%20Taconic%20basin,%20thus%20juvenile%20source%20areas%20were%20of%20greater%20importance%20to%20Sevier%20basin%20sediments.}}

