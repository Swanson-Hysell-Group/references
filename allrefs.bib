@article{Scotese2009a,
	annote = {10.1144/SP326.4},
	author = {Scotese, Christopher R.},
	date = {2009/01/01},
	date-added = {2011-03-16 16:47:02 -0400},
	date-modified = {2012-10-29 20:46:20 +0000},
	journal = {Geological Society, London, Special Publications},
	journal1 = {Geological Society, London, Special Publications},
	month = {01},
	number = {1},
	pages = {67--83},
	title = {Late Proterozoic plate tectonics and palaeogeography: a tale of two supercontinents, Rodinia and Pannotia},
	ty = {JOUR},
	volume = {326},
	year = {2009},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://sp.lyellcollection.org/content/326/1/67.abstract%20N2%20-%20The%20plate%20tectonic%20and%20palaeogeographic%20history%20of%20the%20late%20Proterozoic%20is%20a%20tale%20of%20two%20supercontinents:%20Rodinia%20and%20Pannotia.%20Rodinia%20formed%20during%20the%20Grenville%20Event%20(c.%201100%20Ma)%20and%20remained%20intact%20until%20its%20collision%20with%20the%20Congo%20continent%20(800%E2%80%93750%20Ma).%20This%20collision%20closed%20the%20southern%20part%20of%20the%20Mozambique%20Seaway,%20and%20triggered%20the%20break-up%20of%20Rodinia.%20The%20Panthalassic%20Ocean%20opened%20as%20the%20supercontinent%20of%20Rodinia%20split%20into%20a%20northern%20half%20(East%20Gondwana,%20Cathyasia%20and%20Cimmeria)%20and%20a%20southern%20half%20(Laurentia,%20Amazonia%E2%80%93NW%20Africa,%20Baltica,%20and%20Siberia).%20Over%20the%20next%20150%20Ma,%20North%20Rodinia%20rotated%20counter-clockwise%20over%20the%20North%20Pole,%20while%20South%20Rodinia%20rotated%20clockwise%20across%20the%20South%20Pole.%20In%20the%20latest%20Precambrian%20(650%E2%80%93550%20Ma),%20the%20three%20Neoproterozoic%20continents%20%E2%80%93%20North%20Rodinia,%20South%20Rodinia%20and%20the%20Congo%20continents%20%E2%80%93%20collided%20during%20the%20Pan-Africa%20Event%20forming%20the%20second%20Neoproterozoic%20supercontinent,%20Pannotia%20(Greater%20Gondwanaland).%20Pan-African%20mountain%20building%20and%20the%20fall%20in%20sea%20level%20associated%20with%20the%20assembly%20of%20Pannotia%20may%20have%20triggered%20the%20extreme%20Ice%20House%20conditions%20that%20characterize%20the%20middle%20and%20late%20Neoproterozoic.%20Although%20the%20palaeogeographic%20maps%20presented%20here%20do%20not%20prohibit%20a%20Snowball%20Earth,%20the%20mapped%20extent%20of%20Neoproterozoic%20ice%20sheets%20favour%20a%20bipolar%20Ice%20House%20World%20with%20a%20broad%20expanse%20of%20ocean%20at%20the%20equator.%20Soon%20after%20it%20was%20assembled%20(c.%20560%20Ma),%20Pannotia%20broke%20apart%20into%20the%20four%20principal%20Palaeozoic%20continents:%20Laurentia%20(North%20America),%20Baltica%20(northern%20Europe),%20Siberia%20and%20Gondwana.%20The%20amalgamation%20and%20subsequent%20break-up%20of%20Pannotia%20may%20have%20triggered%20the%20%E2%80%98Cambrian%20Explosion%E2%80%99.%20The%20first%20economically%20important%20accumulations%20of%20hydrocarbons%20are%20from%20Neoproterozoic%20sources.%20The%20two%20major%20source%20rocks%20of%20this%20age%20(Nepa%20of%20Siberia%20and%20Huqf%20of%20Oman)%20occur%20in%20association%20with%20massive%20Neoproterozoic%20evaporite%20deposits%20and%20in%20the%20warm%20equatorial%E2%80%93subtropical%20belt,%20within%2030%C2%B0%20of%20the%20equator.}}

@article{Kent1979a,
	abstract = {Ninety-six oriented samples were collected from 13 sites in the Onondaga limestone of New York for paleomagnetic study, including rock magnetism and magnetic susceptibility anisotropy. The sites were located in a small penecontemporaneous fold and a larger fold of imprecisely known origin, as well as flatlying beds. The natural remanent magnetizations (NRM) give directions (declination 195.1∞, inclination 84.4∞, and \&{\#}945;95 = 6.9∞for N = 13 sites) that are similar to those originally measured for the Onondaga limestone by Graham (1956). Alternating field and thermal demagnetization analyses show that the NRM is a composite of a large viscous component along the present geomagnetic field and a smaller, more stable component of magnetization with a shallow and southerly direction. The site mean directions after 300 Oe of magnetic cleaning, but without correction for bedding tilt, give a formation mean of declination 168.7∞, inclination 13.6∞, and \&{\#}945;95 = 8.3∞for N = 9 sites (the magnetizations at four sites could not be adequately resolved and are omitted). Although the stable magnetization is shown to be of postfolding origin, essentially the same direction is obtained at sites with flat-lying bedding as at the sites with folded bedding prior to tilt correction. Rock magnetic investigations indicate that some form of magnetite is the important magnetic mineral in the limestone. The similarity in magnetic fabric between a small penecontemporaneous fold and a larger fold suggests acquisition of magnetic properties while the sediment was still unconsolidated. The postfolding origin of stable remanence is therefore interpreted as a form of postdepositional detrital remanent magnetism. The paleomagnetic pole position derived from the formation mean direction is located at latitude 39.7∞N, longitude 120.7∞E (dp = 4.3∞, dm = 8.5∞) and agrees reasonably well with other Devonian poles from cratonic North America, although a Permian age for the magnetizations of the Onondaga cannot be entirely discounted.},
	author = {Kent, Dennis V.},
	date-added = {2011-03-16 12:59:37 -0400},
	date-modified = {2012-10-29 20:46:20 +0000},
	do = {10.1029/JB084iB07p03576},
	isbn = {0148-0227},
	journal = {J. Geophys. Res.},
	number = {B7},
	pages = {3576--3588},
	publisher = {AGU},
	title = {Paleomagnetism of the Devonian Onondaga Limestone Revisited},
	ty = {JOUR},
	volume = {84},
	year = {1979},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://dx.doi.org/10.1029/JB084iB07p03576}}

