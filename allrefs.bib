	pages = {395--398},
	title = {The oldest evidence of bioturbation on Earth},
	ty = {JOUR},
	volume = {40},
	year = {2012},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://geology.gsapubs.org/content/40/5/395.abstract%20N2%20-%20Detailed%20study%20of%20the%20Khatyspyt%20Formation%20in%20arctic%20Siberia%20has%20shown%20that,%20contrary%20to%20common%20expectations,%20the%20earliest%20ichnofabric%20is%20of%20late%20Ediacaran%20age,%20records%20a%20food-seeking%20behavior,%20and%20is%20found%20in%20a%20distal%20carbonate%20ramp%20setting%20where%20it%20co-occurs%20with%20fossils%20of%20Avalon-type%20Ediacaran%20soft-bodied%20organisms.%20Preserved%20depth%20of%20bioturbation%20reaches%205%20cm.%20The%20ichnofabric%20solely%20comprises%20Nenoxites,%20the%20oldest%20known%20meniscate%20trace%20fossil,%20which%20is%20interpreted%20as%20burrows%20with%20terminal%20backfill%20structure%20formed%20as%20a%20result%20of%20active%20displacement%20of%20sediment%20to%20form%20a%20tunnel%20within%20the%20substrate,%20followed%20by%20emplacement%20of%20the%20material%20behind%20the%20animal%20as%20it%20progressed%20through%20the%20sediment.%20In%20addition%20to%20being%20the%20most%20reliable%20paleontological%20evidence%20for%20the%20existence%20of%20bilaterians%20at%20ca.%20555%20Ma,%20the%20late%20Ediacaran%20bioturbation%20is%20regarded%20as%20a%20key%20step%20in%20the%20escalatory%20%E2%80%9Cengineering%E2%80%9D%20of%20Phanerozoic%20ecospace%20leading%20to%20sudden%20diversification%20of%20macroscopic%20organisms%20and%20macrocommunities.}}

@article{Ward2012a,
	annote = {10.1130/B30077.1},
	author = {Ward, Peter D. and Haggart, James W. and Mitchell, Ross and Kirschvink, Joseph L. and Tobin, Thomas},
	date = {2012/05/01},
	date-added = {2012-05-02 14:40:23 +0000},
	date-modified = {2012-10-29 20:46:18 +0000},
	journal = {Geological Society of America Bulletin},
	journal1 = {Geological Society of America Bulletin},
	month = {05},
	number = {5-6},
	pages = {957--974},
	title = {Integration of macrofossil biostratigraphy and magnetostratigraphy for the Pacific Coast Upper Cretaceous (Campanian--Maastrichtian) of North America and implications for correlation with the Western Interior and Tethys},
	ty = {JOUR},
	volume = {124},
	year = {2012},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://gsabulletin.gsapubs.org/content/124/5-6/957.abstract%20N2%20-%20New%20biostratigraphic%20data%20obtained%20from%20measured%20stratigraphic%20sections%20of%20Santonian%20through%20Maastrichtian%20age%20located%20along%20the%20west%20coast%20of%20North%20America%20necessitate%20changes%20to%20the%20currently%20accepted%20chronostratigraphic%20framework%20for%20this%20region%20of%20the%20North%20Pacific%20biotic%20province.%20We%20recognize%20and/or%20define%2012%20molluscan%20zones%20over%20this%20interval%20of%20the%20Upper%20Cretaceous%20and%20propose%20revisions%20to%20the%20currently%20accepted%20integration%20of%20ammonite%20zones%20with%20global%20Upper%20Cretaceous%20magnetochrons.%20Our%20findings%20demonstrate%20that%20there%20was%20significantly%20more%20faunal%20interchange%20between%20the%20North%20American%20Pacific%20Coast%20and%20both%20the%20Western%20Interior%20and%20Gulf%20Coast%20regions%20of%20North%20America%20during%20the%20Late%20Cretaceous%20than%20has%20previously%20been%20recognized,%20and%20because%20of%20this,%20novel%20and%20direct%20biostratigraphic%20correlations%20can%20be%20made.%20These%20new%20faunal%20correlations%20are%20augmented%20with%20the%20magnetostratigraphic%20record%20from%20Pacific%20Coast%20localities%20to%20arrive%20at%20better%20interregional%20correlation%20for%20the%20Upper%20Cretaceous%20globally.%20The%20new%20integration%20of%20the%20global%20polarity%20time%20scale%20with%20the%20local,%20west%20coast%20ammonite%20zonation%20now%20allows%20better%20correlation%20between%20sections%20both%20within%20the%20North%20Pacific%20province%20(but%20geographically%20far%20from%20our%20study%20areas)%20as%20well%20as%20to%20sections%20outside%20of%20the%20province%20itself.%20However,%20we%20note%20here%20that%20previous%20correlations%20between%20biostratigraphy%20and%20the%20top%20and%20bottom%20of%20magnetochron%2033r%20in%20west%20coast%20North%20American%20sections%20appear%20to%20have%20been%20in%20error%20due%20to%20unrecognized,%20modern-day%20normal-field%20overprint%20of%20originally%20reversed%20polarity%20in%20Upper%20Cretaceous%20sections.%20We%20reinterpret%20the%20position%20of%20this%20chron%20based%20on%20this%20new%20information.}}

