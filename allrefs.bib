	title = {Calcium isotope constraints on the end-Permian mass extinction},
	ty = {JOUR},
	volume = {107},
	year = {2010},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://www.pnas.org/content/107/19/8543.abstract%20N2%20-%20The%20end-Permian%20mass%20extinction%20horizon%20is%20marked%20by%20an%20abrupt%20shift%20in%20style%20of%20carbonate%20sedimentation%20and%20a%20negative%20excursion%20in%20the%20carbon%20isotope%20(%CE%B413C)%20composition%20of%20carbonate%20minerals.%20Several%20extinction%20scenarios%20consistent%20with%20these%20observations%20have%20been%20put%20forward.%20Secular%20variation%20in%20the%20calcium%20isotope%20(%CE%B444/40Ca)%20composition%20of%20marine%20sediments%20provides%20a%20tool%20for%20distinguishing%20among%20these%20possibilities%20and%20thereby%20constraining%20the%20causes%20of%20mass%20extinction.%20Here%20we%20report%20%CE%B444/40Ca%20across%20the%20Permian-Triassic%20boundary%20from%20marine%20limestone%20in%20south%20China.%20The%20%CE%B444/40Ca%20exhibits%20a%20transient%20negative%20excursion%20of%20%E2%88%BC0.3%E2%80%B0%20over%20a%20few%20hundred%20thousand%20years%20or%20less,%20which%20we%20interpret%20to%20reflect%20a%20change%20in%20the%20global%20%CE%B444/40Ca%20composition%20of%20seawater.%20CO2-driven%20ocean%20acidification%20best%20explains%20the%20coincidence%20of%20the%20%CE%B444/40Ca%20excursion%20with%20negative%20excursions%20in%20the%20%CE%B413C%20of%20carbonates%20and%20organic%20matter%20and%20the%20preferential%20extinction%20of%20heavily%20calcified%20marine%20animals.%20Calcium%20isotope%20constraints%20on%20carbon%20cycle%20calculations%20suggest%20that%20the%20average%20%CE%B413C%20of%20CO2%20released%20was%20heavier%20than%20-28%E2%80%B0%20and%20more%20likely%20near%20-15%E2%80%B0;%20these%20values%20indicate%20a%20source%20containing%20substantial%20amounts%20of%20mantle-%20or%20carbonate-derived%20carbon.%20Collectively,%20the%20results%20point%20toward%20Siberian%20Trap%20volcanism%20as%20the%20trigger%20of%20mass%20extinction.}}

@article{Payne2009a,
	annote = {10.1073/pnas.0806314106},
	author = {Payne, Jonathan L. and Boyer, Alison G. and Brown, James H. and Finnegan, Seth and Kowalewski, Micha{\l} and Krause, Richard A. and Lyons, S. Kathleen and McClain, Craig R. and McShea, Daniel W. and Novack-Gottshall, Philip M. and Smith, Felisa A. and Stempien, Jennifer A. and Wang, Steve C.},
	date = {2009/01/06},
	date-added = {2011-03-28 08:18:21 -0400},
	date-modified = {2012-10-29 20:46:20 +0000},
	journal = {Proceedings of the National Academy of Sciences},
	journal1 = {Proceedings of the National Academy of Sciences},
	month = {01},
	number = {1},
	pages = {24--27},
	title = {Two-phase increase in the maximum size of life over 3.5 billion years reflects biological innovation and environmental opportunity},
	ty = {JOUR},
	volume = {106},
	year = {2009},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://www.pnas.org/content/106/1/24.abstract%20N2%20-%20The%20maximum%20size%20of%20organisms%20has%20increased%20enormously%20since%20the%20initial%20appearance%20of%20life%20%3E3.5%20billion%20years%20ago%20(Gya),%20but%20the%20pattern%20and%20timing%20of%20this%20size%20increase%20is%20poorly%20known.%20Consequently,%20controls%20underlying%20the%20size%20spectrum%20of%20the%20global%20biota%20have%20been%20difficult%20to%20evaluate.%20Our%20period-level%20compilation%20of%20the%20largest%20known%20fossil%20organisms%20demonstrates%20that%20maximum%20size%20increased%20by%2016%20orders%20of%20magnitude%20since%20life%20first%20appeared%20in%20the%20fossil%20record.%20The%20great%20majority%20of%20the%20increase%20is%20accounted%20for%20by%202%20discrete%20steps%20of%20approximately%20equal%20magnitude:%20the%20first%20in%20the%20middle%20of%20the%20Paleoproterozoic%20Era%20(%E2%89%881.9%20Gya)%20and%20the%20second%20during%20the%20late%20Neoproterozoic%20and%20early%20Paleozoic%20eras%20(0.6%E2%80%930.45%20Gya).%20Each%20size%20step%20required%20a%20major%20innovation%20in%20organismal%20complexity%E2%80%94first%20the%20eukaryotic%20cell%20and%20later%20eukaryotic%20multicellularity.%20These%20size%20steps%20coincide%20with,%20or%20slightly%20postdate,%20increases%20in%20the%20concentration%20of%20atmospheric%20oxygen,%20suggesting%20latent%20evolutionary%20potential%20was%20realized%20soon%20after%20environmental%20limitations%20were%20removed.}}

@article{Nardin2011a,
	annote = {10.1130/B30364.1},
	author = {Nardin, Elise and Godd{\'e}ris, Yves and Donnadieu, Yannick and Hir, Guillaume Le and Blakey, Ronald C. and Puc{\'e}at, Emmanuelle and Aretz, Markus},
	date = {2011/05/01},
	date-added = {2011-03-28 08:02:35 -0400},
	date-modified = {2018-12-18 16:25:01 +0100},
	doi = {10.1130/B30364.1},
	journal = {Geological Society of America Bulletin},
	journal1 = {Geological Society of America Bulletin},
	month = {05},
	number = {5-6},
	pages = {1181--1192},
	title = {Modeling the early {P}aleozoic long-term climatic trend},
	ty = {JOUR},
	url = {http://gsabulletin.gsapubs.org/content/123/5-6/1181.abstract N2 - The early Paleozoic climate has been described as warm and equable. However, recent data based on conodont oxygen isotopic composition reveal a large, long, cooling trend through the Ordovician, followed by an abrupt cooling during the Late Ordovician glaciation. This long-term climate change is associated with a major radiation in the Earth life history. Nonetheless, the driving mechanisms for this cooling trend remain unknown. Carbon dioxide consumption by the weathering of fresh rocks from volcanic arcs has recently been suggested as a possible driver for this climate change. However, the impact of the plate motion context has not been explored yet, although it might have a major impact on atmospheric CO2 levels. Simulations with a climate model coupled to a biogeochemical model (GEOCLIM) show that the atmospheric CO2 decreased from more than 20 PAL (∼5600 ppmv) in the Furongian down to approximately 10 PAL (∼2800 ppmv) in the Llandovery before rising again in the Early Devonian. We suggest that changes in geography and exposure of fresh volcanic rocks on continents are required to explain the large CO2 drawdown that led to the onset of cooler to glacial conditions from the Middle Ordovician to the Llandovery. The weathering of fresh volcanic rocks is itself responsible for 33% of the Late Ordovician atmospheric CO2 decrease; the rest being related to the continent motion through the intertropical convergence zone (ITCZ). Mean annual continental temperature falls by 3°C in the Early Ordovician, reaching 13.5°C during the glacial interval, and rises to 16°C in the Early Devonian.},
	volume = {123},
	year = {2011},
	bdsk-file-1 = {}}

