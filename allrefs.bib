@article{Wagner2011a,
	annote = {10.1130/GES00626.1},
	author = {Wagner, David L. and Saucedo, George J. and Clahan, Kevin B. and Fleck, Robert J. and Langenheim, Victoria E. and McLaughlin, Robert J. and Sarna-Wojcicki, Andrei M. and Allen, James R. and Deino, Alan L.},
	date-added = {2013-10-23 03:33:49 +0000},
	date-modified = {2024-02-01 14:09:47 -0800},
	doi = {10.1130/GES00626.1},
	journal = {Geosphere},
	month = {06},
	number = {3},
	pages = {658--683},
	title = {{Geology, geochronology, and paleogeography of the southern Sonoma volcanic field and adjacent areas, northern San Francisco Bay region, California}},
	volume = {7},
	year = {2011},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://geosphere.gsapubs.org/content/7/3/658.abstract%20N2%20-%20Recent%20geologic%20mapping%20in%20the%20northern%20San%20Francisco%20Bay%20region%20(California,%20USA)%20supported%20by%20radiometric%20dating%20and%20tephrochronologic%20correlations,%20provides%20insights%20into%20the%20framework%20geology,%20stratigraphy,%20tectonic%20evolution,%20and%20geologic%20history%20of%20this%20part%20of%20the%20San%20Andreas%20transform%20plate%20boundary.%20There%20are%2025%20new%20and%20existing%20radiometric%20dates%20that%20define%20three%20temporally%20distinct%20volcanic%20packages%20along%20the%20north%20margin%20of%20San%20Pablo%20Bay,%20i.e.,%20the%20Burdell%20Mountain%20Volcanics%20(11.1%20Ma),%20the%20Tolay%20Volcanics%20(ca.%2010%E2%80%938%20Ma),%20and%20the%20Sonoma%20Volcanics%20(ca.%208%E2%80%932.5%20Ma).%20The%20Burdell%20Mountain%20and%20the%20Tolay%20Volcanics%20are%20allochthonous,%20having%20been%20displaced%20from%20the%20Quien%20Sabe%20Volcanics%20and%20the%20Berkeley%20Hills%20Volcanics,%20respectively.%20Two%20samples%20from%20a%20core%20of%20the%20Tolay%20Volcanics%20taken%20from%20the%20Murphy%20#1%20well%20in%20the%20Petaluma%20oilfield%20yielded%20ages%20of%208.99%20%C2%B1%200.06%20and%209.13%20%C2%B1%200.06%20Ma,%20demonstrating%20that%20volcanic%20rocks%20exposed%20along%20Tolay%20Creek%20near%20Sears%20Point%20previously%20thought%20to%20be%20a%20separate%20unit,%20the%20Donnell%20Ranch%20volcanics,%20are%20part%20of%20the%20Tolay%20Volcanics.%20Other%20new%20dates%20reported%20herein%20show%20that%20volcanic%20rocks%20in%20the%20Meacham%20Hill%20area%20and%20extending%20southwest%20to%20the%20Burdell%20Mountain%20fault%20are%20also%20part%20of%20the%20Tolay%20Volcanics.%20In%20the%20Sonoma%20volcanic%20field,%20strongly%20bimodal%20volcanic%20sequences%20are%20intercalated%20with%20sediments.%20In%20the%20Mayacmas%20Mountains%20a%20belt%20of%20eruptive%20centers%20youngs%20to%20the%20north.%20The%20youngest%20of%20these%20volcanic%20centers%20at%20Sugarloaf%20Ridge,%20which%20lithologically,%20chemically,%20and%20temporally%20matches%20the%20Napa%20Valley%20eruptive%20center,%20was%20apparently%20displaced%2030%20km%20to%20the%20northwest%20by%20movement%20along%20the%20Carneros%20and%20West%20Napa%20faults.%20The%20older%20parts%20of%20the%20Sonoma%20Volcanics%20have%20been%20displaced%20at%20least%2028%20km%20along%20the%20Rodgers%20Creek%20fault%20since%20ca.%207%20Ma.%20The%20Petaluma%20Formation%20also%20youngs%20to%20the%20north%20along%20the%20Rodgers%20Creek%E2%80%93Hayward%20fault%20and%20the%20Bennett%20Valley%20fault.%20The%20Petaluma%20basin%20formed%20as%20part%20of%20the%20Contra%20Costa%20basin%20in%20the%20Late%20Miocene%20and%20was%20displaced%20to%20its%20present%20location%20along%20the%20Rodgers%20Creek%E2%80%93Hayward%20and%20older%20faults.%20The%20Tolay%20fault,%20previously%20thought%20to%20be%20a%20major%20dextral%20fault,%20is%20part%20of%20a%20fold-and-thrust%20belt%20that%20does%20not%20exhibit%20lateral%20displacement.}}

