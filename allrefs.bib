@article{Riedman2014a,
	annote = {10.1130/G35901.1},
	author = {Riedman, Leigh Anne and Porter, Susannah M. and Halverson, Galen P. and Hurtgen, Matthew T. and Junium, Christopher K.},
	date = {2014/10/07},
	date-added = {2014-10-14 21:53:55 +0000},
	date-modified = {2014-10-14 21:53:55 +0000},
	journal = {Geology},
	journal1 = {Geology},
	month = {10},
	title = {Organic-walled microfossil assemblages from glacial and interglacial Neoproterozoic units of Australia and Svalbard},
	ty = {JOUR},
	url = {http://geology.gsapubs.org/content/early/2014/10/06/G35901.1.abstract N2 - Before the onset of the Neoproterozoic Snowball Earth glaciations, eukaryotes had begun diversifying, and in their aftermath, macroscopic life, including both animals and macroalgae, became abundant and widespread. Although glacially driven mass extinctions have been hypothesized, little is known about the biosphere during and between these glaciations. Here we present new data from organic-walled microfossil assemblages from five successions in Australia and Svalbard that collectively span the first (Sturtian) glaciation and interglacial interval and integrate them with data derived from a critical evaluation of the literature to produce a new estimate of eukaryotic diversity from 850 to 650 Ma. These new glacial and interglacial assemblages consist of only smooth-walled spheroids (leiosphaerids), aggregates of cells, and filaments, in contrast to the much more diverse organic-walled microfossil assemblages found in early Neoproterozoic rocks. This contrast is not attributed to biases in deposition or preservation, but is instead interpreted as reflecting an interval of lowered eukaryotic diversity that spanned the glaciations and that may have begun millions of years prior to their onset.},
	year = {2014},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://geology.gsapubs.org/content/early/2014/10/06/G35901.1.abstract%20N2%20-%20%20Before%20the%20onset%20of%20the%20Neoproterozoic%20Snowball%20Earth%20glaciations,%20eukaryotes%20had%20begun%20diversifying,%20and%20in%20their%20aftermath,%20macroscopic%20life,%20including%20both%20animals%20and%20macroalgae,%20became%20abundant%20and%20widespread.%20Although%20glacially%20driven%20mass%20extinctions%20have%20been%20hypothesized,%20little%20is%20known%20about%20the%20biosphere%20during%20and%20between%20these%20glaciations.%20Here%20we%20present%20new%20data%20from%20organic-walled%20microfossil%20assemblages%20from%20five%20successions%20in%20Australia%20and%20Svalbard%20that%20collectively%20span%20the%20first%20(Sturtian)%20glaciation%20and%20interglacial%20interval%20and%20integrate%20them%20with%20data%20derived%20from%20a%20critical%20evaluation%20of%20the%20literature%20to%20produce%20a%20new%20estimate%20of%20eukaryotic%20diversity%20from%20850%20to%20650%20Ma.%20These%20new%20glacial%20and%20interglacial%20assemblages%20consist%20of%20only%20smooth-walled%20spheroids%20(leiosphaerids),%20aggregates%20of%20cells,%20and%20filaments,%20in%20contrast%20to%20the%20much%20more%20diverse%20organic-walled%20microfossil%20assemblages%20found%20in%20early%20Neoproterozoic%20rocks.%20This%20contrast%20is%20not%20attributed%20to%20biases%20in%20deposition%20or%20preservation,%20but%20is%20instead%20interpreted%20as%20reflecting%20an%20interval%20of%20lowered%20eukaryotic%20diversity%20that%20spanned%20the%20glaciations%20and%20that%20may%20have%20begun%20millions%20of%20years%20prior%20to%20their%20onset.}}

