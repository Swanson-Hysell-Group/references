@article{Daradich2017a,
	abstract = {The impact that long-term changes in Earth's rotation axis relative to the surface geography, or true polar wander (TPW), and continental drift have had in driving cooling of high-latitude North America since the Eocene is explored. Recent reanalyses of paleomagnetic pole positions suggest a secular drift in Earth's rotation axis of ∼ 8 $\,^{\circ}$ over the last 40 Myr, in a direction that has brought North America to increasingly higher latitudes. Using modern temperature data in tandem with a simple model, a reduction in the annual sum of positive degree days (PDDs) driven by this polar and plate motion over the last 20 Myr is quantified. At sites in Baffin Island, the TPW- and continental drift-driven decrease in insolation forcing over the last 20 Myr rivals changes in insolation forcing caused by variations in Earth's obliquity and precession. Using conservative \{PDD\} scaling factors and an annual snowfall equal to modern station observations, the snowiest location in Baffin Island 20 Myr ago had a mass balance deficit of ∼0.75--2 m yr−1 (water equivalent thickness) relative to its projected mass balance at 2.7 Ma. This mass balance deficit would have continued to increase as one goes back in time until ∼40 Myr ago based on adopted paleopole locations. \{TPW\} and continental drift that moved Arctic North America poleward would have strongly promoted glacial inception in Baffin Island at ∼3 Ma, a location where the proto-Laurentide Ice Sheet is thought to have originated. },
	author = {A. Daradich and P. Huybers and J.X. Mitrovica and N.-H. Chan and J. Austermann},
	date-added = {2017-02-06 20:41:23 +0000},
	date-modified = {2017-02-06 20:42:01 +0000},
	doi = {10.1016/j.epsl.2016.12.036},
	issn = {0012-821X},
	journal = {Earth and Planetary Science Letters},
	keywords = {climate},
	pages = {96 - 104},
	title = {{The influence of true polar wander on glacial inception in North America}},
	url = {//www.sciencedirect.com/science/article/pii/S0012821X1630749X},
	volume = {461},
	year = {2017},
	bdsk-file-1 = {},
	bdsk-url-1 = {//www.sciencedirect.com/science/article/pii/S0012821X1630749X},
	bdsk-url-2 = {http://dx.doi.org/10.1016/j.epsl.2016.12.036}}

@article{Rhoads1991a,
	annote = {10.1144/GSL.SP.1991.058.01.13},
	author = {Rhoads, Donald C. and Mulsow, Sandor G. and Gutschick, Raymond and Baldwin, Christopher T. and Stolz, John F.},
	date = {1991/01/01},
	date-added = {2017-01-25 18:44:06 +0000},
	date-modified = {2017-01-25 18:44:06 +0000},
	journal = {Geological Society, London, Special Publications},
	journal1 = {Geological Society, London, Special Publications},
	month = {01},
	number = {1},
	pages = {187--199},
	title = {The dysaerobic zone revisited: a magnetic facies?},
	ty = {JOUR},
	url = {http://sp.lyellcollection.org/content/58/1/187.abstract N2 - The original dysaerobic zone concept defined a unique assemblage of benthic organisms and sedimentary fabrics associated with dissolved oxygen concentrations ranging between 0.3 and 1.0 ml/l. Subsequent studies of the Santa Barbara Basin and oxygen minimum zone (OMZ) off the California coast suggest that this facies is bounded by dissolved oxygen in the range 0.1 to 0.5 ml/l.This range of dissolved oxygen is optimal for the growth of magnetotactic bacteria. We present a hypothesis predicting that the dysaerobic zone should be associated with a high inventory of biogenic magnetite and that this magnetite can be used as a palaeo-oxygen indicator.We have tested this hypothesis with a magnetic analysis of samples from aerobic, anaerobic, and dysaerobic sediments taken off the Peruvian coast. The mean magnetic susceptibility of the dysaerobic zone is 3 to 5 times higher than the aerobic and anaerobic parts of the Peruvian oxygen minimum zone (OMZ). Micrographs (TEM) of these sediment samples indicate that only the dysaerobic zone contains appreciable amounts of fine-grained magnetite.},
	volume = {58},
	year = {1991},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://sp.lyellcollection.org/content/58/1/187.abstract%20N2%20-%20The%20original%20dysaerobic%20zone%20concept%20defined%20a%20unique%20assemblage%20of%20benthic%20organisms%20and%20sedimentary%20fabrics%20associated%20with%20dissolved%20oxygen%20concentrations%20ranging%20between%200.3%20and%201.0%20ml/l.%20Subsequent%20studies%20of%20the%20Santa%20Barbara%20Basin%20and%20oxygen%20minimum%20zone%20(OMZ)%20off%20the%20California%20coast%20suggest%20that%20this%20facies%20is%20bounded%20by%20dissolved%20oxygen%20in%20the%20range%200.1%20to%200.5%20ml/l.This%20range%20of%20dissolved%20oxygen%20is%20optimal%20for%20the%20growth%20of%20magnetotactic%20bacteria.%20We%20present%20a%20hypothesis%20predicting%20that%20the%20dysaerobic%20zone%20should%20be%20associated%20with%20a%20high%20inventory%20of%20biogenic%20magnetite%20and%20that%20this%20magnetite%20can%20be%20used%20as%20a%20palaeo-oxygen%20indicator.We%20have%20tested%20this%20hypothesis%20with%20a%20magnetic%20analysis%20of%20samples%20from%20aerobic,%20anaerobic,%20and%20dysaerobic%20sediments%20taken%20off%20the%20Peruvian%20coast.%20The%20mean%20magnetic%20susceptibility%20of%20the%20dysaerobic%20zone%20is%203%20to%205%20times%20higher%20than%20the%20aerobic%20and%20anaerobic%20parts%20of%20the%20Peruvian%20oxygen%20minimum%20zone%20(OMZ).%20Micrographs%20(TEM)%20of%20these%20sediment%20samples%20indicate%20that%20only%20the%20dysaerobic%20zone%20contains%20appreciable%20amounts%20of%20fine-grained%20magnetite.}}

