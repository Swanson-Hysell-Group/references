@article{Torsvik2014a,
	author = {Torsvik, Trond H. and van der Voo, Rob and Doubrovine, Pavel V. and Burke, Kevin and Steinberger, Bernhard and Ashwal, Lewis D. and Tr{\o}nnes, Reidar G. and Webb, Susan J. and Bull, Abigail L.},
	date = {2014/06/02},
	date-added = {2014-06-22 18:55:12 +0000},
	date-modified = {2020-09-14 15:52:13 -0700},
	doi = {10.1073/pnas.1318135111},
	journal = {Proceedings of the National Academy of Sciences},
	month = {06},
	pages = {8735-8740},
	title = {Deep mantle structure as a reference frame for movements in and on the {E}arth},
	ty = {JOUR},
	url = {http://www.pnas.org/content/early/2014/05/29/1318135111.abstract N2 - Earth’s residual geoid is dominated by a degree-2 mode, with elevated regions above large low shear-wave velocity provinces on the core–mantle boundary beneath Africa and the Pacific. The edges of these deep mantle bodies, when projected radially to the Earth’s surface, correlate with the reconstructed positions of large igneous provinces and kimberlites since Pangea formed about 320 million years ago. Using this surface-to-core–mantle boundary correlation to locate continents in longitude and a novel iterative approach for defining a paleomagnetic reference frame corrected for true polar wander, we have developed a model for absolute plate motion back to earliest Paleozoic time (540 Ma). For the Paleozoic, we have identified six phases of slow, oscillatory true polar wander during which the Earth’s axis of minimum moment of inertia was similar to that of Mesozoic times. The rates of Paleozoic true polar wander (<1°/My) are compatible with those in the Mesozoic, but absolute plate velocities are, on average, twice as high. Our reconstructions generate geologically plausible scenarios, with large igneous provinces and kimberlites sourced from the margins of the large low shear-wave velocity provinces, as in Mesozoic and Cenozoic times. This absolute kinematic model suggests that a degree-2 convection mode within the Earth’s mantle may have operated throughout the entire Phanerozoic.},
	volume = {111},
	year = {2014},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://www.pnas.org/content/early/2014/05/29/1318135111.abstract%20N2%20-%20Earth%E2%80%99s%20residual%20geoid%20is%20dominated%20by%20a%20degree-2%20mode,%20with%20elevated%20regions%20above%20large%20low%20shear-wave%20velocity%20provinces%20on%20the%20core%E2%80%93mantle%20boundary%20beneath%20Africa%20and%20the%20Pacific.%20The%20edges%20of%20these%20deep%20mantle%20bodies,%20when%20projected%20radially%20to%20the%20Earth%E2%80%99s%20surface,%20correlate%20with%20the%20reconstructed%20positions%20of%20large%20igneous%20provinces%20and%20kimberlites%20since%20Pangea%20formed%20about%20320%20million%20years%20ago.%20Using%20this%20surface-to-core%E2%80%93mantle%20boundary%20correlation%20to%20locate%20continents%20in%20longitude%20and%20a%20novel%20iterative%20approach%20for%20defining%20a%20paleomagnetic%20reference%20frame%20corrected%20for%20true%20polar%20wander,%20we%20have%20developed%20a%20model%20for%20absolute%20plate%20motion%20back%20to%20earliest%20Paleozoic%20time%20(540%20Ma).%20For%20the%20Paleozoic,%20we%20have%20identified%20six%20phases%20of%20slow,%20oscillatory%20true%20polar%20wander%20during%20which%20the%20Earth%E2%80%99s%20axis%20of%20minimum%20moment%20of%20inertia%20was%20similar%20to%20that%20of%20Mesozoic%20times.%20The%20rates%20of%20Paleozoic%20true%20polar%20wander%20(%3C1%C2%B0/My)%20are%20compatible%20with%20those%20in%20the%20Mesozoic,%20but%20absolute%20plate%20velocities%20are,%20on%20average,%20twice%20as%20high.%20Our%20reconstructions%20generate%20geologically%20plausible%20scenarios,%20with%20large%20igneous%20provinces%20and%20kimberlites%20sourced%20from%20the%20margins%20of%20the%20large%20low%20shear-wave%20velocity%20provinces,%20as%20in%20Mesozoic%20and%20Cenozoic%20times.%20This%20absolute%20kinematic%20model%20suggests%20that%20a%20degree-2%20convection%20mode%20within%20the%20Earth%E2%80%99s%20mantle%20may%20have%20operated%20throughout%20the%20entire%20Phanerozoic.}}

