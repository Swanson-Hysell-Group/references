	bdsk-file-1 = {},
	bdsk-url-1 = {http://geology.gsapubs.org/content/39/6/539.abstract%20N2%20-%20The%20origin%20and%20expansion%20of%20biomineralization%20in%20eukaryotes%20played%20a%20critical%20role%20in%20Earth%20history,%20linking%20biological%20and%20geochemical%20processes.%20However,%20the%20onset%20of%20this%20phenomenon%20is%20poorly%20constrained%20due%20to%20a%20limited%20early%20fossil%20record%20of%20biomineralization.%20Although%20macroscopic%20evidence%20for%20biomineralization%20is%20not%20known%20until%20the%20late%20Ediacaran,%20we%20here%20report%20biologically%20controlled%20phosphatic%20biomineralization%20of%20scale%20microfossils%20from%20mid-Neoproterozoic%20(pre-Sturtian)%20strata%20of%20northwest%20Canada.%20Primary%20biological%20control%20on%20mineralization%20is%20supported%20by%20the%20identification%20of%20apatite%20in%20both%20chert-hosted%20and%20limestone-hosted%20specimens,%20the%20conspicuously%20rigid%20original%20morphology%20of%20the%20scale%20microfossils%20relative%20to%20co-occurring%20organic-walled%20cyanobacteria%20and%20acritarchs,%20and%20the%20microstructure%20of%20the%20constituent%20phosphate.%20Cell-enveloping%20mineralized%20scales%20occur%20in%20a%20wide%20range%20of%20extant%20protists,%20but%20the%20apparent%20restriction%20of%20phosphate%20scales%20to%20one%20modern%20taxon%20of%20green%20algae%20suggests%20a%20possible%20affiliation%20for%20these%20fossils.%20Documentation%20of%20primary%20phosphate%20biomineralization%20in%20Fifteenmile%20Group%20(Yukon%20Territory,%20Canada)%20microfossils%20greatly%20extends%20the%20known%20record%20of%20biologically%20controlled%20mineralization%20and%20provides%20a%20unique%20window%20into%20the%20diversity%20of%20early%20eukaryotes.}}

@article{Jackson1985a,
	abstract = {Of 149 oriented specimens of the lower Ordovician Oneota dolomite subjected to stepwise thermal or alternating-field demagnetization, 50 contained a characteristic shallow east-southeasterly or west-northwesterly component of magnetization identifiable on orthogonal vector projections. For 48 other specimens the demagnetization trajectories defined greats-circle paths which intersect close to the characteristic direction. The site-mean directions for the characteristic component were determined by using both the characteristic directions and great-circle data, and these yield a formation-mean direction obtained from 10 sites with a declination of 105∞, an inclination of +2∞, and a precision parameter k of 17.6 (\&{\#}945;95 = 11.9∞). The mean of the site virtual poles falls at 10.4∞N, 166.4∞E (K = 48.0, A95 = 7.0∞), which is close to previously published late Cambrian paleopoles. Both polarity groups have predominantly positive inclinations, suggesting the presence of an uncleaned downward component whose unblocking-temperature and coercivity spectra overlap very strongly with those of the characteristic magnetization. We interpret this downward component as a drilling-induced remanent magnetization, and we hope to have removed its contribution by averaging the dual-polarity results. Multicomponent magnetizations were also present in samples collected from blocks of Oneota dolomite incorporated into the overlying New Richmond sandstone (lower Ordovician), but only six out of eight samples yielded well-defined greats-circle paths. The best fit intersection of these defines a northerly and steep recent component, while the directions of the higher-stability components are different for each block. Due to the small number of samples and imperfect resolution of magnetic directions, the conglomerate test is not conclusive; nevertheless it suggests that the stable remanence in the Oneota dolomite was acquired prior to the deposition of the New Richmond sandstone.},
	author = {Jackson, Mike and Van der Voo, Rob},
	date-added = {2011-05-31 09:19:59 -0400},
	date-modified = {2012-10-29 20:46:19 +0000},
	isbn = {0148-0227},
	journal = {J. Geophys. Res.},
	number = {B12},
	pages = {10449--10461},
	publisher = {AGU},
	title = {A LOWER ORDOVICIAN PALEOMAGNETIC POLE FROM THE ONEOTA DOLOMITE, UPPER MISSISSIPPI RIVER VALLEY},
	ty = {JOUR},
	volume = {90},
	year = {1985},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://dx.doi.org/10.1029/JB090iB12p10449}}

