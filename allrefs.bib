@article{Kean1981a,
	abstract = {Two long cores from a magnetite-rich gabbroic intrusion near Clam Lake, Wisconsin were studied to obtain paleopole positions to aid in determining the time of intrusion and learn more about the tectonics of the area. This intrusion was suspected to be late Precambrian in age. A.F. demagnetization above 150 oe. produced reliable remanent directions. The cores were not azimuthally oriented, therefore small circle plots were made for each sample using 12 different horizontal orientations. The best pole position was considered to be where the small circle paths crossed the Precambrian polar wander curve. This gave a normal pole at N 30$\,^{\circ}$E 176$\,^{\circ}$which is middle Keweenawan in age. The average inclination and declination for 14 of the 18 core sections was 35$\,^{\circ}$and 288$\,^{\circ}$respectively, which is consistent with aeromagnetic maps of the area. The 35$\,^{\circ}$inclination is consistent with most middle Keweenawan rocks of the area, after they have been corrected for a 10$\,^{\circ}$- 30$\,^{\circ}$tilt. This suggests that the Clam Lake area was not tilted after intrusion. Basalt dikes in the gabbro gave consistently lower inclinations, which suggest a late Keweenawan time for their formation.},
	author = {Kean, William F. and Swingen, Regina A.},
	date = {//NaN},
