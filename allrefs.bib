@article{Young2012a,
	annote = {10.1098/rstb.2011.0145},
	author = {Young, J. N. and Rickaby, R. E. M. and Kapralov, M. V. and Filatov, D. A.},
	date = {2012/02/19},
	date-added = {2012-02-23 15:45:51 +0000},
	date-modified = {2012-10-29 20:46:18 +0000},
	journal = {Philosophical Transactions of the Royal Society B: Biological Sciences},
	journal1 = {Philosophical Transactions of the Royal Society B: Biological Sciences},
	month = {02},
	number = {1588},
	pages = {483--492},
	title = {Adaptive signals in algal Rubisco reveal a history of ancient atmospheric carbon dioxide},
	ty = {JOUR},
	volume = {367},
	year = {2012},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://rstb.royalsocietypublishing.org/content/367/1588/483.abstract%20N2%20-%20Rubisco,%20the%20most%20abundant%20enzyme%20on%20the%20Earth%20and%20responsible%20for%20all%20photosynthetic%20carbon%20fixation,%20is%20often%20thought%20of%20as%20a%20highly%20conserved%20and%20sluggish%20enzyme.%20Yet,%20different%20algal%20Rubiscos%20demonstrate%20a%20range%20of%20kinetic%20properties%20hinting%20at%20a%20history%20of%20evolution%20and%20adaptation.%20Here,%20we%20show%20that%20algal%20Rubisco%20has%20indeed%20evolved%20adaptively%20during%20ancient%20and%20distinct%20geological%20periods.%20Using%20DNA%20sequences%20of%20extant%20marine%20algae%20of%20the%20red%20and%20Chromista%20lineage,%20we%20define%20positive%20selection%20within%20the%20large%20subunit%20of%20Rubisco,%20encoded%20by%20rbcL,%20to%20occur%20basal%20to%20the%20radiation%20of%20modern%20marine%20groups.%20This%20signal%20of%20positive%20selection%20appears%20to%20be%20responding%20to%20changing%20intracellular%20concentrations%20of%20carbon%20dioxide%20(CO2)%20triggered%20by%20physiological%20adaptations%20to%20declining%20atmospheric%20CO2.%20Within%20the%20ecologically%20important%20Haptophyta%20(including%20coccolithophores)%20and%20Bacillariophyta%20(diatoms),%20positive%20selection%20occurred%20consistently%20during%20periods%20of%20falling%20Phanerozoic%20CO2%20and%20suggests%20emergence%20of%20carbon-concentrating%20mechanisms.%20During%20the%20Proterozoic,%20a%20strong%20signal%20of%20positive%20selection%20after%20secondary%20endosymbiosis%20occurs%20at%20the%20origin%20of%20the%20Chromista%20lineage%20(approx.%201.1%20Ga),%20with%20further%20positive%20selection%20events%20until%200.41%20Ga,%20implying%20a%20significant%20and%20continuous%20decrease%20in%20atmospheric%20CO2%20encompassing%20the%20Cryogenian%20Snowball%20Earth%20events.%20We%20surmise%20that%20positive%20selection%20in%20Rubisco%20has%20been%20caused%20by%20declines%20in%20atmospheric%20CO2%20and%20hence%20acts%20as%20a%20proxy%20for%20ancient%20atmospheric%20CO2.}}

