	publisher = {John Wiley \& Sons, Ltd},
	title = {The {Ordovician} meteorite event in {North America}: Age of the {Slate Islands} impact structure, northern {Lake Superior}, {Ontario}, {Canada}},
	volume = {n/a},
	year = {2024},
