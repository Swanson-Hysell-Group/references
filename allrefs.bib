	bdsk-url-1 = {http://www.sciencemag.org/content/308/5728/1611.abstract%20N2%20-%20The%20Paleocene-Eocene%20thermal%20maximum%20(PETM)%20has%20been%20attributed%20to%20the%20rapid%20release%20of%20%E2%88%BC2000%20%C3%97%20109%20metric%20tons%20of%20carbon%20in%20the%20form%20of%20methane.%20In%20theory,%20oxidation%20and%20ocean%20absorption%20of%20this%20carbon%20should%20have%20lowered%20deep-sea%20pH,%20thereby%20triggering%20a%20rapid%20(%3C10,000-year)%20shoaling%20of%20the%20calcite%20compensation%20depth%20(CCD),%20followed%20by%20gradual%20recovery.%20Here%20we%20present%20geochemical%20data%20from%20five%20new%20South%20Atlantic%20deep-sea%20sections%20that%20constrain%20the%20timing%20and%20extent%20of%20massive%20sea-floor%20carbonate%20dissolution%20coincident%20with%20the%20PETM.%20The%20sections,%20from%20between%202.7%20and%204.8%20kilometers%20water%20depth,%20are%20marked%20by%20a%20prominent%20clay%20layer,%20the%20character%20of%20which%20indicates%20that%20the%20CCD%20shoaled%20rapidly%20(%3C10,000%20years)%20by%20more%20than%202%20kilometers%20and%20recovered%20gradually%20(%3E100,000%20years).%20These%20findings%20indicate%20that%20a%20large%20mass%20of%20carbon%20(%C2%BB2000%20%C3%97%20109%20metric%20tons%20of%20carbon)%20dissolved%20in%20the%20ocean%20at%20the%20Paleocene-Eocene%20boundary%20and%20that%20permanent%20sequestration%20of%20this%20carbon%20occurred%20through%20silicate%20weathering%20feedback.}}

