	pages = {61--76},
	title = {Palaeomagnetism of Permo-Triassic rocks in the Iberian Cordillera, Spain: acquisition of Secondary and characteristic remanence},
	ty = {JOUR},
	volume = {146},
	year = {1989},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://jgs.lyellcollection.org/content/146/1/61.abstract%20N2%20-%20Magnetostratigraphy%20is%20widely%20used%20as%20a%20tool%20for%20stratigraphical%20correlation%20but%20there%20are%20problems%20in%20its%20application%20to%20rocks%20which%20have%20suffered%20complex%20diagenesis,%20particularly%20sandy,%20continental%20red%20beds.%20In%20such%20cases%20the%20complete%20magnetic%20record%20should%20be%20studied%20in%20relation%20to%20its%20depositional,%20diagenetic%20and%20structural%20history.%20To%20this%20end%20a%20detailed%20palaeomagnetic%20study%20has%20been%20made%20of%20Permian%20and%20Triassic%20rocks%20in%20the%20northern%20Iberian%20Cordillera,%20Spain.%20Four%20stratigraphical%20units%20comprising%20the%20Autunian,%20'Saxonian',%20Buntsandstein%20and%20Muschelkalk%20have%20been%20studied%20in%20a%20single%20section%20near%20Molina%20de%20Aragon%20which%20is%20well-documented%20sedimentologically.%20Autunian%20rocks%20have%20a%20characteristic%20remanence%20which%20is%20exclusively%20reversed%20and%20corresponds%20to%20the%20Kiaman%20Interval%20of%20Lower%20Permian%20age.%20A%20pole%20position%20(49%20N,%20167%20W)%20is%20consistent%20with%20previous%20studies%20which%20indicate%20the%20rotation%20of%20Iberia%20in%20post-Triassic%20times%20relative%20to%20the%20stable%20European%20plate.%20The%20Saxonian%20facies%20show%20complex,%20multicomponent%20magnetizations;%20no%20polarity%20zonation%20can%20be%20resolved%20but%20individual%20components%20were%20acquired%20prior%20to%20the%20rotation%20of%20Iberia.The%20Buntsandstein%20is%20remarkable%20in%20that%20much%20of%20it%20is%20completely%20remagnetized%20in%20a%20direction%20similar%20to%20the%20present%20local%20geomagnetic%20direction.%20This%20secondary%20remanence%20is%20carried%20by%20fine%20grained%20hematite%20which%20has%20been%20formed%20as%20a%20result%20of%20carbonate%20dissolution%20and%20other%20diagenetic%20reactions.%20Initially,%20these%20iron%20oxides%20were%20probably%20superparamagnetic%20and%20remanence%20was%20only%20blocked-in%20by%20structural%20inversion%20of%20the%20Iberian%20Cordillera%20in%20Tertiary%20times%20and%20after%20rotation%20of%20the%20Iberian%20plate.%20Some%20of%20the%20primary%20remanence%20is%20preserved%20in%20some%20fine%20grained%20lithologies%20of%20the%20Buntsandstein,%20indicating%20that%20normal%20and%20reversed%20zones%20of%20magnetization%20were%20originally%20present.%20The%20magnetization%20of%20the%20Muschelkalk%20carbonates%20is%20also%20complex;%20secondary%20components%20similar%20to%20those%20of%20the%20Buntsandstein%20are%20present%20but%20there%20is%20evidence%20that%20primary%20components%20were%20mainly%20normal%20during%20Karnian%20times.}}

