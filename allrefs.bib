	keywords = {oxyexsolution; thermochemical remanent magetization; paleointensity; 1519 Geomagnetism and Paleomagnetism: Magnetic mineralogy and petrology; 1521 Geomagnetism and Paleomagnetism: Paleointensity; 1533 Geomagnetism and Paleomagnetism: Remagnetization; 1540 Geomagnetism and Paleomagnetism: Rock and mineral magnetism},
	month = {06},
	number = {B6},
