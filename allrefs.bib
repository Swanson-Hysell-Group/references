@article{Gomes2013a,
	annote = {10.1130/G34187.1},
	author = {Gomes, Maya L. and Hurtgen, Matthew T.},
	date = {2013/06/01},
	date-added = {2014-02-13 18:13:12 +0000},
	date-modified = {2015-10-26 17:19:39 +0000},
	journal = {Geology},
	journal1 = {Geology},
	month = {06},
	number = {6},
	pages = {663--666},
	title = {Sulfur isotope systematics of a euxinic, low-sulfate lake: Evaluating the importance of the reservoir effect in modern and ancient oceans},
	ty = {JOUR},
	volume = {41},
	year = {2013},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://geology.gsapubs.org/content/41/6/663.abstract%20N2%20-%20The%20sulfur%20(S)%20isotope%20difference%20between%20sedimentary%20sulfate%20and%20sulfide%20phases%20preserved%20in%20sedimentary%20rocks%20(%CE%9434S)%20has%20been%20utilized%20to%20reconstruct%20marine%20sulfate%20concentrations%20and%20inferentially%20the%20redox%20evolution%20of%20Earth%E2%80%99s%20surface.%20These%20interpretations%20are%20largely%20based%20on%20experimental%20studies%20that%20indicate%20that%20microbial%20sulfate%20reduction%20is%20accompanied%20by%20a%20substantial%20kinetic%20isotope%20effect%20(up%20to%2066%E2%80%B0),%20but%20only%20at%20sulfate%20concentrations%20%3E~200%20%CE%BCM.%20In%20this%20study,%20we%20examine%20S%20isotope%20systematics%20in%20a%20modern,%20low-sulfate%20euxinic%20lake%20(~100%E2%80%93350%20%CE%BCM)%20and%20find%20that%20the%20calculated%20kinetic%20isotope%20effect%20associated%20with%20microbial%20sulfate%20reduction%20(%CE%B5%2034S)%20is%20relatively%20large%20(~23.5%E2%80%B0),%20but%20preserved%20%CE%9434S%20values%20are%20considerably%20smaller%20(4.7%E2%80%B0%E2%80%939.9%E2%80%B0).%20%CE%9434S%20values%20in%20this%20system%20are%20controlled%20by%20the%20fraction%20of%20the%20sulfate%20reservoir%20that%20is%20consumed%20during%20sulfate%20reduction%20and%20the%20location%20of%20pyrite%20formation.%20This%20reservoir%20effect%20strongly%20influences%20the%20S%20isotope%20composition%20of%20sulfide%20preserved%20in%20the%20rock%20record%20such%20that%20%CE%9434S%20values%20increase%20as%20a%20function%20of%20sulfate%20levels,%20even%20when%20sulfate%20concentrations%20are%20%3E200%20%CE%BCM%20and%20the%20kinetic%20isotope%20effect%20is%20expressed.%20These%20findings%20have%20important%20implications%20for%20reconstructing%20the%20chemical%20evolution%20of%20the%20ocean-atmosphere%20system%20throughout%20Earth%20history%E2%80%94not%20just%20for%20the%20Precambrian.}}

