	journal = {Contributions to Mineralogy and Petrology},
	number = {6},
	pages = {863--883},
	title = {Migrating magmatism in the northern US Cordillera: in situ U--Pb geochronology of the Idaho batholith},
	ty = {JOUR},
	url = {http://dx.doi.org/10.1007/s00410-009-0459-5},
	volume = {159},
