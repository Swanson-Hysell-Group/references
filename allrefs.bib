@article{Husson2015a,
	annote = {10.2475/01.2015.01},
	author = {Husson, Jon M. and Maloof, Adam C. and Schoene, Blair and Chen, Christine Y. and Higgins, John A.},
	date-added = {2015-02-10 23:58:19 +0000},
	date-modified = {2018-04-24 21:52:56 +0000},
	doi = {10.2475/01.2015.01},
	journal = {American Journal of Science},
	month = {01},
	number = {1},
	pages = {1--45},
	title = {Stratigraphic expression of {E}arth's deepest δ13C excursion in the {W}onoka {F}ormation of {S}outh {A}ustralia},
	volume = {315},
	year = {2015},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://www.ajsonline.org/content/315/1/1.abstract%20N2%20-%20The%20most%20negative%20carbon%20isotope%20excursion%20in%20Earth%20history%20is%20found%20in%20carbonate%20rocks%20of%20the%20Ediacaran%20Period%20(635-541%20Ma).%20Known%20colloquially%20as%20the%20%E2%80%9CShuram%E2%80%9D%20excursion,%20workers%20have%20long%20noted%20its%20broad%20concordance%20with%20the%20rise%20of%20abundant%20macro-scale%20fossils%20in%20the%20rock%20record,%20collectively%20known%20as%20the%20%E2%80%9CEdiacaran%20Biota.%E2%80%9D%20Thus,%20the%20Shuram%20excursion%20has%20been%20interpreted%20by%20many%20in%20the%20context%20of%20a%20dramatically%20changing%20redox%20state%20of%20the%20Ediacaran%20oceans%E2%80%94for%20example,%20a%20result%20of%20methane%20cycling%20in%20a%20low%20O2%20atmosphere,%20the%20final%20destruction%20of%20a%20large%20pool%20of%20recalcitrant%20dissolved%20organic%20carbon%20(DOC),%20and%20the%20step-wise%20oxidation%20of%20the%20Ediacaran%20oceans.%20More%20recently,%20diagenetic%20interpretations%20of%20the%20Shuram%20excursion%20have%20challenged%20the%20various%20redox%20models,%20with%20the%20very%20negative%20%CE%B413C%20values%20of%20Ediacaran%20carbonates%20explained%20via%20sedimentary%20in-growth%20of%20very%20%CE%B413C%20depleted%20authigenic%20carbonates,%20meteoric%20alteration%20or%20late-stage%20burial%20diagenesis.%20A%20stratigraphic%20and%20sedimentological%20context%20is%20required%20to%20discriminate%20between%20these%20explanatory%20models,%20and%20to%20determine%20whether%20the%20Shuram%20excursion%20can%20be%20used%20to%20evaluate%20oxygenation%20in%20terminal%20Neoproterozoic%20oceans.%20Here%20we%20present%20chemo-stratigraphic%20data%20(%CE%B413C,%20%CE%B418O,%20and%20trace%20element%20abundances)%20from%2015%20measured%20sections%20of%20the%20Ediacaran-aged%20Wonoka%20Formation%20(Fm.)%20of%20South%20Australia.%20In%20some%20locations,%20the%20Wonoka%20Fm.%20is%20%E2%88%BC700%20meters%20(m)%20of%20mixed%20shelf%20limestones%20and%20siliciclastics%20that%20record%20a%2017%20permil%20%CE%B413C%20excursion%20(%E2%88%9212%20to%20+5%E2%80%B0).%20Further%20north%20in%20the%20basin,%20the%20Wonoka%20Fm.%20is%20host%20to%20deep%20(%E2%88%BC1%20km)%20paleocanyons,%20which%20are%20partly%20filled%20by%20tabular-clast%20carbonate%20breccias.%20Canyon-filling%20ceased%20during%20ongoing%20sedimentation%20on%20the%20shelf%20interior%20(the%20%E2%80%9Ccanyon-shoulder%E2%80%9D),%20as%20evidenced%20by%20upper%20canyon-shoulder%20units%20that%20overlie%20and%20cap%20certain%20canyon-fill%20sequences.%20The%20unprecedented%20size%20of%20the%20chemostratigraphic%20dataset%20presented%20here%20(2671%20%CE%B413C-%CE%B418O%20measurements%20from%20the%20canyon-shoulder,%201393%20%CE%B413C-%CE%B418O%20measurements%20from%20canyon%20clasts,%20and%2011%20different%20trace%20elements%20measured%20on%20247%20Wonoka%20Fm.%20carbonate%20samples),%20when%20coupled%20with%20the%20unique%20canyon-shoulder%20to%20canyon-fill%20depositional%20system%20of%20the%20Wonoka%20Fm.,%20allows%20for%20new%20insights%20into%20Ediacaran%20carbon%20isotope%20systematics.%20The%20excursion%20is%20preserved%20in%20a%20remarkably%20consistent%20fashion%20across%2012,000%20km2%20of%20basin%20area;%20fabric-altering%20diagenesis,%20where%20present,%20occurs%20at%20the%20sub-meter%20vertical%20scale,%20results%20in%20%3C%201%20permil%20offsets%20in%20%CE%B413C%20and%20cannot%20be%20used%20to%20explain%20the%20full%20%CE%B413C%20excursion.%20Multi-variate%20analysis%20of%20the%20dataset%20allows%20for%20rigorous%20assessment%20of%20different%20potential%20carbonate%20sources%20for%20the%20Wonoka%20canyon-fill%20breccias.%20Eroded%20and%20transported%20canyon-shoulder%20carbonates%20are%20the%20most%20likely%20source,%20thus%20requiring%20a%20syn-depositional%20age%20for%20the%20extraordinary%20range%20of%20%CE%B413C%20values%20(%E2%88%9212%20to%20+5%E2%80%B0)%20observed%20in%20both%20the%20Wonoka%20Fm.%20canyon-shoulder%20and%20canyon-fill%20breccias.%20Geological%20observations%20(for%20example,%20excellent%20preservation%20of%20sedimentary%20structures%20in%20Wonoka%20carbonates,%20absence%20of%20top-down%20alteration%20profiles%20associated%20with%20exposure%20surfaces)%20do%20not%20provide%20first-order%20evidence%20for%20the%20meteoric%20or%20authigenic%20carbonate%20models.%20Thus,%20the%20balance%20of%20evidence%20supports%20either%20a%20primary%20origin%20or%20syn-depositional,%20fabric-retentive%20diagenesis%20for%20the%20deep%20negative%20%CE%B413C%20excursion%20hosted%20in%20the%20Wonoka%20Formation%20of%20South%20Australia.}}

