@article{Bosak2012a,
	author = {Bosak, Tanja and Lahr, Daniel J. G. and Pruss, Sara B. and Macdonald, Francis A. and Gooday, Andrew J. and Dalton, Lilly and Matys, Emily D.},
	date = {2012/01/01},
	date-added = {2014-03-13 21:29:22 +0000},
	date-modified = {2014-03-13 21:29:22 +0000},
	journal = {Geology},
	m3 = {10.1130/G32535.1},
	month = {01},
	number = {1},
	pages = {67--70},
	title = {Possible early foraminiferans in post-Sturtian (716−635 Ma) cap carbonates},
	ty = {JOUR},
	url = {http://geology.gsapubs.org/content/40/1/67.abstract N2 - Foraminifera are an ecologically important group of modern heterotrophic amoeboid eukaryotes whose naked and testate ancestors are thought to have evolved ∼1 Ga ago. However, the single-chambered agglutinated tests of these protists appear in the fossil record only after ca. 580 Ma, coinciding with the appearance of macroscopic and mineralized animals. Here we report the discovery of small, slender tubular microfossils in the Sturtian (ca. 716–635 Ma) cap carbonate of the Rasthof Formation in Namibia. The tubes are 200–1300 μm long and 20–70 μm wide, and preserve apertures and variably wide lumens, folds, constrictions, and ridges. Their sometimes flexible walls are composed of carbonaceous material and detrital minerals. This combination of morphologic and compositional characters is also present in some species of modern single-chambered agglutinated tubular foraminiferans, and is not found in other agglutinated eukaryotes. The preservation of possible early Foraminifera in the carbonate rocks deposited in the immediate aftermath of Sturtian low-latitude glaciation indicates that various morphologically modern protists thrived in microbially dominated ecosystems, and contributed to the cycling of carbon in Neoproterozoic oceans much before the rise of complex animals.},
	volume = {40},
	year = {2012},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://geology.gsapubs.org/content/40/1/67.abstract%20N2%20-%20Foraminifera%20are%20an%20ecologically%20important%20group%20of%20modern%20heterotrophic%20amoeboid%20eukaryotes%20whose%20naked%20and%20testate%20ancestors%20are%20thought%20to%20have%20evolved%20%E2%88%BC1%20Ga%20ago.%20However,%20the%20single-chambered%20agglutinated%20tests%20of%20these%20protists%20appear%20in%20the%20fossil%20record%20only%20after%20ca.%20580%20Ma,%20coinciding%20with%20the%20appearance%20of%20macroscopic%20and%20mineralized%20animals.%20Here%20we%20report%20the%20discovery%20of%20small,%20slender%20tubular%20microfossils%20in%20the%20Sturtian%20(ca.%20716%E2%80%93635%20Ma)%20cap%20carbonate%20of%20the%20Rasthof%20Formation%20in%20Namibia.%20The%20tubes%20are%20200%E2%80%931300%20%CE%BCm%20long%20and%2020%E2%80%9370%20%CE%BCm%20wide,%20and%20preserve%20apertures%20and%20variably%20wide%20lumens,%20folds,%20constrictions,%20and%20ridges.%20Their%20sometimes%20flexible%20walls%20are%20composed%20of%20carbonaceous%20material%20and%20detrital%20minerals.%20This%20combination%20of%20morphologic%20and%20compositional%20characters%20is%20also%20present%20in%20some%20species%20of%20modern%20single-chambered%20agglutinated%20tubular%20foraminiferans,%20and%20is%20not%20found%20in%20other%20agglutinated%20eukaryotes.%20The%20preservation%20of%20possible%20early%20Foraminifera%20in%20the%20carbonate%20rocks%20deposited%20in%20the%20immediate%20aftermath%20of%20Sturtian%20low-latitude%20glaciation%20indicates%20that%20various%20morphologically%20modern%20protists%20thrived%20in%20microbially%20dominated%20ecosystems,%20and%20contributed%20to%20the%20cycling%20of%20carbon%20in%20Neoproterozoic%20oceans%20much%20before%20the%20rise%20of%20complex%20animals.}}

