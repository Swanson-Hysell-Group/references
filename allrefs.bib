@article{Van-der-Voo2015a,
	author = {Van der Voo, Rob and van Hinsbergen, Douwe J. J. and Domeier, Mathew and Spakman, Wim and Torsvik, Trond H.},
	date = {2015/06/05},
	date-added = {2015-09-02 20:41:16 +0000},
	date-modified = {2020-11-04 14:52:14 -0800},
	doi = {10.1130/2015.2513(19)},
	journal = {Geological Society of America Special Papers},
	month = {06},
	title = {{Latest Jurassic--earliest Cretaceous closure of the Mongol-Okhotsk Ocean: A paleomagnetic and seismological-tomographic analysis}},
	ty = {JOUR},
	volume = {513},
	year = {2015},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://specialpapers.gsapubs.org/content/early/2015/06/05/2015.2513_19.abstract%20N2%20-%20The%20Mongol-Okhotsk%20Ocean%20closed%20when%20the%20Amuria%20block,%20normally%20considered%20to%20have%20been%20part%20of%20the%20North%20China%20block%20since%20the%20early%20Mesozoic,%20and%20the%20southern%20margin%20of%20Siberia%20collided%20in%20Late%20Jurassic%20to%20Early%20Cretaceous%20times.%20The%20resulting%20suture%20runs%20WSW-ENE%20and%20is%20reasonably%20well%20defined%20to%20the%20east%20of%20longitude%20100%C2%B0E.%20Because%20no%20evidence%20exists%20for%20any%20westward%20prolongation%20of%20the%20Mongol-Okhotsk%20Ocean%20suture%20toward%20the%20Tarim%20block,%20the%20cryptic%20termination%20of%20the%20suture%20is%20an%20%C2%ADenigma,%20compounded%20by%20the%20fact%20that%20a%20tomographically%20identified%20slab%20in%20the%20lower%201000%20km%20of%20the%20mantle,%20interpreted%20as%20a%20remnant%20of%20Mongol-Okhotsk%20oceanic%20lithosphere,%20has%20a%20clear%20N-S%20trend,%20at%20almost%20right%20angles%20to%20the%20surface%20suture.%20No%20sensible%20explanation%20can%20be%20constructed%20for%20a%20rotation%20of%20some%2090%C2%B0%20of%20this%20slab.%20There%20is%20a%20solution,%20however,%20to%20both%20these%20enigmas%20if%20we%20consider%20that%20the%20Triassic%20Mongol-Okhotsk%20Ocean%20existed%20east%20of%20an%20initially%20meridian-parallel,%20but%20later%20progressively%20more%20%C2%ADsinuous,%20late%20Paleozoic%20Pangea%20margin.%20This%20margin%20consisted%20of%20Siberia,%20Amuria,%20and%20the%20China%20continental%20elements.%20The%20Mongol-Okhotsk%20Ocean%20was%20subducting%20westward%20during%20the%20early%20Mesozoic%20and%20likely%20older%20times%20underneath%20this%20margin.%20This%20would%20readily%20explain%20the%20tomographic%20N-S%20slab%20orientation%20at%20depths%20of%202000%20km%20and%20greater.%20Paleomagnetic%20inclination%20differences%20between%20the%20global%20apparent%20polar%20wander%20path%20in%20Siberian%20coordinates%20and%20results%20from%20the%20North%20China%20block%20show%20a%20gradually%20diminishing%20trend%20with%20time,%20as%20these%20cratons%20approached%20each%20other%20during%20the%20Jurassic.%20During%20this%20time,%20the%20paleomagnetic%20data%20of%20the%20North%20China%20block%20show%20that%20it%20underwent%20a%20slight%20northward%20motion,%20but%20with%20a%20considerable%20counterclockwise%20rotation%20of%20%E2%88%BC90%C2%B0.%20At%20the%20same%20time,%20the%20Mongol-Okhotsk%20Ocean%E2%80%93bordering%20margin%20of%20Eurasia%20(between%20Siberia%20and%20Tarim)%20moved%20southward%20by%20%E2%88%BC30%C2%B0%20and%20rotated%2045%C2%B0%20clockwise.%20These%20continental%20scissoring%20movements%20caused%20doubly%20vergent%20subduction%20of%20the%20Mongol-Okhotsk%20Ocean.%20Paleomagnetic%20data%20suggest%20final%20closure%20of%20the%20Mongol-Okhotsk%20Ocean%20in%20latest%20Jurassic%E2%80%93earliest%20Cretaceous%20time.%20Arc-related%20rocks%20above%20the%20subduction%20zone%20follow%20the%20outline%20around%20the%20core%20of%20the%20Tuva-Mongol%20belt%20in%20the%20eastern%20Altaids%20between%20Amuria%20and%20Siberia,%20and%20they%20form%20a%20tightening,%20westward-convex%20Tuva-Mongol%20orocline.%20This%20large-scale%20oroclinal%20bending%20of%20the%20crust%20above%20a%20disappearing%20ocean%20is%20reminiscent%20of%20similarly%20tightening%20oroclines%20in%20Kazakhstan%20and%20Variscan%20Europe,%20which%20closed%20earlier%20by%20subduction%20in%20the%20late%20Paleozoic.}}

@article{Van-Schmus1982a,
	annote = {10.1130/MEM156-p165},
	author = {Van Schmus, W. R. and Green, J. C. and Halls, H. C.},
	date = {1982/01/01},
	date-added = {2015-08-24 20:58:09 +0000},
	date-modified = {2015-08-24 20:58:09 +0000},
	journal = {Geological Society of America Memoirs},
	journal1 = {Geological Society of America Memoirs},
	month = {01},
	pages = {165--172},
	title = {8: Geochronology of Keweenawan rocks of the Lake Superior region: A summary},
	ty = {JOUR},
	url = {http://memoirs.gsapubs.org/content/156/165.abstract N2 - There have been many U-Pb, Rb-Sr., and K-Ar geochronologic studies of Keweenawan rocks. U-Pb results on zircons by Silver and Green show that most of the igneous activity (by volume) occurred 1,110 ± 10 m.y. ago in the Lake Superior region. This includes rocks of the upper normal magnetic polarity sequence as well as upper units of the underlying reversed magnetic polarity sequence, thus dating that reversed-to-normal change at 1,110 ± 10 m.y. ago.Many of the Rb-Sr and K-Ar results on the 1,110 m.y. old units are concordant although in many other instances there is clear discordance with the Rb-Sr and K-Ar ages being too young. Other units, not yet dated by U-Pb methods, also give young ages, potentially suggesting that upper Keweenawan igneous activity may have extended to as young as 900 m.y. ago. However, review of paleomagnetic pole positions for such units shows no evidence for such young crystallization ages; the paleomagnetic data are consistent with all younger units being about 1,110 m.y. old.K-Ar results suggest ages of 1,150-1,250 m.y. for stratigraphically older units (for example, Logan Sills) of the reversed sequence and, along with Rb-Sr results, for normal polarity dikes of the Sudbury dike swarm. Paleomagnetic pole positions are also consistent with early Keweenawan igneous activity occurring about 1,200 m.y. ago. Thus, we conclude that Keweenawan rifting and associated igneous activity began 1,200-1,225 m.y. ago, peaked at 1,110 m.y. ago, and ceased shortly thereafter.},
	volume = {156},
	year = {1982},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://memoirs.gsapubs.org/content/156/165.abstract%20N2%20-%20There%20have%20been%20many%20U-Pb,%20Rb-Sr.,%20and%20K-Ar%20geochronologic%20studies%20of%20Keweenawan%20rocks.%20U-Pb%20results%20on%20zircons%20by%20Silver%20and%20Green%20show%20that%20most%20of%20the%20igneous%20activity%20(by%20volume)%20occurred%201,110%20%C2%B1%2010%20m.y.%20ago%20in%20the%20Lake%20Superior%20region.%20This%20includes%20rocks%20of%20the%20upper%20normal%20magnetic%20polarity%20sequence%20as%20well%20as%20upper%20units%20of%20the%20underlying%20reversed%20magnetic%20polarity%20sequence,%20thus%20dating%20that%20reversed-to-normal%20change%20at%201,110%20%C2%B1%2010%20m.y.%20ago.Many%20of%20the%20Rb-Sr%20and%20K-Ar%20results%20on%20the%201,110%20m.y.%20old%20units%20are%20concordant%20although%20in%20many%20other%20instances%20there%20is%20clear%20discordance%20with%20the%20Rb-Sr%20and%20K-Ar%20ages%20being%20too%20young.%20Other%20units,%20not%20yet%20dated%20by%20U-Pb%20methods,%20also%20give%20young%20ages,%20potentially%20suggesting%20that%20upper%20Keweenawan%20igneous%20activity%20may%20have%20extended%20to%20as%20young%20as%20900%20m.y.%20ago.%20However,%20review%20of%20paleomagnetic%20pole%20positions%20for%20such%20units%20shows%20no%20evidence%20for%20such%20young%20crystallization%20ages;%20the%20paleomagnetic%20data%20are%20consistent%20with%20all%20younger%20units%20being%20about%201,110%20m.y.%20old.K-Ar%20results%20suggest%20ages%20of%201,150-1,250%20m.y.%20for%20stratigraphically%20older%20units%20(for%20example,%20Logan%20Sills)%20of%20the%20reversed%20sequence%20and,%20along%20with%20Rb-Sr%20results,%20for%20normal%20polarity%20dikes%20of%20the%20Sudbury%20dike%20swarm.%20Paleomagnetic%20pole%20positions%20are%20also%20consistent%20with%20early%20Keweenawan%20igneous%20activity%20occurring%20about%201,200%20m.y.%20ago.%20Thus,%20we%20conclude%20that%20Keweenawan%20rifting%20and%20associated%20igneous%20activity%20began%201,200-1,225%20m.y.%20ago,%20peaked%20at%201,110%20m.y.%20ago,%20and%20ceased%20shortly%20thereafter.}}

