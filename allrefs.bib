@article{Kump2014a,
	author = {Kump, Lee R.},
	date = {2014/09/30},
	date-added = {2015-03-03 00:33:42 +0000},
	date-modified = {2015-03-03 00:33:42 +0000},
	journal = {Proceedings of the National Academy of Sciences},
	m3 = {10.1073/pnas.1321496111},
	month = {09},
	number = {39},
	pages = {14062--14065},
	title = {Hypothesized link between Neoproterozoic greening of the land surface and the establishment of an oxygen-rich atmosphere},
	ty = {JOUR},
	url = {http://www.pnas.org/content/111/39/14062.abstract N2 - Considerable geological, geochemical, paleontological, and isotopic evidence exists to support the hypothesis that the atmospheric oxygen level rose from an Archean baseline of essentially zero to modern values in two steps roughly 2.3 billion and 0.8–0.6 billion years ago (Ga). The first step in oxygen content, the Great Oxidation Event, was likely a threshold response to diminishing reductant input from Earth’s interior. Here I provide an alternative to previous suggestions that the second step was the result of the establishment of the first terrestrial fungal–lichen ecosystems. The consumption of oxygen by aerobes respiring this new source of organic matter in soils would have necessitated an increase in the atmospheric oxygen content to compensate for the reduced delivery of oxygen to the weathering environment below the organic-rich upper soil layer. Support for this hypothesis comes from the observed spread toward more negative carbon isotope compositions in Neoproterozoic (1.0–0.542 Ga) and younger limestones altered under the influence of ground waters, and the positive correlation between the carbon isotope composition and oxygen content of modern ground waters in contact with limestones. Thus, the greening of the planet’s land surfaces forced the atmospheric oxygen level to a new, higher equilibrium state.},
	volume = {111},
	year = {2014},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://www.pnas.org/content/111/39/14062.abstract%20N2%20-%20Considerable%20geological,%20geochemical,%20paleontological,%20and%20isotopic%20evidence%20exists%20to%20support%20the%20hypothesis%20that%20the%20atmospheric%20oxygen%20level%20rose%20from%20an%20Archean%20baseline%20of%20essentially%20zero%20to%20modern%20values%20in%20two%20steps%20roughly%202.3%20billion%20and%200.8%E2%80%930.6%20billion%20years%20ago%20(Ga).%20The%20first%20step%20in%20oxygen%20content,%20the%20Great%20Oxidation%20Event,%20was%20likely%20a%20threshold%20response%20to%20diminishing%20reductant%20input%20from%20Earth%E2%80%99s%20interior.%20Here%20I%20provide%20an%20alternative%20to%20previous%20suggestions%20that%20the%20second%20step%20was%20the%20result%20of%20the%20establishment%20of%20the%20first%20terrestrial%20fungal%E2%80%93lichen%20ecosystems.%20The%20consumption%20of%20oxygen%20by%20aerobes%20respiring%20this%20new%20source%20of%20organic%20matter%20in%20soils%20would%20have%20necessitated%20an%20increase%20in%20the%20atmospheric%20oxygen%20content%20to%20compensate%20for%20the%20reduced%20delivery%20of%20oxygen%20to%20the%20weathering%20environment%20below%20the%20organic-rich%20upper%20soil%20layer.%20Support%20for%20this%20hypothesis%20comes%20from%20the%20observed%20spread%20toward%20more%20negative%20carbon%20isotope%20compositions%20in%20Neoproterozoic%20(1.0%E2%80%930.542%20Ga)%20and%20younger%20limestones%20altered%20under%20the%20influence%20of%20ground%20waters,%20and%20the%20positive%20correlation%20between%20the%20carbon%20isotope%20composition%20and%20oxygen%20content%20of%20modern%20ground%20waters%20in%20contact%20with%20limestones.%20Thus,%20the%20greening%20of%20the%20planet%E2%80%99s%20land%20surfaces%20forced%20the%20atmospheric%20oxygen%20level%20to%20a%20new,%20higher%20equilibrium%20state.}}

