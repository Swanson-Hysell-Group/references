@article{Halls2004b,
	annote = {10.1139/e03-093},
	author = {Halls, Henry C. and Davis, Donald W.},
	date = {2004/03/01},
	date-added = {2014-01-07 22:56:26 +0000},
	date-modified = {2014-01-07 22:56:26 +0000},
	journal = {Canadian Journal of Earth Sciences},
	journal1 = {Canadian Journal of Earth Sciences},
	month = {03},
	number = {3},
	pages = {255--269},
	title = {Paleomagnetism and U--Pb geochronology of the 2.17 Ga Biscotasing dyke swarm, Ontario, Canada: evidence for vertical-axis crustal rotation across the Kapuskasing Zone},
	ty = {JOUR},
	url = {http://cjes.geoscienceworld.org/content/41/3/255.abstract N2 - U–Pb dates on baddeleyite yield ages of 2167.8 ± 2.2 and 2171.6 ± 1.2 Ma on two northeast-trending dykes west of the Kapuskasing Zone in Ontario, Canada. These ages identify the dykes as belonging to the Biscotasing dyke swarm east of the Kapuskasing Zone, which was previously dated at 2166.7 ± 1.4 Ma by U–Pb on baddeleyite and zircon. The new dates show that the Biscotasing swarm was emplaced over an area of at least 300 000 km2, much larger than hitherto suspected, and in a geologically short period of time of about 5 million years. A comparison of paleomagnetic data from Biscotasing and 2.45 Ga Matachewan dykes on either side of the Kapuskasing Zone suggests that the western half of the Superior Province has rotated about 10°–20° counterclockwise relative to the eastern half across the Kapuskasing Zone. This movement may have been accompanied by rifting farther north which ultimately led to the Paleoproterozoic embayment, underlying Hudson Bay, that gives the Superior Province its characteristic butterfly-shaped outline.},
	volume = {41},
	year = {2004},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://cjes.geoscienceworld.org/content/41/3/255.abstract%20N2%20-%20U%E2%80%93Pb%20dates%20on%20baddeleyite%20yield%20ages%20of%202167.8%20%C2%B1%202.2%20and%202171.6%20%C2%B1%201.2%20Ma%20on%20two%20northeast-trending%20dykes%20west%20of%20the%20Kapuskasing%20Zone%20in%20Ontario,%20Canada.%20These%20ages%20identify%20the%20dykes%20as%20belonging%20to%20the%20Biscotasing%20dyke%20swarm%20east%20of%20the%20Kapuskasing%20Zone,%20which%20was%20previously%20dated%20at%202166.7%20%C2%B1%201.4%20Ma%20by%20U%E2%80%93Pb%20on%20baddeleyite%20and%20zircon.%20The%20new%20dates%20show%20that%20the%20Biscotasing%20swarm%20was%20emplaced%20over%20an%20area%20of%20at%20least%20300%20000%20km2,%20much%20larger%20than%20hitherto%20suspected,%20and%20in%20a%20geologically%20short%20period%20of%20time%20of%20about%205%20million%20years.%20A%20comparison%20of%20paleomagnetic%20data%20from%20Biscotasing%20and%202.45%20Ga%20Matachewan%20dykes%20on%20either%20side%20of%20the%20Kapuskasing%20Zone%20suggests%20that%20the%20western%20half%20of%20the%20Superior%20Province%20has%20rotated%20about%2010%C2%B0%E2%80%9320%C2%B0%20counterclockwise%20relative%20to%20the%20eastern%20half%20across%20the%20Kapuskasing%20Zone.%20This%20movement%20may%20have%20been%20accompanied%20by%20rifting%20farther%20north%20which%20ultimately%20led%20to%20the%20Paleoproterozoic%20embayment,%20underlying%20Hudson%20Bay,%20that%20gives%20the%20Superior%20Province%20its%20characteristic%20butterfly-shaped%20outline.}}

@article{Rooney2014a,
	author = {Rooney, Alan D. and Macdonald, Francis A. and Strauss, Justin V. and Dud{\'a}s, Francis {\"O}. and Hallmann, Christian and Selby, David},
	date = {2013/12/16},
	date-added = {2014-01-07 22:34:42 +0000},
	date-modified = {2014-03-14 23:36:33 +0000},
	doi = {10.1073/pnas.1317266110},
	journal = {Proceedings of the National Academy of Sciences},
	month = {12},
	pages = {51-56},
	title = {{Re-Os geochronology and coupled Os-Sr isotope constraints on the Sturtian snowball Earth}},
	ty = {JOUR},
	volume = {111},
	year = {2014},
	bdsk-file-1 = {},
	bdsk-file-2 = {},
	bdsk-url-1 = {http://www.pnas.org/content/early/2013/12/12/1317266110.abstract%20N2%20-%20After%20nearly%20a%20billion%20years%20with%20no%20evidence%20for%20glaciation,%20ice%20advanced%20to%20equatorial%20latitudes%20at%20least%20twice%20between%20717%20and%20635%20Mya.%20Although%20the%20initiation%20mechanism%20of%20these%20Neoproterozoic%20Snowball%20Earth%20events%20has%20remained%20a%20mystery,%20the%20broad%20synchronicity%20of%20rifting%20of%20the%20supercontinent%20Rodinia,%20the%20emplacement%20of%20large%20igneous%20provinces%20at%20low%20latitude,%20and%20the%20onset%20of%20the%20Sturtian%20glaciation%20has%20suggested%20a%20tectonic%20forcing.%20We%20present%20unique%20Re-Os%20geochronology%20and%20high-resolution%20Os%20and%20Sr%20isotope%20profiles%20bracketing%20Sturtian-age%20glacial%20deposits%20of%20the%20Rapitan%20Group%20in%20northwest%20Canada.%20Coupled%20with%20existing%20U-Pb%20dates,%20the%20postglacial%20Re-Os%20date%20of%20662.4%20%C2%B1%203.9%20Mya%20represents%20direct%20geochronological%20constraints%20for%20both%20the%20onset%20and%20demise%20of%20a%20Cryogenian%20glaciation%20from%20the%20same%20continental%20margin%20and%20suggests%20a%2055-My%20duration%20of%20the%20Sturtian%20glacial%20epoch.%20The%20Os%20and%20Sr%20isotope%20data%20allow%20us%20to%20assess%20the%20relative%20weathering%20input%20of%20old%20radiogenic%20crust%20and%20more%20juvenile,%20mantle-derived%20substrate.%20The%20preglacial%20isotopic%20signals%20are%20consistent%20with%20an%20enhanced%20contribution%20of%20juvenile%20material%20to%20the%20oceans%20and%20glacial%20initiation%20through%20enhanced%20global%20weatherability.%20In%20contrast,%20postglacial%20strata%20feature%20radiogenic%20Os%20and%20Sr%20isotope%20compositions%20indicative%20of%20extensive%20glacial%20scouring%20of%20the%20continents%20and%20intense%20silicate%20weathering%20in%20a%20post%E2%80%93Snowball%20Earth%20hothouse.}}

