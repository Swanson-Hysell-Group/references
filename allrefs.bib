	bdsk-url-1 = {http://geology.gsapubs.org/content/39/1/39.abstract%20N2%20-%20Previous%20paleomagnetic%20work%20has%20appeared%20to%20demand%20the%20breakup%20of%20southwest%20United%20States%E2%88%92East%20Antarctic%20(SWEAT)%20type%20Rodinia%20reconstructions%20before%20ca.%20750%20Ma,%20significantly%20earlier%20than%20the%20stratigraphic%20record%20of%20rift-drift%20transition%20between%20715%20Ma%20and%20650%20Ma.%20Here%20we%20reanalyze%20Australian%20paleomagnetic%20and%20regional%20tectonic%20data%20to%20produce%20a%20model%20in%20which%20the%20Precambrian%20Australian%20continent%20had%20a%20slightly%20different%20configuration%20before%20the%20breakup%20of%20Rodinia.%20A%20cross-continental%20megashear%20zone%20developed%20along%20the%20Paterson%20and%20Petermann%20orogens%20at%20ca.%20650%E2%80%93550%20Ma,%20during%20or%20after%20the%20breakup%20of%20Rodinia,%20manifested%20as%20an%20%E2%88%BC40%C2%B0%20clockwise%20rotation%20of%20the%20South%20and%20West%20Australian%20cratons%20relative%20to%20the%20North%20Australian%20craton%20around%20a%20vertical%20axis%20in%20Central%20Australia.%20This%20model%20reconciles%20major%20paleomagnetic%20discrepancies%20within%20Australia,%20and%20allows%20for%20a%20longer%20lifespan%20of%20SWEAT-like%20reconstructions%20of%20Rodinia%20that%20are%20consistent%20with%20the%20Neoproterozoic%20stratigraphic%20records%20of%20Australia%20and%20Laurentia.}}

@article{Le-Heron2011a,
	annote = {10.1130/G31547.1},
