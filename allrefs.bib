@article{Tarduno1994a,
	abstract = {Magnetic hysteresis data from the western equatorial Pacific suggest that the preservation of magnetic remanence in pelagic carbonates is controlled by paleoproductivity. Hysteresis excursions (100 k.y. intervals) are linked here to greater magnetic dissolution associated with increased glacial organic carbon supply. Changes in the redox boundary coupled to glacial terminations result in anomalous magnetic features which are preserved in the sedimentary record. These high-frequency variations are superimposed on a longer term signal of magnetic dissolution which may reflect decreased productivity since the Miocene.},
	author = {Tarduno, J. A.},
	date-added = {2008-02-21 11:48:14 -0500},
