@article{Arrial2013a,
	abstract = {Subduction is driven by the negative buoyancy of the slab, which depends on both the temperature and composition of the lithospheric plate. In the case of subduction of an oceanic plateau, larger thickness of the lower-density crust and harzburgite layers can locally decrease the negative buoyancy available to drive subduction. However, the ability of a plateau to have an impact on subduction depends on the total buoyancy of the slab, and therefore also depends on size of the plateau and the basalt to eclogite transition, which substantially increases the density of the crust. Using 2-D numerical finite element models of subduction, we investigate the role of eclogitization and oceanic plateau size (thickness and length) in the process of oceanic plateau subduction. Model results show that eclogitization of the crust substantially increases the chances that a plateau will be subducted because the extra buoyancy of larger plateaus is lost through the phase transition. For kinematically driven models, all plateaus are subducted regardless of the thickness or width. Extrapolation of these results to 3-D geometry shows that sufficient slab buoyancy is available to sustain subduction for narrow plateaus with slab widths 6--7 times the plateau width (depending on plateau thickness and length). In dynamically driven models, subduction of oceanic plateaus of various sizes can substantially slow subduction, and large plateaus ( {$>$} 200 km long and {$>$} 25 km thick) can lead to break-off of the slab and underplating of the plateau.},
	author = {Arrial, Pierre-Andr{\'e} and Billen, Magali I.},
	date = {2013/2/1/},
	date-added = {2014-09-11 21:54:58 +0000},
	date-modified = {2014-09-11 21:54:58 +0000},
	day = {1},
	doi = {http://dx.doi.org/10.1016/j.epsl.2012.12.011},
	isbn = {0012-821X},
	journal = {Earth and Planetary Science Letters},
	keywords = {buoyancy; plateau geometry; flat-slab; break-off; rheology},
	month = {2},
	number = {0},
	pages = {34--43},
	title = {Influence of geometry and eclogitization on oceanic plateau subduction},
	ty = {JOUR},
	url = {http://www.sciencedirect.com/science/article/pii/S0012821X12006978},
	volume = {363},
	year = {2013},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://www.sciencedirect.com/science/article/pii/S0012821X12006978},
	bdsk-url-2 = {http://dx.doi.org/10.1016/j.epsl.2012.12.011}}

@article{Rodriguez-Gonzalez2014a,
	abstract = {Abstract The direction of plate tectonic motion and the direction of mantle flow, as inferred from observations of seismic anisotropy measurements, show a good global correlation far from subduction zones. However, this correlation is poor near subduction zones, where below the slab seismic anisotropy is aligned parallel to the trench and above the slab has a complex pattern, which has not been fully explained. Here we present time-dependent three-dimensional (3D) fully-dynamic simulations of subduction to study the effect of overriding plate structure on the evolution of slab geometry and induced mantle flow. We find that along-strike variation in thermal thickness of the overriding plate causes increased hydrodynamic suction and shallower slab dip beneath the colder portion of the overriding plate; the variation in slab geometry drives strong trench-parallel flow beneath the slab and a complex flow pattern above the slab. This new mechanism for driving trench-parallel flow provides a good explanation for seismic anisotropy observations from the Middle and South America subduction zones, where both slab dip and overriding plate thermal state are strongly variable and correlated, and thus may be an important mechanism in other subduction zones. The location and strength of trench-parallel flow vary with the time-dependent evolution of the slab, suggesting that the global variability in seismic anisotropy observations in subduction zones is in part due to the non-steady-state behavior of these systems.},
	author = {Rodr{\'\i}guez-Gonz{\'a}lez, Juan and Billen, Magali I. and Negredo, Ana M.},
	date = {2014/9/1/},
	date-added = {2014-09-11 21:21:58 +0000},
	date-modified = {2014-09-11 21:21:58 +0000},
	day = {1},
	doi = {http://dx.doi.org/10.1016/j.epsl.2014.06.013},
	isbn = {0012-821X},
	journal = {Earth and Planetary Science Letters},
	keywords = {subduction dynamics; slab dip; trench-parallel flow; seismic anisotropy; thermo-mechanical numerical modeling; Middle and South America},
	month = {9},
	number = {0},
	pages = {227--235},
	title = {Non-steady-state subduction and trench-parallel flow induced by overriding plate structure},
	ty = {JOUR},
	url = {http://www.sciencedirect.com/science/article/pii/S0012821X14003902},
	volume = {401},
	year = {2014},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://www.sciencedirect.com/science/article/pii/S0012821X14003902},
	bdsk-url-2 = {http://dx.doi.org/10.1016/j.epsl.2014.06.013}}

@article{Ferre2014a,
	abstract = {Abstract Wasilewski et al. (1979) concluded that no magnetic remanence existed in the uppermost mantle and that even if present, such sources would be at temperatures too high to contribute to long wavelength magnetic anomalies (LWMA). However, new collections of unaltered mantle xenoliths indicate that the uppermost mantle could contain ferromagnetic minerals. 1. The analysis of some LWMA over cratons and forearcs suggest magnetic sources in the uppermost mantle. 2. The most common ferromagnetic phase in the uppermost mantle is stoichiometric magnetite. Assuming a 30 km-thick crust, and crustal and mantle geotherms of 15 $\,^{\circ}$C/km and 5 $\,^{\circ}$C/km, respectively, the 600 $\,^{\circ}$C Curie temperature implies a 30 km-thick layer of mantle. 3. The uppermost mantle is cooler than 600 $\,^{\circ}$C in Archean and Proterozoic shields (&gt; 350 $\,^{\circ}$C), subduction zones (&gt; 300 $\,^{\circ}$C) and old oceanic basins (&gt; 250 $\,^{\circ}$C). 4. Recently investigated sets of unaltered mantle xenoliths contain pure magnetite inclusions in olivine and pyroxene formed in equilibrium with the host silicate. 5. The ascent of mantle xenoliths occurs in less than a day. Diffusion rates in olivine suggest that the growth of magnetite possible within this time frame cannot account for the size and distribution of magnetite particles in our samples. 6. Demagnetization of natural remanent magnetization (NRM) of unaltered mantle xenoliths unambiguously indicates only a single component acquired upon cooling at the Earth's surface. This is most easily explained as a thermoremanent magnetization acquired by pre-existing ferromagnetic minerals as xenoliths cool rapidly at the Earth's surface from magmatic temperatures, acquired during ascent. 7. Modern experimental data suggest that the w{\"u}stite--magnetite oxygen buffer and the fayalite--magnetite--quartz oxygen buffer extend several tens of km within the uppermost mantle. 8. The magnetic properties of mantle xenoliths vary consistently across tectonic settings. In conclusion, the model of a uniformly non-magnetic mantle should be revisited.},
	author = {Ferr{\'e}, Eric C. and Friedman, Sarah A. and Mart{\'\i}n-Hern{\'a}ndez, Fat{\'\i}ma and Feinberg, Joshua M. and Till, Jessica L. and Ionov, Dmitri A. and Conder, James A.},
	booktitle = {Crustal and mantle sources of magnetic anomalies},
	date = {2014/6/11/},
	date-added = {2014-09-09 21:41:03 +0000},
	date-modified = {2014-09-09 21:41:03 +0000},
	day = {11},
	doi = {http://dx.doi.org/10.1016/j.tecto.2014.01.004},
	isbn = {0040-1951},
	journal = {Tectonophysics},
	keywords = {Mantle; Xenolith; Magnetization; Magnetic anomaly; Magnetite; NRM},
	month = {6},
	number = {0},
	pages = {3--14},
	title = {Eight good reasons why the uppermost mantle could be magnetic},
	ty = {JOUR},
	url = {http://www.sciencedirect.com/science/article/pii/S0040195114000225},
	volume = {624--625},
	year = {2014},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://www.sciencedirect.com/science/article/pii/S0040195114000225},
	bdsk-url-2 = {http://dx.doi.org/10.1016/j.tecto.2014.01.004}}

@article{Oehlert2014a,
	abstract = {Many negative δ13C excursions in marine carbonates from the geological record are interpreted to record significant biogeochemical events in early Earth history. The assumption that no post-depositional processes can simultaneously alter carbonate and organic δ13C values towards more negative values is the cornerstone of this approach. However, the effects of post-depositional alteration on the relationship between carbonate and organic δ13C values have not been directly evaluated. Here we present paired carbonate and organic δ13C records that exhibit a coupled negative excursion resulting from multiple periods of meteoric alteration of the carbonate δ13C record, and consequent contributions of isotopically negative terrestrial organic matter to the sedimentary record. The possibility that carbonate and organic δ13C records can be simultaneously shifted towards lower δ13C values during periods of subaerial exposure may necessitate the reappraisal of some of the δ13C anomalies associated with noteworthy biogeochemical events throughout Earth history.},
	annote = {Supplementary information available for this article at http://www.nature.com/ncomms/2014/140819/ncomms5672/suppinfo/ncomms5672{\_}S1.html},
	author = {Oehlert, Amanda M. and Swart, Peter K.},
	date = {2014/08/19/online},
	date-added = {2014-08-24 21:11:41 +0000},
	date-modified = {2014-08-24 21:11:41 +0000},
	day = {19},
	journal = {Nat Commun},
	l3 = {10.1038/ncomms5672},
	m3 = {Article},
	month = {08},
	publisher = {Nature Publishing Group, a division of Macmillan Publishers Limited. All Rights Reserved.},
	title = {Interpreting carbonate and organic carbon isotope covariance in the sedimentary record},
	ty = {JOUR},
	url = {http://dx.doi.org/10.1038/ncomms5672},
	volume = {5},
	year = {2014},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://dx.doi.org/10.1038/ncomms5672}}

@article{Fischer2014a,
	author = {Fischer, Woodward W. and Fike, David A. and Johnson, Jena E. and Raub, Timothy D. and Guan, Yunbin and Kirschvink, Joseph L. and Eiler, John M.},
	date = {2014/04/15},
	date-added = {2014-08-21 13:01:56 +0000},
	date-modified = {2014-08-21 13:01:56 +0000},
	journal = {Proceedings of the National Academy of Sciences},
	m3 = {10.1073/pnas.1322577111},
	month = {04},
	number = {15},
	pages = {5468--5473},
	title = {SQUID--SIMS is a useful approach to uncover primary signals in the Archean sulfur cycle},
	ty = {JOUR},
	url = {http://www.pnas.org/content/111/15/5468.abstract N2 - Many aspects of Earth’s early sulfur cycle, from the origin of mass-anomalous fractionations to the degree of biological participation, remain poorly understood—in part due to complications from postdepositional diagenetic and metamorphic processes. Using a combination of scanning high-resolution magnetic superconducting quantum interference device (SQUID) microscopy and secondary ion mass spectrometry (SIMS) of sulfur isotopes (32S, 33S, and 34S), we examined drill core samples from slope and basinal environments adjacent to a major Late Archean (∼2.6–2.5 Ga) marine carbonate platform from South Africa. Coupled with petrography, these techniques can untangle the complex history of mineralization in samples containing diverse sulfur-bearing phases. We focused on pyrite nodules, precipitated in shallow sediments. These textures record systematic spatial differences in both mass-dependent and mass-anomalous sulfur-isotopic composition over length scales of even a few hundred microns. Petrography and magnetic imaging demonstrate that mass-anomalous fractionations were acquired before burial and compaction, but also show evidence of postdepositional alteration 500 million y after deposition. Using magnetic imaging to screen for primary phases, we observed large spatial gradients in Δ33S (>4‰) in nodules, pointing to substantial environmental heterogeneity and dynamic mixing of sulfur pools on geologically rapid timescales. In other nodules, large systematic radial δ34S gradients (>20‰) were observed, from low values near their centers increasing to high values near their rims. These fractionations support hypotheses that microbial sulfate reduction was an important metabolism in organic-rich Archean environments—even in an Archean ocean basin dominated by iron chemistry.},
	volume = {111},
	year = {2014},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://www.pnas.org/content/111/15/5468.abstract%20N2%20-%20Many%20aspects%20of%20Earth%E2%80%99s%20early%20sulfur%20cycle,%20from%20the%20origin%20of%20mass-anomalous%20fractionations%20to%20the%20degree%20of%20biological%20participation,%20remain%20poorly%20understood%E2%80%94in%20part%20due%20to%20complications%20from%20postdepositional%20diagenetic%20and%20metamorphic%20processes.%20Using%20a%20combination%20of%20scanning%20high-resolution%20magnetic%20superconducting%20quantum%20interference%20device%20(SQUID)%20microscopy%20and%20secondary%20ion%20mass%20spectrometry%20(SIMS)%20of%20sulfur%20isotopes%20(32S,%2033S,%20and%2034S),%20we%20examined%20drill%20core%20samples%20from%20slope%20and%20basinal%20environments%20adjacent%20to%20a%20major%20Late%20Archean%20(%E2%88%BC2.6%E2%80%932.5%20Ga)%20marine%20carbonate%20platform%20from%20South%20Africa.%20Coupled%20with%20petrography,%20these%20techniques%20can%20untangle%20the%20complex%20history%20of%20mineralization%20in%20samples%20containing%20diverse%20sulfur-bearing%20phases.%20We%20focused%20on%20pyrite%20nodules,%20precipitated%20in%20shallow%20sediments.%20These%20textures%20record%20systematic%20spatial%20differences%20in%20both%20mass-dependent%20and%20mass-anomalous%20sulfur-isotopic%20composition%20over%20length%20scales%20of%20even%20a%20few%20hundred%20microns.%20Petrography%20and%20magnetic%20imaging%20demonstrate%20that%20mass-anomalous%20fractionations%20were%20acquired%20before%20burial%20and%20compaction,%20but%20also%20show%20evidence%20of%20postdepositional%20alteration%20500%20million%20y%20after%20deposition.%20Using%20magnetic%20imaging%20to%20screen%20for%20primary%20phases,%20we%20observed%20large%20spatial%20gradients%20in%20%CE%9433S%20(%3E4%E2%80%B0)%20in%20nodules,%20pointing%20to%20substantial%20environmental%20heterogeneity%20and%20dynamic%20mixing%20of%20sulfur%20pools%20on%20geologically%20rapid%20timescales.%20In%20other%20nodules,%20large%20systematic%20radial%20%CE%B434S%20gradients%20(%3E20%E2%80%B0)%20were%20observed,%20from%20low%20values%20near%20their%20centers%20increasing%20to%20high%20values%20near%20their%20rims.%20These%20fractionations%20support%20hypotheses%20that%20microbial%20sulfate%20reduction%20was%20an%20important%20metabolism%20in%20organic-rich%20Archean%20environments%E2%80%94even%20in%20an%20Archean%20ocean%20basin%20dominated%20by%20iron%20chemistry.}}

@article{Liang2006a,
	author = {Liang, Mao-Chang and Hartman, Hyman and Kopp, Robert E. and Kirschvink, Joseph L. and Yung, Yuk L.},
	date = {2006/12/12},
	date-added = {2014-08-21 12:57:52 +0000},
	date-modified = {2014-08-21 12:57:52 +0000},
	journal = {Proceedings of the National Academy of Sciences},
	m3 = {10.1073/pnas.0608839103},
	month = {12},
	number = {50},
	pages = {18896--18899},
	title = {Production of hydrogen peroxide in the atmosphere of a Snowball Earth and the origin of oxygenic photosynthesis},
	ty = {JOUR},
	url = {http://www.pnas.org/content/103/50/18896.abstract N2 - During Proterozoic time, Earth experienced two intervals with one or more episodes of low-latitude glaciation, which are probable “Snowball Earth” events. Although the severity of the historical glaciations is debated, theoretical “hard Snowball” conditions are associated with the nearly complete shutdown of the hydrological cycle. We show here that, during such long and severe glacial intervals, a weak hydrological cycle coupled with photochemical reactions involving water vapor would give rise to the sustained production of hydrogen peroxide. The photochemical production of hydrogen peroxide has been proposed previously as the primary mechanism for oxidizing the surface of Mars. During a Snowball, hydrogen peroxide could be stored in the ice; it would then be released directly into the ocean and the atmosphere upon melting and could mediate global oxidation events in the aftermath of the Snowball, such as that recorded in the Fe and Mn oxides of the Kalahari Manganese Field, deposited after the Paleoproterozoic low-latitude Makganyene glaciation. Low levels of peroxides and molecular oxygen generated during Archean and earliest Proterozoic non-Snowball glacial intervals could have driven the evolution of oxygen-mediating and -using enzymes and thereby paved the way for the eventual appearance of oxygenic photosynthesis.},
	volume = {103},
	year = {2006},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://www.pnas.org/content/103/50/18896.abstract%20N2%20-%20During%20Proterozoic%20time,%20Earth%20experienced%20two%20intervals%20with%20one%20or%20more%20episodes%20of%20low-latitude%20glaciation,%20which%20are%20probable%20%E2%80%9CSnowball%20Earth%E2%80%9D%20events.%20Although%20the%20severity%20of%20the%20historical%20glaciations%20is%20debated,%20theoretical%20%E2%80%9Chard%20Snowball%E2%80%9D%20conditions%20are%20associated%20with%20the%20nearly%20complete%20shutdown%20of%20the%20hydrological%20cycle.%20We%20show%20here%20that,%20during%20such%20long%20and%20severe%20glacial%20intervals,%20a%20weak%20hydrological%20cycle%20coupled%20with%20photochemical%20reactions%20involving%20water%20vapor%20would%20give%20rise%20to%20the%20sustained%20production%20of%20hydrogen%20peroxide.%20The%20photochemical%20production%20of%20hydrogen%20peroxide%20has%20been%20proposed%20previously%20as%20the%20primary%20mechanism%20for%20oxidizing%20the%20surface%20of%20Mars.%20During%20a%20Snowball,%20hydrogen%20peroxide%20could%20be%20stored%20in%20the%20ice;%20it%20would%20then%20be%20released%20directly%20into%20the%20ocean%20and%20the%20atmosphere%20upon%20melting%20and%20could%20mediate%20global%20oxidation%20events%20in%20the%20aftermath%20of%20the%20Snowball,%20such%20as%20that%20recorded%20in%20the%20Fe%20and%20Mn%20oxides%20of%20the%20Kalahari%20Manganese%20Field,%20deposited%20after%20the%20Paleoproterozoic%20low-latitude%20Makganyene%20glaciation.%20Low%20levels%20of%20peroxides%20and%20molecular%20oxygen%20generated%20during%20Archean%20and%20earliest%20Proterozoic%20non-Snowball%20glacial%20intervals%20could%20have%20driven%20the%20evolution%20of%20oxygen-mediating%20and%20-using%20enzymes%20and%20thereby%20paved%20the%20way%20for%20the%20eventual%20appearance%20of%20oxygenic%20photosynthesis.}}

@article{Grout1959a,
	author = {Grout, F. F. and Sharp, R. P. and Schwartz, G. M.},
	date-added = {2014-08-17 01:39:31 +0000},
