@article{Windley2007a,
	annote = {10.1144/0016-76492006-022},
	author = {Windley, Brian F. and Alexeiev, Dmitriy and Xiao, Wenjiao and Kr{\"o}ner, Alfred and Badarch, Gombosuren},
	date = {2007/01/01},
	date-added = {2013-05-09 15:32:22 +0000},
	date-modified = {2013-05-09 15:32:22 +0000},
	journal = {Journal of the Geological Society},
	journal1 = {Journal of the Geological Society},
	month = {01},
	number = {1},
	pages = {31--47},
	title = {Tectonic models for accretion of the Central Asian Orogenic Belt},
	ty = {JOUR},
	url = {http://jgs.lyellcollection.org/content/164/1/31.abstract N2 - The Central Asian Orogenic Belt (c. 1000–250 Ma) formed by accretion of island arcs, ophiolites, oceanic islands, seamounts, accretionary wedges, oceanic plateaux and microcontinents in a manner comparable with that of circum-Pacific Mesozoic–Cenozoic accretionary orogens. Palaeomagnetic and palaeofloral data indicate that early accretion (Vendian–Ordovician) took place when Baltica and Siberia were separated by a wide ocean. Island arcs and Precambrian microcontinents accreted to the active margins of the two continents or amalgamated in an oceanic setting (as in Kazakhstan) by roll-back and collision, forming a huge accretionary collage. The Palaeo-Asian Ocean closed in the Permian with formation of the Solonker suture. We evaluate contrasting tectonic models for the evolution of the orogenic belt. Current information provides little support for the main tenets of the one- or three-arc Kipchak model; current data suggest that an archipelago-type (Indonesian) model is more viable. Some diagnostic features of ridge–trench interaction are present in the Central Asian orogen (e.g. granites, adakites, boninites, near-trench magmatism, Alaskan-type mafic–ultramafic complexes, high-temperature metamorphic belts that prograde rapidly from low-grade belts, rhyolitic ash-fall tuffs). They offer a promising perspective for future investigations.},
	volume = {164},
	year = {2007},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://jgs.lyellcollection.org/content/164/1/31.abstract%20N2%20-%20The%20Central%20Asian%20Orogenic%20Belt%20(c.%201000%E2%80%93250%20Ma)%20formed%20by%20accretion%20of%20island%20arcs,%20ophiolites,%20oceanic%20islands,%20seamounts,%20accretionary%20wedges,%20oceanic%20plateaux%20and%20microcontinents%20in%20a%20manner%20comparable%20with%20that%20of%20circum-Pacific%20Mesozoic%E2%80%93Cenozoic%20accretionary%20orogens.%20Palaeomagnetic%20and%20palaeofloral%20data%20indicate%20that%20early%20accretion%20(Vendian%E2%80%93Ordovician)%20took%20place%20when%20Baltica%20and%20Siberia%20were%20separated%20by%20a%20wide%20ocean.%20Island%20arcs%20and%20Precambrian%20microcontinents%20accreted%20to%20the%20active%20margins%20of%20the%20two%20continents%20or%20amalgamated%20in%20an%20oceanic%20setting%20(as%20in%20Kazakhstan)%20by%20roll-back%20and%20collision,%20forming%20a%20huge%20accretionary%20collage.%20The%20Palaeo-Asian%20Ocean%20closed%20in%20the%20Permian%20with%20formation%20of%20the%20Solonker%20suture.%20We%20evaluate%20contrasting%20tectonic%20models%20for%20the%20evolution%20of%20the%20orogenic%20belt.%20Current%20information%20provides%20little%20support%20for%20the%20main%20tenets%20of%20the%20one-%20or%20three-arc%20Kipchak%20model;%20current%20data%20suggest%20that%20an%20archipelago-type%20(Indonesian)%20model%20is%20more%20viable.%20Some%20diagnostic%20features%20of%20ridge%E2%80%93trench%20interaction%20are%20present%20in%20the%20Central%20Asian%20orogen%20(e.g.%20granites,%20adakites,%20boninites,%20near-trench%20magmatism,%20Alaskan-type%20mafic%E2%80%93ultramafic%20complexes,%20high-temperature%20metamorphic%20belts%20that%20prograde%20rapidly%20from%20low-grade%20belts,%20rhyolitic%20ash-fall%20tuffs).%20They%20offer%20a%20promising%20perspective%20for%20future%20investigations.}}

@article{Pares2013a,
	annote = {10.1093/gji/ggs027},
	author = {Par{\'e}s, Josep M. and Van der Voo, Rob},
	date = {2013/01/01},
	date-added = {2013-05-09 14:35:02 +0000},
	date-modified = {2013-05-09 14:35:02 +0000},
	journal = {Geophysical Journal International},
	journal1 = {Geophysical Journal International},
	month = {01},
	number = {1},
	pages = {75--81},
	title = {Non-antipodal directions in magnetostratigraphy: an overprint bias?},
	ty = {JOUR},
	url = {http://gji.oxfordjournals.org/content/192/1/75.abstract N2 - Paleomagnetic records show very often that the directions of normal and reverse polarity are not quite antipodal, as one would expect for an axial geocentric dipole model. Specifically, in magnetostratigraphic studies of Tertiary sediments, which include large data sets of paleomagnetic directions of both polarities, it is commonly observed that reverse polarity inclinations are shallower than those of normal polarity. Such an inclination anomaly has important implications for both paleomagnetism and paleogeographic reconstructions. We investigate the conventional explanation for such asymmetry, which involves the presence of a persistent, partially unremoved present day field magnetization in the studied rocks. Both plate motion history and inclination shallowing, which we evaluate in detail, can play an important role in the paleomagnetic record. Our analysis shows that alternatively, it is plausible that the inclination anomaly is due to a contribution of an axial octupole, in accordance with observations of the recent (0–5 Ma) geomagnetic field recorded in lava flows.},
	volume = {192},
	year = {2013},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://gji.oxfordjournals.org/content/192/1/75.abstract%20N2%20-%20Paleomagnetic%20records%20show%20very%20often%20that%20the%20directions%20of%20normal%20and%20reverse%20polarity%20are%20not%20quite%20antipodal,%20as%20one%20would%20expect%20for%20an%20axial%20geocentric%20dipole%20model.%20Specifically,%20in%20magnetostratigraphic%20studies%20of%20Tertiary%20sediments,%20which%20include%20large%20data%20sets%20of%20paleomagnetic%20directions%20of%20both%20polarities,%20it%20is%20commonly%20observed%20that%20reverse%20polarity%20inclinations%20are%20shallower%20than%20those%20of%20normal%20polarity.%20Such%20an%20inclination%20anomaly%20has%20important%20implications%20for%20both%20paleomagnetism%20and%20paleogeographic%20reconstructions.%20We%20investigate%20the%20conventional%20explanation%20for%20such%20asymmetry,%20which%20involves%20the%20presence%20of%20a%20persistent,%20partially%20unremoved%20present%20day%20field%20magnetization%20in%20the%20studied%20rocks.%20Both%20plate%20motion%20history%20and%20inclination%20shallowing,%20which%20we%20evaluate%20in%20detail,%20can%20play%20an%20important%20role%20in%20the%20paleomagnetic%20record.%20Our%20analysis%20shows%20that%20alternatively,%20it%20is%20plausible%20that%20the%20inclination%20anomaly%20is%20due%20to%20a%20contribution%20of%20an%20axial%20octupole,%20in%20accordance%20with%20observations%20of%20the%20recent%20(0%E2%80%935%20Ma)%20geomagnetic%20field%20recorded%20in%20lava%20flows.}}

