	journal = {Geology},
	journal1 = {Geology},
	month = {01},
	number = {1},
	pages = {87--90},
	title = {Does the global stratigraphic reproducibility of δ13C in Neoproterozoic carbonates require a marine origin? A Pliocene--Pleistocene comparison},
	ty = {JOUR},
	volume = {40},
	year = {2012},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://geology.gsapubs.org/content/40/1/87.abstract%20N2%20-%20The%20large%20and%20systematic%20negative%20shifts%20in%20the%20%CE%B413C%20values%20(%3E12%E2%80%B0)%20of%20carbonate-dominated%20rocks%20that%20preceded%20Neoproterozoic%20glacial%20successions%20have%20been%20interpreted%20to%20record%20a%20dramatic%20series%20of%20global%20environmental%20and%20evolutionary%20events.%20These%20values%20are%20widely%20considered%20to%20be%20marine%20rather%20than%20diagenetic%20in%20origin%20because%20stratigraphic%20patterns%20of%20change%20are%20systematic%20and%20reproducible%20from%20basin%20to%20basin,%20distinct%20in%20magnitude,%20and%20associated%20with%20recognizable%20stratigraphic%20markers%20such%20as%20glacial%20deposits.%20In%20contrast,%20diagenetic%20systems%20are%20commonly%20considered%20to%20have%20a%20more%20local%20and%20stochastic%20influence%20on%20%CE%B413C%20values.%20Cores%20taken%20in%20Quaternary%20carbonate%20platform%20sediments,%20however,%20reveal%20a%20curious%20similarity%20in%20magnitude,%20thickness,%20and%20core%20to%20core%20reproducibility%20where%20diagenetic%20alteration%20has%20occurred%20in%20response%20to%20sea-level%20fall.%20Sea-level%20changes%20produced%20similar%20%CE%B413C%20and%20%CE%B418O%20stratigraphic%20records%20at%20globally%20disparate%20locations,%20which%20are%20unrelated%20to%20the%20global%20marine%20%CE%B413C%20signal%20and%20bear%20no%20relation%20to%20the%20global%20carbon%20cycle.%20By%20analogy%20with%20the%20Pliocene%E2%80%93Pleistocene,%20we%20propose%20that%20spatial%20reproducibility%20of%20%CE%B413C%20in%20some%20Neoproterozoic%20successions%20might%20be%20attributed%20to%20causes%20other%20than%20secular%20variation%20of%20the%20global%20carbon%20cycle,%20including%20diagenesis.%20This%20observation%20does%20not%20negate%20the%20stratigraphic%20utility%20of%20the%20carbon%20isotopic%20values,%20only%20the%20origin%20of%20the%20signal.}}

@article{Bridges2012a,
	annote = {10.1130/G32697.1},
	author = {Bridges, David L. and Mickus, Kevin and Gao, Stephen S. and Abdelsalam, Mohamed G. and Alemu, Abera},
	date = {2012/01/23},
	date-added = {2012-01-24 16:57:01 +0000},
	date-modified = {2012-10-29 20:46:18 +0000},
	journal = {Geology},
	journal1 = {Geology},
	month = {01},
	title = {Magnetic stripes of a transitional continental rift in Afar},
	ty = {JOUR},
	year = {2012},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://geology.gsapubs.org/content/early/2012/01/23/G32697.1.abstract%20N2%20-%20Magnetic%20stripes%20parallel%20to%20mid-ocean%20ridges%20are%20one%20of%20the%20most%20significant%20consequences%20of%20seafloor%20spreading,%20and%20have%20played%20an%20essential%20role%20in%20the%20establishment%20of%20the%20plate%20tectonics%20theory%20and%20the%20determination%20of%20seafloor%20spreading%20rates.%20Similar%20magnetic%20anomaly%20patterns%20have%20not%20been%20well%20documented%20subaerially%20in%20continental%20rifts%20transitioning%20into%20seafloor%20spreading%20centers.%20Here,%20using%20high-resolution%20magnetic%20data%20that%20were%20collected%20across%20the%20Tendaho%20Graben%20in%20the%20Afar%20Depression,%20Ethiopia,%20we%20document%20one%20of%20the%20first%20examples%20of%20subaerial%20magnetic%20lineations%20similar%20in%20pattern%20and%20amplitude%20to%20those%20that%20characterize%20seafloor%20spreading%20centers.%20The%20%E2%88%BC50-km-wide%20graben%20is%20the%20southernmost%20structural%20and%20geomorphological%20expression%20of%20the%20on-land%20continuation%20of%20the%20Red%20Sea%20propagator,%20which%20is%20taken%20to%20represent%20the%20Arabian-Nubian%20plate%20boundary%20within%20Afar.%20The%20graben%20is%20bounded%20by%20northwest-trending%20border%20faults,%20with%20the%20footwalls%20dominated%20by%20ca.%201.7%20Ma%20basalts%20and%20the%20downthrown%20blocks%20constituting%20progressively%20younger%20basalts%20toward%20the%20center%20of%20the%20graben,%20reaching%20ca.%2035%20ka.%20The%20Tendaho%20magnetic%20field%20is%20characterized%20by%20an%20%E2%88%BC10-km-wide%20linear%20negative%20magnetic%20anomaly%20that%20corresponds%20to%20a%20normal-polarity%20zone%20that%20is%20flanked%20by%20two%20parallel,%20%E2%88%BC20-km-wide%20linear%20positive%20magnetic%20anomalies%20of%20reversed%20polarity.%20This%20work%20shows%20that%20magnetic%20stripes%20can%20be%20developed%20in%20transitional%20continental%20rifts%20before%20the%20development%20of%20oceanic%20spreading%20centers.%20The%20common%20assumption%20that%20magnetic%20stripes%20can%20be%20used%20to%20date%20the%20onset%20of%20seafloor%20spreading%20may%20need%20to%20be%20re-evaluated%20in%20light%20of%20the%20evidence%20provided%20here.}}

