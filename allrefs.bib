	bdsk-url-1 = {http://petrology.oxfordjournals.org/content/5/2/310.abstract%20N2%20-%20Phase-equilibrium%20studies%20in%20the%20system%20FeO-Fe2O3%E2%80%94TiO2%20permit%20determination%20of%20the%20temperature%20and%20oxygen%20fugacity%20of%20formation%20of%20coexisting%20pairs%20of%20titaniferous%20magnetite%20and%20ilmenite%20in%20many%20rocks.%20Temperatures%20thus%20obtained%20are%20probably%20accurate%20to%20%C2%B150%C2%B0C.%20Temperatures%20indicated%20for%20most%20igneous%20and%20metamorphic%20rocks%20for%20which%20data%20are%20available%20are%20generally%20consistent%20with%20temperatures%20inferred%20by%20other%20methods.%20Temperatures%20for%20certain%20gabbroic%20rocks%20are%20too%20low%20for%20magmatic%20crystallization%20and%20probably%20reflect%20the%20migration%20of%20ilmenite%20from%20titaniferous%20magnetite%20to%20form%20separate%20granules%20upon%20cooling.The%20experimentally%20determined%20solubility%20of%20ilmenite%20in%20magnetite%20is%20much%20too%20small%20to%20account%20for%20most%20ilmeno-magnetites%20by%20simple%20exsolution.%20Subsolidus%20oxidation%20of%20magnetite-ulv%C3%B6spinelgSS%20to%20yield%20ilmenite-magnetite%20intergrowths%20has%20been%20experimentally%20verified%20and%20probably%20takes%20place%20during%20cooling%20of%20many%20igneous%20and%20perhaps%20some%20metamorphic%20rocks.%20Oxidation%20at%20surface%20or%20hypabyssal%20conditions%20may%20produce%20metastable%20titanomaghemites.In%20order%20of%20increasing%20intensity%20of%20oxidation,%20the%20following%20Fe%E2%80%94Ti%20oxide%20pairs%20occur%20in%20plutonic%20rocks:%20ulv%C3%B6spinel-rich%20magnetiteSS+ilmeniteSS,%20ulv%C3%B6spinel-poor%20magnetiteSS+ilmeniteSS,%20ulv%C3%B6spinel-poor%20magnetiteSS+hematiteSS,%20hematiteSS+rutile.}}

@article{Turner2008a,
	annote = {10.1130/G24186A.1},
	author = {Turner, Michael B. and Cronin, Shane J. and Stewart, Robert B. and Bebbington, Mark and Smith, Ian E. M.},
	date-added = {2010-10-08 18:01:31 -0400},
	date-modified = {2011-02-02 09:42:44 -0500},
	journal = {Geology},
	journal1 = {Geology},
	number = {1},
	pages = {31--34},
	title = {Using titanomagnetite textures to elucidate volcanic eruption histories},
	ty = {JOUR},
	volume = {36},
	year = {January, 2008},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://geology.gsapubs.org/content/36/1/31.abstract%20N2%20-%20Mineral%20assemblages%20in%20volcanic%20rocks%20record%20both%20pre-eruptive%20conditions%20and%20changes%20experienced%20by%20magma%20as%20it%20rises.%20Titanomagnetite%20in%20andesitic%20magmas%20is%20especially%20sensitive%20to%20changes%20in%20temperature%20and%20oxygen%20fugacity%20immediately%20prior%20to%20and%20during%20eruptions.%20Two%20end-member%20eruption%20states%20can%20be%20distinguished%20by%20examining%20titanomagnetite%20textures%20in%20erupted%20rocks.%20Slow-ascent%20eruptions%E2%80%94characterized%20by%20near-stagnant%20magma%20bodies%20and%20slow%20effusion%20of%20lava%20domes%E2%80%94show%20solid-state%20exsolution%20of%20titanohematite/ilmenite%20lamellae%20within%20titanomagnetite%20hosts.%20By%20contrast,%20fast-ascent%20eruptions%E2%80%94characterized%20by%20rapid%20chilling%20of%20magma%20in%20sub-Plinian%20eruptions%E2%80%94contain%20titanomagnetites%20without%20such%20exsolution%20features.%20This%20mineralogical%20distinction%20is%20particularly%20useful%20in%20examining%20very%20fine-grained%20distal%20tephra%20layers%20where%20other%20characteristic%20properties%20of%20the%20two%20eruptions%20types%20are%20not%20present.%20Such%20tephra%20records%20in%20lake%20deposits%20typically%20provide%20the%20most%20precise%20long-term%20eruption%20records%20from%20andesitic%20volcanoes.%20Using%20an%20example%20from%20Mount%20Taranaki,%20New%20Zealand,%20we%20show%20that%20by%20classifying%20eruption%20styles%20within%20such%20sequences,%20the%20underlying%20magmatic%20system%20processes%20at%20a%20volcano%20can%20be%20elucidated%20and%20separated%20from%20other%20environmental%20factors%20such%20as%20vent/crater%20configuration.}}

