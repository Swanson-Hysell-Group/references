	bdsk-url-1 = {http://www.sciencemag.org/content/335/6073/1212.abstract%20N2%20-%20The%20Moon%20possesses%20strong%20magnetic%20anomalies%20that%20are%20enigmatic%20given%20the%20weak%20magnetism%20of%20lunar%20rocks.%20We%20show%20that%20the%20most%20prominent%20grouping%20of%20anomalies%20can%20be%20explained%20by%20highly%20magnetic%20extralunar%20materials%20from%20the%20projectile%20that%20formed%20the%20largest%20and%20oldest%20impact%20crater%20on%20the%20Moon:%20the%20South%20Pole%E2%80%93Aitken%20basin.%20The%20distribution%20of%20projectile%20materials%20from%20a%20model%20oblique%20impact%20coincides%20with%20the%20distribution%20of%20magnetic%20anomalies%20surrounding%20this%20basin,%20and%20the%20magnetic%20properties%20of%20these%20materials%20can%20account%20for%20the%20intensity%20of%20the%20observed%20anomalies%20if%20they%20were%20magnetized%20in%20a%20core%20dynamo%20field.%20Distal%20ejecta%20from%20this%20event%20can%20explain%20the%20origin%20of%20isolated%20magnetic%20anomalies%20far%20from%20this%20basin.}}

@article{Falkowski2008a,
	annote = {10.1098/rstb.2008.0054},
	author = {Falkowski, Paul G and Godfrey, Linda V},
	date = {2008/08/27},
	date-added = {2012-03-07 02:43:31 +0000},
	date-modified = {2012-10-29 20:46:18 +0000},
	journal = {Philosophical Transactions of the Royal Society B: Biological Sciences},
	journal1 = {Philosophical Transactions of the Royal Society B: Biological Sciences},
	month = {08},
	number = {1504},
	pages = {2705--2716},
	title = {Electrons, life and the evolution of Earth's oxygen cycle},
	ty = {JOUR},
	volume = {363},
	year = {2008},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://rstb.royalsocietypublishing.org/content/363/1504/2705.abstract%20N2%20-%20The%20biogeochemical%20cycles%20of%20H,%20C,%20N,%20O%20and%20S%20are%20coupled%20via%20biologically%20catalysed%20electron%20transfer%20(redox)%20reactions.%20The%20metabolic%20processes%20responsible%20for%20maintaining%20these%20cycles%20evolved%20over%20the%20first%20ca%202.3%20Ga%20of%20Earth's%20history%20in%20prokaryotes%20and,%20through%20a%20sequence%20of%20events,%20led%20to%20the%20production%20of%20oxygen%20via%20the%20photobiologically%20catalysed%20oxidation%20of%20water.%20However,%20geochemical%20evidence%20suggests%20that%20there%20was%20a%20delay%20of%20several%20hundred%20million%20years%20before%20oxygen%20accumulated%20in%20Earth's%20atmosphere%20related%20to%20changes%20in%20the%20burial%20efficiency%20of%20organic%20matter%20and%20fundamental%20alterations%20in%20the%20nitrogen%20cycle.%20In%20the%20latter%20case,%20the%20presence%20of%20free%20molecular%20oxygen%20allowed%20ammonium%20to%20be%20oxidized%20to%20nitrate%20and%20subsequently%20denitrified.%20The%20interaction%20between%20the%20oxygen%20and%20nitrogen%20cycles%20in%20particular%20led%20to%20a%20negative%20feedback,%20in%20which%20increased%20production%20of%20oxygen%20led%20to%20decreased%20fixed%20inorganic%20nitrogen%20in%20the%20oceans.%20This%20feedback,%20which%20is%20supported%20by%20isotopic%20analyses%20of%20fixed%20nitrogen%20in%20sedimentary%20rocks%20from%20the%20Late%20Archaean,%20continues%20to%20the%20present.%20However,%20once%20sufficient%20oxygen%20accumulated%20in%20Earth's%20atmosphere%20to%20allow%20nitrification%20to%20out-compete%20denitrification,%20a%20new%20stable%20electron%20%E2%80%98market%E2%80%99%20emerged%20in%20which%20oxygenic%20photosynthesis%20and%20aerobic%20respiration%20ultimately%20spread%20via%20endosymbiotic%20events%20and%20massive%20lateral%20gene%20transfer%20to%20eukaryotic%20host%20cells,%20allowing%20the%20evolution%20of%20complex%20(i.e.%20animal)%20life%20forms.%20The%20resulting%20network%20of%20electron%20transfers%20led%20a%20gas%20composition%20of%20Earth's%20atmosphere%20that%20is%20far%20from%20thermodynamic%20equilibrium%20(i.e.%20it%20is%20an%20emergent%20property),%20yet%20is%20relatively%20stable%20on%20geological%20time%20scales.%20The%20early%20coevolution%20of%20the%20C,%20N%20and%20O%20cycles,%20and%20the%20resulting%20non-equilibrium%20gaseous%20by-products%20can%20be%20used%20as%20a%20guide%20to%20search%20for%20the%20presence%20of%20life%20on%20terrestrial%20planets%20outside%20of%20our%20Solar%20System.}}

@article{Fennel2005a,
	annote = {10.2475/ajs.305.6-8.526},
	author = {Fennel, Katja and Follows, Mick and Falkowski, Paul G.},
	date = {June/September/October 2005},
	date-added = {2012-03-07 02:28:32 +0000},
	date-modified = {2012-10-29 20:46:18 +0000},
	journal = {American Journal of Science},
	journal1 = {American Journal of Science},
	month = {September},
	number = {6-8},
	pages = {526--545},
	title = {The co-evolution of the nitrogen, carbon and oxygen cycles in the Proterozoic ocean},
	ty = {JOUR},
	volume = {305},
	year = {2005},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://www.ajsonline.org/content/305/6-8/526.abstract%20N2%20-%20Geochemical%20evidence%20suggests%20that%20there%20was%20a%20delay%20of%20several%20hundred%20million%20years%20between%20the%20evolution%20of%20oxygenic%20photosynthesis%20and%20the%20accumulation%20of%20oxygen%20in%20Earth%E2%80%99s%20atmosphere.%20The%20deep%20ocean%20appears%20to%20have%20remained%20euxenic%20for%20several%20hundred%20million%20years%20after%20the%20atmosphere%20became%20oxygenated.%20In%20this%20paper%20we%20examine%20the%20possibility%20that%20the%20extraordinary%20delay%20in%20the%20oxidation%20of%20the%20atmosphere%20and%20oceans%20was%20caused%20by%20a%20biogeochemical%20%E2%80%9Cbottleneck%E2%80%9D%20imposed%20by%20metabolic%20feedbacks%20between%20carbon%20burial,%20net%20oxygen%20production,%20and%20the%20evolution%20of%20the%20nitrogen%20cycle%20in%20the%20Proterozoic%20oceans.%20Whereas%20under%20anoxic%20conditions%20oceanic%20ammonium%20would%20have%20been%20relatively%20stable,%20as%20oxygen%20concentrations%20rose,%20nitrification%20and%20subsequent%20denitrification%20would%20have%20rapidly%20removed%20fixed%20inorganic%20nitrogen%20from%20the%20oceans.%20Denitrification%20would%20have%20imposed%20a%20strong%20constraint%20on%20the%20further%20rise%20of%20free%20oxygen%20by%20depriving%20oxygenic%20photoautotrophs%20of%20an%20essential%20nutrient%20(that%20is,%20fixed%20inorganic%20nitrogen).%20To%20examine%20the%20dynamic%20interactions%20between%20oxygen%20and%20nitrogen%20cycling,%20we%20developed%20a%20five%20box%20model%20that%20incorporates%20the%20salient%20features%20of%20the%20oxygen,%20nitrogen%20and%20carbon%20cycles,%20ocean%20circulation,%20and%20ocean-atmosphere%20gas-exchange.%20Model%20simulations,%20initiated%20under%20anaerobic%20conditions%20with%20no%20free%20oxygen%20in%20the%20atmosphere%20or%20ocean,%20are%20characterized%20by%20an%20initially%20reduced%20deep%20ocean%20with%20abundant%20ammonium,%20followed%20by%20an%20extended%20period%20when%20neither%20form%20of%20fixed%20nitrogen%20is%20stable,%20and%20a%20fully%20oxidized%20phase%20with%20abundant%20nitrate.%20We%20infer%20that,%20in%20the%20process%20of%20oxidizing%20the%20early%20Proterozoic%20ocean,%20the%20system%20had%20to%20go%20through%20a%20nitrogen-limited%20phase%20during%20which%20time%20export%20production%20was%20severely%20attenuated.%20Our%20studies%20suggest%20that%20the%20presence%20of%20shallow%20seas%20with%20increased%20organic%20matter%20burial%20was%20a%20critical%20factor%20determining%20the%20concentration%20of%20oxygen%20in%20the%20ocean%20and%20atmosphere,%20while%20the%20phosphate%20concentration%20played%20a%20key%20role%20in%20determining%20the%20rate%20of%20oxygenation%20of%20the%20deep%20ocean.}}

@article{Shcherbakov2012a,
	abstract = {The sequence of durations of the geomagnetic polarity intervals is often described in terms of a nonhomogenous Poisson process with time-dependent reversal rate, reflecting the nonstationarity of the underlying geodynamo process. This view has recently been challenged, and here we show that the first-passage time statistics of random walks taking place on a flat potential relief yields a much more consistent interpretation of the distribution of geomagnetic polarity intervals. A possible physical explanation suggests that the stability of a polarity chron of the Earth's magnetic field is controlled by a sum of statistically independent, randomly behaving, dynamo processes in the outer core. The random-walk hypothesis naturally includes the observed occurrences of very long superchrons, and it provides a new, considerably longer statistical estimate for the total duration of the present Brunhes chron predicting that the probability for a geomagnetic field reversal within the next 30 Ka is \&{\#}8776;5{\%} and the probability that we live in a chron longer than 2 Ma is about 30{\%}.},
	author = {Shcherbakov, Valeriy and Fabian, Karl},
	date = {2012/03/07},
	date-added = {2012-03-06 21:57:46 +0000},
	date-modified = {2012-10-29 20:46:18 +0000},
	isbn = {0148-0227},
	journal = {J. Geophys. Res.},
	keywords = {first passage time statistics; geodynamo; geomagnetic reversals; 1507 Geomagnetism and Paleomagnetism: Core processes (1213, 8115); 1510 Geomagnetism and Paleomagnetism: Dynamo: theories and simulations; 1535 Geomagnetism and Paleomagnetism: Reversals: process, timescale, magnetostratigraphy; 1560 Geomagnetism and Paleomagnetism: Time variations: secular and longer},
	month = {03},
	number = {B3},
	publisher = {AGU},
	sp = {B03101},
	title = {The geodynamo as a random walker: A view on reversal statistics},
	ty = {JOUR},
