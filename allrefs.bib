	pages = {727--730},
	title = {Lhasa terrane in southern Tibet came from Australia},
	ty = {JOUR},
	volume = {39},
	year = {2011},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://geology.gsapubs.org/content/39/8/727.abstract%20N2%20-%20The%20U-Pb%20age%20and%20Hf%20isotope%20data%20on%20detrital%20zircons%20from%20Paleozoic%20metasedimentary%20rocks%20in%20the%20Lhasa%20terrane%20(Tibet)%20define%20a%20distinctive%20age%20population%20of%20ca.%201170%20Ma%20with%20%CE%B5Hf(t)%20values%20identical%20to%20the%20coeval%20detrital%20zircons%20from%20Western%20Australia,%20but%20those%20from%20the%20western%20Qiangtang%20and%20Tethyan%20Himalaya%20terranes%20define%20an%20age%20population%20of%20ca.%20950%20Ma%20with%20a%20similar%20%CE%B5Hf(t)%20range.%20The%20ca.%201170%20Ma%20detrital%20zircons%20in%20the%20Lhasa%20terrane%20were%20most%20likely%20derived%20from%20the%20Albany-Fraser%20belt%20in%20southwest%20Australia,%20whereas%20the%20ca.%20950%20Ma%20detrital%20zircons%20from%20both%20the%20western%20Qiangtang%20and%20Tethyan%20Himalaya%20terranes%20might%20have%20been%20sourced%20from%20the%20High%20Himalaya%20to%20the%20south.%20Such%20detrital%20zircon%20connections%20enable%20us%20to%20propose%20that%20the%20Lhasa%20terrane%20is%20exotic%20to%20the%20Tibetan%20Plateau%20system,%20and%20should%20no%20longer%20be%20considered%20as%20part%20of%20the%20Qiangtang%E2%80%93Greater%20India%E2%80%93Tethyan%20Himalaya%20continental%20margin%20system%20in%20the%20Paleozoic%20reconstruction%20of%20the%20Indian%20plate,%20as%20current%20models%20show;%20rather,%20it%20should%20be%20placed%20at%20the%20northwestern%20margin%20of%20Australia.%20These%20results%20provide%20new%20constraints%20on%20the%20paleogeographic%20reconstruction%20and%20tectonic%20evolution%20of%20southern%20Tibet,%20and%20indicate%20that%20the%20Lhasa%20terrane%20evolved%20as%20part%20of%20the%20late%20Precambrian%E2%80%93early%20Paleozoic%20evolution%20as%20part%20of%20Australia%20in%20a%20different%20paleogeographical%20setting%20than%20that%20of%20the%20Qiangtang%E2%88%92Greater%20India%E2%88%92Tethyan%20Himalaya%20system.}}

