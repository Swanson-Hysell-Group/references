@article{Gee2010a,
	abstract = {Ash flow tuffs, or ignimbrites, typically contain fine-grained magnetite, spanning the superparamagnetic to single-domain size range that should be suitable for estimating geomagnetic field intensity. However, ignimbrites may have a remanence of thermal and chemical origin as a result of the complex magnetic mineralogy and variations in the thermal and alteration history. We examined three stratigraphic sections through the \&{\#}8764;0.76 Ma Bishop Tuff, where independent information on postemplacement cooling and alteration is available, as a test of the suitability of ignimbrites for paleointensity studies. Thermomagnetic curves suggest that low-Ti titanomagnetite (Tc = 560∞C\&{\#}8211;580∞C) is the dominant phase, with a minor contribution from a higher Tc phase(s). Significant remanence unblocking above 580∞C suggests that maghemite and/or (titano)maghemite is an important contributor to the remanence in most samples. We obtained successful paleofield estimates from remanence unblocked between 440∞C and 580∞C for 46 of 89 specimens (15 sites at two of three total localities). These specimens represent a range of degrees of welding and have variable alteration histories and yet provide a consistent paleofield estimate of 43.0 \&{\#}956;T ($\pm$3.2), equivalent to a VADM of 7.8 ◊1022 Am2. The most densely welded sections of the tuff have emplacement temperatures inferred to be as high as \&{\#}8764;660∞C, suggesting that the remanence may be primarily thermal in origin, though a contribution from thermochemical remanence cannot be excluded. These results suggest that ignimbrites may constitute a viable material for reliable paleointensity determinations.},
	author = {Gee, Jeffrey S. and Yu, Yongjae and Bowles, Julie},
	date = {2010/03/16},
	date-added = {2010-03-15 17:09:08 -0400},
	date-modified = {2011-02-02 09:42:45 -0500},
	do = {10.1029/2009GC002834},
	isbn = {1525-2027},
	journal = {Geochem. Geophys. Geosyst.},
	keywords = {geomagnetic intensity; ash flow; 1521 Geomagnetism and Paleomagnetism: Paleointensity; 1519 Geomagnetism and Paleomagnetism: Magnetic mineralogy and petrology; 1527 Geomagnetism and Paleomagnetism: Paleomagnetism applied to geologic processes},
	month = {03},
	number = {3},
	publisher = {AGU},
	sp = {Q03010},
	title = {Paleointensity estimates from ignimbrites: An evaluation of the Bishop Tuff},
	ty = {JOUR},
	volume = {11},
	year = {2010},
	bdsk-file-1 = {},
	bdsk-file-2 = {},
	bdsk-url-1 = {http://dx.doi.org/10.1029/2009GC002834}}

