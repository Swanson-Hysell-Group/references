@article{Eagles2013a,
	author = {Eagles, Graeme and Wibisono, Affelia D.},
	date = {2013/05/27},
	date-added = {2013-11-20 20:18:12 +0000},
	date-modified = {2013-11-20 20:18:12 +0000},
	journal = {Geophysical Journal International},
	m3 = {10.1093/gji/ggt162},
	month = {05},
	title = {Ridge push, mantle plumes and the speed of the Indian plate},
	ty = {JOUR},
	url = {http://gji.oxfordjournals.org/content/early/2013/05/27/gji.ggt162.abstract N2 - The buoyancy of lithospheric slabs in subduction zones is widely thought to dominate the torques driving plate tectonics. In late Cretaceous and early Paleogene times, the Indian plate moved more rapidly over the mantle than freely subducting slabs sink within it. This signal event has been attributed to arrival of the Deccan–Réunion mantle plume beneath the plate, but it is unknown in which proportions the plume acted to alter the balance of existing plate driving torques and to introduce torques of its own. Our plate kinematic analysis of the Mascarene Basin yields a detailed Indian plate motion history for the period 89–60 Ma. Plate speed initially increases steadily until a pronounced acceleration in the period 68–64 Ma, after which it abruptly returns to values much like those beforehand. This pattern is unlike that suggested to result from the direct introduction of driving forces by the arrival of a thermal plume at the base of the plate. A simple analysis of the gravitational force related to the Indian plate's thickening away from its boundary with the African plate suggests instead that the sudden acceleration and deceleration may be related to uplift of part of that boundary during a period when it was located over the plume head. In this instance, torques related to plate accretion and subduction may have contributed in similar proportions to drive plate motion.},
	year = {2013},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://gji.oxfordjournals.org/content/early/2013/05/27/gji.ggt162.abstract%20N2%20-%20The%20buoyancy%20of%20lithospheric%20slabs%20in%20subduction%20zones%20is%20widely%20thought%20to%20dominate%20the%20torques%20driving%20plate%20tectonics.%20In%20late%20Cretaceous%20and%20early%20Paleogene%20times,%20the%20Indian%20plate%20moved%20more%20rapidly%20over%20the%20mantle%20than%20freely%20subducting%20slabs%20sink%20within%20it.%20This%20signal%20event%20has%20been%20attributed%20to%20arrival%20of%20the%20Deccan%E2%80%93R%C3%A9union%20mantle%20plume%20beneath%20the%20plate,%20but%20it%20is%20unknown%20in%20which%20proportions%20the%20plume%20acted%20to%20alter%20the%20balance%20of%20existing%20plate%20driving%20torques%20and%20to%20introduce%20torques%20of%20its%20own.%20Our%20plate%20kinematic%20analysis%20of%20the%20Mascarene%20Basin%20yields%20a%20detailed%20Indian%20plate%20motion%20history%20for%20the%20period%2089%E2%80%9360%20Ma.%20Plate%20speed%20initially%20increases%20steadily%20until%20a%20pronounced%20acceleration%20in%20the%20period%2068%E2%80%9364%20Ma,%20after%20which%20it%20abruptly%20returns%20to%20values%20much%20like%20those%20beforehand.%20This%20pattern%20is%20unlike%20that%20suggested%20to%20result%20from%20the%20direct%20introduction%20of%20driving%20forces%20by%20the%20arrival%20of%20a%20thermal%20plume%20at%20the%20base%20of%20the%20plate.%20A%20simple%20analysis%20of%20the%20gravitational%20force%20related%20to%20the%20Indian%20plate's%20thickening%20away%20from%20its%20boundary%20with%20the%20African%20plate%20suggests%20instead%20that%20the%20sudden%20acceleration%20and%20deceleration%20may%20be%20related%20to%20uplift%20of%20part%20of%20that%20boundary%20during%20a%20period%20when%20it%20was%20located%20over%20the%20plume%20head.%20In%20this%20instance,%20torques%20related%20to%20plate%20accretion%20and%20subduction%20may%20have%20contributed%20in%20similar%20proportions%20to%20drive%20plate%20motion.}}

