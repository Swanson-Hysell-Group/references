	issn = {0016-7649},
	journal = {Journal of the Geological Society},
	number = {6},
	pages = {945--954},
	publisher = {Geological Society of London},
	title = {{A palaeomagnetic study of Jurassic rocks from the Antarctic Peninsula and its implications}},
