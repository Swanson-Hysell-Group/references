@article{Elmore1984a,
	annote = {10.1130/0016-7606(1984)95<610:TCHCAL>2.0.CO;2},
	author = {Elmore, R. D.},
	date-added = {2012-02-09 20:51:05 +0000},
	date-modified = {2022-01-24 13:44:29 -0800},
	doi = {10.1130/0016-7606(1984)95<610:TCHCAL>2.0.CO;2},
	journal = {Geological Society of America Bulletin},
	journal1 = {Geological Society of America Bulletin},
	number = {5},
	pages = {610--617},
	title = {{The Copper Harbor Conglomerate: A late Precambrian fining-upward alluvial fan sequence in northern Michigan}},
	ty = {JOUR},
	volume = {95},
	year = {1984},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://gsabulletin.gsapubs.org/content/95/5/610.abstract%20N2%20-%20The%20Keweenawan%20Copper%20Harbor%20Conglomerate,%20exposed%20in%20northern%20Michigan,%20is%20part%20of%20a%20thick%20succession%20of%20volcanics%20and%20terrigenous%20clastics%20deposited%20in%20the%20Keweenawan%20Trough,%20a%20failed%20intracontinental%20rift.%20It%20is%20a%20fining-upward%20wedge%20of%20volcanogenic%20conglomerate%20and%20sandstone%20deposited%20as%20proximal%20to%20distal%20braided-stream%20and%20sheet-flood%20facies%20on%20coalesced%20alluvial%20fans%20and%20sand%20flats.%20This%20unit,%20along%20with%20the%20lower%20portion%20of%20the%20overlying%20Nonesuch%20Shale,%20consists%20of%20an%20alluvial%20fan%E2%80%93shallow%20lake%20sequence%20that%20filled%20the%20rift%20during%20and%20following%20volcanic%20activity.%20The%20fining-upward%20nature%20of%20the%20sequence%20reflects%20a%20waning%20sediment%20supply%20probably%20due%20to%20lowering%20of%20the%20source%20area%20following%20faulting.The%20Copper%20Harbor%20Conglomerate%20exhibits%20attributes%20of%20both%20arid-fan%20and%20humid-fan%20alluvial%20models.%20Coarse-grained%20facies%20are%20lithologically%20similar%20to%20alluvial-fan%20units%20deposited%20in%20modern%20humid%20regions.%20Conversely,%20finer%20distal%20Copper%20Harbor%20facies%20exhibit%20numerous%20features%20indicating%20flashy%20discharges%20and%20desiccation,%20processes%20typical%20of%20deposition%20in%20modern%20arid%20regions.%20Ambiguity%20of%20sedimentary%20features%20useful%20for%20climatic%20inference%20probably%20reflects%20the%20limited%20applicability%20of%20Holocene%20models%20to%20more%20ancient%20alluvial%20sequences,%20because%20Precambrian%20hydraulic%20regimes%20developed%20under%20various%20climatic%20settings%20may%20have%20differed%20from%20their%20Holocene%20counterparts.}}

