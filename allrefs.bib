@article{Liu2008a,
	annote = {10.2475/04.2008.02},
	author = {Liu, Xiaoming and Gao, Shan and Diwu, Chunrong and Ling, Wenli},
	date-added = {2016-05-09 16:35:27 +0000},
	date-modified = {2016-05-09 16:35:27 +0000},
	journal = {American Journal of Science},
	journal1 = {American Journal of Science},
	number = {4},
	pages = {421--468},
	title = {Precambrian crustal growth of Yangtze Craton as revealed by detrital zircon studies},
	ty = {JOUR},
	url = {http://www.ajsonline.org/content/308/4/421.abstract N2 - Clastic sedimentary rocks are natural samples of the exposed continental crust over large areas. The age and evolution of the Yangtze craton is not well known, because much of the craton is covered by thick Nanhua (850 –635Ma), Sinian (635 –543Ma) and Phanerozoic sedimentary rocks. The Nanhua clastic sedimentary rocks including tillites provide ideal samples for studies of age and evolution of the craton. 1130 zircons in 8 sandstone and tillite samples of three Nanhua formations (Liantuo, Gucheng and Nantuo) from the Yangtze Gorges area were dated by LA-ICP-MS. 251 of the 711 concordant zircons were analyzed for Hf isotopic compositions by LA-MC-ICP-MS. The results reveal four major age groups of 720 to 910 Ma, 1.90 to 2.05 Ga, 2.40 to 2.55Ga and 2.60 to 2.70 Ga with few grains >3.2Ga. Although Hf isotopic compositions show both juvenile crustal growth and reworking of old crust for all the age groups, the Paleoproterozoic is a period of prominent crustal reworking with negative εHf(t) values. The Neoproterozoic is a period of significant juvenile crustal additions, accounting for 68 percent of zircons with positive εHf(t) values similar to those of the depleted mantle. Crustal additions at 3.2 to 3.8Ga are also significant, as indicated by the zircon Hf continental model ages. Our results highlight the importance of analysis of a sufficient number of zircons for provenance studies. In addition, our results illustrate that possible temporal and spatial provenance variations have to be taken into account for better characterizing formation and evolution of the related continental crust. Our obtained youngest age for each formation shows a strong negative correlation with stratigraphic height. Youngest ages provide good constraints on the maximum ages of the three Nanhua formations: ≤770Ma, ≤733Ma and ≤704Ma for the base, middle unit and top of the Liantuo Formation, respectively; ≤703Ma for the Gucheng Formation and possibly ≤600 to 606Ma for the Nantuo Formation. Although the North China and Yangtze cratons show some apparently similar zircon ages, the two cratons have distinct histories of formation and evolution. While the North China craton is dominated by Archean crustal growth, the Yangtze craton is characterized by prominent crustal additions in the Neoproterozoic, which is almost lacking in the North China craton.},
	volume = {308},
	year = {April 2008},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://www.ajsonline.org/content/308/4/421.abstract%20N2%20-%20Clastic%20sedimentary%20rocks%20are%20natural%20samples%20of%20the%20exposed%20continental%20crust%20over%20large%20areas.%20The%20age%20and%20evolution%20of%20the%20Yangtze%20craton%20is%20not%20well%20known,%20because%20much%20of%20the%20craton%20is%20covered%20by%20thick%20Nanhua%20(850%20%E2%80%93635Ma),%20Sinian%20(635%20%E2%80%93543Ma)%20and%20Phanerozoic%20sedimentary%20rocks.%20The%20Nanhua%20clastic%20sedimentary%20rocks%20including%20tillites%20provide%20ideal%20samples%20for%20studies%20of%20age%20and%20evolution%20of%20the%20craton.%201130%20zircons%20in%208%20sandstone%20and%20tillite%20samples%20of%20three%20Nanhua%20formations%20(Liantuo,%20Gucheng%20and%20Nantuo)%20from%20the%20Yangtze%20Gorges%20area%20were%20dated%20by%20LA-ICP-MS.%20251%20of%20the%20711%20concordant%20zircons%20were%20analyzed%20for%20Hf%20isotopic%20compositions%20by%20LA-MC-ICP-MS.%20The%20results%20reveal%20four%20major%20age%20groups%20of%20720%20to%20910%20Ma,%201.90%20to%202.05%20Ga,%202.40%20to%202.55Ga%20and%202.60%20to%202.70%20Ga%20with%20few%20grains%20%3E3.2Ga.%20Although%20Hf%20isotopic%20compositions%20show%20both%20juvenile%20crustal%20growth%20and%20reworking%20of%20old%20crust%20for%20all%20the%20age%20groups,%20the%20Paleoproterozoic%20is%20a%20period%20of%20prominent%20crustal%20reworking%20with%20negative%20%CE%B5Hf(t)%20values.%20The%20Neoproterozoic%20is%20a%20period%20of%20significant%20juvenile%20crustal%20additions,%20accounting%20for%2068%20percent%20of%20zircons%20with%20positive%20%CE%B5Hf(t)%20values%20similar%20to%20those%20of%20the%20depleted%20mantle.%20Crustal%20additions%20at%203.2%20to%203.8Ga%20are%20also%20significant,%20as%20indicated%20by%20the%20zircon%20Hf%20continental%20model%20ages.%20Our%20results%20highlight%20the%20importance%20of%20analysis%20of%20a%20sufficient%20number%20of%20zircons%20for%20provenance%20studies.%20In%20addition,%20our%20results%20illustrate%20that%20possible%20temporal%20and%20spatial%20provenance%20variations%20have%20to%20be%20taken%20into%20account%20for%20better%20characterizing%20formation%20and%20evolution%20of%20the%20related%20continental%20crust.%20Our%20obtained%20youngest%20age%20for%20each%20formation%20shows%20a%20strong%20negative%20correlation%20with%20stratigraphic%20height.%20Youngest%20ages%20provide%20good%20constraints%20on%20the%20maximum%20ages%20of%20the%20three%20Nanhua%20formations:%20%E2%89%A4770Ma,%20%E2%89%A4733Ma%20and%20%E2%89%A4704Ma%20for%20the%20base,%20middle%20unit%20and%20top%20of%20the%20Liantuo%20Formation,%20respectively;%20%E2%89%A4703Ma%20for%20the%20Gucheng%20Formation%20and%20possibly%20%E2%89%A4600%20to%20606Ma%20for%20the%20Nantuo%20Formation.%20Although%20the%20North%20China%20and%20Yangtze%20cratons%20show%20some%20apparently%20similar%20zircon%20ages,%20the%20two%20cratons%20have%20distinct%20histories%20of%20formation%20and%20evolution.%20While%20the%20North%20China%20craton%20is%20dominated%20by%20Archean%20crustal%20growth,%20the%20Yangtze%20craton%20is%20characterized%20by%20prominent%20crustal%20additions%20in%20the%20Neoproterozoic,%20which%20is%20almost%20lacking%20in%20the%20North%20China%20craton.}}

