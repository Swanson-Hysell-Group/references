	pages = {31--34},
	title = {Sea ice−free conditions during the Sturtian glaciation (early Cryogenian), South Australia},
	ty = {JOUR},
	volume = {39},
	year = {2011},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://geology.gsapubs.org/content/39/1/31.abstract%20N2%20-%20In%20the%20Neoproterozoic%20snowball%20Earth%20hypothesis,%20shutdown%20of%20the%20planet's%20hydrological%20system%20has%20been%20attributed%20to%20a%20global%20ice%20cover%20during%20one%20or%20more%20extreme%20glaciations.%20In%20the%20central%20Flinders%20Ranges,%20South%20Australia,%20the%20Yudnamutana%20Subgroup%20of%20Sturtian%20age%20includes%20diamictite,%20sandstone,%20and%20siltstone%20units%20of%20glaciomarine%20origin%20as%20much%20as%205000%20m%20thick,%20and%20is%20overlain%20by%20postglacial%20transgressive%20siltstone%20and%20shale%20of%20the%20Tindelpina%20Shale%20Member,%20Tapley%20Hill%20Formation.%20In%20the%20central%20Flinders%20Ranges,%20the%20Yudnamutana%20Subgroup%20consists%20of%20(1)%20the%20Pualco%20Tillite%20(gravity%20resedimented%20glacial%20deposits),%20(2)%20the%20Holowilena%20Ironstone%20(glacioturbidites),%20(3)%20poorly%20stratified%20pebbly%20diamictite%20of%20the%20Warcowie%20Dolomite%20Member,%20lowermost%20Wilyerpa%20Formation%20(gravity%20resedimented%20glacial%20deposits),%20succeeded%20by%20(4)%20siltstones%20and%20sandstones%20with%20abundant%20hummocky%20cross-stratification%20(HCS:%20storm%20deposits),%20and%20(5)%20a%20lonestone-bearing%20succession%20with%20cobble-sized%20clasts%20in%20the%20upper%20Wilyerpa%20Formation%20(ice-rafted%20debris%20interpreted%20to%20record%20a%20glacial%20re-advance)%20in%20which%20HCS%20is%20absent.%20Because%20the%20action%20of%20oscillating%20waves%20is%20required%20to%20produce%20HCS%20on%20the%20seafloor,%20its%20presence%20indicates%20an%20interval%20of%20significant%20meltback%20prior%20to%20glacial%20re-advance.%20Given%20that%20the%20HCS%20occurs%20%E2%88%BC2%20km%20beneath%20the%20Tindelpina%20Shale%20Member,%20it%20signifies%20a%20major%20ice-free%20interval%20during%20the%20Sturtian%20glaciation.}}

@article{Paasche2011a,
