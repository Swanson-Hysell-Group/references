@article{Haldan2014a,
	annote = {10.1093/gji/ggu351},
	author = {Haldan, M. M. and Meijers, M. J. M. and Langereis, C. G. and Larsen, B. T. and Heyer, H.},
	date-added = {2014-11-17 21:48:17 +0000},
	date-modified = {2014-11-17 21:48:17 +0000},
	journal = {Geophysical Journal International},
	journal1 = {Geophysical Journal International},
	number = {3},
	pages = {1554--1571},
	title = {New palaeomagnetic results from the Oslo Graben, a Permian Superchron lava province},
	ty = {JOUR},
	url = {http://gji.oxfordjournals.org/content/199/3/1554.abstract N2 - We have performed an extended palaeomagnetic study of the Oslo Graben volcanics, compared to the study of half a century ago by van Everdingen, using modern techniques and a four times larger amount of sites, plus additional rock magnetic experiments. We conclude that the average direction (D = 204.0, I = −37.9, k = 46.9, α95 = 2.0) and associated palaeomagnetic pole (λ = 48.3, ϕ = 155.5, K = 52.2, A95 = 1.9) of the Krokskogen and Vestfold volcanics together are statistically identical to those of the earlier study. This gives confidence in the fact that older palaeomagnetic studies can be reliable and robust, even though methods have improved. Our larger number of samples, and better age constraints, enable us to separate the data into two major intervals: the younger, on average, Krokskogen area and the older Vestfold area. The results show firstly that palaeolatitudes are slightly higher than predicted by the latest apparent polar wander path (APWP) for Eurasia by Torsvik et al. These data support an early Permian Pangaea A configuration and do not necessitate a Pangaea B configuration.The larger data set also allows us to assess the distribution of the characteristic remanent magnetization directions of the Oslo Graben in terms of geomagnetic field behaviour, which were acquired during a long period of dominantly single polarity the Permo-Carboniferous Reversed Superchron (PCRS). The distributions show a significantly lower virtual geomagnetic pole (VGP) scatter at the observed (low) latitudes than expected from a compilation from lavas of the last 5 Myr. The data do however show excellent agreement with the scatter observed both during the Cretaceous Normal Superchron and the PCRS. A comparison of the directional distributions in terms of elongation is less discriminating, since the large errors in all cases allow a fit to the predicted elongation/inclination behaviour of the TK03.GAD model.},
	volume = {199},
	year = {December, 2014},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://gji.oxfordjournals.org/content/199/3/1554.abstract%20N2%20-%20We%20have%20performed%20an%20extended%20palaeomagnetic%20study%20of%20the%20Oslo%20Graben%20volcanics,%20compared%20to%20the%20study%20of%20half%20a%20century%20ago%20by%20van%20Everdingen,%20using%20modern%20techniques%20and%20a%20four%20times%20larger%20amount%20of%20sites,%20plus%20additional%20rock%20magnetic%20experiments.%20We%20conclude%20that%20the%20average%20direction%20(D%20=%20204.0,%20I%20=%20%E2%88%9237.9,%20k%20=%2046.9,%20%CE%B195%20=%202.0)%20and%20associated%20palaeomagnetic%20pole%20(%CE%BB%20=%2048.3,%20%CF%95%20=%20155.5,%20K%20=%2052.2,%20A95%20=%201.9)%20of%20the%20Krokskogen%20and%20Vestfold%20volcanics%20together%20are%20statistically%20identical%20to%20those%20of%20the%20earlier%20study.%20This%20gives%20confidence%20in%20the%20fact%20that%20older%20palaeomagnetic%20studies%20can%20be%20reliable%20and%20robust,%20even%20though%20methods%20have%20improved.%20Our%20larger%20number%20of%20samples,%20and%20better%20age%20constraints,%20enable%20us%20to%20separate%20the%20data%20into%20two%20major%20intervals:%20the%20younger,%20on%20average,%20Krokskogen%20area%20and%20the%20older%20Vestfold%20area.%20The%20results%20show%20firstly%20that%20palaeolatitudes%20are%20slightly%20higher%20than%20predicted%20by%20the%20latest%20apparent%20polar%20wander%20path%20(APWP)%20for%20Eurasia%20by%20Torsvik%20et%20al.%20These%20data%20support%20an%20early%20Permian%20Pangaea%20A%20configuration%20and%20do%20not%20necessitate%20a%20Pangaea%20B%20configuration.The%20larger%20data%20set%20also%20allows%20us%20to%20assess%20the%20distribution%20of%20the%20characteristic%20remanent%20magnetization%20directions%20of%20the%20Oslo%20Graben%20in%20terms%20of%20geomagnetic%20field%20behaviour,%20which%20were%20acquired%20during%20a%20long%20period%20of%20dominantly%20single%20polarity%20the%20Permo-Carboniferous%20Reversed%20Superchron%20(PCRS).%20The%20distributions%20show%20a%20significantly%20lower%20virtual%20geomagnetic%20pole%20(VGP)%20scatter%20at%20the%20observed%20(low)%20latitudes%20than%20expected%20from%20a%20compilation%20from%20lavas%20of%20the%20last%205%20Myr.%20The%20data%20do%20however%20show%20excellent%20agreement%20with%20the%20scatter%20observed%20both%20during%20the%20Cretaceous%20Normal%20Superchron%20and%20the%20PCRS.%20A%20comparison%20of%20the%20directional%20distributions%20in%20terms%20of%20elongation%20is%20less%20discriminating,%20since%20the%20large%20errors%20in%20all%20cases%20allow%20a%20fit%20to%20the%20predicted%20elongation/inclination%20behaviour%20of%20the%20TK03.GAD%20model.}}

@article{Graham2001a,
	annote = {10.1130/0016-7606(2001)113<1560:SRATIO>2.0.CO;2},
	author = {Graham, S. A. and Hendrix, M. S. and Johnson, C. L. and Badamgarav, D. and Badarch, G. and Amory, J. and Porter, M. and Barsbold, R. and Webb, L. E. and Hacker, B. R.},
	date-added = {2014-11-11 06:11:50 +0000},
	date-modified = {2014-11-11 06:11:50 +0000},
	journal = {Geological Society of America Bulletin},
	journal1 = {Geological Society of America Bulletin},
	number = {12},
	pages = {1560--1579},
	title = {Sedimentary record and tectonic implications of Mesozoic rifting in southeast Mongolia},
	ty = {JOUR},
	url = {http://gsabulletin.gsapubs.org/content/113/12/1560.abstract N2 - The East Gobi basin of Mongolia is a poorly described Late Jurassic–Early Cretaceous extensional province that holds great importance for reconstructions of Mesozoic tectonics and paleogeography of eastern Asia. Extension is especially well recorded in the structure and stratigraphy of the Unegt and Zuunbayan subbasins southwest of Saynshand, Mongolia, where outcrop and subsurface relationships permit recognition of prerift, synrift, and postrift Mesozoic stratigraphic megasequences. Within the synrift megasequence, three sequences developed in response to climatic and rift-related structural controls on sedimentation. Where best exposed along the northern margin of the Unegt subbasin, each of the synrift sequences is bounded by unconformities and generally fines upward from basal alluvial and fluvial conglomerate to fluvial and lacustrine sandstone and mudstone. Resedimented ashes and basalt flows punctuate the synrift megasequence. Rifting began in the Unegt subbasin prior to 155 Ma with coarse alluvial filling of local fault depressions. Subsidence generally outstripped sediment supply, and fresh to saline lacustrine environments, expanding southward with time, dominated the Unegt- Zuunbayan landscape for much of latest Jurassic–Early Cretaceous time. Episodic faulting and volcanism characterized the basin system for the balance of the Early Cretaceous. A brief period of compressional and/or transpressional basin inversion occurred at the end of the Early Cretaceous, prior to deposition of a widespread Upper Cretaceous overlap sequence.The driver(s) of Late Jurassic–Early Cretaceous extension remain uncertain because southeast Mongolia occupied an intraplate position by the beginning of the Cretaceous. Extension in the East Gobi basin was coeval with collapse and extension of early Mesozoic contractional orogenic belts along the northern and southern borders of Mongolia and probably was a linked phenomenon. Strike-slip faulting associated with collisions on the southern Asian and Mongol- Okhotsk margins likely also played a role in late Mesozoic deformation of the East Gobi region, perhaps partitioning the Gobi from apparently coeval large-magnitude contractional deformation in the Yinshan- Yanshan orogenic belt south of the study area in Inner Mongolia.},
	volume = {113},
	year = {December, 2001},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://gsabulletin.gsapubs.org/content/113/12/1560.abstract%20N2%20-%20The%20East%20Gobi%20basin%20of%20Mongolia%20is%20a%20%20poorly%20described%20Late%20Jurassic%E2%80%93Early%20Cretaceous%20%20extensional%20province%20that%20holds%20%20great%20importance%20for%20reconstructions%20of%20%20Mesozoic%20tectonics%20and%20paleogeography%20of%20%20eastern%20Asia.%20Extension%20is%20especially%20well%20recorded%20%20in%20the%20structure%20and%20stratigraphy%20of%20%20the%20Unegt%20and%20Zuunbayan%20subbasins%20southwest%20%20of%20Saynshand,%20Mongolia,%20where%20outcrop%20%20and%20subsurface%20relationships%20permit%20%20recognition%20of%20prerift,%20synrift,%20and%20postrift%20%20Mesozoic%20stratigraphic%20megasequences.%20%20Within%20the%20synrift%20megasequence,%20three%20sequences%20%20developed%20in%20response%20to%20climatic%20%20and%20rift-related%20structural%20controls%20on%20sedimentation.%20%20Where%20best%20exposed%20along%20the%20%20northern%20margin%20of%20the%20Unegt%20subbasin,%20%20each%20of%20the%20synrift%20sequences%20is%20bounded%20by%20%20unconformities%20and%20generally%20fines%20upward%20%20from%20basal%20alluvial%20and%20fluvial%20conglomerate%20%20to%20fluvial%20and%20lacustrine%20sandstone%20and%20%20mudstone.%20Resedimented%20ashes%20and%20basalt%20%20flows%20punctuate%20the%20synrift%20megasequence.%20%20Rifting%20began%20in%20the%20Unegt%20subbasin%20prior%20%20to%20155%20Ma%20with%20coarse%20alluvial%20filling%20of%20local%20%20fault%20depressions.%20Subsidence%20generally%20%20outstripped%20sediment%20supply,%20and%20fresh%20to%20%20saline%20lacustrine%20environments,%20expanding%20%20southward%20with%20time,%20dominated%20the%20Unegt-%20Zuunbayan%20landscape%20for%20much%20of%20latest%20%20Jurassic%E2%80%93Early%20Cretaceous%20time.%20Episodic%20%20faulting%20and%20volcanism%20characterized%20the%20%20basin%20system%20for%20the%20balance%20of%20the%20Early%20%20Cretaceous.%20A%20brief%20period%20of%20compressional%20%20and/or%20transpressional%20basin%20inversion%20%20occurred%20at%20the%20end%20of%20the%20Early%20Cretaceous,%20%20prior%20to%20deposition%20of%20a%20widespread%20%20Upper%20Cretaceous%20overlap%20sequence.The%20driver(s)%20of%20Late%20Jurassic%E2%80%93Early%20Cretaceous%20%20extension%20remain%20uncertain%20because%20%20southeast%20Mongolia%20occupied%20an%20intraplate%20%20position%20by%20the%20beginning%20of%20the%20Cretaceous.%20%20Extension%20in%20the%20East%20Gobi%20basin%20was%20coeval%20%20with%20collapse%20and%20extension%20of%20early%20Mesozoic%20%20contractional%20orogenic%20belts%20along%20the%20%20northern%20and%20southern%20borders%20of%20Mongolia%20%20and%20probably%20was%20a%20linked%20phenomenon.%20%20Strike-slip%20faulting%20associated%20with%20collisions%20%20on%20the%20southern%20Asian%20and%20Mongol-%20Okhotsk%20margins%20likely%20also%20played%20a%20role%20%20in%20late%20Mesozoic%20deformation%20of%20the%20East%20%20Gobi%20region,%20perhaps%20partitioning%20the%20Gobi%20%20from%20apparently%20coeval%20large-magnitude%20%20contractional%20deformation%20in%20the%20Yinshan-%20Yanshan%20orogenic%20belt%20south%20of%20the%20study%20%20area%20in%20Inner%20Mongolia.}}

