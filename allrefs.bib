@article{Meister2013a,
	annote = {10.1130/G34185.1},
	author = {Meister, Patrick},
	date = {2013/04/01},
	date-added = {2013-03-25 20:31:04 +0000},
	date-modified = {2013-03-25 20:31:04 +0000},
	journal = {Geology},
	journal1 = {Geology},
	month = {04},
	number = {4},
	pages = {499--502},
	title = {Two opposing effects of sulfate reduction on carbonate precipitation in normal marine, hypersaline, and alkaline environments},
	ty = {JOUR},
	url = {http://geology.gsapubs.org/content/41/4/499.abstract N2 - Sulfate reduction has been suggested as a mechanism to induce precipitation of calcium and magnesium carbonates in marine sediments and microbial mats through most of Earth’s history. However, sulfate reduction also causes a drop in pH that favors dissolution rather than precipitation of carbonates. Model results obtained in this study show that in modern seawater, modern hypersaline water, and assumed Precambrian alkaline seawater, sulfate reduction initially lowers the saturation of carbonates due to a rapid decrease in pH. With continuing sulfate reduction, the pH stabilizes between 6.5 and 7, and carbonate saturation slowly increases as a result of increasing dissolved inorganic carbon concentration. However, sulfate reduction in surface microbial mats is not sufficient to cause such an increase in saturation. With increasing salinity, sulfate reduction becomes even less efficient to induce carbonate precipitation. In an alkaline Precambrian ocean, where large amounts of carbonate were formed, induction through sulfate reduction was entirely ineffective. Other metabolic pathways or abiotic factors must be responsible for inducing carbonate formation in microbial mats through Earth’s history.},
	volume = {41},
	year = {2013},
	bdsk-url-1 = {http://geology.gsapubs.org/content/41/4/499.abstract%20N2%20-%20Sulfate%20reduction%20has%20been%20suggested%20as%20a%20mechanism%20to%20induce%20precipitation%20of%20calcium%20and%20magnesium%20carbonates%20in%20marine%20sediments%20and%20microbial%20mats%20through%20most%20of%20Earth%E2%80%99s%20history.%20However,%20sulfate%20reduction%20also%20causes%20a%20drop%20in%20pH%20that%20favors%20dissolution%20rather%20than%20precipitation%20of%20carbonates.%20Model%20results%20obtained%20in%20this%20study%20show%20that%20in%20modern%20seawater,%20modern%20hypersaline%20water,%20and%20assumed%20Precambrian%20alkaline%20seawater,%20sulfate%20reduction%20initially%20lowers%20the%20saturation%20of%20carbonates%20due%20to%20a%20rapid%20decrease%20in%20pH.%20With%20continuing%20sulfate%20reduction,%20the%20pH%20stabilizes%20between%206.5%20and%207,%20and%20carbonate%20saturation%20slowly%20increases%20as%20a%20result%20of%20increasing%20dissolved%20inorganic%20carbon%20concentration.%20However,%20sulfate%20reduction%20in%20surface%20microbial%20mats%20is%20not%20sufficient%20to%20cause%20such%20an%20increase%20in%20saturation.%20With%20increasing%20salinity,%20sulfate%20reduction%20becomes%20even%20less%20efficient%20to%20induce%20carbonate%20precipitation.%20In%20an%20alkaline%20Precambrian%20ocean,%20where%20large%20amounts%20of%20carbonate%20were%20formed,%20induction%20through%20sulfate%20reduction%20was%20entirely%20ineffective.%20Other%20metabolic%20pathways%20or%20abiotic%20factors%20must%20be%20responsible%20for%20inducing%20carbonate%20formation%20in%20microbial%20mats%20through%20Earth%E2%80%99s%20history.}}

