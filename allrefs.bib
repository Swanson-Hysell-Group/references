@article{Groot2016a,
	annote = {10.1093/gji/ggw095},
	author = {de Groot, Lennart V. and Pimentel, Adriano and Di Chiara, Anita},
	date = {2016/07/01},
	date-added = {2016-06-13 18:35:57 +0000},
	date-modified = {2016-06-13 18:35:57 +0000},
	doi = {10.1093/gji/ggw095},
	journal = {Geophysical Journal International},
	m3 = {10.1093/gji/ggw095},
	month = {07},
	number = {1},
	pages = {590--604},
	title = {The multimethod palaeointensity approach applied to volcanics from Terceira: full-vector geomagnetic data for the past 50 kyr},
	ty = {JOUR},
	url = {http://gji.oxfordjournals.org/content/206/1/590.abstract N2 - The island of Terceira (38.5°N, 27.2°W) in the Azores Archipelago boasts a wealth of well-dated recent volcanic products; it is therefore the ideal location to improve the resolution of the full-vector geomagnetic field record for the Mid-Atlantic Ocean. We investigated 21 (sub-)sites sampled from 10 different cooling units; six of these cooling units are from the Holocene, the other four are approximately coeval with the age of known geomagnetic excursions. After successfully determining the palaeodirections from all but one site, we applied the multimethod palaeointensity approach to all sites. Here, we used three different palaeointensity methods: the IZZI-Thellier protocol, the Multispecimen technique, and the calibrated pseudo-Thellier method. For the Holocene sites four robust palaeointensity estimates were obtained, they mostly agree with data from the nearby island of São Miguel and data from the Iberian Peninsula and West Africa. Two older sites, dated at 25.7 and 46.3 ka, produced low palaeointensities: 24.4 and 24.1 μT, respectively. As both the IZZI-Thellier and pseudo-Thellier methods yielded technically acceptable results for these sites we used them to improve the pseudo-Thellier calibration relation and establish its applicability to lower palaeointensities. Sixty per cent of all sampled cooling units/ages in our study yielded a technically successful palaeointensity estimate; this unusually high success rate is attributed both to our sampling strategy and the implementation of the multimethod approach.},
	volume = {206},
	year = {2016},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://gji.oxfordjournals.org/content/206/1/590.abstract%20N2%20-%20The%20island%20of%20Terceira%20(38.5%C2%B0N,%2027.2%C2%B0W)%20in%20the%20Azores%20Archipelago%20boasts%20a%20wealth%20of%20well-dated%20recent%20volcanic%20products;%20it%20is%20therefore%20the%20ideal%20location%20to%20improve%20the%20resolution%20of%20the%20full-vector%20geomagnetic%20field%20record%20for%20the%20Mid-Atlantic%20Ocean.%20We%20investigated%2021%20(sub-)sites%20sampled%20from%2010%20different%20cooling%20units;%20six%20of%20these%20cooling%20units%20are%20from%20the%20Holocene,%20the%20other%20four%20are%20approximately%20coeval%20with%20the%20age%20of%20known%20geomagnetic%20excursions.%20After%20successfully%20determining%20the%20palaeodirections%20from%20all%20but%20one%20site,%20we%20applied%20the%20multimethod%20palaeointensity%20approach%20to%20all%20sites.%20Here,%20we%20used%20three%20different%20palaeointensity%20methods:%20the%20IZZI-Thellier%20protocol,%20the%20Multispecimen%20technique,%20and%20the%20calibrated%20pseudo-Thellier%20method.%20For%20the%20Holocene%20sites%20four%20robust%20palaeointensity%20estimates%20were%20obtained,%20they%20mostly%20agree%20with%20data%20from%20the%20nearby%20island%20of%20S%C3%A3o%20Miguel%20and%20data%20from%20the%20Iberian%20Peninsula%20and%20West%20Africa.%20Two%20older%20sites,%20dated%20at%2025.7%20and%2046.3%20ka,%20produced%20low%20palaeointensities:%2024.4%20and%2024.1%20%CE%BCT,%20respectively.%20As%20both%20the%20IZZI-Thellier%20and%20pseudo-Thellier%20methods%20yielded%20technically%20acceptable%20results%20for%20these%20sites%20we%20used%20them%20to%20improve%20the%20pseudo-Thellier%20calibration%20relation%20and%20establish%20its%20applicability%20to%20lower%20palaeointensities.%20Sixty%20per%20cent%20of%20all%20sampled%20cooling%20units/ages%20in%20our%20study%20yielded%20a%20technically%20successful%20palaeointensity%20estimate;%20this%20unusually%20high%20success%20rate%20is%20attributed%20both%20to%20our%20sampling%20strategy%20and%20the%20implementation%20of%20the%20multimethod%20approach.},
	bdsk-url-2 = {http://dx.doi.org/10.1093/gji/ggw095}}

@article{Reznik2016a,
	abstract = {This study investigates the effects of shock waves on magnetic and microstructural behavior of multidomain magnetite from a magnetite-bearing ore, experimentally shocked to pressures of 5, 10, 20 and 30 GPa. Changes in apparent crystallite size and lattice parameter were determined by X-ray diffraction, and grain fragmentation and defect accumulation were studied by scanning and transmission electron microscopy. Magnetic properties were characterized by low-temperature saturation isothermal remanent magnetization (SIRM), susceptibility measurements around the Verwey transition as well as by hysteresis parameters at room temperature. It is established, that the shock-induced refinement of magnetic domains from MD to SD-PSD range is a result of cooperative processes including brittle fragmentation of magnetite grains, plastic deformation with shear bands and twins as well as structural disordering in form of molten grains and amorphous nano-clusters. Up to 10 GPa, a decrease of coherent crystallite size, lattice parameter, saturation magnetization and magnetic susceptibility, and an increase in coercivity, SIRM, width of Verwey transition is mostly associated with brittle grain fragmentation. Starting from 20 GPa, a slight recovery is documented in all magnetic and non-magnetic parameters. In particular, the recovery in SIRM is correlated with an increase of the lattice constant. The recovery effect is associated with the increasing influence of shock heating/annealing at high shock pressures. The strong decrease of magnetic susceptibility at 30 GPa is interpreted as a result of strong lattice damage and distortion. Our results unravel the microstructural mechanisms behind the loss of magnetization and the modification of magnetic properties of magnetite and contribute to our understanding of shock-induced magnetic phenomena in impacted rocks on earth and in meteorites. This article is protected by copyright. All rights reserved.},
	author = {Reznik, Boris and Kontny, Agnes and Fritz, J{\"o}rg and Gerhards, Uta},
	date-added = {2016-06-13 18:29:30 +0000},
	date-modified = {2016-06-13 18:29:30 +0000},
	doi = {10.1002/2016GC006338},
	isbn = {1525-2027},
	journal = {Geochemistry, Geophysics, Geosystems},
	publisher = {Wiley Online Library},
	title = {Shock-induced deformation phenomena in magnetite and their consequences on magnetic properties},
	ty = {JOUR},
	url = {http://dx.doi.org/10.1002/2016GC006338},
	year = {2016},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://dx.doi.org/10.1002/2016GC006338}}

