@article{Fairchild2016b,
	author = {Fairchild, Luke M. and Swanson-Hysell, Nicholas L. and Tikoo, Sonia M.},
	cited-by = {Slate_Islands},
	date = {2016/07/22},
	date-added = {2016-08-11 23:12:06 +0000},
	date-modified = {2016-08-31 22:31:29 +0000},
	doi = {10.1130/G37927.1},
	journal = {Geology},
	m3 = {10.1130/G37927.1},
	title = {A matter of minutes: Breccia dike paleomagnetism provides evidence for rapid crater modification},
	ty = {JOUR},
	volume = {44},
	year = {2016},
	bdsk-url-1 = {http://geology.gsapubs.org/content/early/2016/07/21/G37927.1.abstract%20N2%20-%20During%20an%20impact%20event,%20a%20crater's%20transient%20structure%20adjusts%20gravitationally.%20Within%20medium-sized%20complex%20craters,%20a%20central%20uplift%20rises%20and%20collapses%20resulting%20in%20large-scale%20rotations%20of%20the%20target%20rock.%20Estimated%20crater%20modification%20rates%20from%20numerical%20models%20indicate%20that%20complex%20impact%20craters%20modify%20to%20a%20structurally%20stable%20state%20within%20tens%20of%20seconds%20to%20several%20minutes%20after%20excavation.%20However,%20there%20is%20little%20direct%20geologic%20evidence%20constraining%20these%20rates.%20We%20show%20how%20paleomagnetic%20measurements%20of%20lithic%20breccia%20dikes%20emplaced%20during%20crater%20excavation%20can%20be%20used%20to%20constrain%20the%20rate%20of%20crater%20modification%20within%20the%20central%20uplift%20of%20the%20%E2%88%BC34-km-diameter%20Slate%20Islands%20impact%20structure,%20Ontario,%20Canada.%20The%20uniformity%20and%20linearity%20of%20paleomagnetic%20directions%20among%20the%20clasts%20and%20matrix%20of%20breccia%20dikes%20throughout%20the%20impact%20structure%20indicate%20that%20breccia%20dikes%20were%20frictionally%20heated%20above%20the%20magnetite%20Curie%20temperature%20(580%20%C2%B0C)%20during%20their%20emplacement%20and%20subsequently%20cooled%20in%20situ%20through%20magnetic%20blocking%20temperatures.%20The%20tight%20grouping%20of%20these%20paleomagnetic%20directions%20implies%20that%20these%20breccia%20dikes%20cooled%20and%20locked%20in%20magnetic%20remanence%20over%20a%20time%20interval%20in%20which%20the%20impact%20structure%20was%20not%20experiencing%20structural%20rotations%20and%20had%20already%20reached%20a%20stable%20state.%20Conductive%20cooling%20of%20the%20thinnest%20sampled%20breccia%20dike%20would%20have%20led%20to%20the%20recording%20of%20magnetic%20remanence%20approximately%20six%20minutes%20after%20emplacement.%20This%20constraint%20necessitates%20a%20stable%20crater%20structure%20only%20minutes%20after%20impact%20and%20presents%20a%20rare%20case%20in%20which%20a%20geological%20process%20can%20be%20resolved%20on%20such%20a%20short%20time%20scale.}}

