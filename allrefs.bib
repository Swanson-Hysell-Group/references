	title = {Neoproterozoic aragonite-dolomite seas? Widespread marine dolomite precipitation in Cryogenian reef complexes},
	ty = {JOUR},
	volume = {39},
	year = {2011},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://geology.gsapubs.org/content/39/9/871.abstract%20N2%20-%20The%20extraordinary%20abundance%20of%20dolomite%20in%20the%20Proterozoic%20challenges%20our%20understanding%20of%20Precambrian%20marine%20environments.%20Here%20we%20show%20that%20synsedimentary%20marine%20dolomite%20precipitation%20was%20pervasive%20within%20Cryogenian%20reef%20complexes%20from%20the%20Adelaide%20Fold%20Belt,%20South%20Australia.%20Although%20these%20reefs%20are%20composed%20of%20dolomite,%20textural%20evidence%20indicates%20an%20originally%20aragonitic%20mineralogy%20for%20depositional%20components,%20in%20common%20with%20many%20other%20Neoproterozoic%20carbonates.%20Allochthonous%20slope%20debris%20from%20the%20reefs%20invariably%20contains%20both%20limestone%20and%20dolomite%20clasts,%20indicating%20synsedimentary%20dolomitization%20in%20the%20reefs.%20We%20describe%20several%20new%20forms%20of%20fibrous%20marine%20dolomite%20cement%20from%20the%20reefs%20that%20have%20a%20length-slow%20optical%20character.%20These%20fascicular%20slow,%20radial%20slow,%20and%20rhombic%20dolomite%20cements%20have%20finely%20preserved%20cathodoluminescent%20growth%20zones,%20and%20optical%20characteristics%20that%20indicate%20they%20originally%20precipitated%20as%20dolomite,%20rather%20than%20replacing%20calcite%20or%20aragonite%20cements.%20Abundant%20early%20marine%20dolomite%20precipitation%20implies%20a%20radically%20different%20seawater%20chemistry%20for%20the%20Cryogenian.%20Perhaps%20these%20aragonite-dolomite%20seas%20are%20associated%20with%20extreme%20Neoproterozoic%20glacial%20events%20and/or%20ocean%20anoxia.}}

