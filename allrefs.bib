@article{Brueckner1985a,
	author = {Brueckner, Hannes K. and Snyder, Walter S.},
	date = {1985/07/01},
	date-added = {2013-10-23 04:03:16 +0000},
	date-modified = {2013-10-23 04:03:16 +0000},
	journal = {Journal of Sedimentary Research},
	m3 = {10.1306/212F872E-2B24-11D7-8648000102C1865D},
	month = {07},
	number = {4},
	pages = {553--568},
	title = {Chemical and Sr-isotopic variations during diagenesis of Miocene siliceous sediments of the Monterey Formation, California},
	ty = {JOUR},
	url = {http://jsedres.sepmonline.org/content/55/4/553.abstract N2 - The Monterey Formation of California preserves Miocene siliceous sediments at progressive (generally with depth) diagenetic stages: diatomite (opal-A) --> CT-chert (opaI-CT) --> quartz chert for initially clay-poor sediments and diatomaceous shale --> CT-porcelanite (porous opal-CT) --> quartz porcelanite for sediments that were initially clay-rich. The chemistry of most diatomite is controlled by three primary phases (biogenic silica, carbonate, and detrital clay) and several subsidiary phases (organic material, apatite, pyrite, and detrital minerals including quartz and plagioclase). The elemental abundances of the clay-poor diagenetic sequence decrease sharply with advancing diagenetic state for those elements controlled by clay (Al, Ti, K, Rb, Cs, Fe, some Group B metals), carbonate (Ca, Mg, Sr, Ba), apatite (P, Ca, Sr, Ba, V), and organics (V, Ni), while silica shows a congruent increase. These first-order variations reflect the initial compositions of the siliceous sediments modified by the addition of silica, the removal of carbonate and apatite, and the migration of petroleum during silica diagenesis. Anomalous abundances of Mn, Ni, Cr, Mo, and some other Group B metals are associated with trapped refractory organic material and suggest that petroleum catagenesis and migration occurred during silica diagenesis: migration may have been facilitated by the release of bound water during silica-dehydration reactions. Second-order variations (in K/Rb, K/Cs, Rb/Sr, 87 Sr/ 86 Sr) with advancing diagenetic state suggest ion-exchange and ion-expulsion by reaction of detrital phases with pore fluids. Diagenetic processes partially equilibrated, but did not homogenize, depositional 87 Rb/ 86 Sr- 87 Sr/ 86 Sr mixing lines generated by detrital clays and authigenic carbonate and silica in siliceous sediments from the Santa Maria region. However, similar mixing lines in diatomites from the Santa Lucia area are reset to nearly horizontal slopes in associated CT-porcelanites. The degree of equilibration may be a function of the rate of formation of relatively impermeable quartz chert which isolated the siliceous system from further interaction with pore fluids. The rapid formation of quartz chert in the Santa Maria region is believed to have prevented isotopic homogenization processes from reaching completion. Initial chemistry of the siliceous systems controlled the rates and pathways of silica diagenesis. Silica diagenesis, in turn, altered the chemistry of the siliceous sediment.},
	volume = {55},
	year = {1985},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://jsedres.sepmonline.org/content/55/4/553.abstract%20N2%20-%20The%20Monterey%20Formation%20of%20California%20preserves%20Miocene%20siliceous%20sediments%20at%20progressive%20(generally%20with%20depth)%20diagenetic%20stages:%20diatomite%20(opal-A)%20--%3E%20CT-chert%20(opaI-CT)%20--%3E%20quartz%20chert%20for%20initially%20clay-poor%20sediments%20and%20diatomaceous%20shale%20--%3E%20CT-porcelanite%20(porous%20opal-CT)%20--%3E%20quartz%20porcelanite%20for%20sediments%20that%20were%20initially%20clay-rich.%20The%20chemistry%20of%20most%20diatomite%20is%20controlled%20by%20three%20primary%20phases%20(biogenic%20silica,%20carbonate,%20and%20detrital%20clay)%20and%20several%20subsidiary%20phases%20(organic%20material,%20apatite,%20pyrite,%20and%20detrital%20minerals%20including%20quartz%20and%20plagioclase).%20The%20elemental%20abundances%20of%20the%20clay-poor%20diagenetic%20sequence%20decrease%20sharply%20with%20advancing%20diagenetic%20state%20for%20those%20elements%20controlled%20by%20clay%20(Al,%20Ti,%20K,%20Rb,%20Cs,%20Fe,%20some%20Group%20B%20metals),%20carbonate%20(Ca,%20Mg,%20Sr,%20Ba),%20apatite%20(P,%20Ca,%20Sr,%20Ba,%20V),%20and%20organics%20(V,%20Ni),%20while%20silica%20shows%20a%20congruent%20increase.%20These%20first-order%20variations%20reflect%20the%20initial%20compositions%20of%20the%20siliceous%20sediments%20modified%20by%20the%20addition%20of%20silica,%20the%20removal%20of%20carbonate%20and%20apatite,%20and%20the%20migration%20of%20petroleum%20during%20silica%20diagenesis.%20Anomalous%20abundances%20of%20Mn,%20Ni,%20Cr,%20Mo,%20and%20some%20other%20Group%20B%20metals%20are%20associated%20with%20trapped%20refractory%20organic%20material%20and%20suggest%20that%20petroleum%20catagenesis%20and%20migration%20occurred%20during%20silica%20diagenesis:%20migration%20may%20have%20been%20facilitated%20by%20the%20release%20of%20bound%20water%20during%20silica-dehydration%20reactions.%20Second-order%20variations%20(in%20K/Rb,%20K/Cs,%20Rb/Sr,%2087%20Sr/%2086%20Sr)%20with%20advancing%20diagenetic%20state%20suggest%20ion-exchange%20and%20ion-expulsion%20by%20reaction%20of%20detrital%20phases%20with%20pore%20fluids.%20Diagenetic%20processes%20partially%20equilibrated,%20but%20did%20not%20homogenize,%20depositional%2087%20Rb/%2086%20Sr-%2087%20Sr/%2086%20Sr%20mixing%20lines%20generated%20by%20detrital%20clays%20and%20authigenic%20carbonate%20and%20silica%20in%20siliceous%20sediments%20from%20the%20Santa%20Maria%20region.%20However,%20similar%20mixing%20lines%20in%20diatomites%20from%20the%20Santa%20Lucia%20area%20are%20reset%20to%20nearly%20horizontal%20slopes%20in%20associated%20CT-porcelanites.%20The%20degree%20of%20equilibration%20may%20be%20a%20function%20of%20the%20rate%20of%20formation%20of%20relatively%20impermeable%20quartz%20chert%20which%20isolated%20the%20siliceous%20system%20from%20further%20interaction%20with%20pore%20fluids.%20The%20rapid%20formation%20of%20quartz%20chert%20in%20the%20Santa%20Maria%20region%20is%20believed%20to%20have%20prevented%20isotopic%20homogenization%20processes%20from%20reaching%20completion.%20Initial%20chemistry%20of%20the%20siliceous%20systems%20controlled%20the%20rates%20and%20pathways%20of%20silica%20diagenesis.%20Silica%20diagenesis,%20in%20turn,%20altered%20the%20chemistry%20of%20the%20siliceous%20sediment.}}

@article{Fox1985a,
	author = {Fox, KENNETH F. and Fleck, ROBERT J. and Curtis, GARNISS H. and Meyer, CHARLES E.},
	date-added = {2013-10-23 03:53:08 +0000},
	date-modified = {2023-11-07 09:49:52 -0800},
	doi = {10.1130/0016-7606(1985)96<647:IOTNYA>2.0.CO;2},
	journal = {Geological Society of America Bulletin},
	month = {05},
	number = {5},
	pages = {647--654},
	title = {Implications of the northwestwardly younger age of the volcanic rocks of west-central {C}alifornia},
	volume = {96},
	year = {1985},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://gsabulletin.gsapubs.org/content/96/5/647.abstract%20N2%20-%20Erosional%20remnants%20of%20volcanic%20fields%20in%20west-central%20California%20form%20a%20linear%20northwest-trending%20belt%20growing%20younger%20in%20age%20to%20the%20northwest.%20Major%20fields%20within%20the%20belt%20are%20represented%20by%20the%20Neenach%20Volcanics,%20Pinnacles%20Volcanic%20Formation,%20Quien%20Sabe%20Volcanics,%20volcanic%20rocks%20in%20the%20Berkeley%20Hills,%20Tolay%20Volcanics,%20Sonoma%20Volcanics,%20and%20Clear%20Lake%20Volcanics.%20Dispersion%20in%20the%20age-distance%20relation%20is%20reduced%20by%20restoration%20of%20inferred%20offsets%20on%20transecting%20right-lateral%20fault%20systems.%20The%20offsets%20include%20115%20km%20on%20the%20San%20Gregorio%E2%80%93Hosgri%20fault,%20314%20km%20on%20the%20San%20Andreas%20fault,%2043%20km%20on%20the%20Hayward-Rodgers%20Creek%20fault,%20and%2028%20km%20on%20the%20Carneros-Franklin-Sunol-Calaveras%20fault.%20On%20the%20basis%20of%20the%20age%20and%20restored%20position%20of%20the%20volcanic%20rocks,%20we%20judge%20that%20the%20locus%20of%20initial%20active%20volcanism%20migrated%20northwestward%20%E2%88%BC3.75%20cm/yr%20from%2025%20to%2012%20Ma,%20and%20%E2%88%BC1.35%20cm/yr%20from%2012%20Ma%20to%20the%20present.The%20volcanic%20rocks%20apparently%20formed%20south%20of%20the%20northwardly%20retreating%20edge%20of%20the%20subducted%20part%20of%20the%20Juan%20de%20Fuca%20plate,%20corroborating%20one%20corollary%20of%20a%20published%20model%20of%20an%20expanding%20hole%20in%20the%20subducted%20Farallon-Juan%20de%20Fuca-Cocos%20plate.%20The%20present%20position%20of%20the%20locus%20of%20melting%20at%20Clear%20Lake,%20California,%20requires%20substantial%20overthrusting%20of%20the%20Juan%20de%20Fuca%20plate%20by%20the%20Pacific%20plate,%20as%20was%20postulated%20on%20the%20basis%20of%20foreshortening%20of%20magnetic%20anomalies%20in%20the%20Gorda%20basin.%20The%20change%20in%20rate%20of%20northwestward%20migration%20%E2%88%BC12%20Ma%20reflects%20a%20change%20in%20spreading%20direction%20of%20the%20Juan%20de%20Fuca%20plate%20vis-%C3%A0-vis%20the%20Pacific%20plate,%20previously%20recognized%20from%20changes%20in%20orientation%20of%20oceanic%20magnetic%20anomalies.%20From%20the%20migration%20rates,%20it%20can%20be%20inferred%20that%20the%20relative%20movement%20between%20the%20Pacific%20plate%20and%20the%20westernmost%20fringe%20of%20the%20North%20American%20plate%20averaged%20%E2%88%BC3.5%20cm/yr%20from%2027%20m.y.%20ago%20to%20the%20present.}}

@article{Cole1992a,
	author = {Cole, Ronald B. and Basu, Asish R.},
	date = {1992/10/30},
	date-added = {2013-10-23 03:45:00 +0000},
	date-modified = {2013-10-23 03:45:00 +0000},
	journal = {Science},
	m3 = {10.1126/science.258.5083.793},
	month = {10},
	number = {5083},
	pages = {793--796},
	title = {Middle Tertiary Volcanism During Ridge-Trench Interactions in Western California},
	ty = {JOUR},
	url = {http://www.sciencemag.org/content/258/5083/793.abstract N2 - Bimodal volcanism in the Santa Maria Province of west-central California occurred when segments of the East Pacific Rise interacted with a subduction zone along the California margin during the Early Miocene (about 17 million years ago). Isotopic compositions of neodymium and strontium as well as trace-element data indicate that these volcanic rocks were derived from a depleted-mantle (mid-ocean ridge basalt) source. After ridge-trench interactions, the depleted-mantle reservoir was juxtaposed beneath the continental margin and was erupted to form basalts. It also assimilated and partially melted local Jurassic-Cretaceous sedimentary and metasedimentary basement rocks to form rhyolites and dacites.},
	volume = {258},
	year = {1992},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://www.sciencemag.org/content/258/5083/793.abstract%20N2%20-%20Bimodal%20volcanism%20in%20the%20Santa%20Maria%20Province%20of%20west-central%20California%20occurred%20when%20segments%20of%20the%20East%20Pacific%20Rise%20interacted%20with%20a%20subduction%20zone%20along%20the%20California%20margin%20during%20the%20Early%20Miocene%20(about%2017%20million%20years%20ago).%20Isotopic%20compositions%20of%20neodymium%20and%20strontium%20as%20well%20as%20trace-element%20data%20indicate%20that%20these%20volcanic%20rocks%20were%20derived%20from%20a%20depleted-mantle%20(mid-ocean%20ridge%20basalt)%20source.%20After%20ridge-trench%20interactions,%20the%20depleted-mantle%20reservoir%20was%20juxtaposed%20beneath%20the%20continental%20margin%20and%20was%20erupted%20to%20form%20basalts.%20It%20also%20assimilated%20and%20partially%20melted%20local%20Jurassic-Cretaceous%20sedimentary%20and%20metasedimentary%20basement%20rocks%20to%20form%20rhyolites%20and%20dacites.}}

