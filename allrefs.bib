	number = {1},
	pages = {111--124},
	title = {Whole-rock aminostratigraphy of the Coorong Coastal Plain, South Australia: towards a 1 million year record of sea-level highstands},
	ty = {JOUR},
	volume = {158},
	year = {2001},
