	title = {Two diamictites, two cap carbonates, two $\delta^{13}${C} excursions, two rifts: The {N}eoproterozoic {Kingston Peak Formation, Death Valley, California}},
	ty = {JOUR},
	volume = {27},
	year = {1999},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://geology.gsapubs.org/content/27/4/339.abstract%20N2%20-%20Stratigraphic%20mapping%20of%20the%20Neoproterozoic%20glaciogenic%20Kingston%20Peak%20Formation%20(Death%20Valley,%20California)%20provides%20evidence%20for%20two%20temporally%20discrete%20extensional%20deformation%20episodes.%20These%20episodes%20are%20bracketed%20by%20the%20Sourdough%20Limestone%20and%20Noonday%20Dolomite,%20the%20facies%20characteristics%20and%20%CE%B413C%20data%20(ranging%20between%202.15%20and%20%E2%88%922.56%E2%80%B0%20and%20%E2%88%921.88%20and%20%E2%88%924.86%E2%80%B0,%20respectively)%20of%20which%20make%20them%20equivalent%20to%20Sturtian%20and%20Varangian%20age%20cap%20carbonates,%20respectively.%20This%20constrains%20the%20two%20extensional%20episodes%20along%20the%20southwestern%20margin%20of%20Laurentia%20to%20ca.%20700%20Ma%20and%20ca.%20600%20Ma.%20These%20observations%20and%20data%20show%20that%20the%20field%20evidence%20for%20mid-Neoproterozoic%20breakup%20and%20the%20predictions%20from%20tectonic%20subsidence%20curves%20for%20a%20latest%20Neoproterozoic%20breakup%20are%20both%20correct.%20Thus,%20Neoproterozoic%20plate%20reconstructions%20must%20account%20for%20two%20discrete%20rift%20episodes%20separated%20by%20100%20m.y.%20or%20more.%20Confining%20rifting%20to%20within%20the%20Kingston%20Peak%20Formation%20thereby%20places%20the%20younger%20Proterozoic%20rocks%20of%20the%20southwestern%20Great%20Basin%20in%20the%20rift%20to%20drift%20tectonic%20phase.}}

