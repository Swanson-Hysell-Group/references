	month = {07},
	number = {7},
	pages = {671--674},
	title = {$^{40}${A}r/$^{39}${A}r age of the {L}onar crater and consequence for the geochronology of planetary impacts},
	ty = {JOUR},
	volume = {39},
	year = {2011},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://geology.gsapubs.org/content/39/7/671.abstract%20N2%20-%20Asteroid%20impacts%20play%20an%20important%20role%20in%20the%20evolution%20of%20planetary%20surfaces.%20In%20the%20inner%20solar%20system,%20the%20large%20majority%20of%20impacts%20occur%20on%20bodies%20(e.g.,%20asteroids,%20the%20Moon,%20Mars)%20covered%20by%20primitive%20igneous%20rocks.%20However,%20most%20of%20the%20impacts%20recorded%20on%20Earth%20occur%20on%20different%20rock%20types%20and%20are%20poor%20proxies%20for%20planetary%20impacts.%20The%20Lonar%20crater%20is%20a%201.88-km-diameter,%20Quaternary%20age%20crater%20(Fig.%201)%20located%20on%20the%20ca.%2066%20Ma%20Deccan%20basaltic%20traps%20in%20Maharashtra%20(India),%20and%20is%20one%20of%20the%20very%20few%20craters%20on%20Earth%20emplaced%20directly%20on%20basaltic%20lava%20flows.%20We%20carried%20out%2012%2040Ar/39Ar%20step-heating%20experiments%20on%204%20melt%20rock%20samples%20in%20order%20to%20(1)%20obtain%20a%20precise%20age%20for%20the%20Lonar%20crater;%20(2)%20study%20the%20response%20of%20isotopic%20chronometers%20during%20impacts%20on%20mafic%20target%20rocks;%20and%20(3)%20better%20understand%20the%20dating%20of%20extraterrestrial%20impact%20craters.%20We%20obtained%2010%20plateau%20and%209%20inverse%20isochron%20ages%20on%20various%20aliquots.%20Combination%20of%20selected%20data%20into%20a%20global%20inverse%20isochron%20yielded%20an%20age%20of%20570%20%C2%B1%2047%20ka%20(MSWD%20=%201.1;%20P%20=%200.24).%20In%20comparison,%20previous%20nonisotopic%20investigations%20on%20rocks%20thought%20to%20be%20affected%20by%20secondary%20processes%20yielded%20a%20range%20of%20much%20younger%20ages%20(ca.%2012%E2%80%9362%20ka).%20The%20measured%2040Ar/36Ar%20trapped%20values%20offer%20a%20direct%20comparison%20with%20the%20atmospheric%20benchmark%20value%20and%20allow%20us%20to%20test%20the%20inherited%2040Ar*%20degassing%20capacity%20of%20basaltic%20impact%20melt%20rocks.%20The%2040Ar/36Ar%20ratio%20of%20296.5%20%C2%B1%201.7%20is%20indistinguishable%20from%20the%20atmospheric%20composition%20and%20suggests%20that%20inherited%2040Ar*%20is%20absent%20from%20the%20melt%20rock.%20This%20result%20substantiates%20diffusion%20models%20that%20predict%20a%20near-complete%20degassing%20of%20low-viscosity%20melt%20(e.g.,%20basalts)%20during%20impact,%20and%20demonstrates%20for%20the%20first%20time%20that%20inherited%2040Ar*%20is%20less%20problematic%20for%2040Ar/39Ar%20dating%20of%20impact%20events%20in%20basaltic%20igneous%20rocks%20compared%20to%20Si-rich%20rocks.%20These%20results%20provide%20direct%20evidence%20that%20basaltic%20melt%20rocks%20are%20excellent%20candidates%20for%20recording%20the%20timing%20of%20planetary%20impact%20events%20and,%20as%20far%20as%20dating%20is%20concerned,%20should%20be%20the%20preferred%20targets%20of%20sample%20recovery%20by%20future%20missions.},
	bdsk-url-2 = {http://dx.doi.org/10.1130/G31888.1}}

@article{Swart2012a,
