@article{Montoya-Pino2010a,
	abstract = {During the Mesozoic greenhouse world, the oceans underwent several oceanic anoxic events (OAEs) characterized by intervals during which organic-rich black shales were deposited, indicating strong oxygen depletion in the marine realm. The Cenomanian-Turonian OAE2 (ca. 93 Ma) represents one of the most prominent events of the Cretaceous, with significant perturbations of the global carbon cycle. Although OAE2 likely reached a global scale, the spatial extent of seawater anoxia during this OAE is poorly constrained. Here we demonstrate that variations in the U/U isotope ratio (δU), a newly developed paleoredox proxy, can be used to quantify the extent of marine anoxia. For black shales from the mid-Cretaceous OAE2 we find a systematic shift toward lighter δU and lower U concentrations as compared to modern equivalent organic-rich sediments from the Black Sea. This shift translates to a global increase of oceanic anoxia during OAE2 by at least a factor of three as compared to the present day or to periods before and after OAE2. The constant offset in U concentrations and isotope compositions of black shales throughout OAE2 compared to modern Black Sea sediments indicates an enhancement of oceanic anoxic conditions already prior to the onset of OAE2. },
	annote = {10.1130/G30652.1},
	author = {Montoya-Pino, Carolina and Weyer, Stefan and Anbar, Ariel D. and Pross, J{\"o}rg and Oschmann, Wolfgang and van de Schootbrugge, Bas and Arz, Helge W.},
	date = {2010/04/},
	date-added = {2010-03-25 15:20:50 -0400},
	date-modified = {2011-02-02 09:42:45 -0500},
	journal = {Geology},
	journal1 = {Geology},
	month = {04},
	number = {4},
	pages = {315--318},
	title = {Global enhancement of ocean anoxia during Oceanic Anoxic Event 2: A quantitative approach using U isotopes},
	ty = {JOUR},
	volume = {38},
	year = {2010},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://geology.gsapubs.org/content/38/4/315.abstract}}

@article{Fike2010a,
	abstract = {Carbonate-associated sulfate (CAS) has the potential to generate high-resolution records of seawater sulfate (δS) that improve upon existing evaporite-based records. With improved resolution, however, significant isotopic offsets have become apparent between the evaporite and CAS proxies. Here we present high-resolution δS measurements of both these proxies from the Ara Group, Sultanate of Oman, a series of six carbonate-evaporite sequences deposited ca. 547--540 Ma. The δS from Ara carbonates show little scatter and provide our estimate of δS. Repeated enrichments (as much as 4‰relative to δS) were observed in floor and roof anhydrite units (δS) bounding the Ara carbonates. These enrichments cannot be explained by secular variation or from isotopic fractionation during evaporite deposition and require the existence of an additional S-depleted sink, which we attribute to HS production via ongoing bacterial sulfate reduction during evaporite deposition. To preserve this isotope signature, the resulting sulfide must be sequestered as pyrite. The magnitude of the resulting δS offset (relative to CAS) is a function of local pyrite burial (). In periods of low pyrite burial, it is possible for δS to be depleted relative to δS, whereas during episodes of substantial pyrite burial ( > 0.05), δS can be strongly enriched relative to δS. Our data suggest that local  of ∼0.13 is consistent with the observed δS enrichments found in the Ara Group anhydrites. Such elevated pyrite burial in evaporitic settings requires a substantial iron source, supporting possible ferruginous ocean conditions across the Ediacaran-Cambrian boundary. Isotopic offsets between paired δS-δS data may thus serve as an independent proxy for marine redox through time, in addition to quantifying the importance of microbial activity in a setting where direct evidence (e.g., total organic carbon or biomarkers) may be scarce and physical processes are thought to dominate. },
	annote = {10.1130/G30230.1},
	author = {Fike, D. A. and Grotzinger, J. P.},
	date = {2010/04/},
	date-added = {2010-03-25 15:12:35 -0400},
	date-modified = {2011-02-02 09:42:45 -0500},
	journal = {Geology},
	journal1 = {Geology},
	month = {04},
	number = {4},
	pages = {371--374},
	title = {A δ34SSO4 approach to reconstructing biogenic pyrite burial in carbonate-evaporite basins: An example from the Ara Group, Sultanate of Oman},
	ty = {JOUR},
	volume = {38},
	year = {2010},
	bdsk-file-1 = {},
	bdsk-file-2 = {},
	bdsk-url-1 = {http://geology.gsapubs.org/content/38/4/371.abstract}}

