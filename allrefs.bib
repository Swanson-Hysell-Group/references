@article{Spencer2014a,
	annote = {10.1130/B30884.1},
	author = {Spencer, Christopher J. and Prave, Anthony R. and Cawood, Peter A. and Roberts, Nick M. W.},
	date = {2014/07/01},
	date-added = {2014-06-30 16:25:56 +0000},
	date-modified = {2021-06-03 14:16:37 -0700},
	doi = {10.1130/B30884.1},
	journal = {Geological Society of America Bulletin},
	journal1 = {Geological Society of America Bulletin},
	month = {07},
	number = {7-8},
	pages = {1117--1128},
	title = {{Detrital zircon geochronology of the Grenville/Llano foreland and basal Sauk Sequence in west Texas, USA}},
	ty = {JOUR},
	url = {http://gsabulletin.gsapubs.org/content/126/7-8/1117.abstract N2 - U-Pb detrital zircon ages from Mesoproterozoic and Cambrian siliciclastic units in west Texas (USA) constrain the depositional setting, provenance, and tectonic history of the region within a late Mesoproterozoic Grenville foreland basin and the early Paleozoic Sauk transgressive sequence. Two key units, the Hazel and Lanoria Formations, have detrital zircon age spectra dominated by detritus derived from the Grenville orogen (the Llano uplift and eroded equivalents), the ca. 1.4 Ga Granite-Rhyolite, and the ca. 1.7–1.6 Ga Yavapai/Mazatzal provinces. These data, combined with sedimentological data, permit interpreting those formations as the proximal and distal deposits, respectively, of a molasse shed into the Grenvillian foreland basin.Detrital zircons as young as ca. 520 Ma show that the Van Horn Formation, previously considered to be Precambrian in age, is no older than middle Cambrian. Further, the overall detrital zircon age spectrum of the Van Horn Formation is similar to that of the overlying Cambro-Ordovician Bliss Formation: both indicate derivation from sources that included the Colorado-Oklahoma aulacogen, Grenville, Granite-Rhyolite, and Yavapai/Mazatzal provinces. The similarities between the depositional history of the Van Horn and Bliss Formations lead us to conclude that the base of the Sauk Sequence in west Texas occurs at the base of the Van Horn Formation. Base-level rise associated with the Sauk transgression affected drainage patterns and sediment deposition along southwestern Laurentia some 20 m.y. earlier than previously assumed.},
	volume = {126},
	year = {2014},
	bdsk-file-1 = {},
	bdsk-file-2 = {},
	bdsk-url-1 = {http://gsabulletin.gsapubs.org/content/126/7-8/1117.abstract%20N2%20-%20U-Pb%20detrital%20zircon%20ages%20from%20Mesoproterozoic%20and%20Cambrian%20siliciclastic%20units%20in%20west%20Texas%20(USA)%20constrain%20the%20depositional%20setting,%20provenance,%20and%20tectonic%20history%20of%20the%20region%20within%20a%20late%20Mesoproterozoic%20Grenville%20foreland%20basin%20and%20the%20early%20Paleozoic%20Sauk%20transgressive%20sequence.%20Two%20key%20units,%20the%20Hazel%20and%20Lanoria%20Formations,%20have%20detrital%20zircon%20age%20spectra%20dominated%20by%20detritus%20derived%20from%20the%20Grenville%20orogen%20(the%20Llano%20uplift%20and%20eroded%20equivalents),%20the%20ca.%201.4%20Ga%20Granite-Rhyolite,%20and%20the%20ca.%201.7%E2%80%931.6%20Ga%20Yavapai/Mazatzal%20provinces.%20These%20data,%20combined%20with%20sedimentological%20data,%20permit%20interpreting%20those%20formations%20as%20the%20proximal%20and%20distal%20deposits,%20respectively,%20of%20a%20molasse%20shed%20into%20the%20Grenvillian%20foreland%20basin.Detrital%20zircons%20as%20young%20as%20ca.%20520%20Ma%20show%20that%20the%20Van%20Horn%20Formation,%20previously%20considered%20to%20be%20Precambrian%20in%20age,%20is%20no%20older%20than%20middle%20Cambrian.%20Further,%20the%20overall%20detrital%20zircon%20age%20spectrum%20of%20the%20Van%20Horn%20Formation%20is%20similar%20to%20that%20of%20the%20overlying%20Cambro-Ordovician%20Bliss%20Formation:%20both%20indicate%20derivation%20from%20sources%20that%20included%20the%20Colorado-Oklahoma%20aulacogen,%20Grenville,%20Granite-Rhyolite,%20and%20Yavapai/Mazatzal%20provinces.%20The%20similarities%20between%20the%20depositional%20history%20of%20the%20Van%20Horn%20and%20Bliss%20Formations%20lead%20us%20to%20conclude%20that%20the%20base%20of%20the%20Sauk%20Sequence%20in%20west%20Texas%20occurs%20at%20the%20base%20of%20the%20Van%20Horn%20Formation.%20Base-level%20rise%20associated%20with%20the%20Sauk%20transgression%20affected%20drainage%20patterns%20and%20sediment%20deposition%20along%20southwestern%20Laurentia%20some%2020%20m.y.%20earlier%20than%20previously%20assumed.}}

