@article{Burke2014a,
	author = {Burke, Kevin and Cannon, J. Matthew},
	date = {2014/03/01},
	date-added = {2014-04-08 21:48:09 +0000},
	date-modified = {2014-04-08 21:48:09 +0000},
	journal = {Canadian Journal of Earth Sciences},
	m3 = {10.1139/cjes-2013-0115},
	month = {03},
	number = {3},
	pages = {208--221},
	title = {Plume--plate interaction},
	ty = {JOUR},
	url = {http://cjes.geoscienceworld.org/content/51/3/208.abstract N2 - Having discerned competition among vigorous plumes on the 108 year timescale, Tuzo Wilson suggested that plumes control plate behavior and are “the mainsprings of geological history”. Here we revisit that idea by discussing selected examples of plume–plate interaction and find that modern observational, instrumental, computational, and modeling capabilities are revealing a wonderful variety and complexity in plume–plate interaction. The degree to which plumes control plate behavior is poorly constrained. However, the examples we consider suggest complex interactions between plumes and plates that, during the past 70 million years, have led to separate episodes of extreme plate acceleration and near complete cessation of plate motion in the deep mantle reference frame. The recognition of contrasting convective behavior within two newly distinguished “Active Plume Heads”, both reaching to depths of ∼1200 km, one beneath Hawaii and the other between Iceland and Norway, represent new opportunities in studying plume–plate interaction. Wilson’s suggestion continues to inspire stimulating questions for future research.},
	volume = {51},
	year = {2014},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://cjes.geoscienceworld.org/content/51/3/208.abstract%20N2%20-%20Having%20discerned%20competition%20among%20vigorous%20plumes%20on%20the%20108%20year%20timescale,%20Tuzo%20Wilson%20suggested%20that%20plumes%20control%20plate%20behavior%20and%20are%20%E2%80%9Cthe%20mainsprings%20of%20geological%20history%E2%80%9D.%20Here%20we%20revisit%20that%20idea%20by%20discussing%20selected%20examples%20of%20plume%E2%80%93plate%20interaction%20and%20find%20that%20modern%20observational,%20instrumental,%20computational,%20and%20modeling%20capabilities%20are%20revealing%20a%20wonderful%20variety%20and%20complexity%20in%20plume%E2%80%93plate%20interaction.%20The%20degree%20to%20which%20plumes%20control%20plate%20behavior%20is%20poorly%20constrained.%20However,%20the%20examples%20we%20consider%20suggest%20complex%20interactions%20between%20plumes%20and%20plates%20that,%20during%20the%20past%2070%20million%20years,%20have%20led%20to%20separate%20episodes%20of%20extreme%20plate%20acceleration%20and%20near%20complete%20cessation%20of%20plate%20motion%20in%20the%20deep%20mantle%20reference%20frame.%20The%20recognition%20of%20contrasting%20convective%20behavior%20within%20two%20newly%20distinguished%20%E2%80%9CActive%20Plume%20Heads%E2%80%9D,%20both%20reaching%20to%20depths%20of%20%E2%88%BC1200%20km,%20one%20beneath%20Hawaii%20and%20the%20other%20between%20Iceland%20and%20Norway,%20represent%20new%20opportunities%20in%20studying%20plume%E2%80%93plate%20interaction.%20Wilson%E2%80%99s%20suggestion%20continues%20to%20inspire%20stimulating%20questions%20for%20future%20research.}}

