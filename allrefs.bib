	journal = {J. Geophys. Res.},
	keywords = {snowball earth; climate dynamics; ice modeling; 1620 Global Change: Climate dynamics; 9622 Information Related to Geologic Time: Proterozoic; 0776 Cryosphere: Glaciology; 0726 Cryosphere: Ice sheets; 0750 Cryosphere: Sea ice},
	month = {02},
