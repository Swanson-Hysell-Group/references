	number = {1},
	pages = {1--14},
	title = {Volc{\'a}n Tanc{\'\i}taro, Michoac{\'a}n, Mexico, 40Ar/39Ar constraints on its history of sector collapse},
	url = {https://www.sciencedirect.com/science/article/pii/S0377027306003891},
