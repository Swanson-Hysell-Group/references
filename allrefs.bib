@article{Morrow2008a,
	annote = {10.1130/GES00134.1},
	author = {Morrow, Jared R. and Sandberg, Charles A.},
	date = {2008/04/01},
	date-added = {2012-12-13 05:57:32 +0000},
	date-modified = {2012-12-13 05:57:32 +0000},
	journal = {Geosphere},
	journal1 = {Geosphere},
	month = {04},
	number = {2},
	pages = {445--458},
	title = {Evolution of Devonian carbonate-shelf margin, Nevada},
	ty = {JOUR},
	url = {http://geosphere.gsapubs.org/content/4/2/445.abstract N2 - The north-trending, 550-km-long Nevada segment of the Devonian carbonate-shelf margin, which fringed western North America, evidences the complex interaction of paleotectonics, eustasy, biotic changes, and bolide impact–related influences. Margin reconstruction is complicated by mid-Paleozoic to Paleogene compressional tectonics and younger extensional and strike-slip faulting. Reports published during the past three decades identify 12 important events that influenced development of shelf-margin settings; in chronological order, these are: (1) Early Devonian inheritance of Silurian stable shelf margin, (2) formation of Early to early Middle Devonian shelf-margin basins, (3) progradation of later Middle Devonian shelf margin, (4) late Middle Devonian Taghanic onlap and continuing long-term Frasnian transgression, (5) initiation of latest Middle Devonian to early Frasnian proto-Antler orogenic forebulge, (6) mid-Frasnian Alamo Impact, (7) accelerated development of proto-Antler forebulge and backbulge Pilot basin, (8) global late Frasnian semichatovae sea-level rise, (9) end-Frasnian sea-level fluctuations and ensuing mass extinction, (10) long-term Famennian regression and continent-wide erosion, (11) late Famennian emergence of Antler orogenic highlands, and (12) end-Devonian eustatic sea-level fall.Although of considerable value for understanding facies relationships and geometries, existing standard carbonate platform-margin models developed for passive settings elsewhere do not adequately describe the diverse depositional and structural settings along the Nevada Devonian platform margin. Recent structural and geochemical studies suggest that the Early to Middle Devonian shelf-margin basins may have been fault bound and controlled by inherited Precambrian structure. Subsequently, the migrating latest Middle to Late Devonian Antler orogenic forebulge exerted a dominant control on shelf-margin position, morphology, and sedimentation.},
	volume = {4},
	year = {2008},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://geosphere.gsapubs.org/content/4/2/445.abstract%20N2%20-%20The%20north-trending,%20550-km-long%20Nevada%20segment%20of%20the%20Devonian%20carbonate-shelf%20margin,%20which%20fringed%20western%20North%20America,%20evidences%20the%20complex%20interaction%20of%20paleotectonics,%20eustasy,%20biotic%20changes,%20and%20bolide%20impact%E2%80%93related%20influences.%20Margin%20reconstruction%20is%20complicated%20by%20mid-Paleozoic%20to%20Paleogene%20compressional%20tectonics%20and%20younger%20extensional%20and%20strike-slip%20faulting.%20Reports%20published%20during%20the%20past%20three%20decades%20identify%2012%20important%20events%20that%20influenced%20development%20of%20shelf-margin%20settings;%20in%20chronological%20order,%20these%20are:%20(1)%20Early%20Devonian%20inheritance%20of%20Silurian%20stable%20shelf%20margin,%20(2)%20formation%20of%20Early%20to%20early%20Middle%20Devonian%20shelf-margin%20basins,%20(3)%20progradation%20of%20later%20Middle%20Devonian%20shelf%20margin,%20(4)%20late%20Middle%20Devonian%20Taghanic%20onlap%20and%20continuing%20long-term%20Frasnian%20transgression,%20(5)%20initiation%20of%20latest%20Middle%20Devonian%20to%20early%20Frasnian%20proto-Antler%20orogenic%20forebulge,%20(6)%20mid-Frasnian%20Alamo%20Impact,%20(7)%20accelerated%20development%20of%20proto-Antler%20forebulge%20and%20backbulge%20Pilot%20basin,%20(8)%20global%20late%20Frasnian%20semichatovae%20sea-level%20rise,%20(9)%20end-Frasnian%20sea-level%20fluctuations%20and%20ensuing%20mass%20extinction,%20(10)%20long-term%20Famennian%20regression%20and%20continent-wide%20erosion,%20(11)%20late%20Famennian%20emergence%20of%20Antler%20orogenic%20highlands,%20and%20(12)%20end-Devonian%20eustatic%20sea-level%20fall.Although%20of%20considerable%20value%20for%20understanding%20facies%20relationships%20and%20geometries,%20existing%20standard%20carbonate%20platform-margin%20models%20developed%20for%20passive%20settings%20elsewhere%20do%20not%20adequately%20describe%20the%20diverse%20depositional%20and%20structural%20settings%20along%20the%20Nevada%20Devonian%20platform%20margin.%20Recent%20structural%20and%20geochemical%20studies%20suggest%20that%20the%20Early%20to%20Middle%20Devonian%20shelf-margin%20basins%20may%20have%20been%20fault%20bound%20and%20controlled%20by%20inherited%20Precambrian%20structure.%20Subsequently,%20the%20migrating%20latest%20Middle%20to%20Late%20Devonian%20Antler%20orogenic%20forebulge%20exerted%20a%20dominant%20control%20on%20shelf-margin%20position,%20morphology,%20and%20sedimentation.}}

@article{De-Vleeschouwer2012a,
	annote = {10.1130/B30547.1},
	author = {De Vleeschouwer, David and Whalen, Michael T. and (Jed) Day, James E. and Claeys, Philippe},
	date = {2012/05/01},
	date-added = {2012-12-13 05:07:49 +0000},
	date-modified = {2012-12-13 05:07:49 +0000},
	journal = {Geological Society of America Bulletin},
	journal1 = {Geological Society of America Bulletin},
	month = {05},
	number = {5-6},
	pages = {928--942},
	title = {Cyclostratigraphic calibration of the Frasnian (Late Devonian) time scale (western Alberta, Canada)},
	ty = {JOUR},
	url = {http://gsabulletin.gsapubs.org/content/124/5-6/928.abstract N2 - Until now, the duration of the Frasnian Stage has remained very poorly constrained, hampering a detailed understanding of sedimentation processes and environmental and evolutionary change. In this study, time-series analyses of high-resolution (10–20 k.y.) magnetic susceptibility data identify sixteen 405 k.y. eccentricity cycles in the magnetic susceptibility stratigraphy of the Frasnian (Late Devonian), derived from carbonate-platform and surrounding slope and basin deposits in western Alberta, Canada. Previous studies demonstrated the generally consistent pattern of magnetic susceptibility change across the Alberta basin and thus demonstrated the utility of magnetic susceptibility stratigraphy as a refined regional correlation tool compared to biostratigraphy. In the present study, we show that the magnetic susceptibility stratigraphy of the Frasnian interval in western Alberta has been significantly influenced by astronomical forcing. Using the sixteen 405 k.y. eccentricity cycles as a geochronometer, we constructed a Frasnian astronomical time scale. This time scale indicates a duration of 6.5 ± 0.4 m.y. for the Frasnian. Calibrating this duration to the best available Devonian chronology, the absolute age of the Givetian-Frasnian boundary is recalculated to 383.6 ± 3.0 Ma, and the age of the Frasnian-Famennian boundary is recalculated to 376.7 ± 3.0 Ma. These new absolute ages take into account the astronomically derived duration of the Frasnian, but they also yield a narrowing of the error margins of the absolute ages by several hundreds of thousands of years.},
	volume = {124},
	year = {2012},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://gsabulletin.gsapubs.org/content/124/5-6/928.abstract%20N2%20-%20Until%20now,%20the%20duration%20of%20the%20Frasnian%20Stage%20has%20remained%20very%20poorly%20constrained,%20hampering%20a%20detailed%20understanding%20of%20sedimentation%20processes%20and%20environmental%20and%20evolutionary%20change.%20In%20this%20study,%20time-series%20analyses%20of%20high-resolution%20(10%E2%80%9320%20k.y.)%20magnetic%20susceptibility%20data%20identify%20sixteen%20405%20k.y.%20eccentricity%20cycles%20in%20the%20magnetic%20susceptibility%20stratigraphy%20of%20the%20Frasnian%20(Late%20Devonian),%20derived%20from%20carbonate-platform%20and%20surrounding%20slope%20and%20basin%20deposits%20in%20western%20Alberta,%20Canada.%20Previous%20studies%20demonstrated%20the%20generally%20consistent%20pattern%20of%20magnetic%20susceptibility%20change%20across%20the%20Alberta%20basin%20and%20thus%20demonstrated%20the%20utility%20of%20magnetic%20susceptibility%20stratigraphy%20as%20a%20refined%20regional%20correlation%20tool%20compared%20to%20biostratigraphy.%20In%20the%20present%20study,%20we%20show%20that%20the%20magnetic%20susceptibility%20stratigraphy%20of%20the%20Frasnian%20interval%20in%20western%20Alberta%20has%20been%20significantly%20influenced%20by%20astronomical%20forcing.%20Using%20the%20sixteen%20405%20k.y.%20eccentricity%20cycles%20as%20a%20geochronometer,%20we%20constructed%20a%20Frasnian%20astronomical%20time%20scale.%20This%20time%20scale%20indicates%20a%20duration%20of%206.5%20%C2%B1%200.4%20m.y.%20for%20the%20Frasnian.%20Calibrating%20this%20duration%20to%20the%20best%20available%20Devonian%20chronology,%20the%20absolute%20age%20of%20the%20Givetian-Frasnian%20boundary%20is%20recalculated%20to%20383.6%20%C2%B1%203.0%20Ma,%20and%20the%20age%20of%20the%20Frasnian-Famennian%20boundary%20is%20recalculated%20to%20376.7%20%C2%B1%203.0%20Ma.%20These%20new%20absolute%20ages%20take%20into%20account%20the%20astronomically%20derived%20duration%20of%20the%20Frasnian,%20but%20they%20also%20yield%20a%20narrowing%20of%20the%20error%20margins%20of%20the%20absolute%20ages%20by%20several%20hundreds%20of%20thousands%20of%20years.}}

