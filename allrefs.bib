@article{JOLLY1972a,
	annote = {10.1093/petrology/13.2.273},
	author = {Jolly, WAYNE T. and Smith, RAYMOND E.},
	date = {1972/06/01},
	date-added = {2012-02-09 18:04:19 +0000},
	date-modified = {2012-10-29 20:46:18 +0000},
	journal = {Journal of Petrology},
	journal1 = {Journal of Petrology},
	month = {06},
	number = {2},
	pages = {273--309},
	title = {Degradation and Metamorphic Differentiation of the Keweenawan Tholeiitic Lavas of Northern Michigan, U.S.A.},
	ty = {JOUR},
	volume = {13},
	year = {1972},
	bdsk-url-1 = {http://petrology.oxfordjournals.org/content/13/2/273.abstract%20N2%20-%20The%20Portage%20Lake%20Lava%20Series%20of%20the%20Keweenaw%20Peninsula,%20northern%20Michigan,%20is%20composed%20of%20over%205000%20m%20of%20tholeiitic%20lava%20flows.%20Chemical%20and%20petrologic%20study%20of%20thin%20undifferentiated%20flows%20from%20this%20sequence%20shows%20that%20the%20bulk%20of%20the%20flows%20are%20olivine%20tholeiites;%20highly%20ironenriched%20tholeiites%20comprise%20up%20to%2010%20per%20cent%20of%20the%20volume.%20In%20addition,%20a%20few%20small%20rhyolitic%20intrusives,%20exceedingly%20rich%20in%20alkalis,%20are%20exposed%20in%20the%20region.%20During%20burial%20the%20amygdular%20tops%20of%20each%20flow%20acted%20as%20channelways%20for%20migrating%20fluids%20during%20a%20regional%20metamorphic%20event%20that%20produced%20a%20progressive%20sequence%20of%20secondary%20phases%20within%20the%20flow%20tops.%20In%20the%20upper%20part%20of%20the%20stratigraphic%20section,%20laumontite,%20analcime,%20albite,%20and%20chlorite%20dominate%20assemblages%20characteristic%20of%20the%20zeolite%20facies.%20Stratigraphically%20deeper.%20flow%20tops%20are%20characterized%20by%20metamorphic%20assemblages%20of%20the%20prehnite-pumpellyite%20facies.%20Within%20the%20higher%20rank%20facies,%20rocks%20along%20fractures%20have%20been%20transformed%20to%20calcium-rich%20monomineralic%20domains%20(metadomains)%20of%20epidote%20or%20pumpellyite.%20These%20metadomains%20grade%20outward%20through%20incompletely%20reconstituted%20rocks%20containing%20albitized%20feldspars,%20and%20finally,%20in%20flow%20centers,%20to%20basalt%20displaying%20few%20signs%20of%20mineralogical%20readjustment.%20Extreme%20chemical%20disparity%20exists%20within%20the%20altered%20flow%20tops,%20particularly%20with%20respect%20to%20calcium%20and%20sodium%20content.%20Calculations%20reveal%20that%20bulk%20compositions%20of%20metamorphically%20adjusted%20flow%20tops%20are%20similar%20to%20unaltered%20basalts.%20Thus,%20the%20chemical%20variation%20displayed%20by%20the%20metamorphic%20rock%20types%20resulted%20from%20localized%20metamorphic%20differentiation.The%20Keweenawan%20sequence%20displays%20progressive%20dehydration%20from%20the%20top%20to%20the%20base%20of%20the%20stratigraphic%20section.%20At%20the%20top%20chlorite%20(H2O%20=%2012%20per%20cent)%20and%20pumpellyite%20(H2O%20=%206%20per%20cent)%20metadomains%20formed%20by%20dehydration.%20The%20fact%20that%20most%20of%20these%20rocks%20were%20hydrated%20strongly%20suggests%20that%20fluid%20pressures%20were%20less%20than%20total%20pressures%20during%20the%20metamorphic%20event.%20In%20rocks%20undergoing%20hydration%20in%20the%20uper%20part%20of%20the%20stratigraphic%20section,%20therefore,%20water%20pressures%20decreased%20away%20from%20channelways.%20As%20a%20result,%20the%20most%20hydrous%20rock%20types%20formed%20in%20these%20regions.%20Conversely,%20in%20rock%20undergoing%20dehydration%20water%20pressures%20increased%20away%20from%20channelwasys,%20so%20that%20the%20most%20dehydrated%20rocks%20formed%20in%20such%20regions.%20Water%20content%20of%20an%20individual%20rock%20is%20dependent%20on%20both%20position%20in%20the%20stratigraphic%20pile%20and%20position%20with%20respect%20to%20fluid%20channelways.}}

