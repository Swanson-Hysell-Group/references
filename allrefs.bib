	date = {2011/04/19},
	date-added = {2011-04-19 18:17:59 -0400},
	date-modified = {2012-10-29 20:46:19 +0000},
	journal = {Proceedings of the National Academy of Sciences},
	journal1 = {Proceedings of the National Academy of Sciences},
	month = {04},
	number = {16},
	pages = {6386--6389},
	title = {Magnetic evidence for a partially differentiated carbonaceous chondrite parent body},
	ty = {JOUR},
	volume = {108},
	year = {2011},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://www.pnas.org/content/108/16/6386.abstract%20N2%20-%20The%20textures%20of%20chondritic%20meteorites%20demonstrate%20that%20they%20are%20not%20the%20products%20of%20planetary%20melting%20processes.%20This%20has%20long%20been%20interpreted%20as%20evidence%20that%20chondrite%20parent%20bodies%20never%20experienced%20large-scale%20melting.%20As%20a%20result,%20the%20paleomagnetism%20of%20the%20CV%20carbonaceous%20chondrite%20Allende,%20most%20of%20which%20was%20acquired%20after%20accretion%20of%20the%20parent%20body,%20has%20been%20a%20long-standing%20mystery.%20The%20possibility%20of%20a%20core%20dynamo%20like%20that%20known%20for%20achondrite%20parent%20bodies%20has%20been%20discounted%20because%20chondrite%20parent%20bodies%20are%20assumed%20to%20be%20undifferentiated.%20Resolution%20of%20this%20conundrum%20requires%20a%20determination%20of%20the%20age%20and%20timescale%20over%20which%20Allende%20acquired%20its%20magnetization.%20Here,%20we%20report%20that%20Allende%E2%80%99s%20magnetization%20was%20acquired%20over%20several%20million%20years%20(Ma)%20during%20metasomatism%20on%20the%20parent%20planetesimal%20in%20a%20%3E%20%20%E2%88%BC%2020%20%CE%BCT%20field%20up%20to%20approximately%209%E2%80%9410%20Ma%20after%20solar%20system%20formation.%20This%20field%20was%20present%20too%20recently%20and%20directionally%20stable%20for%20too%20long%20to%20have%20been%20generated%20by%20the%20protoplanetary%20disk%20or%20young%20Sun.%20The%20field%20intensity%20is%20in%20the%20range%20expected%20for%20planetesimal%20core%20dynamos,%20suggesting%20that%20CV%20chondrites%20are%20derived%20from%20the%20outer,%20unmelted%20layer%20of%20a%20partially%20differentiated%20body%20with%20a%20convecting%20metallic%20core.},
	bdsk-url-2 = {http://www.pnas.org/content/108/16/6386.abstract%20N2%20-%20The%20textures%20of%20chondritic%20meteorites%20demonstrate%20that%20they%20are%20not%20the%20products%20of%20planetary%20melting%20processes.%20This%20has%20long%20been%20interpreted%20as%20evidence%20that%20chondrite%20parent%20bodies%20never%20experienced%20large-scale%20melting.%20As%20a%20result,%20the%20paleomagnetism%20of%20the%20CV%20carbonaceous%20chondrite%20Allende,%20most%20of%20which%20was%20acquired%20after%20accretion%20of%20the%20parent%20body,%20has%20been%20a%20long-standing%20mystery.%20The%20possibility%20of%20a%20core%20dynamo%20like%20that%20known%20for%20achondrite%20parent%20bodies%20has%20been%20discounted%20because%20chondrite%20parent%20bodies%20are%20assumed%20to%20be%20undifferentiated.%20Resolution%20of%20this%20conundrum%20requires%20a%20determination%20of%20the%20age%20and%20timescale%20over%20which%20Allende%20acquired%20its%20magnetization.%20Here,%20we%20report%20that%20Allende%E2%80%99s%20magnetization%20was%20acquired%20over%20several%20million%20years%20(Ma)%20during%20metasomatism%20on%20the%20parent%20planetesimal%20in%20a%20%3E%20%E2%88%BC%2020%20%CE%BCT%20field%20up%20to%20approximately%209%E2%80%9410%20Ma%20after%20solar%20system%20formation.%20This%20field%20was%20present%20too%20recently%20and%20directionally%20stable%20for%20too%20long%20to%20have%20been%20generated%20by%20the%20protoplanetary%20disk%20or%20young%20Sun.%20The%20field%20intensity%20is%20in%20the%20range%20expected%20for%20planetesimal%20core%20dynamos,%20suggesting%20that%20CV%20chondrites%20are%20derived%20from%20the%20outer,%20unmelted%20layer%20of%20a%20partially%20differentiated%20body%20with%20a%20convecting%20metallic%20core.}}

