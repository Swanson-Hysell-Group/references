@article{McCabe1994a,
	abstract = {Samples of Lower Carboniferous Chatburn and Pendleside limestones collected from 27 sites in the Craven Basin (northern England) carry a syn-Hercynian remagnetization residing in magnetite. The paleomagnetic directions are all of reversed polarity consistent with a Kiaman Superchron remagnetization. The partially (62{\%}) tilt corrected mean direction has the minimum correlation statistic implying a synfolding magnetization. The resulting pole appears to be Late Carboniferous in age, and there is no indication of any magnetization component that predates the remagnetization event. The magnetization appears to be of the same type as the synfolding remagnetizations documented in several Appalachian carbonate units. Jackson (1990) reported that remagnetized Appalachian carbonates have distinctive hysteresis properties, and we have obtained similar hysteresis loops from remagnetized Paleozoic carbonates from the Craven Basin (England), the Great Basin (Nevada), Alaska, and New York State. The hysteresis loops are all \&{\#}8220;wasp-waisted\&{\#}8221; and yield highly anomalous hysteresis ratios, compared to data from synthetic or \&{\#}8220;typical\&{\#}8221; magnetite-bearing samples. In contrast, unremagnetized limestones from Italy show hysteresis behavior which is more typical for magnetite-bearing rocks (Channell and McCabe, this issue). These results suggest that remagnetization in magnetite-bearing carbonates can be readily detected on the basis of hysteresis properties, prior to a full-scale paleomagnetic investigation.},
	author = {McCabe, Chad and Channell, J. E. T.},
	date-added = {2011-01-20 09:57:44 -0500},
	date-modified = {2011-03-18 12:36:20 -0400},
	do = {10.1029/93JB02802},
	isbn = {0148-0227},
	journal = {J. Geophys. Res.},
	number = {B3},
	pages = {4603--4612},
	publisher = {AGU},
	title = {{Late Paleozoic remagnetization in limestones of the Craven Basin (northern England) and the rock magnetic fingerprint of remagnetized sedimentary carbonates}},
	ty = {JOUR},
	volume = {99},
	year = {1994},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://dx.doi.org/10.1029/93JB02802}}

