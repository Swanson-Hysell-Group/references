@article{Liniecki-Laporte1988a,
	annote = {10.1130/0091-7613(1988)016<0216:PNCOLM>2.3.CO;2},
	author = {Liniecki-Laporte, Margaret and Andersen, David W.},
	date-added = {2013-03-02 05:34:01 +0000},
	date-modified = {2013-03-02 05:34:01 +0000},
	journal = {Geology},
	journal1 = {Geology},
	number = {3},
	pages = {216--220},
	title = {Possible new constraints on late Miocene depositional patterns in west-central California},
	ty = {JOUR},
	url = {http://geology.gsapubs.org/content/16/3/216.abstract N2 - In the San Francisco Bay area, estuarine, lacustrine, and fluvial depositional environments existed contemporaneously within the Mulholland Formation, which was deposited in the Contra Costa basin from 7.7 to 6.5 Ma. The estuarine facies is differentiated from the nonmarine facies on the bases of ostracodes and sedimentology. Presence of the estuarine facies in the Mulholland Formation demonstrates that the Contra Costa basin was at sea level, the western part of the basin being a marine embayment for about 1 m.y. Absence of fresh Sierra Nevada-derived material in the lower Mulholland Formation indicates that a topographically elevated area existed east of the Contra Costa basin, effectively deflecting the Sierran debris, which is represented by the coeval Neroly Formation found in the eastern central Coast Ranges. To the west of the Contra Costa basin, some gaps in the Coast Ranges allowed connection with the Pacific Ocean.},
	volume = {16},
	year = {March, 1988},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://geology.gsapubs.org/content/16/3/216.abstract%20N2%20-%20In%20the%20San%20Francisco%20Bay%20area,%20estuarine,%20lacustrine,%20and%20fluvial%20depositional%20environments%20existed%20contemporaneously%20within%20the%20Mulholland%20Formation,%20which%20was%20deposited%20in%20the%20Contra%20Costa%20basin%20from%207.7%20to%206.5%20Ma.%20The%20estuarine%20facies%20is%20differentiated%20from%20the%20nonmarine%20facies%20on%20the%20bases%20of%20ostracodes%20and%20sedimentology.%20Presence%20of%20the%20estuarine%20facies%20in%20the%20Mulholland%20Formation%20demonstrates%20that%20the%20Contra%20Costa%20basin%20was%20at%20sea%20level,%20the%20western%20part%20of%20the%20basin%20being%20a%20marine%20embayment%20for%20about%201%20m.y.%20Absence%20of%20fresh%20Sierra%20Nevada-derived%20material%20in%20the%20lower%20Mulholland%20Formation%20indicates%20that%20a%20topographically%20elevated%20area%20existed%20east%20of%20the%20Contra%20Costa%20basin,%20effectively%20deflecting%20the%20Sierran%20debris,%20which%20is%20represented%20by%20the%20coeval%20Neroly%20Formation%20found%20in%20the%20eastern%20central%20Coast%20Ranges.%20To%20the%20west%20of%20the%20Contra%20Costa%20basin,%20some%20gaps%20in%20the%20Coast%20Ranges%20allowed%20connection%20with%20the%20Pacific%20Ocean.}}

