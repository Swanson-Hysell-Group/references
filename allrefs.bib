@article{BARNETT1970a,
	annote = {10.1130/0016-7606(1970)81{$[$}2375:UCAHSO{$]$}2.0.CO;2},
	author = {BARNETT, STOCKTON GORDON},
	date = {1970/08/01},
	date-added = {2011-04-08 19:07:05 -0400},
	date-modified = {2012-10-29 20:46:19 +0000},
	journal = {Geological Society of America Bulletin},
	journal1 = {Geological Society of America Bulletin},
	month = {08},
	number = {8},
	pages = {2375--2402},
	title = {Upper Cayugan and Helderbergian Stratigraphy of Southeastern New York and Northern New Jersey},
	ty = {JOUR},
	volume = {81},
	year = {1970},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://gsabulletin.gsapubs.org/content/81/8/2375.abstract%20N2%20-%20Study%20of%20stratigraphic%20sections%20in%20the%20Green%20Pond-Schunemunk%20Mountain%20outlier%20and%20along%20the%20main%20Silurian-Devonian%20outcrop%20belt%2025%20mi%20to%20the%20northwest%20has%20resulted%20in%20alteration%20and%20refinement%20of%20regional%20stratigraphic%20relations%20of%20Upper%20Cayugan%20and%20Helderbergian%20strata%20in%20southeastern%20New%20York%20and%20northern%20New%20Jersey.%20Many%20well-established%20stratigraphic%20units%20of%20New%20York%20and%20eastern%20Pennsylvania%20can%20be%20recognized%20in%20the%20outlier.%20Two%20new%20units%20in%20the%20outlier%20are%20here%20proposed%E2%80%94the%20Berkshire%20Valley%20Formation%20and%20the%20Orrs%20Mills%20Member%20of%20the%20Rondout%20Formation.%20A%20tentative%20paleoenvironmental%20analysis%20has%20resulted%20in%20the%20recognition%20of%20eight%20facies:%20fluvial%20redbed;%20supralittoral;%20littoral%20lagoonal;%20sublittoral%20lagoonal;%20biostromal%20reef;%20shallow%20sublittoral%20(crinoidal%20meadow%20and%20sandstone);%20intermediate%20sublittoral;%20and%20deep%20sublittoral%20arranged%20in%20basinward%20order.%20Seven%20recognizable%20time%20horizons%20were%20used%20in%20the%20establishment%20of%20stratigraphic%20correlations.%20The%20approximate%20geographic%20distribution%20of%20paleoenvironments%20at%20eight%20successive%20horizons%20during%20the%20late%20Cayugan%20and%20Helderbergian%20are%20shown%20on%20a%20series%20of%20lithofacies-paleoenvironmental%20maps.%20It%20can%20be%20inferred%20from%20these%20maps%20that%20the%20report%20area%20was%20situated%20on%20the%20eastern%20side%20of%20a%20generally%20deepening%20northern%20Appalachian%20basin.%20The%20northeast-trending%20shoreline%20was%20predominantly%20located%20within%20the%20report%20area,%20but%20at%20times%20receded%20to%20the%20west%20or%20advanced%20to%20the%20east.%20A%20sediment%20source%20was%20continually%20active%20in%20eastern%20Pennsylvania%20south%20of%20the%20main%20outcrop%20belt,%20whereas%20a%20source%20east%20of%20the%20northern%20portion%20of%20the%20outlier%20was%20active%20only%20during%20the%20late%20Helderbergian.%20During%20the%20deposition%20of%20the%20Berkshire%20Valley%20Formation,%20the%20southern%20part%20of%20the%20outlier%20appears%20to%20have%20acted%20as%20a%20strait%20that%20connected%20the%20northern%20Appalachian%20basin%20to%20a%20sea%20located%20to%20the%20south-east.%20The%20southern%20part%20of%20the%20outlier%20was%20subjected%20to%20rather%20extensive%20pre-Oriskany%20(Deerparkian)%20erosion,%20whereas%20pre-Oriskany%20erosion%20in%20the%20northern%20outlier%20was%20considerably%20less.%20On%20the%20other%20hand,%20deposition%20continued%20uninterrupted%20along%20the%20main%20outcrop%20belt%20throughout%20late%20Cayugan,%20Helderbergian,%20and%20Deerparkian%20time.}}

