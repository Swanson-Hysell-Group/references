@article{Linder2012a,
	abstract = {Secular variation, the change in the Earth's magnetic field through time, reflects the energy state of the geodynamo. Secular variation is commonly quantified by paleomagnetists as the standard deviation of the angular distances of the virtual geomagnetic poles to their mean pole, known as the S value. This parameter has long been thought to exhibit latitude dependence {$[$}S(\&{\#}955;){$]$}, whose origin is widely attributed to a combination of time-varying dipole and non-dipole components. The slope and magnitude of S(\&{\#}955;) are taken as a basis to understand the geomagnetic field and its evolution. Here we show that S(\&{\#}955;) stems from a mathematical aberration of the conversion from directions to poles, hence directional populations better quantify local estimates of paleosecular variation.},
	author = {Linder, Julia and Gilder, Stuart A.},
	date = {2012/01/28},
	date-added = {2012-01-27 23:57:25 +0000},
	date-modified = {2012-10-29 20:46:18 +0000},
	isbn = {0094-8276},
	journal = {Geophys. Res. Lett.},
	keywords = {geomagnetism; paleomagnetism; 1522 Geomagnetism and Paleomagnetism: Paleomagnetic secular variation; 1560 Geomagnetism and Paleomagnetism: Time variations: secular and longer},
	month = {01},
	number = {2},
	publisher = {AGU},
	sp = {L02308},
	title = {Latitude dependency of the geomagnetic secular variation S parameter: A mathematical artifact},
	ty = {JOUR},
	volume = {39},
	year = {2012},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://dx.doi.org/10.1029/2011GL050330}}

