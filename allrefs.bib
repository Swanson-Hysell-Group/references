@article{Petterson2011a,
	annote = {10.1130/B30281.1},
	author = {Petterson, R. and Prave, A. R. and Wernicke, B. P. and Fallick, A. E.},
	date = {2011/07/01},
	date-added = {2011-06-04 13:43:30 -0400},
	date-modified = {2012-10-29 20:46:19 +0000},
	journal = {Geological Society of America Bulletin},
	journal1 = {Geological Society of America Bulletin},
	month = {07},
	number = {7-8},
	pages = {1317--1336},
	title = {The Neoproterozoic Noonday Formation, Death Valley region, California},
	ty = {JOUR},
	volume = {123},
	year = {2011},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://gsabulletin.gsapubs.org/content/123/7-8/1317.abstract%20N2%20-%20The%20Neoproterozoic%E2%80%93Cambrian%20succession%20in%20the%20Death%20Valley%20region%20of%20the%20southwestern%20United%20States%20is%20among%20the%20best%20exposed%20and%20easily%20accessible%20in%20the%20world.%20The%20largest%20single%20exposure%20of%20these%20strata%20occurs%20in%20the%20Panamint%20Range%20on%20the%20west%20side%20of%20Death%20Valley,%20and%20it,%20although%20variably%20metamorphosed,%20contains%20the%20most%20complete%20sections%20of%20the%20Noonday%20Formation%20cap%20carbonate%20sequence.%20New%20geological%20mapping,%20measured%20sections,%20and%20high-resolution%20carbon%20isotope%20data%20for%20the%20Noonday%20Formation%20in%20this%20range%20enable%20establishment%20of%20a%20unified%20stratigraphy%20across%20the%20Death%20Valley%20region%20that%20consists%20of%20three%20units.%20From%20the%20base%20upward,%20they%20include:%20the%20Sentinel%20Peak%20Member%20of%20light-gray,%20massive%20to%20laminated%20fine%20dolostone%20locally%20containing%20vugs%20and%20tubes%20variably%20filled%20with%20micrite,%20spar,%20or%20quartz%20(and%20rarely%20galena),%20and%20varying%20from%202%20to%20200%20m%20in%20thickness;%20the%20Radcliff%20Member,%20composed%20of%20feldspathic%20shale%20and%20sandstone%20and%20thin-bedded%20limestone,%200%E2%80%93200%20m%20thick;%20and%20the%20newly%20defined%20Mahogany%20Flats%20Member%20of%20gray,%20commonly%20stromatolitic,%20thin-%20to%20medium-bedded%20fine%20dolostone%20that%20is%20%E2%88%BC200%20m%20thick%20at%20its%20type%20locality.Carbon%20isotopic%20trends%20in%20the%20Panamint%20Range%20match%20to%20within%201%E2%80%B0%E2%80%932%E2%80%B0%20reproducibility%20those%20known%20for%20the%20equivalent%20nonmetamorphosed%20strata%20in%20the%20eastern%20Death%20Valley%20sections.%20A%20composite%20section%20of%20the%20Noonday%20Formation%20displays%20a%20chemostratigraphic%20profile%20with%20values%20near%20%E2%88%923%E2%80%B0%20through%20the%20cap%20dolostone%20of%20the%20Sentinel%20Peak%20Member,%20a%20decline%20to%20%E2%88%926%E2%80%B0%20in%20the%20lower%20part%20of%20the%20Radcliff%20Member,%20followed%20by%20a%20recovery%20to%20near%200%E2%80%B0%20and%20subsequent%20decline%20toward%20%E2%88%922%E2%80%B0%20in%20the%20remainder%20of%20the%20Radcliff%20units%20and%20lower%20Mahogany%20Flats%20Member,%20and%20then%20a%20return%20to%20positive%20values%20(4%E2%80%B0)%20through%20the%20remainder%20of%20the%20Mahogany%20Flats%20Member.%20This%20pattern%20matches%20the%20Ediacaran%20cap%20carbonate%20in%20Namibia%20remarkably%20well,%20and,%20assuming%20our%20carbon%20isotopic%20correlations%20are%20correct,%20it%20indicates%20that%20Noonday%20deposition%20occurred%20at%20the%20beginning%20of%20the%20Ediacaran%20Period,%20and%20that%20the%20immediately%20underlying%20Wildrose%20Diamictite%20of%20the%20Kingston%20Peak%20Formation%20probably%20represents%20the%20younger%20Cryogenian%20(Marinoan)%20glacial%20episode.}}

@article{Verdel2011a,
	annote = {10.1130/B30369.1},
	author = {Verdel, Charles and Wernicke, Brian P. and Bowring, Samuel A.},
	date = {2011/07/01},
	date-added = {2011-06-04 13:39:33 -0400},
	date-modified = {2012-10-29 20:46:19 +0000},
	journal = {Geological Society of America Bulletin},
	journal1 = {Geological Society of America Bulletin},
	month = {07},
	number = {7-8},
	pages = {1539--1559},
	title = {The Shuram and subsequent Ediacaran carbon isotope excursions from southwest Laurentia, and implications for environmental stability during the metazoan radiation},
	ty = {JOUR},
	volume = {123},
	year = {2011},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://gsabulletin.gsapubs.org/content/123/7-8/1539.abstract%20N2%20-%20Current%20understanding%20of%20secular%20changes%20in%20the%20carbon%20isotopic%20composition%20of%20mid-%20to%20late%20Ediacaran%20carbonates%20suggests%20a%20relatively%20long,%20steady%20recovery%20of%20the%20global%20ocean%20from%20the%20Shuram%20negative%20excursion,%20followed%20by%20a%20smaller%20negative%20excursion%20at%20the%20Precambrian-Cambrian%20boundary.%20New%20radiometric,%20stratigraphic,%20and%20carbon%20isotope%20data%20from%20thick%20exposures%20of%20the%20upper%20Johnnie%20Formation%20in%20the%20Panamint%20Range%20of%20eastern%20California,%20combined%20with%20data%20from%20carbonate-rich%20facies%20of%20the%20Stirling%20Quartzite%20in%20the%20Funeral%20Mountains,%20confirm%20an%20Ediacaran%20age%20for%20these%20strata%20and%20provide%20a%20more%20complete%20record%20of%20isotopic%20variations%20during%20this%20time%20interval%20than%20previously%20determined%20from%20SW%20Laurentia%20and%20other%20key%20sections%20around%20the%20globe.%20A%20siltstone%20in%20the%20lower%20part%20of%20the%20Johnnie%20Formation%20yielded%20a%20detrital%20zircon%20grain%20with%20an%20age%20of%20640.33%20%C2%B1%200.09%20Ma,%20lowering%20the%20maximum%20radiometric%20age%20constraint%20on%20the%20Johnnie%20Formation%20by%20%3E400%20m.y.,%20consistent%20with%20an%20Ediacaran%20age%20based%20on%20chemo-%20and%20biostratigraphic%20data.%20In%20contrast%20to%20previous%20C%20isotope%20compilations%20from%20this%20region,%20which%20were%20generally%20based%20on%20relatively%20thin%20portions%20of%20the%20Cordilleran%20miogeocline%20near%20its%20depositional%20hinge,%20the%20more%20basinward%20exposures%20exhibit%20a%20recovery%20from%20values%20near%20%E2%80%9312%E2%80%B0%20to%200%E2%80%B0%20within%20the%20upper%20part%20of%20the%20Johnnie%20Formation.%20Details%20in%20the%20shape%20of%20the%20chemostratigraphic%20profile%20through%20the%20upper%20Johnnie%20Formation%20closely%20match%20those%20in%20profiles%20through%20the%20Wonoka%20Formation%20in%20South%20Australia%20(which%20lies%20above%20the%20basal%20Ediacaran%20global%20stratotype%20section%20and%20point)%20and%20the%20Shuram-Buah%20interval%20in%20Oman,%20confirming%20temporal%20correlation%20and%20suggesting%20genesis%20through%20changes%20in%20the%20isotopic%20composition%20of%20the%20global%20ocean.%20The%20Shuram%20excursion%20in%20SW%20Laurentia%20is%20followed%20by%20at%20least%20three%20smaller%20Ediacaran%20to%20earliest%20Cambrian%20isotopic%20excursions%20recorded%20within,%20from%20oldest%20to%20youngest,%20the%20uppermost%20Johnnie%20Formation,%20the%20middle%20Stirling%20Quartzite,%20and%20the%20lower%20Wood%20Canyon%20Formation.%20These%20data%20indicate%20that%20the%20negative%20excursion%20associated%20with%20the%20base%20of%20the%20Cambrian%20is%20not%20a%20unique%20post-Shuram%20event,%20and%20that%20post-Shuram,%20pre-Cambrian%20animal%20evolution%20occurred%20in%20an%20environment%20of%20repeated%20large-magnitude%20fluctuations%20in%20the%20carbon%20isotopic%20composition%20of%20the%20global%20ocean.}}

@article{Jones2011a,
	annote = {10.1130/B30323.1},
	author = {Jones, David S. and Fike, David A. and Finnegan, Seth and Fischer, Woodward W. and Schrag, Daniel P. and McCay, Dwight},
	date = {2011/07/01},
	date-added = {2011-06-04 13:10:00 -0400},
	date-modified = {2012-10-29 20:46:19 +0000},
	journal = {Geological Society of America Bulletin},
	journal1 = {Geological Society of America Bulletin},
	month = {07},
	number = {7-8},
	pages = {1645--1664},
	title = {Terminal Ordovician carbon isotope stratigraphy and glacioeustatic sea-level change across Anticosti Island (Qu{\'e}bec, Canada)},
	ty = {JOUR},
	volume = {123},
	year = {2011},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://gsabulletin.gsapubs.org/content/123/7-8/1645.abstract%20N2%20-%20Globally%20documented%20carbon%20isotope%20excursions%20provide%20time-varying%20signals%20that%20can%20be%20used%20for%20high-resolution%20stratigraphic%20correlation.%20We%20report%20detailed%20inorganic%20and%20organic%20carbon%20isotope%20curves%20from%20carbonate%20rocks%20of%20the%20Ellis%20Bay%20and%20Becscie%20Formations%20spanning%20the%20Ordovician-Silurian%20boundary%20on%20Anticosti%20Island,%20Qu%C3%A9bec,%20Canada.%20Strata%20of%20the%20Anticosti%20Basin%20record%20the%20development%20of%20a%20storm-dominated%20tropical%20carbonate%20ramp.%20These%20strata%20host%20the%20well-known%20Hirnantian%20positive%20carbon%20isotope%20excursion,%20which%20attains%20maximum%20values%20of%20%E2%88%BC4.5%E2%80%B0%20in%20carbonate%20carbon%20of%20the%20Laframboise%20Member%20or%20the%20Fox%20Point%20Member%20of%20the%20Becscie%20Formation.%20The%20excursion%20also%20occurs%20in%20organic%20carbon,%20and%20%CE%B413Ccarb%20and%20%CE%B413Corg%20values%20covary%20such%20that%20no%20reproducible%20%CE%9413C%20(=%20%CE%B413Ccarb%20%E2%80%93%20%CE%B413Corg)%20excursion%20is%20observed.%20The%20most%20complete%20stratigraphic%20section,%20at%20Laframboise%20Point%20in%20the%20west,%20shows%20the%20characteristic%20shape%20of%20the%20Hirnantian%20Stage%20excursion%20at%20the%20global%20stratotype%20section%20and%20point%20(GSSP)%20for%20the%20Hirnantian%20Stage%20in%20China%20and%20the%20Silurian%20System%20in%20Scotland.%20We%20therefore%20suggest%20that%20the%20entire%20Hirnantian%20Stage%20on%20Anticosti%20Island%20is%20confined%20to%20the%20Laframboise%20and%20lower%20Fox%20Point%20Members.By%20documenting%20discontinuities%20in%20the%20architecture%20of%20the%20carbon%20isotope%20curve%20at%20multiple%20stratigraphic%20sections%20spanning%20a%20proximal%20to%20distal%20transect%20across%20the%20sedimentary%20basin,%20we%20are%20able%20to%20reconstruct%20glacioeustatic%20sea-level%20fluctuations%20corresponding%20to%20maximum%20glacial%20conditions%20associated%20with%20the%20end-Ordovician%20ice%20age.%20The%20combined%20litho-%20and%20chemostratigraphic%20approach%20provides%20evidence%20for%20the%20diachroneity%20of%20the%20oncolite%20bed%20and%20Becscie%20limestones;%20the%20former%20transgresses%20from%20west%20to%20east,%20and%20the%20latter%20progrades%20from%20east%20to%20west.%20The%20sea-level%20curve%20consistent%20with%20our%20sequence-stratigraphic%20model%20indicates%20that%20glacioeustatic%20sea-level%20changes%20and%20the%20positive%20carbon%20isotope%20excursion%20were%20not%20perfectly%20coupled.%20Although%20the%20start%20of%20the%20isotope%20excursion%20and%20the%20initial%20sea-level%20drawdown%20were%20coincident,%20the%20peak%20of%20the%20isotope%20excursion%20did%20not%20occur%20until%20after%20sea%20level%20had%20begun%20to%20rise.%20Carbon%20isotope%20values%20did%20not%20return%20to%20baseline%20until%20well%20after%20the%20Anticosti%20ramp%20was%20reflooded.%20The%20sea-level%E2%80%93%CE%B413Ccarb%20relationship%20proposed%20here%20is%20consistent%20with%20the%20%E2%80%9Cweathering%E2%80%9D%20hypothesis%20for%20the%20origin%20of%20the%20Hirnantian%20%CE%B413Ccarb%20excursion.}}

