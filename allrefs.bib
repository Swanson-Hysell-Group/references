@article{Sweetkind2011a,
	annote = {10.1130/GES00625.1},
	author = {Sweetkind, Donald S. and Rytuba, James J. and Langenheim, Victoria E. and Fleck, Robert J.},
	date = {2011/06/01},
	date-added = {2016-12-17 18:07:37 +0000},
	date-modified = {2016-12-17 18:07:37 +0000},
	journal = {Geosphere},
	journal1 = {Geosphere},
	month = {06},
	number = {3},
	pages = {629--657},
	title = {Geology and geochemistry of volcanic centers within the eastern half of the Sonoma volcanic field, northern San Francisco Bay region, California},
	ty = {JOUR},
	url = {http://geosphere.gsapubs.org/content/7/3/629.abstract N2 - Volcanic rocks in the Sonoma volcanic field in the northern California Coast Ranges contain heterogeneous assemblages of a variety of compositionally diverse volcanic rocks. We have used field mapping, new and existing age determinations, and 343 new major and trace element analyses of whole-rock samples from lavas and tuff to define for the first time volcanic source areas for many parts of the Sonoma volcanic field. Geophysical data and models have helped to define the thickness of the volcanic pile and the location of caldera structures. Volcanic rocks of the Sonoma volcanic field show a broad range in eruptive style that is spatially variable and specific to an individual eruptive center. Major, minor, and trace-element geochemical data for intracaldera and outflow tuffs and their distal fall equivalents suggest caldera-related sources for the Pinole and Lawlor Tuffs in southern Napa Valley and for the tuff of Franz Valley in northern Napa Valley. Stratigraphic correlations based on similarity in eruptive sequence and style coupled with geochemical data allow an estimate of 30 km of right-lateral offset across the West Napa-Carneros fault zones since ∼5 Ma.The volcanic fields in the California Coast Ranges north of San Francisco Bay are temporally and spatially associated with the northward migration of the Mendocino triple junction and the transition from subduction and associated arc volcanism to a slab window tectonic environment. Our geochemical analyses from the Sonoma volcanic field highlight the geochemical diversity of these volcanic rocks, allowing us to clearly distinguish these volcanic rocks from those of the roughly coeval ancestral Cascades magmatic arc to the west, and also to compare rocks of the Sonoma volcanic field to rocks from other slab window settings.},
	volume = {7},
	year = {2011},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://geosphere.gsapubs.org/content/7/3/629.abstract%20N2%20-%20Volcanic%20rocks%20in%20the%20Sonoma%20volcanic%20field%20in%20the%20northern%20California%20Coast%20Ranges%20contain%20heterogeneous%20assemblages%20of%20a%20variety%20of%20compositionally%20diverse%20volcanic%20rocks.%20We%20have%20used%20field%20mapping,%20new%20and%20existing%20age%20determinations,%20and%20343%20new%20major%20and%20trace%20element%20analyses%20of%20whole-rock%20samples%20from%20lavas%20and%20tuff%20to%20define%20for%20the%20first%20time%20volcanic%20source%20areas%20for%20many%20parts%20of%20the%20Sonoma%20volcanic%20field.%20Geophysical%20data%20and%20models%20have%20helped%20to%20define%20the%20thickness%20of%20the%20volcanic%20pile%20and%20the%20location%20of%20caldera%20structures.%20Volcanic%20rocks%20of%20the%20Sonoma%20volcanic%20field%20show%20a%20broad%20range%20in%20eruptive%20style%20that%20is%20spatially%20variable%20and%20specific%20to%20an%20individual%20eruptive%20center.%20Major,%20minor,%20and%20trace-element%20geochemical%20data%20for%20intracaldera%20and%20outflow%20tuffs%20and%20their%20distal%20fall%20equivalents%20suggest%20caldera-related%20sources%20for%20the%20Pinole%20and%20Lawlor%20Tuffs%20in%20southern%20Napa%20Valley%20and%20for%20the%20tuff%20of%20Franz%20Valley%20in%20northern%20Napa%20Valley.%20Stratigraphic%20correlations%20based%20on%20similarity%20in%20eruptive%20sequence%20and%20style%20coupled%20with%20geochemical%20data%20allow%20an%20estimate%20of%2030%20km%20of%20right-lateral%20offset%20across%20the%20West%20Napa-Carneros%20fault%20zones%20since%20%E2%88%BC5%20Ma.The%20volcanic%20fields%20in%20the%20California%20Coast%20Ranges%20north%20of%20San%20Francisco%20Bay%20are%20temporally%20and%20spatially%20associated%20with%20the%20northward%20migration%20of%20the%20Mendocino%20triple%20junction%20and%20the%20transition%20from%20subduction%20and%20associated%20arc%20volcanism%20to%20a%20slab%20window%20tectonic%20environment.%20Our%20geochemical%20analyses%20from%20the%20Sonoma%20volcanic%20field%20highlight%20the%20geochemical%20diversity%20of%20these%20volcanic%20rocks,%20allowing%20us%20to%20clearly%20distinguish%20these%20volcanic%20rocks%20from%20those%20of%20the%20roughly%20coeval%20ancestral%20Cascades%20magmatic%20arc%20to%20the%20west,%20and%20also%20to%20compare%20rocks%20of%20the%20Sonoma%20volcanic%20field%20to%20rocks%20from%20other%20slab%20window%20settings.}}

@article{Thompson2010a,
	author = {Thompson, M. D. and Grunow, A. M. and Ramezani, J.},
	date = {2010/01/08},
	date-added = {2016-10-24 15:55:53 +0000},
	date-modified = {2017-01-06 18:00:11 +0000},
	doi = {10.1130/B26581.1},
	journal = {Geological Society of America Bulletin},
	journal1 = {Geological Society of America},
	lp = {88},
	month = {01},
	n2 = {Paleomagnetic measurements and U-Pb geochronology of alkalic igneous rocks intruding the Ediacaran Cambridge Argillite and the Lower Cambrian Weymouth Formation north of Boston at Nahant, Massachusetts yield a well-constrained paleopole. The oldest intrusive phases are a syenodiorite sill and a granite dike with 206Pb/238U crystallization ages of 490.19 $\pm$0.90 Ma and 489.03 $\pm$0.82 Ma, respectively. This sequence along with undated mafic sills penetrating both the argillite and Weymouth strata are cut by 488.53 $\pm$0.81 Ma gabbro locally associated with 488.48 $\pm$0.79 Ma syenite forming a steep-sided intrusive plug. Ten paleomagnetic sampling sites within the mafic sills and the gabbro contain a stable A magnetic component with a mean direction of D = 278.5$\,^{\circ}$, I = -76.7$\,^{\circ}$(A95 = 3.9$\,^{\circ}$, N = 10). This is considered to be the primary magnetization direction because it passes both fold and reversals tests. The corresponding paleopole at 320$\,^{\circ}$E, 34$\,^{\circ}$N (A95 = 7.2$\,^{\circ}$, N = 10) places the Southeastern New England Avalon Zone at a southerly paleolatitude of 65$\,^{\circ}$slightly removed from the African margin of Gondwana and suggests that bimodal Nahant magmatism is linked with latest Cambrian-Early Ordovician rifting of West Avalonia to form the Rheic Ocean.Stable B and C magnetic components in Nahant syenodiorite and syenite give rise to virtual geomagnetic poles that track Late Silurian through Carboniferous segments of the North American apparent polar wander path, indicating docking of West Avalonia by mid-Paleozoic time.{\copyright}2010 Geological Society of America},
	number = {1-2},
	pages = {76},
	title = {{Cambro-Ordovician paleogeography of the Southeastern New England Avalon Zone: Implications for Gondwana breakup}},
	ty = {JOUR},
	url = {http://gsabulletin.gsapubs.org/content/122/1-2/76.abstract},
	volume = {122},
	year = {2010},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://gsabulletin.gsapubs.org/content/122/1-2/76.abstract}}

@article{Cutts2012a,
	author = {Cutts, J. A. and Zagorevski, A. and McNicoll, V. and Carr, S. D.},
	date = {2012/01/01},
	date-added = {2016-10-24 15:45:10 +0000},
	date-modified = {2017-01-06 18:07:11 +0000},
	doi = {10.1139/E11-040},
	journal = {Canadian Journal of Earth Sciences},
	journal1 = {Can J Earth Sci},
	lp = {127},
	m3 = {10.1139/e11-040},
	month = {01},
	n2 = {The Moreton's Harbour Group lies along the Red Indian Line, the fundamental Iapetus suture that separates rocks of peri-Laurentian affinity with rocks of peri-Gondwanan affinity in the Newfoundland Appalachians. Characterization of age and environment of formation of the Moreton's Harbour Group is an important constraint on evolution of the Laurentian margin during Ordovician closure of Iapetus Ocean and associated marginal basins. The Moreton's Harbour Group comprises a fault-bounded ophiolitic sequence of layered gabbro, sheeted diabase, pillow basalt, and felsic intrusive rocks. It is offset by high-angle shear zones that were contemporaneous with a 477.4 $\pm$0.4 Ma syn-tectonic and syn-magmatic suite of trondhjemite and tonalite. Trace element data from the felsic suite indicate formation in a supra-subduction zone setting, although isotopic data from the felsic intrusive rocks (εNd (--5.02) to (--10.53), Tdm 1200--1800 Ma) indicate a significant amount of contamination from Mesoproterozoic or older continental crust. The age and tectonic setting of the Moreton's Harbour Group suggest that it is the northernmost extent of the ca. 480 Ma Annieopsquotch Ophiolite Belt. We present a model in which the Moreton's Harbour Group formed in response to propagation of the Annieopsquotch Ophiolite Belt spreading centre into the Dashwoods microcontinent. This ridge propagation model supports the formation of the Annieopsquotch Ophiolite Belt immediately outboard of Dashwoods and explains its rapid accretion to the composite Laurentian margin.},
	number = {1},
	pages = {111},
	title = {{Tectono-stratigraphic setting of the Moreton's Harbour Group and its implications for the evolution of the Laurentian margin: Notre Dame Bay, Newfoundland}},
	ty = {JOUR},
	url = {http://cjes.geoscienceworld.org/content/49/1/111.abstract},
	volume = {49},
	year = {2012},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://cjes.geoscienceworld.org/content/49/1/111.abstract}}

@article{Hibbard2000a,
	annote = {10.1130/0091-7613(2000)28<127:DCMAIT>2.0.CO;2},
	author = {Hibbard, James},
