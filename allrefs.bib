@article{Cawood2013a,
	author = {Cawood, Peter A. and Wang, Yuejun and Xu, Yajun and Zhao, Guochun},
	date = {2013/08/01},
	date-added = {2013-08-06 22:30:05 +0000},
	date-modified = {2015-05-27 05:26:06 +0000},
	doi = {10.1130/G34395.1},
	journal = {Geology},
	month = {08},
	number = {8},
	pages = {903--906},
	title = {{Locating South China in Rodinia and Gondwana: A fragment of greater India lithosphere?}},
	ty = {JOUR},
	volume = {41},
	year = {2013},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://geology.gsapubs.org/content/41/8/903.abstract%20N2%20-%20From%20the%20formation%20of%20Rodinia%20at%20the%20end%20of%20the%20Mesoproterozoic%20to%20the%20commencement%20of%20Pangea%20breakup%20at%20the%20end%20of%20the%20Paleozoic,%20the%20South%20China%20craton%20first%20formed%20and%20then%20occupied%20a%20position%20adjacent%20to%20Western%20Australia%20and%20northern%20India.%20Early%20Neoproterozoic%20suprasubduction%20zone%20magmatic%20arc-backarc%20assemblages%20in%20the%20craton%20range%20in%20age%20from%20ca.%201000%20Ma%20to%20820%20Ma%20and%20display%20a%20sequential%20northwest%20decrease%20in%20age.%20These%20relations%20suggest%20formation%20and%20closure%20of%20arc%20systems%20through%20southeast-directed%20subduction,%20resulting%20in%20progressive%20northwestward%20accretion%20onto%20the%20periphery%20of%20an%20already%20assembled%20Rodinia.%20Siliciclastic%20units%20within%20an%20early%20Paleozoic%20succession%20that%20transgresses%20across%20the%20craton%20were%20derived%20from%20the%20southeast%20and%20include%20detritus%20from%20beyond%20the%20current%20limits%20of%20the%20craton.%20Detrital%20zircon%20age%20spectra%20require%20an%20East%20Gondwana%20source%20and%20are%20very%20similar%20to%20the%20Tethyan%20Himalaya%20and%20younger%20Paleozoic%20successions%20from%20Western%20Australia,%20suggesting%20derivation%20from%20a%20common%20source%20and%20by%20inference%20accumulation%20in%20linked%20basins%20along%20the%20northern%20margin%20of%20Gondwana,%20a%20situation%20that%20continued%20until%20rifting%20and%20breakup%20of%20the%20craton%20in%20the%20late%20Paleozoic.}}

@article{MILLER1985a,
	annote = {10.1130/0016-7606(1985)96<1537:GASSTU>2.0.CO;2},
	author = {MILLER, JULIA M. G.},
	date-added = {2013-07-22 16:45:09 +0000},
	date-modified = {2013-07-22 16:45:09 +0000},
	journal = {Geological Society of America Bulletin},
	journal1 = {Geological Society of America Bulletin},
	number = {12},
	pages = {1537--1553},
	title = {Glacial and syntectonic sedimentation: The upper Proterozoic Kingston Peak Formation, southern Panamint Range, eastern California},
	ty = {JOUR},
	url = {http://gsabulletin.gsapubs.org/content/96/12/1537.abstract N2 - A sedimentological-stratigraphic study of the upper Proterozoic Kingston Peak Formation in the southern Panamint Range shows that it was deposited under glacial conditions with contemporaneous volcanism and tectonic activity. Evidence for glaciation rests primarily upon (1) the homogeneity, thickness, and lateral extent of two diamictite units; (2) the facies association of the diamictite; and (3) presence of striated stones and dropstones within the formation elsewhere in the Death Valley area. In the Panamint Range, pillowed basalt interbedded with diamictite demonstrates synchronous subaqueous volcanism. Lower Kingston Peak units rest on a variable substrate and locally overlap faults, indicating tectonism prior to deposition. Tectonism during Kingston Peak deposition is inferred from abrupt thickness changes and buried faults. Sedimentation was chiefly on a submerged continental platform and locally terrestrial, during a period of incipient rifting. Two ice advances are recorded with associated sea-level fluctuations.The formation thickens northward from 40 to about 1,200 m over ∼40 km. Initial sediments were fine grained and in basins a few kilometres across; nearby islands provided coarse debris. Overlying sandstone and conglomerate indicate regression. Predominantly massive diamictite, as much as 450 m thick and interpreted as lodgment till or glacioma-rine sediment, records the first ice advance. A northward increase in diamictite thickness, decrease in clast size, and facies change from diamictite to argillite and graywacke suggest a southern source. Overlying laminated limestone marks a transgression. Succeeding interbedded sandy limestone, thick-bedded graywacke, and parallel-laminated siltstone and sandstone double in thickness over a few kilometres, demonstrating local subsidence and renewed terrigenous input. Trough, cross-laminated, arkosic sandstone and conglomerate overlain by predominantly massive diamictite, as much as 190 m thick with a locally erosive base, represent glaciofluvial deposits and lodgment till and record the second ice advance.},
	volume = {96},
	year = {December, 1985},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://gsabulletin.gsapubs.org/content/96/12/1537.abstract%20N2%20-%20A%20sedimentological-stratigraphic%20study%20of%20the%20upper%20Proterozoic%20Kingston%20Peak%20Formation%20in%20the%20southern%20Panamint%20Range%20shows%20that%20it%20was%20deposited%20under%20glacial%20conditions%20with%20contemporaneous%20volcanism%20and%20tectonic%20activity.%20Evidence%20for%20glaciation%20rests%20primarily%20upon%20(1)%20the%20homogeneity,%20thickness,%20and%20lateral%20extent%20of%20two%20diamictite%20units;%20(2)%20the%20facies%20association%20of%20the%20diamictite;%20and%20(3)%20presence%20of%20striated%20stones%20and%20dropstones%20within%20the%20formation%20elsewhere%20in%20the%20Death%20Valley%20area.%20In%20the%20Panamint%20Range,%20pillowed%20basalt%20interbedded%20with%20diamictite%20demonstrates%20synchronous%20subaqueous%20volcanism.%20Lower%20Kingston%20Peak%20units%20rest%20on%20a%20variable%20substrate%20and%20locally%20overlap%20faults,%20indicating%20tectonism%20prior%20to%20deposition.%20Tectonism%20during%20Kingston%20Peak%20deposition%20is%20inferred%20from%20abrupt%20thickness%20changes%20and%20buried%20faults.%20Sedimentation%20was%20chiefly%20on%20a%20submerged%20continental%20platform%20and%20locally%20terrestrial,%20during%20a%20period%20of%20incipient%20rifting.%20Two%20ice%20advances%20are%20recorded%20with%20associated%20sea-level%20fluctuations.The%20formation%20thickens%20northward%20from%2040%20to%20about%201,200%20m%20over%20%E2%88%BC40%20km.%20Initial%20sediments%20were%20fine%20grained%20and%20in%20basins%20a%20few%20kilometres%20across;%20nearby%20islands%20provided%20coarse%20debris.%20Overlying%20sandstone%20and%20conglomerate%20indicate%20regression.%20Predominantly%20massive%20diamictite,%20as%20much%20as%20450%20m%20thick%20and%20interpreted%20as%20lodgment%20till%20or%20glacioma-rine%20sediment,%20records%20the%20first%20ice%20advance.%20A%20northward%20increase%20in%20diamictite%20thickness,%20decrease%20in%20clast%20size,%20and%20facies%20change%20from%20diamictite%20to%20argillite%20and%20graywacke%20suggest%20a%20southern%20source.%20Overlying%20laminated%20limestone%20marks%20a%20transgression.%20Succeeding%20interbedded%20sandy%20limestone,%20thick-bedded%20graywacke,%20and%20parallel-laminated%20siltstone%20and%20sandstone%20double%20in%20thickness%20over%20a%20few%20kilometres,%20demonstrating%20local%20subsidence%20and%20renewed%20terrigenous%20input.%20Trough,%20cross-laminated,%20arkosic%20sandstone%20and%20conglomerate%20overlain%20by%20predominantly%20massive%20diamictite,%20as%20much%20as%20190%20m%20thick%20with%20a%20locally%20erosive%20base,%20represent%20glaciofluvial%20deposits%20and%20lodgment%20till%20and%20record%20the%20second%20ice%20advance.}}

@article{Macdonald2013a,
	annote = {10.1130/B30789.1},
	author = {Macdonald, Francis A. and Prave, Anthony R. and Petterson, Ryan and Smith, Emily F. and Pruss, Sara B. and Oates, Kaylyn and Waechter, Felix and Trotzuk, Dylan and Fallick, Anthony E.},
	date-added = {2013-07-22 16:34:36 +0000},
	date-modified = {2020-09-17 06:21:23 -0700},
	doi = {10.1130/B30789.1},
	journal = {Geological Society of America Bulletin},
	number = {7-8},
	pages = {1203--1223},
	title = {{The Laurentian record of Neoproterozoic glaciation, tectonism, and eukaryotic evolution in Death Valley, California}},
	volume = {125},
	year = {2013},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://gsabulletin.gsapubs.org/content/125/7-8/1203.abstract%20N2%20-%20Neoproterozoic%20strata%20in%20Death%20Valley,%20California,%20contain%20eukaryotic%20microfossils%20and%20glacial%20deposits%20that%20have%20been%20used%20to%20assess%20the%20severity%20of%20putative%20snowball%20Earth%20events%20and%20the%20biological%20response%20to%20extreme%20environmental%20change.%20These%20successions%20also%20contain%20evidence%20for%20synsedimentary%20faulting%20that%20has%20been%20related%20to%20the%20rifting%20of%20Rodinia,%20and%20in%20turn%20the%20tectonic%20context%20of%20the%20onset%20of%20snowball%20Earth.%20These%20interpretations%20hinge%20on%20local%20geological%20relationships%20and%20both%20regional%20and%20global%20stratigraphic%20correlations.%20Here,%20we%20present%20new%20geological%20mapping,%20measured%20stratigraphic%20sections,%20carbon%20and%20strontium%20isotope%20chemostratigraphy,%20and%20micropaleontology%20from%20the%20Neoproterozoic%20glacial%20deposits%20and%20bounding%20strata%20in%20Death%20Valley.%20These%20new%20data%20enable%20us%20to%20refine%20regional%20correlations,%20both%20across%20Death%20Valley%20and%20throughout%20Laurentia,%20and%20construct%20a%20new%20age%20model%20for%20glacigenic%20strata%20and%20microfossil%20assemblages.%20Particularly,%20our%20remapping%20of%20the%20Kingston%20Peak%20Formation%20in%20the%20Saddle%20Peak%20Hills%20and%20near%20the%20type%20locality%20shows%20for%20the%20first%20time%20that%20glacial%20deposits%20of%20both%20the%20Marinoan%20and%20Sturtian%20glaciations%20can%20be%20distinguished%20in%20southeastern%20Death%20Valley,%20and%20that%20beds%20containing%20vase-shaped%20microfossils%20are%20slump%20blocks%20derived%20from%20the%20underlying%20strata.%20These%20slump%20blocks%20are%20associated%20with%20multiple%20overlapping%20unconformities%20that%20developed%20during%20synsedimentary%20faulting,%20which%20is%20a%20common%20feature%20of%20Cyrogenian%20strata%20along%20the%20margin%20of%20Laurentia%20from%20California%20to%20Alaska.%20With%20these%20data,%20we%20conclude%20that%20all%20of%20the%20microfossils%20that%20have%20been%20described%20to%20date%20in%20Neoproterozoic%20strata%20of%20Death%20Valley%20predate%20the%20glaciations%20and%20do%20not%20bear%20on%20the%20severity,%20extent,%20or%20duration%20of%20Neoproterozoic%20snowball%20Earth%20events.}}

