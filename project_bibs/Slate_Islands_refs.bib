	isbn = {0094-8276},
	journal = {Geophys. Res. Lett.},
	keywords = {5440 Planetology: Solid Surface Planets: Magnetic fields and magnetism; 5420 Planetology: Solid Surface Planets: Impact phenomena (includes cratering); 1540 Geomagnetism and Paleomagnetism: Rock and mineral magnetism},
	number = {6},
