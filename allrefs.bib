	bdsk-file-1 = {},
	bdsk-url-1 = {http://geology.gsapubs.org/content/24/8/703.abstract%20N2%20-%20The%20youngest%20sampled%20submarine%20lava%20flow,%20which%20erupted%20June%201993%20on%20the%20Juan%20de%20Fuca%20Ridge,%20provides%20the%20basis%20for%20a%20tight%20constraint%20on%20the%20initial%20or%20zero-age%20magnetization%20state%20of%20MORB.%20Detailed%20profiles%20of%20magnetic%20hysteresis%20parameters,%20Curie%20temperatures,%20and%20unblocking%20temperatures%20of%20NRM%20with%20respect%20to%20the%20chilled%20margin%20of%20a%20pillow%20fragment%20show%20evidence%20of%20significant%20oxidation,%20which%20preferentially%20affected%20the%20finest%20grain-size%20fraction%20and%20principal%20remanence%20carrier%20of%20the%20titanomagnetite%20magnetic%20mineralogy.%20The%20oxidation%20must%20have%20occurred%20during%20or%20immediately%20after%20initial%20cooling,%20implying%20that%20MORB%20is%20already%20appreciably%20magnetically%20altered%20before%20aging.%20Nevertheless,%20successful%20results%20of%20Thellier%20paleointensity%20experiments%20on%20the%20basalt%20sample%20lend%20support%20to%20the%20idea%20that%20crustal%20magnetization%20represented%20by%20MORB%20preserves%20a%20record%20of%20geomagnetic%20intensity%20variations%20that%20may%20be%20reflected%20in%20small-scale%20magnetic%20anomalies.}}

@article{Prevot1981a,
	abstract = {Both theoretical considerations and available experimental results indicate that magnetic effects of maghemitization are strongly dependent on the grain size of the originally unoxidized titanomagnetite. Maghemitization of single-domain titanomagnetite results in a decrease in coercivity, an increase in susceptibility, and a large decrease in Q ratio. Maghemitization of multidomain titanomagnetite results in an increase in coercivity, a decrease in susceptibility, and no large changes in Q ratio. Single-domain titanomagnetite is probably resistant to the development of a chemical remanent magnetization (CRM), whereas multidomain titanomagnetite can acquire a CRM during maghemitization. The behavior of pseudo-single-domain titanomagnetite, which is the main carrier of remanence in submarine extrusive rocks, is investigated by comparing the magnetic properties of the French-American Mid-Ocean Undersea Study (FAMOUS) (less than 0.1 m.y. old) and the Leg 37 (3.5 m.y. old) pillow basalts recovered from the Mid-Atlantic Ridge near 37∞N. Combining electron microprobe analyses, Curie temperature measurements, and cell edge determinations, we find that the FAMOUS rocks are already oxidized (z = 0.38), possibly as a result of some high-temperature maghemitization during cooling of the magma. Comparison with the more highly oxidized (z = 0.7) Leg 37 pillow basalts indicates that low-temperature maghemitization of such rocks does not result in appreciable changes of coercivity and susceptibility, although the Q ratio does decrease and CRM seems to be acquired. Such a CRM could account for the anomalously low magnetic inclinations observed at most of the Leg 37 sites.},
	author = {Pr\'evot, Michel and Lecaille, Alain and Mankinen, Edward A.},
	date-added = {2010-10-10 11:41:46 -0400},
	date-modified = {2011-02-02 09:42:44 -0500},
	do = {10.1029/JB086iB05p04009},
	isbn = {0148-0227},
	journal = {J. Geophys. Res.},
	number = {B5},
	pages = {4009--4020},
	publisher = {AGU},
	title = {Magnetic Effects of Maghemitization of Oceanic Crust},
	ty = {JOUR},
	volume = {86},
	year = {1981},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://dx.doi.org/10.1029/JB086iB05p04009}}

