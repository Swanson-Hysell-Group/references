	journal = {Geochem. Geophys. Geosyst.},
	keywords = {Amazon; glacial maximum; Holocene; lipids; tetraethers; temperature; 0473 Biogeosciences: Paleoclimatology and paleoceanography; 1055 Geochemistry: Organic and biogenic geochemistry; 4914 Paleoceanography: Continental climate records},
	month = {12},
