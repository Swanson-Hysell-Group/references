@article{Zhang2008a,
	abstract = {In South China, the Wuqiangxi Formation of the Banxi Group and its equivalents underlie the early Cryogenian (Sturtian) glacial deposits but their thickness varies from <200 m to >2000 m. In the Guzhang section of western Hunan, the Wuqiangxi Formation is only 152 m thick, and an ash bed 58 m below the glacial diamictite yielded a SHRIMP U-Pb age of 809.3$\pm$8.4 Ma. In contrast, 90 km south of the Guzhang section towards the basin in Zhijiang area where the Wuqiangxi Formation is ∼2200 m thick, an age of 725$\pm$10 Ma has been reported from the top of this unit, 300 m below the glacial diamictite. These ages provide new evidence for the regional stratigraphic correlation across the Nanhua basin, and suggest unusually large (>2 km) stratigraphic erosion potentially associated with the Sturtian glaciation in South China. The magnitude of erosion may imply significant uplifting and tectonotopography at the onset of the Sturtian glaciation.},
	author = {Zhang, ShiHong and Jiang, GanQing and Dong, Jin and Han, YiGui and Wu, HuaiChun},
	da = {2008//},
	date-added = {2016-03-09 01:07:29 +0000},
	date-modified = {2016-03-09 01:07:29 +0000},
	doi = {10.1007/s11430-008-0119-z},
	id = {Zhang2008},
	isbn = {1862-2801},
	journal = {Science in China Series D: Earth Sciences},
	number = {11},
	pages = {1537--1544},
	title = {New SHRIMP U-Pb age from the Wuqiangxi Formation of Banxi Group: Implications for rifting and stratigraphic erosion associated with the early Cryogenian (Sturtian) glaciation in South China},
	ty = {JOUR},
	url = {http://dx.doi.org/10.1007/s11430-008-0119-z},
	volume = {51},
	year = {2008},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://dx.doi.org/10.1007/s11430-008-0119-z}}

@article{Smith2015b,
	annote = {10.1144/SP424.6},
	author = {Smith, Emily F. and Macdonald, Francis A. and Crowley, James L. and Hodgin, Eben B. and Schrag, Daniel P.},
	date-added = {2016-03-09 00:33:06 +0000},
	date-modified = {2020-09-17 06:27:56 -0700},
	doi = {10.1144/SP424.6},
	journal = {Geological Society, London, Special Publications},
	month = {05},
	title = {{Tectonostratigraphic evolution of the c. 780--730 Ma Beck Spring Dolomite: Basin Formation in the core of Rodinia}},
	volume = {424},
	year = {2015},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://sp.lyellcollection.org/content/early/2015/05/21/SP424.6.abstract%20N2%20-%20The%20Beck%20Spring%20Dolomite%20is%20a%20mixed%20carbonate%E2%80%93siliciclastic%20succession%20exposed%20in%20Death%20Valley,%20California,%20that%20was%20deposited%20between%20780%20and%20717%20Ma.%20Along%20with%20its%20bounding%20units,%20the%20Horse%20Thief%20Springs%20Formation%20below%20and%20unit%20KP1%20of%20the%20Kingston%20Peak%20Formation%20above,%20the%20Beck%20Spring%20Dolomite%20were%20deposited%20in%20one%20of%20the%20ChUMP%20(Chuar%E2%80%93Uinta%20Mountains%E2%80%93Pahrump)%20basins%20with%20subsidence%20commonly%20attributed%20to%20the%20nascent%20rifting%20of%20Rodinia.%20These%20pre-Sturtian%20successions%20preserve%20eukaryotic%20microfossil%20assemblages,%20diverse%20microbialites,%20and%20large%20carbon%20isotope%20anomalies%20directly%20below%20Sturtian-age%20glacial%20deposits.%20Here%20we%20present%20new%20geological%20mapping,%20measured%20stratigraphic%20sections,%20carbon%20isotope%20chemostratigraphy%20and%20detrital%20zircon%20geochronology%20from%20the%20Beck%20Spring%20Dolomite%20and%20its%20bounding%20units.%20The%20carbon%20isotope%20excursion%20at%20the%20top%20of%20the%20Beck%20Spring%20Dolomite%20has%20previously%20been%20attributed%20to%20meteoric%20diagenesis%20associated%20with%20karst%20breccias,%20but%20here%20we%20demonstrate%20that%20these%20breccias%20are%20instead%20mass%20flow%20deposits%20that%20formed%20during%20deposition%20of%20the%20Kingston%20Peak%20Formation%20and%20that%20the%20carbon%20isotope%20excursion%20is%20not%20only%20reproducible%20throughout%20the%20basin,%20but%20is%20associated%20with%20transgression%20rather%20than%20regression%20and%20exposure.%20In%20addition,%20we%20refine%20local%20correlations%20and%20discuss%20the%20use%20of%20chemostratigraphic%20curves%20from%20these%20units%20for%20regional%20and%20global%20correlations.%20The%20Beck%20Spring%20Dolomite%20was%20deposited%20during%20the%20second%20of%20three%20distinct%20basin-forming%20events%20recorded%20in%20the%20Pahrump%20Group%20with%20basin%20inversion%20occurring%20between%20each%20event.%20The%20presence%20of%20syn-sedimentary%20faults,%20the%20character%20of%20the%20lateral%20facies%20change%20and%20detrital%20zircon%20provenance%20analyses%20indicate%20that%20the%20Beck%20Spring%20Dolomite%20fringed%20a%20coeval%20palaeo-high%20to%20the%20south%20in%20a%20tectonically%20active%20basin.%20Detrital%20zircon%20age%20distributions%20in%20the%20Beck%20Spring%20Dolomite%20show%20sharp%20probability%20peaks%20at%20c.%201200,%201400%20and%201800%20Ma,%20consistent%20with%20local%20sources%20to%20the%20SW%20in%20the%20Mojave%20block%20rather%20than%20transcontinental%20rivers.%20The%20c.%201800%20Ma%20probability%20peak%20is%20less%20prominent%20in%20the%20KP1%20samples.%20In%20addition,%20KP1%20also%20records%20slump%20folding%20and%20is%20overlain%20by%20an%20unconformity.%20We%20suggest%20that%20these%20features%20are%20consistent%20with%20the%20emergence%20of%20a%20local%20fault%20to%20the%20NE.%20Deposition%20of%20the%20Beck%20Spring%20Dolomite%20and%20bounding%20units%20do%20not%20record%20evidence%20of%20incipient%20rifting%20of%20the%20western%20margin%20of%20Laurentia%20but%20instead%20reflect%20a%20distinct%20and%20separate%20tectonothermal%20event.Supplementary%20material:%20Carbon%20(%CE%B413C)%20and%20oxygen%20(%CE%B418O)%20isotopic%20measurements,%20detrital%20zircon%20laser%20ablation%20inductively%20coupled%20plasma%20mass%20spectrometry%20(LA-ICPMS)%20data,%20detrital%20zircon%20sample%20information%20and%20data%20from%20reference%20materials%20used%20for%20LA-ICPMS%20analyses%20are%20available%20at%20http://www.geolsoc.org.uk/SUP18823.}}

