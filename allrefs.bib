	doi = {https://doi.org/10.1016/j.gca.2014.08.030},
	isbn = {0016-7037},
	journal = {Geochimica et Cosmochimica Acta},
	pages = {103--115},
	title = {Variation of lithium isotope geochemistry during basalt weathering and secondary mineral transformations in Hawaii},
	ty = {JOUR},
