@article{Cumming2013a,
	abstract = {N2 - A significant body of evidence suggests that the marine environment remained largely anoxic throughout most of the Precambrian. In contrast, the oxygenation history of terrestrial aquatic environments has received little attention, despite the significance of such settings for early eukaryote evolution. To address this, we provide here a geochemical and isotopic assessment of sediments from the late Mesoproterozoic Nonesuch Formation of central North America. We utilize rhenium-osmium (Re-Os) geochronology to yield a depositional age of 1078 $\pm$ 24 Ma, while Os isotope compositions support existing evidence for a lacustrine setting. Fe-S-C systematics suggest that the Nonesuch Formation was deposited from an anoxic Fe-rich (ferruginous) water column. Thus, similar to the marine realm, anoxia persisted in terrestrial aquatic environments in the Middle to Late Proterozoic, but sulfidic water column conditions were not ubiquitous. Our data suggest that oxygenation of the terrestrial realm was not pervasive at this time and may not have preceded oxygenation of the marine environment, signifying a major requirement for further investigation of links between the oxygenation state of terrestrial aquatic environments and eukaryote evolution.},
	annote = {10.1130/G34299.1},
	author = {Cumming, Vivien M. and Poulton, Simon W. and Rooney, Alan D. and Selby, David},
	cited-by = {MRM},
	date = {2013/05/01},
	date-added = {2013-04-18 15:16:14 +0000},
	date-modified = {2021-07-03 23:09:04 -0500},
	doi = {10.1130/G34299.1},
	journal = {Geology},
	journal1 = {Geology},
	number = {5},
	pages = {583--586},
	title = {Anoxia in the terrestrial environment during the late {M}esoproterozoic},
	ty = {JOUR},
	volume = {41},
	year = {2013},
	bdsk-url-1 = {http://geology.gsapubs.org/content/41/5/583.abstract%20N2%20-%20A%20significant%20body%20of%20evidence%20suggests%20that%20the%20marine%20environment%20remained%20largely%20anoxic%20throughout%20most%20of%20the%20Precambrian.%20In%20contrast,%20the%20oxygenation%20history%20of%20terrestrial%20aquatic%20environments%20has%20received%20little%20attention,%20despite%20the%20significance%20of%20such%20settings%20for%20early%20eukaryote%20evolution.%20To%20address%20this,%20we%20provide%20here%20a%20geochemical%20and%20isotopic%20assessment%20of%20sediments%20from%20the%20late%20Mesoproterozoic%20Nonesuch%20Formation%20of%20central%20North%20America.%20We%20utilize%20rhenium-osmium%20(Re-Os)%20geochronology%20to%20yield%20a%20depositional%20age%20of%201078%20%C2%B1%2024%20Ma,%20while%20Os%20isotope%20compositions%20support%20existing%20evidence%20for%20a%20lacustrine%20setting.%20Fe-S-C%20systematics%20suggest%20that%20the%20Nonesuch%20Formation%20was%20deposited%20from%20an%20anoxic%20Fe-rich%20(ferruginous)%20water%20column.%20Thus,%20similar%20to%20the%20marine%20realm,%20anoxia%20persisted%20in%20terrestrial%20aquatic%20environments%20in%20the%20Middle%20to%20Late%20Proterozoic,%20but%20sulfidic%20water%20column%20conditions%20were%20not%20ubiquitous.%20Our%20data%20suggest%20that%20oxygenation%20of%20the%20terrestrial%20realm%20was%20not%20pervasive%20at%20this%20time%20and%20may%20not%20have%20preceded%20oxygenation%20of%20the%20marine%20environment,%20signifying%20a%20major%20requirement%20for%20further%20investigation%20of%20links%20between%20the%20oxygenation%20state%20of%20terrestrial%20aquatic%20environments%20and%20eukaryote%20evolution.}}

