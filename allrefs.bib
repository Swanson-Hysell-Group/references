@phdthesis{Stewart2025a,
	abstract = {The late Mesoproterozoic Oronto Group, Wisconsin and Michigan, preserves an extensive and continuous record of depositional environment and related microbial habitat. Over three kilometers of siliciclastic sediments with minor authigenic calcite record physical and biogeochemical processes acting within the Oronto Group basin at the time of deposition and early diagenesis. In this dissertation I explore the sedimentologic and geochemical signature of the lower Oronto Group (Copper Harbor Conglomerate, Nonesuch, and Freda Formations) with the goal of re-evaluating and refining evolving depositional conditions. Chapter 1 presents a revised sedimentologic and stratigraphic framework and evaluates published geochemical redox proxies and microfossil assemblages within this framework. Sedimentary facies indicate a pervasive shallow marine and tidal influence on deposition, requiring marine incursion to the Laurentian continental interior at ca. 1.08 Ga. Chapter 2 investigates the degree of marine connectivity to the Oronto Group basin using C, O, and Rb-Sr isotope compositions of calcite microspar in molar tooth (MT) structures and carbonate laminae of the Nonesuch Formation. Combined, these data show deposition within a restricted-marine epeiric setting where organic matter remineralization drove 13C depletion, evaporative conditions drove 18O enrichment, and 87Sr/86Sr reflects marine mixing with continental runoff. Chapter 3 evaluates conditions of salinity, redox, and productivity using whole rock geochemistry of fine-grained siliciclastics and rare earth element + yttrium (REY) distributions of calcite microspar. Shale geochemistry reveals deposition within an oxidized basin with a deep, fluctuating chemocline and expansion of anoxic and euxinic conditions during maximum flooding and base level lowstand. REY distributions of calcite microspar preserve an early diagenetic estuarine signal. Shale geochemistry and carbonate REY distributions bring into focus the prevalence of particle shuttling between the water column and shallow sediments that likely enhanced and focused nutrient P bioavailability, analogous to modern estuarine nutrient cycling. Collectively, these studies provide a richer understanding of late Mesoproterozoic environmental conditions that influenced early eukaryote ecology.},
	author = {Stewart,Esther K.},
	date-added = {2025-05-19 10:09:13 -0500},
	date-modified = {2025-05-19 10:09:13 -0500},
	isbn = {9798314852941},
	journal = {ProQuest Dissertations and Theses},
	keywords = {Mesoproterozoic; Midcontinent rift; Molar tooth; Nonesuch; Microfossil assemblages; Geology; Sedimentary geology; Geochemistry; 0372:Geology; 0996:Geochemistry; 0594:Sedimentary Geology},
	language = {English},
	note = {Copyright - Database copyright ProQuest LLC; ProQuest does not claim copyright in the individual underlying works; Last updated - 2025-05-08},
	pages = {232},
	title = {Sedimentologic and Geochemical Markers of Marine Incursion to the Interior Laurentian Oronto Group Basin at ca. 1.08 Ga},
	url = {http://login.ezproxy.lib.umn.edu/login?url=https://www.proquest.com/dissertations-theses/sedimentologic-geochemical-markers-marine/docview/3200087076/se-2},
	year = {2025},
