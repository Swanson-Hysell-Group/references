	title = {Detrital Zircon Provenance of the {M}esoproterozoic {M}idcontinent {R}ift, {L}ake {S}uperior Region, {U.S.A.}},
	url = {http://www.jstor.org/stable/10.1086/668635},
	volume = {121},
