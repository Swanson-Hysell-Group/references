@article{Muxworthy2000d,
	author = {Muxworthy, A. R. and McClelland, E.},
	date = {2000/01/01},
	date-added = {2013-12-13 07:42:17 +0000},
	date-modified = {2013-12-13 07:42:17 +0000},
	journal = {Geophysical Journal International},
	m3 = {10.1046/j.1365-246x.2000.00000.x},
	month = {01},
	number = {1},
	pages = {115--131},
	title = {The causes of low-temperature demagnetization of remanence in multidomain magnetite},
	ty = {JOUR},
	url = {http://gji.oxfordjournals.org/content/140/1/115.abstract N2 - In this paper, the mechanisms of low-temperature demagnetization of remanence in multidomain magnetite are considered. New experimental observations of the behaviour of the saturation isothermal remanence, thermoremanence and partial thermoremanence at low temperatures are presented. The results show that there are two main contributions to this low-temperature demagnetization. The first and predominant contribution (type-1 demagnetization) is due to ‘kinematic’ domain state reorganization and occurs throughout cooling from room temperature to the Verwey transition, Tv at 120–124 K. The second contribution arises from the change in anisotropy from cubic to monoclinic at Tv which changes the overall domain structure of the grain. On warming in zero field, some domain walls will not return to their original positions but will take up a position that leads to a lower net remanence (type-2 demagnetization). In stoichiometric magnetite, demagnetization does not occur at 130 K at the isotropic point, Tk contrary to some previous predictions. In non-stoichiometric magnetite, the influence of the Verwey transition is greatly reduced, and anomalous behaviour is observed at Tk .},
	volume = {140},
	year = {2000},
	bdsk-url-1 = {http://gji.oxfordjournals.org/content/140/1/115.abstract%20N2%20-%20In%20this%20paper,%20the%20mechanisms%20of%20low-temperature%20demagnetization%20of%20remanence%20in%20multidomain%20magnetite%20are%20considered.%20New%20experimental%20observations%20of%20the%20behaviour%20of%20the%20saturation%20isothermal%20remanence,%20thermoremanence%20and%20partial%20thermoremanence%20at%20low%20temperatures%20are%20presented.%20The%20results%20show%20that%20there%20are%20two%20main%20contributions%20to%20this%20low-temperature%20demagnetization.%20The%20first%20and%20predominant%20contribution%20(type-1%20demagnetization)%20is%20due%20to%20%E2%80%98kinematic%E2%80%99%20domain%20state%20reorganization%20and%20occurs%20throughout%20cooling%20from%20room%20temperature%20to%20the%20Verwey%20transition,%20Tv%20%20at%20120%E2%80%93124%20K.%20The%20second%20contribution%20arises%20from%20the%20change%20in%20anisotropy%20from%20cubic%20to%20monoclinic%20at%20Tv%20%20which%20changes%20the%20overall%20domain%20structure%20of%20the%20grain.%20On%20warming%20in%20zero%20field,%20some%20domain%20walls%20will%20not%20return%20to%20their%20original%20positions%20but%20will%20take%20up%20a%20position%20that%20leads%20to%20a%20lower%20net%20remanence%20(type-2%20demagnetization).%20In%20stoichiometric%20magnetite,%20demagnetization%20does%20not%20occur%20at%20130%20K%20at%20the%20isotropic%20point,%20Tk%20%20contrary%20to%20some%20previous%20predictions.%20In%20non-stoichiometric%20magnetite,%20the%20influence%20of%20the%20Verwey%20transition%20is%20greatly%20reduced,%20and%20anomalous%20behaviour%20is%20observed%20at%20Tk%20.}}

@article{Muxworthy2000c,
	annote = {10.1046/j.1365-246x.2000.00999.x},
	author = {Muxworthy, A. R. and McClelland, E.},
	date = {2000/01/01},
	date-added = {2013-12-13 07:41:31 +0000},
	date-modified = {2013-12-13 07:41:31 +0000},
	journal = {Geophysical Journal International},
	journal1 = {Geophysical Journal International},
	month = {01},
	number = {1},
	pages = {101--114},
	title = {Review of the low-temperature magnetic properties of magnetite from a rock magnetic perspective},
	ty = {JOUR},
	url = {http://gji.oxfordjournals.org/content/140/1/101.abstract N2 - The low-temperature magnetic properties of magnetite are reviewed, and implications for rock magnetism considered. The behaviour of fundamental properties of magnetite at low temperatures near the Verwey transition (Tv ) are documented, and attention is given to various Verwey transition theories. The low-temperature behaviour of the magnetic energies that control domain structure is reviewed in detail. For the first time in rock magnetic literature, the low-temperature anomaly in spontaneous magnetization (Ms ) is documented and the differences between the saturation magnetization and Ms near the Verwey transition are discussed. It is argued that the low-temperature behaviour of the magnetocrystalline anisotropy, and in particular the anomaly at Tv is most likely to affect multidomain remanence during low-temperature cycling. For multidomain crystals it is calculated that the large increase in magnetocrystalline anisotropy intensity and reduction in symmetry on cooling through Tv is likely to reduce the stability of closure domains.},
	volume = {140},
	year = {2000},
	bdsk-url-1 = {http://gji.oxfordjournals.org/content/140/1/101.abstract%20N2%20-%20The%20low-temperature%20magnetic%20properties%20of%20magnetite%20are%20reviewed,%20and%20implications%20for%20rock%20magnetism%20considered.%20The%20behaviour%20of%20fundamental%20properties%20of%20magnetite%20at%20low%20temperatures%20near%20the%20Verwey%20transition%20(Tv%20)%20are%20documented,%20and%20attention%20is%20given%20to%20various%20Verwey%20transition%20theories.%20The%20low-temperature%20behaviour%20of%20the%20magnetic%20energies%20that%20control%20domain%20structure%20is%20reviewed%20in%20detail.%20For%20the%20first%20time%20in%20rock%20magnetic%20literature,%20the%20low-temperature%20anomaly%20in%20spontaneous%20magnetization%20(Ms%20)%20is%20documented%20and%20the%20differences%20between%20the%20saturation%20magnetization%20and%20Ms%20near%20the%20Verwey%20transition%20are%20discussed.%20It%20is%20argued%20that%20the%20low-temperature%20behaviour%20of%20the%20magnetocrystalline%20anisotropy,%20and%20in%20particular%20the%20anomaly%20at%20Tv%20%20is%20most%20likely%20to%20affect%20multidomain%20remanence%20during%20low-temperature%20cycling.%20For%20multidomain%20crystals%20it%20is%20calculated%20that%20the%20large%20increase%20in%20magnetocrystalline%20anisotropy%20intensity%20and%20reduction%20in%20symmetry%20on%20cooling%20through%20Tv%20is%20likely%20to%20reduce%20the%20stability%20of%20closure%20domains.}}

@article{Buffett2013b,
	abstract = {Regeneration of the Earth's magnetic field by convection in the liquid core produces a broad spectrum of time variation. Relative palaeointensity measurements in marine sediments provide a detailed record over the past 2 Myr, but an explicit reconstruction of the underlying dynamics is not feasible. A more practical alternative is to construct a stochastic model from estimates of the virtual axial dipole moment. The deterministic part of the model (drift term) describes time-averaged behaviour, whereas the random part (diffusion term) characterizes complex interactions over convective timescales. We recover estimates of the drift and diffusion terms from the SINT2000 model of Valet et al. and the PADM2M model of Ziegler et al. The results are used in numerical solutions of the Fokker--Planck equation to predict statistical properties of the palaeomagnetic field, including the average rates of magnetic reversals and excursions. A physical interpretation of the stochastic model suggests that the timescale for adjustments in the axial dipole moment is set by the dipole decay time τd. We obtain τd = 29 kyr from the stochastic models, which falls within the expected range for the Earth's core. We also predict the amplitude of convective fluctuations in the core, and establish a physical connection to the rates of magnetic reversals and excursions. Chrons lasting longer than 10 Myr are unlikely under present-day conditions. However, long chrons become more likely if the diffusion term is reduced by a factor of 2. Such a change is accomplished by reducing the velocity fluctuations in the core by a factor of √2, which could be attributed to a shift in the spatial pattern of heat flux from the core or a reduction in the total core heat flow.},
	author = {Buffett, Bruce A. and Ziegler, Leah and Constable, Cathy G.},
	date-added = {2013-12-13 06:58:05 +0000},
	date-modified = {2017-04-04 19:13:23 +0000},
	doi = {10.1093/gji/ggt218},
	journal = {Geophysical Journal International},
	journal1 = {Geophysical Journal International},
	month = {October},
	number = {1},
	pages = {86--97},
	title = {A stochastic model for palaeomagnetic field variations},
	ty = {JOUR},
	url = {http://gji.oxfordjournals.org/content/195/1/86.abstract},
	volume = {195},
	year = {2013},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://gji.oxfordjournals.org/content/195/1/86.abstract%20N2%20-%20Regeneration%20of%20the%20Earth's%20magnetic%20field%20by%20convection%20in%20the%20liquid%20core%20produces%20a%20broad%20spectrum%20of%20time%20variation.%20Relative%20palaeointensity%20measurements%20in%20marine%20sediments%20provide%20a%20detailed%20record%20over%20the%20past%202%20Myr,%20but%20an%20explicit%20reconstruction%20of%20the%20underlying%20dynamics%20is%20not%20feasible.%20A%20more%20practical%20alternative%20is%20to%20construct%20a%20stochastic%20model%20from%20estimates%20of%20the%20virtual%20axial%20dipole%20moment.%20The%20deterministic%20part%20of%20the%20model%20(drift%20term)%20describes%20time-averaged%20behaviour,%20whereas%20the%20random%20part%20(diffusion%20term)%20characterizes%20complex%20interactions%20over%20convective%20timescales.%20We%20recover%20estimates%20of%20the%20drift%20and%20diffusion%20terms%20from%20the%20SINT2000%20model%20of%20Valet%20et%20al.%20and%20the%20PADM2M%20model%20of%20Ziegler%20et%20al.%20The%20results%20are%20used%20in%20numerical%20solutions%20of%20the%20Fokker%E2%80%93Planck%20equation%20to%20predict%20statistical%20properties%20of%20the%20palaeomagnetic%20field,%20including%20the%20average%20rates%20of%20magnetic%20reversals%20and%20excursions.%20A%20physical%20interpretation%20of%20the%20stochastic%20model%20suggests%20that%20the%20timescale%20for%20adjustments%20in%20the%20axial%20dipole%20moment%20is%20set%20by%20the%20dipole%20decay%20time%20%CF%84d.%20We%20obtain%20%CF%84d%20=%2029%20kyr%20from%20the%20stochastic%20models,%20which%20falls%20within%20the%20expected%20range%20for%20the%20Earth's%20core.%20We%20also%20predict%20the%20amplitude%20of%20convective%20fluctuations%20in%20the%20core,%20and%20establish%20a%20physical%20connection%20to%20the%20rates%20of%20magnetic%20reversals%20and%20excursions.%20Chrons%20lasting%20longer%20than%2010%20Myr%20are%20unlikely%20under%20present-day%20conditions.%20However,%20long%20chrons%20become%20more%20likely%20if%20the%20diffusion%20term%20is%20reduced%20by%20a%20factor%20of%202.%20Such%20a%20change%20is%20accomplished%20by%20reducing%20the%20velocity%20fluctuations%20in%20the%20core%20by%20a%20factor%20of%20%E2%88%9A2,%20which%20could%20be%20attributed%20to%20a%20shift%20in%20the%20spatial%20pattern%20of%20heat%20flux%20from%20the%20core%20or%20a%20reduction%20in%20the%20total%20core%20heat%20flow.}}

@article{Hyland2009a,
	author = {Hyland, Ethan and Murphy, Brandon and Varela, Phil and Marks, Katie and Colwell, Lauren and Tori, Flavia and Monechi, Simonetta and Cleaveland, Laura and Brinkhuis, Henk and van Mourik, Caroline A and Coccioni, Rodolfo and Bice, David and Montanari, Alessandro},
	date = {2009/04/01},
	date-added = {2013-12-03 21:57:32 +0000},
	date-modified = {2013-12-03 21:57:32 +0000},
	journal = {Geological Society of America Special Papers},
	m3 = {10.1130/2009.2452(19)},
	month = {04},
	pages = {303--322},
	title = {Integrated stratigraphic and astrochronologic calibration of the Eocene-Oligocene transition in the Monte Cagnero section (northeastern Apennines, Italy): A potential parastratotype for the Massignano global stratotype section and point (GSSP)},
	ty = {JOUR},
	url = {http://specialpapers.gsapubs.org/content/452/303.abstract N2 - We present the results of integrated biostratigraphic (planktonic foraminifera, calcareous nannofossils, and dinoflagellates), magnetostratigraphic, and cyclostratigraphic analyses of the lower part of Monte Cagnero section (Umbria-Marche Apennines of Italy), a continuous and complete succession of pelagic limestone and marls that provides the means for an accurate and precise astrochronologic calibration of the Eocene-Oligocene transition. This 38.5-m-thick section overlaps the Oligocene section, which, at meter level 188, contains the Rupelian-Chattian boundary corresponding to the O4-O5 planktonic foraminiferal zonal boundary within the upper half of magnetochron C10n. The Eocene-Oligocene boundary at Monte Cagnero, as defined by the last occurrence of hantkeninid planktonic foraminifers (E14-E15 zonal boundary), is found at meter level 114.1, in the upper part of calcareous nannofossil zone CP16a, and very near the Aal-Gse dinocyst zonal boundary. Paleomagnetic analysis has identified all the magnetic reversals from the lower C13r to the lower C12n, precisely overlapping the base of the Oligocene magnetostratigraphic succession and placing the Eocene-Oligocene boundary in the upper part of C13r, in full agreement with the global stratotype section and point (GSSP) at Massignano.Spectral analysis of calcium carbonate data from bulk samples, collected at 5 cm intervals, indicates that orbital forcing of depositional cycles (i.e., limestone versus marl alternations) is dominant at frequencies corresponding to the theoretical astronomical curves of eccentricity, obliquity, and precessional cycles throughout the studied Eocene-Oligocene transition. Correlation with the astrochronologic time scale allows an age assignment of 33.95 Ma for the Eocene-Oligocene boundary, which is in close agreement with the astrochronologic age for the boundary in the GSSP of Massignano obtained in a similar study by R.E. Brown and colleagues in this volume. Thus, the Monte Cagnero section represents a candidate parastratotype for the Eocene-Oligocene GSSP of Massignano in the eventuality that the oxygen and carbon stable isotope shifts defining the oxygen isotope Oi-1 glaciation will be preferred over the last occurrence of hantkeninids as marker for the boundary, since, at Massignano, the beginning of this isotope shift is barely represented in the uppermost part of the exposed section. The excellent integrated stratigraphic framework of Monte Cagnero presented here will significantly facilitate further high-resolution isotope and paleoecological studies across the time of transition from a hothouse to icehouse Earth.},
	volume = {452},
	year = {2009},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://specialpapers.gsapubs.org/content/452/303.abstract%20N2%20-%20We%20present%20the%20results%20of%20integrated%20biostratigraphic%20(planktonic%20foraminifera,%20calcareous%20nannofossils,%20and%20dinoflagellates),%20magnetostratigraphic,%20and%20cyclostratigraphic%20analyses%20of%20the%20lower%20part%20of%20Monte%20Cagnero%20section%20(Umbria-Marche%20Apennines%20of%20Italy),%20a%20continuous%20and%20complete%20succession%20of%20pelagic%20limestone%20and%20marls%20that%20provides%20the%20means%20for%20an%20accurate%20and%20precise%20astrochronologic%20calibration%20of%20the%20Eocene-Oligocene%20transition.%20This%2038.5-m-thick%20section%20overlaps%20the%20Oligocene%20section,%20which,%20at%20meter%20level%20188,%20contains%20the%20Rupelian-Chattian%20boundary%20corresponding%20to%20the%20O4-O5%20planktonic%20foraminiferal%20zonal%20boundary%20within%20the%20upper%20half%20of%20magnetochron%20C10n.%20The%20Eocene-Oligocene%20boundary%20at%20Monte%20Cagnero,%20as%20defined%20by%20the%20last%20occurrence%20of%20hantkeninid%20planktonic%20foraminifers%20(E14-E15%20zonal%20boundary),%20is%20found%20at%20meter%20level%20114.1,%20in%20the%20upper%20part%20of%20calcareous%20nannofossil%20zone%20CP16a,%20and%20very%20near%20the%20Aal-Gse%20dinocyst%20zonal%20boundary.%20Paleomagnetic%20analysis%20has%20identified%20all%20the%20magnetic%20reversals%20from%20the%20lower%20C13r%20to%20the%20lower%20C12n,%20precisely%20overlapping%20the%20base%20of%20the%20Oligocene%20magnetostratigraphic%20succession%20and%20placing%20the%20Eocene-Oligocene%20boundary%20in%20the%20upper%20part%20of%20C13r,%20in%20full%20agreement%20with%20the%20global%20stratotype%20section%20and%20point%20(GSSP)%20at%20Massignano.Spectral%20analysis%20of%20calcium%20carbonate%20data%20from%20bulk%20samples,%20collected%20at%205%20cm%20intervals,%20indicates%20that%20orbital%20forcing%20of%20depositional%20cycles%20(i.e.,%20limestone%20versus%20marl%20alternations)%20is%20dominant%20at%20frequencies%20corresponding%20to%20the%20theoretical%20astronomical%20curves%20of%20eccentricity,%20obliquity,%20and%20precessional%20cycles%20throughout%20the%20studied%20Eocene-Oligocene%20transition.%20Correlation%20with%20the%20astrochronologic%20time%20scale%20allows%20an%20age%20assignment%20of%2033.95%20Ma%20for%20the%20Eocene-Oligocene%20boundary,%20which%20is%20in%20close%20agreement%20with%20the%20astrochronologic%20age%20for%20the%20boundary%20in%20the%20GSSP%20of%20Massignano%20obtained%20in%20a%20similar%20study%20by%20R.E.%20Brown%20and%20colleagues%20in%20this%20volume.%20Thus,%20the%20Monte%20Cagnero%20section%20represents%20a%20candidate%20parastratotype%20for%20the%20Eocene-Oligocene%20GSSP%20of%20Massignano%20in%20the%20eventuality%20that%20the%20oxygen%20and%20carbon%20stable%20isotope%20shifts%20defining%20the%20oxygen%20isotope%20Oi-1%20glaciation%20will%20be%20preferred%20over%20the%20last%20occurrence%20of%20hantkeninids%20as%20marker%20for%20the%20boundary,%20since,%20at%20Massignano,%20the%20beginning%20of%20this%20isotope%20shift%20is%20barely%20represented%20in%20the%20uppermost%20part%20of%20the%20exposed%20section.%20The%20excellent%20integrated%20stratigraphic%20framework%20of%20Monte%20Cagnero%20presented%20here%20will%20significantly%20facilitate%20further%20high-resolution%20isotope%20and%20paleoecological%20studies%20across%20the%20time%20of%20transition%20from%20a%20hothouse%20to%20icehouse%20Earth.}}

@article{Jovane2007a,
	annote = {10.1130/B25917.1},
	author = {Jovane, Luigi and Florindo, Fabio and Coccioni, Rodolfo and Dinar{\`e}s-Turell, Jaume and Marsili, Andrea and Monechi, Simonetta and Roberts, Andrew P. and Sprovieri, Mario},
	date = {March/April, 2007},
	date-added = {2013-12-03 21:52:52 +0000},
	date-modified = {2013-12-03 21:53:02 +0000},
	journal = {Geological Society of America Bulletin},
	journal1 = {Geological Society of America Bulletin},
	number = {3-4},
	pages = {413--427},
	title = {The middle Eocene climatic optimum event in the Contessa Highway section, Umbrian Apennines, Italy},
	ty = {JOUR},
	url = {http://gsabulletin.gsapubs.org/content/119/3-4/413.abstract N2 - We report a high-resolution paleomagnetic investigation constrained by new qualitative and semiquantitative analyses of planktic and benthic foraminifera, nan-nofossil assemblages, integrated with oxygen and carbon isotope measurements, for the middle Eocene Scaglia limestones of the Contessa Highway section, central Italy. Calcareous plankton assemblages enable recognition of several biostratigraphic events from planktic foraminiferal zone P11 to the lower part of zone P15 and from calcareous nannofossil zone NP15 to the upper part of zone NP17, which results in refinement of the magnetobiostratigraphy of the Contessa Highway section. Correlation of the paleomagnetic polarity pattern with the geomagnetic polarity time scale provides a direct age interpretation for strata around the middle Eocene Scaglia limestones of the Contessa Highway section, from chrons C21n (47 Ma) through to subchron C18n.1n (38.5 Ma). Bulk carbon isotope values indicate a distinct carbon isotopic shift at 40 Ma that is interpreted to represent the first evidence in the Northern Hemisphere of the middle Eocene climatic optimum, which has recently been observed as a stable isotope anomaly in multiple records from the Indian-Atlantic sector of the Southern Ocean. This demonstrates a global response of the carbon cycle to the proposed transient increased pCO2 levels during the late middle Eocene and consequent global CO2-driven climate change.},
	volume = {119},
	year = {2007},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://gsabulletin.gsapubs.org/content/119/3-4/413.abstract%20N2%20-%20We%20report%20a%20high-resolution%20paleomagnetic%20investigation%20constrained%20by%20new%20qualitative%20and%20semiquantitative%20analyses%20of%20planktic%20and%20benthic%20foraminifera,%20nan-nofossil%20assemblages,%20integrated%20with%20oxygen%20and%20carbon%20isotope%20measurements,%20for%20the%20middle%20Eocene%20Scaglia%20limestones%20of%20the%20Contessa%20Highway%20section,%20central%20Italy.%20Calcareous%20plankton%20assemblages%20enable%20recognition%20of%20several%20biostratigraphic%20events%20from%20planktic%20foraminiferal%20zone%20P11%20to%20the%20lower%20part%20of%20zone%20P15%20and%20from%20calcareous%20nannofossil%20zone%20NP15%20to%20the%20upper%20part%20of%20zone%20NP17,%20which%20results%20in%20refinement%20of%20the%20magnetobiostratigraphy%20of%20the%20Contessa%20Highway%20section.%20Correlation%20of%20the%20paleomagnetic%20polarity%20pattern%20with%20the%20geomagnetic%20polarity%20time%20scale%20provides%20a%20direct%20age%20interpretation%20for%20strata%20around%20the%20middle%20Eocene%20Scaglia%20limestones%20of%20the%20Contessa%20Highway%20section,%20from%20chrons%20C21n%20(47%20Ma)%20through%20to%20subchron%20C18n.1n%20(38.5%20Ma).%20Bulk%20carbon%20isotope%20values%20indicate%20a%20distinct%20carbon%20isotopic%20shift%20at%2040%20Ma%20that%20is%20interpreted%20to%20represent%20the%20first%20evidence%20in%20the%20Northern%20Hemisphere%20of%20the%20middle%20Eocene%20climatic%20optimum,%20which%20has%20recently%20been%20observed%20as%20a%20stable%20isotope%20anomaly%20in%20multiple%20records%20from%20the%20Indian-Atlantic%20sector%20of%20the%20Southern%20Ocean.%20This%20demonstrates%20a%20global%20response%20of%20the%20carbon%20cycle%20to%20the%20proposed%20transient%20increased%20pCO2%20levels%20during%20the%20late%20middle%20Eocene%20and%20consequent%20global%20CO2-driven%20climate%20change.}}

