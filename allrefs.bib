@article{BERGMANN2013a,
	annote = {10.2110/palo.2012.p12-088r},
	author = {Bergmann, KRISTIN D. and {Grotzinger}, J.~P. and Fischer, WOODWARD W.},
	date-added = {2013-06-27 17:46:33 +0000},
	date-modified = {2021-12-21 10:25:33 -0800},
	doi = {10.2110/palo.2012.p12-088r},
	journal = {PALAIOS},
	journal1 = {PALAIOS},
	number = {2},
	pages = {99--115},
	title = {BIOLOGICAL INFLUENCES ON SEAFLOOR CARBONATE PRECIPITATION},
	ty = {JOUR},
	volume = {28},
	year = {2013},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://palaios.sepmonline.org/content/28/2/99.abstract%20N2%20-%20The%20sedimentary%20record%20reveals%20first-order%20changes%20in%20the%20locus%20of%20carbonate%20precipitation%20through%20time,%20documented%20in%20the%20decreasing%20abundance%20of%20carbonate%20precipitation%20on%20the%20seafloor.%20This%20pattern%20is%20most%20clearly%20recorded%20by%20the%20occurrence%20of%20seafloor%20carbonate%20crystal%20fans%20(bladed%20aragonite%20pseudomorphs%20neomorphosed%20to%20calcite%20or%20dolomite),%20which%20have%20a%20distinct%20temporal%20distribution,%20ubiquitous%20in%20Archean%20carbonate%20platforms,%20but%20declining%20through%20Proterozoic%20time%20and%20extremely%20rare%20in%20Phanerozoic%20basins.%20To%20understand%20better%20the%20potential%20influences%20on%20this%20pattern,%20we%20built%20a%20mathematical%20framework%20detailing%20the%20effects%20of%20organic%20matter%20delivery%20and%20microbial%20respiratory%20metabolisms%20on%20the%20carbonate%20chemistry%20of%20shallow%20sediments.%20Two%20nonunique%20end-member%20solutions%20emerge%20in%20which%20seafloor%20precipitation%20is%20favorable:%20enhanced%20anaerobic%20respiration%20of%20organic%20matter,%20and%20low%20organic%20matter%20delivery%20to%20the%20sediment-water%20interface.%20This%20analysis%20suggests%20that%20not%20all%20crystal%20fans%20reflect%20a%20unique%20set%20of%20circumstances;%20rather%20there%20may%20have%20been%20several%20different%20geobiological%20and%20sedimentary%20mechanisms%20that%20led%20to%20their%20deposition.%20We%20then%20applied%20this%20logical%20framework%20to%20better%20understand%20the%20petrogenesis%20of%20two%20distinct%20crystal%20fan%20occurrences%E2%80%94the%20Paleoproterozoic%20Beechey%20Formation,%20Northwest%20Territories,%20Canada,%20and%20the%20middle%20Ediacaran%20Rainstorm%20Member%20of%20the%20Johnnie%20Formation,%20Basin%20and%20Range,%20United%20States%E2%80%94using%20a%20combination%20of%20high-resolution%20petrography,%20micro%20X-ray%20fluorescence%20and%20wavelength%20dispersive%20spectroscopy,%20C%20isotopes,%20and%20sedimentary%20context%20to%20provide%20information%20on%20geobiological%20processes%20occurring%20at%20the%20sediment-water%20interface.%20Interestingly,%20both%20of%20these%20Proterozoic%20examples%20are%20associated%20with%20iron-rich%20secondary%20mineral%20assemblages,%20have%20elevated%20trace%20metal%20signatures,%20and%20sit%20within%20maximum%20flooding%20intervals,%20highlighting%20key%20commonalities%20in%20synsedimentary%20geobiological%20processes%20that%20led%20to%20seafloor%20carbonate%20precipitation.}}

