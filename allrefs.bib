@article{Lamb2012a,
	annote = {10.1130/G33093.1},
	author = {Lamb, Michael P. and Fischer, Woodward W. and Raub, Timothy D. and Perron, J. Taylor and Myrow, Paul M.},
	date = {2012/09/01},
	date-added = {2012-09-11 16:14:56 +0000},
	date-modified = {2012-10-29 20:46:18 +0000},
	journal = {Geology},
	journal1 = {Geology},
	month = {09},
	number = {9},
	pages = {827--830},
	title = {Origin of giant wave ripples in snowball Earth cap carbonate},
	ty = {JOUR},
	volume = {40},
	year = {2012},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://geology.gsapubs.org/content/40/9/827.abstract%20N2%20-%20The%20most%20extreme%20climate%20transitions%20in%20Earth%20history%20are%20recorded%20by%20the%20juxtaposition%20of%20Neoproterozoic%20glacial%20deposits%20with%20overlying%20cap%20carbonate%20beds.%20Some%20of%20the%20most%20remarkable%20sedimentary%20structures%20within%20these%20beds%20are%20sharp-crested%20(trochoidal)%20bedforms%20with%20regular%20spacing%20of%20as%20much%20as%20several%20meters%20that%20are%20often%20interpreted%20as%20giant%20wave%20ripples%20formed%20under%20extreme%20wave%20conditions%20in%20a%20nonuniform%20postglacial%20climate.%20Here%20we%20evaluate%20this%20hypothesis%20using%20a%20new%20bedform%20stability%20diagram%20for%20symmetric%20oscillatory%20flows%20that%20indicates%20that%20the%20first-order%20control%20on%20the%20formation%20of%20trochoidal%20rather%20than%20hummocky%20bedforms%20is%20sediment%20size,%20not%20wave%20climate.%20New%20measurements%20of%20bedform%20wavelengths%20and%20particle%20sizes%20from%20the%20ca.%20635%20Ma%20Nuccaleena%20Formation,%20Australia,%20indicate%20that%20the%20giant%20ripples%20are%20generally%20composed%20of%20coarse%20to%20very%20coarse%20sand;%20most%20are%20within%20the%20trochoidal%20bedform%20stability%20phase%20space%20for%20normal%20wave%20climates.%20Moreover,%20numerical%20simulations%20of%20flow%20over%20fixed%20bedforms%20show%20that%20symmetric%20trochoidal%20ripples%20with%20a%20nearly%20vertical%20angle%20of%20climb%20may%20be%20produced%20over%20long%20time%20periods%20with%20variable%20wave%20climates%20in%20conjunction%20with%20rapid%20seabed%20cementation.%20These%20data%20reveal%20that,%20rather%20than%20extreme%20wave%20conditions,%20the%20giant%20wave%20ripples%20are%20a%20consequence%20of%20the%20unusual%20mode%20of%20carbonate%20precipitation%20during%20a%20global%20carbon%20cycle%20perturbation%20unprecedented%20in%20Earth%20history.}}

