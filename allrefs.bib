@article{Evans2013b,
	author = {Evans, David A. D.},
	date-added = {2013-10-28 05:52:40 +0000},
	date-modified = {2020-09-17 05:57:53 -0700},
	doi = {10.1130/B30950.1},
	journal = {Geological Society of America Bulletin},
	pages = {1735-1751},
	title = {Reconstructing pre-{P}angean supercontinents},
	volume = {125},
	year = {2013},
	bdsk-file-1 = {},
	bdsk-file-2 = {},
	bdsk-url-1 = {http://gsabulletin.gsapubs.org/content/early/2013/10/23/B30950.1.abstract%20N2%20-%20Twenty-five%20years%20ago,%20initial%20plans%20for%20reconstructing%20the%20Rodinia%20supercontinent%20were%20being%20drafted,%20based%20on%20the%20growing%20recognition%20of%20correlatable%20mid-Neoproterozoic%20(0.8%E2%80%930.7%20Ga)%20rifted%20passive%20margins,%20many%20of%20which%20were%20established%20on%20the%20eroded%20remnants%20of%20late%20Mesoproterozoic%20(1.3%E2%80%931.0%20Ga)%20orogenic%20belts.%20The%201990s%20witnessed%20a%20surge%20of%20interest%20in%20Rodinia,%20with%20many%20regional%20studies%20of%20tectonostratigraphy%20and%20U-Pb%20geochronology%20generally%20conforming%20to%20the%20%E2%80%9Cinside-out%E2%80%9D%20reconstruction%20model:%20juxtaposition%20of%20west%20Laurentia%20with%20east%20Australia/Antarctica,%20north%20Laurentia%20with%20Siberia,%20and%20east%20Laurentia%20with%20Baltica%20and%20cratons%20that%20would%20later%20form%20West%20Gondwana.%20This%20standard%20model%20of%20Rodinia%20appeared%20to%20be%20converging%20toward%20a%20solution%20with%20only%20minor%20variations%20by%20the%20turn%20of%20the%20millennium,%20but%20new%20paleomagnetic%20data%20and%20tectonostratigraphic%20information%20obtained%20in%20the%20succeeding%20decade%20chipped%20away%20at%20various%20aspects%20of%20the%20reconstruction;%20several%20cratons%20seemed%20to%20require%20exclusion%20from%20the%20supercontinent%20(thus%20questioning%20its%20very%20validity),%20or%20the%20landmass%20might%20have%20assembled%20much%20later%20(%E2%89%A40.9%20Ga)%20than%20originally%20envisaged%20(thus%20weakening%20the%20link%20to%20global%20Mesoproterozoic%20orogenesis).%20Although%20a%20consensus%20model%20of%20Rodinia%E2%80%99s%20assembly%20and%20fragmentation%20has%20arisen%20from%20the%20International%20Geoscience%20Programme%20Project%20440%20working%20group,%20the%20reconstruction%20is%20supported%20by%20rather%20sparse%20definitive-quality%20data.As%20the%20quest%20for%20Rodinia%20matures%20to%20a%20third%20decade%20of%20scrutiny,%20the%20search%20for%20its%20predecessor%20Nuna%20(a.k.a.%20Hudsonland%20or%20Columbia)%20is%20only%20now%20reaching%20a%20stage%20of%20global%20synthesis%20between%20tectonostratigraphic%20and%20paleomagnetic%20data.%20According%20to%20most%20definitions,%20Nuna%20assembled%20at%201.9%E2%80%931.75%20Ga,%20or%20perhaps%20as%20late%20as%201.6%20Ga,%20and%20fragmented%20during%20the%20interval%201.5%E2%80%931.2%20Ga.%20Because%20mafic%20dike%20swarms%20are%20ideal%20targets%20for%20paleomagnetic%20study,%20and%20because%20they%20are%20now%20amenable%20to%20routine%20dating%20by%20U-Pb%20on%20baddeleyite,%20the%20global%20abundance%20of%20Paleo-Mesoproterozoic%20dike%20swarms%20might%20make%20Nuna%20more%20imminently%20solvable%20than%20Rodinia.Prior%20to%20the%20assembly%20of%20Nuna,%20various%20%E2%80%9Csupercraton%E2%80%9D%20connections%20such%20as%20Vaalbara,%20Superia,%20and%20Sclavia%20are%20only%20beginning%20to%20take%20form.%20Unmetamorphosed,%20early%20Paleoproterozoic%20(2.5%E2%80%932.0%20Ga)%20mafic%20dike%20swarms%20are%20commonplace%20features%20across%20the%20interiors%20of%20Archean%20cratons,%20and%20their%20joint%20paleomagnetic%20and%20geochronologic%20study%20can%20help%20reassemble%20the%20cratons%20into%20their%20supercraton%20parent%20landmasses.%20Progressively%20older%20geologic%20times%20require%20consideration%20of%20a%20greater%20number%20of%20potentially%20independent%20terranes,%20each%20needing%20individual%20kinematic%20constraints.%20Furthermore,%20the%20initial%20stabilizing%20events%20of%20most%20extant%20cratons%20during%20Neoarchean%20time%20(3.0%E2%80%932.5%20Ga)%20therefore%20render%20global%20reconstructions%20older%20than%20that%20interval%20improbable.}}

