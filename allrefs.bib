	pages = {39--81},
	title = {Basinwide stratigraphic synthesis and sequence stratigraphy, upper Pragian, Emsian and Eifelian stages (Lower to Middle Devonian), Appalachian Basin},
	ty = {JOUR},
	volume = {278},
	year = {2007},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://sp.lyellcollection.org/content/278/1/39.abstract%20N2%20-%20A%20new%20synthesis%20of%20the%20Lower%20to%20Middle%20Devonian%20(upper%20Pragian,%20Emsian%20and%20Eifelian)%20succession%20across%20the%20Appalachian%20Basin%20has%20been%20developed%20by%20high%20resolution%20event%20and%20sequence%20stratigraphic%20analysis.%20The%20correlation%20of%20numerous%20marker%20beds%20and%20a%20hierarchy%20of%20cycles%20in%20the%20interval%20of%20the%20Oriskany%20Sandstone%20to%20lower%20Hamilton%20Group%20provide%20a%20refined%20picture%20of%20the%20depositional%20patterns,%20faunal%20changes,%20formation%20to%20member-level%20(and%20finer)%20relationships,%20and%20sea-level%20trends.%20The%20succession%20begins%20above%20the%20Wallbridge%20Unconformity,%20or%20its%20correlative%20conformity,%20which%20lies%20beneath%20the%20Oriskany%20Sandstone,%20not%20above%20it%20as%20previously%20thought.%20The%20new%20sequence-stratigraphic%20framework%20of%20Oriskany%20to%20lower%20Hamilton%20strata%20comprises%20nine%20%E2%80%98third%20order%E2%80%99%20stratigraphic%20sequences%20(cycles),%20though%20an%20interval%20of%20some%2025%20million%20years.%20At%20a%20coarse%20scale,%20the%20eustatic%20Pragian%20to%20Eifelian%20sea-level%20curve%20for%20Euramerica%20of%20Johnson%20et%20al.%20(1985)%20shows%20broad%20variance%20with%20the%20Appalachian%20curve,%20reflecting%20the%20regional%20influence%20of%20the%20Acadian%20orogeny.%20However%20at%20the%20finer%20sequence-scale,%20the%20Euramerican%20sea-level%20trends%20are%20recognizable%20in%20the%20Appalachian%20Basin%20succession.}}

@article{ANDERSON1990a,
	annote = {10.1144/gsjgs.147.3.0507},
	author = {ANDERSON, E. J. and GOODWIN, P. W.},
	date = {1990/06/01},
	date-added = {2011-04-08 18:51:01 -0400},
	date-modified = {2012-10-29 20:46:19 +0000},
	journal = {Journal of the Geological Society},
	journal1 = {Journal of the Geological Society},
	month = {06},
	number = {3},
	pages = {507--518},
	title = {The significance of metre-scale allocycles in the quest for a fundamental stratigraphic unit},
	ty = {JOUR},
	volume = {147},
	year = {1990},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://jgs.lyellcollection.org/content/147/3/507.abstract%20N2%20-%20The%20major%20%E2%80%98transgressive%E2%80%99%20sequence%20in%20the%20lower%20Helderberg%20Group%20(Devonian)%20of%20New%20York%20State%20and%20a%20%E2%80%98regressive%E2%80%99%20sequence%20of%20similar%20scale%20in%20the%20first%20Courceyan%20mesothem%20(Carboniferous)%20of%20South%20Wales%20are%20entirely%20divisible%20into%20metre-scale%20allocycles.%20The%20boundaries%20of%20these%20cycles%20are%20produced%20by%20non-sedimentological%20processes:%20larger-scale%20stratigraphic%20events%20associated%20with%20relative%20sea-level%20fluctuations.%20The%20existence%20of%20these%20boundaries%20as%20basin-wide%20discontinuities%20precludes%20the%20application%20of%20Walther%E2%80%99s%20Law%20except%20within%20cycles.%20Thus%20palaeogeographic%20reconstructions%20based%20on%20the%20assumption%20of%20contemporaneity%20of%20large-scale%20fades%20tracts%20(formations%20and%20members)%20must%20be%20abandoned.%20Instead%20stratigraphic%20interpretation%20requires%20the%20recognition%20and%20application%20of%20a%20genetic%20unit%20of%20analysis%20consistent%20with%20the%20actual%20internal%20allogenic%20fabric%20of%20such%20sequences.%20Application%20of%20the%20metre-scale%20allocycle,%20the%20smallest%20allogenic%20unit%20of%20stratigraphic%20accumulation,%20results%20in%20fundamentally%20different%20interpretations%20of%20the%20Helderberg%20and%20Courceyan%20sequences.%20Rather%20than%20being%20continuously%20and%20unidirectionally%20%E2%80%98transgressive%E2%80%99%20or%20%E2%80%98regressive%E2%80%99,%20both%20sequences%20were%20discontinuously%20generated%20by%20episodes%20of%20rapid%20deepening%20and%20gradual%20shallowing%20at%20more%20than%20one%20scale.}}

@article{Anderson1984a,
	abstract = {At any single locality in the Helderberg Group of New York State, most formation and member boundaries coincide with boundaries of punctuated aggradational cycles. In each case of coincidence, the boundary is a discontinuity that was produced by a rapid rise of relative base level, rather than a facies contact representing gradual migration of contiguous paleoenvironments. Apparently diachronous formation boundaries in the sequence are not single continuous surfaces; instead, each diachronous boundary is actually a stratigraphic series of isochronous surfaces that are separate punctuated aggradational cycles (PAC) boundaries produced by distinct geologically instantaneous base-level rises. These conclusions about the origin of formation boundaries suggest that the concept of the formation as a fundamental unit of stratigraphic description and interpretation may need revision if the stratigraphic record accumulated episodically on a small scale. },
	annote = {10.1130/0091-7613(1984)12<120:EAATOO>2.0.CO;2},
	author = {Anderson, E. J. and Goodwin, Peter W. and Sobieski, Theodore H.},
