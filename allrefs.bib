@article{McLelland1990a,
	abstract = {The igneous emplacement age of anorthositic rocks comprising the Marcy massif have been constrained by fixing minimum and maximum ages for their intrusion. Minimum ages have been fixed by: (a) U-Pb dating of cores of air abraded zircons from the anorthosite (>1113 Ma), (b) U-Pb dating of baddeleyite within the anorthosite (>1087 Ma), (c) U-Pb dating of baddeleyite from an olivine metagabbro crosscutting Marcy massif anorthosite (>1109 Ma), (d) U-Pb zircon dating of jotunitic rocks crosscutting the Marcy anorthosite massif ({\$}1143 {$\backslash$}pm 31 Ma{\$}). Maximum emplacement ages are based upon: (a) sheets of anorthositic rock crosscutting mangeritic-charnockitic gneiss dated by U-Pb zircon at {\$}1125 {$\backslash$}pm 10 Ma{\$}, {\$}1134 {$\backslash$}pm 4 Ma{\$}, and {\$}1135 {$\backslash$}pm 43 Ma{\$}, and (b) anorthosite-related pyroxenite dikes crosscutting mangerite that contains xenoliths of identical pyroxenite. These results constrain emplacement of the Marcy anorthosite to 1113-1138 Ma with the most probable age in the interval 1125-1135 Ma. This time of intrusion is coincident with that of the granitoid envelope enclosing the anorthosite massif and indicates that, together, these rocks represent a bimodal magmatic complex.},
	annote = {doi: 10.1086/629372},
	author = {McLelland, James M. and Chiarenzelli, Jeffrey},
	booktitle = {The Journal of Geology},
	da = {1990/01/01},
	date = {1990/01/01},
	date-added = {2017-02-20 04:30:38 +0000},
	date-modified = {2017-02-20 04:30:38 +0000},
	doi = {10.1086/629372},
	isbn = {0022-1376},
	journal = {The Journal of Geology},
	journal1 = {The Journal of Geology},
	m3 = {doi: 10.1086/629372},
	month = {2017/02/19},
	n2 = {The igneous emplacement age of anorthositic rocks comprising the Marcy massif have been constrained by fixing minimum and maximum ages for their intrusion. Minimum ages have been fixed by: (a) U-Pb dating of cores of air abraded zircons from the anorthosite (>1113 Ma), (b) U-Pb dating of baddeleyite within the anorthosite (>1087 Ma), (c) U-Pb dating of baddeleyite from an olivine metagabbro crosscutting Marcy massif anorthosite (>1109 Ma), (d) U-Pb zircon dating of jotunitic rocks crosscutting the Marcy anorthosite massif ({\$}1143 {$\backslash$}pm 31 Ma{\$}). Maximum emplacement ages are based upon: (a) sheets of anorthositic rock crosscutting mangeritic-charnockitic gneiss dated by U-Pb zircon at {\$}1125 {$\backslash$}pm 10 Ma{\$}, {\$}1134 {$\backslash$}pm 4 Ma{\$}, and {\$}1135 {$\backslash$}pm 43 Ma{\$}, and (b) anorthosite-related pyroxenite dikes crosscutting mangerite that contains xenoliths of identical pyroxenite. These results constrain emplacement of the Marcy anorthosite to 1113-1138 Ma with the most probable age in the interval 1125-1135 Ma. This time of intrusion is coincident with that of the granitoid envelope enclosing the anorthosite massif and indicates that, together, these rocks represent a bimodal magmatic complex.},
	number = {1},
