@article{Tarduno2015a,
	annote = {10.1126/science.aaa9114},
	author = {Tarduno, John A. and Cottrell, Rory D. and Davis, William J. and Nimmo, Francis and Bono, Richard K.},
	date = {2015/07/31},
	date-added = {2015-10-21 17:36:09 +0000},
	date-modified = {2015-10-21 17:36:09 +0000},
	journal = {Science},
	journal1 = {Science},
	month = {07},
	number = {6247},
	pages = {521--524},
	title = {A Hadean to Paleoarchean geodynamo recorded by single zircon crystals},
	ty = {JOUR},
	url = {http://www.sciencemag.org/content/349/6247/521.abstract N2 - Knowing when the geodynamo started is important for understanding the evolution of the core, the atmosphere, and life on Earth. We report full-vector paleointensity measurements of Archean to Hadean zircons bearing magnetic inclusions from the Jack Hills conglomerate (Western Australia) to reconstruct the early geodynamo history. Data from zircons between 3.3 billion and 4.2 billion years old record magnetic fields varying between 1.0 and 0.12 times recent equatorial field strengths. A Hadean geomagnetic field requires a core-mantle heat flow exceeding the adiabatic value and is suggestive of plate tectonics and/or advective magmatic heat transport. The existence of a terrestrial magnetic field before the Late Heavy Bombardment is supported by terrestrial nitrogen isotopic evidence and implies that early atmospheric evolution on both Earth and Mars was regulated by dynamo behavior.},
	volume = {349},
	year = {2015},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://www.sciencemag.org/content/349/6247/521.abstract%20N2%20-%20Knowing%20when%20the%20geodynamo%20started%20is%20important%20for%20understanding%20the%20evolution%20of%20the%20core,%20the%20atmosphere,%20and%20life%20on%20Earth.%20We%20report%20full-vector%20paleointensity%20measurements%20of%20Archean%20to%20Hadean%20zircons%20bearing%20magnetic%20inclusions%20from%20the%20Jack%20Hills%20conglomerate%20(Western%20Australia)%20to%20reconstruct%20the%20early%20geodynamo%20history.%20Data%20from%20zircons%20between%203.3%20billion%20and%204.2%20billion%20years%20old%20record%20magnetic%20fields%20varying%20between%201.0%20and%200.12%20times%20recent%20equatorial%20field%20strengths.%20A%20Hadean%20geomagnetic%20field%20requires%20a%20core-mantle%20heat%20flow%20exceeding%20the%20adiabatic%20value%20and%20is%20suggestive%20of%20plate%20tectonics%20and/or%20advective%20magmatic%20heat%20transport.%20The%20existence%20of%20a%20terrestrial%20magnetic%20field%20before%20the%20Late%20Heavy%20Bombardment%20is%20supported%20by%20terrestrial%20nitrogen%20isotopic%20evidence%20and%20implies%20that%20early%20atmospheric%20evolution%20on%20both%20Earth%20and%20Mars%20was%20regulated%20by%20dynamo%20behavior.}}

