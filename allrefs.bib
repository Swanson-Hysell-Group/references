	pages = {685--688},
	title = {Life span and fate of basins},
	volume = {32},
	year = {2004},
	bdsk-file-1 = {},
	bdsk-url-1 = {http://geology.gsapubs.org/content/32/8/685.abstract%20N2%20-%20The%20life%20span%20of%20each%20main%20class%20of%20sedimentary%20basin%20is%20estimated%20from%20published%20data.%20Life%20spans%20vary%20over%20at%20least%20three%20orders%20of%20magnitude,%20from%20%3C1%20m.y.%20for%20trench%20basins%20to%20%3E100%20m.y.%20for%20passive-margin%20and%20intracratonic%20basins.%20The%20life-span%20estimates%20are%20used%20to%20calibrate%20a%20chart%20of%20basin%20groups%20that%20focuses%20on%20the%20likely%20basin%20fates;%20i.e.,%20depositional,%20deformational,%20or%20thermal.%20Consequent%20fates,%20predetermined%20by%20the%20tectonic%20setting%20of%20a%20particular%20basin%20class,%20are%20distinguished%20from%20contingent%20fates,%20which%20are%20independent%20of%20basin%20type.%20Accretion%20of%20trench-basin%20fill%20is,%20for%20example,%20a%20consequent%20fate,%20whereas%20inversion%20(far-field%20shortening)%20of%20a%20rift%20basin%20is%20a%20contingent%20fate.%20Life-span%20data%20are%20also%20used%20to%20calibrate%20the%20Wilson%20Cycle%20and%20indicate%20that%20it%20has%20an%20average%20duration%20of%20%E2%88%BC260%20m.y.%20This%20is%20certainly%20an%20underestimate,%20because%20basin%20life%20spans%20are%20an%20imperfect%20proxy%20for%20the%20duration%20of%20subduction%20and%20collision%20zones.}}

