@article{Tanaka2016a,
	annote = {10.1093/gji/ggw031},
	author = {Tanaka, Hidefumi and Yamamoto, Yuhji},
	date-added = {2016-03-31 20:01:14 +0000},
	date-modified = {2016-03-31 20:01:14 +0000},
	journal = {Geophysical Journal International},
	journal1 = {Geophysical Journal International},
	number = {2},
	pages = {694--714},
	title = {Palaeointensities from Pliocene lava sequences in Iceland: emphasis on the problem of Arai plot with two linear segments},
	ty = {JOUR},
	url = {http://gji.oxfordjournals.org/content/205/2/694.abstract N2 - Palaeointensity experiments were carried out to a sample collection from two sections of basalt lava flow sequences of Pliocene age in north central Iceland (Chron C2An) to further refine the knowledge of the behaviour of the palaeomagnetic field. Selection of samples was mainly based on their stability of remanence to thermal demagnetization as well as good reversibility in variations of magnetic susceptibility and saturation magnetization with temperature, which would indicate the presence of magnetite as a product of deuteric oxidation of titanomagnetite. Among 167 lava flows from two sections, 44 flows were selected for the Königsberger–Thellier–Thellier experiment in vacuum. In spite of careful pre-selection of samples, an Arai plot with two linear segments, or a concave-up appearance, was often encountered during the experiments. This non-ideal behaviour was probably caused by an irreversible change in the domain state of the magnetic grains of the pseudo-single-domain (PSD) range. This is assumed because an ideal linear plot was obtained in the second run of the palaeointensity experiment in which a laboratory thermoremanence acquired after the final step of the first run was used as a natural remanence. This experiment was conducted on six selected samples, and no clear difference between the magnetic grains of the experimented and pristine sister samples was found by scanning electron microscope and hysteresis measurements, that is, no occurrence of notable chemical/mineralogical alteration, suggesting that no change in the grain size distribution had occurred. Hence, the two-segment Arai plot was not caused by the reversible multidomain/PSD effect in which the curvature of the Arai plot is dependent on the grain size. Considering that the irreversible change in domain state must have affected data points at not only high temperatures but also low temperatures, fv ≥ 0.5 was adopted as one of the acceptance criteria where fv is a vectorially defined fraction of the linear segment. A measure of curvature k′ was also used to check the linearity of the selected linear segment. It was avoided, however, to reject the result out of hand by the large curvature k of the entire data points because it might still include a linear segment with a large fraction. Combining with the results of Shaw's experiments, 52 palaeointensities were obtained out of 192 specimens, or 11 flow means were obtained out of the 44 lava flows. Most of the palaeointensities were from the upper part of the lava section (Chron C2An.1n) and ranged between 30 and 66 μT. Including two results from the bottom part of the lava section, the mean virtual dipole moment for 2.5–3.5 Ma is 6.3 ± 1.4 × 1022 Am2 (N = 11), which is ∼19 per cent smaller than the present-day dipole moment.},
	volume = {205},
	year = {May 01, 2016},
	bdsk-file-1 = {},
	bdsk-file-2 = {},
	bdsk-url-1 = {http://gji.oxfordjournals.org/content/205/2/694.abstract%20N2%20-%20Palaeointensity%20experiments%20were%20carried%20out%20to%20a%20sample%20collection%20from%20two%20sections%20of%20basalt%20lava%20flow%20sequences%20of%20Pliocene%20age%20in%20north%20central%20Iceland%20(Chron%20C2An)%20to%20further%20refine%20the%20knowledge%20of%20the%20behaviour%20of%20the%20palaeomagnetic%20field.%20Selection%20of%20samples%20was%20mainly%20based%20on%20their%20stability%20of%20remanence%20to%20thermal%20demagnetization%20as%20well%20as%20good%20reversibility%20in%20variations%20of%20magnetic%20susceptibility%20and%20saturation%20magnetization%20with%20temperature,%20which%20would%20indicate%20the%20presence%20of%20magnetite%20as%20a%20product%20of%20deuteric%20oxidation%20of%20titanomagnetite.%20Among%20167%20lava%20flows%20from%20two%20sections,%2044%20flows%20were%20selected%20for%20the%20K%C3%B6nigsberger%E2%80%93Thellier%E2%80%93Thellier%20experiment%20in%20vacuum.%20In%20spite%20of%20careful%20pre-selection%20of%20samples,%20an%20Arai%20plot%20with%20two%20linear%20segments,%20or%20a%20concave-up%20appearance,%20was%20often%20encountered%20during%20the%20experiments.%20This%20non-ideal%20behaviour%20was%20probably%20caused%20by%20an%20irreversible%20change%20in%20the%20domain%20state%20of%20the%20magnetic%20grains%20of%20the%20pseudo-single-domain%20(PSD)%20range.%20This%20is%20assumed%20because%20an%20ideal%20linear%20plot%20was%20obtained%20in%20the%20second%20run%20of%20the%20palaeointensity%20experiment%20in%20which%20a%20laboratory%20thermoremanence%20acquired%20after%20the%20final%20step%20of%20the%20first%20run%20was%20used%20as%20a%20natural%20remanence.%20This%20experiment%20was%20conducted%20on%20six%20selected%20samples,%20and%20no%20clear%20difference%20between%20the%20magnetic%20grains%20of%20the%20experimented%20and%20pristine%20sister%20samples%20was%20found%20by%20scanning%20electron%20microscope%20and%20hysteresis%20measurements,%20that%20is,%20no%20occurrence%20of%20notable%20chemical/mineralogical%20alteration,%20suggesting%20that%20no%20change%20in%20the%20grain%20size%20distribution%20had%20occurred.%20Hence,%20the%20two-segment%20Arai%20plot%20was%20not%20caused%20by%20the%20reversible%20multidomain/PSD%20effect%20in%20which%20the%20curvature%20of%20the%20Arai%20plot%20is%20dependent%20on%20the%20grain%20size.%20Considering%20that%20the%20irreversible%20change%20in%20domain%20state%20must%20have%20affected%20data%20points%20at%20not%20only%20high%20temperatures%20but%20also%20low%20temperatures,%20fv%20%E2%89%A5%200.5%20was%20adopted%20as%20one%20of%20the%20acceptance%20criteria%20where%20fv%20is%20a%20vectorially%20defined%20fraction%20of%20the%20linear%20segment.%20A%20measure%20of%20curvature%20k%E2%80%B2%20was%20also%20used%20to%20check%20the%20linearity%20of%20the%20selected%20linear%20segment.%20It%20was%20avoided,%20however,%20to%20reject%20the%20result%20out%20of%20hand%20by%20the%20large%20curvature%20k%20of%20the%20entire%20data%20points%20because%20it%20might%20still%20include%20a%20linear%20segment%20with%20a%20large%20fraction.%20Combining%20with%20the%20results%20of%20Shaw's%20experiments,%2052%20palaeointensities%20were%20obtained%20out%20of%20192%20specimens,%20or%2011%20flow%20means%20were%20obtained%20out%20of%20the%2044%20lava%20flows.%20Most%20of%20the%20palaeointensities%20were%20from%20the%20upper%20part%20of%20the%20lava%20section%20(Chron%20C2An.1n)%20and%20ranged%20between%2030%20and%2066%20%CE%BCT.%20Including%20two%20results%20from%20the%20bottom%20part%20of%20the%20lava%20section,%20the%20mean%20virtual%20dipole%20moment%20for%202.5%E2%80%933.5%20Ma%20is%206.3%20%C2%B1%201.4%20%C3%97%201022%20Am2%20(N%20=%2011),%20which%20is%20%E2%88%BC19%20per%20cent%20smaller%20than%20the%20present-day%20dipole%20moment.}}

