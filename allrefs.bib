	bdsk-file-1 = {},
	bdsk-url-1 = {http://geology.gsapubs.org/content/38/11/1027.abstract%20N2%20-%20Oxygen%20isotope%20values%20of%20sequentially%20microsampled%20accretionary%20carbonate%20from%20the%20thick-shelled%20calcitic%20bivalve%20Eurydesma%20from%20the%20Early%20Permian%20of%20southeastern%20Australia%20vary%20seasonally%20over%206%20yr%20of%20growth.%20Paleotemperature%20constraints%20derived%20from%20coeval%20glendonite%20and%20ice-rafted%20clasts,%20in%20combination%20with%20published%20biome%20data,%20indicate%20near-freezing%20winter%20conditions.%20However,%20paleotemperatures%20calculated%20from%20oxygen%20isotope%20data%20are%20too%20warm%20unless%20the%20%CE%B418O%20value%20of%20seawater%20approached%20%E2%88%924%E2%80%B0.%20Associated%20stenohaline%20brachiopods%20and%20lack%20of%20covariance%20with%20%CE%B413C%20argue%20against%20significantly%20reduced%20salinity,%20and%20published%20%CE%B418O%20data%20from%20across%20Australia%20suggest%20that%20conditions%20recorded%20by%20this%20bivalve%20were%20typical%20of%20the%20Gondwanan%20high%20latitudes.%20The%20negative%20%CE%B418O%20value%20of%20seawater%20implied%20by%20these%20data%20reflects%20in%20part%20the%20expected%20meridional%20gradient%20in%20marine%20seawater%20composition%20related%20to%20latitudinal%20variation%20in%20evaporation%20and%20precipitation%20in%20Permian%20oceans,%20but%20is%20also%20consistent%20with%20previous%20suggestions%20of%20a%20secular%20increase%20in%20the%20oxygen%20isotopic%20composition%20of%20ocean%20water%20through%20the%20Phanerozoic.}}

